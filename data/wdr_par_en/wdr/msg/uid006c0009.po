#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You must have a bad memory.
msgctxt "6276_Maya"
msgid "Hmm. I don't think I do..."
msgstr "Mmm. No creo poder hacerlo..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=8
#. y4:msg_location=T6.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You must have a bad memory.
msgctxt "6288_Kiryu"
msgid "Do you remember what we talked about the last time I was here?"
msgstr "¿Recuerdas lo que hablamos la última vez que estuve aquí?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=9
#. y4:msg_location=T6.P9
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You must have a bad memory.
msgctxt "6300_Maya"
msgid "Huh!? I..."
msgstr "¿Eh? Yo..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=10
#. y4:msg_location=T6.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You must have a bad memory.
msgctxt "6312_Kiryu"
msgid "Come on. What'd we talk about?"
msgstr "Anda. ¿De qué hablamos?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=11
#. y4:msg_location=T6.P11
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You must have a bad memory.
msgctxt "6324_Maya"
msgid "Um..."
msgstr "Em..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=12
#. y4:msg_location=T6.P12
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You must have a bad memory.
msgctxt "6336_Maya"
msgid "Sorry, I can't remember! Hahaha!"
msgstr "Perdón, ¡No recuerdo nadita! ¡Ja, ja, ja!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=13
#. y4:msg_location=T6.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You must have a bad memory.
msgctxt "6348_Kiryu"
msgid "Huh. Now I'm starting to get mad, too."
msgstr "Eh. Ya empiezo a irritarme."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=14
#. y4:msg_location=T6.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It is kinda rude.
msgctxt "6360_Kiryu"
msgid "It is kinda rude. You need to pay attention to what your friends are saying, especially if you're the one asking them the question."
msgstr "Eso es un poco grosero. Tienes que prestar atención a lo que dicen tus amigos, sobre todo si eres tú quien les hace la pregunta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=15
#. y4:msg_location=T6.P15
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It is kinda rude.
msgctxt "6372_Maya"
msgid "Yeah. I guess it is rude."
msgstr "Sí. Supongo que es grosero."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=16
#. y4:msg_location=T6.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It is kinda rude.
msgctxt "6384_Kiryu"
msgid "Is that really what's happening? Are you not listening?"
msgstr "¿Es eso lo que está pasando? ¿No escuchas?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=17
#. y4:msg_location=T6.P17
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It is kinda rude.
msgctxt "6396_Maya"
msgid "Well, it doesn't happen when we're talking about something important. Maybe I don't pay enough attention to trivial things."
msgstr "Bueno, no ocurre cuando hablamos de algo importante. Quizá no le presto suficiente atención a las trivialidades."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=18
#. y4:msg_location=T6.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It is kinda rude.
msgctxt "6408_Kiryu"
msgid "I feel a little sorry for your friends, then."
msgstr "Siento un poco de lástima por tus amigos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=19
#. y4:msg_location=T6.P19
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It is kinda rude.
msgctxt "6420_Maya"
msgid "Haha! I should be more careful in conversation."
msgstr "¡Ja, ja! Debería ser más cuidadosa en las conversaciones."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=20
#. y4:msg_location=T6.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It is kinda rude.
msgctxt "6432_Kiryu"
msgid "Good luck with that."
msgstr "Buena suerte con eso."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=141
#. y4:msg_phrase=0
#. y4:msg_location=T141.P0
#. y4:msg_choice_index=3
