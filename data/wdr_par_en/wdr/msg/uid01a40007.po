#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Suited Goon
#. y4:msg_speaker_id=0
msgctxt "72_Suited Goon"
msgid "Urk... Dammit!"
msgstr "Uf... ¡Maldita sea!"

msgctxt "84_Saejima"
msgid "I dunno fuck-all 'bout no woman. Ya wanna find her?\\r\n"
"Then start lookin', assholes."
msgstr "No tengo ni la más puta idea de esa mujer. ¿La quieren \\r\n"
"encontrar? Entonces empiecen a buscar, idiotas."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "132_Saejima"
msgid "(Saori's gotten herself into some serious shit.)"
msgstr "(Saori se metió en algo muy turbio.)"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=?
#. y4:msg_speaker_id=3
msgctxt "144_?"
msgid "Er, 'scuse me..."
msgstr "Eh, disculpe..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "156_Saejima"
msgid "Whaddya want?"
msgstr "¿Qué pasa?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Shine Scout
#. y4:msg_speaker_id=5
msgctxt "168_Shine Scout"
msgid "I work as a scout for Shine, a hostess club on Pink Street."
msgstr "Trabajo como scout para el Shine, un club de hostess en Pink Street."

msgctxt "180_Saejima"
msgid "None of that made a damn lick of sense. Let's walk it back\\r\n"
"and start over at \"scout,\" yeah?"
msgstr "No entendí nada. Vamos paso a paso… empieza otra vez desde ‘scout’, ¿sí? "

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Shine Scout
#. y4:msg_speaker_id=5
msgctxt "192_Shine Scout"
msgid "Huh? Oh. A scout's, uh... like a doorman, I guess?"
msgstr "¿Eh? Oh. Un scout es... eh... ¿como un portero, supongo?"

msgctxt "204_Saejima"
msgid "Oh, a doorman. Shoulda said so in the first place.\\r\n"
"So what's goin' on?"
msgstr "Ah, un portero. Deberías haber empezado por ahí.\\r\n"
"Bueno, ¿qué es lo que pasa?"

msgctxt "216_Shine Scout"
msgid "You know those men in black you just fought off?\\r\n"
"There are some lurking around our club, too."
msgstr "¿Sabes esos hombres de negro con los que acabas de pelear?\\r \n"
"Hay algunos que tambien dan vueltas por nuestro club."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "228_Saejima"
msgid "And?"
msgstr "¿Y? ¿Qué más?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Shine Scout
#. y4:msg_speaker_id=5
msgctxt "240_Shine Scout"
msgid "I was just wondering if you happened to know who they are...?"
msgstr "Me preguntaba si sabías quiénes eran..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "252_Saejima"
msgid "Nope. Sorry."
msgstr "No. Lo siento."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Shine Scout
#. y4:msg_speaker_id=5
msgctxt "264_Shine Scout"
msgid "Oh, all right. I suppose I'll have to alert the police, then."
msgstr "Oh, bueno. Supongo que tendré que informar a la polícia."

msgctxt "276_Shine Scout"
msgid "With those creeps hanging around, our guests don't feel safe.\\r\n"
"We're losing business, and fast."
msgstr "Con esos tipos rondando el lugar, nuestros clientes no se sienten seguros. Estamos perdiendo negocio, y rápido."

msgctxt "288_Shine Scout"
msgid "It's fine, though. If you don't know, you don't know.\\r\n"
"Thanks anyway, and sorry to have bothered you!"
msgstr "Pero está bien. Si no lo sabes, no pasa nada.\n"
"Gracias igual, ¡y disculpa que te haya molestado!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "312_Saejima"
msgid "(So those suits have some buddies over on Pink Street, huh?)"
msgstr "(Así que los trajeados tienen amiguitos en Pink Street, eh?)"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Suited Goon
#. y4:msg_speaker_id=0
msgctxt "348_Suited Goon"
msgid "You... You're the one who helped that woman escape."
msgstr "Tú... tú eres el que ayudó a escapar a esa mujer."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "360_Saejima"
msgid "What gives?"
msgstr "¿Si, y qué?"

msgctxt "372_Suited Thug"
msgid "Where'd she go? You'll tell us, all right,\\r\n"
"even if we have to beat it out of you!"
msgstr "¿A dónde fue? ¡Nos lo vas a decir por las buenas\\r \n"
"o ya te puedes preparar para las malas!"
