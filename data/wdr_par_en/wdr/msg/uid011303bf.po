#. y4:msg_branch_target=T1.P67
#. y4:msg_branch_segment=T1.P67..P69
#. y4:msg_branch_target_text=There ain't no problem with livin' without a goal. You should just enjoy livin' as a handsome champion. That's a rare opportunity.
#. y4:msg_branch_raw=01 11 00 43 00 00 00 22 00 00 00 00 00 00 00 00
msgctxt "3108_Saejima"
msgid "Enjoy life as a handsome champion."
msgstr ""

