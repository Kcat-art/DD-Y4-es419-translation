#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Hoodlum
#. y4:msg_speaker_id=0
msgctxt "56_Hoodlum"
msgid "Who the goddamn are you, anyway? Broke my fuggin' nose..."
msgstr "¿Quién demonios eres? Me rompiste la maldita nariz..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "80_Tadashi"
msgid "Sorry, big guy..."
msgstr "Discúlpame, grandulón..."

#. y4:line_status=translated
msgctxt "92_Saejima"
msgid "Tadashi, ya can't take on all your problems alone.\\r\nThat ain't courage. That's called being reckless."
msgstr "Tadashi, no puedes enfrentarte a todos tus problemas solo.\nEso no es ser valiente. Se llama ser imprudente."

#. y4:line_status=translated
msgctxt "104_Saejima"
msgid "There's times when a man's gotta fight. But when he does,\\r\nhe better not lose. Ya understand me, boy?"
msgstr "Hay momentos en los que un hombre tiene que pelear.\nPero si lo hace, será mejor que no pierda. ¿Me entiendes, chico?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "116_Tadashi"
msgid "Yes, sir."
msgstr "Sí, señor."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "128_Saejima"
msgid "In case ya forgot, Tadashi, I got a sister, too."
msgstr "Por si lo olvidaste, Tadashi, yo también tengo una hermana."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "140_Tadashi"
msgid "I know..."
msgstr "Lo sé..."

#. y4:line_status=translated
msgctxt "152_Saejima"
msgid "When I was 12 years old, my ma and pa died. Me and Yasuko\\r\nwound up with some relatives."
msgstr "Cuando tenía doce años, mi mamá y mi papá murieron.\nYasuko y yo, fuimos a parar con unos parientes."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "164_Tadashi"
msgid "Uh-huh..."
msgstr "Uh-huh..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "176_Saejima"
msgid "I say \"relatives\" but we're talkin', like, eight times removed."
msgstr "Digo \"parientes\" pero en realidad, eran como muy... muy lejanos."

#. y4:line_status=translated
msgctxt "188_Saejima"
msgid "They took us in, treated us great. Not like what happened\\r\nto you guys."
msgstr "Nos adoptaron, nos trataron genial. Nada parecido\na los que les paso a ustedes dos."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "200_Saejima"
msgid "But we both felt like we were imposin' on 'em. Nothin' either of us could do to quit feeling that way. So I left, and I took Yasuko with me."
msgstr "Pero ambos sentíamos que estábamos imponiéndonos contra ellos.\nNinguno de los dos podía sacarse esa sensación de encima.\nAsí que, me fui y me lleve a Yasuko conmigo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "212_Tadashi"
msgid "Then what happened?"
msgstr "¿Y qué paso después?"

#. y4:line_status=translated
msgctxt "224_Saejima"
msgid "I was just a kid, so I couldn't get an honest job.\\r\nBut we did whatever we had to to stay together.\\r\nLittle Yasuko even cooked for the two of us."
msgstr "Yo era solo un niño, no podía conseguir un trabajo honrado.\nPero hicimos lo que pudimos para mantenernos juntos.\nLa pequeña Yasuko incluso cocinaba para ambos."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "236_Tadashi"
msgid "Was it hard?"
msgstr "¿Fue difícil?"

#. y4:line_status=translated
msgctxt "248_Saejima"
msgid "Not so long as I had my sister smilin' beside me.\\r\nBut one time Yasuko got real sick."
msgstr "Mientras tuviera a mi hermana mirándome con una sonrisa, no.\nPero hubo una ocasión donde Yasuko se enfermó muy, pero muy mal."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "260_Tadashi"
msgid "Oh no..."
msgstr "Ay no..."

#. y4:line_status=translated
msgctxt "272_Saejima"
msgid "Runaways don't get health insurance. Would've cost\\r\nan arm and a leg for surgery and a hospital room."
msgstr "Los chicos que se escapan de casa no tienen un seguro\nmédico. Habría costado un brazo y un ojo de la cara,\nconseguir una habitación y una cirugía en un hospital."

#. y4:line_status=translated
msgctxt "284_Saejima"
msgid "We were barely survivin'. Couldn't get a loan.\\r\nI got desperate. Started walkin' the streets,\\r\npicking fights with anyone over nothin'."
msgstr "Sobrevivíamos apenas. No conseguí ningún préstamo.\nMe desesperé. Caminaba por las calles... peleándome,\ncon cualquiera que veía sin motivo."

#. y4:line_status=translated
msgctxt "296_Saejima"
msgid "Bein' in a street fight was the only time I felt like\\r\nI could just forget about everything else."
msgstr "Pelearme en las calles era lo único que podía\nhacerme olvidar de todo lo que me pasaba."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "308_Tadashi"
msgid "......"
msgstr "......"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "320_Saejima"
msgid "Till one day, I picked a fight with the wrong guy."
msgstr "Hasta que un día, me cruce con el tipo equivocado."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "332_Saejima"
msgid "This man who's old enough to be my dad just up and beat the crap outta me. I started crying, thinkin' how pathetic, how miserable I was."
msgstr "Era un señor viejo lo suficiente como para ser mi papá, entonces\nfue cuando ese hombre me levanto y me molió a golpes. Comencé a\nlloriquear, pensando en lo patético y miserable que me veía."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "344_Tadashi"
msgid "Was that the man who helped you?"
msgstr "¿Fue esa persona quien te ayudo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "356_Saejima"
msgid "Ya guessed it. That was Sasai-san. The man I owe my life to."
msgstr "Adivinaste. Era Sasai-san. El hombre al que le debo la vida."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "368_Saejima"
msgid "He saw me cryin', and he said, \"Why are you so sad?\""
msgstr "Me vio llorar y dijo, \"¿Por qué estás tan triste?\""

#. y4:line_status=translated
msgctxt "380_Saejima"
msgid "Me, the kid who tried to kick his ass! I wound up spillin'\\r\nmy guts about me and Yasuko, blubberin' about her illness."
msgstr "¡A mí, al chico que intentaba darle una paliza!\nTermine desahogándome. Contándole sobre Yasuko\ny su enfermedad, y todos mis problemas."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "392_Tadashi"
msgid "And what did he do?"
msgstr "¿Y qué hizo?"

#. y4:line_status=translated
msgctxt "404_Saejima"
msgid "He said to me, \"You've come a long way, boy.\\r\nFought hard on your own.\""
msgstr "Me dijo, \"Has llegado muy lejos, chico.\nHas luchado muy duro por tu cuenta.\""

#. y4:line_status=translated
msgctxt "416_Saejima"
msgid "And then he took care of everything－gettin' Yasuko\\r\ninto the hospital, even payin' for her surgery."
msgstr "Y después se ocupó de todo- consiguió una habitación\npara Yasuko en el hospital, incluso pago por su cirugía."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=31
#. y4:msg_location=T0.P31
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "428_Tadashi"
msgid "Wow. All that happened to you?"
msgstr "Guau. ¿Te paso todo eso?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=32
#. y4:msg_location=T0.P32
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "440_Saejima"
msgid "When I first met ya, you reminded me of... me."
msgstr "Cuando te conocí, me recordabas a... mi."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "452_Tadashi"
msgid "And that's why... that's why you helped me?"
msgstr "Entonces..., fue por eso... ¿Por esa razón me ayudaste?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=34
#. y4:msg_location=T0.P34
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "464_Saejima"
msgid "Yup. It was my turn to pay that kindness forward."
msgstr "Sí, me tocaba a mí devolver esa amabilidad."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "476_Tadashi"
msgid "......"
msgstr "......"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=36
#. y4:msg_location=T0.P36
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "488_Saejima"
msgid "Do ya wanna help your sister, Tadashi? Whatever it takes?"
msgstr "¿Quieres ayudar a tu hermana, Tadashi? ¿Cueste lo que cueste?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=37
#. y4:msg_location=T0.P37
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "500_Tadashi"
msgid "Uh-huh. Whatever it takes. I'm scared, but nobody's gonna stop me... not even you!"
msgstr "Sí. Haré lo que sea necesario. Tengo miedo,\npero nadie me va a detener... ¡Ni siquiera tú!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=38
#. y4:msg_location=T0.P38
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "512_Saejima"
msgid "Then stay outta trouble, alright? From here on, I got your back. I'm gonna see you reunited with your sister."
msgstr "Entonces mantente alejado del peligro, ¿está bien?\nAhora en adelante iremos juntos, haré que te reúnas\ncon tu hermana."

#. y4:line_status=translated
msgctxt "524_Saejima"
msgid "No one's stopped me yet－not loan sharks, not the yakuza, not the cops－so breathe easy."
msgstr "Todavía nadie consiguió detenerme - ni los prestamistas, ni los\nyakuza, ni los policías, nadie. Así que puedes estar tranquilo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=40
#. y4:msg_location=T0.P40
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "536_Tadashi"
msgid "Okay. Thank you, Uncle Suzuki!"
msgstr "Genial. ¡Gracias, tío Suzuki!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=41
#. y4:msg_location=T0.P41
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "548_Saejima"
msgid "It's Saejima. My real name... It's Taiga Saejima."
msgstr "Es Saejima. Mi nombre real... Es Taiga Saejima."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=42
#. y4:msg_location=T0.P42
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "560_Tadashi"
msgid "Oh... Thank you, Uncle Taiga!"
msgstr "Ah... ¡Gracias, tío Taiga!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=43
#. y4:msg_location=T0.P43
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "572_Tadashi"
msgid "And, uh, I'm sorry I ran off like that. It was stupid."
msgstr "Y... eh, siento haberme escapado. Fui estúpido."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=44
#. y4:msg_location=T0.P44
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "584_Saejima"
msgid "No sweat. Just goes to show how much you miss your sister."
msgstr "No hay problema. Eso solo demuestra lo mucho que extrañas\na tu hermana."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=45
#. y4:msg_location=T0.P45
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "596_Saejima"
msgid "C'mon, buddy. Let's get a move on. We're gonna save your sister!"
msgstr "Vamos, amiguito. Hay que seguir, ¡vamos a salvar a tu hermana!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=46
#. y4:msg_location=T0.P46
#. y4:msg_speaker=Tadashi
#. y4:msg_speaker_id=1
msgctxt "608_Tadashi"
msgid "Yessir!"
msgstr "¡Sí, señor!"
