#. y4:msg_branch_choice=That last one's pretty obvious, don't you think?
msgctxt "8988_Noa"
msgid "Well... Maybe a masochist?"
msgstr "Bueno... ¿Tal vez a una masoquista?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
