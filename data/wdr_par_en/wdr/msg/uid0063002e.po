#. y4:msg_type=id
#. y4:msg_label=Nombre interno
#. y4:msg_id_index=0
msgctxt "4812"
msgid "Shizuka"
msgstr "Shizuka"

#. y4:msg_type=id
#. y4:msg_label=Nombre interno
#. y4:msg_id_index=1
msgctxt "4816"
msgid "Kiryu"
msgstr "Kiryu"

msgctxt "256_Shizuka"
msgid "Hehe. I can't wait to go karaoke with you. <Color:7>♥<Color:Default>"
msgstr "Je, je. No puedo esperar para ir al karaoke con usted. <Color:7>♥<Color:Default>"

msgctxt "268_Shizuka"
msgid "Now, what should I sing? How about \"Raindrops\"? <Color:7>♥<Color:Default>"
msgstr "Ahora, ¿qué debería cantar? ¿Qué tal \"Raindrops\"? <Color:7>♥<Color:Default>"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=0
msgctxt "280_Shizuka"
msgid "Hehe. I think I was able to sing that fairly well!"
msgstr "Je, je. ¡Creo que pude cantar eso bastante bien!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
