msgctxt "2624_Tanimura"
msgid "[It's likely he got involved in something.]"
msgstr "[Lo más probable es que se haya involucrado en alguna cosa.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=10
#. y4:msg_phrase=26
#. y4:msg_location=T10.P26
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "2636_Nair"
msgid "[Garcia...]"
msgstr "[Garcia...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=10
#. y4:msg_phrase=27
#. y4:msg_location=T10.P27
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2648_Tanimura"
msgid "[Is there any way you can contact him?]"
msgstr "[¿Hay alguna manera en la que pueda contactarlo?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=10
#. y4:msg_phrase=28
#. y4:msg_location=T10.P28
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "2660_Nair"
msgid "[I haven't had the chance to give him the cell phone I got from Marcos yet.]"
msgstr "[No, no tuve oportunidad de darle el teléfono que me dio Marcos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=10
#. y4:msg_phrase=29
#. y4:msg_location=T10.P29
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2672_Tanimura"
msgid "[This may not be the best time to sit back and wait patiently.]"
msgstr "[Puede que este no sea el mejor momento para quedarse a esperar\npacientemente.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=10
#. y4:msg_phrase=30
#. y4:msg_location=T10.P30
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2684_Tanimura"
msgid "[I'll go and look for more clues. Something might come in on the <Color:7>radio receiver<Color:Default>.]"
msgstr "[Iré a buscar más pistas. Algo podría sonar en la <Color:7>radio<Color:Default>.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=10
#. y4:msg_phrase=31
#. y4:msg_location=T10.P31
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2696_Tanimura"
msgid "[I'll let you know as soon as I hear something.]"
msgstr "[Tan pronto como sepa algo te lo haré saber.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=10
#. y4:msg_phrase=32
#. y4:msg_location=T10.P32
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "2708_Nair"
msgid "[Got it. Thanks.]"
msgstr "[Está bien. Gracias.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=0
#. y4:msg_location=T11.P0
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "2768_Nair"
msgid "[Ohhh! I lost again! I know it's just sparring, but I really hate losing.]"
msgstr "[¡Aaah! ¡Perdí de nuevo! Sé que es solo un entrenamiento, pero\nrealmente odio perder.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=1
#. y4:msg_location=T11.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2780_Tanimura"
msgid "[I know exactly how you feel. But thanks to you, I think I've gotten the hang of dealing with enemies after parrying.]"
msgstr "[Sé cómo te sientes. Pero gracias a ti, aprendí a lidiar contra\nlos enemigos después de hacerles un parry.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=3
#. y4:msg_location=T11.P3
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "2804_Marcos"
msgid "[Nair! I got some big news!]"
msgstr "[¡Nair! ¡Tengo una gran noticia!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=4
#. y4:msg_location=T11.P4
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "2816_Nair"
msgid "[What is it?]"
msgstr "[¿Qué es?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=5
#. y4:msg_location=T11.P5
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "2828_Marcos"
msgid "[Oh, Tanimura-san's here, too. Perfect timing.]"
msgstr "[Ah, y Tanimura-san también está aquí. Perfecto.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=6
#. y4:msg_location=T11.P6
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2840_Tanimura"
msgid "[What's the news?]"
msgstr "[¿De qué se trata?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=7
#. y4:msg_location=T11.P7
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "2852_Marcos"
msgid "[Someone sighted the same GG that was seen at the club. We now know of a building he apparently enters every night.]"
msgstr "[Alguien vio al mismo GG que estaba en aquel club. Ahora sabemos\nde un edificio al cual va prácticamente todas las noches.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=8
#. y4:msg_location=T11.P8
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2864_Tanimura"
msgid "[Good work. If that GG is our killer, then that building could very well be his hideout.]"
msgstr "[Buen trabajo. Si ese GG es nuestro asesino, es probable que ese\nedificio sea su escondite.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=9
#. y4:msg_location=T11.P9
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "2876_Nair"
msgid "[Where is the building?]"
msgstr "[¿Dónde está el edificio?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=10
#. y4:msg_location=T11.P10
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "2888_Marcos"
msgid "[It's over on Pink Street.]"
msgstr "[Está en la calle Pink.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=11
#. y4:msg_location=T11.P11
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "2900_Nair"
msgid "[Let's go check it out then.]"
msgstr "[Entonces vayamos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=12
#. y4:msg_location=T11.P12
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2912_Tanimura"
msgid "[Wait. You need a warrant to just enter a building like that.]"
msgstr "[Un momento. Necesitan una orden para entrar a un edificio.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=13
#. y4:msg_location=T11.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2924_Tanimura"
msgid "[And to get a warrant, you gotta have some degree of evidence.]"
msgstr "[Y para obtener una orden, necesitan tener evidencia.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=14
#. y4:msg_location=T11.P14
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "2936_Marcos"
msgid "[Sometimes I get fed up with the amount of paperwork here. I had no idea you were such a straight-edge cop, Tanimura-san.]"
msgstr "[A veces me harta la cantidad de papeleo que se hace aquí.\nNo tenía idea de que fueras un policía tan estricto,\nTanimura-san.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=15
#. y4:msg_location=T11.P15
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2948_Tanimura"
msgid "[That's not it. If I'm the one storming into a building, I couldn't care less about a piece of paper.]"
msgstr "[No es eso. Si fuera yo quien irrumpiera el edificio, no me\nimportaría en lo más mínimo lo que dice un pedazo de papel.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=16
#. y4:msg_location=T11.P16
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2960_Tanimura"
msgid "[But your position is a bit more complicated.]"
msgstr "[Pero la situación de ustedes es más complicada.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=17
#. y4:msg_location=T11.P17
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2972_Tanimura"
msgid "[If you guys enter illegally and get caught, your investigation is pretty much over.]"
msgstr "[Si entran de manera ilegal y los atrapan, cerrarían la\ninvestigación inmediatamente.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=18
#. y4:msg_location=T11.P18
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "2984_Nair"
msgid "[You've got a point. I guess we'd best stick to Japanese rules to avoid a load of problems.]"
msgstr "[Tienes razón. Creo que será mejor seguir las reglas japonesas\npara evitar problemas.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=19
#. y4:msg_location=T11.P19
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2996_Tanimura"
msgid "[We'll have to go about this carefully. First, go by that building and find out for sure if it is in fact the right GG.]"
msgstr "[Debemos abordar esto con cuidado. Primero, ve a ese edificio y\nasegúrate de que realmente sea el GG que buscamos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=20
#. y4:msg_location=T11.P20
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3008_Tanimura"
msgid "[If you get the evidence, I'll take care of the paperwork. Then we can make our move.]"
msgstr "[Si consigues la evidencia, yo me haré cargo del papeleo.\nDespués podremos actuar.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=21
#. y4:msg_location=T11.P21
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3020_Marcos"
msgid "[Got it. I'll look into it then.]"
msgstr "[Entendido. Me pondré a investigar.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=22
#. y4:msg_location=T11.P22
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3032_Marcos"
msgid "[Nair, did you hear from Garcia?]"
msgstr "[Nair, ¿sabes algo de Garcia?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=23
#. y4:msg_location=T11.P23
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3044_Nair"
msgid "[Not a word. I just hope he's okay...]"
msgstr "[Nada. Solo espero que esté bien...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=24
#. y4:msg_location=T11.P24
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3056_Marcos"
msgid "[I've got a bad feeling about this. I'll see if I can find out anything.]"
msgstr "[Tengo un mal presentimiento. Veré si puedo averiguar algo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=25
#. y4:msg_location=T11.P25
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3068_Marcos"
msgid "[This is a Japanese cell phone. Take it. It's pre-paid, so you shouldn't run in to any problems.]"
msgstr "[Este es un teléfono japonés. Tómalo. Es prepago, así que no\ndeberías tener ningún problema.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=26
#. y4:msg_location=T11.P26
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3080_Nair"
msgid "[Thank you. This should come in handy.]"
msgstr "[Gracias. Me será muy útil.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=27
#. y4:msg_location=T11.P27
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3092_Tanimura"
msgid "[I haven't seen pre-paid phones in a long time. Good job finding one.]"
msgstr "[Hace mucho que no veía un teléfono prepago. Buen trabajo\npor encontrarte con uno.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=28
#. y4:msg_location=T11.P28
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3104_Marcos"
msgid "[You can still find them in some places. Pretty lucky that such services are still around.]"
msgstr "[Todavía se pueden conseguir en algunos lugares. Es una suerte\nque los servicios todavía funcionen.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=29
#. y4:msg_location=T11.P29
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3116_Marcos"
msgid "[I'll give you one for Garcia, too. Make sure he gets it when he comes back.]"
msgstr "[Te daré uno, para Garcia también. Asegúrate de dárselo\ncuando regrese.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=30
#. y4:msg_location=T11.P30
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3128_Nair"
msgid "[Got it, thanks.]"
msgstr "[Sí, entiendo. Gracias.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=31
#. y4:msg_location=T11.P31
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3140_Marcos"
msgid "[All right. I'll be back later.]"
msgstr "[Bueno. Volveré más tarde.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=33
#. y4:msg_location=T11.P33
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3164_Tanimura"
msgid "[That guy really works hard.]"
msgstr "[Ese tipo sí que trabaja duro.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=34
#. y4:msg_location=T11.P34
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3176_Nair"
msgid "[My brother always used to say Marcos would become a police officer one day, because of his strong sense of justice.]"
msgstr "[Mi hermano siempre decía que Marcos convertiría en policía\nalgún día. Por su fuerte sentido de la justicia.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=35
#. y4:msg_location=T11.P35
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3188_Nair"
msgid "[And now Marcos is the one chasing the killer who murdered him... It's kind of ironic.]"
msgstr "[Y ahora Marcos está detrás del hombre, quien lo asesino...\nQué ironía.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=36
#. y4:msg_location=T11.P36
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3200_Tanimura"
msgid "[You guys were all pretty close, weren't you?]"
msgstr "[Ustedes eran muy cercanos, ¿no?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=37
#. y4:msg_location=T11.P37
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3212_Nair"
msgid "[My brother didn't really get along with my parents, so he always confided in me.]"
msgstr "[Mi hermano no se llevaba muy bien con mis padres, así que él\nsiempre se apoyaba en mí.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=38
#. y4:msg_location=T11.P38
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3224_Nair"
msgid "[Marcos was also one of his only friends. He wasn't really a people person.]"
msgstr "[Marcos también era uno de sus pocos amigos. No era una persona\nmuy sociable.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=39
#. y4:msg_location=T11.P39
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3236_Tanimura"
msgid "[I see. So Marcos working on this case is his way of honoring your brother.]"
msgstr "[Entiendo. Entonces, que marcos trabaje en esta investigación\nes una manera de honrar la memoria de tu hermano.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=40
#. y4:msg_location=T11.P40
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3248_Nair"
msgid "[All we can do now is chase down the killer and make him pay.]"
msgstr "[Lo único que podemos hacer es atrapar al asesino y hacer que\nlo pagué.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=41
#. y4:msg_location=T11.P41
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3260_Tanimura"
msgid "[Yeah. Nobody can change the past.]"
msgstr "[Sí. Nadie puede cambiar el pasado.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=42
#. y4:msg_location=T11.P42
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3272_Nair"
msgid "[Exactly. There's no point in moaning about it. Once we've put an end to this thing, let's go out for some celebratory drinks!]"
msgstr "[Exacto. No tiene sentido quejarse. Una vez le pongamos fin\na esto, ¡salgamos a celebrarlo con unas copas!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=43
#. y4:msg_location=T11.P43
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3284_Tanimura"
msgid "[Heheh. Sounds good to me.]"
msgstr "[Je, je... Me parece bien.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=0
#. y4:msg_location=T12.P0
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3344_Nair"
msgid "[I give up! Tanimura-san, you sure are good!]"
msgstr "[¡Me rindo! Tanimura-san, ¡eres muy bueno!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=1
#. y4:msg_location=T12.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3356_Tanimura"
msgid "[That was a good spar. I think I've got the hang of this now.]"
msgstr "[Fue una buena pelea. Creo que ya le estoy tomando\nel ritmo a esto.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=3
#. y4:msg_location=T12.P3
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3380_Nair"
msgid "[Marcos should be back here any minute...]"
msgstr "[Marcos debería estar por volver...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=4
#. y4:msg_location=T12.P4
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3392_Marcos"
msgid "[You talking about me? Good things only, I trust!]"
msgstr "[¿Hablabas de mí? ¡Espero que de cosas buenas!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=5
#. y4:msg_location=T12.P5
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3404_Nair"
msgid "[Marcos! Did you visit that club?]"
msgstr "[¡Marcos! ¿Fuiste a ese club?]"

#. y4:line_status=translated
msgctxt "3416_Marcos"
msgid "[I became friends with that interpreter witness. He showed me around－was a big help.]"
msgstr "[Me hice amigo de aquel intérprete que lo había visto todo.\nMe enseño el lugar - fue de gran ayuda.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=7
#. y4:msg_location=T12.P7
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3428_Marcos"
msgid "[According to staff working at the club that day, GG wouldn't say anything about himself until he started drinking.]"
msgstr "[Según los empleados que trabajaron ese día, GG no decía nada\nsobre él hasta que empezara a beber.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=8
#. y4:msg_location=T12.P8
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3440_Marcos"
msgid "[That club is frequented by more foreigners than Japanese, so it wasn't a language issue.]"
msgstr "[El club es frecuentado por extranjeros más que japoneses,\nasí que no fue por alguna barrera de idioma.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=9
#. y4:msg_location=T12.P9
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3452_Tanimura"
msgid "[Usually people talk up a storm when they're at a place they can talk in their native tongue.]"
msgstr "[Por lo general, la gente suele hablar sin parar cuando están en\nun lugar donde pueden hablar su lengua materna.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=10
#. y4:msg_location=T12.P10
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3464_Marcos"
msgid "[Exactly. People that can't speak Japanese are tempted to go to places like that to meet people that they can talk with.]"
msgstr "[Exacto. Las personas que no hablan japonés suelen ir a ese\ntipo de lugares para conocer gente con las que puedan hablar.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=11
#. y4:msg_location=T12.P11
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3476_Marcos"
msgid "[But that's not the case with GG. He went to the club by himself and drank without talking to anyone at all.]"
msgstr "[Pero en el caso de GG no fue así. Él llegó al club solo y\nse quedó bebiendo sin hablar con nadie.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=12
#. y4:msg_location=T12.P12
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3488_Nair"
msgid "[What if...]"
msgstr "[Y si fuera...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=13
#. y4:msg_location=T12.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3500_Tanimura"
msgid "[It was a rendezvous.]"
msgstr "[Un encuentro.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=14
#. y4:msg_location=T12.P14
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3512_Marcos"
msgid "[Yes, that's the only possibility. GG was there to meet someone else.]"
msgstr "[Sí, es la única posibilidad. GG fue para encontrarse con\nalguien más.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=15
#. y4:msg_location=T12.P15
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3524_Nair"
msgid "[I wonder if that was the reason he came to Japan... Or is there something else?]"
msgstr "[Me pregunto si esa fue la razón por la que vino a Japón...\n¿O será algo más?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=16
#. y4:msg_location=T12.P16
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3536_Tanimura"
msgid "[If that was the case, why would he get stupid drunk and yell like that?]"
msgstr "[Si ese fuera el caso, ¿por qué haría la estupidez de \nembriagarse y gritar de esa manera?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=17
#. y4:msg_location=T12.P17
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3548_Nair"
msgid "[Maybe he drank too much while he was waiting. But it is a pretty dumb thing to do.]"
msgstr "[Tal vez se pasó bebiendo mientras esperaba. Pero sí, es algo\nmuy estúpido de hacer.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=18
#. y4:msg_location=T12.P18
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3560_Marcos"
msgid "[In either case, there is a strong possibility that the GG at that club is the very same GG that we've been looking for.]"
msgstr "[De cualquier manera, hay una posibilidad muy grande que el\nGG que estaba en ese club sea el mismo que buscamos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=19
#. y4:msg_location=T12.P19
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3572_Marcos"
msgid "[I'm close with that interpreter now too, so I'll try and dig up more info if I can.]"
msgstr "[Además, me llevo bien con aquel intérprete, así que intentaré\nobtener más información si puedo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=20
#. y4:msg_location=T12.P20
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3584_Nair"
msgid "[Right. Thanks, Marcos.]"
msgstr "[Está bien. Gracias, Marcos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=21
#. y4:msg_location=T12.P21
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3596_Marcos"
msgid "[By the way, where's Garcia? Wasn't he supposed to be at the embassy?]"
msgstr "[Por cierto, ¿dónde está Garcia? ¿No se suponía que iba a estar\nen la embajada?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=22
#. y4:msg_location=T12.P22
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3608_Nair"
msgid "[Apparently, he ran into some trouble getting the embassy to contact the Japanese authorities.]"
msgstr "[Al parecer, tuvo algún problema para que la embajada se\ncomunicara con las autoridades japonesas.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=23
#. y4:msg_location=T12.P23
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3620_Nair"
msgid "[All I was told is that it's going to take a bit more time.]"
msgstr "[Lo único que dijeron fue que tomara un poco más de tiempo]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=24
#. y4:msg_location=T12.P24
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3632_Tanimura"
msgid "[Garcia? Another friend of yours?]"
msgstr "[¿Garcia? ¿Otro amigo tuyo?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=25
#. y4:msg_location=T12.P25
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3644_Nair"
msgid "[Yeah. He knows a lot about international relations, so I'm having him take care of our communications through the embassy.]"
msgstr "[Sí. Sabe mucho sobre relaciones internacionales, así que le\npedí que se encargara de las comunicaciones con la embajada.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=26
#. y4:msg_location=T12.P26
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3656_Tanimura"
msgid "[Good thinking. If that GG is our killer, then that's probably the best way.]"
msgstr "[Bien pensado. Si ese GG es nuestro asesino, entonces\nprobablemente, sea la mejor manera.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=27
#. y4:msg_location=T12.P27
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3668_Marcos"
msgid "[Either way, we have to keep investigating while Garcia does his part.]"
msgstr "[Sea como sea, debemos seguir investigando mientras Garcia\nhace su parte.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=28
#. y4:msg_location=T12.P28
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3680_Marcos"
msgid "[I'm going to go do some more work. When Garcia gets back, tell him to stay here and wait for me.]"
msgstr "[Voy a seguir con lo mío. Cuando regrese Garcia, dile que se\nquede y espere por mí.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=9
#. y4:msg_location=T6.P9
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3692_Nair"
msgid "[Got it.]"
msgstr "[Sí. Entiendo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=31
#. y4:msg_location=T12.P31
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3716_Tanimura"
msgid "[Marcos is quite the hard worker.]"
msgstr "[Marcos es muy dedicado.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=32
#. y4:msg_location=T12.P32
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3728_Nair"
msgid "[He feels the same way I do. He was a friend of my brother.]"
msgstr "[Él siente lo mismo que yo. Era el amigo de mi hermano.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=33
#. y4:msg_location=T12.P33
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3740_Tanimura"
msgid "[Oh, really?]"
msgstr "[Ah, ¿sí?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=34
#. y4:msg_location=T12.P34
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3752_Nair"
msgid "[My brother was a genuinely kind and intelligent guy. Marcos and I both really loved him.]"
msgstr "[Mi hermano era un chico muy amable e inteligente. Marcos y yo\nlo queríamos mucho.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=35
#. y4:msg_location=T12.P35
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3764_Nair"
msgid "[That's why we can't believe what happened.]"
msgstr "[Por eso no podemos creer que todo eso sucediera.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=18
#. y4:msg_location=T6.P18
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "3776_Tanimura"
msgid "[......]"
msgstr "[......]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=37
#. y4:msg_location=T12.P37
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3788_Nair"
msgid "[Marcos worked as a cop at the time, and he helped me out when I decided to become one too, in order to find the killer.]"
msgstr "[Marcos ya trabajaba en la policía en ese momento y me ayudo\ncuando decidí serlo también, con el fin de encontrar al\nasesino.]"

#. y4:line_status=translated
msgctxt "3800_Nair"
msgid "[He's a friend－a truly irreplaceable friend.]"
msgstr "[Él es un amigo - un amigo irremplazable.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=39
#. y4:msg_location=T12.P39
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3812_Tanimura"
msgid "[I see.]"
msgstr "[Entiendo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=40
#. y4:msg_location=T12.P40
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3824_Nair"
msgid "[Well, waiting here may be my job, but this is just boring.]"
msgstr "[Bueno, esperar todo el día en este lugar es mi trabajo, pero\ntambién es muy aburrido.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=41
#. y4:msg_location=T12.P41
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3836_Nair"
msgid "[Come back whenever you have time, okay?]"
msgstr "[Vuelve cuando tengas tiempo, ¿sí?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=42
#. y4:msg_location=T12.P42
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3848_Tanimura"
msgid "[For sure.]"
msgstr "[Por supuesto.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=0
#. y4:msg_location=T13.P0
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3908_Nair"
msgid "[You're not bad, Tanimura-san!]"
msgstr "[¡Nada mal, Tanimura-san!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=1
#. y4:msg_location=T13.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3920_Tanimura"
msgid "[That really taught me a lot. I think I got the hang of parrying now.]"
msgstr "[Aprendí mucho. Creo que ahora sé cómo hacer un parry.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=3
#. y4:msg_location=T13.P3
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3944_Nair"
msgid "[Great job! You have a lot of techniques I've never seen before. That was very educational.]"
msgstr "[¡Buen trabajo! Tienes muchas técnicas que jamás había\nvisto antes. Eso fue muy educativo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=4
#. y4:msg_location=T13.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "3956_Tanimura"
msgid "[Glad to be of service. Let's do it again sometime.]"
msgstr "[Encantado de ayudar. Hagámoslo de nuevo otro día.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=5
#. y4:msg_location=T13.P5
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "3968_Nair"
msgid "[Sounds good.]"
msgstr "[Suena bien.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=6
#. y4:msg_location=T13.P6
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=46
msgctxt "3980_Man"
msgid "[Hey, Nair!]"
msgstr "[¡Naaairu!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=8
#. y4:msg_location=T13.P8
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4004_Nair"
msgid "[Oh, Marcos! How was the investigation?]"
msgstr "[Ah, Marcos. ¿Cómo fue la investigación?]"

#. y4:line_status=translated
msgctxt "4016_Marcos"
msgid "[I got some good intel－ Hm? Who's this?]"
msgstr "[Tengo muy buena información- ¿eh? ¿Quién es él?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=10
#. y4:msg_location=T13.P10
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4028_Nair"
msgid "[This is Tanimura-san. He's a Japanese detective and is helping with the investigation.]"
msgstr "[Él es Tanimura-san. Es un detective japonés y nos está ayudando\ncon la investigación.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=11
#. y4:msg_location=T13.P11
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4040_Marcos"
msgid "[Really? That's great!]"
msgstr "[Oh, ¿de verdad? ¡Estupendo!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=12
#. y4:msg_location=T13.P12
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4052_Marcos"
msgid "[My name is Marcos. I'm also an investigator. I came to Japan with Nair.]"
msgstr "[Me llamo Marcos. Yo también soy un investigador. Vine a Japón\ncon Nair.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=13
#. y4:msg_location=T13.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4064_Tanimura"
msgid "[I'm Tanimura. Nice to meet you, Marcos. So how about that good intel?]"
msgstr "[Yo soy Tanimura. Encantado, Marcos. Entonces dices que,\n¿tienes buena información?]"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=14
#. y4:msg_phrase=88
#. y4:msg_location=T14.P88
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sparring
msgctxt "4076_Marcos"
msgid "[Right.]"
msgstr "[Sí.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=15
#. y4:msg_location=T13.P15
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4088_Marcos"
msgid "[GG was spotted nearby, at a club frequented by foreigners.]"
msgstr "[GG fue visto en las cercanías, en un club frecuentado por\nextranjeros.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=16
#. y4:msg_location=T13.P16
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4100_Tanimura"
msgid "[GG?]"
msgstr "[¿GG?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=17
#. y4:msg_location=T13.P17
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4112_Nair"
msgid "[The name of our suspect. He uses fake names so no one can track him down.]"
msgstr "[El nombre del sospechoso. Usa seudónimos para que nadie pueda\nrastrearlo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=18
#. y4:msg_location=T13.P18
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4124_Marcos"
msgid "[It's short for 'good game,' like what you'd say after playing a round of something.]"
msgstr "[Es solo una abreviatura de \"good game\", como algo que dirías\ndespués de jugar alguna partida de algo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=19
#. y4:msg_location=T13.P19
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4136_Marcos"
msgid "[It's a cynical way to poke fun at the people he beats, I guess. As if it were a game.]"
msgstr "[Debe ser una forma cínica de burlarse de la gente que derrota.\nComo si fuera un juego]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=20
#. y4:msg_location=T13.P20
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4148_Tanimura"
msgid "[I see now. Doesn't sound like he takes the police very seriously.]"
msgstr "[Entiendo. Suena como que no se toma a la policía muy en serio.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=21
#. y4:msg_location=T13.P21
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4160_Marcos"
msgid "[You got that right. But it seems that the very same GG was just drinking at a club.]"
msgstr "[Exactamente. Aunque, parece que GG solo estaba bebiendo en\naquel club.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=22
#. y4:msg_location=T13.P22
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4172_Nair"
msgid "[Where did you hear that?]"
msgstr "[¿Dónde has oído eso?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=23
#. y4:msg_location=T13.P23
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4184_Marcos"
msgid "[From this guy who happened to be there. He works as an interpreter.]"
msgstr "[De un tipo que casualmente estaba ahí. Trabaja como interprete.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=24
#. y4:msg_location=T13.P24
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4196_Marcos"
msgid "[Apparently he was drunk and yelling, \"I'm GG!\" at the top of his lungs.]"
msgstr "[Al parecer estaba borracho y gritaba, \"¡Soy GG!\" a todo pulmón.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=25
#. y4:msg_location=T13.P25
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4208_Tanimura"
msgid "[Wait a second. That doesn't necessarily mean he's the same GG you guys are looking for.]"
msgstr "[Un momento. Eso no quiere decir que sea el mismo GG que ustedes\nestán buscando.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=26
#. y4:msg_location=T13.P26
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4220_Marcos"
msgid "[You're right. But it's at least a lead to follow.]"
msgstr "[Tienes razón. Pero al menos es una pista a seguir.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=27
#. y4:msg_location=T13.P27
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4232_Marcos"
msgid "[I'm going over to the club now to find out everything I can.]"
msgstr "[Voy a ir al club ahora mismo para averiguar todo lo que pueda.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=28
#. y4:msg_location=T13.P28
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4244_Nair"
msgid "[Thanks, Marcos. Let me know if something turns up.]"
msgstr "[Gracias, Marcos. Avísame si surge algo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=8
#. y4:msg_phrase=6
#. y4:msg_location=T8.P6
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4256_Marcos"
msgid "[Will do.]"
msgstr "[Lo haré.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=31
#. y4:msg_location=T13.P31
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4280_Nair"
msgid "[Just wait... Won't be long now.]"
msgstr "[Solo espera un poco más... No tardaré.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=18
#. y4:msg_location=T6.P18
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4292_Tanimura"
msgid "[......]"
msgstr "[......]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=33
#. y4:msg_location=T13.P33
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4304_Tanimura"
msgid "[I forgot, I wanted to ask you something.]"
msgstr "[Casi se me olvida, quería preguntarte algo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=34
#. y4:msg_location=T13.P34
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4316_Nair"
msgid "[What?]"
msgstr "[¿Qué?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=35
#. y4:msg_location=T13.P35
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4328_Tanimura"
msgid "[What crime did this GG commit?]"
msgstr "[¿Qué crimen cometió ese tal GG?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=18
#. y4:msg_location=T6.P18
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4340_Nair"
msgid "[......]"
msgstr "[......]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=37
#. y4:msg_location=T13.P37
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4352_Nair"
msgid "[He murdered an entire family and stole their money. And in the most atrocious of ways.]"
msgstr "[Asesino a una familia entera y robo todo su dinero.\nDe la manera más repulsiva y atroz.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=38
#. y4:msg_location=T13.P38
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4364_Nair"
msgid "[Two parents and their son. The crime scene was so horrific, the victims bodies were unrecognizable...]"
msgstr "[Asesino al niño junto a sus dos padres. La escena era tan\nhorrible que los cuerpos de las víctimas eran irreconocibles...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=39
#. y4:msg_location=T13.P39
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4376_Tanimura"
msgid "[He did all that just for money?]"
msgstr "[¿Lo hizo solo por dinero?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=40
#. y4:msg_location=T13.P40
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4388_Nair"
msgid "[I don't know. That family did nothing to deserve such a cruel fate.]"
msgstr "[No lo sé. Esa familia no hizo nada como para merecer un destino\ntan cruel.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=41
#. y4:msg_location=T13.P41
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4400_Tanimura"
msgid "[Why do you say that? Perhaps he had some really bad grudge or something?]"
msgstr "[¿Por qué piensas eso? Tal vez les guardaba rencor o\nalgo parecido.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=42
#. y4:msg_location=T13.P42
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4412_Nair"
msgid "[No! Not in a million years!]"
msgstr "[¡Que no! ¡Ni ahora ni en mil años!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=43
#. y4:msg_location=T13.P43
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4424_Tanimura"
msgid "[Nair...]"
msgstr "[Nair...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=44
#. y4:msg_location=T13.P44
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4436_Nair"
msgid "[I just... won't... believe it...]"
msgstr "[Yo... no..., no lo puedo creer...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=45
#. y4:msg_location=T13.P45
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4448_Tanimura"
msgid "[Don't tell me...]"
msgstr "[No me digas que...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=18
#. y4:msg_location=T6.P18
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4460_Nair"
msgid "[......]"
msgstr "[......]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=47
#. y4:msg_location=T13.P47
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4472_Nair"
msgid "[I'm afraid so. It was my parents and brother that he killed.]"
msgstr "[Me temo que sí. Eran mis padres y mi hermano los que ese\nhombre asesino.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=48
#. y4:msg_location=T13.P48
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4484_Nair"
msgid "[I was safe at a friend's house that day.]"
msgstr "[Yo estaba en la casa de una amiga ese día.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=18
#. y4:msg_location=T6.P18
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4496_Tanimura"
msgid "[......]"
msgstr "[......]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=50
#. y4:msg_location=T13.P50
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4508_Nair"
msgid "[Sorry, I didn't mean to get so gloomy all of a sudden.]"
msgstr "[Discúlpame, no quería ponerme tan melancólica de repente.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=51
#. y4:msg_location=T13.P51
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4520_Tanimura"
msgid "[No, don't apologize. I'm sorry for making you talk about it.]"
msgstr "[Está bien, no te disculpes. Siento haberte hecho hablar\nde ello.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=52
#. y4:msg_location=T13.P52
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4532_Nair"
msgid "[I'm fine. I became a detective for the sole purpose of personally solving this case.]"
msgstr "[No pasa nada. Me hice detective con el propósito de resolver\neste caso personalmente]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=18
#. y4:msg_location=T6.P18
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "4544_Tanimura"
msgid "[......]"
msgstr "[......]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=54
#. y4:msg_location=T13.P54
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4556_Nair"
msgid "[Don't look so upset! We have to stay sharp!]"
msgstr "[¡No te desanimes! ¡Hay que mantenerse alertas!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=55
#. y4:msg_location=T13.P55
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4568_Tanimura"
msgid "[Right...]"
msgstr "[Cierto...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=56
#. y4:msg_location=T13.P56
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "4580_Nair"
msgid "[Come back to spar again, okay? I'll show you how a real fighter does it next time!]"
msgstr "[Vuelve a entrenar de nuevo, ¿sí? ¡La próxima te demostraré como\nse pelea de verdad!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=43
#. y4:msg_location=T11.P43
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "4592_Tanimura"
msgid "[Heheh. Sounds good to me.]"
msgstr "[Je, je... Me parece bien.]"

