msgctxt "2520_峰村七海：源氏名"
msgid "You have a lot of stuff with you... Do you have some business to attend to? You should take care of that first."
msgstr "Trae muchas cosas... ¿Tiene algo que hacer? Si es así, termine con eso primero."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "2532_Tanimura"
msgid "Right. Sorry."
msgstr "Sí, lo siento."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "2544_峰村七海：源氏名"
msgid "I'll be here, waiting. Hurry back!"
msgstr "Lo estaré esperando aquí. ¡Dese prisa!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "2556_峰村七海：源氏名"
msgid "When are you gonna grow up?"
msgstr "¿Cuándo vas a madurar?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Host
#. y4:msg_speaker_id=4
msgctxt "2568_Host"
msgid "I'm really sorry! I'll find her and get the money back. Don't worry!"
msgstr "¡Lo siento mucho! La encontraré y traeré el dinero de vuelta. ¡No se preocupe!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "2580_峰村七海：源氏名"
msgid "Just make sure you get the money back to me. I worked my fingers to the bone to earn it!"
msgstr "Solo tráeme mi dinero. ¡Me rompí los huesos para conseguirlo!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Host
#. y4:msg_speaker_id=4
msgctxt "2592_Host"
msgid "I know. And thanks. Bye."
msgstr "Lo sé. Gracias. Nos vemos."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
