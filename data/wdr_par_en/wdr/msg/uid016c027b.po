#. y4:msg_location=T11.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "1740_Maya"
msgid "You're very fashion-conscious, aren't you?"
msgstr "Eres fanático de la moda, ¿no?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=1
#. y4:msg_location=T11.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "1752_Kiryu"
msgid "You think so?"
msgstr "¿De verdad lo cree?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=2
#. y4:msg_location=T11.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "1764_Maya"
msgid "Yeah."
msgstr "Sí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=3
#. y4:msg_location=T11.P3
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "1776_Maya"
msgid "Everybody should pay more attention to fashion once they're adults. As long as they have the money for it, of course."
msgstr "Todo el mundo debería prestar más atención a la moda cuando sean adultos. Siempre y cuando tengan dinero para costearlo, claro está."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=4
#. y4:msg_location=T11.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "1788_Kiryu"
msgid "You keep an eye on that kind of thing, huh?"
msgstr "Estás atenta en ese tipo de cosas, ¿eh?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=5
#. y4:msg_location=T11.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
#. y4:msg_decision_group=1
#. y4:msg_decision_choices=1. This is the only suit I have. -> T11.P6 | 2. It takes more than money to be well-dressed. -> T11.P11 | 3. You shouldn't judge a man by his clothes. -> T11.P16
msgctxt "1800_Maya"
msgid "Yep. I'm kind of picky when it comes to clothes."
msgstr "Sip. Soy exigente cuando se trata de la ropa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=6
#. y4:msg_location=T11.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=This is the only suit I have.
msgctxt "1812_Kiryu"
msgid "I like to dress casual when I'm not working. In fact, this is the only suit I have."
msgstr "Me gusta vestirme casual cuando no estoy trabajando. De hecho, este es el único traje que tengo disponible."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=7
#. y4:msg_location=T11.P7
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=This is the only suit I have.
msgctxt "1824_Maya"
msgid "Oh? Well, it's a nice one."
msgstr "¿Oh? Bueno, es una bonita."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=8
#. y4:msg_location=T11.P8
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=This is the only suit I have.
msgctxt "1836_Maya"
msgid "A person's clothes can really affect the impression they give. And you make a great first impression."
msgstr "La ropa de una persona puede influir mucho en la impresión que da. Y tu guapo, das una muy buena impresión."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=9
#. y4:msg_location=T11.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=This is the only suit I have.
msgctxt "1848_Kiryu"
msgid "Heh, thanks. You look nice in that dress, too."
msgstr "Gracias. Te ves bien en ese vestido."

msgctxt "1860_Maya"
msgid "Really? Thank you. <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=11
#. y4:msg_location=T11.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It takes more than money to be well-dressed.
msgctxt "1872_Kiryu"
msgid "It takes more than money to be well-dressed. You have to have taste, too."
msgstr "Se necesita más que dinero para estar bien vestido. También hay que tener buen gusto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=12
#. y4:msg_location=T11.P12
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It takes more than money to be well-dressed.
msgctxt "1884_Maya"
msgid "Right! You can look great wearing old clothes, as long as they're the right old clothes."
msgstr "Sí. Puedes estar estupendo con ropa vieja, siempre que sea la ropa vieja adecuada."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=13
#. y4:msg_location=T11.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It takes more than money to be well-dressed.
msgctxt "1896_Kiryu"
msgid "I've got to pick out clothes for the kids I look after, so I guess I pay more attention to that kind of thing than most people."
msgstr "Tengo que elegir ropa para los niños que cuido, así que supongo que pongo más atención a ese tipo de cosas que la mayoría de la gente."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=14
#. y4:msg_location=T11.P14
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It takes more than money to be well-dressed.
msgctxt "1908_Maya"
msgid "Wow. You're a trendsetter, then!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=15
#. y4:msg_location=T11.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It takes more than money to be well-dressed.
msgctxt "1920_Kiryu"
msgid "Heh, sure."
msgstr "Je, como tú digas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=16
#. y4:msg_location=T11.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't judge a man by his clothes.
msgctxt "1932_Kiryu"
msgid "You shouldn't judge a man by his clothes. Some people won't look good no matter what they wear."
msgstr "No deberías juzgar a un hombre por como va vestido. A veces, algunas personas no se verán bien, sin importar que lleven puesto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=17
#. y4:msg_location=T11.P17
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't judge a man by his clothes.
msgctxt "1944_Maya"
msgid "Well, you have to wear clothes that match your body type."
msgstr "Bueno, tienes que llevar ropa que combine con tu tipo de cuerpo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=18
#. y4:msg_location=T11.P18
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't judge a man by his clothes.
msgctxt "1956_Maya"
msgid "You're nice and muscular, so you'd look great in foreign brand-name clothes."
msgstr "Eres atractivo y musculoso. Te verías bien con ropa  de marca extranjera."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=19
#. y4:msg_location=T11.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't judge a man by his clothes.
msgctxt "1968_Kiryu"
msgid "Well, clothing can be hard to move in. I often end up taking my shirt off."
msgstr "Bueno, la ropa puede ser difícil de ponerse. A menudo me termino quitando la camisa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=20
#. y4:msg_location=T11.P20
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't judge a man by his clothes.
msgctxt "1980_Maya"
msgid "Really!? That's kind of a waste."
msgstr "¿¡En serio!? Qué manera de desperdiciarlo."

msgctxt "1992_Kiryu"
msgid "I'm more confident in how I look without clothes, actually.\\r\n"
"Maybe I'll show you sometime."
msgstr "Me siento más seguro de como me veo sin ropa. De hecho,\\r tal vez te lo muestre en algún momento."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=11
#. y4:msg_phrase=22
#. y4:msg_location=T11.P22
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't judge a man by his clothes.
msgctxt "2004_Maya"
msgid "Oh! Uh, I'll think about it!"
msgstr "¡Oh!, ah, ¡lo pensaré!"

msgctxt "2016_Maya"
msgid "Welcome back. It's nice to see you again! <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=dialogue
