#. y4:msg_branch_target_text=You're pretty cute sometimes.
#. y4:msg_branch_raw=01 11 00 13 00 00 00 1d 00 00 00 00 00 00 00 00
msgctxt "13140_Akiyama"
msgid "You're pretty cute sometimes."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=20
#. y4:msg_location=T23.P20
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're pretty cute sometimes.
msgctxt "13152_Erena"
msgid "I know."
msgstr "Lo sé."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=21
#. y4:msg_location=T23.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're pretty cute sometimes.
msgctxt "13164_Akiyama"
msgid "Heheh. But don't you sometimes know exactly how a story's going to end, right when it starts?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=22
#. y4:msg_location=T23.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're pretty cute sometimes.
msgctxt "13176_Akiyama"
msgid "It's not like the two main characters aren't going to get together, right?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=23
#. y4:msg_location=T23.P23
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're pretty cute sometimes.
msgctxt "13188_Erena"
msgid "That's okay. It's not the ending that's important. It's how they get there, how they overcome the obstacles in front of them."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=24
#. y4:msg_location=T23.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're pretty cute sometimes.
msgctxt "13200_Akiyama"
msgid "Hmm... I haven't thought about it that way."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=0
#. y4:msg_location=T24.P0
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "13212_Erena"
msgid "I've never met a man like you before."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=27
#. y4:msg_location=T2.P27
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I think you've got it wrong.
msgctxt "13224_Akiyama"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=2
#. y4:msg_location=T24.P2
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "13236_Erena"
msgid "Yeah. Don't know what it is, but I really feel like I can be myself in front of you."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=3
#. y4:msg_location=T24.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "13248_Akiyama"
msgid "That's nice of you to say."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=4
#. y4:msg_location=T24.P4
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "13260_Erena"
msgid "I feel like you accept me for who I am."
msgstr ""

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=5
#. y4:msg_location=T24.P5
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=24
#. y4:msg_decision_choices=1. You can't do that with other customers? -> T24.P6 | 2. We do get along well, don't we? -> T24.P15 | 3. I'm nobody special. -> T24.P21
msgctxt "13272_Erena"
msgid "That's why I can talk to you about anything. You've really given me a lot of good advice."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=6
#. y4:msg_location=T24.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't do that with other customers?
msgctxt "13284_Akiyama"
msgid "You can't do that with other customers? Why don't you try being yourself with everyone?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=7
#. y4:msg_location=T24.P7
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't do that with other customers?
msgctxt "13296_Erena"
msgid "But I always have to leave a good impression on my customers. I can't talk about my private life."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=8
#. y4:msg_location=T24.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't do that with other customers?
msgctxt "13308_Akiyama"
msgid "But you do with me."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=9
#. y4:msg_location=T24.P9
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't do that with other customers?
msgctxt "13320_Erena"
msgid "Is that a problem?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=10
#. y4:msg_location=T24.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't do that with other customers?
msgctxt "13332_Akiyama"
msgid "A problem? Not at all. The fact that you feel you can talk about personal things with me shows that you trust me."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
