msgstr "Sé más abierta"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "2384_Employee"
msgid "Ask for your favorite dish."
msgstr "Debes pedir tu plato favorito"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "2396_Employee"
msgid "Ask for his favorite dish."
msgstr "Debes pedir su plato favorito"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "2408_Employee"
msgid "Ask for his favorite dish."
msgstr "Debes pedir su plato favorito"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "2420_Employee"
msgid "Maintain your image as a hostess."
msgstr "Mantén tu imagen de hostess"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "2432_Employee"
msgid "Create a domestic atmosphere."
msgstr "Crea una atmosfera hogareña"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "2444_Employee"
msgid "Create a domestic atmosphere."
msgstr "Crea una atmosfera hogareña"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "2456_Employee"
msgid "Go Dutch."
msgstr "Dividir la cuenta"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "2468_Employee"
msgid "Take out your wallet like you're going to pay."
msgstr "Saca tu cartera y simula que vas a pagar"

