#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4932_Maya"
msgid "Ugh... I'm tired."
msgstr "Uf... Estoy cansada."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "4944_Kiryu"
msgid "What's wrong?"
msgstr "¿Qué ocurre?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4956_Maya"
msgid "Oh, I got stopped by a policeman on the way to work today."
msgstr "Oh, es que un policía me detuvo hoy de camino al trabajo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4968_Maya"
msgid "I wasn't feeling well, so I wanted to tell him to get lost this time, but..."
msgstr "No me sentía bien, así que quería decirle que se perdiera esta vez, pero..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=4
#. y4:msg_location=T2.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "4980_Kiryu"
msgid "This time? You get questioned that often?"
msgstr "¿Esta vez? ¿Te interrogan a menudo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=5
#. y4:msg_location=T2.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4992_Maya"
msgid "Yeah. Do I look that suspicious to you?"
msgstr "Sí. ¿Crees que me veo sospechosa?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=6
#. y4:msg_location=T2.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "5004_Kiryu"
msgid "Actually..."
msgstr "De hecho..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=7
#. y4:msg_location=T2.P7
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "5016_Maya"
msgid "Heh. Well, I'm pretty used to it by now. I'd get stopped every day when I was in junior high school."
msgstr "Je. Bueno, ya estoy acostumbrada. Me detenían todos los días mientras aún cursaba la secundaria."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=8
#. y4:msg_location=T2.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "5028_Kiryu"
msgid "Every day? Wow."
msgstr "¿Todos los días? Vaya..."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=9
#. y4:msg_location=T2.P9
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=2
#. y4:msg_decision_choices=1. That's a pretty big difference. -> T2.P10 | 2. I get stopped sometimes myself. -> T2.P17 | 3. You could try to wear less flashy clothes. -> T2.P24
msgctxt "5040_Maya"
msgid "It's a lot better now. Maybe two or three times a month."
msgstr "Quizás exageré. Tal vez me detenían dos o tres veces al mes."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
