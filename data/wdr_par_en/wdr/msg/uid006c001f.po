#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Do you like hardworking men?
msgctxt "4284_Noa"
msgid "Well, I don't exactly like men because they're hard workers."
msgstr "¿Los hombres trabajadores...? No exactamente..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
