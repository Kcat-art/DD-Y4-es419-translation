#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Learn how to be a better judge of men.
msgctxt "8808_松岡里緒奈：源氏名"
msgid "Oh, so you've gone out with a lot of girls, huh? I didn't realize you were such a player."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=27
#. y4:msg_location=T12.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Learn how to be a better judge of men.
msgctxt "8820_Kiryu"
msgid "Uh, I didn't mean it that way. A guy like me with a lot of life experience learns to be a good judge of character."
msgstr "No quise decir eso. Un hombre como yo con mucha experiencia en la vida aprende a juzgar bien el carácter."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
