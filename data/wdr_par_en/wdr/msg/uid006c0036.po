#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Romance movies.
msgctxt "11028_Kiryu"
msgid "Hehe. Don't judge a book by its cover."
msgstr "Jeje. No juzgues un libro por su portada."

