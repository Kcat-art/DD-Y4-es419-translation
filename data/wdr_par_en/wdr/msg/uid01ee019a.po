#. y4:msg_speaker_id=0
msgctxt "264_Tanimura"
msgid "(This is no time to be making detours. They took Zhao-san somewhere off Senryo Avenue.)"
msgstr "(No es momento de tomar desvíos. Se llevaron a Zhao-san para algún lugar fuera de la avenida Senryo)."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Haruka
#. y4:msg_speaker_id=1
msgctxt "300_Tanimura"
msgid "What took you so long, Uncle Kaz? I got tired of waiting..."
msgstr "¿Por qué demoraste tanto, tío Kaz? Me cansé de esperar..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Lily
#. y4:msg_speaker_id=3
msgctxt "324_Tanimura"
msgid "Oh, you're back, Akiyama-san. Shall we go, then?"
msgstr "Ah, ahí estás, Akiyama-san. ¿Vamos?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Yasuko
#. y4:msg_speaker_id=5
msgctxt "336_Tanimura"
msgid "Oh, Kiryu-san, I've been waiting for you. Shall we go, then?"
msgstr "Ah, Kiryu-san, te estaba esperando. ¿Nos vamos?"

