#. y4:msg_speaker_id=6
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'll make sure she gets home.
msgctxt "172_Yusuke"
msgid "Huh!?"
msgstr "¡¿Eh?!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Haruko
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'll make sure she gets home.
msgctxt "184_Haruko"
msgid "Really? Thanks so much, Ryota-kun! I'll give you her address later."
msgstr "¿De verdad? ¡Gracias, Ryota-kun! Luego te paso su dirección."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
