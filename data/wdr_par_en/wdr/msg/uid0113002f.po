#. y4:msg_branch_segment=T0.P9..P11
#. y4:msg_branch_target_text=Exhibition matches are single match fights. You can participate in these matches using the Special Slot. Winning these single match fights will earn you money which can be used to enhance the dojo's facilities.
#. y4:msg_branch_raw=01 11 00 09 00 00 00 12 00 00 00 00 00 00 00 00
msgctxt "740_Saejima"
msgid "Exhibition Matches"
msgstr "Combates de exhibición"

