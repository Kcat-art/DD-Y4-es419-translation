msgctxt "17172_Rio"
msgid "Yeah..."
msgstr "Sí..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=18
#. y4:msg_location=T26.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17184_Akiyama"
msgid "How long did you run away for? Three days or something?"
msgstr "¿Por cuánto tiempo? ¿Tres días o algo así?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=19
#. y4:msg_location=T26.P19
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17196_Rio"
msgid "Um... More like one night."
msgstr "Eh… más bien una sola noche."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=20
#. y4:msg_location=T26.P20
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17208_Akiyama"
msgid "That's not very long at all."
msgstr "Eso no es mucho."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=21
#. y4:msg_location=T26.P21
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17220_Rio"
msgid "Hahaha! No, but it seemed like a big deal at the time."
msgstr "Ja, ja, ja! No, pero en ese momento me pareció un gran problema."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=22
#. y4:msg_location=T26.P22
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17232_Rio"
msgid "And they found me almost immediately."
msgstr "Y me encontraron casi de inmediato."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=23
#. y4:msg_location=T26.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17244_Akiyama"
msgid "Hahaha. That's pretty cute."
msgstr "Jajaja. Eso es bastante tierno."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=24
#. y4:msg_location=T26.P24
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17256_Rio"
msgid "Hehe. Well, my mom's pretty strict, so I was really afraid of what she'd say."
msgstr "Jeje. Bueno, mi mamá es bastante estricta, así que tenía mucho miedo de lo que me fuera a decir."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=25
#. y4:msg_location=T26.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17268_Akiyama"
msgid "Heh. So then what happened?"
msgstr "Je. ¿Y entonces qué pasó?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=26
#. y4:msg_location=T26.P26
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17280_Rio"
msgid "Oh, we made up. But the thing I remember most is how nice my mother was to me at the time. It was the nicest she'd ever been."
msgstr "Pues nos reconciliamos. Pero lo que más recuerdo es lo amable que fue conmigo en ese momento. Fue la vez que más amable ha sido."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=27
#. y4:msg_location=T26.P27
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17292_Rio"
msgid "Thinking back now, I can see how great a mother she really is."
msgstr "Ahora que lo pienso, puedo ver la buena madre que es realmente."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=So what do you think now that you're doing it?
msgctxt "17304_Akiyama"
msgid "Yeah."
msgstr "Sí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=29
#. y4:msg_location=T26.P29
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17316_Rio"
msgid "I gave her so much to be worried about. I kinda want to make it up to her now."
msgstr "Le di muchas razones para preocuparse. Ahora quiero compensárselo un poco."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=30
#. y4:msg_location=T26.P30
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17328_Akiyama"
msgid "So you asked her on a \"date.\" I'm sure she'll enjoy it."
msgstr "Así que la invitaste a una “cita”. Estoy seguro de que la disfrutará."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=31
#. y4:msg_location=T26.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How long did you run away for?
msgctxt "17340_Rio"
msgid "Yes, I hope so!"
msgstr "¡Sí, eso espero!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=200
#. y4:msg_phrase=0
#. y4:msg_location=T200.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T26.P32
#. y4:msg_branch_segment=T26.P32..P41
#. y4:msg_branch_target_text=I can understand how you must've felt.
#. y4:msg_branch_raw=01 11 00 20 00 00 00 26 00 00 00 00 00 00 00 00
msgctxt "17352_Akiyama"
msgid "I can understand how you must've felt."
msgstr "Puedo entender cómo te sentiste."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=33
#. y4:msg_location=T26.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can understand how you must've felt.
msgctxt "17364_Rio"
msgid "Did you ever run away from home, Akiyama-san?"
msgstr "¿Alguna vez se escapo de casa, Akiyama-san?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=34
#. y4:msg_location=T26.P34
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can understand how you must've felt.
msgctxt "17376_Akiyama"
msgid "Sort of. I caused my share of trouble. Your parents must've been pretty mad."
msgstr "Más o menos. Me metí en mis buenos líos. Tus padres debieron de enfadarse bastante."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=35
#. y4:msg_location=T26.P35
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can understand how you must've felt.
msgctxt "17388_Rio"
msgid "They were furious!"
msgstr "¡Estaban furiosos!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=36
#. y4:msg_location=T26.P36
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can understand how you must've felt.
msgctxt "17400_Rio"
msgid "We made up, though. Then my mom started being really nice to me."
msgstr "Sin embargo, nos reconciliamos. Entonces mi mamá comenzó a ser muy amable conmigo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=37
#. y4:msg_location=T26.P37
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can understand how you must've felt.
msgctxt "17412_Rio"
msgid "She was completely different. Like, way kinder. She'd been so strict before!"
msgstr "Era completamente diferente. Mucho más cariñosa. ¡Antes había sido tan estricta!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=38
#. y4:msg_location=T26.P38
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can understand how you must've felt.
msgctxt "17424_Akiyama"
msgid "I see."
msgstr "Ya veo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=39
#. y4:msg_location=T26.P39
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can understand how you must've felt.
msgctxt "17436_Rio"
msgid "For the first time in my life, I could really tell how much she loved me."
msgstr "Por primera vez en mi vida, pude darme cuenta de cuánto me quería."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=40
#. y4:msg_location=T26.P40
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can understand how you must've felt.
msgctxt "17448_Akiyama"
msgid "Well, you can give back to her tomorrow with your \"date\" then."
msgstr "Bueno, entonces mañana podrás compensarla con tu \"cita\"."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=16
#. y4:msg_location=T4.P16
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "17460_Rio"
msgid "I will!"
msgstr "¡Lo prometo!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=201
#. y4:msg_phrase=0
#. y4:msg_location=T201.P0
#. y4:msg_choice_index=3
