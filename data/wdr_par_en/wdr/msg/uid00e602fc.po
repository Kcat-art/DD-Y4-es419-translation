#. y4:line_status=translated
msgctxt "96_Saejima"
msgid "I'm here to take out the trash. Now get outta here.\\r\nOn the double."
msgstr "Vine a sacar la basura. Ahora se me van yendo y rápido."

#. y4:line_status=translated
msgctxt "108_Street Punk"
msgid "Want us to leave? We're gonna need a going-away present."
msgstr "¿Quieres que nos vayamos? Nos vendría bien un regalo de despedida."

#. y4:line_status=translated
msgctxt "120_Saejima"
msgid "Shut the fuck up! My fist in your face is all\\r\nyou freeloaders deserve!"
msgstr "¡Cierra la puta boca! ¡Hacerte comer mis puños es lo\núnico que unos parásitos como ustedes merecen!"

