msgid "What about you? What would your ideal date be like?"
msgstr "¿Y tú? ¿Cómo sería tu cita ideal?"

msgctxt "9108_Noa"
msgid "Well, I－"
msgstr "Bueno, yo－"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
