msgctxt "452_Matsuyama"
msgid "How about some fresh sushi?"
msgstr "¿Te apetece algo de sushi fresco?"

#. y4:line_status=translated
#. y4:msg_role=decision
#. y4:msg_decision_role=choice
#. y4:msg_decision_group=0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0112
#. y4:msg_branch_target=T0.P18
msgctxt "464_Matsuyama"
msgid "Let's see what fast food has to offer."
msgstr "Veamos qué nos ofrece la comida rápida."

