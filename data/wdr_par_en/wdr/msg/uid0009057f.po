#. y4:line_status=translated
msgctxt "84_Boyfriend"
msgid "What do you say we go play some golf? I hear you\\r\ncan play a round for pretty cheap these days."
msgstr "¿Te animas a jugar golf? Escuché que podemos jugar\\r\nuna ronda a un precio bastante razonable."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Girlfriend
#. y4:msg_speaker_id=2
msgctxt "96_Girlfriend"
msgid "That does sound kinda nice. But isn't it a bit far?"
msgstr "Eso suena bastante bien. Pero, ¿no está un poco lejos?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Boyfriend
#. y4:msg_speaker_id=0
msgctxt "108_Boyfriend"
msgid "Not if we take a taxi. We'd be there in no time."
msgstr "No si tomamos un taxi. Llegaríamos en un santiamén."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Girlfriend
#. y4:msg_speaker_id=2
msgctxt "120_Girlfriend"
msgid "Yeah? Okay, then let's get going!"
msgstr "¿En serio? ¡Entonces vámonos!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
