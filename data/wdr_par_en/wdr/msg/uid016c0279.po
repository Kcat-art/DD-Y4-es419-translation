#. y4:msg_branch_choice=You'll get used to it eventually.
msgctxt "2448_Akiyama"
msgid "You mean you want me to request you?"
msgstr "¿Me estás pidiendo que te solicite?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=29
