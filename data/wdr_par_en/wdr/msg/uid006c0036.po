#. y4:msg_branch_choice=He might not forgive you, you know.
msgctxt "12000_Kiryu"
msgid "He's got his pride, after all. If he goes too easy on you, he'll lose face."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=19
#. y4:msg_location=T21.P19
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He might not forgive you, you know.
msgctxt "12012_松岡里緒奈：源氏名"
msgid "You have a point. He does care a lot about his reputation."
msgstr "Tienes razón. Le importa mucho su reputación."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=20
