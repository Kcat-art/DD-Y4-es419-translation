msgctxt "108_Tanimura"
msgid "(A couple having trouble winning at the UFO Catcher. I should have a look. I may be able to have a <Color:7>Revelation<Color:Default>...)"
msgstr "(Una pareja con problemas para ganar en el UFO Catcher... Debería revisar, tal vez sea una <Color:7>Revelación<Color:Default>...)."
