#. y4:msg_speaker_id=2
msgctxt "2064_峰村七海：源氏名"
msgid "Hello. Nice to meet you."
msgstr "Hola. Encantada de conocerle."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
