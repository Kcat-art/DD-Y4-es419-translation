#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'd stay a human.
msgctxt "6408_松岡里緒奈：源氏名"
msgid "No, it has to be an animal! That's the whole point!"
msgstr "¡No, tiene que ser un animal! ¡Ese es el punto!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
