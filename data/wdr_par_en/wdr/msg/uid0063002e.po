#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Sure. -> T2.P3 | 2. I'd rather not. -> T2.P5
msgctxt "304_Shizuka"
msgid "I know! Will you sing a duet with me?"
msgstr "¡Lo sé! ¿Va a cantar un dueto conmigo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
