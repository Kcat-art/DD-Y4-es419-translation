#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Unfortunately, no.
msgctxt "2136_峰村七海：源氏名"
msgid "I see..."
msgstr "Ya veo..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=7
#. y4:msg_location=T34.P7
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=21
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Unfortunately, no.
msgctxt "2148_Tanimura"
msgid "Hey, don't look so disappointed."
msgstr "Oye, no pongas esa cara de decepción."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=8
#. y4:msg_location=T34.P8
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Unfortunately, no.
msgctxt "2160_峰村七海：源氏名"
msgid "Oh, it's not that... I was just worried about you. It must be a dangerous job."
msgstr "Ay, no, no es eso... Yo solo estaba preocupada por usted. Debe ser un trabajo peligroso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=9
#. y4:msg_location=T34.P9
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=21
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Unfortunately, no.
msgctxt "2172_Tanimura"
msgid "It can be. That's why I like to stop by places like this for a little break now and then."
msgstr "Algunas veces. Por eso me gusta pasar por lugares como este a despejarme de vez en cuando."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=10
#. y4:msg_location=T34.P10
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Unfortunately, no.
msgctxt "2184_峰村七海：源氏名"
msgid "That's good."
msgstr "Ah, suena razonable."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=48
#. y4:msg_phrase=0
#. y4:msg_location=T48.P0
