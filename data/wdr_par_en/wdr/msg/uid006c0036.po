#. y4:msg_speaker_id=2
msgctxt "12684_松岡里緒奈：源氏名"
msgid "What about you?"
msgstr "¿Qué hay de ti?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
