#. y4:msg_location=T1.P23
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Actually, I'm the one who's been stalking you.
msgctxt "4704_Noa"
msgid "You are?"
msgstr "¿D-de verdad estabas bromeando...?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=24
#. y4:msg_location=T1.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Actually, I'm the one who's been stalking you.
msgctxt "4716_Akiyama"
msgid "Uh, sorry. I was just trying to be funny. I didn't think you'd take me seriously."
msgstr "Lo siento. ¿Te asusté?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=25
#. y4:msg_location=T1.P25
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Actually, I'm the one who's been stalking you.
msgctxt "4728_Noa"
msgid "Oh... Don't joke like that."
msgstr "Este... no bromees con esas cosas..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=26
#. y4:msg_location=T1.P26
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Actually, I'm the one who's been stalking you.
msgctxt "4740_Noa"
msgid "That kind of joke isn't funny. Especially not when there's actually someone stalking me."
msgstr "Por favor, deja de hacer ese tipo de bromas. Casi me da un infarto del susto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=27
#. y4:msg_location=T1.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Actually, I'm the one who's been stalking you.
msgctxt "4752_Akiyama"
msgid "Er, sorry."
msgstr "Lo siento..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
