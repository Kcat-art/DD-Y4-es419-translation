msgctxt "56_Saejima"
msgid "Did you just say \"Shibata Family\"?"
msgstr "Oye, dijiste algo sobre la \"Familia Shibata\", ¿verdad?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=1
msgctxt "68_Kido"
msgid "Who's asking?"
msgstr "¿Y tú quién eres?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "80_Saejima"
msgid "Ex-member of the Tojo Clan's Sasai Family."
msgstr "Solía formar parte de la Familia Sasai del clan Tojo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=1
msgctxt "92_Kido"
msgid "Never heard of them."
msgstr "¿Sasai? Nunca escuché hablar de ellos."

msgctxt "104_Saejima"
msgid "These goons ya just wasted－they all Shibata's?"
msgstr "¿Todos esos eran miembros de la Familia Shibata?\\r\n"
"¿Verdad?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=1
msgctxt "116_Kido"
msgid "Maybe. What's it to you?"
msgstr "Tal vez. ¿Qué te importa?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "140_Saejima"
msgid "You in the business?"
msgstr "¿Así que estás metido en este negocio?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=1
msgctxt "152_Kido"
msgid "The yakuza? Uh, yeah..."
msgstr "¿La yakuza? Eh, sí, pero..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "164_Saejima"
msgid "What family?"
msgstr "¿De qué familia?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=1
msgctxt "176_Kido"
msgid "Er, I'm with the Tojo. The, uh... Shibata Family, actually."
msgstr "Ehh, estoy en el Tojo. La Familia Shibata mejor dicho."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "188_Saejima"
msgid "Why were ya just poundin' on your own boys?"
msgstr "¿Por qué estás enfrentandote a tus compañeros?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=1
msgctxt "200_Kido"
msgid "Um, it's kinda complicated..."
msgstr "Ehh... Es un poco complicado..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "212_Saejima"
msgid "They jump ya for droppin' out?"
msgstr "¿Te buscan por haberte ido?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=1
msgctxt "224_Kido"
msgid "No, not exactly."
msgstr "N-no, no es eso, pero..."

msgctxt "236_Saejima"
msgid "Well, you're obviously no friend of Shibata's.\\r\n"
"Just the man I need."
msgstr "Bueno, si ya no eres miembro de los Shibata, eres el indicado.\\r\n"
"Necesito tu ayuda."

msgctxt "248_Kido"
msgid "Wait－need me? For what?"
msgstr "¿Necesitarme? ¿Para qué?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "260_Saejima"
msgid "You're gonna help me find my boss, Sasai-san."
msgstr "Sasai-san, mi jefe. Ayúdame a encontrarlo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=1
msgctxt "284_Kido"
msgid "Ah!"
msgstr "¡Ah!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=1
msgctxt "296_Kido"
msgid "Hup!"
msgstr "¡Jop!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "332_Saejima"
msgid "Ngh!"
msgstr "¡Ahg!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=1
msgctxt "356_Kido"
msgid "Sorry, man, but I got my own shit to take care of!"
msgstr "¡Lo siento, pero tengo mis propios asuntos de los que ocuparme!"

#. y4:msg_type=dialogue
