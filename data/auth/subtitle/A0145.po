msgctxt "492\t573"
msgid "I'll be back. Tomorrow."
msgstr "Nos vemos, mañana."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "607\t674"
msgid "Looking forward to it."
msgstr "Te estaremos esperando."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "975\t1031"
msgid "Hey, uh..."
msgstr "Oye..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1056\t1104"
msgid "Your name."
msgstr "Tu nombre..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1105\t1178"
msgid "I never asked you your name."
msgstr "¿Puedo saber al menos tu nombre?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1275\t1335"
msgid "Lily."
msgstr "Lily..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1341\t1392"
msgid "It's Lily."
msgstr "Mi nombre es Lily."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1413\t1473"
msgid "Lily-san?"
msgstr "¿Lily-san?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1474\t1581"
msgid "That your real name?\\nOr just the one you use at work?"
msgstr "¿Ese es tu nombre real?\\n¿O es el que usas en el trabajo?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1659\t1720"
msgid "Does it really matter either way?"
msgstr "¿Es necesario que lo diga?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1775\t1845"
msgid "No... Guess it doesn't."
msgstr "No, está bien."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1899\t1976"
msgid "See you tomorrow."
msgstr "Te estaremos esperado mañana."

