#. y4:msg_speaker_id=0
msgctxt "4776_Himeka"
msgid "I just realized I haven't asked what ya do for a livin'."
msgstr "Jo, me acabo de dar cuenta de que ni te he preguntado a qué te dedicas."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4788_Tanimura"
msgid "You wanna know?"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4800_Himeka"
msgid "Yup! Come on, tell me! Even just a hint."
msgstr "¡Claro! ¡Por favor, dímelo! Aunque sea una pista."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4812_Tanimura"
msgid "A hint? Okay, well... I work for the government."
msgstr "¿Una pista? Bien, pues... trabajo para el gobierno."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=4
#. y4:msg_location=T2.P4
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4824_Himeka"
msgid "Yer a public servant!"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=5
#. y4:msg_location=T2.P5
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4836_Himeka"
msgid "Hmm... Are you a school teacher?"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=6
#. y4:msg_location=T2.P6
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4848_Tanimura"
msgid "Nope. I'm not cut out to teach anyone anything."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=7
#. y4:msg_location=T2.P7
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4860_Tanimura"
msgid "I'm a cop. I'm in the Community Safety Division. It's... Well... Let's just say I'm a detective."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=8
#. y4:msg_location=T2.P8
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4872_Himeka"
msgid "Wow! Y'know, now that you mention it, you do kinda have that air about ya."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=9
#. y4:msg_location=T9.P9
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Come on. I'm a cop, remember?
msgctxt "4884_Tanimura"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=10
#. y4:msg_location=T2.P10
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4896_Himeka"
msgid "Yeah. Ya got that \"I always catch the bad guy\" look. I haven't done anythin' wrong, just so ya know!"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=11
#. y4:msg_location=T2.P11
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4908_Tanimura"
msgid "Heh. I wonder."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=12
#. y4:msg_location=T2.P12
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4920_Himeka"
msgid "Hey, I'd like your advice on something. Do ya mind?"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=13
#. y4:msg_location=T2.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4932_Tanimura"
msgid "I can't promise I can help, but go ahead."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=14
#. y4:msg_location=T2.P14
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4944_Himeka"
msgid "Ever since appearin' in that magazine, I've been gettin' a real mountain of customers comin' to get a taste of my hospitality."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=15
#. y4:msg_location=T2.P15
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4956_Himeka"
msgid "But some of them are... I don't know... Like they've never been to a club before. They seem pretty inexperienced with women."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=16
#. y4:msg_location=T2.P16
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4968_Himeka"
msgid "Anyway, a few of those customers get the wrong idea about me. They're like, \"I can't believe we get along so well!\""
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=17
#. y4:msg_location=T2.P17
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4980_Tanimura"
msgid "They don't get what a hostess club is all about."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=18
#. y4:msg_location=T2.P18
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4992_Himeka"
msgid "Yeah. It's flatterin' when they say they love me, but..."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=19
#. y4:msg_location=T2.P19
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "5004_Himeka"
msgid "A few are creepin' a little too hard, if ya know what I mean. Nothin' bad's happened yet, but..."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=20
#. y4:msg_location=T2.P20
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "5016_Tanimura"
msgid "You should report stuff like that to the police. Then we can tell them to lay off."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=21
#. y4:msg_location=T2.P21
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "5028_Himeka"
msgid "But they like me, and they're customers. I don't wanna offend them or anythin'."
msgstr ""

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
