#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe I could sing a song...
msgctxt "12168_Kiryu"
msgid "I'll take that as a no..."
msgstr "Lo tomaré como un no..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=29
#. y4:msg_location=T21.P29
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe I could sing a song...
msgctxt "12180_望月京子：源氏名"
msgid "Hey, maybe you and I could form a band ourselves. Then you could sing to your heart's content."
msgstr "Ey, si te parece, tú y yo podríamos formar una banda, y así podrías cantar lo que tengas contenido en tu corazón."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=30
#. y4:msg_location=T21.P30
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe I could sing a song...
msgctxt "12192_Kiryu"
msgid "Heh, that's an interesting idea."
msgstr "Je, eso es a una idea interesante."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
