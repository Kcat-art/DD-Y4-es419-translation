msgid "Chigusa..."
msgstr "Chigusa..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Chigusa
#. y4:msg_speaker_id=1
msgctxt "176_Chigusa"
msgid "I've known all this time! I just..."
msgstr "¡Lo he sabido todo este tiempo! Solo que..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Chigusa
#. y4:msg_speaker_id=1
msgctxt "188_Chigusa"
msgid "Forget it. Just let me be alone."
msgstr "Olvídalo. Déjame estar sola."

msgctxt "200_Kiryu"
msgid "I don't think that's gonna help. We should go somewhere we\\r\n"
"can sit and take a breather."
msgstr "No creo que eso sea de ayuda. Deberíamos ir a algun lugar\\r\n"
"donde podamos sentarnos y tomar un respiro."

msgctxt "212_Chigusa"
msgid "...Fine. Let's go back to Bantam, then. Yusaku and I used to\\r\n"
"go there together all the time."
msgstr "...Bueno. Volvamos a Bantam. Yusaku y yo solíamos\\r\n"
"ir ahí juntos todo el tiempo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
