#. y4:msg_speaker_id=0
msgctxt "12228_望月京子：源氏名"
msgid "Is that it? Anything else?"
msgstr "¿Solo eso? ¿Nada más?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=3
#. y4:msg_location=T22.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "12240_Kiryu"
msgid "Like what?"
msgstr "¿Cómo qué?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=4
#. y4:msg_location=T22.P4
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "12252_望月京子：源氏名"
msgid "Well, you could get a present or two for me, in honor of my dream coming true and all."
msgstr "Bueno, podrías prepararme un regalito o dos, en honor a mi gran sueño haciéndose realidad por fin."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
