#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=23
#. y4:msg_location=T7.P23
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I sometimes do that myself.
msgctxt "8148_Rio"
msgid "Whew! I'm glad. I'd have had a hard time if it was both legs!"
msgstr "¡Uf! Me alegro. ¡Lo habría pasado mal si hubieran sido las dos piernas!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=24
#. y4:msg_location=T7.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I sometimes do that myself.
msgctxt "8160_Akiyama"
msgid "Nope. Just the one. And I don't do it standing up, either."
msgstr "No. Sólo una. Y tampoco lo hago de pie."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=25
#. y4:msg_location=T7.P25
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I sometimes do that myself.
msgctxt "8172_Rio"
msgid "I'm so relieved to hear that!"
msgstr "¡Estoy tan aliviada de escuchar eso!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=144
#. y4:msg_phrase=0
#. y4:msg_location=T144.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T7.P26
#. y4:msg_branch_segment=T7.P26..P41
#. y4:msg_branch_target_text=Do you know why people do that?
#. y4:msg_branch_raw=01 11 00 1a 00 00 00 1f 00 00 00 00 00 00 00 00
msgctxt "8184_Akiyama"
msgid "Do you know why people do that?"
msgstr "¿Sabes por qué la gente hace eso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=27
#. y4:msg_location=T7.P27
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8196_Rio"
msgid "Hm... Something to do with nerves, maybe?"
msgstr "Hm... ¿Algo que tenga que ver con los nervios, tal vez?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=28
#. y4:msg_location=T7.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8208_Akiyama"
msgid "I heard it was related to the amount of muscle you have."
msgstr "Oí que estaba relacionado con la cantidad de músculo que uno tiene."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=29
#. y4:msg_location=T7.P29
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8220_Rio"
msgid "Muscle!?"
msgstr "¿¡Músculo!?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=30
#. y4:msg_location=T7.P30
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8232_Akiyama"
msgid "Yeah. It seems that people who have a lot of muscle are more likely to have lactic acid build up in their bodies."
msgstr "Sí. Parece que las personas que tienen mucho músculo son más propensas a la acumulación de ácido láctico en sus cuerpos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=31
#. y4:msg_location=T7.P31
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8244_Akiyama"
msgid "When they stay in the same position for too long, the lactic acid builds up..."
msgstr "Cuando permanecen demasiado tiempo en la misma posición, el ácido láctico se acumula..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=32
#. y4:msg_location=T7.P32
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8256_Akiyama"
msgid "...and they feel like they have to move in order to dissolve it. That's why some people bounce their legs."
msgstr "...y sienten que tienen que moverse para disolverlo. Es por eso que algunas personas rebotan las piernas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=33
#. y4:msg_location=T7.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8268_Rio"
msgid "Really? It's so amazing that you know that, Akiyama-san!"
msgstr "¿De verdad? ¡Es increíble que lo sepas, Akiyama-san!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=34
#. y4:msg_location=T7.P34
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8280_Akiyama"
msgid "That's just what I've heard."
msgstr "Eso es sólo lo que he escuchado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=35
#. y4:msg_location=T7.P35
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8292_Rio"
msgid "But that does sound about right!"
msgstr "Pero suena como si fuera cierto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=36
#. y4:msg_location=T7.P36
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8304_Akiyama"
msgid "I'm not positive, but it sounds plausible."
msgstr "No estoy seguro, pero suena plausible."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=37
#. y4:msg_location=T7.P37
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8316_Rio"
msgid "It does. Should I recommend that Yokoyama-kun do some stretches, then?"
msgstr "Así es. ¿Debería recomendarle a Yokoyama-kun que haga algunos estiramientos, entonces?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=38
#. y4:msg_location=T7.P38
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8328_Akiyama"
msgid "Uh, no. Just leave him be."
msgstr "Eh, no. Déjalo en paz."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=39
#. y4:msg_location=T7.P39
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8340_Rio"
msgid "What makes you say that?"
msgstr "¿Qué le hace decir eso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=40
#. y4:msg_location=T7.P40
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8352_Akiyama"
msgid "There aren't that many people who can bounce both legs like that, you know?"
msgstr "No hay mucha gente que pueda rebotar las dos piernas de esa manera, ¿sabes?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=41
#. y4:msg_location=T7.P41
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you know why people do that?
msgctxt "8364_Rio"
msgid "Hehe! Oh, you're so mean!"
msgstr "¡Jeje! ¡Oh, eres tan malo!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=0
#. y4:msg_location=T8.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "8376_Rio"
msgid "Are you married, Akiyama-san?"
msgstr "¿Está casado, Akiyama-san?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=1
#. y4:msg_location=T8.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "8388_Akiyama"
msgid "Me? Nope. I'm single."
msgstr "¿Yo? No, Estoy soltero."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=2
#. y4:msg_location=T8.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "8400_Rio"
msgid "Oh really?"
msgstr "¿Oh, en serio?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=3
#. y4:msg_location=T8.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "8412_Akiyama"
msgid "Why? Do I look married?"
msgstr "¿Por qué? ¿Parezco casado?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=31
#. y4:msg_location=T2.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sounds like fate. You should buy him.
msgctxt "8424_Rio"
msgid "......"
msgstr "......"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=5
#. y4:msg_location=T8.P5
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "8436_Rio"
msgid "No way! Not at all!"
msgstr "¡De ninguna manera! ¡Para nada!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=6
#. y4:msg_location=T8.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "8448_Akiyama"
msgid "That's what I thought. What about you?"
msgstr "Eso es lo que pensé. ¿Y que hay de ti?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=7
#. y4:msg_location=T8.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "8460_Rio"
msgid "Me?"
msgstr "¿Yo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=So what do you think now that you're doing it?
msgctxt "8472_Akiyama"
msgid "Yeah."
msgstr "Sí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=9
#. y4:msg_location=T8.P9
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "8484_Rio"
msgid "Well... I'm just getting over a breakup."
msgstr "Bueno... Estoy superando una ruptura."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=10
#. y4:msg_location=T8.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "8496_Akiyama"
msgid "What do you do to get over something like that?"
msgstr "¿Qué se hace para superar algo como eso?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=11
#. y4:msg_location=T8.P11
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "8508_Rio"
msgid "I'm trying to become prettier than I was when I was going out with my ex."
msgstr "Estoy intentando ser más bonita de lo que era cuando salía con mi ex."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=12
#. y4:msg_location=T8.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "8520_Akiyama"
msgid "Prettier?"
msgstr "¿Más bonita?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=13
#. y4:msg_location=T8.P13
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "8532_Rio"
msgid "Yep! I've been working on my hair and making my skin nice and firm."
msgstr "¡Sí! He estado trabajando en mi pelo y haciendo que mi piel esté bonita y firme."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=14
#. y4:msg_location=T8.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "8544_Akiyama"
msgid "Hmm, I see... So you're trying to feel better by aiming for those goals. Got it."
msgstr "Hmm, ya veo... Así que estás tratando de sentirte mejor apuntando a esas metas. Entendido."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=15
#. y4:msg_location=T8.P15
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=8
#. y4:msg_decision_choices=1. How much would you say you've recovered? -> T8.P16 | 2. I sort of understand what you mean. -> T8.P24 | 3. That's a positive way to look at things. -> T8.P30
msgctxt "8556_Rio"
msgid "Yep, that's right."
msgstr "Sip, así es."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=145
#. y4:msg_phrase=0
#. y4:msg_location=T145.P0
