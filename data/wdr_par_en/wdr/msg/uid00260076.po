#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=37
#. y4:msg_location=T0.P37
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=1
msgctxt "792_Date"
msgid "Even you can't do it, Kiryu? This is impossible..."
msgstr "¿Ni siquiera tú puedes, Kiryu? Es una causa perdida..."

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=38
#. y4:msg_location=T0.P38
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=12
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Maybe he's hungry. -> T0.P39 | 2. Maybe his diaper is dirty. -> T0.P165 | 3. Maybe he's tired. -> T0.P102
msgctxt "804_Kiryu"
msgid "(There must be some reason he's crying.)"
msgstr "(Tiene que haber alguna razón por la que llora.)"

#. y4:line_status=translated
msgctxt "816_Kiryu"
msgid "You said he's been crying for an hour, right? He's probably\\r\nhungry."
msgstr "Dices que lleva una hora llorando, ¿no? Puede que \\r\ntenga hambre."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
