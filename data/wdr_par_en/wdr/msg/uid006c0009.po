msgctxt "6264_Kiryu"
msgid "You must have a bad memory."
msgstr "Debes de tener mala memoria."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
