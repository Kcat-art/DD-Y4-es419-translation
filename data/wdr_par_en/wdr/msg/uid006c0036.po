#. y4:msg_speaker_id=2
msgctxt "8904_松岡里緒奈：源氏名"
msgid "Do you know what he said when I asked him why he likes me?"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=5
#. y4:msg_location=T13.P5
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "8916_松岡里緒奈：源氏名"
msgid "He said he loves my passionate personality. What do you think of that?"
msgstr "Dijo que ama mi personalidad apasionada. ¿Qué opinas de eso?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=6
#. y4:msg_location=T13.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "8928_Kiryu"
msgid "Well, that's hard to say..."
msgstr "Bueno, eso es difícil de decir..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=7
#. y4:msg_location=T13.P7
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "8940_松岡里緒奈：源氏名"
msgid "I'm trying to decide whether I should give him a shot or not."
msgstr "Estoy tratando de decidir si debo darle una oportunidad o no."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=8
#. y4:msg_location=T13.P8
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=13
#. y4:msg_decision_choices=1. If you're not sure, you shouldn't do it. -> T13.P9 | 2. What's he got that I haven't got? -> T13.P18 | 3. I should meet him sometime. -> T13.P25
