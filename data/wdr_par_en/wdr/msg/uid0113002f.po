#. y4:msg_branch_target_text=The dojo rank represents the dojo's current rank. You can raise the rank by winning exhibition matches and tournaments, as well as enhancing the dojo's facilities.
#. y4:msg_branch_raw=01 11 00 1b 00 00 00 09 00 00 00 00 00 00 00 00
msgctxt "13568"
msgid "Dojo Rank"
msgstr "Rango del dojo"

