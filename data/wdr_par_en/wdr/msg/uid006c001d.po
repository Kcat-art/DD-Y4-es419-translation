#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You should try to be more aware of your behavior.
msgctxt "15900_Rio"
msgid "Huh!? Well, that's not very like you, Akiyama-san..."
msgstr "¿¡Eh!? Bueno, eso no es muy propio de usted, Akiyama-san..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
