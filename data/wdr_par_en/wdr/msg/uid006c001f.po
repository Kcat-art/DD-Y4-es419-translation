#. y4:msg_decision_group=10
#. y4:msg_decision_choices=1. What a creep. -> T10.P9 | 2. Are you going to tell the police? -> T10.P15 | 3. Just leave him be. -> T10.P21
msgctxt "7704_Noa"
msgid "And he said, \"You're lying! I know it!\""
msgstr "Y él dijo: \"¡Estás mintiendo! ¡Lo sé!\""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=10
