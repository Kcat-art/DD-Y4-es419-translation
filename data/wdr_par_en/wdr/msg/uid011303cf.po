#. y4:msg_branch_target_text=Hmph. Yeah, a little.
#. y4:msg_branch_raw=01 11 00 35 00 00 00 15 00 00 00 00 00 00 00 00
msgctxt "2532_Saejima"
msgid "Hmph. Yeah, a little."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=54
#. y4:msg_location=T1.P54
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2544_Ehama"
msgid "Really!? That's a surprise!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=55
#. y4:msg_location=T1.P55
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2556_Saejima"
msgid "Yeah, techno, right? Just ain't heard that word in a long time. An old buddy o' mine used to do the jitterbug."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=56
#. y4:msg_location=T1.P56
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2568_Ehama"
msgid "Oh! You must be talking about the dance, right?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=57
#. y4:msg_location=T1.P57
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2580_Saejima"
msgid "That's right. Ya know about the jitterbug too?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=58
#. y4:msg_location=T1.P58
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2592_Ehama"
msgid "Of course I do! Actually, I used to do the jitterbug myself!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=59
#. y4:msg_location=T1.P59
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2604_Saejima"
msgid "Huh. Now ain't that impressive! It's been ages since I thought about the jitterbug..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=60
#. y4:msg_location=T1.P60
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2616_Ehama"
msgid "Same for me. Oh man, it's so nice to be able to talk to someone my age. It feels like we could talk about anything!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=61
#. y4:msg_location=T1.P61
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2628_Saejima"
msgid "(Our bond's growin' stronger. And it looks like he's more motivated now.)"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=62
#. y4:msg_location=T1.P62
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2640_Saejima"
msgid "Hmph... 'Course I know. Techno... Short for technology..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=63
#. y4:msg_location=T1.P63
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2652_Ehama"
msgid "Um... Saejima-san... If you don't know what it is, you should just say so."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=64
#. y4:msg_location=T1.P64
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2664_Saejima"
msgid "Right..."
msgstr "Cierto..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=65
#. y4:msg_location=T1.P65
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2676_Saejima"
msgid "(Did he lose trust in me...?)"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=66
#. y4:msg_location=T1.P66
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2688_Saejima"
msgid "Techno...? Never heard of it. I used to listen to folk."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=67
#. y4:msg_location=T1.P67
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2700_Ehama"
msgid "Folk music!? I love folk music. Come to think of it, we are from that generation, aren't we?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=68
#. y4:msg_location=T1.P68
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2712_Ehama"
msgid "I used to love John Dover... Oh that's so nostalgic... I may still have the record at home. I'll check next time I go back."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
