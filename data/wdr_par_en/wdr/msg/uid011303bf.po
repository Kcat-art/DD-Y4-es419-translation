#. y4:msg_branch_target=T1.P64
#. y4:msg_branch_segment=T1.P64..P66
#. y4:msg_branch_target_text=Cross that bridge when ya get to it. Humans are the personification o' greed. You'll find a goal in due time.
#. y4:msg_branch_raw=01 11 00 40 00 00 00 1b 00 00 00 00 00 00 00 00
msgctxt "3096_Saejima"
msgid "Don't worry 'bout that now."
msgstr ""

