#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "4080_Erena"
msgid "I'm real glad I decided to come to Tokyo."
msgstr "Estoy muy feliz de haberme mudado a Tokio."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4092_Akiyama"
msgid "Why do you say that all of a sudden?"
msgstr "¿Por qué lo dices?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "4104_Erena"
msgid "Oh, I'm just happy that a nice man like you decided to come and request me, that's all."
msgstr "Ah, solo me pone feliz que un buen hombre como usted me haya solicitado, eso era."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4116_Akiyama"
msgid "Heheh. How long have you been here, anyway?"
msgstr "Ja, ja, ja. Bueno, ¿cuánto tiempo llevas aquí?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "4128_Erena"
msgid "Actually, about 10 days."
msgstr "Llevo como unos diez días."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4140_Akiyama"
msgid "Really? You're probably still getting used to it, then?"
msgstr "¿En serio? Entonces todavía no te acostumbras, ¿verdad?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "4152_Erena"
msgid "Yep, but I've already gotten the hang of the pace here."
msgstr "Podría decirse que no, pero ya le voy agarrando el ritmo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4164_Akiyama"
msgid "The pace? What do you mean?"
msgstr "¿Ritmo? ¿Qué quieres decir?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "4176_Erena"
msgid "How fast people walk."
msgstr "El ritmo con el que camina la gente."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "4188_Erena"
msgid "I've always been a fast walker, so I didn't have any trouble fittin' in."
msgstr "Siempre he sido de caminar rápido, así que no ha sido problema para mí."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
