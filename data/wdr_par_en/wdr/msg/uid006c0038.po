msgid "I like your spirit. But you should be careful. You never know what they might do."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
