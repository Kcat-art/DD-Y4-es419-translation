#. y4:msg_branch_target_text=Maybe you need a masochistic boyfriend.
#. y4:msg_branch_raw=01 11 00 25 00 00 00 27 00 00 00 00 00 00 00 00
msgctxt "13212_Akiyama"
msgid "Maybe you need a masochistic boyfriend."
msgstr "Quizá necesites un novio masoquista."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=38
#. y4:msg_location=T17.P38
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe you need a masochistic boyfriend.
msgctxt "13224_Rio"
msgid "A masochist? Haha. What makes you say that?"
msgstr "¿Masoquista? Ja, ja. ¿Por qué dice eso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=39
#. y4:msg_location=T17.P39
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe you need a masochistic boyfriend.
msgctxt "13236_Akiyama"
msgid "You should find a man who actually likes being criticized. I'm sure you'll get along that way."
msgstr "Deberías encontrar a un hombre al que realmente le guste que lo critiquen. Seguro que así se llevarían bien."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=40
#. y4:msg_location=T17.P40
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe you need a masochistic boyfriend.
msgctxt "13248_Rio"
msgid "But I already told you, I don't want to criticize them!"
msgstr "Pero ya se lo había dicho, ¡no quiero criticarlos!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=41
#. y4:msg_location=T17.P41
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe you need a masochistic boyfriend.
msgctxt "13260_Akiyama"
msgid "Huh? Did you say that?"
msgstr "¿Eh? ¿Habías dicho eso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=42
#. y4:msg_location=T17.P42
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe you need a masochistic boyfriend.
msgctxt "13272_Rio"
msgid "Hmph! Did you even listen to what I said!?"
msgstr "¡Hmph! ¿¡Al menos escucho lo que dije!?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=43
#. y4:msg_location=T17.P43
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe you need a masochistic boyfriend.
msgctxt "13284_Akiyama"
msgid "Sorry, sorry."
msgstr "Lo siento, lo siento."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
