msgid "If you're not sure, you shouldn't do it."
msgstr "Si no estás segura, no deberías hacerlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=10
