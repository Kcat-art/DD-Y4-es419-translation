#. y4:msg_branch_choice=You shouldn't be drinking that much.
msgctxt "14232_Kiryu"
msgid "You shouldn't drink so much. It isn't good for you."
msgstr "No deberías beber tanto. No es bueno para ti."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=15
#. y4:msg_location=T27.P15
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You shouldn't be drinking that much.
msgctxt "14244_松岡里緒奈：源氏名"
msgid "Kiryu-san, are you worrying about me?"
msgstr "Kiryu-san, ¿te preocupas por mí?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=16
#. y4:msg_location=T27.P16
