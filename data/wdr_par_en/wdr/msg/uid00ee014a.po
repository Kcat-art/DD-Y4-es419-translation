#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "260_Dealer"
msgid "It looks like you don't have enough chips to play roulette, sir."
msgstr "Parece que no tiene suficientes fichas para jugar a la ruleta, señor."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "272_Dealer"
msgid "If you'd like to purchase chips, you can do so at the front desk."
msgstr "Si desea comprar más fichas, puede hacerlo en la mesa del frente."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "284_Dealer"
msgid "Welcome. Would you like to play roulette?"
msgstr "Bienvenido. ¿Le gustaría jugar a la ruleta?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "308_Haruka"
msgid "Uncle Kaz! I bet you could get 1,000 points in roulette!"
msgstr "¡Tío Kaz! ¡Apuesto a que podrías conseguir 1000 puntos en la ruleta!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "320_Kiryu"
msgid "(1,000 points in roulette... Should I give it a try?)"
msgstr "(1.000 puntos en la ruleta... ¿Debería intentarlo?)"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "332_Kiryu"
msgid "All right, I'll play."
msgstr "Muy bien, jugaré."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "344_Dealer"
msgid "Very good, sir. Please take your seat."
msgstr "Muy bien, señor. Por favor, tome asiento."

#. y4:line_status=translated
msgctxt "356_Haruka"
msgid "Good luck, Uncle Kaz!"
msgstr "¡Buena suerte, Tío Kaz!"

#. y4:line_status=translated
msgctxt "380_Kiryu"
msgid "Not right now."
msgstr "Ahora no."

#. y4:line_status=translated
msgctxt "392_Dealer"
msgid "Very well. We hope you'll play with us next time."
msgstr "Muy bien. Esperamos que vuelvas a jugar con nosotros."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "404_Haruka"
msgid "Aww, I wanted to watch you play... Maybe next time?"
msgstr "Ay, quería verte jugar... ¿Quizás la próxima vez?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "416_Haruka"
msgid "Uncle Kaz! I bet you could get 2,000 points in roulette!"
