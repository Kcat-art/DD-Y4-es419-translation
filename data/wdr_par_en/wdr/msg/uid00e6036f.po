#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "68_Tanimura"
msgid "So, you're Nadine?"
msgstr "¿Así que, eres Nadine?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Nadine
#. y4:msg_speaker_id=1
msgctxt "80_Nadine"
msgid "Yes..."
msgstr "Sí..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Saki-chan
#. y4:msg_speaker_id=2
msgctxt "92_Saki-chan"
msgid "He says he's here to help you, dear."
msgstr "Él dice que está aquí para ayudarte, cariño."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Nadine
#. y4:msg_speaker_id=1
msgctxt "104_Nadine"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "116_Tanimura"
msgid "Yep. Had a heck of a time trying to find you, too. Nice work."
msgstr "Sip. Duré un montón tratando de encontrarte. Buen trabajo."

msgctxt "128_Saki-chan"
msgid "She's not out of trouble just yet. Those creeps have her\\r\n"
"passport, and she can't get home without it."
msgstr "Ella no está fuera de problemas todavía. Esos hombres aterradores tienen su pasaporte, sin eso ella no puede volver a su hogar."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "140_Tanimura"
msgid "You mean... the human traffickers?"
msgstr "Te refieres... ¿A los traficantes de personas?"

msgctxt "152_Saki-chan"
msgid "I take it you've run into them already. Well, it's not only\\r\n"
"trafficking they do. They're in charge of managing the\\r\n"
"women they bring in, too."
msgstr "Debo suponer que ya los encontraste. Bueno, no es solo tráfico que hacen. También se encargan de administrar a las mujeres que traen."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "164_Tanimura"
msgid "Managing? In what sense?"
msgstr "¿Gestión? ¿En qué sentido?"

msgctxt "176_Saki-chan"
msgid "They take the women's passports so they can't escape, and\\r\n"
"then give them just enough money to eke out a meager living.\\r\n"
"They're essentially modern-day slave drivers."
msgstr "Ellos le quitan los pasaportes para que no puedan escapar, y luego les dan dinero suficiente para vivir a duras penas. Esencialmente son esclavistas modernos."

msgctxt "188_Tanimura"
msgid "Ugh... That's terrible. I hate bastards like that the most.\\r\n"
"You have any idea where they are?"
msgstr "Ew... Eso es terrible. Odio a los bastardos de ese tipo. ¿Tienes una idea en donde se encuentran?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Saki-chan
#. y4:msg_speaker_id=2
msgctxt "200_Saki-chan"
msgid "In a dilapidated food warehouse on the docks."
msgstr "En un almacén deteriorado en los muelles."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Nadine
#. y4:msg_speaker_id=1
msgctxt "212_Nadine"
msgid "I want go home to the Philippines..."
msgstr "Quiero regresar a mi casa en Filipinas..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "224_Tanimura"
msgid "Don't worry. I'll get your passport back."
msgstr "No te preocupes. Te devolveré el pasaporte."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Nadine
#. y4:msg_speaker_id=1
msgctxt "236_Nadine"
msgid "You will!?"
msgstr "¿¡De verdad!?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "248_Tanimura"
msgid "Yup. Just leave it to me."
msgstr "Sip. Déjemelo todo a mí."
