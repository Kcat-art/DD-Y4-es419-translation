msgid "I understand. But I'm happy to hear you're interested."
msgstr "Comprendo. Pero me alegra oír que estés interesado."

msgctxt "428_Takeda"
msgid "I'm Takeda, a manager at Oyamada Talent Productions.\\r\n"
"Let's head to our office to discuss the particulars."
msgstr "Me llamo Takeda, soy un manager en Oyamada Talent Productions.\\r\n"
"Acompañame a mi oficina para discutir los detalles."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=15
#. y4:msg_location=T2.P15
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Turn Him Down
msgctxt "452_Saejima"
msgid "Nope."
msgstr "No."

msgctxt "464_Man in Black"
msgid "I'd really like to discuss this opportunity with you.\\r\n"
"Meet me here if you happen to change your mind."
msgstr "De verdad me encantaría discutir esta oportunidad contigo.\\r\n"
"Estaré justo aquí por si cambias de parecer."

