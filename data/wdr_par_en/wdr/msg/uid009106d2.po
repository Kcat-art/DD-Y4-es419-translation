#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=7
msgctxt "312_Akaishi"
msgid "Hm?"
msgstr "¿Mm?"

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "324_Kiryu"
msgid "I bet the Kamurocho Guard will eventually grow strong enough to crush Black Nightmare and any other gang like it."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "336_Kiryu"
msgid "I told their boss the same thing, by the way. You just keep doing the best you can."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=7
msgctxt "348_Akaishi"
msgid "Do you really think you should be inflating our reputation like that!?"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "360_Kiryu"
msgid "What, aren't you committed to your cause? Don't let me down here."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=7
msgctxt "372_Akaishi"
msgid "Oh, no! I mean, yes, of course I'm committed! We'll give it our all."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "384_Kiryu"
msgid "I don't want to sound like a broken record, but I'm putting a lot of faith in you. The future of Kamurocho may very well rest on your shoulders!"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=7
msgctxt "396_Akaishi"
msgid "Wow! I can't tell you how much your words of support mean to me! I'll do whatever I can!"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=7
msgctxt "408_Akaishi"
msgid "Oh, this is a token of my appreciation."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
