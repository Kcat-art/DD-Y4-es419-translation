msgid "Er... Is this Sky Finance?"
msgstr "Disculpe..., ¿aquí queda Sky Finance?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=7
#. y4:msg_phrase=1
#. y4:msg_location=T7.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "460_Akiyama"
msgid "Whoops! Yeah, it is. Are, uh... you a customer?"
msgstr "¡Ah! Sí, aquí es. Supongo que necesita de nuestros\nservicios, ¿no?"

#. y4:line_status=translated
msgctxt "472_Desperate Man"
msgid "Can you help me!? I need money... Oh, won't you please give\\r\nme a loan!?"
msgstr "¡¿Podría ayudarme?! Necesito dinero... ¡¿Me daría un préstamo?!"

