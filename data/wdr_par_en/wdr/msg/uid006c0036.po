msgctxt "7020_Kiryu"
msgid "Maybe you should stop drinking."
msgstr "Tal vez deberías dejar de beber."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
