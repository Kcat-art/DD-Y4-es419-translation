#. y4:msg_branch_target=T29.P12
#. y4:msg_branch_segment=T29.P12..P18
#. y4:msg_branch_target_text=Don't you get tired of eating the same thing?
#. y4:msg_branch_raw=01 11 00 0c 00 00 00 2d 00 00 00 00 00 00 00 00
msgctxt "14436_Akiyama"
msgid "Don't you get tired of eating the same thing?"
msgstr "¿No te cansas de comer lo mismo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=13
#. y4:msg_location=T29.P13
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Don't you get tired of eating the same thing?
msgctxt "14448_Noa"
msgid "Not at all. I could eat chestnut cream cake every day."
msgstr "Para nada. Podría comer pastel de crema de castañas todos los días."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=14
#. y4:msg_location=T29.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Don't you get tired of eating the same thing?
msgctxt "14460_Akiyama"
msgid "Seems like a waste. There are so many other kinds of delicious cake. We could try some together."
msgstr "Parece un desperdicio. Hay tantos otros tipos de pasteles deliciosos. Podríamos probar algunos juntos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=15
#. y4:msg_location=T29.P15
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Don't you get tired of eating the same thing?
msgctxt "14472_Noa"
msgid "No thanks. I don't like the fancy stuff."
msgstr "No, gracias. No me gustan las cosas elegantes."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=16
#. y4:msg_location=T29.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Don't you get tired of eating the same thing?
msgctxt "14484_Akiyama"
msgid "Don't say that before you even try it! Come on, let's go."
msgstr "¡No digas eso antes de siquiera intentarlo!, vamos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=17
#. y4:msg_location=T29.P17
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Don't you get tired of eating the same thing?
msgctxt "14496_Noa"
msgid "Oh, give it a rest! Quit making me feel bad about the cake I like!"
msgstr "¡Basta ya! ¡Deje de hacerme sentir mal por el pastel que me gusta!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=18
#. y4:msg_location=T29.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Don't you get tired of eating the same thing?
msgctxt "14508_Akiyama"
msgid "Oh, sorry..."
msgstr "Oh, lo siento..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=19
#. y4:msg_location=T29.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Have you ever tried baking a cake yourself?
msgctxt "14520_Akiyama"
msgid "Have you ever tried baking a cake yourself? It shouldn't be too hard."
msgstr "¿Alguna vez has intentado hornear un pastel tú misma? No debería ser demasiado difícil."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=20
#. y4:msg_location=T29.P20
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Have you ever tried baking a cake yourself?
msgctxt "14532_Noa"
msgid "Akiyama-san, I can barely boil water. Could I really make a cake all by myself?"
msgstr "Akiyama-san, apenas puedo hervir agua. ¿Podría hacer un pastel yo sola?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=21
#. y4:msg_location=T29.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Have you ever tried baking a cake yourself?
msgctxt "14544_Akiyama"
msgid "Oh, I forgot that you can't cook..."
msgstr "Oh, olvidé que no puedes cocinar..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=22
#. y4:msg_location=T29.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Have you ever tried baking a cake yourself?
msgctxt "14556_Akiyama"
msgid "But you seem to like those three kinds of cake so much. Maybe that's the motivation you need to give baking a try."
msgstr "Pero parece que te gustan mucho esos tres tipos de pastel. Quizá esa sea la motivación que necesitas para darle una oportunidad a la repostería."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=23
#. y4:msg_location=T29.P23
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Have you ever tried baking a cake yourself?
msgctxt "14568_Noa"
msgid "Hmm. It would be nice to have cake whenever I want..."
msgstr "Hmm. Estaría bien poder comer pastel cuando quiera..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=24
#. y4:msg_location=T29.P24
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Have you ever tried baking a cake yourself?
msgctxt "14580_Noa"
msgid "Okay, I'll do it! If it turns out well, I can give you some."
msgstr "¡Está bien, lo haré! Si sale bien, puedo darle un poco."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=25
#. y4:msg_location=T29.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Have you ever tried baking a cake yourself?
msgctxt "14592_Akiyama"
msgid "I'll be looking forward to it."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=30
#. y4:msg_section_label=Conversación 30
#. y4:msg_talk=30
#. y4:msg_phrase=0
#. y4:msg_location=T30.P0
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "14604_Noa"
msgid "Akiyama-san!"
msgstr "¡Akiyama-san!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=1
#. y4:msg_location=T9.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "14616_Akiyama"
msgid "What's wrong?"
msgstr "¿Qué ocurre?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=30
#. y4:msg_section_label=Conversación 30
#. y4:msg_talk=30
#. y4:msg_phrase=2
#. y4:msg_location=T30.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "14628_Noa"
msgid "I've got another stalker."
msgstr "Tengo otro acosador."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=30
#. y4:msg_section_label=Conversación 30
#. y4:msg_talk=30
#. y4:msg_phrase=3
#. y4:msg_location=T30.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "14640_Akiyama"
msgid "What!? Seriously!?"
msgstr "¡¿Qué?! ¿¡En serio!?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=22
#. y4:msg_location=T1.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Actually, I'm the one who's been stalking you.
msgctxt "14652_Noa"
msgid "Haha! Just kidding!"
msgstr "Es broma, ¡Ja, ja, caíste!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=30
#. y4:msg_section_label=Conversación 30
#. y4:msg_talk=30
#. y4:msg_phrase=5
#. y4:msg_location=T30.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "14664_Akiyama"
msgid "Hmph. You're on your own if you get any more."
msgstr "Hmph. Estás por tu cuenta si consigues más."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=30
#. y4:msg_section_label=Conversación 30
#. y4:msg_talk=30
#. y4:msg_phrase=6
#. y4:msg_location=T30.P6
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=30
#. y4:msg_decision_choices=1. You shouldn't joke around about it. -> T30.P7 | 2. I was only kidding. -> T30.P12 | 3. Uh, you're touching me again. -> T30.P18
msgctxt "14676_Noa"
msgid "Wait, really!? You'd stop helping me?"
msgstr "Espera, ¿¡en serio!? ¿Dejaría de ayudarme?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=30
#. y4:msg_section_label=Conversación 30
#. y4:msg_talk=30
#. y4:msg_phrase=7
#. y4:msg_location=T30.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You shouldn't joke around about it.
msgctxt "14688_Akiyama"
msgid "You shouldn't joke around about it. If you don't take it seriously, I won't help you."
msgstr "No debes bromear al respecto. Si no te lo tomas en serio, no te ayudaré."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=30
#. y4:msg_section_label=Conversación 30
#. y4:msg_talk=30
#. y4:msg_phrase=8
#. y4:msg_location=T30.P8
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You shouldn't joke around about it.
msgctxt "14700_Noa"
msgid "No! I couldn't handle it without you."
msgstr "¡No! No podría manejarlo sin usted."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=30
#. y4:msg_section_label=Conversación 30
#. y4:msg_talk=30
#. y4:msg_phrase=9
