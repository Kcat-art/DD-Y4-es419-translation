#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I could pick out an outfit for you.
msgctxt "10500_Kiryu"
msgid "Let me see... How about a red dress with a fur coat?"
msgstr "Déjame ver... ¿Qué tal un vestido rojo con un abrigo de piel?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
