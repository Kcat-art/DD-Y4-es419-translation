#. y4:msg_branch_raw=01 11 00 08 00 00 00 1d 00 00 00 00 00 00 00 00
msgctxt "11136_Kiryu"
msgid "She sounds pretty aggressive."
msgstr "Suena bastante agresiva."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=9
#. y4:msg_location=T19.P9
