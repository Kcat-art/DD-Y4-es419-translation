msgctxt "6396_Kiryu"
msgid "I'd stay a human."
msgstr "Seguiría siendo un ser humano."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=11
