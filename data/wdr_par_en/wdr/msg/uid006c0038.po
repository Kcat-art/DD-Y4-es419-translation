#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sure. I find them every day.
msgctxt "5400_Kiryu"
msgid "It's not like I'm having affairs."
msgstr "No es que esté teniendo algo serio con ellas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
