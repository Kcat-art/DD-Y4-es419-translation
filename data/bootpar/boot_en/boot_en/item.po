msgctxt "88847\tEXPLANATION"
msgid "This Mozzarella Cheese Caprese uses fresh tomatoes and mozzarella cheese topped with light olive oil."
msgstr "Esta Caprese de queso mozzarella utiliza tomates frescos y queso mozzarella, cubierta con un toque de aceite de oliva ligero."

#. y4:line_status=translated
msgctxt "88949\tEXPLANATION"
