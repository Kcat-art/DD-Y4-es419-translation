#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's with young girls these days?
msgctxt "4932_Erena"
msgid "Hahahah! You're funny!"
msgstr "¡Ja, ja, ja! ¡Eres muy gracioso!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=30
#. y4:msg_location=T1.P30
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's with young girls these days?
msgctxt "4944_Erena"
msgid "But haven't you ever had an experience like that? Ya know, love at first sight?"
msgstr "Pero, ¿no has tenido alguna vez una experiencia como esa? ¿Amor a primera vista?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=31
#. y4:msg_location=T1.P31
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's with young girls these days?
msgctxt "4956_Akiyama"
msgid "Sure I have. When I saw you, for instance."
msgstr "Claro. Cuando te vi, por ejemplo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=32
