#. y4:msg_speaker_id=0
msgctxt "4836_望月京子：源氏名"
msgid "My ultimate goal is to go on a world tour with my band."
msgstr "Mi gran objetivo con la banda es hacer una gira mundial."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
