#. y4:msg_branch_choice=That's a positive way to look at things.
msgctxt "8748_Rio"
msgid "Not really. It's pretty negative."
msgstr "La verdad es que no. Es bastante negativo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=32
