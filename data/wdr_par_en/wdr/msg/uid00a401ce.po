msgctxt "128_Forex Company Employee"
msgid "Are you here for the forex information session?\\r\n"
"Thank you very much!"
msgstr "¿Viene por la charla informativa de forex?\\r\n"
"¡Un placer tenerle aquí!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm not interested.
msgctxt "140_Akiyama"
msgid "I'm not particularly interested in forex, no."
msgstr "No. No estoy muy interesado en el FX."

msgctxt "152_Forex Company Employee"
msgid "Oh, you aren't? Well, we're always holding information\\r\n"
"sessions here, so stop by if you ever want to learn more!"
msgstr "¿Seguro? Bueno, siempre tenemos charlas de estas, así\\r\n"
"que le esperamos por aquí si alguna vez quiere aprender."

msgctxt "164_Akiyama"
msgid "I am a little interested in forex, yes. I came by to learn\\r\n"
"more."
msgstr "Estoy un poco interesado en el FX. Vine a informarme."

