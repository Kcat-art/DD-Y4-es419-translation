#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Both legs bouncing sounds annoying.
msgctxt "7992_Rio"
msgid "I did a double take the first time I saw it!"
msgstr "¡Tuve que comprobar dos veces la primera vez que lo vi!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
