#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=0
#. y4:msg_location=T26.P0
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "13212_Noa"
msgid "My little brother's birthday is coming up."
msgstr "Se acerca el cumpleaños de mi hermanito."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=1
#. y4:msg_location=T26.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "13224_Akiyama"
msgid "Oh? How old is he going to be?"
msgstr "¿Oh? ¿Cuántos años va a tener?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=2
#. y4:msg_location=T26.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "13236_Noa"
msgid "Eighteen."
msgstr "Dieciocho."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=3
#. y4:msg_location=T26.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "13248_Akiyama"
msgid "So he's not much younger than you."
msgstr "Así que no es mucho más joven que tú."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=4
#. y4:msg_location=T26.P4
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "13260_Noa"
msgid "Yeah. He says that he wants to go to a movie on his birthday."
msgstr "Sí. Dice que quiere ir al cine en su cumpleaños."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=5
#. y4:msg_location=T26.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "13272_Akiyama"
msgid "With you? Doesn't he have a girlfriend?"
msgstr "¿Contigo? ¿No tiene novia?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=6
#. y4:msg_location=T26.P6
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "13284_Noa"
msgid "I don't think so. Not if he wants to hang out with me on his birthday."
msgstr "No lo creo. No si quiere salir conmigo en su cumpleaños."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=7
#. y4:msg_location=T26.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "13296_Akiyama"
msgid "Heheh. Fair enough."
msgstr "Jejeje. Bastante justo."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=8
#. y4:msg_location=T26.P8
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=26
#. y4:msg_decision_choices=1. You don't mind going? -> T26.P9 | 2. Why don't you introduce him to a girl? -> T26.P17 | 3. It's a bit weird, too. -> T26.P24
msgctxt "13308_Noa"
msgid "It's kinda sad going to a movie with your big sister on your eighteenth birthday."
msgstr "Es un poco triste ir al cine con tu hermana mayor en tu decimoctavo cumpleaños."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=9
#. y4:msg_location=T26.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You don't mind going?
msgctxt "13320_Akiyama"
msgid "You don't mind going? Don't you need to find a boyfriend yourself?"
msgstr "¿No te molesta ir? ¿No deberías encontrar tú un novio?"

msgctxt "13332_Noa"
msgid "Oh, I'm okay. I've already got someone I like. <Color:7>♥<Color:Default>"
msgstr "Oh, estoy bien. Ya tengo a alguien que me gusta. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=11
#. y4:msg_location=T26.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You don't mind going?
msgctxt "13344_Akiyama"
msgid "You do? You've never mentioned that before."
msgstr "¿Ya tienes? Nunca habías mencionado eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=12
#. y4:msg_location=T26.P12
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You don't mind going?
msgctxt "13356_Noa"
msgid "Well, it's a secret."
msgstr "Bueno, es un secreto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=13
#. y4:msg_location=T26.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You don't mind going?
msgctxt "13368_Akiyama"
msgid "Then why do you come to me with your stalker problems? Shouldn't you be talking to this guy?"
msgstr "¿Entonces por qué vienes a mí con tus problemas de acosador? ¿No deberías estar hablando con ese tipo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=14
#. y4:msg_location=T26.P14
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You don't mind going?
msgctxt "13380_Noa"
msgid "I already am."
msgstr "Ya lo estoy haciendo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=15
#. y4:msg_location=T26.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You don't mind going?
msgctxt "13392_Akiyama"
msgid "Huh? You are?"
msgstr "¿eh? ¿lo estas haciendo?"

msgctxt "13404_Noa"
msgid "Hehe, yep. He's been a big help. <Color:7>♥<Color:Default>"
msgstr "Jeje, sí. Ha sido de gran ayuda. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=17
#. y4:msg_location=T26.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you introduce him to a girl?
msgctxt "13416_Akiyama"
msgid "Why don't you introduce him to a girl? Do you have a friend who needs a boyfriend?"
msgstr "¿Por qué no le presentas a una chica? ¿Tienes una amiga que necesita novio?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=18
#. y4:msg_location=T26.P18
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you introduce him to a girl?
msgctxt "13428_Noa"
msgid "I don't want to introduce any of my friends to my brother."
msgstr "No quiero presentarle a ninguna de mis amigas a mi hermano."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=19
#. y4:msg_location=T26.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you introduce him to a girl?
msgctxt "13440_Akiyama"
msgid "That's kind of mean."
msgstr "Eso es un poco cruel."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=20
#. y4:msg_location=T26.P20
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you introduce him to a girl?
msgctxt "13452_Noa"
msgid "Yeah, you caught me."
msgstr "Sí, me atrapó."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=21
#. y4:msg_location=T26.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you introduce him to a girl?
msgctxt "13464_Akiyama"
msgid "But he's your brother. You don't mind helping him out a little, do you?"
msgstr "Pero es tu hermano. No te importa ayudarlo un poco, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=22
#. y4:msg_location=T26.P22
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you introduce him to a girl?
msgctxt "13476_Noa"
msgid "Actually, I do. He should be able to get girls on his own."
msgstr "En realidad, sí. Debería ser capaz de conseguir chicas por sí mismo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=23
#. y4:msg_location=T26.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you introduce him to a girl?
msgctxt "13488_Akiyama"
msgid "Oh. Okay."
msgstr "Oh. Está bien."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=201
#. y4:msg_phrase=0
#. y4:msg_location=T201.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T26.P24
#. y4:msg_branch_segment=T26.P24..P31
#. y4:msg_branch_target_text=It's a bit weird, too.
#. y4:msg_branch_raw=01 11 00 18 00 00 00 16 00 00 00 00 00 00 00 00
msgctxt "13500_Akiyama"
msgid "It's a bit weird, too."
msgstr "Es un poco raro, también."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=25
#. y4:msg_location=T26.P25
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It's a bit weird, too.
msgctxt "13512_Noa"
msgid "Hmm? What do you mean weird?"
msgstr "¿Hmm? ¿A qué te refieres con raro?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=26
#. y4:msg_location=T26.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It's a bit weird, too.
msgctxt "13524_Akiyama"
msgid "Well, even if he doesn't have a girlfriend, you'd think he'd rather go out with one of his friends."
msgstr "Bueno, incluso si no tiene novia, uno pensaría que preferiría salir con uno de sus amigos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=27
#. y4:msg_location=T26.P27
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It's a bit weird, too.
msgctxt "13536_Noa"
msgid "Yeah, that's true."
msgstr "Sí, eso es verdad."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=28
#. y4:msg_location=T26.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It's a bit weird, too.
msgctxt "13548_Akiyama"
msgid "Still, I'm a little envious of him, going out with such a pretty girl."
msgstr "Aun así, le tengo un poco de envidia, saliendo con una chica tan guapa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=29
#. y4:msg_location=T26.P29
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It's a bit weird, too.
msgctxt "13560_Noa"
msgid "Haha. But if he keeps going out with me, he'll never get a girlfriend."
msgstr "Aun así, le tengo un poco de envidia, saliendo con una chica tan guapa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=30
#. y4:msg_location=T26.P30
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It's a bit weird, too.
msgctxt "13572_Noa"
msgid "Maybe I'll have a talk with him."
msgstr "Tal vez tenga una charla con él."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It's probably because I enjoy my work.
msgctxt "13584_Akiyama"
msgid "Heheh."
msgstr "Je, je, je."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=0
#. y4:msg_location=T27.P0
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "13596_Noa"
msgid "I'm gonna have to say goodbye to my kids pretty soon."
msgstr "Voy a tener que despedirme de mis niños muy pronto."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=1
#. y4:msg_location=T27.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "13608_Akiyama"
msgid "Your kids? Oh, you mean your ballet class?"
msgstr "¿Tus niños? Oh, ¿te refieres a tu clase de ballet?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=2
#. y4:msg_location=T27.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "13620_Noa"
msgid "That's right. I've been so busy that I decided to take some time off from teaching."
msgstr "Así es. He estado tan ocupada que decidí tomarme un tiempo libre de la enseñanza."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=3
#. y4:msg_location=T27.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "13632_Akiyama"
msgid "That's too bad. But you could use a break, right?"
msgstr "Es una lástima. Pero te vendría bien un descanso, ¿verdad?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=4
#. y4:msg_location=T27.P4
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "13644_Noa"
msgid "I guess. They're always making noise and crawling all over me."
msgstr "Supongo que sí. Siempre están haciendo ruido y arrastrándose sobre mí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=5
#. y4:msg_location=T27.P5
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "13656_Noa"
msgid "And they can be pretty selfish."
msgstr "Y pueden ser bastante egoístas."

msgctxt "13668_Noa"
msgid "But I love them. <Color:7>♥<Color:Default>"
msgstr "Pero los amo. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It's probably because I enjoy my work.
msgctxt "13680_Akiyama"
msgid "Heheh."
msgstr "Je, je, je."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=8
#. y4:msg_location=T27.P8
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "13692_Noa"
msgid "They come up and hug me and whisper, \"I love you.\""
msgstr "Se acercan, me abrazan y me susurran: \"Te amo\"."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=9
#. y4:msg_location=T27.P9
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "13704_Noa"
msgid "And they tell me all about their lives. All the fun and interesting stuff they do."
msgstr "Y me cuentan todo sobre sus vidas. Todas las cosas divertidas e interesantes que hacen."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=10
#. y4:msg_location=T27.P10
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=27
#. y4:msg_decision_choices=1. You'll see them again. -> T27.P11 | 2. They might forget you sooner than you think. -> T27.P17 | 3. You have to say goodbye sooner or later. -> T27.P23
msgctxt "13716_Noa"
msgid "I'm really going to miss them..."
msgstr "Los voy a echar mucho de menos..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=11
#. y4:msg_location=T27.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You'll see them again.
msgctxt "13728_Akiyama"
msgid "You'll see them again. You're not quitting ballet, right?"
msgstr "Los volverás a ver. No vas a dejar el ballet, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
