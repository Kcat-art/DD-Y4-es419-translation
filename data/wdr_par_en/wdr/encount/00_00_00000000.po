#. y4:line_status=reviewed
#. y4:translated_by=Keiner
#. y4:reviewed_by=Keiner
msgctxt "128_Man"
msgid "Can you let me borrow some o' that too? And if I can't, I'll just hafta make you!"
msgstr "¿Me prestas un poquito? ¡Si no, tendré que obligarte!"

#. y4:line_status=reviewed
