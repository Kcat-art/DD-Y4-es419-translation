#. y4:msg_location=T0.P22
#. y4:msg_speaker=Blue Z, Member A
#. y4:msg_speaker_id=0
msgctxt "320_Blue Z, Member A"
msgid "Whoa, she took off!"
msgstr "¡Vaya, se largó!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Blue Z Members
#. y4:msg_speaker_id=16
msgctxt "344_Blue Z Members"
msgid "Aw, man!"
msgstr "¡Oh, venga ya!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Blue Z, Member A
#. y4:msg_speaker_id=0
msgctxt "368_Blue Z, Member A"
msgid "Damn, pops! We were, like, this close to scorin'!"
msgstr "¡Maldito viejo! ¡Estábamos a punto de conseguirlo!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Blue Z, Member D
#. y4:msg_speaker_id=9
msgctxt "380_Blue Z, Member D"
msgid "Aota-san, let's teach this old fart a lesson!"
msgstr "¡Aota-san, vamos a darle una lección a este viejo!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Older-Looking Man
#. y4:msg_speaker_id=6
msgctxt "392_Aota"
msgid "......"
msgstr "......"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Aota
#. y4:msg_speaker_id=14
msgctxt "404_Aota"
msgid "Yeah, maybe we should..."
msgstr "Sí, tal vez deberíamos..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Aota
#. y4:msg_speaker_id=14
msgctxt "416_Aota"
msgid "All right, boys! Let's show this has-been a thing or two!"
msgstr "¡Muy bien, chicos! ¡Mostremos a este viejo un par de cosas!"
