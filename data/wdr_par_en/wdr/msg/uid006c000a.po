#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=9
#. y4:msg_decision_choices=1. That takes coordination. -> T9.P10 | 2. That's your special talent? -> T9.P17 | 3. I'd give it a four out of ten. -> T9.P24
msgctxt "4644_Chihiro"
msgid "What do you think?"
msgstr "¿Qué opina?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
