#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe it needs a new battery.
msgctxt "2296_Short Man"
msgid "(...I don't know, man. It just popped out.)"
msgstr "(... No lo sé, simplemente. Se me ocurrió.)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
