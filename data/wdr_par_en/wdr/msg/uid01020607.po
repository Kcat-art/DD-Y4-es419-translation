#. y4:msg_speaker=Date
#. y4:msg_speaker_id=0
msgctxt "84_Date"
msgid "Hold on a sec, Kiryu."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "96_Kiryu"
msgid "What's wrong?"
msgstr "¿Qué ocurre?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=0
msgctxt "108_Date"
msgid "There's something I need to tell you."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=0
msgctxt "120_Date"
msgid "Couldn't really say it in there."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "132_Kiryu"
msgid "Does it involve Yasuko-san?"
msgstr ""

msgctxt "144_Date"
msgid "You bet. If she found out about this, she'd just end up\\r\n"
"getting herself into more trouble."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "156_Kiryu"
msgid "Well? What is it?"
msgstr ""

msgctxt "168_Date"
msgid "Well... You only just got here so you probably haven't\\r\n"
"noticed, but the whole town's been kinda on edge lately."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "180_Kiryu"
msgid "Because of Saejima?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=0
msgctxt "192_Date"
msgid "Partially, I'm sure. But there's more to it than that."
msgstr ""

msgctxt "204_Date"
msgid "Word on the street is, Majima and Saejima linked up a few\\r\n"
"days ago."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "216_Kiryu"
msgid "What!?"
msgstr "¡¿Qué?!"

msgctxt "228_Date"
msgid "Yup. I hear Majima had his boys line the whole damn street\\r\n"
"to keep the cops off Saejima."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "240_Kiryu"
msgid "Huh. So they've already met."
msgstr ""

msgctxt "252_Kiryu"
msgid "Speaking of, Date-san... do you know where I can find\\r\n"
"Majima-san? I need to talk to him as soon as possible."
msgstr ""

msgctxt "264_Kiryu"
msgid "Not just about Saejima. Majima-san might be able to tell me\\r\n"
"more about the connection between the top police brass,\\r\n"
"Jingu, and the Tojo Clan."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=0
msgctxt "276_Date"
msgid "The police? What are you talking about?"
msgstr ""

msgctxt "288_Kiryu"
msgid "Sorry, but I can't say much more than that. Just know that\\r\n"
"people are gunning for the Tojo."
msgstr ""

msgctxt "300_Kiryu"
msgid "And no matter what's going down, I need to hear Majima-san's\\r\n"
"side of the story."
msgstr ""

msgctxt "312_Date"
msgid "All right. Last I heard, he'd taken root up on the top floor\\r\n"
"of the Millennium Tower. Starting there's your best bet."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "324_Kiryu"
msgid "Great. Thanks, Date-san."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "396_Kiryu"
msgid "(Can't think of a better place to talk than New Serena.)"
msgstr ""

msgctxt "408_Kiryu"
msgid "Yasuko-san, there's a bar near here that I used to go to\\r\n"
"back in the day. We can catch our breath there for a bit."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Yasuko
#. y4:msg_speaker_id=7
msgctxt "420_Yasuko"
msgid "Okay, I'll follow your lead."
msgstr ""
