#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
msgctxt "152_Man"
msgid "That's enough! Really!"
msgstr "¡Ya basta! ¡En enserio!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
