#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Miki
#. y4:msg_speaker_id=7
msgctxt "560_Miki"
msgid "I'm listening."
msgstr "Te escucho."

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Akiyama
