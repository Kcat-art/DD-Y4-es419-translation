#. y4:msg_choice_index=1
#. y4:msg_branch_choice=If you're not sure, you shouldn't do it.
msgctxt "9024_Kiryu"
msgid "Shouldn't that be up to you?"
msgstr "¿Eso no debería depender de ti?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=15
#. y4:msg_location=T13.P15
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=If you're not sure, you shouldn't do it.
msgctxt "9036_松岡里緒奈：源氏名"
msgid "I just want to know what you think."
msgstr "Sólo quiero saber lo que piensas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
