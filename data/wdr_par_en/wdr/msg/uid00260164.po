#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "80_Kiryu"
msgid "You sure know how to get what you want."
msgstr "No tengo dudas de que sabes cómo conseguir lo que quieres."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "104_松岡里緒奈：源氏名"
msgid "I think I'm gonna stay on at the club."
msgstr "Creo... que me quedaré en el club."

#. y4:line_status=translated
msgctxt "116_Kiryu"
msgid "Why?"
msgstr "¿Tú?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "128_松岡里緒奈：源氏名"
msgid "I've never seen my dad look so happy."
msgstr "Nunca vi a mi padre tan contento."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "140_松岡里緒奈：源氏名"
msgid "If I can make my customers that happy just by having a drink with them, well..."
msgstr "Si puedo hacer felices a mis clientes con solo tomar un rato con ellos..."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "152_松岡里緒奈：源氏名"
msgid "I feel it's my duty to keep doing it."
msgstr "Siento que es mi deber seguir con ello."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "164_松岡里緒奈：源氏名"
msgid "Besides, I really enjoy working as a hostess now! <Color:255,200,200,255>♥<Color:Default>"
msgstr "Ademas, ¡disfruto mucho trabajando como una hostess! <Color:255,200,200,255>♥<Color:Default>"

#. y4:line_status=translated
msgctxt "176_Kiryu"
msgid "I see..."
msgstr "Ya veo..."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "188_松岡里緒奈：源氏名"
msgid "So you can come and see me anytime you like! <Color:255,200,200,255>♥<Color:Default>"
msgstr "¡Y puedes venir a verme las veces que quieras! <Color:255,200,200,255>♥<Color:Default>"

#. y4:line_status=translated
msgctxt "200_Kiryu"
msgid "Good."
msgstr "Perfecto."

