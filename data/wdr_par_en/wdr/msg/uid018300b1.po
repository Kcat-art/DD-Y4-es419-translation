#. y4:msg_speaker_id=9
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You're letting it bother you too much.
msgctxt "7220_Tanimura"
msgid "If you're going to be that bothered by them, you're going to ruin your time at the hot spring."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
