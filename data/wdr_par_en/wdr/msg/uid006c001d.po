#. y4:msg_location=T18.P36
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I take my time and lick it slowly.
msgctxt "13728_Rio"
msgid "Hehehe!"
msgstr "¡Je, je, je!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
