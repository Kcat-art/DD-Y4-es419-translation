#. y4:msg_location=T16.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12252_Rio"
msgid "I hung out with an old classmate from high school yesterday."
msgstr "Ayer estuve con uno de mis antiguos compañeros de la secundaria."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=1
#. y4:msg_location=T16.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "12264_Akiyama"
msgid "Oh yeah? A guy or a girl?"
msgstr "¿Ah, sí? ¿Un chico o una chica?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=2
#. y4:msg_location=T16.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12276_Rio"
msgid "A girl. I went to an all-girls school."
msgstr "Una chica. Fui a una escuela solo para chicas."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=3
#. y4:msg_location=T16.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "12288_Akiyama"
msgid "I didn't know that."
msgstr "No sabía eso."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=4
#. y4:msg_location=T16.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12300_Rio"
msgid "Yep! It was tons of fun!"
msgstr "¡Sí! ¡Fue muy divertido!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=5
#. y4:msg_location=T16.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "12312_Akiyama"
msgid "I guess an all-girls school would be pretty cool..."
msgstr "Supongo que una escuela solo para chicas debe ser bastante genial..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=6
#. y4:msg_location=T16.P6
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12324_Rio"
msgid "Of course! When it's just girls, we let it all hang out!"
msgstr "¡Por supuesto! ¡Cuando solo somos chicas, nos soltamos completamente!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=7
#. y4:msg_location=T16.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12336_Rio"
msgid "If there were boys around, we probably would've tried being all cute and nice."
msgstr "Si hubiera chicos alrededor, probablemente habríamos intentado actuar lindas y agradables."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=8
#. y4:msg_location=T16.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "12348_Akiyama"
msgid "Heh. I think I get what you mean. That's pretty honest of you."
msgstr "Je. Creo que entiendo lo que quieres decir. Eso es muy honesto de tu parte."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
