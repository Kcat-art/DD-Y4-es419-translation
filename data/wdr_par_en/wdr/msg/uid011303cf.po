msgid "The way that he fights fair and square in the name of justice. That's what makes him so cool."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=18
