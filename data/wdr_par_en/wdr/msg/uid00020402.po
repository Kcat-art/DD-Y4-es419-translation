#. y4:msg_location=T0.P2
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Ask About Purgatory -> T0.P4 | 2. Ask About the Florist -> T0.P13
msgctxt "184_Saejima"
msgid "Yeah."
msgstr "Sí."

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
