#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6828_Rio"
msgid "Are you sure?"
msgstr "¿Está seguro?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
