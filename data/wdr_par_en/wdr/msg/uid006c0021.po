#. y4:msg_branch_segment=T4.P20..P27
#. y4:msg_branch_target_text=Maybe I should try that one myself.
#. y4:msg_branch_raw=01 11 00 14 00 00 00 23 00 00 00 00 00 00 00 00
msgctxt "6144_Akiyama"
msgid "Maybe I should try that one myself."
msgstr "Tal vez debería intentarlo yo mismo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
