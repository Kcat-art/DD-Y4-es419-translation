#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That last one's pretty obvious, don't you think?
msgctxt "9012_Noa"
msgid "Well, whatever! I just want to be treated well!"
msgstr "¡Bueno, lo que sea! ¡Sólo quiero que me traten bien!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=29
#. y4:msg_location=T13.P29
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That last one's pretty obvious, don't you think?
msgctxt "9024_Akiyama"
msgid "I understand, but were you treated badly in the past or something?"
msgstr "Lo entiendo, pero ¿te trataron mal en el pasado o algo así?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=30
