msgid "However, the only information you can <Color:7>input<Color:Default> is that of particularly strong enemies, ones who made a lasting impression on you."
msgstr "Sin embargo, la única información que puedes <Color:7>ingresar<Color:Default> es la de enemigos\n"
"particularmente fuertes que te dejaron con una gran impresión."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
