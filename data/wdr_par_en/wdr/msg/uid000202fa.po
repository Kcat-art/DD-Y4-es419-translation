msgctxt "56_Saejima"
msgid "'Scuse me. Know where I can find an info broker?"
msgstr "Discúlpeme. ¿Sabe dónde puedo encontrar un agente de información?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Homeless Man
#. y4:msg_speaker_id=2
msgctxt "68_Homeless Man"
msgid "Who, me? Nah, I don't know a thing."
msgstr "¿Quién, yo? Qué va, no sé nada."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "80_Saejima"
msgid "Alright. Mind lettin' me by so I can ask someone who does?"
msgstr "De acuerdo. ¿Te importa dejarme pasar para poder preguntarle a alguien que lo sepa?"

#. y4:line_status=translated
msgctxt "92_Homeless Man"
msgid "No one's up ahead. You'd just be wasting your time.\\r\nI'd look elsewhere if I was you."
msgstr "Nadie está por delante. Estarías perdiendo el tiempo.\\r\nSi fuera tú, buscaría en otra parte."
