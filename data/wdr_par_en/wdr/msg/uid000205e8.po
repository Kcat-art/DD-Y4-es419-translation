msgctxt "160"
msgid "Kamuro taxi driver is now your ally."
msgstr "El taxista Kamuro ahora es tu aliado."

#. y4:line_status=translated
#. y4:msg_role=name
#. y4:msg_name_id=0
msgctxt "4352"
msgid "Taxi Driver"
msgstr "Taxista"

#. y4:line_status=translated
#. y4:msg_role=name
#. y4:msg_name_id=1
