#. y4:msg_branch_segment=T0.P26..P35
#. y4:msg_branch_target_text=Why don't you stay for a bit longer?
#. y4:msg_branch_raw=01 11 00 1a 00 00 00 24 00 00 00 00 00 00 00 00
msgctxt "17532_Kiryu"
msgid "Why don't you stay for a bit longer?"
msgstr "¿Por qué no te quedas un poco más?"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=124
#. y4:msg_phrase=0
#. y4:msg_location=T124.P0
