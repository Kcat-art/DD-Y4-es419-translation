msgctxt "6696_Kiryu"
msgid "We should go out for all-you-can-eat yakiniku. Get your stomach ready."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
