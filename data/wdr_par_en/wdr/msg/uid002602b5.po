#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why the hell not?
msgctxt "964_Saejima"
msgid "They don't look like they're doing too good."
msgstr "No parece que les esté yendo muy bien."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
