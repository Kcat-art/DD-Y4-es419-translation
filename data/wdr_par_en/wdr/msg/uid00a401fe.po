msgid "Talk_Quest"
msgstr "Talk_Quest"

msgctxt "100_Broke-ass College Student"
msgid "What was with those maniacs chasing that girl around?\\r\n"
"Just when you think the city's dangerous enough as is..."
msgstr "¿Qué pasa con esos locos persiguiendo a esa chica?\\r\n"
"Justo cuando creía que la ciudad ya era lo bastante peligrosa..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Broke-ass College Student
#. y4:msg_speaker_id=0
msgctxt "112_Broke-ass College Student"
msgid "I wonder if she's okay? Maybe I should've called the police."
msgstr "¿Estará bien? Quizás debí haber llamado a la policía."

msgctxt "124_Saejima"
msgid "Hey, that girl ya saw bein' chased...\\r\n"
"she wearin' a black jacket?"
msgstr "¿Oye, esa chica a la que perseguían...\\r\n"
"llevaba una chaqueta negra?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Broke-ass College Student
#. y4:msg_speaker_id=0
msgctxt "136_Broke-ass College Student"
msgid "Huh? Oh, uh... yeah, I think so."
msgstr "¿Eh? Oh... Sí, creo que sí."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "148_Saejima"
msgid "That'd be Makiko. You see where she went?"
msgstr "Ha de ser Makiko. ¿Has visto por donde se fue?"

msgctxt "160_Broke-ass College Student"
msgid "She went running along this road toward Shichifuku Street.\\r\n"
"Should I notify the police?"
msgstr "Se fue corriendo por esta calle hacia la calle Shichifuku.\\r\n"
"¿Debería llamar a la policía?"

msgctxt "172_Saejima"
msgid "Nah, don't bother callin' the cops. I'll take care of this.\\r\n"
"She was headed toward West Park, yeah? Thanks, kid."
msgstr "Nah, ni te molestes en llamar a la policía. Yo me encargo.\\r\n"
"¿Iba hacia el Parque Oeste, verdad? Gracias, chico."

msgctxt "196_Broke-ass College Student"
msgid "If you're still looking for that girl in the black jacket,\\r\n"
"she was running down this road toward Shichifuku Street."
msgstr "Si sigues buscando a la chica de la chaqueta negra,\\r\n"
"Se fue corriendo por esta calle hacia la calle Shichifuku."
