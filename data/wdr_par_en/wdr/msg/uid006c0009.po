#. y4:msg_branch_choice=What if you don't like the guy?
msgctxt "9324_Kiryu"
msgid "What if you don't like the guy? It's not possible to like every man who falls for you, right?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
