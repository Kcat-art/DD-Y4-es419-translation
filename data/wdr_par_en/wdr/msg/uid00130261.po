msgid "Kamurocho Guard Member"
msgstr "Guardia de Kamurocho"

#. y4:line_status=translated
msgctxt "908"
msgid "Tanimura"
msgstr "Tanimura"

#. y4:line_status=translated
msgctxt "912"
msgid "Talk_Angry"
msgstr "Talk_Angry"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "56_Kamurocho Guard Member"
msgid "Argh..."
msgstr "Argh..."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "68_Tanimura"
msgid "Hey! Hang in there! Who did this to you?"
msgstr "¡Ey, aguanta, compañero! ¿Quién te hizo esto?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "80_Kamurocho Guard Member"
msgid "Tanimura-san... I'm glad you're here. Someone just jumped me from behind. I didn't get a good look at him."
msgstr "Tanimura-san... Que bueno que estes aqui. alguien me ataco por la espalda. no lo vi bien quien era."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "92_Tanimura"
msgid "This is bad! Your other volunteers are in danger!"
msgstr "¡Esto es malo! ¡Tú y los otros voluntarios están en peligro!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "104_Kamurocho Guard Member"
msgid "I'll be okay. Please, go help the others."
msgstr "Estaré bien. Por favor, ve con los otros."

