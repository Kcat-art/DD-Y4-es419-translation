#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He might not forgive you, you know.
msgctxt "12024_Kiryu"
msgid "I'd say you've got a fifty-fifty chance."
msgstr "Yo diría que tienes un cincuenta por ciento de probabilidades."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
