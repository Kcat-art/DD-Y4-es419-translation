#. y4:line_status=translated
msgctxt "177\t497954\t18\tCHK"
msgid "Pick up a weapon with <Action:Battle_Drop_Weapon@Combat>, then attack with <Action:Battle_Drop_Weapon@Combat>, <Action:Battle_Heavy_Attack@Combat>, or <Action:Battle_Normal_Attack@Combat>"
msgstr "Coge un arma con <Action:Battle_Drop_Weapon@Combat>, luego ataca con <Action:Battle_Drop_Weapon@Combat>, <Action:Battle_Heavy_Attack@Combat>, o <Action:Battle_Normal_Attack@Combat>"

#. y4:line_status=translated
msgctxt "177\t498142\t19\tCHK"
msgid "Defeat all remaining enemies!"
msgstr "¡Derrota a todos los enemigos restantes!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "177\t498172\t20\tCHK"
msgid "<Action:Battle_Fight_Stance@Combat> while using <Action:Move_Forward@Combat><Action:Move_Back@Combat><Action:Move_Left@Combat><Action:Move_Right@Combat> to strafe while in Fighting Stance"
msgstr "<Action:Battle_Fight_Stance@Combat> mientras usas <Action:Move_Forward@Combat><Action:Move_Back@Combat><Action:Move_Left@Combat><Action:Move_Right@Combat> para caminar en postura de combate"

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "177\t498360\t21\tCHK"
msgid "Guard against attacks from the front with <Action:Battle_Guard@Combat>"
msgstr "Defiéndete contra ataques frontales con <Action:Battle_Guard@Combat>"

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "177\t498431\t22\tCHK"
msgid "<Action:Battle_Dodge@Combat> to Quickstep"
msgstr "<Action:Battle_Dodge@Combat> para usar pasos rápidos"

#. y4:line_status=translated
msgctxt "177\t498473\t23\tCHK"
msgid "Attack to increase the <Color:109,193,240,255>Heat Gauge<Color:Default> at top left of screen"
msgstr "Ataca para aumentar la <Color:109,193,240,255>Barra de Heat<Color:Default> en la esquina superior izquierda"

#. y4:line_status=translated
msgctxt "177\t498567\t24\tCHK"
msgid "Grab enemy or hold weapon + <Action:Battle_Heavy_Attack@Combat> to execute a <Color:7>Heat Action<Color:Default>"
msgstr "Coge un arma o un enemigo<Action:Battle_Heavy_Attack@Combat> para realizar una <Color:7>Acción Heat<Color:Default>"

#. y4:line_status=translated
msgctxt "177\t498680\t25\tCHK"
msgid "Hold down <Action:Battle_Heavy_Attack@Combat> while after an unarmed combo with <Action:Battle_Normal_Attack@Combat> to execute a Charge Attack"
msgstr "Mantén pulsado <Action:Battle_Heavy_Attack@Combat> después de hacer un combo con <Action:Battle_Normal_Attack@Combat> para hacer un ataque cargado"

#. y4:line_status=translated
msgctxt "177\t498824\t26\tCHK"
msgid "<Action:Battle_Guard@Combat> against an enemy attack to parry"
msgstr "<Action:Battle_Guard@Combat> contra un ataque enemigo para hacer un parry"

#. y4:line_status=translated
msgctxt "185\t520201\t1\tCHK"
msgid "You're lookin' fine as ever, babe!"
msgstr "¡Te ves tan bien como siempre, nena!"

#. y4:line_status=translated
msgctxt "185\t520236\t2\tCHK"
msgid "Really? It's all for you, darling."
msgstr "¿En serio? Es todo para ti, cariño."

#. y4:line_status=translated
msgctxt "185\t520271\t3\tCHK"
msgid "Oh, you!"
msgstr "¡Ah, tú!"

#. y4:line_status=translated
msgctxt "185\t520280\t4\tCHK"
msgid "Hold it!"
msgstr "¡Un momento!"

#. y4:line_status=translated
msgctxt "185\t520289\t5\tCHK"
msgid "I turn my back for one second,\nand this happens!?"
msgstr "¡¿Me doy la vuelta un segundo,\ny pasa esto?!"

#. y4:line_status=translated
msgctxt "185\t520339\t6\tCHK"
msgid "You no-good son-of-a-bitch!"
msgstr "¡Tú, maldito hijo de puta!"

#. y4:line_status=translated
msgctxt "185\t520367\t7\tCHK"
msgid "Well, \"darling\"...\nGet ready to die!"
msgstr "Bueno, \"cariño\"\n¡Prepárate para morir!"

#. y4:line_status=translated
msgctxt "186\t520969\t1\tCHK"
msgid "Stop!\nGive those back!"
msgstr "¡Espera!\n¡Devuélvemelas!"

#. y4:line_status=translated
msgctxt "186\t520992\t2\tCHK"
msgid "Thief!"
msgstr "¡Ladrón!"

#. y4:line_status=translated
msgctxt "187\t521593\t1\tCHK"
msgid "Yes. I understand."
msgstr "Sí, entendido."

#. y4:line_status=translated
msgctxt "187\t521612\t2\tCHK"
msgid "Now then..."
msgstr "Y ahora..."

#. y4:line_status=translated
msgctxt "187\t521624\t3\tCHK"
msgid "On second thought...\nI gotta postpone."
msgstr "Pensándolo bien...\nTengo que posponer el encargo."

#. y4:line_status=translated
msgctxt "187\t521663\t4\tCHK"
msgid "Wire it to my usual account."
msgstr "Cárguelo a mi cuenta habitual."

#. y4:line_status=translated
msgctxt "187\t521692\t5\tCHK"
msgid "I'll be done in a flash."
msgstr "Habré acabado en un pestañeo."

#. y4:line_status=translated
msgctxt "188\t522489\t1\tCHK"
msgid "End of the line!"
msgstr "¡No tienes escapatoria!"

#. y4:line_status=translated
msgctxt "188\t522506\t2\tCHK"
msgid "Bullshit it is!\nYou want the kid to get it!?"
msgstr "¡Y una mierda!\n¡¿Acaso quieres que acabe con él?!"

#. y4:line_status=translated
msgctxt "188\t522551\t3\tCHK"
msgid "Answer me."
msgstr "Respóndeme."

#. y4:line_status=translated
msgctxt "188\t522562\t4\tCHK"
msgid "Which wire should I cut?\nThe blue one or the red one!?"
msgstr "La bomba, ¿qué cable debo cortar? ¡¿El azul o el rojo?!"

#. y4:line_status=translated
msgctxt "188\t522617\t5\tCHK"
msgid "Just drop the piece, lady!"
msgstr "¡Suelte la pistola, señorita!"

#. y4:line_status=translated
msgctxt "188\t522644\t6\tCHK"
msgid "You want a dead kid on your hands?"
msgstr "¿Acaso quieres un niño muerto sobre tu conciencia?"

#. y4:line_status=translated
msgctxt "188\t522679\t7\tCHK"
msgid "Take this!"
msgstr "Toma esto!"

#. y4:line_status=translated
msgctxt "188\t522690\t8\tCHK"
msgid "You... pervert!"
msgstr "¡Serás pervertido!"

#. y4:line_status=translated
msgctxt "189\t523865\t1\tCHK"
msgid "Nooo!"
msgstr "¡Nooo!"

#. y4:line_status=translated
msgctxt "189\t523871\t2\tCHK"
msgid "I don't wanna die!"
msgstr "¡No quiero morir!"

#. y4:line_status=translated
msgctxt "189\t523890\t3\tCHK"
msgid "It's your own damn fault."
msgstr "Todo esto es culpa tuya."

#. y4:line_status=translated
msgctxt "189\t523916\t4\tCHK"
msgid "You did this to yourself, pal."
msgstr "Tú te hiciste eso, amigo."

#. y4:line_status=translated
msgctxt "189\t523947\t5\tCHK"
msgid "Help!"
msgstr "¡Ayuda!"

#. y4:line_status=translated
msgctxt "189\t523953\t6\tCHK"
msgid "Please, somebody help!"
msgstr "¡Por favor, que alguien me ayude!"

#. y4:line_status=translated
msgctxt "189\t523976\t7\tCHK"
msgid "One, two...!"
msgstr "¡Uno, dos...!"

#. y4:line_status=translated
msgctxt "189\t523989\t8\tCHK"
msgid "Shit, this thing weighs a fuckin' ton!"
msgstr "Mierda, ¡esto pesa una jodida tonelada!"

#. y4:line_status=translated
msgctxt "189\t524028\t9\tCHK"
msgid "Keep lifting!"
msgstr "¡Sigue levantándolo!"

#. y4:line_status=translated
msgctxt "189\t524042\t10\tCHK"
msgid "No, please!"
msgstr "¡No, por favor!"

#. y4:line_status=translated
msgctxt "189\t524054\t11\tCHK"
msgid "C'mon, lift your side!"
msgstr "¡Vamos, ponle ganas!"

#. y4:line_status=translated
msgctxt "189\t524077\t12\tCHK"
msgid "You hear me?\nYou're not even lifting!"
msgstr "¿Me estás oyendo?\n¡Parece que ni lo estás intentando!"

#. y4:line_status=translated
msgctxt "189\t524115\t13\tCHK"
msgid "I'm trying!\nI'm trying, man!"
msgstr "¡Que sí!\n¡Que lo estoy intentando, tío!"

#. y4:line_status=translated
msgctxt "189\t524144\t14\tCHK"
msgid "Wait, hold it!\nQuit moving!"
msgstr "Espera, ¡aguanta!\n¡Deja de moverte!"

#. y4:line_status=translated
msgctxt "189\t524172\t15\tCHK"
msgid "Stay still, you idiot!\nStay still!"
msgstr "¡Quieto, idiota!\n¡Quédate quieto!"

#. y4:line_status=translated
msgctxt "189\t524207\t16\tCHK"
msgid "I'm alive!"
msgstr "¡Estoy vivo!"

#. y4:line_status=translated
msgctxt "189\t524218\t17\tCHK"
msgid "I'm gonna die!"
msgstr "¡Voy a morir!"

#. y4:line_status=translated
msgctxt "189\t524233\t18\tCHK"
msgid "Noooooo!"
msgstr "¡Nooooo!"

#. y4:line_status=translated
msgctxt "190\t525337\t1\tCHK"
msgid "Ugh, no luck..."
msgstr "Uf, no hubo suerte..."

#. y4:line_status=translated
msgctxt "190\t525353\t2\tCHK"
msgid "Oh, I got one!"
msgstr "¡Oh, tengo uno!"

#. y4:line_status=translated
msgctxt "190\t525368\t3\tCHK"
msgid "Wait, come back!"
msgstr "¡Espera, vuelve!"

#. y4:line_status=translated
msgctxt "190\t525385\t4\tCHK"
msgid "You're mine!"
msgstr "¡Prepárate!"

#. y4:line_status=translated
msgctxt "190\t525398\t5\tCHK"
msgid "Five hundred!?"
msgstr "¿¡Quinientos!?"

#. y4:line_status=translated
msgctxt "190\t525413\t6\tCHK"
msgid "Thank you very much, sir!"
msgstr "¡Muchas gracias, señor!"

#. y4:line_status=translated
msgctxt "190\t525439\t7\tCHK"
msgid "Please take this."
msgstr "Por favor, tome esto."

#. y4:line_status=translated
msgctxt "190\t525457\t8\tCHK"
msgid "You can..."
msgstr "Puedes..."

#. y4:line_status=translated
msgctxt "190\t525468\t9\tCHK"
msgid "Keep it."
msgstr "Guárdalo."

#. y4:line_status=translated
msgctxt "191\t526473\t1\tCHK"
msgid "C'mon! It's all good, babe."
msgstr "¡Venga! Todo irá bien, nena."

#. y4:line_status=translated
msgctxt "191\t526501\t2\tCHK"
msgid "Just leave me alone!"
msgstr "¡Déjame en paz!"

#. y4:line_status=translated
msgctxt "191\t526522\t3\tCHK"
msgid "Let me go!"
msgstr "¡Déjame ir!"

#. y4:line_status=translated
msgctxt "191\t526533\t4\tCHK"
msgid "Unhand her, foul beast!"
msgstr "¡Aléjate de ella, monstruo repugnante!"

#. y4:line_status=translated
msgctxt "191\t526557\t5\tCHK"
msgid "Huh?"
msgstr "Uh, ¿y eso?"

#. y4:line_status=translated
msgctxt "191\t526562\t6\tCHK"
msgid "Can't you tell...\nshe's not interested in you?"
msgstr "¿Es que no ves... \nque no le interesas?"

#. y4:line_status=translated
msgctxt "191\t526609\t7\tCHK"
msgid "Just get the hell outta here!"
msgstr "¡Vete al carajo de una maldita vez!"

#. y4:line_status=translated
msgctxt "191\t526639\t8\tCHK"
msgid "What was that?"
msgstr "¡¿Qué dijiste?!"

#. y4:line_status=translated
msgctxt "191\t526654\t9\tCHK"
msgid "You need your ears cleaned or somethin'?"
msgstr "¿Qué pasa, tienes cera en los oídos o qué?"

#. y4:line_status=translated
msgctxt "191\t526695\t10\tCHK"
msgid "In that case... I'll gladly do it for ya!"
msgstr "En ese caso... ¡Lo haré con gusto!"

#. y4:line_status=translated
msgctxt "191\t526737\t11\tCHK"
msgid "Bring it!"
msgstr "¡Vamos!"

#. y4:line_status=translated
msgctxt "191\t526747\t12\tCHK"
msgid "It won't take long, pinky swear."
msgstr "No tardaremos mucho, te lo prometo."

#. y4:line_status=translated
msgctxt "192\t527785\t1\tCHK"
msgid "All right, I got it!"
msgstr "Muy bien, ¡lo tengo!"

#. y4:line_status=translated
msgctxt "192\t527806\t2\tCHK"
msgid "This is tough..."
msgstr "Esto es difícil..."

#. y4:line_status=translated
msgctxt "192\t527823\t3\tCHK"
msgid "You're mine this time!"
msgstr "¡Esta vez eres mío!"

#. y4:line_status=translated
msgctxt "192\t527846\t4\tCHK"
msgid "You're doing it! You're doing it!"
msgstr "¡Lo estás haciendo! ¡Lo estás haciendo!"

#. y4:line_status=translated
msgctxt "192\t527880\t5\tCHK"
msgid "What the? It's broken or something!"
msgstr "¿Qué? ¡Está roto o algo así!"

#. y4:line_status=translated
msgctxt "192\t527916\t6\tCHK"
msgid "The hell's it doing!?"
msgstr "¿¡Qué demonios está haciendo!?"

#. y4:line_status=translated
msgctxt "192\t527938\t7\tCHK"
msgid "You did it!"
msgstr "¡Lo hiciste!"

#. y4:line_status=translated
msgctxt "192\t527950\t8\tCHK"
msgid "Guess I did! Look at that!"
msgstr "¡Supongo que lo hice! ¡Mira eso!"

#. y4:line_status=translated
msgctxt "192\t527977\t9\tCHK"
msgid "You little!"
msgstr "Hijo de!"

#. y4:line_status=translated
msgctxt "193\t528729\t1\tCHK"
msgid "The hell?"
msgstr "¿Dónde?"

#. y4:line_status=translated
msgctxt "193\t528739\t2\tCHK"
msgid "Ah, excuse me!"
msgstr "¡Ay, discúlpame!"

#. y4:line_status=translated
msgctxt "193\t528754\t3\tCHK"
msgid "Watch where you're going, brat!\nYou know who I am!?"
msgstr "¡Mira a dónde vas, mocoso!\n¡¿No sabes quién soy!?"

#. y4:line_status=translated
msgctxt "193\t528806\t4\tCHK"
msgid "Heh."
msgstr "Je."

#. y4:line_status=translated
msgctxt "193\t528811\t5\tCHK"
msgid "Ow!"
msgstr "¡Ouch!"

#. y4:line_status=translated
msgctxt "193\t528815\t6\tCHK"
msgid "You son of a...!"
msgstr "¡Hijo de...!"

#. y4:line_status=translated
msgctxt "194\t529449\t1\tCHK"
msgid "\"Suicide Suspected In Deputy Commissioner's Death\nPart Of A Corruption Cover-Up?\""
msgstr "\"Se sospecha de suicidio en la muerte del subcomisionado\n¿Parte de un encubrimiento de corrupción?\""

