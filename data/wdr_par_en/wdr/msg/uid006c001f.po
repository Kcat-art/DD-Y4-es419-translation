#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=They just like talking to each other like that.
msgctxt "14280_Akiyama"
msgid "......"
msgstr "......"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=0
#. y4:msg_location=T29.P0
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "14292_Noa"
msgid "I had the most delicious chestnut cream cake today!"
msgstr "¡Hoy comí el pastel de crema de castañas más delicioso!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=1
#. y4:msg_location=T29.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "14304_Akiyama"
msgid "Oh really? What's next, strawberry shortcake or chocolate cake?"
msgstr "¿En serio? ¿Qué será lo siguiente, pastel de fresas o de chocolate?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=2
#. y4:msg_location=T29.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "14316_Noa"
msgid "Hehe! Am I that predictable?"
msgstr "¡Jeje! ¿Soy tan predecible?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=3
#. y4:msg_location=T29.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "14328_Akiyama"
msgid "I'm afraid so."
msgstr "Me temo que sí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=4
#. y4:msg_location=T29.P4
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "14340_Noa"
msgid "Oh well, I can't fight it. I've had other cakes, but the flavor's always too complex."
msgstr "Oh, bueno, no puedo luchar contra eso. He comido otros pasteles, pero el sabor siempre es demasiado complejo."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
