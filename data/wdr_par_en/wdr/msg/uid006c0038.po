#. y4:line_status=todo
msgctxt "6516_Kiryu"
msgid "Um, I don't think so..."
msgstr ""

#. y4:line_status=todo
msgctxt "6528_望月京子：源氏名"
msgid "You know, I keep recommending my diet to people, but no one takes me up on it."
