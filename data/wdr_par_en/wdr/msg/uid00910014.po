#. y4:msg_branch_choice=Check Investigation
msgctxt "4892_Nair"
msgid "[An assassin trained by GG... I might know the person they're talking about.]"
msgstr "[Un asesino entrenado por GG..., puede que conozca a la persona\nde la que hablan.]"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
