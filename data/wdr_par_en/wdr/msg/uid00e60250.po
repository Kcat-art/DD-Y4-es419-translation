msgctxt "1048"
msgid "Hehehe. ♪ What should I have you buy? <Color:7>♥<Color:Default>"
msgstr "Je, je, je. ♪ ¿Qué debería hacerte comprar? <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=72
#. y4:msg_location=T0.P72
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Go Out to Eat
msgctxt "1360"
msgid "But if that's where you wanna go, Akiyama-san, I guess I'll go."
msgstr "Pero si ahí es donde quieres ir, Akiyama-san, supongo que iré."

msgctxt "1552"
msgid "Hehe... You certainly know how to heat things up! I hope you like my singing. ♪"
msgstr "Jeje... ¡Desde luego sabes cómo animar el ambiente! Espero que te guste cómo canto. ♪"

msgctxt "1672"
msgid "I only started playing recently. Hehehe... This should be a good matchup. <Color:7>♥<Color:Default>"
msgstr "Empecé a jugar hace poco. Jejeje... Esta va a ser una buena partida. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
