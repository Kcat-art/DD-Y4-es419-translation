#. y4:line_status=translated
msgctxt "84_Homeless Newcomer"
msgid "What in tarnation... I dunno where I am anymore.\\r\nHow do I even get out of here?"
msgstr "¿Qué diablos... ya ni sé dónde estoy.\\r \n¿Cómo salgo de aquí?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Homeless Veteran
#. y4:msg_speaker_id=2
msgctxt "96_Homeless Veteran"
msgid "You new around here, chief? Where is it you want to go?"
msgstr "¿Eres nuevo por aquí, amigo? ¿A dónde quieres ir?"

#. y4:line_status=translated
msgctxt "108_Homeless Newcomer"
msgid "Oh, uh... I was just trying to get to Tenkaichi Street.\\r\nCan you point me in the right direction?"
msgstr "Oh, eh... solo quería llegar a la calle Tenkaichi.\\r\n ¿Me puedes dar indicaciones?"

#. y4:line_status=translated
msgctxt "120_Homeless Veteran"
msgid "I can point you to a map in the underground parking lot.\\r\nMakes navigating down here a cinch."
msgstr "Te puedo guiar a un mapa en el aparcamiento subterráneo.\\r\n Así se hace mucho más fácil orientarse por aquí."

#. y4:line_status=translated
msgctxt "132_Homeless Veteran"
msgid "It's next to the exit, so if you wind up lost again,\\r\ndouble back to the map and reorient yourself."
msgstr "Está junto a la salida, así que si te pierdes otra vez,\\r\n vuelve al mapa y vuelve a orientarte."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Homeless Newcomer
#. y4:msg_speaker_id=0
msgctxt "156_Homeless Newcomer"
msgid "A map is exactly what I needed. Thank you kindly."
msgstr "Un mapa es justo lo que necesitaba. Muchas gracias."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Homeless Veteran
#. y4:msg_speaker_id=2
msgctxt "168_Homeless Veteran"
msgid "You be careful now, chief. The underground's a wide and wild place."
msgstr "Cuídate, amigo. El subterráneo es un lugar vasto y salvaje."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=6
msgctxt "180_Saejima"
msgid "(Glad I carry a map on me, so I don't get lost like that.)"
msgstr "(Menos mal que llevo un mapa, así no me pasa lo mismo.)"
