#. y4:msg_decision_group=6
#. y4:msg_decision_choices=1. Usually just canned beer. -> T6.P6 | 2. I like shochu. You know, sweet potato liquor? -> T6.P13 | 3. I drink a lot of whiskey. -> T6.P22
msgctxt "6756_Akiyama"
msgid "Well..."
msgstr "Bueno..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=6
#. y4:msg_location=T6.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Usually just canned beer.
msgctxt "6768_Akiyama"
msgid "Usually just canned beer. I'll buy some at a convenience store and have a little party by the roadside."
msgstr "Por lo general, solo cerveza en lata. Compraré unas cuantas en una tienda de conveniencia y haré una pequeña fiesta al borde de la carretera."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=7
#. y4:msg_location=T6.P7
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Usually just canned beer.
msgctxt "6780_Erena"
msgid "Wow, that's pretty cool. I've always wanted to try something like that."
msgstr "Wow, eso es genial. Siempre he querido intentar algo así."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=8
#. y4:msg_location=T6.P8
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Usually just canned beer.
msgctxt "6792_Erena"
msgid "I've never been able to drink in public without worrying what people might think."
msgstr "Nunca he podido beber en público sin preocuparme por lo que la gente pueda pensar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=9
#. y4:msg_location=T6.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Usually just canned beer.
msgctxt "6804_Akiyama"
msgid "Well, why don't you join me next time?"
msgstr "Bueno, ¿por qué no te nos unes la próxima vez?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=10
#. y4:msg_location=T6.P10
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Usually just canned beer.
msgctxt "6816_Erena"
msgid "Ooh, yes! Definitely gimme a call!"
msgstr "¡Oh, sí! ¡Definitivamente! ¡Tú solo llámame!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=11
#. y4:msg_location=T6.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Usually just canned beer.
msgctxt "6828_Akiyama"
msgid "It's a date then."
msgstr "Una cita será entonces."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=12
#. y4:msg_location=T6.P12
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Usually just canned beer.
msgctxt "6840_Erena"
msgid "Promise!"
msgstr "¡Es una promesa!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
