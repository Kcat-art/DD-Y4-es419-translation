#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "112_Saejima"
msgid "For a buncha men in suits, this don't look too gentlemanly."
msgstr "Para tratarse de un grupo de trajeados, esto no parece muy caballeroso."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Femme Fatale
#. y4:msg_speaker_id=1
msgctxt "124_Femme Fatale"
msgid "Please, help me!"
msgstr "¡Por favor, ayudame!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=6
#. y4:msg_location=T2.P6
#. y4:msg_speaker=Suited Goon
#. y4:msg_speaker_id=3
msgctxt "184_Suited Goon"
msgid "Not so fast."
msgstr "No tan rapido."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=8
#. y4:msg_location=T2.P8
#. y4:msg_speaker=Suited Goon
#. y4:msg_speaker_id=3
msgctxt "208_Suited Goon"
msgid "You? I thought I told you to get lost!"
msgstr "¿Y tú? ¡Ya te dicho que te perdieras!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=9
#. y4:msg_location=T2.P9
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "220_Saejima"
msgid "It's clear as a kappa you're up to some shady shit..."
msgstr "Está claro como el agua que aquí hay algo turbio..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=10
#. y4:msg_location=T2.P10
#. y4:msg_speaker=Suited Goon
#. y4:msg_speaker_id=3
msgctxt "232_Suited Goon"
msgid "Which isn't your problem, so beat it already!"
msgstr "¡Eso no es problema tuyo, así que lárgate de una vez!"

msgctxt "244_Saejima"
msgid "When someone asks me for help, it becomes my problem.\\r\n"
"'Specially when they're surrounded by a buncha suits."
msgstr "Cuando alguien me pide ayuda, eso ya es mi problema.\\r\n"
"Especialmente cuando esta rodeada de un montón de trajeados."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=12
#. y4:msg_location=T2.P12
#. y4:msg_speaker=Suited Goon
#. y4:msg_speaker_id=3
msgctxt "256_Suited Goon"
msgid "Great, we've got us a wannabe hero..."
msgstr "Vaya, conque tenemos un héroe aquí..."

msgctxt "268_Suited Henchman"
msgid "Look, this is one damsel in distress you don't wanna save.\\r\n"
"Meddle in our business and there will be real consequences."
msgstr "Mira, no querrás salvar a esta \"damisela en apuros\".\\r\n"
"Metete en tus propios asuntos y no habrá problemas."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=14
#. y4:msg_location=T2.P14
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "280_Saejima"
msgid "That a threat?"
msgstr "¿Es eso una amenaza?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=15
#. y4:msg_location=T2.P15
#. y4:msg_speaker=Suited Henchman
#. y4:msg_speaker_id=6
msgctxt "292_Suited Henchman"
msgid "No, it's a promise. Playing hero for some woman you've never even met will get you killed."
msgstr "No, es una promesa. Jugar a ser el héroe con mujeres que no conoces te va a costar la vida."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=16
#. y4:msg_location=T2.P16
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "304_Saejima"
msgid "......"
msgstr "......"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=17
#. y4:msg_location=T2.P17
#. y4:msg_speaker=Suited Goon
#. y4:msg_speaker_id=3
msgctxt "316_Suited Goon"
msgid "Hey, dumbass! Hello in there!"
msgstr "¡Tierra a imbecil! ¿¡Nos escuchas!?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=18
#. y4:msg_location=T2.P18
#. y4:msg_speaker=Suited Henchman
#. y4:msg_speaker_id=6
msgctxt "328_Suited Henchman"
msgid "I guess you're ignoring my warning."
msgstr "Supongo que no te importa tu vida."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=19
#. y4:msg_location=T2.P19
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "340_Saejima"
msgid "Guess I am."
msgstr "Supongo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=20
#. y4:msg_location=T2.P20
#. y4:msg_speaker=Suited Henchman
#. y4:msg_speaker_id=6
msgctxt "352_Suited Henchman"
msgid "Then you've painted us into a corner. Try not to get your blood on my suit!"
msgstr "Entonces complicaste las cosas. ¡Procura no manchar mi traje con tu sangre!"
