#. y4:msg_speaker_id=0
msgctxt "5928_望月京子：源氏名"
msgid "Well, people do tell me I'm a little too forward. I've never been easily intimidated."
msgstr "Bueno ya que lo dices, la gente me comenta que voy muy deprisa o muy atrevida. Nunca me he dejado intimidar."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
