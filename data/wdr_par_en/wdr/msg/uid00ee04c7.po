#. y4:msg_location=T0.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "164_Akiyama"
msgid "Well, let's get started."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "176_キャバ育名前"
msgid "Yes, let's."
msgstr "Sí, vamos."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "188_Akiyama"
msgid "First, let's get you changed into an outfit that brings out the best of your natural beauty. Don't worry, I guarantee you'll look great."
msgstr "Primero, vamos a cambiarte a un atuendo que resalte lo mejor de tu belleza natural. No te preocupes, te garantizo que te verás genial."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "224_Akiyama"
msgid "Not bad."
msgstr "Nada mal."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "236_キャバ育名前"
msgid "Really? This is a little embarrassing."
msgstr "¿En serio? Esto es un poco vergonzoso."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "248_Akiyama"
msgid "It's time to go out on the club floor. Don't worry. I'm sure you'll get customers."
msgstr "Es hora de que salgas. No te preocupes. Estoy seguro de que conseguirás clientes."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "260_キャバ育名前"
msgid "Okay..."
msgstr "Bueno..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "296_Akiyama"
msgid "%s, huh? That works. You'll use that name at the club from now on."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "308_キャバ育名前"
msgid "Okay, thank you."
msgstr "De acuerdo, gracias."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "320_Akiyama"
msgid "First, let's get you changed into an outfit that brings out the best of your natural beauty. Don't worry, I guarantee you'll look great."
msgstr "Primero, vamos a cambiarte a un atuendo que resalte lo mejor de tu belleza natural. No te preocupes, te garantizo que te verás genial."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=0
#. y4:msg_location=T3.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "344_Akiyama"
msgid "Welcome to Elise. We're going to make you into this club's number one hostess."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=1
#. y4:msg_location=T3.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "356_Akiyama"
msgid "You'll need to come up with a name to use in the club. What would you like your name to be?"
msgstr ""

msgctxt "428_Akiyama"
msgid "I'm not quite sure how to pronounce that... Why don't we\\r\n"
"come up with something a bit more natural?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=5
#. y4:msg_phrase=1
#. y4:msg_location=T5.P1
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "488_キャバ育名前"
msgid "Sorry, I should've called if I was going to skip work..."
msgstr ""

msgctxt "500_Akiyama"
msgid "It's okay. I haven't been the best manager, either.\\r\n"
"I'll be sure to do a better job from now on."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "512_キャバ育名前"
msgid "Okay..."
msgstr "Bueno..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=1
#. y4:msg_location=T6.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "548_Akiyama"
msgid "You're working hard. Have you met any promising men yet?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=2
#. y4:msg_location=T6.P2
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "560_キャバ育名前"
msgid "I have a lot of rich customers, but as men, they leave something to be desired, if you know what I mean."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=3
#. y4:msg_location=T6.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "572_Akiyama"
msgid "It's a hard road finding the perfect man, I've heard."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=4
#. y4:msg_location=T6.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "584_Akiyama"
msgid "How's your day job going? I imagine they keep you pretty busy."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=5
#. y4:msg_location=T6.P5
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "596_キャバ育名前"
msgid "Actually, they've put me completely in charge of a project. So I'm busy, but I love it!"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=6
#. y4:msg_location=T6.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "608_Akiyama"
msgid "Sounds like you're a natural leader. You could probably quit the company and work for yourself."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=7
#. y4:msg_location=T6.P7
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "620_キャバ育名前"
msgid "Work for myself? I'd never thought of that..."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=8
#. y4:msg_location=T6.P8
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "632_キャバ育名前"
msgid "Hmm..."
msgstr "Mmm..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=9
#. y4:msg_location=T6.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "644_Akiyama"
msgid "(I think she'll do just fine.)"
msgstr ""
