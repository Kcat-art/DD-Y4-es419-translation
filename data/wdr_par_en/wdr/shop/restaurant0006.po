msgctxt "620"
msgid "Quit"
msgstr "Salir"

#. y4:line_status=reviewed
#. y4:translated_by=Kcat0
#. y4:reviewed_by=Kcat0
msgctxt "625"
msgid "Cancel the order."
msgstr "Cancelar pedido."

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
msgctxt "643"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=reviewed
#. y4:translated_by=Kcat0
#. y4:reviewed_by=Kcat0
msgctxt "649"
msgid "Order the currently selected item."
msgstr "Pagar el objeto seleccionado."

#. y4:line_status=translated
msgctxt "684"
msgid "(I haven't picked anything.)"
msgstr "(No he escogido nada)"

#. y4:line_status=translated
msgctxt "713"
msgid "(I'm short on cash.)"
msgstr "(Me hace falta dinero)"

#. y4:line_status=translated
msgctxt "734"
msgid "Thank you. Your total comes to %s."
msgstr "Gracias. El precio total es de %s."

#. y4:line_status=translated
msgctxt "769"
msgid "(I can't eat anymore...)"
msgstr "(No puedo comer más...)"

#. y4:line_status=translated
msgctxt "817"
msgid "A blend of Mandheling and Brazilian beans with a\nColombian base."
msgstr "Una mezcla de granos mandheling y brasileños con\nuna base colombiana."

#. y4:line_status=translated
msgctxt "882"
msgid "This is the ultimate cup of coffee, made with top-grade\ncoffee beans."
msgstr "Esta es la taza de café definitiva, elaborada con\ngranos de café de primera calidad."

#. y4:line_status=translated
msgctxt "952"
msgid "A lot of coffee drinkers love our mocha for its rich,\nbitter flavor."
msgstr "A muchos amantes del café les encanta el moca por su\nsabor amargo y rico."

#. y4:line_status=translated
msgctxt "1021"
msgid "Bergamot-scented and brewed with Sri Lankan tea\nleaves from a farm under exclusive contract."
msgstr "Perfumada con bergamota y elaborada con hojas\nde té de Sri Lanka procedentes de una\nplantación exclusiva."

#. y4:line_status=translated
msgctxt "1114"
msgid "Assam tea leaves from a tea farm under our exclusive\ncontract have been carefully brewed with creamy,\npasteurized milk from Hokkaido."
msgstr "Hojas de té Assam de una plantación exclusiva\ncontratada, cuidadosamente mezcladas con leche\ncremosa pasteurizada de Hokkaido."

#. y4:line_status=translated
msgctxt "1248"
msgid "Made with healthy, organic tomatoes."
msgstr "Hecho con tomates saludables y orgánicos."

#. y4:line_status=translated
msgctxt "1285"
msgid "Richly scented tea from the hills of Nuwara Eliya in\nSri Lanka combined with organic lemon."
msgstr "Té con un aroma intenso, proveniente de las colinas\nde Nuwara Eliya en Sri Lanka. Combinado con limón\norgánico."

#. y4:line_status=translated
msgctxt "1377"
msgid "A creamy parfait loaded with fresh strawberries."
msgstr "Un parfait cremoso cargado de fresas frescas."

#. y4:line_status=translated
msgctxt "1426"
msgid "A sizable parfait loaded with rich chocolate."
msgstr "Un parfait grande cargado de chocolate rico y delicioso."

#. y4:line_status=translated
msgctxt "1472"
msgid "A popular float made with Uji green tea and creamy\nvanilla ice cream."
msgstr "Un popular helado flotante hecho con matcha Uji y\nun cremoso helado de vainilla."

#. y4:line_status=translated
msgctxt "1542"
msgid "Our special shortcake and a drink."
msgstr "Nuestro especial de torta y una bebida."

#. y4:line_status=translated
msgctxt "1577"
msgid "A fried egg, bacon, toast, and your choice of either\ncoffee or tea."
msgstr "Un huevo frito, tocino, una tostada, más un café o\nté de tu elección."

#. y4:line_status=translated
msgctxt "1645"
msgid "This set features a bacon, egg, and lettuce sandwich on\nwhite bread."
msgstr "Este set incluye un sándwich de huevo, tocino y lechuga\nen pan blanco."

#. y4:line_status=translated
msgctxt "1714"
msgid "Tuna and cream pasta with a drink."
msgstr "Pasta de atún y crema con una bebida."

#. y4:line_status=translated
msgctxt "1749"
msgid "This beef curry is our special house recipe."
msgstr "Este curry de carne de res es nuestra receta especial de la casa."

