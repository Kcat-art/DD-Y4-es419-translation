#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "664_Tanimura"
msgid "Yeah, you two have fun."
msgstr "Sí, que se diviertan."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=48
#. y4:msg_location=T0.P48
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "676_Yusuke"
msgid "Er, right! Thanks, guys. I owe you one."
msgstr "¡Er, claro! Gracias, chicos. Les debo una."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=55
#. y4:msg_location=T0.P55
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=9
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "760_Haruko"
msgid "Well, I'd say that went over pretty damn good!"
msgstr "Bueno, ¡diría que eso salió bastante bien!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=56
#. y4:msg_location=T0.P56
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "772_Tanimura"
msgid "That it did."
msgstr "Así es."

#. y4:line_status=translated
msgctxt "784_Naoya"
msgid "Honestly, I didn't think it'd go this well. It was really thanks to you, Ryo－ I mean, Tanimura-san."
msgstr "Honestamente, no pensé que iría tan bien. Fue gracias a ti, Ryo－ quiero decir, Tanimura-san."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=58
#. y4:msg_location=T0.P58
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "796_Tanimura"
msgid "I guess we'll see. This is just the beginning for those two."
msgstr "Supongo que lo veremos. Esto es solo es el comienzo para esos dos."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=59
#. y4:msg_location=T0.P59
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=9
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "808_Naoya"
msgid "Heheh, you got that right. It's all up to our boy Yusuke now."
msgstr "Je, je, tienes razón. Todo depende ahora de nuestro chico Yusuke."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=60
#. y4:msg_location=T0.P60
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=9
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "820_Naoya"
msgid "It's not much, but this is to thank you for everything you did."
msgstr "No es mucho, pero esto es para agradecerte por todo lo que hiciste."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=62
#. y4:msg_location=T0.P62
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "844_Tanimura"
msgid "Are you sure? I don't know if I feel right... accepting money for this."
msgstr "¿Estás seguro? No sé si me siento bien... aceptando dinero por esto."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=63
#. y4:msg_location=T0.P63
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=9
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "856_Naoya"
msgid "Ah, don't take it like that. Besides, I'll make sure I get it all back from Yusuke later. I know he appreciates your help."
msgstr "Ah, no te lo tomes así. Además, me aseguraré de recuperarlo todo de Yusuke después. Sé que aprecia tu ayuda."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=64
#. y4:msg_location=T0.P64
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "868_Tanimura"
msgid "You really got his back, don't you?"
msgstr "Realmente lo apoyas, ¿no?"

#. y4:line_status=translated
msgctxt "880_Naoya"
msgid "Well, like I said, he's like a bad habit I just can't break.\\r\nSo what's a friend supposed do? Hahaha."
msgstr "Bueno, como dije, es como un mal hábito del que no me puedo deshacer.\\r\nEntonces, ¿qué se supone que hacen los amigos? Ja, ja, ja."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
