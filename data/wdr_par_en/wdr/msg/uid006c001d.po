#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=21
#. y4:msg_location=T3.P21
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Nothing wrong with showing a little skin.
msgctxt "6180_Rio"
msgid "I guess it's natural to want to please someone who says something sweet like that, right?"
msgstr "Supongo que es natural querer complacer a alguien que dice algo dulce como eso, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=32
#. y4:msg_location=T3.P32
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Aren't you embarrassed?
msgctxt "6192_Akiyama"
msgid "Yeah, I'm sure you'd be happy to hear something like that."
msgstr "Sí, estoy seguro que eso te alegraría el día."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=47
#. y4:msg_location=T3.P47
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should dress up as a sexy bunny girl next.
msgctxt "6204_Akiyama"
msgid "Well, see if he'll let you be a bunny next time."
msgstr "Bueno, a ver si la próxima vez te deja ser una conejita."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=48
#. y4:msg_location=T3.P48
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should dress up as a sexy bunny girl next.
msgctxt "6216_Rio"
msgid "Hehe, well, I'll bring it up!"
msgstr "Jeje, bueno, ¡lo mencionaré!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=0
#. y4:msg_location=T4.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "6228_Rio"
msgid "Akiyama-san, do you play guitar?"
msgstr "Akiyama-san, ¿usted toca la guitarra?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=1
#. y4:msg_location=T4.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "6240_Akiyama"
msgid "Guitar? Where'd that come from?"
msgstr "¿La guitarra? ¿A que viene eso?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=2
#. y4:msg_location=T4.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "6252_Akiyama"
msgid "Well, I've messed around with one before, but that's about it. Why do you ask?"
msgstr "Bueno, he probado a tocar alguna que otra vez, pero sin más. ¿Por qué lo preguntas?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=3
#. y4:msg_location=T4.P3
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "6264_Rio"
msgid "I've just always thought it would be cool to be able to play the guitar."
msgstr "Siempre he pensado que sería genial poder tocar la guitarra."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=4
#. y4:msg_location=T4.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "6276_Rio"
msgid "I have a friend who plays. She said that once you have the chords down, the rest is easy."
msgstr "Tengo una amiga que toca. Me dijo que una vez que aprendes los acordes, el resto es fácil."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=5
#. y4:msg_location=T4.P5
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "6288_Rio"
msgid "So the other day I decided to go ahead and buy a guitar. It wasn't cheap, either."
msgstr "Total que el otro día me animé por fin a comprar una guitarra. Y no fue barata, precisamente."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=6
#. y4:msg_location=T4.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "6300_Akiyama"
msgid "Wow. You don't mess around, do you? Have you tried playing it?"
msgstr "Vaya. No te andas con tonterías, ¿eh? ¿Has intentado tocarla?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=7
#. y4:msg_location=T4.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=4
#. y4:msg_decision_choices=1. I hear a lot of people quit after a few weeks. -> T4.P8 | 2. Isn't it hard to play with nails like that? -> T4.P17 | 3. Why did you pick the guitar? -> T4.P30
msgctxt "6312_Rio"
msgid "I have! I don't have the time to practice as much as I should, but I'm going to do my best to play well!"
msgstr "¡Ya lo he hecho! No tengo tiempo para practicar tanto como debería, ¡pero voy a hacer todo lo posible para tocar bien!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=133
#. y4:msg_phrase=0
#. y4:msg_location=T133.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T4.P8
#. y4:msg_branch_segment=T4.P8..P16
#. y4:msg_branch_target_text=I hear a lot of people quit after a few weeks.
#. y4:msg_branch_raw=01 11 00 08 00 00 00 2e 00 00 00 00 00 00 00 00
msgctxt "6324_Akiyama"
msgid "I hear a lot of people quit after a few weeks."
msgstr "He oído que mucha gente lo deja al cabo de unas semanas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=9
#. y4:msg_location=T4.P9
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "6336_Rio"
msgid "I know! That's why I purposely bought an expensive one."
msgstr "¡Lo sé! Es por eso que compré una cara a propósito."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=10
#. y4:msg_location=T4.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "6348_Akiyama"
msgid "Huh? Why?"
msgstr "¿Eh? ¿Por qué?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=11
#. y4:msg_location=T4.P11
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "6360_Rio"
msgid "I tend to eventually give up with things like this."
msgstr "Tiendo a rendirme con este tipo de cosas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=12
#. y4:msg_location=T4.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "6372_Rio"
msgid "But I figured if I spent a lot of money, I'd keep it up. Quitting would be a huge waste."
msgstr "Pero pensé que si gastaba mucho dinero, me mantendría constante. Rendirme sería malgastarlo todo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=13
#. y4:msg_location=T4.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "6384_Akiyama"
msgid "Hmm. I see..."
msgstr "Mmm. Ya veo..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=14
#. y4:msg_location=T4.P14
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "6396_Rio"
msgid "Right now my goal is to keep practicing for a month. It helps to set little goals like that."
msgstr "Ahora mismo mi objetivo es seguir practicando durante un mes. Ayuda fijarse pequeñas metas como esa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=15
#. y4:msg_location=T4.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "6408_Akiyama"
msgid "Yeah? Well, let me know when you play."
msgstr "¿Sí? Bueno, avísame cuando toques."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=16
#. y4:msg_location=T4.P16
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "6420_Rio"
msgid "I will!"
msgstr "¡Lo haré!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=134
#. y4:msg_phrase=0
#. y4:msg_location=T134.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T4.P17
#. y4:msg_branch_segment=T4.P17..P29
#. y4:msg_branch_target_text=Isn't it hard to play with nails like that?
#. y4:msg_branch_raw=01 11 00 11 00 00 00 2b 00 00 00 00 00 00 00 00
msgctxt "6432_Akiyama"
msgid "Isn't it hard to play with nails like that?"
msgstr "¿No es difícil tocar con uñas como esas?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=18
#. y4:msg_location=T4.P18
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Isn't it hard to play with nails like that?
msgctxt "6444_Rio"
msgid "Whoa! I'm surprised you thought of that!"
msgstr "¡Wow! ¡Me sorprende que hayas pensado en eso!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=19
#. y4:msg_location=T4.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Isn't it hard to play with nails like that?
msgctxt "6456_Akiyama"
msgid "Really? It seems pretty obvious to me."
msgstr "¿De verdad? A mí me parece bastante obvio."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=20
#. y4:msg_location=T4.P20
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Isn't it hard to play with nails like that?
msgctxt "6468_Rio"
msgid "You're a step ahead of most men, then. Guys don't think about a girl's nails."
msgstr "En eso superas a la mayoría de los hombres. La mayoría no piensan en las uñas de una mujer."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=21
#. y4:msg_location=T4.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Isn't it hard to play with nails like that?
msgctxt "6480_Akiyama"
msgid "Oh, I see... Well, anyway, do they get in the way?"
msgstr "Oh, entiendo... En fin, ¿te molestan?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=22
#. y4:msg_location=T4.P22
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Isn't it hard to play with nails like that?
msgctxt "6492_Rio"
msgid "Well, these are removable nails. I put them on with a kind of double-sided tape."
msgstr "Bueno, estos son uñas removibles. Las puse con una especie de cinta adhesiva de doble cara."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=23
#. y4:msg_location=T4.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Isn't it hard to play with nails like that?
msgctxt "6504_Akiyama"
msgid "Huh. What'll they think of next?"
msgstr "Vaya... ¿Qué se les ocurrirá después?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=24
#. y4:msg_location=T4.P24
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Isn't it hard to play with nails like that?
msgctxt "6516_Rio"
msgid "Problem is, they come off a little too easily, so they're not very practical."
msgstr "El problema es que se despegan con demasiada facilidad, así que no son muy prácticas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=25
#. y4:msg_location=T4.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Isn't it hard to play with nails like that?
msgctxt "6528_Akiyama"
msgid "I can see that. Being a girl must be tough."
msgstr "Ya veo. Ser una chica debe ser duro."

msgctxt "6540_Rio"
msgid "Hehe! ♪ Oh, it sure can be, but most of the time, being a girl is a blast!"
msgstr "¡Jeje! ♪ Oh, puede llegar a serlo, pero la mayoría de las veces, ¡ser una chica es maravilloso!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=27
#. y4:msg_location=T4.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Isn't it hard to play with nails like that?
msgctxt "6552_Akiyama"
msgid "Heh. I'll take your word for it."
msgstr "Je. Entonces te tomo la palabra."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=28
#. y4:msg_location=T4.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Isn't it hard to play with nails like that?
msgctxt "6564_Akiyama"
msgid "Well, good luck with the guitar. Let me know when you can play it."
msgstr "Bueno, suerte con la guitarra. Cuéntame cuando le agarres el ritmo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=16
#. y4:msg_location=T4.P16
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "6576_Rio"
msgid "I will!"
msgstr "¡Lo haré!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=135
#. y4:msg_phrase=0
#. y4:msg_location=T135.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T4.P30
#. y4:msg_branch_segment=T4.P30..P41
#. y4:msg_branch_target_text=Why did you pick the guitar?
#. y4:msg_branch_raw=01 11 00 1e 00 00 00 1c 00 00 00 00 00 00 00 00
msgctxt "6588_Akiyama"
msgid "Why did you pick the guitar?"
msgstr "¿Por qué elegiste la guitarra?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=31
#. y4:msg_location=T4.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why did you pick the guitar?
msgctxt "6600_Rio"
msgid "Because of someone I used to date, actually."
msgstr "Por alguien con quien solía salir, en realidad."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=32
#. y4:msg_location=T4.P32
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why did you pick the guitar?
msgctxt "6612_Akiyama"
msgid "Yeah? Was he in a band or something?"
msgstr "¿Sí? ¿Estaba en una banda o algo así?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=33
#. y4:msg_location=T4.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why did you pick the guitar?
msgctxt "6624_Rio"
msgid "Yep. And that made me wish I could play, too."
msgstr "Sí. Y eso me hizo desear poder tocar también."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=34
#. y4:msg_location=T4.P34
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why did you pick the guitar?
msgctxt "6636_Akiyama"
msgid "Playing an instrument can be fun."
msgstr "Tocar un instrumento puede ser divertido."

msgctxt "6648_Rio"
msgid "For sure! ♪"
msgstr "Por supuesto! ♪"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=36
#. y4:msg_location=T4.P36
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why did you pick the guitar?
msgctxt "6660_Akiyama"
msgid "So you want to be able to sing and play?"
msgstr "¿Así que quieres ser capaz de cantar y tocar?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=37
#. y4:msg_location=T4.P37
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why did you pick the guitar?
msgctxt "6672_Rio"
msgid "Yeah! Just think about it! Everyone's out camping and singing songs around a campfire, and then I pull out my guitar! Wouldn't that be awesome?"
msgstr "¡Claro! Piénsalo. Todos reunidos en un campamento, cantando junto al fuego..., ¡y de repente saco mi guitarra! ¿No sería genial?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=38
#. y4:msg_location=T4.P38
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why did you pick the guitar?
msgctxt "6684_Akiyama"
msgid "Hah! So that's your image of a guitar player?"
msgstr "¡Hah! ¿Así que esa es tu imagen de un guitarrista?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=39
#. y4:msg_location=T4.P39
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why did you pick the guitar?
msgctxt "6696_Rio"
msgid "Yes! Exactly!"
msgstr "¡Sí! ¡Exactamente!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=28
#. y4:msg_location=T4.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Isn't it hard to play with nails like that?
msgctxt "6708_Akiyama"
msgid "Well, good luck with the guitar. Let me know when you can play it."
msgstr "Bueno, suerte con la guitarra. Cuéntame cuando le agarres el ritmo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=16
#. y4:msg_location=T4.P16
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "6720_Rio"
msgid "I will!"
msgstr "¡Lo haré!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
