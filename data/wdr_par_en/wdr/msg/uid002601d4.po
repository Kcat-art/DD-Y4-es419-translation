#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe it needs a new battery.
msgctxt "2332_Short Man"
msgid "(Shit! We're gonna get arrested!)"
msgstr "(¡Mierda! ¡Nos van a meter presos!)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=123
#. y4:msg_location=T2.P123
#. y4:msg_speaker=Tall Man
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe it needs a new battery.
msgctxt "2344_Tall Man"
msgid "(I guess there's no avoiding it now.)"
msgstr "(Supongo que ya no hay manera de evitarlo)."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=64
#. y4:msg_location=T2.P64
#. y4:msg_speaker=Short Man
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Is that the key to that car?
msgctxt "2356_Short Man"
msgid "We ain't going nowhere! We don't give up that easily!"
msgstr "¡No iremos a ninguna parte! ¡No nos rendiremos tan fácilmente!"

#. y4:line_status=translated
msgctxt "2368_Tall Man"
msgid "What!? Are you serious－ Ah, fuck it, let's just get him! Raaaaagh!"
msgstr "¡¿Qué, hablas en serio?! ¡Ah, al diablo, vamos a darle!\n¡Aaaaagh!"

#. y4:line_status=translated
msgctxt "2392_Short Man"
msgid "Hey, would ya look at that. Some dumbo forgot their wallet\\r\nin their car!"
msgstr "Oye, mira eso. ¡Algún idiota olvido su billetera\\r\nen el auto!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=1
#. y4:msg_location=T3.P1
#. y4:msg_speaker=Tall Man
#. y4:msg_speaker_id=1
msgctxt "2404_Tall Man"
msgid "Wait, isn't that one of those cheapie wallets they sell at the 100-yen store?"
msgstr "Espera, ¿No son de las miserables billeteras que se venden por\\r\n100 yenes en las tiendas?"

#. y4:line_status=translated
msgctxt "2416_Short Man"
msgid "Still, a wallet's a wallet. There might be money inside.\\r\nLet's get that shit!"
msgstr "¿Y? Una billetera es una billetera. Puede tener dinero dentro.\\r\n¡Vamos a conseguir esa mierda!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=3
#. y4:msg_location=T3.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2428_Tanimura"
msgid "(Aren't those the thieves from before?)"
msgstr "(¿No son esos los ladrones de antes?)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=4
#. y4:msg_location=T3.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2440_Tanimura"
msgid "(I'd rather not deal with this crap, but I'll get my head chewed off later if I leave the scene of a crime in progress.)"
msgstr "(Preferiría no lidiar con esta basura, pero me dejarán retumbando la cabeza con un sermón si abandono la escena de un crimen en progreso.)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=5
#. y4:msg_location=T3.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "2452_Tanimura"
msgid "(If I charge in and they run, it'll be too much of a hassle. I should approach quietly so they don't notice me.)"
msgstr "(Si voy directamente hacia ellos empezarán a correr, sería demasiado molesto. Debo acercarme sigilosamente para que no se percaten.)"

#. y4:line_status=translated
msgctxt "2464_Catch the Car Burglars!"
msgid "Don't miss your chance to arrest the thieves. But be careful－they'll notice you if you don't approach quietly."
msgstr "No pierdas la oportunidad de arrestar a los ladrones. Pero ten cuidado - ellos notarán tu presencia si no te acercas sigilosamente."

