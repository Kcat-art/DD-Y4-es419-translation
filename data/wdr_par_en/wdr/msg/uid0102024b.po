#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "128_Akiyama"
msgid "Hey, how'd your little session with Sugiuchi go?"
msgstr "Hey, qué tal."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=3
msgctxt "140_Kido"
msgid "Ugh, don't get me started."
msgstr "Buenas."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=3
msgctxt "152_Kido"
msgid "That guy really puts the dick in detective. What an asshole."
msgstr "Ahh, ese tal Sugiuchi, el detective... de verdad tiene una personalidad de mierda, ¿no?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "164_Akiyama"
msgid "No joke."
msgstr "Sí... Bueno, tiene más de cuarenta y sigue estancado en ese puesto, ¿no?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "176_Akiyama"
msgid "But hey, if I were over forty and still stuck as a beat cop, I'd probably have a chip on my shoulder, too."
msgstr "Debe estar frustrado... Seguro que sí."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=3
msgctxt "188_Kido"
msgid "You think that's all it is?"
msgstr "¿Tú crees que es solo eso?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "200_Akiyama"
msgid "You think it's not?"
msgstr "¿A qué te refieres?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=3
msgctxt "272_Kido"
msgid "I dunno. It kinda feels like he's, like, obsessed with you and Arai-aniki or something."
msgstr "Es que ese tal Sugiuchi... solo me hacía preguntas sobre usted y Arai-aniki."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "284_Akiyama"
msgid "How do you figure?"
msgstr "¿Sobre Arai y yo?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=3
msgctxt "296_Kido"
msgid "He kept grilling me about how you two met."
msgstr "Sí. Que cómo se conocieron ustedes dos, por ejemplo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=3
msgctxt "308_Kido"
msgid "Oh, and he wouldn't shut up about wanting to know what Kanemura's loan terms were."
msgstr "Que cuáles fueron las condiciones para que usted le prestara dinero a nuestro jefe..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=3
msgctxt "320_Kido"
msgid "Doesn't that seem kinda... weird to you?"
msgstr "¿No le parece raro?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "332_Akiyama"
msgid "I guess."
msgstr "Sí, un poco."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=3
msgctxt "344_Kido"
msgid "Not that I can blame him for wondering. Why <Italic>are</Italic> you throwing your weight behind Arai-aniki?"
msgstr "Pero igual, yo también tengo curiosidad. ¿Por qué se involucra tanto usted por Arai-aniki?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "356_Akiyama"
msgid "That's my little secret."
msgstr "......"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=3
msgctxt "368_Kido"
msgid "C'mon, Akiyama-san! You can tell me."
msgstr "Akiyama-san. Dígamelo, por favor."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "380_Akiyama"
msgid "Heh, maybe when you're older."
msgstr "Será en otra ocasión."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=3
msgctxt "392_Kido"
msgid "Ugh, Akiyama-san..."
msgstr "Akiyama-san..."
