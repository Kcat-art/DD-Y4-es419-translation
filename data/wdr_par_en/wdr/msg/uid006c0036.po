#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Historical dramas.
msgctxt "10896_Kiryu"
msgid "Hmm... I'd say Miyamoto Musashi."
msgstr "Hmm... Yo diría que Miyamoto Musashi."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=18
#. y4:msg_location=T18.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Historical dramas.
msgctxt "10908_Kiryu"
msgid "He always pushed himself to be stronger, and he fought all the best swordsmen throughout Japan. He's a man's man."
msgstr "Siempre se esforzó por ser más fuerte y luchó contra los mejores espadachines de todo Japón. Es el macho de machos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
