#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "232_Yusuke"
msgid "Me?"
msgstr "¿Yo?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Haruko
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "244_Haruko"
msgid "Don't worry. I know where she lives. I'll make sure she gets home okay."
msgstr "No te preocupes. Sé dónde vive. Me aseguraré de que llegue bien."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "256_Tanimura"
msgid "Oh, okay..."
msgstr "Oh, de acuerdo..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Haruko
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "268_Haruko"
msgid "Yusuke-kun, would you mind seeing Konatsu home? She's not drunk, but I'm still concerned about her, just the same."
msgstr "Yusuke-kun, ¿podrías acompañar a Konatsu a casa? No está ebria, pero igual me preocupa."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "280_Yusuke"
msgid "Oh, all right. Will do!"
msgstr "Oh, está bien. ¡Lo haré!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Haruko
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "292_Haruko"
msgid "Thanks! Well, today was a lot of fun! See you guys again!"
msgstr "¡Gracias! Bueno, hoy fue muy divertido. ¡Nos vemos!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=9
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "376_Haruko"
msgid "Uh-oh... That didn't go well at all."
msgstr "Uh-oh... Eso no salió nada bien."

#. y4:line_status=translated
msgctxt "388_Naoya"
msgid "Either way, thanks for your help, Ryo－ I mean, Tanimura-san."
msgstr "De todos modos, gracias por tu ayuda, Ryo－ digo, Tanimura-san."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "400_Tanimura"
msgid "To be honest, I don't think I helped that much."
msgstr "Para ser honesto, no creo haber ayudado mucho."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=9
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "412_Naoya"
msgid "Well... Yusuke didn't really man up the way he should've."
msgstr "Bueno... Yusuke no se comportó como debería."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=9
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "424_Naoya"
msgid "Sorry, but this is all I have to offer."
msgstr "Lo siento, pero esto es todo lo que tengo para ofrecer."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "448_Tanimura"
msgid "Thanks."
msgstr "Gracias."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=9
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "460_Naoya"
msgid "Don't mention it. I'm amazed you decided to help us out in the first place. Well, see you around."
msgstr "No hay de qué. Me sorprende que decidieras ayudarnos desde el principio. Bueno, nos vemos."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=38
#. y4:msg_location=T0.P38
#. y4:msg_speaker=Haruko
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "556_Haruko"
msgid "Really? That would be super! I'll see Konatsu home. Thanks, Yusuke-kun!"
msgstr "¿De verdad? ¡Sería genial! Me encargaré de llevar a Konatsu a casa. ¡Gracias, Yusuke-kun!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=39
#. y4:msg_location=T0.P39
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "568_Talk_Gakkari"
msgid "Well, everybody, today was fun. Thanks for coming out!"
msgstr "Bueno, todos, hoy fue divertido. ¡Gracias por venir!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=41
#. y4:msg_location=T0.P41
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "592_Haruko"
msgid "Come on, Akino. Let's go."
msgstr "Vamos, Akino. Andando."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=42
#. y4:msg_location=T0.P42
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "604_Akino"
msgid "Ughhh... Hmm? Yusuke? Where we going?"
msgstr "Ughhh... ¿Mm? ¿Yusuke? ¿A dónde vamos?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=43
#. y4:msg_location=T0.P43
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "616_Yusuke"
msgid "I'm taking your drunk self home, of course."
msgstr "Te llevo a casa, claro."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
