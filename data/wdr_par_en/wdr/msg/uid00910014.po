#. y4:msg_branch_choice=Check Investigation
msgctxt "5072_Tanimura"
msgid "[Seems GG ordered a large amount of guns, and a helicopter to boot.]"
msgstr "[Parece que GG ordeno una gran cantidad de armas y un\nhelicóptero.]"

#. y4:line_status=translated
