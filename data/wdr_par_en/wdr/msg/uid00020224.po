msgid "Why?"
msgstr "¿Tú?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=The Florist
#. y4:msg_speaker_id=0
msgctxt "92_The Florist"
msgid "I had a feeling you weren't just another psychopath."
msgstr "Tenía la sensación de que no eras un psicópata más."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=3
msgctxt "104_Saejima"
msgid "The hell does that mean?"
msgstr "¿Qué quieres decir?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=The Florist
#. y4:msg_speaker_id=0
msgctxt "116_The Florist"
msgid "If you had killed Ivan, I would have denied your request."
msgstr "La pelea, si hubieras intentado matar a Ivan, habría rechazado tu petición."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=3
msgctxt "128_Saejima"
msgid "'Scuse me?"
msgstr "¿Disculpa?"

#. y4:line_status=translated
msgctxt "140_The Florist"
msgid "People come here to see blood, but letting my prizefighters\\r\nmurder each other would be bad business."
msgstr "La gente viene aquí buscando sangre.\\r\n...pero no tengo intención de dejar que se maten entre sí."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=The Florist
#. y4:msg_speaker_id=0
msgctxt "152_The Florist"
msgid "I'm relieved to see there's some humanity left in you."
msgstr "Me alegra saber que aún te queda humanidad."

#. y4:line_status=translated
#. y4:msg_type=dialogue
