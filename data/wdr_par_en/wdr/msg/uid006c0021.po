#. y4:msg_phrase=0
#. y4:msg_location=T23.P0
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "12912_Erena"
msgid "I saw the best romantic comedy yesterday!"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=1
#. y4:msg_location=T23.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "12924_Akiyama"
msgid "You like those?"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=2
#. y4:msg_location=T23.P2
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "12936_Erena"
msgid "I guess. I like horror, too, but the girl in me can't get enough romantic comedies."
msgstr ""

msgctxt "12948_Erena"
msgid "I love stories with happy endings. <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
