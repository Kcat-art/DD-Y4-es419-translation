#. y4:msg_branch_raw=01 11 00 12 00 00 00 1a 00 00 00 00 00 00 00 00
msgctxt "4980_Kiryu"
msgid "You could find a roommate."
msgstr "Podrías encontrar un compañero de piso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=19
#. y4:msg_location=T2.P19
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "4992_松岡里緒奈：源氏名"
msgid "I thought about that, but I'm not a very neat person."
msgstr "Lo pensé, pero no soy una persona muy ordenada."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=20
#. y4:msg_location=T2.P20
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "5004_松岡里緒奈：源氏名"
msgid "One of my friends was shocked when she visited my apartment a while ago. She said I must have some unnatural aversion to cleaning..."
msgstr "Una de mis amigas se sorprendió cuando visitó mi apartamento hace un tiempo. Dijo que debía de tener una aversión antinatural a la limpieza..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=21
#. y4:msg_location=T2.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "5016_Kiryu"
msgid "It's that bad?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=22
#. y4:msg_location=T2.P22
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "5028_松岡里緒奈：源氏名"
msgid "Yes. I've got clothes and underwear strewn everywhere, and I forget to take out the trash..."
msgstr "Sí. Tengo ropa y ropa interior esparcida por todas partes, y me olvido de sacar la basura..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=23
#. y4:msg_location=T2.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "5040_Kiryu"
msgid "Wow, that is pretty bad."
msgstr "Vaya, eso es bastante malo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=24
#. y4:msg_location=T2.P24
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "5052_松岡里緒奈：源氏名"
msgid "How about you? Are you a neat person?"
msgstr "¿Y que hay de usted? ¿Es una persona ordenada?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=25
#. y4:msg_location=T2.P25
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "5064_Kiryu"
msgid "Yes, I am. I like to keep things in order. I'm pretty handy with an iron."
msgstr "Sí, así es. Me gusta mantener las cosas en orden. Soy bastante hábil con la plancha."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=26
#. y4:msg_location=T2.P26
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "5076_松岡里緒奈：源氏名"
msgid "Really!? Maybe we could live together!"
msgstr "¿¡En serio!? ¡Quizás podríamos vivir juntos!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=27
#. y4:msg_location=T2.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "5088_Kiryu"
msgid "I was just kidding."
msgstr "Estaba bromeando."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=28
#. y4:msg_location=T2.P28
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "5100_松岡里緒奈：源氏名"
msgid "Oh..."
msgstr "Oh..."

msgctxt "5112_松岡里緒奈：源氏名"
msgid "Well, living with you still sounds like it'd be fun. <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=30
#. y4:msg_location=T2.P30
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You'll get used to it eventually.
msgctxt "5124_Kiryu"
msgid "You'll get used to it eventually. Living alone can be a good experience."
msgstr "Con el tiempo te acostumbrarás. Vivir solo puede ser una buena experiencia."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=31
#. y4:msg_location=T2.P31
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You'll get used to it eventually.
msgctxt "5136_松岡里緒奈：源氏名"
msgid "Yes, I guess so."
msgstr "Sí, supongo que sí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=32
#. y4:msg_location=T2.P32
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You'll get used to it eventually.
msgctxt "5148_松岡里緒奈：源氏名"
msgid "But I'm so sick of being lonely. I wish there was something I could do about it."
msgstr "Pero estoy tan harta de estar sola. Desearía que hubiera algo que pudiera hacer al respecto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=33
#. y4:msg_location=T2.P33
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You'll get used to it eventually.
msgctxt "5160_Kiryu"
msgid "Have you thought about getting a pet?"
msgstr "¿Has pensado en tener una mascota?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=34
#. y4:msg_location=T2.P34
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You'll get used to it eventually.
msgctxt "5172_松岡里緒奈：源氏名"
msgid "No, I couldn't do that. I can't even pick up after myself, let alone an animal."
msgstr "No, no podría hacer eso. Ni siquiera puedo recoger lo que ensucio, mucho menos un animal."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=35
#. y4:msg_location=T2.P35
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You'll get used to it eventually.
msgctxt "5184_Kiryu"
msgid "Huh. I guess you'll just have to live with it."
msgstr "Eh. Supongo que tendrás que vivir con ello."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=36
#. y4:msg_location=T2.P36
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You'll get used to it eventually.
msgctxt "5196_松岡里緒奈：源氏名"
msgid "Maybe I shouldn't have run away from home..."
msgstr "Tal vez no debería haberme escapado de casa..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=37
#. y4:msg_location=T2.P37
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You'll get used to it eventually.
msgctxt "5208_Kiryu"
msgid "......"
msgstr "......"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=0
#. y4:msg_location=T3.P0
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "5220_松岡里緒奈：源氏名"
msgid "Do you have any particular kind of girl you prefer to date?"
msgstr "¿Tiene algún tipo de chica en particular con la que prefiere salir?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=1
#. y4:msg_location=T3.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "5232_Kiryu"
msgid "Not really. The most important thing to me is that we both feel the same way about each other."
msgstr "La verdad es que no. Lo más importante para mí es que ambos sentimos lo mismo el uno por el otro."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=2
#. y4:msg_location=T3.P2
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "5244_松岡里緒奈：源氏名"
msgid "You don't have any preferences? Not even for how a girl looks?"
msgstr "¿No tienes ninguna preferencia? ¿Ni siquiera por el aspecto de una chica?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=3
#. y4:msg_location=T3.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "5256_Kiryu"
msgid "No. I don't judge a book by its cover. How about you?"
msgstr "No. No juzgo un libro por su portada. ¿Y tú?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=4
#. y4:msg_location=T3.P4
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "5268_松岡里緒奈：源氏名"
msgid "I have really high standards!"
msgstr "¡Tengo estándares realmente altos!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=5
#. y4:msg_location=T3.P5
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "5280_松岡里緒奈：源氏名"
msgid "He has to be able to run 100 meters in about 11 seconds and have a grip strength of 100 kilos. He has to be kind, short-haired, and a gourmet!"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=6
#. y4:msg_location=T3.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "5292_Kiryu"
msgid "Is... Is that all?"
msgstr "Es... ¿Eso es todo?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=7
#. y4:msg_location=T3.P7
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=3
#. y4:msg_decision_choices=1. Piece of cake. -> T3.P8 | 2. Are you saying you want to date me? -> T3.P15 | 3. You won't find too many men like that. -> T3.P22
msgctxt "5304_松岡里緒奈：源氏名"
msgid "Do you think you can meet my standards?"
msgstr "¿Crees que puedes cumplir con mis estándares?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=8
#. y4:msg_location=T3.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Piece of cake.
msgctxt "5316_Kiryu"
msgid "Piece of cake. Although my hair has gotten a bit long."
msgstr "Pan comido. Aunque mi pelo se ha vuelto un poco largo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=9
#. y4:msg_location=T3.P9
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Piece of cake.
msgctxt "5328_松岡里緒奈：源氏名"
msgid "You have a grip strength of 100 kilos!?"
msgstr "¿¡Tienes una fuerza de agarre de 100 kilos!?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=10
#. y4:msg_location=T3.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Piece of cake.
msgctxt "5340_Kiryu"
msgid "Sure. I'll measure it in front of you some time."
msgstr "Claro. La mediré frente a ti alguna vez."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=11
#. y4:msg_location=T3.P11
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Piece of cake.
msgctxt "5352_松岡里緒奈：源氏名"
msgid "And you know a lot of fancy restaurants?"
msgstr "¿Y conoces muchos restaurantes elegantes?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=12
#. y4:msg_location=T3.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Piece of cake.
msgctxt "5364_Kiryu"
msgid "I know some good, cheap places in Kamurocho. I'm a regular at most of them. I can take you with me if you want."
msgstr "Conozco algunos sitios buenos y baratos en Kamurocho. Soy cliente habitual de la mayoría de ellos. Puedo llevarte conmigo si quieres."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=13
#. y4:msg_location=T3.P13
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Piece of cake.
msgctxt "5376_松岡里緒奈：源氏名"
msgid "Wonderful! You may just fit the bill!"
msgstr "¡Maravilloso! ¡Puede que encajes a la perfección!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=14
#. y4:msg_location=T3.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Piece of cake.
msgctxt "5388_Kiryu"
msgid "Heh. What did I tell you?"
msgstr "Je. ¿Qué te dije?"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=131
#. y4:msg_phrase=0
#. y4:msg_location=T131.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T3.P15
#. y4:msg_branch_segment=T3.P15..P21
#. y4:msg_branch_target_text=Are you saying you want to date me?
#. y4:msg_branch_raw=01 11 00 0f 00 00 00 23 00 00 00 00 00 00 00 00
msgctxt "5400_Kiryu"
msgid "Are you saying you want to date me?"
msgstr "¿Estás diciendo que quieres salir conmigo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=16
#. y4:msg_location=T3.P16
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you saying you want to date me?
msgctxt "5412_松岡里緒奈：源氏名"
msgid "Huh? I didn't mean it that way. I was just wondering how you would measure up."
msgstr ""

