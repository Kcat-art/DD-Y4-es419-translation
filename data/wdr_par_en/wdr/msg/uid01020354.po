#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=1
msgctxt "128_Zhao"
msgid "Leaving already, Ma-chan?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "176_Tanimura"
msgid "...You know, Zhao-san? You've been a better friend to me than I've ever been to you."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=1
msgctxt "188_Zhao"
msgid "Don't be ridiculous. You know that's not true."
msgstr ""

msgctxt "212_Zhao"
msgid "I'm just sorry the truth turned out to be so harsh. Your\\r\n"
"father, murdered by another man on the force... I can\\r\n"
"barely believe it."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "224_Tanimura"
msgid "You're telling me."
msgstr "Puedes creerlo."

msgctxt "236_Zhao"
msgid "Something about all this doesn't sit well with me...\\r\n"
"How will your father's spirit ever find peace?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "260_Tanimura"
msgid "I think he'll be just fine."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=1
msgctxt "272_Zhao"
msgid "Hm?"
msgstr "¿Mm?"

msgctxt "296_Tanimura"
msgid "Chief Hisai, Sugiuchi-san... They were tired of being used\\r\n"
"by Munakata and Katsuragi all these years."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=1
msgctxt "308_Zhao"
msgid "Hm..."
msgstr "Mm..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "332_Tanimura"
msgid "The two of them spent their whole lives serving others."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "344_Tanimura"
msgid "But their final moments... Those were theirs, and theirs alone."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "356_Tanimura"
msgid "They went out following their own brand of justice."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=1
msgctxt "368_Zhao"
msgid "Ma-chan..."
msgstr ""

msgctxt "392_Tanimura"
msgid "Sugiuchi-san must've known telling me the truth of what\\r\n"
"happened 25 years ago was signing his own death warrant."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "404_Tanimura"
msgid "But he did it anyway."
msgstr ""

msgctxt "416_Tanimura"
msgid "And Chief Hisai... He took his own life in order to spare\\r\n"
"you, me, and Mei Hua."
msgstr ""

msgctxt "440_Zhao"
msgid "That explains what he said into the phone before he shot\\r\n"
"himself: \"Both of them will be dealt with.\""
msgstr ""

msgctxt "452_Tanimura"
msgid "Yeah. Chief Hisai told Munakata I was dead so he'd stop\\r\n"
"coming after me."
msgstr ""

msgctxt "464_Tanimura"
msgid "He spared my life so that I could do what's right. So that\\r\n"
"I could do what he never could."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=35
#. y4:msg_location=T0.P35
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=1
msgctxt "476_Zhao"
msgid "You mean bring Munakata down?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=36
#. y4:msg_location=T0.P36
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "488_Tanimura"
msgid "Exactly."
msgstr "Exacto."

msgctxt "512_Zhao"
msgid "But how are you gonna do that, Ma-chan? Munakata's one of\\r\n"
"the most powerful men in one of the top police institutions in the world."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=39
#. y4:msg_location=T0.P39
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "524_Tanimura"
msgid "Well, I don't think I'll be getting much help from my fellow officers, that's for sure."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=43
#. y4:msg_location=T0.P43
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=5
msgctxt "572_Akiyama"
msgid "Ni hao."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=44
#. y4:msg_location=T0.P44
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "584_Tanimura"
msgid "Akiyama-san."
msgstr "Akiyama-san."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=45
#. y4:msg_location=T0.P45
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=5
msgctxt "596_Akiyama"
msgid "Phew. The shit's really hit the proverbial fan, huh?"
msgstr ""

msgctxt "608_Tanimura"
msgid "You're telling me. Anyway, what's up? You wouldn't swing by\\r\n"
"here without a good reason."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=47
#. y4:msg_location=T0.P47
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=5
msgctxt "620_Akiyama"
msgid "You know, sometimes it's depressing how sharp you are."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=48
#. y4:msg_location=T0.P48
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "632_Tanimura"
msgid "What happened?"
msgstr "¿Por qué?"

msgctxt "644_Akiyama"
msgid "District attorney's goons showed up at my office. Started\\r\n"
"tearing the place apart at the seams."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=50
#. y4:msg_location=T0.P50
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=5
msgctxt "656_Akiyama"
msgid "Not to mention, they chucked me out on the street."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=51
#. y4:msg_location=T0.P51
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "668_Tanimura"
msgid "Wait, they're investigating Sky Finance? On what grounds?"
msgstr ""

msgctxt "680_Akiyama"
msgid "They said they're looking into some kinda coercion. The\\r\n"
"exact term's eluding me at the moment."
msgstr ""

msgctxt "692_Akiyama"
msgid "Anyway, the issue is my tests. They said I'm forcing people\\r\n"
"to do stuff they don't want to do in exchange for money.\\r\n"
"Classic coercion case, I guess."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=54
#. y4:msg_location=T0.P54
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "704_Tanimura"
msgid "Heh, it's like I can hear the words coming out of the DA's mouth himself."
msgstr ""

msgctxt "716_Akiyama"
msgid "Anyway, I didn't know where else to turn, so I thought I'd\\r\n"
"drop by here."
msgstr ""

msgctxt "728_Akiyama"
msgid "Looks like I caught you at a bad time, though. Want me to\\r\n"
"come back later?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=57
#. y4:msg_location=T0.P57
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "740_Tanimura"
msgid "No, your timing actually couldn't be better."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=58
#. y4:msg_location=T0.P58
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=5
msgctxt "752_Akiyama"
msgid "Oh yeah?"
msgstr "Ya veo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=59
#. y4:msg_location=T0.P59
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "764_Tanimura"
msgid "Yeah. I need a hand with something, Akiyama-san."
msgstr ""
