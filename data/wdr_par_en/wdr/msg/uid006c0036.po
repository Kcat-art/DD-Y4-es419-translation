#. y4:msg_branch_target_text=I'd like to be a gorilla, too.
#. y4:msg_branch_raw=01 11 00 16 00 00 00 1e 00 00 00 00 00 00 00 00
msgctxt "6540_Kiryu"
msgid "I'd like to be a gorilla, too."
msgstr "A mí también me gustaría ser un gorila."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=23
#. y4:msg_location=T6.P23
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'd like to be a gorilla, too.
msgctxt "6552_松岡里緒奈：源氏名"
msgid "Really? What a coincidence! What do you like about gorillas?"
msgstr "¿De verdad? ¡Qué casualidad! ¿Qué es lo que más te gusta de los gorilas?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=24
#. y4:msg_location=T6.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'd like to be a gorilla, too.
msgctxt "6564_Kiryu"
msgid "Well, they're strong. And they have lots of wives."
msgstr "Bueno, son fuertes. Y tienen muchas esposas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=25
#. y4:msg_location=T6.P25
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'd like to be a gorilla, too.
msgctxt "6576_松岡里緒奈：源氏名"
msgid "Lots of wives, huh? You mean male gorillas sleep around a lot?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=26
#. y4:msg_location=T6.P26
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'd like to be a gorilla, too.
msgctxt "6588_Kiryu"
msgid "That's right. Would you be interested in being one of my mates?"
msgstr "Así es. ¿Te interesaría ser una de mis compañeras?"

msgctxt "6600_松岡里緒奈：源氏名"
msgid "Hehehe. I won't settle for being one of many, but I'll consider it if I get to be your official wife. <Color:7>♥<Color:Default>"
msgstr "Jejeje. No me conformaré con ser una de muchas, pero lo consideraré si llego a ser tu esposa oficial. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=28
#. y4:msg_location=T6.P28
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'd like to be a gorilla, too.
msgctxt "6612_Kiryu"
msgid "Ah. Oh well."
msgstr "Ah. Oh bueno."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
