#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "84_Kiryu"
msgid "Sorry to keep you waiting."
msgstr "Lamento hacerle esperar."

#. y4:line_status=translated
msgctxt "96_Takashi"
msgid "There you are, Kiryu-san! So? What did you find out about\\r\nmy father?"
msgstr "¡Aquí está, Kiryu-san! ¿Entonces? ¿Qué descubrió sobre\\r\nmi padre?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "108_Kiryu"
msgid "Everything you want to know should be inside this bouquet."
msgstr "Todo lo que debes saber está en este ramo de flores."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "144_Takashi"
msgid "I guess it's on this card, then."
msgstr "¿Esta tarjeta, verdad? A ver..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "156_Takashi"
msgid "Let's see..."
msgstr "Veamos..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "168_Takashi"
msgid "Huh!? No way..."
msgstr "¿Eh? ¡No puede ser...!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "180_Kiryu"
msgid "......"
msgstr "......"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "192_Takashi"
msgid "This says... my father's dead. That can't be true, can it?"
msgstr "Esto dice... que mi padre está muerto. ¿Eso no puede ser cierto, verdad?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "204_Kiryu"
msgid "Huh? What are you talking about?"
msgstr "¿Eh? ¿De qué estás hablando?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "216_Takashi"
msgid "Look! It says so right here on this card!"
msgstr "¡Mira! ¡Lo dice aquí en la tarjeta!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=12
#. y4:msg_location=T1.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "228_Kiryu"
msgid "I can't believe it..."
msgstr "No puede ser..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "240_Kiryu"
msgid "(What is the Florist thinking?)"
msgstr "(¿Qué es lo que pretende el Florista?)."

#. y4:line_status=translated
msgctxt "252_Takashi"
msgid "I guess it's enough knowing he and my mom are out there\\r\nsomewhere, watching over me and Kyoka."
msgstr "Creo que me basta con saber que ellos, mi mamá y él, están en\\r\nalgún lado, protegiéndonos a Kyoka y a mí."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "264_Kiryu"
msgid "I'm sorry, Takashi."
msgstr "Takashi..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "276_Takashi"
msgid "......"
msgstr "......"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=17
#. y4:msg_location=T1.P17
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "288_Takashi"
msgid "...Huh?"
msgstr "... ¿Eh?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=18
#. y4:msg_location=T1.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "300_Kiryu"
msgid "What is it?"
msgstr "¿Qué cosa?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=19
#. y4:msg_location=T1.P19
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "312_Takashi"
msgid "These flowers! Aren't these...?"
msgstr "¡Estas flores! ¿Acaso son...?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=20
#. y4:msg_location=T1.P20
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "324_Takashi"
msgid "Yeah, they are! They're definitely the same flowers!"
msgstr "¡Sí, lo son! ¡Definitivamente son las mismas flores!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=21
#. y4:msg_location=T1.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "336_Kiryu"
msgid "What are you talking about?"
msgstr "¿A qué te refieres?"

#. y4:line_status=translated
msgctxt "348_Takashi"
msgid "Every year on the anniversary of my mom's death, someone\\r\nleaves a massive bouquet of flowers at her grave. These are\\r\nthe same kind, I'm sure of it!"
msgstr "Todos los años, en el aniversario de la muerte de mi madre,\\r\nalguien deja flores en su tumba... ¡Y son exactamente las\\r\nmismas que estas!"

#. y4:line_status=translated
msgctxt "360_Takashi"
msgid "Whoever has been leaving them is always gone by the time I\\r\nget there, so I've never known who it was."
msgstr "Siempre estaban allí antes de que yo llegara a visitar la tumba.\\r\nSiempre me he preguntado quién las deja ahí..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=24
#. y4:msg_location=T1.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "372_Kiryu"
msgid "Hm..."
msgstr "Mm..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=25
#. y4:msg_location=T1.P25
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "384_Takashi"
msgid "And, well... when she was alive, my mom loved these flowers."
msgstr "Y, bueno... Estas flores eran las favoritas de mi madre."

#. y4:line_status=translated
msgctxt "396_Takashi"
msgid "She once told me how she used to have a garden full of them\\r\nat home, when she and my dad still lived together."
msgstr "Ella me contó una vez que solía tener un jardín lleno de ellas\\r en casa, cuando ella y mi padre todavía vivían juntos."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=27
#. y4:msg_location=T1.P27
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "408_Takashi"
msgid "I was just a baby at the time... but she said she loved that garden more than anything."
msgstr "Cuidar del jardín era uno de los pasatiempos de mi madre."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=28
#. y4:msg_location=T1.P28
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "420_Kiryu"
msgid "Guess this is a pretty important flower, then."
msgstr "Entonces, estas deben ser unas flores muy importantes."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=29
#. y4:msg_location=T1.P29
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "432_Takashi"
msgid "Hey, Kiryu-san?"
msgstr "¿Oye, Kiryu-san?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=30
#. y4:msg_location=T1.P30
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "444_Kiryu"
msgid "Hm?"
msgstr "¿Mm?"

#. y4:line_status=translated
msgctxt "456_Takashi"
msgid "The Florist's the one who gave you these flowers, right? Why\\r\ndo you think he did that?"
msgstr "¿Fue el Florista quien le dio estas flores? ¿Por qué cree\\r\nque lo hizo?"

#. y4:line_status=translated
msgctxt "468_Kiryu"
msgid "Couldn't tell you. All I really know about the guy is that\\r\nhe's an information dealer. Everything else is shrouded in\\r\nmystery."
msgstr "No lo sé... Lo único que sé es que él es un informante legendario\\r\nde identidad desconocida y..."

#. y4:line_status=translated
msgctxt "480_Kiryu"
msgid "Though there's one other thing I know. As tough as he looks,\\r\nhe has a soft spot for that one type of flower."
msgstr "A pesar de su apariencia, parece que le gustan mucho esas flores...\\r\neso es todo lo que sé."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=35
#. y4:msg_location=T1.P35
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "504_Takashi"
msgid "Hm... I see! I think I get it now!"
msgstr "Mm... ¡Ya veo! ¡Ahora lo entiendo!"

#. y4:line_status=translated
msgctxt "516_Takashi"
msgid "Thanks for everything, Kiryu-san. If you wouldn't mind,\\r\nI'd love for you to attend the wedding."
msgstr "Kiryu-san, realmente le agradezco por todo. Si le parece bien,\\r\n¡me encantaría que asistiera a mi boda!"

#. y4:line_status=translated
msgctxt "528_Kiryu"
msgid "I might just take you up on that. In the meantime, be good\\r\nto Kyoka... and your dad, too."
msgstr "Puede que sí acepte. Y mientras tanto, sé bueno con Kyoka...\\r\ny con tu padre también."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=38
#. y4:msg_location=T1.P38
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "540_Takashi"
msgid "I will!"
msgstr "¡Lo prometo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=43
#. y4:msg_location=T1.P43
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "600_Kiryu"
msgid "Heh, looks like the truth still came out in the end..."
msgstr "Je, parece que al final la verdad salió a la luz..."
