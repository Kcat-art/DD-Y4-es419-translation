#. y4:file_status=translated
#. y4:last_reviewer=Kcat0

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
msgctxt "620"
msgid "Quit"
msgstr "Salir"

#. y4:line_status=translated
msgctxt "625"
msgid "Cancel the order."
msgstr "Cancelar el pedido."

#. y4:line_status=translated
msgctxt "643"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=translated
msgctxt "649"
msgid "Order the currently selected item."
msgstr "Pagar el objeto seleccionado actualmente."

#. y4:line_status=translated
msgctxt "684"
msgid "(I haven't picked anything.)"
msgstr "(No he escogido nada)"

#. y4:line_status=translated
msgctxt "713"
msgid "(I'm short on cash.)"
msgstr "(Me hace falta dinero)"

#. y4:line_status=translated
msgctxt "734"
msgid "Thank you. Your total comes to %s."
msgstr "Gracias. El precio total es de %s."

#. y4:line_status=translated
msgctxt "769"
msgid "(I can't eat anymore...)"
msgstr "(No puedo comer más...)"

#. y4:line_status=translated
msgctxt "812"
msgid "Thick-cut chuck meat. Some of the best beef on offer."
msgstr "Carne de ternera de corte grueso. Una de las mejores carnes disponibles."

#. y4:line_status=translated
msgctxt "866"
msgid "This tongue meat is popular for its unique flavor."
msgstr "Esta carne de lengua es popular por su sabor único."

#. y4:line_status=translated
msgctxt "917"
msgid "This tongue meat from carefully selected beef is soft\nand rich. Enjoy! "
msgstr "Esta carne de lengua de res cuidadosamente\nseleccionada es suave y rica. ¡Disfrútala!"

#. y4:line_status=translated
msgctxt "989"
msgid "Meat from the belly of the cow. Popular for its \nincredibly rich flavor."
msgstr "Carne de la panza de la vaca. Popular por su\nsabor increíblemente rico."

#. y4:line_status=translated
msgctxt "1062"
msgid "Top-grade kalbi beef taken from the choicest parts of\na single cow."
msgstr "Carne de res kalbi de primera calidad obtenida de las\npartes más selectas de una sola vaca."

#. y4:line_status=translated
msgctxt "1130"
msgid "Beef back strap with a mild flavor and relatively low\nin fat."
msgstr "Tira de lomo de res con un sabor suave y\nrelativamente bajo en grasa."

#. y4:line_status=translated
msgctxt "1192"
msgid "Choice sirloin taken from top-grade Japanese beef.\nThe taste is incredible."
msgstr "Solomillo de ternera japonesa de primera calidad.\nEl sabor es increíble."

#. y4:line_status=translated
msgctxt "1268"
msgid "This beef skirt steak is actually considered to be \nentrails, but it's very popular nonetheless."
msgstr "Este filete de ternera en realidad se considera\nvísceras, pero aun así es muy popular."

#. y4:line_status=translated
msgctxt "1365"
msgid "Harami taken from top-grade Japanese beef. An \nincredible treat for your tastebuds."
msgstr "Harami extraído de carne de res japonesa de\nprimera calidad. Un placer increíble para el\npaladar."

#. y4:line_status=translated
msgctxt "1449"
msgid "Fresh liver cut up into raw strips with a delicious \nsesame-based sauce."
msgstr "Hígado fresco cortado en tiras crudas con una\ndeliciosa salsa a base de sésamo."

#. y4:line_status=translated
msgctxt "1522"
msgid "Some say this choice beef intestine only finds \nits true worth in being burnt black."
msgstr "Algunos dicen que este selecto intestino de res\nsólo encuentra su verdadero valor cuando se\nquema hasta quedar negro."

#. y4:line_status=translated
msgctxt "1607"
msgid "A serving of succulent seafood, such as shrimp, \nscallops, and squid."
msgstr "Una ración de suculentos mariscos como\ncamarones, vieiras y calamares."

#. y4:line_status=translated
msgctxt "1677"
msgid "Kimchi made from Chinese cabbage, cucumbers, \ndaikon, and more in this tantalizing combo dish."
msgstr "Kimchi elaborado con col china, pepinos, daikon\ny mucho más en este tentador plato combinado."

#. y4:line_status=translated
msgctxt "1772"
msgid "Eat it up with our salty sweet gochujang sauce. \nDelicious when roasted to a golden brown."
msgstr "Cómelo con nuestra salsa gochujang agridulce y\nsalada. Delicioso cuando se asa hasta que esté\ndorado."

#. y4:line_status=translated
msgctxt "1863"
msgid "Spicy beef soup and rice is one of our house \nspecialties."
msgstr "La sopa picante de ternera y arroz es una de\nnuestras especialidades."

