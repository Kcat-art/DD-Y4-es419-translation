#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Unfortunately, no.
msgctxt "2628_Tanimura"
msgid "I see..."
msgstr "Ya veo..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=52
#. y4:msg_phrase=0
#. y4:msg_location=T52.P0
