#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=0
msgctxt "100_Numai"
msgid "Ah, Saejima-san. Always a pleasure. I'm still wrestling with the decision of whether I should keep giving campaign speeches."
msgstr "Ah, Saejima-san. Un gusto verlo. Todavía estoy dudando si debo seguir dando discursos de campaña."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=0
msgctxt "112_Numai"
msgid "I don't want to cause a scandal, but I don't want to give in to threats, either."
msgstr "No quiero que se arme un escándalo, pero tampoco quiero ceder ante las amenazas."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Good luck out there. -> T0.P3 | 2. I'll be your lookout. -> T0.P10
msgctxt "124_Saejima"
msgid "(Guess they're still bein' harassed by hired thugs.)"
msgstr "(Parece que todavía los están acosando matones contratados)."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Good luck out there.
msgctxt "136_Saejima"
msgid "Punks like that prolly ain't votin' anyway. Good luck out there, though."
msgstr "Esos tipos probablemente ni siquiera van a votar. De todos modos, buena suerte allá afuera."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Good luck out there.
msgctxt "148_Numai"
msgid "Thank you very much! As long as I have even a single supporter, I'll keep fighting to be the people's politician!"
msgstr "¡Muchísimas gracias! ¡Mientras tenga un solo simpatizante \\r\n"
"seguiré luchando por ser el político del pueblo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll be your lookout.
msgctxt "220_Saejima"
msgid "I'll be your lookout, if ya like."
msgstr "Puedo ser tu vigía, si quieres."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll be your lookout.
msgctxt "232_Numai"
msgid "Oh, but I couldn't impose on you like that."
msgstr "Oh, pero no puedo obligarte hacer algo así."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll be your lookout.
msgctxt "244_Saejima"
msgid "I just wanna lend a helpin' hand to a guy who could use one."
msgstr "Solo quiero echar una mano a alguien que podría necesitarla."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll be your lookout.
msgctxt "256_Numai"
msgid "Really? Well, if you don't mind, then I'd appreciate it."
msgstr "¿De verdad? Bueno, si no te molesta, lo agradecería."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll be your lookout.
msgctxt "268_Numai"
msgid "But please, try not to do anything too rash..."
msgstr "Pero por favor, intenta no hacer algo muy precipitado..."

