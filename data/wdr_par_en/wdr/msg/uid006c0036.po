msgctxt "14064_松岡里緒奈：源氏名"
msgid "I had quite a shock the other night."
msgstr "La otra noche me llevé un buen susto."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
