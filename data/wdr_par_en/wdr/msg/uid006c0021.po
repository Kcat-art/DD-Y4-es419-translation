#. y4:msg_branch_target=T4.P10
#. y4:msg_branch_segment=T4.P10..P19
#. y4:msg_branch_target_text=It sounds like he's trying pretty hard.
#. y4:msg_branch_raw=01 11 00 0a 00 00 00 27 00 00 00 00 00 00 00 00
msgctxt "6024_Akiyama"
msgid "It sounds like he's trying pretty hard."
msgstr "Parece que se está esforzando bastante."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
