msgctxt "210\tNAME"
msgid "Police Scanner"
msgstr "Escáner policial"

#. y4:line_status=translated
msgctxt "249\tEXPLANATION"
msgid "Help Akaishi and the Kamurocho Guard by solving the cases\nyou receive on the police scanner."
msgstr "Ayuda a Akaishi y a la policía de Kamurocho resolviendo los casos\nque recibes en el escáner de la policía."

#. y4:line_status=translated
msgctxt "342\tEXPLANATION"
msgid "Akaishi and the Kamurocho are in trouble. Help them out."
msgstr "Akaishi y la policía están en problemas. Ayúdalos."

#. y4:line_status=translated
msgctxt "399\tEXPLANATION"
msgid "You helped Akaishi and the Kamurocho Guard by solving the\ncases you received on the scanner."
msgstr "Ayudaste a Akaishi y a la policía de Kamurocho a resolver los\ncasos del escáner."

