#. y4:msg_branch_choice=Go With Him
msgctxt "376_Akiyama"
msgid "...All right. I'll come along."
msgstr "Vale... Te acompañaré."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
