#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=We should go out for all-you-can-eat yakiniku.
msgctxt "6732_松岡里緒奈：源氏名"
msgid "But if I eat too much, I might not be able to fit into my dresses..."
msgstr "Pero si como demasiado, puede que no me quepan mis vestidos..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=10
