#. y4:msg_branch_raw=01 11 00 1a 00 00 00 11 00 00 00 00 00 00 00 00
msgctxt "3024_Saejima"
msgid "Go to a new dojo."
msgstr ""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=24
#. y4:msg_phrase=0
#. y4:msg_location=T24.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T1.P29
#. y4:msg_branch_segment=T1.P29..P32
#. y4:msg_branch_target_text=Who the fuck cares if they're asses? It don't matter. I'd of done nothin'. This sport's about facin' yerself, not a bunch o' low lives.
#. y4:msg_branch_raw=01 11 00 1d 00 00 00 0e 00 00 00 00 00 00 00 00
msgctxt "3036_Saejima"
msgid "Wouldn't care."
msgstr ""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=25
#. y4:msg_phrase=0
#. y4:msg_location=T25.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T1.P33
#. y4:msg_branch_segment=T1.P33..P75
#. y4:msg_branch_target_text=Well, I guess if I hated 'em that much I woulda chased 'em outta the dojo myself. No point in me being the one leavin'.
#. y4:msg_branch_raw=01 11 00 21 00 00 00 12 00 00 00 00 00 00 00 00
msgctxt "3048_Saejima"
msgid "I'd chase 'em off."
msgstr ""

