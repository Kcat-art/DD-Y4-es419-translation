#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "584_Kamiyama"
msgid "Oh, hello. What can I do for you today?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "596_Saejima"
msgid "Hey, I need you to make me a bomb. Could you make me one from this battery and this high-grade explosive gunpowder?"
msgstr "Ey, necesito que me hagas una bomba. ¿Podrías hacerme una con esta bateria y esta polvora explosiva de alta calidad?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "608_Kamiyama"
msgid "A bomb? You're not particular about the case or cables I use, right?"
msgstr " ¿Una bomba? ¿No eres exigente con el estuche o los cables que uso, ¿verdad?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "620_Kamiyama"
msgid "I'll see what I can do."
msgstr "Veré que puedo hacer."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "680_Kamiyama"
msgid "I finished! It's not the prettiest thing in the world, but what it lacks in beauty, it makes up for with power."
msgstr "¡Terminé! No es la cosa mas bonita en el mundo, pero lo que le falta de belleza, lo compensa en poder."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "716_Kamiyama"
msgid "No need to pay me! You've done a lot to help me, after all."
msgstr "¡No hace falta que me pagues! Ya hiciste mucho por mi."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "728_Saejima"
msgid "Great, thanks. I appreciate it."
msgstr "Muchas gracias. En verdad lo aprecio."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "740_Kamiyama"
msgid "Oh, hello. What can I do for you today?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "752_Saejima"
msgid "Hey, I need a pickaxe. Could you make me one from this Super Alloy and Chunk of Wood?"
msgstr "Hola, necesito un pico. ¿Podrias hacerme uno de esta Super Aleación y Trozo de Madera?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "764_Kamiyama"
msgid "This alloy is of such incredible high quality! This is fantastic."
msgstr "Esta aleación es de una excelente calidad. ¡Es fantastico!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "776_Kamiyama"
msgid "I'll see what I can do."
msgstr "Veré que puedo hacer."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "836_Kamiyama"
msgid "I finished! This pickaxe will be able to break through any material."
msgstr "¡Terminé! Este pico será capaz de romper cualquier material."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "872_Kamiyama"
msgid "Oh, no need to pay me! Getting to work with such a fine alloy is a rare treat indeed."
msgstr "¡No tienes que pagarme! Trabajar con una aleacion tan fina es un gran regalo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "884_Saejima"
msgid "Great, thanks. I appreciate it."
msgstr "Muchas gracias. En verdad lo aprecio."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "896_Kamiyama"
msgid "Hey, you're here. I make weapons here. They'll be real helpful in battle, promise."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "908_Kamiyama"
msgid "Also, if you have the right materials, I can make you new weapons."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "920_Kamiyama"
msgid "Oh, here, take this. It's a recipe. It's like a blueprint. Without one of these, I can't make anything."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=5
#. y4:msg_location=T2.P5
#. y4:msg_speaker=Equipment Modding
#. y4:msg_speaker_id=2
msgctxt "956_Kamiyama"
msgid "You can modify your weapons, gear, and accessories here."
msgstr ""

msgctxt "968_Kamiyama"
msgid "Start by getting all the required items. Then, make a selection on the Mod menu to modify equipped items.\\r\n"
"\\r\n"
"You will need a <Color:255,255,0,255>design from a book or DVD<Color:Default>, a <Color:255,255,0,255>weapon or piece of equipment<Color:Default> to mod, <Color:255,255,0,255>materials<Color:Default> with which to complete the mod, and the <Color:255,255,0,255>funds<Color:Default> to cover Kamiyama's costs."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=7
#. y4:msg_location=T2.P7
msgctxt "980_Kamiyama"
msgid "To check the required weapons and materials, open the Pause Menu, then navigate to the Items screen and look for books and DVDs with designs under Valuables."
msgstr ""

