#. y4:msg_speaker_id=10
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Refuse
msgctxt "1584_Kiryu"
msgid "I don't have time for this. You'll have to deal with it yourself."
msgstr "No tengo tiempo para esto. Tendrás que encargarte tú mismo."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
