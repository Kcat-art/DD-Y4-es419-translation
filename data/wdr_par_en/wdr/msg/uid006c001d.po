#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So basically, you don't like stupid men.
msgctxt "13128_Akiyama"
msgid "And that makes you dislike yourself?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=31
