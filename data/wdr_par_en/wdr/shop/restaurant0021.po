#. y4:file_status=untranslated
#. y4:last_translator=sasha

#. y4:line_status=translated
msgctxt "492"
msgid "Quit"
msgstr "Salir"

#. y4:line_status=translated
msgctxt "497"
msgid "Cancel the order."
msgstr "Cancelar el pedido."

#. y4:line_status=translated
msgctxt "515"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=translated
msgctxt "521"
msgid "Order the currently selected item."
msgstr "Pagar el objeto seleccionado actualmente."

#. y4:line_status=translated
msgctxt "556"
msgid "(I haven't picked anything.)"
msgstr "(No he escogido nada)"

#. y4:line_status=translated
msgctxt "585"
msgid "(I'm short on cash.)"
msgstr "(Me hace falta dinero)"

#. y4:line_status=translated
msgctxt "606"
msgid "Thank you. Your total comes to %s."
msgstr "Gracias. El precio total es de %s."

#. y4:line_status=translated
msgctxt "641"
msgid "(I can't eat anymore...)"
msgstr "(No puedo comer más...)"

#. y4:line_status=translated
msgctxt "684"
msgid "Tofu handmade from the finest organic soybeans.\nSavor that rich, natural flavor."
msgstr "Tofu hecho a mano con la mejor soja orgánica.\nSaborea ese rico, sabor natural."

#. y4:line_status=translated
msgctxt "765"
msgid "One of our most popular items. The contrast of crispy\nskin and juicy meat is just to die for."
msgstr "Uno de nuestros artículos más populares. El contraste de la piel crujiente\ncon la carne jugosa está para morirse."

#. y4:line_status=translated
msgctxt "859"
msgid "This fluffy omelet has the rich flavor of grated yam\nand fermented soybeans, finished with a fresh sauce."
msgstr "Este omelet esponjoso tiene el rico sabor de ñame rallado\ny soja fermentada, acabado con una salsa fresca."

#. y4:line_status=translated
#. y4:translated_by=sasha
msgctxt "965"
msgid "Fresh Hokkaido mackerel slow-grilled to preserve its\ntrue flavor."
msgstr "Macarela fresco de Hokkaido asado lentamente para\npreservar su verdadero sabor."

#. y4:line_status=translated
msgctxt "1031"
msgid "Meatballs made from only the juiciest ground beef. \nTry dipping them in egg yolk and our special sauce."
msgstr "Albondigas hechas solo con la carne de res molida más jugosa.\nPrueba sumergirlas en yema de huevo y nuestra salsa especial."

#. y4:line_status=translated
msgctxt "1135"
msgid "Plenty of organic vegetables topped with crab salad.\nYou can really taste the freshness."
msgstr "Muchas verduras orgánicas cubiertas con ensalada de cangrejo.\nRealmente puedes saborear la frescura."

#. y4:line_status=translated
msgctxt "1224"
msgid "Home-made dumplings, bite-sized and easy to eat."
msgstr "Empanadillas caseras, del tamaño de un bocado y fáciles de comer."

#. y4:line_status=translated
msgctxt "1273"
msgid "Five varieties of fish will let you enjoy all the flavors of\nthe season and the sea."
msgstr "Cinco variedades de pescado te permitirán disfrutar de\ntodos los sabores de la temporada y del mar."

#. y4:line_status=translated
msgctxt "1358"
msgid "Tomato pizza with thick bacon slices. The slow-cooked\ntomato garlic sauce really kicks it up a notch."
msgstr "Pizza de tomate con gruesas lonchas de tocino. La salsa de\ntomate y ajo cocinada a fuego lento le da un gran sabor."

#. y4:line_status=translated
msgctxt "1460"
msgid "Fried rice cooked in a stone bowl. The shark fin sauce\npulls it all together, but don't worry. We don't use real\nshark fins."
msgstr "Arroz frito cocinado en un tazón de piedra. La salsa de aleta\nde tiburón lo une todo, pero no te preocupes. No utilizamos\naletas de tiburón reales."

#. y4:line_status=translated
msgctxt "1585"
msgid "The rich chocolate fondant and flavorful green tea ice\ncream are the perfect match."
msgstr "El rico fondant de chocolate y el sabroso helado de té\nverde son la combinación perfecta."

