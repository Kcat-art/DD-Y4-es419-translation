#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=A pure and innocent woman.
msgctxt "5100_Chihiro"
msgid "Really!? Wow!"
msgstr "¡¿Oh, de verdad?! ¡Guau!"

