#. y4:msg_location=T6.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "6336_Kiryu"
msgid "Why the gorilla?"
msgstr "¿Por qué el gorila?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
