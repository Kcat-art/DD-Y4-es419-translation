#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a positive way to look at things.
msgctxt "8808_Rio"
msgid "Hm, never thought of it like that before. I guess it's not negative..."
msgstr "Hm, nunca lo había pensado de esa manera. Supongo que no es negativo..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
