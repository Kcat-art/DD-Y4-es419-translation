#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I sort of understand what you mean.
msgctxt "8724_Rio"
msgid "Hehehe. Oh, stop it!"
msgstr "Je, je, je. ¡Oh, para!"

