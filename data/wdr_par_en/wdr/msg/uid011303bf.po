#. y4:msg_branch_target=T1.P10
#. y4:msg_branch_segment=T1.P10..P12
#. y4:msg_branch_target_text=Spirit. That's what's most important. And plannin'? Well, I could give a rat's ass 'bout crap like that.
#. y4:msg_branch_raw=01 11 00 0a 00 00 00 19 00 00 00 00 00 00 00 00
msgctxt "3000_Saejima"
msgid "Spirit is most important."
msgstr ""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=22
