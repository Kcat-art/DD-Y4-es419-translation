msgctxt "116_Man"
msgid "Hey, you sure look like you've been havin' some fun, knockin' back a few drinks and all. But you're not from around here, are ya?"
msgstr "Oye, parece que te has estado divirtiendo un buen rato, tomando unas copas y todo eso. Pero no eres de por aquí, ¿verdad?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
msgctxt "128_Man"
msgid "You got balls to be hangin' out here on our turf, friend!"
msgstr "¡Tienes agallas para andar por aquí en nuestro territorio, amigo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
msgctxt "152_Man"
msgid "You made me realize I was being way too close-minded. Sorry 'bout that."
msgstr "Me hiciste darme cuenta de que estaba siendo demasiado cerrado de mente. Lo siento por eso."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
msgctxt "164_Man"
msgid "Booze is a man's best friend! Drink up, my man, drink up!"
msgstr "¡El alcohol es el mejor amigo del hombre! ¡Bebe, amigo, bebe!"

#. y4:line_status=translated
