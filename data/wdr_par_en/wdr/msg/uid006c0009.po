#. y4:msg_branch_choice=That's a tricky issue.
msgctxt "4824_Kiryu"
msgid "That's a tricky issue. It depends on what the man wants."
msgstr "Es... difícil de explicar. Todo depende de lo que el hombre quiera."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
