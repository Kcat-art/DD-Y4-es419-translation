#. y4:msg_location=T21.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm against it, personally.
msgctxt "15180_Akiyama"
msgid "Remember, I'm always here if you need someone to talk to."
msgstr "Recuerda que siempre estaré aquí si necesitas alguien con quien hablar."

msgctxt "15192_Rio"
msgid "Thank you! That really makes me feel better. <Color:7>♥<Color:Default>"
msgstr "¡Gracias! Eso realmente me hace sentir mejor. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=19
#. y4:msg_location=T21.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It doesn't really matter what I say, does it?
msgctxt "15204_Akiyama"
msgid "It doesn't really matter what I say, does it? You should do whatever you want to do."
msgstr "En realidad no importa lo que yo diga, ¿verdad? Deberías hacer lo que tú quieras hacer."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=20
#. y4:msg_location=T21.P20
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It doesn't really matter what I say, does it?
msgctxt "15216_Rio"
msgid "What? So that's your thought on it? I'm hurt..."
msgstr "¿Qué? ¿Eso es lo que piensa? Estoy dolida..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=21
#. y4:msg_location=T21.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It doesn't really matter what I say, does it?
msgctxt "15228_Akiyama"
msgid "Then let me ask you this. If I told you I didn't want you to do it, would you give up the idea?"
msgstr "Entonces déjame preguntarte esto: si te dijera que no quiero que lo hagas, ¿renunciarías a la idea?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=22
#. y4:msg_location=T21.P22
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It doesn't really matter what I say, does it?
msgctxt "15240_Rio"
msgid "Well, I'm not sure..."
msgstr "Bueno… no estoy segura..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=23
#. y4:msg_location=T21.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It doesn't really matter what I say, does it?
msgctxt "15252_Akiyama"
msgid "Then you should decide on your own."
msgstr "Entonces deberías decidirlo por ti misma."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=24
#. y4:msg_location=T21.P24
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It doesn't really matter what I say, does it?
msgctxt "15264_Rio"
msgid "Okay..."
msgstr "Bueno..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=186
#. y4:msg_phrase=0
#. y4:msg_location=T186.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T21.P25
#. y4:msg_branch_segment=T21.P25..P32
#. y4:msg_branch_target_text=If you're not sure, why don't you just try it?
#. y4:msg_branch_raw=01 11 00 19 00 00 00 2e 00 00 00 00 00 00 00 00
msgctxt "15276_Akiyama"
msgid "If you're not sure, why don't you just try it?"
msgstr "Si no estás segura, ¿por qué no simplemente lo intentas?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=36
#. y4:msg_location=T5.P36
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=How long have you been playing?
msgctxt "15288_Rio"
msgid "Huh?"
msgstr "Uh, ¿y eso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=27
#. y4:msg_location=T21.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=If you're not sure, why don't you just try it?
msgctxt "15300_Akiyama"
msgid "Instead of agonizing over it forever, go and give it a try and then decide if you want to stick with it."
msgstr "En vez de seguir torturándote con la duda, ve y pruébalo. Luego decide si realmente quieres continuar con eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=28
#. y4:msg_location=T21.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=If you're not sure, why don't you just try it?
msgctxt "15312_Akiyama"
msgid "That seems like the fastest solution to me."
msgstr "Esa me parece la solución más rápida."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=29
#. y4:msg_location=T21.P29
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=If you're not sure, why don't you just try it?
msgctxt "15324_Rio"
msgid "Yeah, you might be right."
msgstr "Sí, puede que tenga razón."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=37
#. y4:msg_location=T8.P37
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a positive way to look at things.
msgctxt "15336_Akiyama"
msgid "Exactly."
msgstr "Exacto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=31
#. y4:msg_location=T21.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=If you're not sure, why don't you just try it?
msgctxt "15348_Rio"
msgid "Yes! I'm going to just do it instead of wasting time trying to make up my mind!"
msgstr "¡Sí! ¡Voy a hacerlo, en vez de seguir perdiendo el tiempo intentando tomar una decisión!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=32
#. y4:msg_location=T21.P32
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=If you're not sure, why don't you just try it?
msgctxt "15360_Akiyama"
msgid "That's the spirit."
msgstr "Finalmente te pusiste serio, ¿eh?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=0
#. y4:msg_location=T22.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "15372_Akiyama"
msgid "Hey, whatever happened with that dog that looks like an old man? Is he getting along with your other one?"
msgstr "Oye, ¿qué pasó con ese perro que parece un anciano? ¿Se lleva bien con tu otro perro?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=1
#. y4:msg_location=T22.P1
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "15384_Rio"
msgid "Yep! They're both doing fine. I just taught him how to sit! He's a fast learner."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=2
#. y4:msg_location=T22.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "15396_Akiyama"
msgid "Oh? I guess you can teach an old-looking dog new tricks. Glad to hear it."
msgstr "¿Ah, sí? Supongo que se le pueden enseñar trucos a un perro de aspecto viejo. Me alegra escuchar eso."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=3
#. y4:msg_location=T22.P3
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "15408_Rio"
msgid "Hehe! He's cute, but... Well, he poops while he walks!"
msgstr "¡Jeje! Es adorable, pero… ¡Hace caca mientras camina!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=4
#. y4:msg_location=T22.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "15420_Akiyama"
msgid "He actually moves around?"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=5
#. y4:msg_location=T22.P5
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "15432_Rio"
msgid "Yes! He gets poo all over my apartment!"
msgstr "¡Sí! ¡Hace caca por todo mi apartamento!"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=22
