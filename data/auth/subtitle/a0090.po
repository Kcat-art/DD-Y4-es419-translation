#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1026\t1086"
msgid "Arai-san?"
msgstr "¿Arai-san?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1403\t1463"
msgid "Akiyama-san."
msgstr "Akiyama-san."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1541\t1624"
msgid "You said I had a chance\\nto make it big..."
msgstr "Creo que la oportunidad que\\nestabas tratando de darme..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1659\t1777"
msgid "But I guess it just\\nwasn't meant to be."
msgstr "se me acaba de escapar."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1856\t1916"
msgid "I'll be seeing you."
msgstr "Adiós."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1967\t2027"
msgid "Arai-san!"
msgstr "¡Arai-san!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "2704\t2858"
msgid "One bullet, straight to the head.\\nClean and simple."
msgstr "Una bala directamente a la cabeza.\\nSin disparos adicionales."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2853\t2953"
msgid "No quicker way to bump a guy off."
msgstr "Un tiro con única intención de matar."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "2996\t3091"
msgid "Shouldn't you be running?"
msgstr "¿No deberías estar huyendo?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3126\t3221"
msgid "The perp's the guy who just ran off, yeah?"
msgstr "El culpable es aquel tipo que escapó antes, ¿no?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3236\t3346"
msgid "Do you really want to try\\nexplaining that to the cops?"
msgstr "Si sigues aquí la policía te terminará\\narrestando a ti."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3362\t3422"
msgid "Who are you?"
msgstr "¿Y tú eres?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "3535\t3637"
msgid "I'm guessing you're not yakuza."
msgstr "No eres más que un civil, ¿verdad?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "3650\t3710"
msgid "Well no, but..."
msgstr "Eh. Sí, pero..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "3722\t3834"
msgid "The force is full of nasty characters."
msgstr "La policía está llena de tipos desagradables."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "3850\t3967"
msgid "Some will beat a confession out of you\\njust for shits and giggles."
msgstr "Si te atrapan, de seguro\\nte obligarán a confesar otra verdad."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "3989\t4049"
msgid "Chief!"
msgstr "¡Jefe!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4062\t4122"
msgid "Hana-chan!"
msgstr "¡Hana-chan!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4196\t4256"
msgid "Looks like you're out of time."
msgstr "Parece que se te acabó el tiempo."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4300\t4330"
msgid "Not another step!"
msgstr "¡Quieto!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4341\t4401"
msgid "Wait, me?"
msgstr "¿Eh? ¿Yo?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4405\t4440"
msgid "I said don't move!"
msgstr "¡Te dije que quieto!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4443\t4540"
msgid "Hey, you've got the wrong guy!\\nIt wasn't me!"
msgstr "¡Oi! ¡Tienen al tipo equivocado!\\n¡No fui yo!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4545\t4585"
msgid "Stop struggling!"
msgstr "¡Deja de poner resistencia!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4595\t4753"
msgid "Sugiuchi-san sure loves his interrogations.\\nTry not to sweat too much."
msgstr "De seguro el interrogatorio de Sugiuchi-san será implacable.\\nBuena suerte con ello."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4754\t4814"
msgid "Have fun."
msgstr "Nos vemos."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4813\t4892"
msgid "Sugiuchi? You mean－"
msgstr "¿Sugiuchi? Qué－"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4899\t4981"
msgid "Hey, hold on a sec!"
msgstr "¡Oi, tú, espera!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4993\t5166"
msgid "I'm telling you, it wasn't me!\\nAsk the guy who just ran off! C'mon!"
msgstr "¡Les estoy diciento que no fui yo!\\n¡Pregúntenle al tipo de antes! ¡Vamos!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5152\t5183"
msgid "Chief!"
msgstr "¡Jefe!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5184\t5272"
msgid "Hana-chan!"
msgstr "¡Hana-chan!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5246\t5325"
msgid "<Italic>Chief!</Italic>"
msgstr "<Italic>¡Jefeeeeeeee!</Italic>"

