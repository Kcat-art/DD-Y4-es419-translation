#. y4:msg_branch_target=T11.P10
#. y4:msg_branch_segment=T11.P10..P17
#. y4:msg_branch_target_text=Keep working hard for your fans.
#. y4:msg_branch_raw=01 11 00 0a 00 00 00 20 00 00 00 00 00 00 00 00
msgctxt "8112_Kiryu"
msgid "Keep working hard for your fans."
msgstr "Sigue trabajando duro para tus fans."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=11
#. y4:msg_location=T11.P11
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Keep working hard for your fans.
msgctxt "8124_望月京子：源氏名"
msgid "I will! It's nice to feel needed."
msgstr "¡Lo haré! Se siente bien ser necesitada o tener el apoyo de ellos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=12
#. y4:msg_location=T11.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Keep working hard for your fans.
msgctxt "8136_Kiryu"
msgid "Sure. But it can sometimes be difficult to live up to people's expectations."
msgstr "Seguramente. Pero eso también puede que ser difícil, tienes que cumplir las expectativas de la gente."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=13
#. y4:msg_location=T11.P13
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Keep working hard for your fans.
msgctxt "8148_望月京子：源氏名"
msgid "I don't think I have to worry. I've got a perfect ear for music and solid star potential. But you knew that, right?"
msgstr "No creo que me tenga que preocupar. ¡Tengo uno ido perfecto para la música y potencial increíble para ser una estrella! ¿Pero eso me imagino que ya lo sabías, no?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=14
#. y4:msg_location=T11.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Keep working hard for your fans.
msgctxt "8160_Kiryu"
msgid "Right."
msgstr "Ya veo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=15
#. y4:msg_location=T11.P15
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Keep working hard for your fans.
msgctxt "8172_望月京子：源氏名"
msgid "Hey, aren't you gonna tell me I should be more modest?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=16
#. y4:msg_location=T11.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Keep working hard for your fans.
msgctxt "8184_Kiryu"
msgid "Oh, I thought you were being serious..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=17
#. y4:msg_location=T11.P17
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Keep working hard for your fans.
msgctxt "8196_望月京子：源氏名"
msgid "Haha. Even I'm not that full of myself."
msgstr ""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=155
#. y4:msg_phrase=0
#. y4:msg_location=T155.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T11.P18
#. y4:msg_branch_segment=T11.P18..P26
#. y4:msg_branch_target_text=So some of your fans are high school kids?
#. y4:msg_branch_raw=01 11 00 12 00 00 00 2a 00 00 00 00 00 00 00 00
msgctxt "8208_Kiryu"
msgid "So some of your fans are high school kids?"
msgstr "¿Así que algunos chicos de secundaria son fans?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=19
#. y4:msg_location=T11.P19
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So some of your fans are high school kids?
msgctxt "8220_望月京子：源氏名"
msgid "Yeah. We have plenty of fans who are in high school."
msgstr "Así es. Tenemos muchos fans que son de secundaria."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=20
#. y4:msg_location=T11.P20
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So some of your fans are high school kids?
msgctxt "8232_望月京子：源氏名"
msgid "Some of my lyrics are about my experiences when I was a teenager, so I guess they can identify with my songs."
msgstr "Algunas de mis letras son de mis experiencias cuando era adolescente, y eso creo que los identifica mis canciones."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=21
#. y4:msg_location=T11.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So some of your fans are high school kids?
msgctxt "8244_Kiryu"
msgid "I see... I hope you're not a bad influence on them."
msgstr "Ya veo... Espero que no sea una mala influencia para ellos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=22
#. y4:msg_location=T11.P22
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So some of your fans are high school kids?
msgctxt "8256_望月京子：源氏名"
msgid "Hey! What kind of things do you think I write about?"
msgstr "¡Ey! ¿Qué clase de letras piensas que escribo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=23
#. y4:msg_location=T11.P23
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So some of your fans are high school kids?
msgctxt "8268_望月京子：源氏名"
msgid "I went through the same things any adolescent kid did. Love, pain, confusion..."
msgstr "Pase por las mismas cosas que un adolescente. Amor, dolor, confusión..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=24
#. y4:msg_location=T11.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So some of your fans are high school kids?
msgctxt "8280_Kiryu"
msgid "So which lyrics are we talking about, exactly?"
msgstr "Entonces... ¿Sobre qué letra estamos hablando, exactamente?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=25
#. y4:msg_location=T11.P25
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So some of your fans are high school kids?
msgctxt "8292_望月京子：源氏名"
msgid "That's a secret. They're too embarrassing."
msgstr "Es un secreto... Me es vergonzoso contarlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=17
#. y4:msg_location=T1.P17
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Take good care of it.
msgctxt "8304_Kiryu"
msgid "Heh..."
msgstr "Je..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=156
#. y4:msg_phrase=0
#. y4:msg_location=T156.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T11.P27
#. y4:msg_branch_segment=T11.P27..P33
#. y4:msg_branch_target_text=It's ironic to think of you as cupid.
#. y4:msg_branch_raw=01 11 00 1b 00 00 00 25 00 00 00 00 00 00 00 00
msgctxt "8316_Kiryu"
msgid "It's ironic to think of you as cupid."
msgstr "Me es irónico pensarte como cupido."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=28
#. y4:msg_location=T11.P28
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It's ironic to think of you as cupid.
msgctxt "8328_望月京子：源氏名"
msgid "What's that supposed to mean, Kiryu-san?"
msgstr "¿Qué me estás queriendo decir, Kiryu-san?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=29
#. y4:msg_location=T11.P29
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It's ironic to think of you as cupid.
msgctxt "8340_Kiryu"
msgid "You brought these kids together when your own love life needs a lot more attention."
msgstr "Reuniste a estos cuando tu vida amorosa necesita más atención."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=30
#. y4:msg_location=T11.P30
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It's ironic to think of you as cupid.
msgctxt "8352_望月京子：源氏名"
msgid "Okay, you've got me there. I'm the one who could sure use a cupid."
msgstr "Entiendo... Yo soy la única a la que le vendría bien un cupido."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=31
#. y4:msg_location=T11.P31
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It's ironic to think of you as cupid.
msgctxt "8364_Kiryu"
msgid "Maybe I could help. I know a lot of guys."
msgstr "Yo podría serlo. Conozco a muchos chicos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=32
#. y4:msg_location=T11.P32
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It's ironic to think of you as cupid.
msgctxt "8376_望月京子：源氏名"
msgid "Does that mean you have no interest in me, Kiryu-san? That makes me sad..."
msgstr "¿Me estás diciendo que no tienes interés en mí, Kiryu-san? Qué triste..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=24
#. y4:msg_location=T1.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You want me to buy you a new one?
msgctxt "8388_Kiryu"
msgid "......"
msgstr "......"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=0
#. y4:msg_location=T12.P0
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "8400_望月京子：源氏名"
msgid "I've been having writer's block recently. I can't seem to come up with any good songs."
msgstr "He tenido hace poco un bloqueo de escritor. No se me ocurre nada para una canción."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=1
#. y4:msg_location=T12.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "8412_Kiryu"
msgid "That's too bad."
msgstr "Eso es... una pena."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=2
#. y4:msg_location=T12.P2
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "8424_望月京子：源氏名"
msgid "It used to come so naturally. The lyrics and melody would just pop into my head."
msgstr "Era algo que me salía natural. Las letras y las melodías solo venían a mi cabeza."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=3
#. y4:msg_location=T12.P3
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "8436_望月京子：源氏名"
msgid "But now, even playing my guitar doesn't help. I can't come up with anything decent."
msgstr "Pero ahora, incluso tocar la guitarra no me ayuda. No se me ocurre algo decente para tocar."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=4
#. y4:msg_location=T12.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "8448_Kiryu"
msgid "That happens sometimes."
msgstr "Eso pasa a veces."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=5
#. y4:msg_location=T12.P5
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "8460_望月京子：源氏名"
msgid "But I'm worried that I'll never be able to write another song."
msgstr "Pero me preocupa no poder escribir ninguna canción nunca más."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=6
#. y4:msg_location=T12.P6
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=12
#. y4:msg_decision_choices=1. I think you're just too busy. -> T12.P7 | 2. You need a change of pace. -> T12.P13 | 3. Stop complaining. -> T12.P20
msgctxt "8472_望月京子：源氏名"
msgid "Maybe I already used up all my talent..."
msgstr "Tal vez agote todo mi talento..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=7
#. y4:msg_location=T12.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I think you're just too busy.
msgctxt "8484_Kiryu"
msgid "I think you're just too busy. After all, you play in the band and work at the club."
msgstr "Creo que te estás cargando de muchas cosas. Después de todo, tocas en una banda y trabajas aquí en el club."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=8
#. y4:msg_location=T12.P8
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I think you're just too busy.
msgctxt "8496_望月京子：源氏名"
msgid "You might be right... I haven't been able to relax much these days."
msgstr "Puede que tengas razón... No me tome un día en mucho tiempo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=9
#. y4:msg_location=T12.P9
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I think you're just too busy.
msgctxt "8508_望月京子：源氏名"
msgid "It's no good if my job at the club gets in the way of my music. Maybe I should quit and work on the band full time."
msgstr "No es bueno que mi camino a ser música sea interrumpida por mi trabajo en el club. Capaz deba dejar el club e ir con la banda a tiempo completo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=10
#. y4:msg_location=T12.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I think you're just too busy.
msgctxt "8520_Kiryu"
msgid "Even if you do that, you shouldn't push yourself too hard. Your brain can't work properly if you don't give it time to rest."
msgstr "Incluso si lo haces, no debes esforzarte demasiado. Tu cerebro debe descansar para andar con todas las energías."

msgctxt "8532_望月京子：源氏名"
msgid "Right. Thanks for worrying about me. You're so sweet,\\r\n"
" Kiryu-san. <Color:7>♥<Color:Default>"
msgstr "Tienes razón. Gracias por preocuparme por mí. Eres muy lindo,\\r\n"
" Kiryu-san. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=12
#. y4:msg_location=T12.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I think you're just too busy.
msgctxt "8544_Kiryu"
msgid "Don't mention it."
msgstr "No hace falta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=13
#. y4:msg_location=T12.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You need a change of pace.
msgctxt "8556_Kiryu"
msgid "You need a change of pace. You could branch out, try to find things that would get your creative juices flowing."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=14
#. y4:msg_location=T12.P14
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You need a change of pace.
msgctxt "8568_望月京子：源氏名"
msgid "Come to think of it, I haven't seen a movie in a long time. That could help."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=15
#. y4:msg_location=T12.P15
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You need a change of pace.
msgctxt "8580_望月京子：源氏名"
msgid "And I wouldn't mind taking a stroll through an art museum."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=16
#. y4:msg_location=T12.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You need a change of pace.
msgctxt "8592_Kiryu"
msgid "We could go together."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=17
#. y4:msg_location=T12.P17
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You need a change of pace.
msgctxt "8604_望月京子：源氏名"
msgid "That sounds an awful lot like a date. You can't fool me that easily."
msgstr ""

msgctxt "8616_望月京子：源氏名"
msgid "But I appreciate you worrying about me. <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=19
#. y4:msg_location=T12.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You need a change of pace.
msgctxt "8628_Kiryu"
msgid "Heh, sure thing."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=20
#. y4:msg_location=T12.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Stop complaining.
msgctxt "8640_Kiryu"
msgid "Stop complaining. It's not like you."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=21
#. y4:msg_location=T12.P21
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Stop complaining.
msgctxt "8652_望月京子：源氏名"
msgid "I think I have the right to complain once in a while. I am only human, you know."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=22
#. y4:msg_location=T12.P22
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Stop complaining.
msgctxt "8664_Kiryu"
msgid "Yes, but what are the members of your band going to think if you start talking like that?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=23
#. y4:msg_location=T12.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Stop complaining.
msgctxt "8676_Kiryu"
msgid "A leader has to be strong, or their organization can't function."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=24
#. y4:msg_location=T12.P24
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Stop complaining.
msgctxt "8688_望月京子：源氏名"
msgid "That's easy for you to say, but..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=25
#. y4:msg_location=T12.P25
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Stop complaining.
msgctxt "8700_望月京子：源氏名"
msgid "Look, you're a guy. Maybe that's the way things work for men. But women deal with things differently. You can't expect me to be exactly like you."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=24
#. y4:msg_location=T1.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You want me to buy you a new one?
msgctxt "8712_Kiryu"
msgid "......"
msgstr "......"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=27
#. y4:msg_location=T12.P27
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Stop complaining.
msgctxt "8724_望月京子：源氏名"
msgid "What am I gonna do?"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=0
#. y4:msg_location=T13.P0
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "8736_望月京子：源氏名"
msgid "I think a guy has to be able to fight to really be a man, don't you think so?"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=1
#. y4:msg_location=T13.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "8748_Kiryu"
msgid "Not necessarily. You have to have heart, too. That's the most important muscle of all."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=2
#. y4:msg_location=T13.P2
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "8760_望月京子：源氏名"
msgid "I know what you mean. There are lots of good fighters who are jerks. But I do think a man has to be able to hold his own, too!"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=3
#. y4:msg_location=T13.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "8772_Kiryu"
msgid "Yeah, but there's really more to it than that..."
msgstr ""

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=4
#. y4:msg_location=T13.P4
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=13
#. y4:msg_decision_choices=1. I'm nothing special. -> T13.P5 | 2. Everybody tries to pick fights with me. -> T13.P11 | 3. I'm a pacifist, so I try to avoid fighting. -> T13.P19
msgctxt "8784_望月京子：源氏名"
msgid "You look pretty tough, Kiryu-san. Are you a good fighter?"
msgstr ""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=160
#. y4:msg_phrase=0
#. y4:msg_location=T160.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T13.P5
#. y4:msg_branch_segment=T13.P5..P10
#. y4:msg_branch_target_text=I'm nothing special.
#. y4:msg_branch_raw=01 11 00 05 00 00 00 14 00 00 00 00 00 00 00 00
msgctxt "8796_Kiryu"
msgid "I'm nothing special."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=6
#. y4:msg_location=T13.P6
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm nothing special.
msgctxt "8808_望月京子：源氏名"
msgid "Oh, come on now. You're just being modest! I bet you've cracked a few heads in your time."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=7
#. y4:msg_location=T13.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm nothing special.
msgctxt "8820_Kiryu"
msgid "I don't really keep track of that kind of thing."
msgstr ""

msgctxt "8832_望月京子：源氏名"
msgid "That's so cool! A real man doesn't make a big deal about how strong he is. <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=9
#. y4:msg_location=T13.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm nothing special.
msgctxt "8844_Kiryu"
msgid "It's really what's on the inside that counts. There's nothing wrong with being able to fight, but knowing when not to fight is far more important."
msgstr ""

msgctxt "8856_望月京子：源氏名"
msgid "Huh. You're not just some run-of-the-mill thug, are you?\\r\n"
"I think I'm getting to like you more and more. <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=161
#. y4:msg_phrase=0
#. y4:msg_location=T161.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T13.P11
#. y4:msg_branch_segment=T13.P11..P18
#. y4:msg_branch_target_text=Everybody tries to pick fights with me.
#. y4:msg_branch_raw=01 11 00 0b 00 00 00 27 00 00 00 00 00 00 00 00
msgctxt "8868_Kiryu"
msgid "Everybody tries to pick fights with me."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=12
#. y4:msg_location=T13.P12
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Everybody tries to pick fights with me.
msgctxt "8880_望月京子：源氏名"
msgid "I thought so. What do you do when that happens?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=13
#. y4:msg_location=T13.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Everybody tries to pick fights with me.
msgctxt "8892_Kiryu"
msgid "I oblige them. I can't just run away. I punish them and I don't stop until they apologize."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=14
#. y4:msg_location=T13.P14
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Everybody tries to pick fights with me.
msgctxt "8904_望月京子：源氏名"
msgid "If you're so strong, couldn't you let them go after a bit? You don't have to beat them to a pulp."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=15
#. y4:msg_location=T13.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Everybody tries to pick fights with me.
msgctxt "8916_Kiryu"
msgid "Hey, they're the ones who picked a fight with me."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=16
#. y4:msg_location=T13.P16
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Everybody tries to pick fights with me.
msgctxt "8928_望月京子：源氏名"
msgid "Are you sure you don't just enjoy beating people up? Because that's not true strength."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=17
#. y4:msg_location=T13.P17
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Everybody tries to pick fights with me.
msgctxt "8940_望月京子：源氏名"
msgid "I hate people like that."
msgstr ""

#. y4:msg_type=branch_dialogue
