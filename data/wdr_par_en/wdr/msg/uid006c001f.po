#. y4:msg_location=T0.P25
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're just saying that.
msgctxt "4380_Noa"
msgid "Huh? Why?"
msgstr "¿Eh? ¿Por qué?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're just saying that.
msgctxt "4392_Akiyama"
msgid "Because it makes me think you might like me. You shouldn't lead me on."
msgstr "Porque entonces significa que te lo estás tomando en serio, y empezaría a pensar: \"Eh, esta chica tiene interés en mí\"."

msgctxt "4404_Noa"
msgid "Hehe! It's only leading you on if it's not true. <Color:7>♥<Color:Default>"
msgstr "¡Je, je! ¿Y por qué sería malo pensar eso? <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
