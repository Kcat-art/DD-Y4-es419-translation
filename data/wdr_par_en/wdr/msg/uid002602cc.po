#. y4:msg_location=T0.P55
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Be more open.
msgctxt "1136_Akiyama"
msgid "Let's see..."
msgstr "Veamos..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=56
#. y4:msg_location=T0.P56
#. y4:msg_speaker=Miki
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Be more open.
msgctxt "1148_Miki"
msgid "Okay, I'll have..."
msgstr "Bueno, voy a querer..."

#. y4:line_status=translated
msgctxt "1160_Akiyama"
msgid "Not so fast. There's a little trick when it comes to\\r\nordering, too."
msgstr "No te apresures. Hay un pequeño truco a la hora de\\r\nordenar comida, también."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=58
#. y4:msg_location=T0.P58
#. y4:msg_speaker=Miki
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Be more open.
msgctxt "1172_Miki"
msgid "There is?"
msgstr "¿Lo hay?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=59
#. y4:msg_location=T0.P59
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Be more open.
msgctxt "1184_Akiyama"
msgid "Of course."
msgstr "No se preocupe."

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=0
#. y4:msg_phrase=60
#. y4:msg_location=T0.P60
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=6
#. y4:msg_decision_group=5
#. y4:msg_decision_choices=1. Ask for your favorite dish. -> T0.P61 | 2. Ask for his favorite dish. -> T0.P68
msgctxt "1196_Akiyama"
msgid "(When it comes time to order...)"
msgstr "(Cuando llega el momento de ordenar...)"

#. y4:line_status=translated
msgctxt "1208_Akiyama"
msgid "When you go out to eat on a date, always order your favorite\\r\ndish."
msgstr "Cuando estés en una cita, siempre debes\\r\nordenar tu comida favorita."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=62
#. y4:msg_location=T0.P62
#. y4:msg_speaker=Miki
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Be more open.
msgctxt "1220_Miki"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:line_status=translated
msgctxt "1232_Akiyama"
msgid "Yep. Hostesses order what they like. It's a fundamental\\r\nrule."
msgstr "Sí, Las hostesses piden lo que a ellas les gusta.\\r\nEs una regla esencial."

#. y4:line_status=translated
msgctxt "1244_Miki"
msgid "I don't imagine the guy would mind too much, but I don't see\\r\nhow it could have much of a positive effect on the evening,\\r\neither..."
msgstr "Me imagino que a la otra persona no le importaría\\r\ndemasiado, pero, no veo como eso sería algo\\r\npositivo..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
