#. y4:msg_speaker_id=2
msgctxt "11052_松岡里緒奈：源氏名"
msgid "And for making you pretend to be my boyfriend."
msgstr "Y por hacerte fingir ser mi novio."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=2
#. y4:msg_location=T19.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "11064_Kiryu"
msgid "Don't worry about it."
msgstr "No hay de que."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=3
#. y4:msg_location=T19.P3
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "11076_松岡里緒奈：源氏名"
msgid "I got an email from her after we left, you know. She couldn't say enough nice things about you."
msgstr "Recibí un correo electrónico de ella después de que nos fuimos, ya sabes. No podía dejar de decir cosas buenas sobre ti."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=4
#. y4:msg_location=T19.P4
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "11088_松岡里緒奈：源氏名"
msgid "She said you were polite and very handsome!"
msgstr "¡Dijo que eras educado y muy guapo!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=5
#. y4:msg_location=T19.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "11100_Kiryu"
msgid "Hehe. That's nice to hear."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
