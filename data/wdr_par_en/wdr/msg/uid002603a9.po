#. y4:line_status=translated
msgctxt "128_Rabble Rouser"
msgid "What are you gonna do, spew another long-winded speech?\\r\nJust give it up already."
msgstr "¿Qué vas a hacer, soltar otro largo sermón?\\r\nRíndete ya."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Suited Gentleman
#. y4:msg_speaker_id=2
msgctxt "140_Suited Gentleman"
msgid "Enough already! Your idle threats don't intimidate me."
msgstr "¡Basta ya! Tus amenazas vacías no me intimidan."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Rabble Rouser
#. y4:msg_speaker_id=0
msgctxt "152_Rabble Rouser"
msgid "That was me asking nicely. You won't like not-so-nice."
msgstr "Yo lo pedí amablemente. Pero habrá otros que no serán amables."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
msgctxt "164_Saejima"
msgid "Hey, c'mon. What're ya doing?"
msgstr "Vamos. ¿Qué tratas de hacer?"

#. y4:line_status=translated
msgctxt "176_Rabble Rouser"
msgid "Uh-oh, here comes trouble. Look, Numai-san, take my advice\\r\nand pack it in for today. Got it?"
msgstr "Oh-oh, huele a problemas. Mira, Numai, hazme un favor, y\\r\ndéjalo ya por hoy. ¿Entendiste?"

#. y4:line_status=translated
msgctxt "188_Common Thug"
msgid "You never know when these political extremists will snap,\\r\nmaybe even take down an innocent bystander or two..."
msgstr "Nunca se sabe cuándo estos políticos extremistas vayan a estallar,\\r\ntal vez incluso acabarán con inocentes..."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
msgctxt "200_Numai"
msgid "Why, I..."
msgstr "¿Por qué?..."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
msgctxt "296_Saejima"
msgid "Friggin' kids these days... You alright?"
msgstr "Estos mocosos de hoy en día... ¿Te encuentras bien?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
msgctxt "308_Numai"
msgid "Yes, I think so. Thank you very much. You're a lifesaver."
msgstr "Sí, eso creo. Muchísimas gracias. Eres mi salvador."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=16
#. y4:msg_location=T1.P16
#. y4:msg_speaker=?
#. y4:msg_speaker_id=10
msgctxt "320_?"
msgid "Sir!"
msgstr "¡Señor!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=17
#. y4:msg_location=T1.P17
#. y4:msg_speaker=Suited Woman
#. y4:msg_speaker_id=11
msgctxt "332_Suited Woman"
msgid "Sir, are you all right!?"
msgstr "¿¡Señor, se encuentra bien!?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=18
#. y4:msg_location=T1.P18
#. y4:msg_speaker=Suited Woman
#. y4:msg_speaker_id=11
msgctxt "344_Suited Woman"
msgid "Another hired thug? We've had enough of your interference!"
msgstr "¿Otro matón a sueldo? ¡Ya estamos cansados de que interfieran!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=19
#. y4:msg_location=T1.P19
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
msgctxt "356_Saejima"
msgid "What're ya talkin' about?"
msgstr "¿De qué está hablando?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=20
#. y4:msg_location=T1.P20
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
msgctxt "368_Numai"
msgid "No, Hirauchi-kun, on the contrary! This man was helping me."
msgstr "¡No, Hirauchi-kun, al contrario! Este hombre me ayudó."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=21
#. y4:msg_location=T1.P21
#. y4:msg_speaker=Hirauchi
#. y4:msg_speaker_id=14
msgctxt "380_Hirauchi"
msgid "Oh?"
msgstr "Oh..."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=28
#. y4:msg_location=T1.P28
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
msgctxt "464_Saejima"
msgid "So you're a politician, huh?"
msgstr "Conque eres un político, ¿eh?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=29
#. y4:msg_location=T1.P29
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
msgctxt "476_Numai"
msgid "My name's Numai. I deeply apologize for my aide's gross misunderstanding."
msgstr "Me llamo Numai. Me disculpo profundamente por el malentendido causado por mi ayudante."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=30
#. y4:msg_location=T1.P30
#. y4:msg_speaker=Hirauchi
#. y4:msg_speaker_id=14
msgctxt "488_Hirauchi"
msgid "Please forgive me."
msgstr "Por favor, discúlpeme."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=31
#. y4:msg_location=T1.P31
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
msgctxt "500_Saejima"
msgid "It's alright. I know I don't much look like the average upstandin' citizen."
msgstr "Está todo bien. Sé que mi apariencia no ayuda mucho."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=32
#. y4:msg_location=T1.P32
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
msgctxt "512_Saejima"
msgid "Does that kid come by here just to heckle ya?"
msgstr "¿Ese niño viene por aquí solo para molestar?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=33
#. y4:msg_location=T1.P33
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
msgctxt "524_Numai"
msgid "Yes. This part of Kamurocho is under my electoral district."
msgstr "Sí. Esta parte de Kamurocho está dentro de mi distrito electoral."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=34
#. y4:msg_location=T1.P34
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
msgctxt "536_Numai"
msgid "I've been giving public speeches here, but lately it seems I've been attracting the wrong kind of attention."
msgstr "He estado dando discursos públicos aquí, pero últimamente parece que he estado atrayendo la atención de indeseables."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=35
#. y4:msg_location=T1.P35
#. y4:msg_speaker=Hirauchi
#. y4:msg_speaker_id=14
msgctxt "548_Hirauchi"
msgid "It's a conspiracy!"
msgstr "¡Es una conspiración!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=36
#. y4:msg_location=T1.P36
#. y4:msg_speaker=Hirauchi
#. y4:msg_speaker_id=14
msgctxt "560_Hirauchi"
msgid "A rival has been sending these hired protesters after you."
msgstr "Un rival ha estado enviando a estos manifestantes a sueldo tras de ti."

#. y4:line_status=translated
msgctxt "572_Numai"
msgid "Hirauchi-kun! I won't have you spreading baseless rumors\\r\nabout a respected political opponent."
msgstr "¡Hirauchi-kun! No toleraré que difundas rumores infundados\\r\nsobre un respetado oponente político."

#. y4:line_status=translated
msgctxt "584_Hirauchi"
msgid "But, sir－!"
msgstr "¡Pero, señor - !"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=39
#. y4:msg_location=T1.P39
#. y4:msg_speaker=?
#. y4:msg_speaker_id=10
msgctxt "596_?"
msgid "Well, well, well. If it isn't Numai-san."
msgstr "Vaya, vaya, vaya. Sí es nada más y nada menos que Numai-san."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=40
#. y4:msg_location=T1.P40
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
msgctxt "608_Numai"
msgid "Oh. Hello, Shirakawa-sensei."
msgstr "Oh. Hola, Shirakawa-sensei."

#. y4:line_status=translated
msgctxt "620_Shirakawa"
msgid "Are you speaking here today? You certainly do work hard...\\r\nor do you hardly work? Haha! I kid, I kid."
msgstr "¿Darás un discurso? Veo que trabajas muy duro...\\r\n¡Tan duro que estas temblando! ¡Ja, ja! Solo bromeo."

#. y4:line_status=translated
msgctxt "632_Numai"
msgid "Without the strong constituency you enjoy, Shirakawa-san,\\r\nI have to focus on more grassroots efforts."
msgstr "Sin el fuerte electorado del que usted disfruta, Shirakawa-san,\\r\nYo debo centrarme en cuestiones más ordinarias."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=43
#. y4:msg_location=T1.P43
#. y4:msg_speaker=Shirakawa
#. y4:msg_speaker_id=17
msgctxt "644_Shirakawa"
msgid "That's just fine. When I was younger, I worked my way up by doing the same. But, you know..."
msgstr "Eso está muy bien. Cuando era más joven, me abrí camino haciendo lo mismo. Pero, ya sabes..."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=44
#. y4:msg_location=T1.P44
#. y4:msg_speaker=Shirakawa
#. y4:msg_speaker_id=17
msgctxt "656_Shirakawa"
msgid "Youngsters these days have no stomach for real debate. If you try to make too many waves, the rabble will have it out for you."
msgstr "Los jóvenes de hoy en día no aguantan un debate de verdad. Si intentas hacer demasiados movimientos, la chusma se enfada contigo.\n"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=45
#. y4:msg_location=T1.P45
#. y4:msg_speaker=Shirakawa
#. y4:msg_speaker_id=17
msgctxt "668_Shirakawa"
msgid "One wrong word could spell the end of your political career."
msgstr "Una palabra equivocada puede significar el fin de tu carrera."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=46
#. y4:msg_location=T1.P46
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
msgctxt "680_Numai"
msgid "I suppose..."
msgstr "Supongo que sí..."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=47
#. y4:msg_location=T1.P47
#. y4:msg_speaker=Shirakawa
#. y4:msg_speaker_id=17
msgctxt "692_Shirakawa"
msgid "Well, I'm sure you still have a bright future ahead. Do your best and the wheels of democracy will turn just fine. Take care, now..."
msgstr "Seguro que aún te queda un brillante futuro por delante. Haz lo mejor que puedas y las ruedas de la democracia girarán bien. Cuídese..."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=49
#. y4:msg_location=T1.P49
#. y4:msg_speaker=Hirauchi
#. y4:msg_speaker_id=14
msgctxt "716_Hirauchi"
msgid "See? I just know he's behind this! How many times have I told you as much?"
msgstr "¿Lo ves? ¡Sé que él está detrás de esto! ¿Cuántas veces te lo tengo que decir?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=50
#. y4:msg_location=T1.P50
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
msgctxt "728_Saejima"
msgid "Who was that windbag?"
msgstr "¿Quién era ese charlatán?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=51
#. y4:msg_location=T1.P51
#. y4:msg_speaker=Hirauchi
#. y4:msg_speaker_id=14
msgctxt "740_Hirauchi"
msgid "Councilman Masumi Shirakawa. Numai-sensei will be going head to head against him in the next election into the Diet!"
msgstr "Concejal Masumi Shirakawa. Numai-sensei se enfrentará a él en las próximas elecciones."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=52
#. y4:msg_location=T1.P52
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
msgctxt "752_Numai"
msgid "Please, Hirauchi-kun, don't go accusing Shirakawa-sensei without proof! I'm sure he'd never even consider doing such a thing."
msgstr "¡Por favor, Hirauchi-kun, no vayas acusando a Shirakawa-sensei sin pruebas! Estoy seguro de que él nunca consideraría hacer tal cosa."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=53
#. y4:msg_location=T1.P53
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
msgctxt "764_Saejima"
msgid "Ya really trust that Shirakawa guy, huh?"
msgstr "Realmente confías en ese Shirakawa, ¿eh?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=54
#. y4:msg_location=T1.P54
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
msgctxt "776_Numai"
msgid "Why, I idolize Shirakawa-sensei. He entered politics at a young age and has accomplished a great deal since then."
msgstr "Yo idolatro a Shirakawa-sensei. Entró en la política desde muy joven y ha conseguido mucho desde entonces."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=55
#. y4:msg_location=T1.P55
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
msgctxt "788_Numai"
msgid "He and I may be political rivals, but I can't even imagine him doing anything so underhanded."
msgstr "Puede que él y yo seamos rivales políticos, pero no me lo imagino haciendo algo tan corrupto."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=56
#. y4:msg_location=T1.P56
#. y4:msg_speaker=Hirauchi
#. y4:msg_speaker_id=14
msgctxt "800_Hirauchi"
msgid "Sensei..."
msgstr "Señor..."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=57
#. y4:msg_location=T1.P57
#. y4:msg_speaker=Hirauchi
#. y4:msg_speaker_id=14
msgctxt "812_Hirauchi"
msgid "Why give campaign speeches if they're going to keep causing all this trouble?"
msgstr "¿Para qué dar discursos de campaña si van a seguir causando todos estos problemas?"

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=58
#. y4:msg_location=T1.P58
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Good luck out there. -> T1.P59 | 2. I'll be your lookout. -> T1.P66
msgctxt "824_Saejima"
msgid "(Sounds like they're bein' harassed by some hired thugs.)"
msgstr "(Parece que están siendo acosados por matones a sueldo.)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=59
#. y4:msg_location=T1.P59
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Good luck out there.
msgctxt "836_Saejima"
msgid "Must be rough, but try not to let a few punks bring ya down. Welp, good luck out there."
msgstr "Debe ser duro, pero no dejen que un par de payasos los \\r\ndesanimen. Bueno, buena suerte."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=60
#. y4:msg_location=T1.P60
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Good luck out there.
msgctxt "848_Numai"
msgid "Thank you very much! As long as I have even a single supporter, I'll keep fighting to be the people's politician!"
msgstr "¡Muchísimas gracias! ¡Mientras tenga un solo simpatizante \\r\nseguiré luchando por ser el político del pueblo!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=66
#. y4:msg_location=T1.P66
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll be your lookout.
msgctxt "920_Saejima"
msgid "I'll be your lookout, if ya like."
msgstr "Puedo ser tu vigía, si quieres."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=67
#. y4:msg_location=T1.P67
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll be your lookout.
msgctxt "932_Numai"
msgid "Oh, but I couldn't impose on you like that."
msgstr "Oh, pero no puedo obligarte hacer algo así."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=68
#. y4:msg_location=T1.P68
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll be your lookout.
msgctxt "944_Saejima"
msgid "I just wanna lend a helpin' hand to a guy who could use one."
msgstr "Solo quiero echar una mano a alguien que podría necesitarla."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=69
#. y4:msg_location=T1.P69
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll be your lookout.
msgctxt "956_Numai"
msgid "Really? Well, if you don't mind, then I'd appreciate it."
msgstr "¿De verdad? Bueno, si no te molesta, lo agradecería."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=70
#. y4:msg_location=T1.P70
#. y4:msg_speaker=Numai
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll be your lookout.
msgctxt "968_Numai"
msgid "But please, try not to do anything too rash..."
msgstr "Pero por favor, intenta no hacer algo muy precipitado..."

