#. y4:msg_branch_choice=Are you sure you can handle being a teacher?
msgctxt "4644_Kiryu"
msgid "I think I'll pass..."
msgstr "Mejor paso, gracias."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
