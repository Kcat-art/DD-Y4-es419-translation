#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=9
#. y4:msg_decision_choices=1. Definitely. -> T1.P74 | 2. That ain't likely. -> T1.P79 | 3. Not by winnin' alone. -> T1.P84
msgctxt "2772_Ehama"
msgid "...will children look up to me?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=74
#. y4:msg_location=T1.P74
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2784_Saejima"
msgid "You're sure to be popular. Just like yer idol, the Ferocious Tiger."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=75
#. y4:msg_location=T1.P75
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2796_Ehama"
msgid "Really!? You really think so? If I become like the Ferocious Tiger one day... It would be a dream come true!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=76
