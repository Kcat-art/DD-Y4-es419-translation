#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Consistent Loser
#. y4:msg_speaker_id=0
msgctxt "84_Consistent Loser"
msgid "Aw man, I still wanna play pachinko, but I've gotta go to work now... And the pachinko place will be closed by the time I get off."
msgstr "Maldita sea, quiero jugar pachinko, pero tengo que trabajar... Y cuando salga van a cerrar."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Stay-at-Home Pachinko Player
#. y4:msg_speaker_id=2
msgctxt "96_Stay-at-Home Pachinko Player"
msgid "Why don't you try 777 Town, then? It's the best way to play away from the parlor!"
msgstr "¿Entonces por qué no pruebas 777 Town? ¡Es la mejor manera de jugar sin necesidad de ir al lugar!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Consistent Loser
#. y4:msg_speaker_id=0
msgctxt "108_Consistent Loser"
msgid "777 Town? What's that?"
msgstr "¿777 Town? ¿Y eso qué es?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Stay-at-Home Pachinko Player
#. y4:msg_speaker_id=2
msgctxt "120_Stay-at-Home Pachinko Player"
msgid "With 777 Town, you can play pachinko or slots on your PC! They've got over one hundred types of machines, too!"
msgstr "¡Con 777 Town puedes jugar pachinko o tragamonedas en tu PC! ¡Tienen más de cien tipos de máquinas disponibles!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Consistent Loser
#. y4:msg_speaker_id=0
msgctxt "132_Consistent Loser"
msgid "You can play as much as you want on over one hundred machines? Seriously!?"
msgstr "¿Puedes jugar todo lo que quieras en más de cien máquinas? ¡¿En serio?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Stay-at-Home Pachinko Player
#. y4:msg_speaker_id=2
msgctxt "144_Stay-at-Home Pachinko Player"
msgid "And you can play from your phone, too. Pretty sweet, don'tcha think?"
msgstr "Y también puedes jugar desde tu celular. Está genial, ¿no crees?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Consistent Loser
#. y4:msg_speaker_id=0
msgctxt "156_Consistent Loser"
msgid "I gotta check this out! Man... Screw work! It's time for me to get back to pachinko full-time!"
msgstr "¡Tengo que probar eso! Demonios... ¡Al diablo con el trabajo! ¡Es hora de volverle al pachinko con todo!"

