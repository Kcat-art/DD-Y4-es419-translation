#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "266\t359"
msgid "Those are my terms."
msgstr "Esos serían los términos."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "369\t494"
msgid "If you don't pass the test,\\nI'm afraid I can't offer you the loan."
msgstr "Si no pasas la prueba,\\nme temo que no podremos darte el préstamo."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "562\t652"
msgid "And about the ten days you mentioned."
msgstr "Y sobre los diez días que mencionaste..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "654\t789"
msgid "You really need the money that soon?"
msgstr "¿Realmente necesitas el dinero con tanta ungencia?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "811\t852"
msgid "I do."
msgstr "Sí."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "853\t913"
msgid "Pretty big hurry, huh?"
msgstr "Tienes prisa, ¿no?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "946\t1031"
msgid "Yes. That's right."
msgstr "Sí. Así es."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1058\t1234"
msgid "But if you don't pass my test,\\nyou'll have wasted some of that precious time."
msgstr "Pero si no pasas la prueba,\\ntodo habrá sido una pérdida de tiempo para ti."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1255\t1374"
msgid "What do you think?\\nStill want to give it a shot?"
msgstr "¿Estás bien con eso?\\n¿Aún así quieres hacer la prueba?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1862\t1914"
msgid "Yes."
msgstr "Sí."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1915\t1972"
msgid "I have to try."
msgstr "Déjeme intentarlo."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "2008\t2096"
msgid "And you're really sure?"
msgstr "¿Estás realmente segura?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "2201\t2298"
msgid "This is the only option I have left."
msgstr "Esta es la única opción que me queda."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "2374\t2429"
msgid "So please."
msgstr "Así que, por favor."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "2440\t2566"
msgid "Let me take your test."
msgstr "Déjeme tomar esa prueba."

