msgctxt "92_Akiyama"
msgid "Sky Finance. Akiyama speaking."
msgstr "Habla Akiyama de Sky Finance."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Nishihama
#. y4:msg_speaker_id=2
msgctxt "104_Nishihama"
msgid "Akiyama-san? I got a call from the kidnapper."
msgstr "Akiyama-san, ¿es usted? Acabo de recibir una llamada de los\n"
"secuestradores..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "116_Akiyama"
msgid "And... Where's he want to make the exchange?"
msgstr "Mmm..., ¿dónde le pidieron entregar el dinero? "

msgctxt "128_Nishihama"
msgid "Park Boulevard... There's a taxi stand by the Kamurocho\\r\n"
"Hills construction site."
msgstr "En el bulevar del parque, por Kamurocho Hills... Me pidieron\n"
"ir a la parada de taxis que está al lado."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "140_Akiyama"
msgid "A taxi stand?"
msgstr "¿Una parada de taxis?"

msgctxt "152_Nishihama"
msgid "Yeah, he said to put the money in a cab. Then he'll tell me\\r\n"
"where my daughter is."
msgstr "Sí, me indicó que pusiera el dinero en un taxi, y que luego\n"
"me daría la ubicación de mi hija."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "164_Akiyama"
msgid "I see. Okay, then. Let's meet in front of the Millennium Tower?"
msgstr "Perfecto. Entonces, ¿nos encontramos en la Torre Millennium?"

msgctxt "176_Talk_Phone_st"
msgid "I'll bring the money right over. Come to the lockers on\\r\n"
"Taihei Boulevard."
msgstr "Traeré el dinero enseguida. Por favor, dirigete a los casilleros\\r\n"
"del bulevar Taihei."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Nishihama
#. y4:msg_speaker_id=2
msgctxt "188_Nishihama"
msgid "Sure... I'll see you there."
msgstr "Estaré allí... ¡Muchas gracias!"

msgctxt "248_Akiyama"
msgid "A taxi stand, huh? Wonder if the kidnapper's muzzled the\\r\n"
"guy..."
msgstr "Así que una parada de taxis... ¿El secuestrador no le habrá\\r\n"
"ordenado guardar silencio?"
