msgctxt "112_Elise Manager"
msgid "Hello, Akiyama-san."
msgstr "Buenas, Akiyama-san."

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "124_Akiyama"
msgid "Yo. I thought I'd drop in and check on the club. How are\\r\nthings?"
msgstr "Yo. Estaba cerca, así que decidí pasarme por el club. ¿Cómo va todo?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "136_Elise Manager"
msgid "Remarkably well, given the state of the economy."
msgstr "Considerando esta horrible economía, diría que increíblemente bien."

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "148_Akiyama"
msgid "Really? That's good to hear."
msgstr "¿De verdad? Qué bien."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu2nd
msgctxt "160_Elise Manager"
msgid "But..."
msgstr "Pero..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "172_Akiyama"
msgid "But what?"
msgstr "¿Pero qué?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu2nd
msgctxt "184_Elise Manager"
msgid "Well, it's Miki..."
msgstr "Se trata de Miki..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "196_Akiyama"
msgid "What about her?"
msgstr "¿Qué pasa con ella?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "208_Elise Manager"
msgid "Maybe you'd better ask her yourself. She's in today."
msgstr "Ella está aquí hoy. Sería mejor que le preguntases tú mismo."

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "220_Akiyama"
msgid "All right. Have her stop by the dressing room."
msgstr "De acuerdo. Dile que vaya al vestuario."

