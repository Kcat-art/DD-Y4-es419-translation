#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "3960_Akiyama"
msgid "Hey, Rio-chan, can I ask you something? You're a college student, right?"
msgstr "Oye, Rio-chan, ¿puedo preguntarte algo? Eres universitaria, ¿verdad?"

msgctxt "3972_Rio"
msgid "Nope! Hehe. ♪"
msgstr "¡Nop! Jeje. ♪"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "3984_Akiyama"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "3996_Rio"
msgid "I'm currently taking a break from college."
msgstr "Me estoy tomando un descanso de la universidad a decir verdad."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "4008_Akiyama"
msgid "Oh, I didn't know that... Did you take a break just for this job?"
msgstr "Vaya, no estaba al tanto... ¿Te tomaste un descanso solo por este trabajo?"

msgctxt "4020_Rio"
msgid "Yep! ♪"
msgstr "¡Sip! ♪"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "4032_Akiyama"
msgid "So what got you started in this line of work?"
msgstr "¿Por qué empezaste a trabajar aquí?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "4044_Rio"
msgid "The club was recruiting new girls, and one of my friends asked me to go with her to see what it was like. I decided I might like to try it, too."
msgstr "El club estaba reclutando chicas nuevas y una de mis amigas me pidió que la acompañara para ver cómo era. Decidí que a mí también me gustaría probar."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. So what do you think now that you're doing it? -> T0.P9 | 2. What about it interested you? -> T0.P23 | 3. You're a little different from the other girls. -> T0.P30
msgctxt "4056_Rio"
msgid "Before that though, I'd always been intrigued by the idea of being a hostess."
msgstr "Aunque antes de aquello, siempre había sentido curiosidad por la idea de ser hostess."

