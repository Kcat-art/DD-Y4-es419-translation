#. y4:line_status=translated
msgctxt "168_Shizuka"
msgid "Wow! We won!"
msgstr "¡Guau! ¡Ganamos!"

#. y4:line_status=translated
#. y4:translated_by=Crazy56
msgctxt "180_Shizuka"
msgid "It's so cool how you're so good at golf! <Color:255,200,200,255>♥<Color:Default>"
msgstr "¡Es genial que seas tan bueno jugando al golf!  <Color:255,200,200,255>♥<Color:Default>"

#. y4:line_status=translated
#. y4:translated_by=Crazy56
msgctxt "192_Shizuka"
msgid "Ask me out again sometime, okay? Let's win again next time! <Color:255,200,200,255>♥<Color:Default>"
msgstr "Invítame a salir de nuevo algún día, ¿de acuerdo? ¡Ganaremos otra vez! <Color:255,200,200,255>♥<Color:Default>"

#. y4:line_status=translated
msgctxt "252_Shizuka"
msgid "Hooray! We won a prize!"
msgstr "¡Hurra! ¡Ganamos un premio!"

#. y4:line_status=translated
msgctxt "264_Shizuka"
msgid "Next time, we've definitely gotta win!"
msgstr "¡La próxima vez, tenemos que ganar sí o sí!"

#. y4:line_status=translated
#. y4:translated_by=Crazy56
msgctxt "276_Shizuka"
msgid "I hope you'll invite me out again sometime! <Color:255,200,200,255>♥<Color:Default>"
msgstr "¡Espero que me invites a salir de nuevo! <Color:255,200,200,255>♥<Color:Default>"

#. y4:line_status=translated
#. y4:translated_by=Crazy56
msgctxt "336_Shizuka"
msgid "That was fun! ♪ I hope you'll invite me out again sometime! <Color:255,200,200,255>♥<Color:Default>"
msgstr "¡Qué divertido! ♪ ¡Espero que me invites a salir de nuevo! <Color:255,200,200,255>♥<Color:Default>"

#. y4:line_status=translated
#. y4:translated_by=Crazy56
msgctxt "396_Shizuka"
msgid "Goodness... You're much too good at this."
msgstr "Dios mío… eres demasiado bueno en esto."

#. y4:line_status=translated
#. y4:translated_by=Crazy56
msgctxt "408_Shizuka"
msgid "But I won't let you get the better of me next time! You'd better be ready for my victory!"
msgstr "¡Pero no dejaré que me ganes la próxima vez! ¡Será mejor que estés preparado para mi victoria!"

#. y4:line_status=translated
msgctxt "420_Shizuka"
msgid "I hope you'll invite me out again, all right?"
msgstr "Espero que me invites a salir de nuevo, ¿de acuerdo?"

#. y4:line_status=translated
#. y4:translated_by=Crazy56
msgctxt "480_Shizuka"
msgid "Looks like we tied. That was a good game!"
msgstr "Parece que empatamos. ¡Fue una gran partida!"

#. y4:line_status=translated
#. y4:translated_by=Crazy56
msgctxt "492_Shizuka"
msgid "I'll beat you next time, though!"
msgstr "¡Te venceré la próxima vez!"

#. y4:line_status=translated
msgctxt "504_Shizuka"
msgid "I hope you'll invite me out again, all right?"
msgstr "Espero que me invites a salir de nuevo, ¿de acuerdo?"

#. y4:line_status=translated
#. y4:translated_by=Crazy56
msgctxt "564_Shizuka"
msgid "I won! Hehe, I was really on a roll today."
msgstr "¡Gané! Hoy sí que tuve suerte je, je, je."

