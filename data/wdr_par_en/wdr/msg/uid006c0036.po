#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So should we make babies?
msgctxt "13584_Kiryu"
msgid "Sorry..."
msgstr "Lo siento..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
