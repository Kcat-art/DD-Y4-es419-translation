msgid "But I didn't bring anything to train in. What should I do?"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
