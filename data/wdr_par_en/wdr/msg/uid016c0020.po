msgid "(I guess she wants me to look in her eyes...)"
msgstr "(Supongo que quiere que la mire a sus ojos...)"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=0
#. y4:msg_location=T22.P0
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1200_Noa"
msgid "You will fall in looove with me. You will fall in looove with me."
msgstr "Te enamoraraaaaas de mí. Te enamoraraaaaas de mí."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=1
#. y4:msg_location=T22.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1212_Akiyama"
msgid "......"
msgstr "......"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=2
#. y4:msg_location=T22.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1224_Noa"
msgid "How do you feel?"
msgstr "¿Cómo se siente?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=3
#. y4:msg_location=T22.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1236_Akiyama"
msgid "Do you seriously think telling me to fall in love with you will work?"
msgstr "¿En serio crees que decirme que me enamore de ti funcionará?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=4
#. y4:msg_location=T22.P4
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1248_Noa"
msgid "What are you talking about?"
msgstr "¿A qué te refieres?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=5
#. y4:msg_location=T22.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1260_Akiyama"
msgid "Don't play dumb. You've been mumbling to yourself this whole time."
msgstr "No te hagas la tonta. Has estado murmurando para ti misma todo este tiempo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=6
#. y4:msg_location=T22.P6
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1272_Noa"
msgid "Oh! You heard that!? Why didn't you say something earlier!? I'm so embarrassed..."
msgstr "¡Oh! ¿¡Ha escuchado eso!? ¿¡Por qué no dijo algo antes!? Estoy tan avergonzada..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=23
#. y4:msg_phrase=0
#. y4:msg_location=T23.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1284_Akiyama"
msgid "What are you saying? It was so soft that I couldn't quite make it out."
msgstr "¿Qué estás diciendo? Lo dijiste tan bajo que no pude entenderlo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=23
#. y4:msg_phrase=1
#. y4:msg_location=T23.P1
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1296_Noa"
msgid "Oh? Hehe, don't worry about that."
msgstr "¿Oh? Je, je, no se preocupe por eso."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=23
#. y4:msg_phrase=2
#. y4:msg_location=T23.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1308_Akiyama"
msgid "Something about love?"
msgstr "¿Algo sobre el amor?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=23
#. y4:msg_phrase=3
#. y4:msg_location=T23.P3
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1320_Noa"
msgid "No, I didn't say anything like that. You must be hearing things."
msgstr "No, no dije nada de eso. Debe estar escuchando cosas."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=23
#. y4:msg_phrase=4
#. y4:msg_location=T23.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1332_Akiyama"
msgid "You sure? It wasn't something about falling in love with you?"
msgstr "¿Estás segura? ¿No era algo sobre enamorarme de ti?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=23
#. y4:msg_phrase=5
#. y4:msg_location=T23.P5
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1344_Noa"
msgid "Hey! You did hear me! You're so mean!"
msgstr "¡Eh! ¡Me ha escuchado! ¡Usted es muy malo!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=5
#. y4:msg_location=T13.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1356_Akiyama"
msgid "Heheh."
msgstr "Je, je, je."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=24
#. y4:msg_phrase=0
#. y4:msg_location=T24.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1368_Akiyama"
msgid "Don't you have to move your fingers in a circle? Like, \"You are getting sleeeeepy...\""
msgstr "¿No tienes que mover los dedos en círculo? Como, \"Te estás quedando dooormidooo...\""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=24
#. y4:msg_phrase=1
#. y4:msg_location=T24.P1
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1380_Noa"
msgid "Haha. I don't wanna put you to sleep."
msgstr "Ja, ja. No quiero hacerlo dormir."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=24
#. y4:msg_phrase=2
#. y4:msg_location=T24.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1392_Akiyama"
msgid "No? Then what were you trying to do?"
msgstr "¿No? Entonces, ¿qué estabas tratando de hacer?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=24
#. y4:msg_phrase=3
#. y4:msg_location=T24.P3
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
