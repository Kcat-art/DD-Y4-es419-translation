#. y4:line_status=translated
msgctxt "114440\tEXPLANATION"
msgid "A coin with \"1000G\" engraved on it. Must be worth quite a bit since it's made of gold."
msgstr "Una moneda con \"1000G\" grabado. Debe valer bastante, ya que está hecha de oro."

#. y4:line_status=translated
msgctxt "114527\tEXPLANATION"
