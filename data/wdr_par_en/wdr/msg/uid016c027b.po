#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=34
#. y4:msg_phrase=0
#. y4:msg_location=T34.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2400_Maya"
msgid "I'm Maya. Nice to meet you."
msgstr "Soy Maya. Encantada de conocerte."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=34
#. y4:msg_phrase=1
#. y4:msg_location=T34.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=27
msgctxt "2412_Tanimura"
msgid "I'm Tanimura."
msgstr "Yo soy Tanimura."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=34
#. y4:msg_phrase=2
#. y4:msg_location=T34.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2424_Maya"
msgid "What do you do for a living?"
msgstr "¿A qué te dedicas?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=34
#. y4:msg_phrase=3
#. y4:msg_location=T34.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=27
msgctxt "2436_Tanimura"
msgid "You girls like asking that question, don't you? I'm a cop."
msgstr "A las chicas les gusta hacer esa pregunta, ¿no? Soy policía."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=34
#. y4:msg_phrase=4
#. y4:msg_location=T34.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2448_Maya"
msgid "You are!?"
msgstr "¡¿En serio?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=34
#. y4:msg_phrase=5
#. y4:msg_location=T34.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=27
msgctxt "2460_Tanimura"
msgid "It's not that surprising, is it? You must get other cops coming here to drink once in a while."
msgstr "No es para tanto, ¿cierto? Seguro que otros policías vienen por aquí a beber de vez en cuando."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=34
#. y4:msg_phrase=6
#. y4:msg_location=T34.P6
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2472_Maya"
msgid "Actually, I get stopped by the police quite often. I even got stopped on my way here today. So yes, I do see a lot of cops."
msgstr "En realidad, la policía me suele detener con frecuencia. Incluso hoy me detuvieron cuando venía. Así que sí, veo un montón de policías."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=34
#. y4:msg_phrase=7
#. y4:msg_location=T34.P7
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=27
msgctxt "2484_Tanimura"
msgid "Heh. Small world."
msgstr "Je, qué pequeño es el mundo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=35
#. y4:msg_phrase=0
#. y4:msg_location=T35.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2496_Maya"
msgid "Did you always want to be a policeman?"
msgstr "¿Siempre quisiste ser policía?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=35
#. y4:msg_phrase=1
#. y4:msg_location=T35.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=27
msgctxt "2508_Tanimura"
msgid "You could say that. My father was a cop, too."
msgstr "Se podría decir que sí. Mi padre también fue policía."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=35
#. y4:msg_phrase=2
#. y4:msg_location=T35.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2520_Maya"
msgid "Wow, that's great! I work as a fashion model when I'm not here."
msgstr "¡Guau, eso es genial! Yo trabajo de modelo cuando no estoy en el club."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=35
#. y4:msg_phrase=3
#. y4:msg_location=T35.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=27
msgctxt "2532_Tanimura"
msgid "That sounds pretty impressive."
msgstr "Oh, eso suena asombroso."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=35
#. y4:msg_phrase=4
#. y4:msg_location=T35.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2544_Maya"
msgid "I've wanted to be a model for so long, it's like a dream come true."
msgstr "He querido ser modelo durante mucho tiempo, es como un sueño hecho realidad."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=35
#. y4:msg_phrase=5
#. y4:msg_location=T35.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=27
msgctxt "2556_Tanimura"
msgid "Do you have a goal as a model? Like appearing in a fashion show overseas or something?"
msgstr "¿Tienes algún propósito como modelo? Algo así como..., ¿ir a un desfile de moda en el extranjero?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=35
#. y4:msg_phrase=6
#. y4:msg_location=T35.P6
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2568_Maya"
msgid "No, I'm just happy to be able to do what I love."
msgstr "Nah, ya soy feliz de poder hacer lo que me gusta."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=35
#. y4:msg_phrase=7
#. y4:msg_location=T35.P7
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=27
msgctxt "2580_Tanimura"
msgid "You're pretty modest, aren't you?"
msgstr "Je, je. Parece que eres muy modesta."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=36
#. y4:msg_phrase=0
#. y4:msg_location=T36.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2592_Maya"
msgid "Were you working again today? You must be tired."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=36
#. y4:msg_phrase=1
#. y4:msg_location=T36.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=27
msgctxt "2604_Tanimura"
msgid "Hmm? Oh, yeah. You could say I'm still on the job, actually."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=36
#. y4:msg_phrase=2
#. y4:msg_location=T36.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2616_Maya"
msgid "Haha! Are you sure it's okay for you to be in a place like this, then?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=36
#. y4:msg_phrase=3
#. y4:msg_location=T36.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=27
msgctxt "2628_Tanimura"
msgid "We'll call it fieldwork. I have to know the conditions on the ground before I can move in and make an arrest, right?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=36
#. y4:msg_phrase=4
#. y4:msg_location=T36.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2640_Maya"
msgid "Hmm? Someone here is breaking the law?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=36
#. y4:msg_phrase=5
#. y4:msg_location=T36.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=27
msgctxt "2652_Tanimura"
msgid "Could be. I wouldn't be doing my job if I didn't give this place a thorough look."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=36
#. y4:msg_phrase=6
#. y4:msg_location=T36.P6
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2664_Maya"
msgid "Hahaha! That's not the most convincing story. I hope you don't get in trouble with your boss."
msgstr ""

msgctxt "2676_Himeka"
msgid "The dialogue will end after one round if you've\\r\n"
"entered a club more than once. Please report when this message is displayed."
msgstr "El diálogo terminará después de una ronda\\r\n"
"cuando entre al club más de una vez. Contacte a un programador si ve este mensaje."

