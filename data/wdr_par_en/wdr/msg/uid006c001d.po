#. y4:msg_location=T0.P19
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=So what do you think now that you're doing it?
msgctxt "4188_Rio"
msgid "That makes sense."
msgstr "Eso tiene sentido."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=So what do you think now that you're doing it?
msgctxt "4200_Akiyama"
msgid "I could tell you really meant what you said from the way you said it."
msgstr "Rio-chan, cuando lo dijiste, se notaba que hablabas en serio. Y eso me encantó."

msgctxt "4212_Rio"
msgid "Hehe! ♪ You really think so, huh?"
msgstr "Je, je, je. ♪ ¿En serio?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
