msgid "Yeah, you see those sometimes. Like people who jump in the bath without washing off first..."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=5
