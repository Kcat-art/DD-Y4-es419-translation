#. y4:item_icon=2d_ys_fish_ika
#. y4:item_field=description
#. y4:item_pair_context=23369
msgctxt "99791"
msgid "A normal squid. Almost transparent while fresh."
msgstr "Un calamar normal. Cuando está fresco es casi transparente."

#. y4:line_status=translated
#. y4:item_index=245
#. y4:item_id=fish_karei
#. y4:item_icon=2d_ys_fish_karei
#. y4:item_field=name
#. y4:item_pair_context=99839
msgctxt "23375"
msgid "Flounder"
msgstr "Lenguado"

#. y4:line_status=translated
#. y4:item_index=245
#. y4:item_id=fish_karei
#. y4:item_icon=2d_ys_fish_karei
#. y4:item_field=description
#. y4:item_pair_context=23375
msgctxt "99839"
msgid "Unlike Hirame flounders, its eyes are to the right. Its white meat is great stewed."
msgstr "A diferencia del Hirame, sus ojos están a la derecha. Su carne blanca sabe genial guisada."

#. y4:line_status=translated
#. y4:item_index=246
#. y4:item_id=fish_madai
#. y4:item_icon=2d_ys_fish_madai
#. y4:item_field=name
#. y4:item_pair_context=99923
msgctxt "23384"
msgid "Sea Bream"
msgstr "Besugo"

#. y4:line_status=translated
#. y4:item_index=246
#. y4:item_id=fish_madai
#. y4:item_icon=2d_ys_fish_madai
#. y4:item_field=description
#. y4:item_pair_context=23384
msgctxt "99923"
msgid "Highly valued since ancient times, the sea bream is regarded as a symbol of luck."
msgstr "Muy codiciados desde tiempos antiguos, el besugo es visto como símbolo de la buena suerte."

#. y4:line_status=translated
#. y4:item_index=247
#. y4:item_id=fish_kasago
#. y4:item_icon=2d_ys_fish_kasago
#. y4:item_field=name
#. y4:item_pair_context=100005
msgctxt "23394"
msgid "Devil Scorpionfish"
msgstr "Pez Escorpión Diablo"

#. y4:line_status=translated
#. y4:item_index=247
#. y4:item_id=fish_kasago
#. y4:item_icon=2d_ys_fish_kasago
#. y4:item_field=description
#. y4:item_pair_context=23394
msgctxt "100005"
msgid "Almost every part of this fish is edible, but take care with its venomous spines."
msgstr "Este pescado es comestible casi en su totalidad, pero cuidado con sus espinas venenosas."

#. y4:line_status=translated
#. y4:item_index=248
#. y4:item_id=fish_kawahagi
#. y4:item_icon=2d_ys_fish_kawahagi
#. y4:item_field=name
#. y4:item_pair_context=100087
msgctxt "23413"
msgid "Thread-sail Filefish"
msgstr "Kawahagi"

#. y4:line_status=translated
#. y4:item_index=248
#. y4:item_id=fish_kawahagi
#. y4:item_icon=2d_ys_fish_kawahagi
#. y4:item_field=description
#. y4:item_pair_context=23413
msgctxt "100087"
msgid "The skin of this fish can be easily peeled off. Its meat and liver are great for various dishes."
msgstr "La piel de este pescado se puede retirar con facilidad. Su carne e hígado se utilizan para varios platos."

#. y4:line_status=translated
#. y4:item_index=249
#. y4:item_id=fish_kurumaebi
#. y4:item_icon=2d_ys_fish_kurumaebi
#. y4:item_field=name
#. y4:item_pair_context=100184
msgctxt "23434"
msgid "Prawn"
msgstr "Camarón"

#. y4:line_status=translated
#. y4:item_index=249
#. y4:item_id=fish_kurumaebi
#. y4:item_icon=2d_ys_fish_kurumaebi
#. y4:item_field=description
#. y4:item_pair_context=23434
msgctxt "100184"
msgid "A large shrimp living in the depths of the bay. A real culinary treat."
msgstr "Una gamba grande que vive en el fondo de la bahía. Una verdadera delicia culinaria."

#. y4:line_status=translated
#. y4:item_index=250
#. y4:item_id=fish_anago
#. y4:item_icon=2d_ys_fish_anago
#. y4:item_field=name
#. y4:item_pair_context=100255
msgctxt "23440"
msgid "Conger Eel"
msgstr "Congrio"

#. y4:line_status=translated
#. y4:item_index=250
#. y4:item_id=fish_anago
#. y4:item_icon=2d_ys_fish_anago
#. y4:item_field=description
#. y4:item_pair_context=23440
msgctxt "100255"
msgid "A long nocturnal fish. Its Japanese name \"anago\" comes from how it lives in holes (\"ana\")."
msgstr "Un pez nocturno y largo. Su nombre en japonés ('Anago') proviene de su costumbre a vivir en agujeros ('ana')."

#. y4:line_status=translated
#. y4:item_index=251
#. y4:item_id=fish_haze
#. y4:item_icon=2d_ys_fish_haze
#. y4:item_field=name
#. y4:item_pair_context=100346
msgctxt "23451"
msgid "Goby"
msgstr "Gobio"

#. y4:line_status=translated
#. y4:item_index=251
#. y4:item_id=fish_haze
#. y4:item_icon=2d_ys_fish_haze
#. y4:item_field=description
#. y4:item_pair_context=23451
msgctxt "100346"
msgid "Japanese goby are fairly small and are said to be easy to catch."
msgstr "El pez gobio japonés es bastante pequeño y se dice que fácil de pescar."

#. y4:line_status=translated
#. y4:item_index=252
#. y4:item_id=fish_drum_can
#. y4:item_icon=2d_ys_fish_drum_can
#. y4:item_field=name
#. y4:item_pair_context=100411
msgctxt "23456"
msgid "Steel Drum"
msgstr "Tambor de Acero"

#. y4:line_status=translated
#. y4:item_index=252
#. y4:item_id=fish_drum_can
#. y4:item_icon=2d_ys_fish_drum_can
#. y4:item_field=description
#. y4:item_pair_context=23456
msgctxt "100411"
msgid "An oil drum that has rusted in the water. It's filled with concrete, so it's very heavy."
msgstr "Un barril de petróleo que se ha oxidado en el agua. Está relleno de hormigón, por lo que pesa mucho."

#. y4:line_status=translated
#. y4:item_index=253
#. y4:item_id=fish_treasure
#. y4:item_icon=2d_ys_fish_treasure
#. y4:item_field=name
#. y4:item_pair_context=100500
msgctxt "23467"
msgid "Bag"
msgstr "Bolsa"

#. y4:line_status=translated
#. y4:item_index=253
#. y4:item_id=fish_treasure
#. y4:item_icon=2d_ys_fish_treasure
#. y4:item_field=description
#. y4:item_pair_context=23467
msgctxt "100500"
msgid "A knapsack with something inside."
msgstr "Una mochila con algo dentro."

#. y4:line_status=translated
#. y4:item_index=254
#. y4:item_id=fish_itou
#. y4:item_icon=2d_ys_fish_itou
#. y4:item_field=name
#. y4:item_pair_context=100534
msgctxt "23471"
msgid "Japanese Huchen"
msgstr "Huchen Japonés"

#. y4:line_status=translated
#. y4:item_index=254
#. y4:item_id=fish_itou
#. y4:item_icon=2d_ys_fish_itou
#. y4:item_field=description
#. y4:item_pair_context=23471
msgctxt "100534"
msgid "A fish so rare that many have never seen it before. Some grow to become quite large."
msgstr "Un pez tan raro que muchos no lo han visto jamás. Algunos crecen bastante."

#. y4:line_status=translated
#. y4:item_index=255
#. y4:item_id=fish_ryugu
#. y4:item_icon=2d_ys_fish_ryugu
#. y4:item_field=name
#. y4:item_pair_context=100619
msgctxt "23487"
msgid "Giant Oarfish"
msgstr "Pez remo gigante"

#. y4:line_status=translated
#. y4:item_index=255
#. y4:item_id=fish_ryugu
#. y4:item_icon=2d_ys_fish_ryugu
#. y4:item_field=description
#. y4:item_pair_context=23487
msgctxt "100619"
