#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=23
#. y4:msg_decision_choices=1. Real life never works out that way. -> T23.P7 | 2. I don't like happy endings. -> T23.P12 | 3. You're pretty cute sometimes. -> T23.P19
msgctxt "12984_Erena"
msgid "So romantic! Don't you just love that kinda thing?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=7
#. y4:msg_location=T23.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Real life never works out that way.
msgctxt "12996_Akiyama"
msgid "Real life never works out that way. If you keep missing each other, you probably won't end up like that."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=8
#. y4:msg_location=T23.P8
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Real life never works out that way.
msgctxt "13008_Erena"
msgid "Why do ya have to be so cynical?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=9
#. y4:msg_location=T23.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Real life never works out that way.
msgctxt "13020_Akiyama"
msgid "Maybe it's because I'm a man, but I've always been that way. Sometimes I want to scream at the screen because the plot's so unrealistic."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=10
#. y4:msg_location=T23.P10
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Real life never works out that way.
msgctxt "13032_Erena"
msgid "If I were watchin' a movie and someone did that, I'd get pretty upset."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=11
#. y4:msg_location=T23.P11
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Real life never works out that way.
msgctxt "13044_Erena"
msgid "I think I need a more romantic type of man."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=12
#. y4:msg_location=T23.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't like happy endings.
msgctxt "13056_Akiyama"
msgid "I don't like happy endings. Maybe I'm just the twisted type."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=13
#. y4:msg_location=T23.P13
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't like happy endings.
msgctxt "13068_Erena"
msgid "Really? What kind of movies do you like?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=14
#. y4:msg_location=T23.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't like happy endings.
msgctxt "13080_Akiyama"
msgid "Well, more realistic stuff, I guess. You know, people doing the best they can, even if it doesn't end well."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=15
#. y4:msg_location=T23.P15
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't like happy endings.
msgctxt "13092_Erena"
msgid "I see. Why do you think you like that?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=16
#. y4:msg_location=T23.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't like happy endings.
msgctxt "13104_Akiyama"
msgid "Maybe it's because of my job. I get to see how lots of different kinds of people live. I know that life can be hard."
msgstr ""

msgctxt "13116_Erena"
msgid "Hmm... That sounds convincing coming from an older gentleman.\\r\n"
" But I think I'll stick with my romantic comedies for the moment."
msgstr ""

#. y4:msg_type=branch_dialogue
