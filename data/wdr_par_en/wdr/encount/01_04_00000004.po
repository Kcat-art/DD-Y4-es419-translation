msgctxt "116_Man"
msgid "Listen, can we talk to you for a sec? Won't take but a moment of your time."
msgstr "Oye, ¿podemos hablar contigo un momento? No te tomará mucho tiempo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
msgctxt "128_Man"
msgid "In fact, if you shut up and hand over your cash, you can be on your way in a flash! So cough it up, pal, before we beat it outta you!"
msgstr "De hecho, si te callas y nos entregas tu dinero, ¡puedes irte en un abrir y cerrar de ojos! ¡Así que suéltalo ya, amigo, antes de que\nte lo saquemos a golpes!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
msgctxt "152_Man"
msgid "Please forgive us. We're very sorry."
msgstr "Por favor, perdónenos. Lo sentimos mucho."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
msgctxt "164_Man"
msgid "Here, take this with our apologies for wastin' your time."
msgstr "Toma, llévate esto con nuestras disculpas por hacerte perder el tiempo."

