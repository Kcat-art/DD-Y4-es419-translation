#. y4:msg_branch_raw=01 11 00 0f 00 00 00 21 00 00 00 00 00 00 00 00
msgctxt "7788_Akiyama"
msgid "Are you going to tell the police?"
msgstr "¿Se lo vas a decir a la policía?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=16
#. y4:msg_location=T10.P16
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you going to tell the police?
msgctxt "7800_Noa"
msgid "I can't. He's a customer. I don't wanna cause trouble for the club."
msgstr "No puedo. Es un cliente. No quiero causarle problemas al club."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=17
#. y4:msg_location=T10.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you going to tell the police?
msgctxt "7812_Akiyama"
msgid "But he's the one causing trouble. The club would want to help you."
msgstr "Pero es él el que causa problemas. El club querría ayudarte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=18
#. y4:msg_location=T10.P18
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you going to tell the police?
msgctxt "7824_Noa"
msgid "Hmm. Okay, I'll talk to the manager."
msgstr "Hmm. Bien, hablaré con el gerente."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=19
#. y4:msg_location=T10.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you going to tell the police?
msgctxt "7836_Akiyama"
msgid "Good idea."
msgstr "Buena idea."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=20
#. y4:msg_location=T10.P20
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you going to tell the police?
msgctxt "7848_Noa"
msgid "I wish all of my customers were like you."
msgstr "Desearía que todos mis clientes fueran como usted."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=21
#. y4:msg_location=T10.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just leave him be.
msgctxt "7860_Akiyama"
msgid "Just leave him be. When he realizes you're with me, he'll give up."
msgstr "Déjalo en paz. Cuando se dé cuenta de que estás conmigo, se rendirá."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=22
#. y4:msg_location=T10.P22
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just leave him be.
msgctxt "7872_Noa"
msgid "But what if something happens?"
msgstr "Pero, ¿qué pasa si algo sucede?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=12
#. y4:msg_location=T2.P12
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You sound like a guy.
msgctxt "7884_Akiyama"
msgid "What do you mean?"
msgstr "¿A qué te refieres?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=24
#. y4:msg_location=T10.P24
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just leave him be.
msgctxt "7896_Noa"
msgid "What if... What if he attacked you?"
msgstr "¿Que pasaría si... ¿Que pasaría si él te atacase?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=25
#. y4:msg_location=T10.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just leave him be.
msgctxt "7908_Akiyama"
msgid "Don't worry about that. If anything did happen, I can take care of myself. Trust me."
msgstr "No se preocupe por eso. Si pasara algo, puedo cuidar de mí misma. Confíe en mí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=26
#. y4:msg_location=T10.P26
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just leave him be.
msgctxt "7920_Noa"
msgid "You can? Oh, I'm still worried. Just be careful."
msgstr "¿Puedes? Oh, todavía estoy preocupado. Solo sé cuidadosa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=27
#. y4:msg_location=T10.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just leave him be.
msgctxt "7932_Akiyama"
msgid "I will."
msgstr "Lo haré."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=0
#. y4:msg_location=T11.P0
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "7944_Noa"
msgid "Haha! You're so funny!"
msgstr "¡Ja, ja! ¡Usted es muy gracioso!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=24
#. y4:msg_location=T2.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=They just like talking to each other like that.
msgctxt "7956_Akiyama"
msgid "......"
msgstr "......"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=1
#. y4:msg_location=T6.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "7968_Noa"
msgid "What? Is something wrong?"
msgstr "¿Pasa algo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=3
#. y4:msg_location=T11.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "7980_Akiyama"
msgid "Not really... But you touch people a lot while you're talking to them."
msgstr "No realmente... Pero tocas mucho a las personas mientras hablas con ellos."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=4
#. y4:msg_location=T11.P4
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "7992_Noa"
msgid "I do?"
msgstr "¿Lo hago?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=5
#. y4:msg_location=T11.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "8004_Akiyama"
msgid "Yeah. You don't even seem to notice it. Maybe you've been doing it with your stalker, too."
msgstr "Sí. Ni siquiera pareces notarlo. Quizás también lo has estado haciendo con tu acosador."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=6
#. y4:msg_location=T11.P6
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "8016_Noa"
msgid "Maybe I have..."
msgstr "Tal vez lo haya hecho..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=7
#. y4:msg_location=T11.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "8028_Akiyama"
msgid "Hmm. That could be part of the problem."
msgstr "Hmm. Eso podría ser parte del problema."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=12
#. y4:msg_location=T2.P12
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You sound like a guy.
msgctxt "8040_Noa"
msgid "What do you mean?"
msgstr "¿A qué te refieres?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=9
#. y4:msg_location=T11.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "8052_Akiyama"
msgid "When a woman touches a man like that, she sends him a pretty strong message. He starts to think she really likes him."
msgstr "Cuando una mujer toca así a un hombre, le envía un mensaje muy fuerte. Empieza a pensar que a ella realmente le gusta."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=10
#. y4:msg_location=T11.P10
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=11
#. y4:msg_decision_choices=1. You have to watch who you're talking to. -> T11.P11 | 2. You shouldn't touch your customers. -> T11.P19 | 3. You have to get rid of that habit. -> T11.P26
msgctxt "8064_Noa"
msgid "He does?"
msgstr "¿Ah, sí?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=11
#. y4:msg_location=T11.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You have to watch who you're talking to.
msgctxt "8076_Akiyama"
msgid "You have to watch who you're talking to, especially if it's a guy who doesn't have much experience with women."
msgstr "Tienes que vigilar con quién hablas, sobre todo si es un tipo que no tiene mucha experiencia con mujeres."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=12
#. y4:msg_location=T11.P12
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You have to watch who you're talking to.
msgctxt "8088_Noa"
msgid "Why is that?"
msgstr "¿Y eso por qué?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=13
#. y4:msg_location=T11.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You have to watch who you're talking to.
msgctxt "8100_Akiyama"
msgid "If a guy usually can't get a girl to give him a second glance, what happens if one suddenly starts holding his hand or touching his shoulder?"
msgstr "Si un chico normalmente no consigue que una chica le de una segunda mirada, ¿qué pasa si de repente una empieza a tomarle la mano o a tocarle el hombro?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=14
#. y4:msg_location=T11.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You have to watch who you're talking to.
msgctxt "8112_Akiyama"
msgid "He gets the wrong idea. I mean, girls don't do that unless they like someone, right?"
msgstr "Se hace una idea equivocada. Quiero decir, las chicas no hacen eso a menos que les guste alguien, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=15
#. y4:msg_location=T11.P15
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You have to watch who you're talking to.
msgctxt "8124_Noa"
msgid "Yeah. Maybe that's what happened with my customer..."
msgstr "Sí. Tal vez eso es lo que pasó con mi cliente..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=16
#. y4:msg_location=T11.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You have to watch who you're talking to.
msgctxt "8136_Akiyama"
msgid "He should be responsible for his own actions, but you might want to be a little more careful."
msgstr "Él debe ser responsable de sus propios actos, pero tú deberías tener un poco más de cuidado."

msgctxt "8148_Noa"
msgid "I will. You're really perceptive. I never would have thought of that. <Color:7>♥<Color:Default>"
msgstr "Lo haré. Usted es muy perceptivo. Nunca se me habria ocurrido eso. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It's probably because I enjoy my work.
msgctxt "8160_Akiyama"
msgid "Heheh."
msgstr "Je, je, je."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=19
#. y4:msg_location=T11.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You shouldn't touch your customers.
msgctxt "8172_Akiyama"
msgid "You shouldn't touch your customers. They'll think it's okay to touch you."
msgstr "No debes tocar a tus clientes. Pensarán que está bien tocarte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=20
#. y4:msg_location=T11.P20
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
