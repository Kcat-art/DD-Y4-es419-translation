#. y4:msg_speaker_id=0
msgctxt "84_Kiryu"
msgid "Hm?"
msgstr "¿Mm?"

#. y4:line_status=translated
msgctxt "96_Shinya"
msgid "What the hell are you doing here!? If someone spots you, my\\r\nwhole plan's gonna get blown outta the water!"
msgstr "¡¿Qué demonios estás haciendo aquí?! Si alguien te ve,\\r\n¡Todo el plan se irá por la borda!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Woman
#. y4:msg_speaker_id=3
msgctxt "108_Woman"
msgid "I know, I know! I just... wanted to see you so bad!"
msgstr "¡Lo sé, lo sé! Sólo... ¡Tenía muchas ganas de verte!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Shinya
#. y4:msg_speaker_id=1
msgctxt "120_Shinya"
msgid "Yeah, whatever. Like that's supposed to make it okay."
msgstr "Sí, lo que sea. Como si fuera que eso ayude ahora."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Shinya
#. y4:msg_speaker_id=1
msgctxt "132_Shinya"
msgid "Fucking shit! Everything's going all wrong!"
msgstr "¡Puta mierda! ¡Todo se fue al carajo!"

#. y4:line_status=translated
msgctxt "144_Shinya"
msgid "A host that loses 5 mil should get his ass kicked to the\\r\ncurb, not coddled like a goddamn toddler!"
msgstr "¡Un host que pierde 5 millones debería recibir una patada en el culo\\r\nque lo vuele a la maldita calle, no que lo mimen como un puto bebé!"

#. y4:line_status=translated
msgctxt "156_Shinya"
msgid "I knew Yuya was spineless, but I didn't realize just how\\r\nmuch of a coward he was."
msgstr "Sabía que Yuya era un tibio, pero jamás me di cuenta de que\\r\nera muy cobarde."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Woman
#. y4:msg_speaker_id=3
msgctxt "168_Woman"
msgid "Shinya-kun... Are you saying I didn't help?"
msgstr "Shinya-kun... ¿Estás diciendo que no ayudé?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Shinya
#. y4:msg_speaker_id=1
msgctxt "180_Shinya"
msgid "What are you, stupid!? You're fucking useless!"
msgstr "¡¿Qué eres, estúpida?! ¡Eres una maldita inútil!"

#. y4:line_status=translated
msgctxt "192_Shinya"
msgid "If Mitsuru doesn't get tossed out on his ass, what the hell\\r\nwas the point in you posing as a customer!?"
msgstr "Si a Mitsuru ni siquiera lo echan, ¡¿de qué demonios\\r\niba a servir eso de que te hicieras pasar por un cliente?!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Woman
#. y4:msg_speaker_id=3
msgctxt "204_Woman"
msgid "Shinya-kun..."
msgstr "Shinya-kun..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Shinya
#. y4:msg_speaker_id=1
msgctxt "216_Shinya"
msgid "Don't \"Shinya-kun\" me!"
msgstr "¡No intentes consolarme así!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=12
#. y4:msg_location=T1.P12
#. y4:msg_speaker=Shinya
#. y4:msg_speaker_id=1
msgctxt "228_Shinya"
msgid "Everywhere I go, it's always Mitsuru this and Mitsuru that! Nobody shuts their mouths about fuckin' Mitsuru!"
msgstr "¡Dondequiera que vaya, siempre es Mitsuru esto y Mitsuru lo otro! ¡Nadie se calla la boca por el puto Mitsuru!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Shinya
#. y4:msg_speaker_id=1
msgctxt "240_Shinya"
msgid "God dammit! There has to be something I can do..."
msgstr "¡Maldita sea! Tiene que haber algo que pueda hacer..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "252_Kiryu"
msgid "Looks like Kazuki was spot on."
msgstr "Parece que Kazuki dio en el clavo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Shinya
#. y4:msg_speaker_id=1
msgctxt "264_Shinya"
msgid "Huh? The hell's your problem, man!?"
msgstr "¿Eh? ¡¿Qué demonios es tu problema, tío?!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=16
#. y4:msg_location=T1.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "276_Kiryu"
msgid "You're Shinya from Stardust, right?"
msgstr "Eres Shinya del Stardust, ¿no?"

#. y4:line_status=translated
msgctxt "288_Shinya"
msgid "Don't know what you're talking about, old man. Now step the\\r\nhell off!"
msgstr "No sé de lo que estás hablando, viejo. ¡Ahora vete\\r\nal diablo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=18
#. y4:msg_location=T1.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "300_Kiryu"
msgid "Look, just cut the crap and come with me."
msgstr "Mira, deja de actuar como un imbécil y ven conmigo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=19
#. y4:msg_location=T1.P19
#. y4:msg_speaker=Woman
#. y4:msg_speaker_id=3
msgctxt "312_Woman"
msgid "Shinya-kun, Shinya-kun! I think he overheard us!"
msgstr "¡Shinya-kun, Shinya-kun! ¡Creo que nos escuchó!"

#. y4:line_status=translated
msgctxt "324_Shinya"
msgid "Yeah? Well, let him hear. I could floor an old bitch like\\r\nthis with just one little punch."
msgstr "¿Sí? Bueno, que siga escuchando. Podría derribar a este viejo sucio con tan solo\\r\nun pequeño golpe."

#. y4:line_status=translated
msgctxt "336_Shinya"
msgid "You hear that, man? You better get lost if you know what's\\r\ngood for you."
msgstr "¿Oyes eso, viejo? Será mejor que te pierdas si sabes lo que es\\r\nBueno para ti."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=22
#. y4:msg_location=T1.P22
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "348_Kiryu"
msgid "Sorry, but I'm not going anywhere. I think you need a little lesson on what it means to be a friendly host."
msgstr "Lo siento, pero no me voy a ir a ninguna parte. Creo que necesitas una pequeña lección sobre lo que significa ser un host amable."

#. y4:line_status=translated
msgctxt "360_Shinya"
msgid "Talk all you want, big man! You're not gonna keep running\\r\nyour mouth once you're six feet under!"
msgstr "¡Habla todo lo que quieras, grandulón! ¡No vas a seguir abriendo\\r\ntu bocota una vez que estés a seis metros bajo tierra!"
