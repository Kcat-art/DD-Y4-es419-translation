#. y4:msg_branch_target=T6.P21
#. y4:msg_branch_segment=T6.P21..P28
#. y4:msg_branch_target_text=You already told me about this.
#. y4:msg_branch_raw=01 11 00 15 00 00 00 1f 00 00 00 00 00 00 00 00
msgctxt "17748_Kiryu"
msgid "You already told me about this."
msgstr "Pero ya me estás hablando de esto."

