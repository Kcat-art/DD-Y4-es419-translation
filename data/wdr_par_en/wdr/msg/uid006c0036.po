#. y4:msg_branch_target_text=Why are you dieting?
#. y4:msg_branch_raw=01 11 00 17 00 00 00 14 00 00 00 00 00 00 00 00
msgctxt "14676_Kiryu"
msgid "Why are you dieting?"
msgstr "¿Por qué estás a dieta?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=24
#. y4:msg_location=T28.P24
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why are you dieting?
msgctxt "14688_松岡里緒奈：源氏名"
msgid "Well, I want to look pretty. Duh!"
msgstr "Pues claro quiero verme bonita. ¡Duh!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=25
#. y4:msg_location=T28.P25
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why are you dieting?
msgctxt "14700_松岡里緒奈：源氏名"
msgid "I am a hostess, you know."
msgstr "Soy una hostess, sabes."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=26
#. y4:msg_location=T28.P26
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why are you dieting?
msgctxt "14712_Kiryu"
msgid "But do the men who request you really want a thin girl?"
msgstr "Pero, ¿los hombres que te solicitan quieren realmente una chica delgada?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=27
#. y4:msg_location=T28.P27
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why are you dieting?
msgctxt "14724_松岡里緒奈：源氏名"
msgid "Huh!? You think they don't!?"
msgstr "¿¡Eh!? ¿¡Crees que no!?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=28
#. y4:msg_location=T28.P28
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why are you dieting?
msgctxt "14736_Kiryu"
msgid "Your most appealing quality is your bright and cheerful personality. If you lose that because you're too hungry, then you've lost everything."
msgstr "Tu cualidad más atractiva es tu personalidad brillante y alegre. Si la pierdes porque tienes demasiada hambre, lo habrás perdido todo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=29
#. y4:msg_location=T28.P29
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why are you dieting?
msgctxt "14748_松岡里緒奈：源氏名"
msgid "So I shouldn't diet?"
msgstr "¿Entonces no debería hacer dieta?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=11
#. y4:msg_location=T10.P11
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=10
#. y4:msg_decision_choices=1. I'm his biggest fan! -> T10.P12 | 2. I'd love to fight him just once. -> T10.P21 | 3. I'm jealous. -> T10.P31
msgctxt "14760_Kiryu"
msgid "That's right."
msgstr "Así es."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=31
#. y4:msg_location=T28.P31
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why are you dieting?
msgctxt "14772_松岡里緒奈：源氏名"
msgid "You do have a point. Okay, I'll stop!"
msgstr "Tienes razón. ¡Está bien, me detendré!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=32
#. y4:msg_location=T28.P32
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why are you dieting?
msgctxt "14784_松岡里緒奈：源氏名"
msgid "So can I order something to eat?"
msgstr "Entonces, ¿puedo pedir algo de comer?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=33
#. y4:msg_location=T28.P33
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why are you dieting?
msgctxt "14796_Kiryu"
msgid "That was a quick turnaround..."
msgstr "Eso fue un cambio de opinion rápido..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=0
#. y4:msg_location=T29.P0
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "14808_松岡里緒奈：源氏名"
msgid "Kiryu-san, I finished moving back home!"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=1
#. y4:msg_location=T29.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "14820_Kiryu"
msgid "You're back with your parents? How are things with your father?"
msgstr "¿Has vuelto con tus padres? ¿Cómo van las cosas con tu padre?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=2
#. y4:msg_location=T29.P2
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "14832_松岡里緒奈：源氏名"
msgid "He yells at me a lot, but now I kind of like it. I know it's strange, but it's comforting to hear it again."
msgstr "Me grita mucho, pero ahora me gusta. Sé que es extraño, pero es reconfortante escucharlo de nuevo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=3
#. y4:msg_location=T29.P3
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "14844_松岡里緒奈：源氏名"
msgid "I'm so happy that everything's cleared up."
msgstr "Estoy muy feliz de que todo se haya aclarado."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=4
#. y4:msg_location=T29.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "14856_Kiryu"
msgid "Are you going to keep working here?"
msgstr "¿Vas a seguir trabajando aquí?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=5
#. y4:msg_location=T29.P5
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "14868_松岡里緒奈：源氏名"
msgid "Yes, for a little while."
msgstr "Sí, por un tiempo."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=6
#. y4:msg_location=T29.P6
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=29
#. y4:msg_decision_choices=1. You've really grown. -> T29.P7 | 2. Don't drag me into your family drama anymore. -> T29.P15 | 3. I need to talk to your father. -> T29.P22
msgctxt "14880_松岡里緒奈：源氏名"
msgid "But Kamuro Pro Wrestling is still in trouble, so I want to help!"
msgstr "Pero Kamuro Pro Wrestling sigue en problemas, ¡así que quiero ayudar!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=7
#. y4:msg_location=T29.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You've really grown.
msgctxt "14892_Kiryu"
msgid "You've really matured. It's like you've become a new woman."
msgstr "Realmente has madurado. Es como si te hubieras convertido en una nueva mujer."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=8
#. y4:msg_location=T29.P8
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You've really grown.
msgctxt "14904_松岡里緒奈：源氏名"
msgid "You think I've grown up?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=9
#. y4:msg_location=T29.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You've really grown.
msgctxt "14916_Kiryu"
msgid "Sure. It makes you even more attractive than before."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=10
#. y4:msg_location=T29.P10
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You've really grown.
msgctxt "14928_松岡里緒奈：源氏名"
msgid "Then maybe I can find myself a better man now!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=11
#. y4:msg_location=T29.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You've really grown.
msgctxt "14940_Kiryu"
msgid "Oh. Is that what you want?"
