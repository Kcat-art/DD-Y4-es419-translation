#. y4:msg_decision_group=29
#. y4:msg_decision_choices=1. That's good news for guys who want to date you. -> T29.P6 | 2. Don't you get tired of eating the same thing? -> T29.P12 | 3. Have you ever tried baking a cake yourself? -> T29.P19
msgctxt "14352_Noa"
msgid "I like simple things best."
msgstr "Me gustan más las cosas simples."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=6
#. y4:msg_location=T29.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's good news for guys who want to date you.
msgctxt "14364_Akiyama"
msgid "That's good news for guys who want to date you. They don't have to take you to fancy restaurants."
msgstr "Es una buena noticia para los chicos que quieren salir contigo. No tienen que llevarte a restaurantes elegantes."

msgctxt "14376_Noa"
msgid "Yep! I don't mind going to fast food places at all. As long as it tastes good, I'm happy. <Color:7>♥<Color:Default>"
msgstr "¡Sí! No me importa en absoluto ir a sitios de comida rápida. Mientras sepa bien, soy feliz. <Color:7>♥<Color:Default>"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
