#. y4:msg_branch_raw=01 11 00 08 00 00 00 31 00 00 00 00 00 00 00 00
msgctxt "15816_Akiyama"
msgid "You should try to be more aware of your behavior."
msgstr "Deberías tratar de ser más consciente de tu comportamiento."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
