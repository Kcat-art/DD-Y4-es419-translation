#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "4584_Erena"
msgid "Um, can I tell you something?"
msgstr "Mm, ¿puedo decirte algo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4596_Akiyama"
msgid "Hm?"
msgstr "¿Mm?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "4608_Erena"
msgid "Oh, never mind. Forget I said anything."
msgstr "No, no importa. Olvídalo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4620_Akiyama"
msgid "Huh? Come on, spit it out."
msgstr "¿Eh? Solo dímelo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "4632_Erena"
msgid "Well, I'm actually seein' someone."
msgstr "Bueno, es que estoy saliendo con alguien."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4644_Akiyama"
msgid "Oh? And you left him back in Kyoto?"
msgstr "¿Ah? ¿Y lo dejaste en Kioto?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "4656_Erena"
msgid "No... He's here."
msgstr "No... Está aquí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4668_Akiyama"
msgid "Oh, did you come to Tokyo to be with him?"
msgstr "Ah, ¿entonces viniste aquí para poder estar con él?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "4680_Erena"
msgid "No. I met him here."
msgstr "No. Lo conocí aquí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4692_Akiyama"
msgid "Really? But I thought you just got here a little while ago."
msgstr "¿En serio? Pensé que llevabas poco tiempo acá."

