#. y4:msg_location=T10.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=They really start that early?
msgctxt "7752_Kiryu"
msgid "They really start that early? How do they know what's going to be popular?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=12
#. y4:msg_location=T10.P12
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=They really start that early?
msgctxt "7764_Maya"
msgid "What? Oh, haha! You don't understand, do you? They don't have to know."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=13
#. y4:msg_location=T10.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=They really start that early?
msgctxt "7776_Kiryu"
msgid "What do you mean?"
msgstr "¿A qué te refieres?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=14
#. y4:msg_location=T10.P14
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=They really start that early?
msgctxt "7788_Maya"
msgid "It's the fashion industry that makes the trends. They decide what's going to be popular before they do the photoshoot."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=15
#. y4:msg_location=T10.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=They really start that early?
msgctxt "7800_Kiryu"
msgid "Oh, I see. You must know what's going to be popular next season, then."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=16
#. y4:msg_location=T10.P16
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=They really start that early?
msgctxt "7812_Maya"
msgid "Yep! That's why models like me are called trendsetters!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=17
#. y4:msg_location=T10.P17
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=They really start that early?
msgctxt "7824_Kiryu"
msgid "Haha."
msgstr "Ja, ja."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=18
#. y4:msg_location=T10.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm surprised you don't get sick.
msgctxt "7836_Kiryu"
msgid "I'm surprised you don't get sick. Wouldn't you catch a cold in the winter?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=19
#. y4:msg_location=T10.P19
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm surprised you don't get sick.
msgctxt "7848_Maya"
msgid "Well, I'm pretty used to it by now. I guess it's not that big of a deal."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=20
#. y4:msg_location=T10.P20
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm surprised you don't get sick.
msgctxt "7860_Maya"
msgid "What's worse is having to get up so early on the day of a shoot."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=21
#. y4:msg_location=T10.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm surprised you don't get sick.
msgctxt "7872_Kiryu"
msgid "That's not so bad. You just have to go to bed early."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=22
#. y4:msg_location=T10.P22
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm surprised you don't get sick.
msgctxt "7884_Maya"
msgid "I do go to bed early! But then I can't go out with my friends. That's the problem."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=23
#. y4:msg_location=T10.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm surprised you don't get sick.
msgctxt "7896_Kiryu"
msgid "Heh. A lot of people have that kind of problem."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=0
#. y4:msg_location=T11.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "7908_Maya"
msgid "Can I ask you something?"
msgstr "Akiyama-san. ¿Puedo preguntarle algo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=1
#. y4:msg_location=T11.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "7920_Kiryu"
msgid "What?"
msgstr "¿Qué?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=2
#. y4:msg_location=T11.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "7932_Maya"
msgid "When two people start going out, it's normal for them to say \"I love you\" to each other, right?"
msgstr "Cuando dos personas empiezan a salir, es normal que se digan \"te amo\", ¿verdad?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=3
#. y4:msg_location=T11.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "7944_Kiryu"
msgid "I'm not sure. In what kind of situation?"
msgstr "No estoy seguro. ¿Y en qué tipo de situación puede suceder?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=4
#. y4:msg_location=T11.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=11
#. y4:msg_decision_choices=1. That's cute. -> T11.P5 | 2. Maybe those lovey-dovey couples do. -> T11.P11 | 3. Is it really necessary to say it? -> T11.P18
msgctxt "7956_Maya"
msgid "Any situation. When you're holding hands, hugging each other, or whatever. People say \"I love you\" pretty often, right?"
msgstr "En cualquier situación. Cuando se dan las manos, cuando se abrazan o lo que sea. La gente dice \"te amo\" muy a menudo, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=5
#. y4:msg_location=T11.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's cute.
msgctxt "7968_Kiryu"
msgid "That's cute. Yeah, some people do that when they first start dating."
msgstr "Eso es lindo. Sí, algunas personas hacen eso cuando empiezan a salir."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=6
#. y4:msg_location=T11.P6
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's cute.
msgctxt "7980_Maya"
msgid "I thought so. I even say it after I've been dating someone for a long time."
msgstr "Eso pensaba yo. Incluso lo digo después de haber estado saliendo con alguien durante mucho tiempo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=7
#. y4:msg_location=T11.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's cute.
msgctxt "7992_Kiryu"
msgid "If you stop saying it, it usually means you're getting tired of them."
msgstr "Si dejas de decirlo, suele significar que estás cansado de ellos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=8
#. y4:msg_location=T11.P8
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's cute.
msgctxt "8004_Maya"
msgid "Yeah. I hate it when I say \"I love you\" and the guy gives some sort of vague response."
msgstr "Sí. Odio cuando digo \"te amo\" y el tipo me da una respuesta vacía."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=9
#. y4:msg_location=T11.P9
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's cute.
msgctxt "8016_Maya"
msgid "You'd say \"I love you, too\" even if you've been dating for a long time, wouldn't you?"
msgstr "Dirías \"yo también te amo\" aunque llevaran mucho tiempo saliendo, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=10
#. y4:msg_location=T11.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's cute.
msgctxt "8028_Kiryu"
msgid "We'll have to wait and see."
msgstr "Tendremos que esperar y ver."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=11
#. y4:msg_location=T11.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe those lovey-dovey couples do.
msgctxt "8040_Kiryu"
msgid "Maybe those lovey-dovey couples do. It's embarrassing to see."
msgstr "Tal vez esas parejas enamoradas lo hacen. Es vergonzoso, de verdad."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=12
#. y4:msg_location=T11.P12
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe those lovey-dovey couples do.
msgctxt "8052_Maya"
msgid "Hmph!"
msgstr "¡Mmpf!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=13
#. y4:msg_location=T11.P13
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe those lovey-dovey couples do.
msgctxt "8064_Maya"
msgid "What's so wrong with being in love!?"
msgstr "¿¡Qué tiene de malo estar enamorada!?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=14
#. y4:msg_location=T11.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe those lovey-dovey couples do.
msgctxt "8076_Kiryu"
msgid "I don't like watching others act like lovesick kids."
msgstr "No me gusta ver a los demás actuar como niños enamorados."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=15
#. y4:msg_location=T11.P15
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe those lovey-dovey couples do.
msgctxt "8088_Maya"
msgid "But if the couple's happy, what's wrong with it? They're not hurting anybody."
msgstr "Pero si la pareja es feliz, ¿qué tiene de malo? No hacen daño a nadie."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=16
#. y4:msg_location=T11.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe those lovey-dovey couples do.
msgctxt "8100_Kiryu"
msgid "It takes more than saying you love someone to be happy, you know."
msgstr "¿Sabes? Hace falta algo más que decir que quieres a alguien para ser feliz."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=17
#. y4:msg_location=T11.P17
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe those lovey-dovey couples do.
msgctxt "8112_Maya"
msgid "You just don't get it, do you?"
msgstr "No lo entiendes, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=18
#. y4:msg_location=T11.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Is it really necessary to say it?
msgctxt "8124_Kiryu"
msgid "Is it really necessary to say it? You don't need words to express how you feel."
msgstr "¿Realmente es necesario decir eso? No necesitas palabras para expresar lo que sientes."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=19
#. y4:msg_location=T11.P19
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Is it really necessary to say it?
msgctxt "8136_Maya"
msgid "Yes, you do!"
msgstr "Sí, ¡totalmente necesario!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=20
#. y4:msg_location=T11.P20
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Is it really necessary to say it?
msgctxt "8148_Maya"
msgid "When you tell each other you love one another, it reaffirms your feelings."
msgstr "Cuando se dicen que se quieren, se reafirman sus propios sentimientos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=21
#. y4:msg_location=T11.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Is it really necessary to say it?
msgctxt "8160_Kiryu"
msgid "You'd be worried if you weren't reassured that you love each other?"
msgstr "¿Estarías preocupado si no te aseguraran que se quieren?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=22
#. y4:msg_location=T11.P22
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Is it really necessary to say it?
msgctxt "8172_Maya"
msgid "Well, no. I didn't mean that, exactly."
msgstr "Bueno, no. No quise decir eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=23
#. y4:msg_location=T11.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Is it really necessary to say it?
msgctxt "8184_Kiryu"
msgid "If you really love another person, being close to them should be enough. You should even feel a connection when you're apart."
msgstr "Si realmente amas a otra persona, estar cerca de ella debería ser suficiente. Incluso deberías sentir una conexión cuando están separados."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's too bad.
msgctxt "8196_Maya"
msgid "Oh."
msgstr "Oh."

msgctxt "8208_Maya"
msgid "Now that you put it that way, I think you might be right. <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=0
#. y4:msg_location=T12.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "8220_Maya"
msgid "Do you remember that policeman who stopped me while we were on our date?"
msgstr "¿Recuerdas al policía que me detuvo mientras estábamos en nuestra cita?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=10
#. y4:msg_location=T3.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're fooling themselves.
msgctxt "8232_Kiryu"
msgid "Yeah."
msgstr "Sí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=2
#. y4:msg_location=T12.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "8244_Maya"
msgid "I ran into him again not long after that."
msgstr "Me encontré con él de nuevo, no mucho después."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=3
#. y4:msg_location=T12.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "8256_Kiryu"
msgid "He questioned you again?"
msgstr "¿Y te interrogó nuevamente?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=4
#. y4:msg_location=T12.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "8268_Maya"
msgid "No. Actually, he was being friendly."
msgstr "No. En realidad, estaba siendo amigable."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=5
#. y4:msg_location=T12.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "8280_Maya"
msgid "He said he was getting off duty soon and asked if I wanted to go for coffee. He was trying to pick me up!"
msgstr "Me dijo que pronto saldría de servicio y me preguntó si quería ir a tomar un cafecito. ¡Intentaba ligar conmigo!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=6
#. y4:msg_location=T12.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "8292_Kiryu"
msgid "Really? I never thought a cop would try something like that while he was on duty."
msgstr "¿¡En serio!? Nunca pensé que un policía haría algo así mientras estaba de servicio."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=7
#. y4:msg_location=T12.P7
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=12
#. y4:msg_decision_choices=1. Don't tell me you like this guy. -> T12.P8 | 2. So you went out with him? Just like that? -> T12.P17 | 3. Sounds like the cops know your face now. -> T12.P23
msgctxt "8304_Maya"
msgid "Hahaha! It was kind of funny, so I let him buy me some."
msgstr "¡Ja, ja, ja! Me hizo gracia, así que le dejé que me comprara algo."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=157
#. y4:msg_phrase=0
#. y4:msg_location=T157.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T12.P8
#. y4:msg_branch_segment=T12.P8..P16
#. y4:msg_branch_target_text=Don't tell me you like this guy.
#. y4:msg_branch_raw=01 11 00 08 00 00 00 20 00 00 00 00 00 00 00 00
msgctxt "8316_Kiryu"
msgid "Don't tell me you like this guy."
msgstr "No me digas que te gusta ese tipo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=9
#. y4:msg_location=T12.P9
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't tell me you like this guy.
msgctxt "8328_Maya"
msgid "Haha! No, not at all."
msgstr "Ja, ja. Para nada."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=10
#. y4:msg_location=T12.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't tell me you like this guy.
msgctxt "8340_Kiryu"
msgid "Then why'd you go out with him?"
msgstr "¿Y por qué saliste con él?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=11
#. y4:msg_location=T12.P11
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't tell me you like this guy.
msgctxt "8352_Maya"
msgid "Huh? I had a little free time, so I thought I'd be nice to him."
msgstr "¿Eh? Tenía tiempo libre, así que pensé en ser amable con él."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=12
#. y4:msg_location=T12.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't tell me you like this guy.
msgctxt "8364_Kiryu"
msgid "What's so fun about going out with somebody you don't even like?"
msgstr "¿Qué tiene de divertido salir con alguien que ni siquiera te gusta?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=13
#. y4:msg_location=T12.P13
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't tell me you like this guy.
msgctxt "8376_Maya"
msgid "Well, it wasn't really much fun. He kept asking all of these questions. Like, did I have a boyfriend?"
msgstr "Bueno, en realidad no fue muy divertido. No paraba de hacer preguntas. Como, ¿tienes novio?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=14
#. y4:msg_location=T12.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't tell me you like this guy.
msgctxt "8388_Kiryu"
msgid "Huh."
msgstr "Ya veo."

msgctxt "8400_Maya"
msgid "It's okay. I won't see him again. You don't have to worry. <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=16
#. y4:msg_location=T12.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't tell me you like this guy.
msgctxt "8412_Kiryu"
msgid "I wasn't really worried..."
msgstr "No estaba preocupado..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=158
#. y4:msg_phrase=0
#. y4:msg_location=T158.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T12.P17
#. y4:msg_branch_segment=T12.P17..P22
#. y4:msg_branch_target_text=So you went out with him? Just like that?
#. y4:msg_branch_raw=01 11 00 11 00 00 00 29 00 00 00 00 00 00 00 00
msgctxt "8424_Kiryu"
msgid "So you went out with him? Just like that?"
msgstr "¿Así que saliste con él? ¿Así sin más?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=18
#. y4:msg_location=T12.P18
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So you went out with him? Just like that?
msgctxt "8436_Maya"
msgid "Why not? He's a cop. I figured I'd at least be safe."
msgstr "¿Por qué no? Es policía. Pensé que al menos estaría segura."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=19
#. y4:msg_location=T12.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So you went out with him? Just like that?
msgctxt "8448_Kiryu"
msgid "There are bad cops too, you know. I wouldn't trust a guy who asks a girl out while on duty."
msgstr "También hay policías malos. Yo no confiaría en un tipo que invita a salir a una chica mientras está de servicio."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=20
#. y4:msg_location=T12.P20
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So you went out with him? Just like that?
msgctxt "8460_Maya"
msgid "You're right, but I'm a big girl. I can take care of myself."
msgstr "Tienes razón, pero soy una chica grande. Soy capaz de cuidarme sola."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=21
#. y4:msg_location=T12.P21
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So you went out with him? Just like that?
msgctxt "8472_Maya"
msgid "You're not my father. You don't have protect me, okay?"
msgstr "No eres mi papá. No tienes que protegerme, ¿de acuerdo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=29
#. y4:msg_location=T1.P29
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a tricky issue.
msgctxt "8484_Kiryu"
msgid "......"
msgstr "......"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=159
#. y4:msg_phrase=0
#. y4:msg_location=T159.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T12.P23
#. y4:msg_branch_segment=T12.P23..P31
#. y4:msg_branch_target_text=Sounds like the cops know your face now.
#. y4:msg_branch_raw=01 11 00 17 00 00 00 28 00 00 00 00 00 00 00 00
msgctxt "8496_Kiryu"
msgid "Sounds like the cops know your face now."
msgstr "Ahora parece que los policías te conocen."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=24
#. y4:msg_location=T12.P24
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Sounds like the cops know your face now.
msgctxt "8508_Maya"
msgid "Yeah, I guess so."
msgstr "Supongo que sí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=25
#. y4:msg_location=T12.P25
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Sounds like the cops know your face now.
msgctxt "8520_Kiryu"
msgid "Maybe you won't be stopped that much anymore."
msgstr "Quizá ya no te paren tanto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=26
#. y4:msg_location=T12.P26
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Sounds like the cops know your face now.
msgctxt "8532_Maya"
msgid "Hmph. I'd rather be questioned by the cops than hit on."
msgstr "Mmm. Prefiero que la policía me interrogue a que me coqueteen."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=27
#. y4:msg_location=T12.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Sounds like the cops know your face now.
msgctxt "8544_Kiryu"
msgid "Yeah, I can understand that."
msgstr "Sí, lo puedo entender."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=28
#. y4:msg_location=T12.P28
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Sounds like the cops know your face now.
msgctxt "8556_Maya"
msgid "But he's the only one who's tried to pick me up. The other ones still just question me."
msgstr "Pero es el único que ha intentado ligar conmigo. Los demás siguen limitándose a interrogarme."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=29
#. y4:msg_location=T12.P29
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Sounds like the cops know your face now.
msgctxt "8568_Kiryu"
msgid "Hmm. You sure you're not a wanted woman?"
msgstr "Mmm, ¿estás segura de que no eres una fugitiva?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=30
#. y4:msg_location=T12.P30
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Sounds like the cops know your face now.
msgctxt "8580_Maya"
msgid "Who knows? Maybe I've got a price on my head!"
msgstr "¿Quién sabe? ¡Tal vez mi cabeza tiene un precio!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=31
#. y4:msg_location=T12.P31
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Sounds like the cops know your face now.
msgctxt "8592_Maya"
msgid "I really don't understand why they question me so often, though."
msgstr "Sin embargo, no entiendo por qué me interrogan tan a menudo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=0
#. y4:msg_location=T13.P0
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "8604_Kiryu"
msgid "So, you were talking about quitting the club a while ago. Did you decide what to do?"
msgstr "Así que, ¿hablabas sobre abandonar el club hace tiempo? ¿Decidiste qué hacer?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=1
#. y4:msg_location=T13.P1
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "8616_Maya"
msgid "Well, I was planning on quitting, but..."
msgstr "Bueno, planeaba en renunciar, pero..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=2
#. y4:msg_location=T13.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "8628_Kiryu"
msgid "You're not sure?"
msgstr "¿No estás segura?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=3
#. y4:msg_location=T13.P3
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "8640_Maya"
msgid "Yeah. Maybe I've had a change of heart."
msgstr "Sí. Tal vez tuve una corazonada."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=4
#. y4:msg_location=T13.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=13
#. y4:msg_decision_choices=1. You don't want to quit, do you? -> T13.P5 | 2. You should follow your heart. -> T13.P12 | 3. You can't quit. -> T13.P19
msgctxt "8652_Maya"
msgid "What do you think? Should I quit?"
msgstr "¿Qué crees que deba hacer? ¿Debo renunciar?"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=160
#. y4:msg_phrase=0
#. y4:msg_location=T160.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T13.P5
#. y4:msg_branch_segment=T13.P5..P11
#. y4:msg_branch_target_text=You don't want to quit, do you?
#. y4:msg_branch_raw=01 11 00 05 00 00 00 1f 00 00 00 00 00 00 00 00
msgctxt "8664_Kiryu"
msgid "You don't want to quit, do you?"
msgstr "No quieres renunciar, ¿cierto?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=6
#. y4:msg_location=T13.P6
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You don't want to quit, do you?
msgctxt "8676_Maya"
msgid "Huh? How did you know?"
msgstr "¿Eh? ¿Cómo lo sabías?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=7
#. y4:msg_location=T13.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You don't want to quit, do you?
msgctxt "8688_Kiryu"
msgid "You just don't want to leave me, right? It's okay. You can say it."
msgstr "No quieres marcharte, ¿verdad? No pasa nada. Puedes decirlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=8
#. y4:msg_location=T13.P8
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You don't want to quit, do you?
msgctxt "8700_Maya"
msgid "Huh. That's pretty arrogant of you."
msgstr "Huh. Eso es bastante arrogante de tu parte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=9
#. y4:msg_location=T13.P9
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You don't want to quit, do you?
msgctxt "8712_Maya"
msgid "It's as though you don't really care whether or not I stay."
msgstr "Es como si no te importara si me quedo o no."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=10
#. y4:msg_location=T13.P10
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You don't want to quit, do you?
msgctxt "8724_Maya"
msgid "You really don't understand women, do you?"
msgstr "Realmente no entiendes a las mujeres, ¿no?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=29
