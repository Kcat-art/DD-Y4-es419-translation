msgid "Word has it you buy and sell stuff you can't get at your local store."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=3
#. y4:msg_location=T5.P3
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "1388_Kamiyama"
msgid "Huh? Wait, are you a cop...?"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=4
#. y4:msg_location=T5.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=3
msgctxt "1400_Tanimura"
msgid "Let me stop you right there. It's better if we don't know anything about each other. Will you let me make use of your services from here on out?"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
