#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "8676_Rio"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=26
#. y4:msg_location=T8.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I sort of understand what you mean.
msgctxt "8688_Akiyama"
msgid "You want to make yourself prettier to get back at him, right? Sorta make him regret losing you?"
msgstr "Quieres ponerte más bonita para volver con él, ¿verdad? ¿Hacer que se arrepienta de haberte perdido?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
