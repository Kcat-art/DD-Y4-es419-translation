msgid "(Boxcelios? Looks like an arcade shooter...)"
msgstr "(¿Boxcelios? Parece ser un shooter arcade...)"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
