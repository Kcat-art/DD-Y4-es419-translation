msgctxt "72_Sugiyama"
msgid "Saejima-san! It's been a while! Let me know when you need a partner in a tag tournament.\\r\nI'll be there in a flash!"
msgstr "¡Saejima-san, cuánto tiempo! Hazme saber cuando necesites un compañero para el torneo.\\r\n¡Estaré ahí en un parpadeo!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "96_Sugiyama"
msgid "Saejima-san. Nice to see you! Let me know when you need a partner in a tag tournament. I'll be there in a flash!"
msgstr "¡Saejima-san, que bueno verte! Dime cuando necesites un compañero para el torneo. ¡Estaré ahí en nada!"

