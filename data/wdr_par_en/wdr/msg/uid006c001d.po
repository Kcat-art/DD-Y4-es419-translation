#. y4:msg_branch_raw=01 11 00 0f 00 00 00 22 00 00 00 00 00 00 00 00
msgctxt "9048_Akiyama"
msgid "Wouldn't that be kind of annoying?"
msgstr "¿No sería un poco molesto?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
