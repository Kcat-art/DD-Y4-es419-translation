msgctxt "6324_松岡里緒奈：源氏名"
msgid "I think my favorite is the gorilla."
msgstr "Creo que mi favorito es el gorila."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
