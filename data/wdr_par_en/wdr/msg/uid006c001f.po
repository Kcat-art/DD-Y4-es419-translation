#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Do you like hardworking men?
msgctxt "4296_Noa"
msgid "I like men who enjoy their jobs."
msgstr "Diría que me gustan los hombres que disfrutan de su trabajo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
