msgctxt "196"
msgid "Quit"
msgstr "Salir"

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "201"
msgid "Cancel the order."
msgstr "Cancelar el pedido."

#. y4:line_status=translated
msgctxt "219"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=translated
msgctxt "225"
msgid "Order the currently selected item.  "
msgstr "Pedir el objeto actualmente seleccionado.  "

#. y4:line_status=translated
#. y4:translated_by=dani64amv
msgctxt "262"
msgid "(I haven't picked anything.)  "
msgstr "(No he escogido nada)."

#. y4:line_status=reviewed
#. y4:translated_by=dani64amv
#. y4:reviewed_by=dani64amv
msgctxt "293"
msgid "(I'm short on cash.)  "
msgstr "(Me hace falta dinero)."

#. y4:line_status=translated
msgctxt "316"
msgid "Thank you. That'll be %s."
msgstr "Gracias. Eso sería %s."

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "342"
msgid "(I can't carry any more stuff.)"
msgstr "(No puedo llevar más cosas)."

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "374"
msgid "(They're sold out.)"
msgstr "(Están agotados)."

#. y4:line_status=translated
msgctxt "394"
msgid "A body-hugging, halter-neck dress that amplifies its\nwearer's sexiness."
msgstr "Un vestido ajustado al cuerpo y con cuello de tipo\nhalter que realza la sensualidad de su portadora."

#. y4:line_status=translated
msgctxt "466"
msgid "The elegant body line and sophisticated color of this\ndress are sure to turn heads."
msgstr "La elegante silueta del cuerpo y el sofisticado color\nde este vestido seguro que atraerán todas las miradas."

