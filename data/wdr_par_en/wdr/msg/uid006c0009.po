#. y4:msg_branch_target=T0.P26
#. y4:msg_branch_segment=T0.P26..P35
#. y4:msg_branch_target_text=Why don't you stay for a bit longer?
#. y4:msg_branch_raw=01 11 00 1a 00 00 00 24 00 00 00 00 00 00 00 00
msgctxt "4452_Kiryu"
msgid "Why don't you stay for a bit longer?"
msgstr "¿Por qué no te quedas un poco más?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why don't you stay for a bit longer?
msgctxt "4464_Maya"
msgid "Huh? Why?"
msgstr "¿Eh? ¿Por qué?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why don't you stay for a bit longer?
msgctxt "4476_Kiryu"
msgid "We just met. I'd like to get to know you better."
msgstr "Acabamos de conocernos. Y me gustaría conocerte un poco mejor."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why don't you stay for a bit longer?
msgctxt "4488_Maya"
msgid "Hehe. You're cute."
msgstr "Je, je. Eres lindo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why don't you stay for a bit longer?
msgctxt "4500_Maya"
msgid "Well, since you asked so nicely, I could stay for a little while."
msgstr "Bueno, ya que lo pediste tan amablemente, podría quedarme un rato."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=31
#. y4:msg_location=T0.P31
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why don't you stay for a bit longer?
msgctxt "4512_Kiryu"
msgid "Are you sure?"
msgstr "¿Estás segura?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=32
#. y4:msg_location=T0.P32
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why don't you stay for a bit longer?
msgctxt "4524_Maya"
msgid "Yep. You're fun to talk to."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why don't you stay for a bit longer?
msgctxt "4536_Kiryu"
msgid "Heh. All right, then."
msgstr "Je. De acuerdo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=34
#. y4:msg_location=T0.P34
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why don't you stay for a bit longer?
msgctxt "4548_Maya"
msgid "But you have to promise to come and see me every day, okay?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=35
#. y4:msg_location=T0.P35
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why don't you stay for a bit longer?
msgctxt "4560_Kiryu"
msgid "I'll do my best."
msgstr "Dare lo mejor de mí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4572_Maya"
msgid "I became friends with this girl recently, and we really hit it off. We have the same interests and everything."
msgstr "Recientemente, me hice amiga de esta chica, y realmente nos llevamos bien. Tenemos los mismos intereses."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "4584_Kiryu"
msgid "Oh? That's nice."
msgstr "Oh, eso es bueno."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4596_Maya"
msgid "But we have totally different ideas about love. I don't get it."
msgstr "Pero tenemos ideas muy opuestas sobre el amor. No la entiendo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=13
#. y4:msg_location=T10.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=They really start that early?
msgctxt "4608_Kiryu"
msgid "What do you mean?"
msgstr "¿A qué te refieres?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4620_Maya"
msgid "I think a woman should be devoted and try to stay next to her man as much as possible."
msgstr "Yo creo que una mujer debería dedicarse a intentar estar al lado de un hombre como sea posible."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=1
#. y4:msg_decision_choices=1. I have to agree with her. -> T1.P6 | 2. There's nothing wrong with being devoted. -> T1.P14 | 3. That's a tricky issue. -> T1.P21
msgctxt "4632_Maya"
msgid "But she says men get tired of that kind of thing and eventually leave you."
msgstr "Pero ella dice que los hombres se aburren de ese tipo de cosas y finalmente te abandonan."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I have to agree with her.
msgctxt "4644_Kiryu"
msgid "I have to agree with her. Someone hanging around you all the time can be tiring."
msgstr "Estoy de acuerdo con ella. Alguien que siempre está junto a ti, todo el rato, llega a cansar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I have to agree with her.
msgctxt "4656_Maya"
msgid "What? You think so too?"
msgstr "¿Qué? ¿Tú también lo crees?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I have to agree with her.
msgctxt "4668_Kiryu"
msgid "Yeah. Don't get me wrong. If I love someone, I want to spend time with them. I just need time to myself, too."
msgstr "Sí. No me malinterpretes. Si amo a alguien, quiero pasar tiempo con ella. Pero yo también necesito tiempo para mí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I have to agree with her.
msgctxt "4680_Maya"
msgid "Well, I don't want to force myself on anyone."
msgstr "Bueno, no quiero obligar a nadie."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I have to agree with her.
msgctxt "4692_Kiryu"
msgid "Then you should be fine."
msgstr "Entonces deberías estar bien."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I have to agree with her.
msgctxt "4704_Maya"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=12
#. y4:msg_location=T1.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I have to agree with her.
msgctxt "4716_Kiryu"
msgid "Sure. As long as you consider the man's feelings, you won't come off as selfish and needy."
msgstr "Mientras tengas en cuenta los sentimientos del hombre, no parecerás egoísta ni necesitada."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I have to agree with her.
msgctxt "4728_Maya"
msgid "Okay. I guess you have to be devoted while still leaving a little space between you. It sounds a little tricky."
msgstr "Ok. Supongo que tienes que ser devoto y a la vez dejar un poco de espacio entre vosotros. Suena un poco difícil."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=There's nothing wrong with being devoted.
msgctxt "4740_Kiryu"
msgid "There's nothing wrong with being devoted. A man would be lucky to have such a woman."
msgstr "No hay nada de malo en que seas comprometida. Un hombre debería sentirse afortunado en tener ese tipo de mujer."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
