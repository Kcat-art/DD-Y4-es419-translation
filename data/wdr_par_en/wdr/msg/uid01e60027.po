msgctxt "92_Rio"
msgid "Akiyama-san? This is Rio! I need to talk to you!"
msgstr "¿Akiyama-san? ¡Soy Río! Necesito hablar contigo."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "104_Rio"
msgid "That photographer called. The president of the agency wants to meet me!"
msgstr "Me llamó el fotógrafo. ¡El presidente de la agencia quiere conocerme!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "116_Akiyama"
msgid "That's kinda sudden... What was the agency called again?"
msgstr "¡Wow! Que repen... ¿Espera que agencia te llamó?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "128_Rio"
msgid "Shino Productions. Have you heard of it?"
msgstr "Shino Productions. ¿Escuchaste de ellos?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "140_Akiyama"
msgid "Never heard of it."
msgstr "Nunca los escuche."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "152_Rio"
msgid "I'm going to their office to see what the president has to say before making my decision."
msgstr "Me voy a sus oficinas a ver qué quiere decir el presidente antes de tomar una decisión."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "164_Akiyama"
msgid "Makes sense. Good luck!"
msgstr "¡Con cuidado y buena suerte!"

#. y4:line_status=translated
msgctxt "176_Rio"
msgid "Thanks!"
msgstr "¡Gracias!"

#. y4:line_status=todo
msgctxt "236_Talk_Phone_st"
