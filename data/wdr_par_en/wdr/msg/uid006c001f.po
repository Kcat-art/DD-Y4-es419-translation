#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Do you like hardworking men?
msgctxt "4320_Noa"
msgid "Yep. So I pay attention to things like that."
msgstr "Sip. Así que presto atención a detalles relacionados a ello. ♪"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
