#. y4:msg_location=T8.P1
msgctxt "1380_P_sitsofaR_tlk_yes"
msgid "Oh, my... I guess you're not requesting me today..."
msgstr "Oh, vaya... parece que hoy no me has solicitado..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=9
#. y4:msg_phrase=0
#. y4:msg_location=T9.P0
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=3
