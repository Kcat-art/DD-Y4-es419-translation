msgctxt "56_Arai"
msgid "Sorry to drag you into this, Akiyama-san."
msgstr "Siento haberte metido en esto, Akiyama-san."

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "68_Akiyama"
msgid "Pretty sure it's the other way around, isn't it?"
msgstr "Estoy seguro de que es al revés, ¿no?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "80_Arai"
msgid "No. Don't think I don't know what you're up to."
msgstr "No. Sé lo que estás haciendo, Akiyama-san."

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "92_Akiyama"
msgid "......"
msgstr "......"

#. y4:line_status=reviewed
#. y4:translated_by=Keiner
#. y4:reviewed_by=Keiner
msgctxt "116_Arai"
msgid "Hello... What? Don't worry, I'll find them."
msgstr "Sí... ¿Qué? Entendido, los encontraré."

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "140_Akiyama"
msgid "Kido-chan?"
msgstr "¿Kido-chan?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "152_Arai"
msgid "Yeah."
msgstr "Sí."

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "164_Akiyama"
msgid "Figured."
msgstr "Ya veo."

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "176_Arai"
msgid "I've got some business to tend to."
msgstr "Tengo asuntos que atender."

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "188_Akiyama"
msgid "Right... Well, give my regards to Kanemura-san. And make\\r\nsure he remembers his loan terms while you're at it."
msgstr "Bueno... Por favor, recuérdale a Kanemura-san las condiciones que le puse."

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "200_Arai"
msgid "Very well."
msgstr "Claro."

