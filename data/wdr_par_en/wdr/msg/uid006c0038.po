#. y4:line_status=todo
#. y4:msg_role=decision
#. y4:msg_decision_role=prompt
#. y4:msg_decision_group=6
msgctxt "6360_望月京子：源氏名"
msgid "That's right. Most of the time, anyway. Is there something strange about that?"
