msgctxt "460"
msgid "Quit"
msgstr "Salir"

#. y4:line_status=reviewed
#. y4:translated_by=Kcat0
#. y4:reviewed_by=Kcat0
msgctxt "465"
msgid "Cancel the order."
msgstr "Cancelar pedido."

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
msgctxt "483"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=reviewed
#. y4:translated_by=Kcat0
#. y4:reviewed_by=Kcat0
msgctxt "489"
msgid "Order the currently selected item."
msgstr "Pagar el objeto seleccionado."

#. y4:line_status=translated
msgctxt "524"
msgid "(I haven't picked anything.)"
msgstr "(No he escogido nada)"

#. y4:line_status=translated
msgctxt "553"
msgid "(I'm short on cash.)"
msgstr "(Me hace falta dinero)"

#. y4:line_status=translated
msgctxt "574"
msgid "Very well, sir."
msgstr "Muy bien, señor."

#. y4:line_status=translated
msgctxt "590"
msgid "(I can't eat anymore...)"
msgstr "(No puedo comer más...)"

#. y4:line_status=translated
msgctxt "634"
msgid "Nothing like a swig of grapefruit juice to cool you down.\nTangy, refreshing, and full of vitamins."
msgstr "Nada como un trago de jugo de toronja para refrescarse.\nÁcido, refrescante y lleno de vitaminas."

#. y4:line_status=translated
msgctxt "733"
msgid "Made from Italian oranges with a refreshing blend of\nsweet and sour flavors."
msgstr "Hecho de naranjas italianas con una refrescante\nmezcla de sabores dulces y agrios."

#. y4:line_status=translated
msgctxt "810"
msgid "Made with only the finest Brazilian coffee beans for a\nrich, authentic flavor."
msgstr "Elaborado únicamente con los mejores granos de café\nbrasileños para obtener un sabor rico y auténtico."

#. y4:line_status=translated
msgctxt "889"
msgid "Made with only the finest Brazilian coffee beans.\nWatered down to alleviate the bitterness."
msgstr "Elaborado con los mejores granos de café\nbrasileños. Con mucha agua para suavizar el\namargor."

#. y4:line_status=translated
msgctxt "981"
msgid "A perfect marriage of rich milk and Brazilian coffee\nbeans. Truly a match made in heaven."
msgstr "Una combinación perfecta de rica leche y granos de\ncafé brasileños. Realmente única."

#. y4:line_status=translated
msgctxt "1071"
msgid "A classic blend of rich espresso and frothy milk."
msgstr "Una mezcla clásica de un rico expreso y leche espumosa."

#. y4:line_status=translated
msgctxt "1121"
msgid "A popular drink made with espresso, chocolate, and\ncocoa. Smooth and chocolatey."
msgstr "Bebida popular a base de un expreso, chocolate y\ncacao. Suave y achocolatada."

#. y4:line_status=translated
msgctxt "1202"
msgid "A rich, refreshing beverage made with fresh milk.\nThe aroma alone will melt all your worries away."
msgstr "Una bebida rica y refrescante hecha con leche\nfresca. Solo el aroma derretirá todas tus\npreocupaciones."

#. y4:line_status=translated
msgctxt "1301"
msgid "Nothing like a refreshing, nutritious glass of milk."
msgstr "Nada como un refrescante y nutritivo vaso de leche."

#. y4:line_status=translated
msgctxt "1354"
msgid "Rich, tasty cocoa brewed with hand-picked cacao beans."
msgstr "Cacao rico y sabroso elaborado con frutos de cacao seleccionados a mano."

