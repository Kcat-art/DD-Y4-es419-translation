#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'd stay a human.
msgctxt "6456_Kiryu"
msgid "Hey, you asked the question."
msgstr "Oye, tú hiciste la pregunta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=16
#. y4:msg_location=T6.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd like to be a lion.
msgctxt "6468_Kiryu"
msgid "I'd like to be a lion. The lion's the king of the beasts."
msgstr "Me gustaría ser un león. El león es el rey de las bestias."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=17
#. y4:msg_location=T6.P17
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd like to be a lion.
msgctxt "6480_松岡里緒奈：源氏名"
msgid "A lion, huh? Typical man."
msgstr "Un león, ¿eh? Hombre típico."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=18
#. y4:msg_location=T6.P18
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd like to be a lion.
msgctxt "6492_松岡里緒奈：源氏名"
msgid "But don't male lions just lie around all day? It's the females that do the hunting."
msgstr "Pero, ¿no acaso los leones machos no se quedan todo el día tumbados? Son las hembras las que cazan."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=19
#. y4:msg_location=T6.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd like to be a lion.
msgctxt "6504_Kiryu"
msgid "Sounds good to me. I'd like a taste of that life."
msgstr "A mí me parece bien. Me gustaría probar esa vida."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=20
#. y4:msg_location=T6.P20
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd like to be a lion.
msgctxt "6516_松岡里緒奈：源氏名"
msgid "What!? You want to sit back while the women do all the work!? That's terrible."
msgstr "¿¡Qué!? ¿¡Quieres sentarte mientras las mujeres hacen todo el trabajo!? Eso es terrible."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=21
