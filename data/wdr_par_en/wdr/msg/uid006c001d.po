#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I wouldn't mind being a teacher there.
msgctxt "12600_Akiyama"
msgid "Uh, well, I didn't mean it like that..."
msgstr "Eh, bueno, no lo decía en ese sentido..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=30
#. y4:msg_location=T16.P30
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I wouldn't mind being a teacher there.
msgctxt "12612_Rio"
msgid "Hehehe. I think all of the girls would probably fall in love with a teacher like you, Akiyama-san."
msgstr "Je, je, je. Creo que todas las chicas probablemente se enamorarían de un profesor como usted, Akiyama-san."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=31
#. y4:msg_location=T16.P31
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I wouldn't mind being a teacher there.
msgctxt "12624_Akiyama"
msgid "They would, huh?"
msgstr "Lo harían, ¿eh?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=32
#. y4:msg_location=T16.P32
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I wouldn't mind being a teacher there.
msgctxt "12636_Rio"
msgid "Oh my. Are you blushing?"
msgstr "Vaya. ¿Está sonrojado?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=33
#. y4:msg_location=T16.P33
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I wouldn't mind being a teacher there.
msgctxt "12648_Akiyama"
msgid "No. I am not."
msgstr "No, no lo estoy."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=34
#. y4:msg_location=T16.P34
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I wouldn't mind being a teacher there.
msgctxt "12660_Rio"
msgid "That's so cute!"
msgstr "¡Eso es tan tierno!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=35
#. y4:msg_location=T16.P35
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Wait, fried chicken at the school store!?
msgctxt "12672_Akiyama"
msgid "Wait, fried chicken at the school store!? What kind of school store has fried chicken?"
msgstr "Espera, ¿¡pollo frito en la tienda de la escuela!? ¿Qué tipo de tienda escolar tiene pollo frito?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=36
#. y4:msg_location=T16.P36
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Wait, fried chicken at the school store!?
msgctxt "12684_Rio"
msgid "Don't most schools usually have that?"
msgstr "¿No tienen eso la mayoría de las escuelas?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=37
#. y4:msg_location=T16.P37
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Wait, fried chicken at the school store!?
msgctxt "12696_Akiyama"
msgid "No. The most they usually have is bread and milk."
msgstr "No. Lo máximo que suelen tener es pan y leche."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=38
#. y4:msg_location=T16.P38
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Wait, fried chicken at the school store!?
msgctxt "12708_Rio"
msgid "Well, we had that too, but I'm glad we were lucky enough to have fried chicken, then!"
msgstr "Bueno, también teníamos eso, ¡pero me alegra que fuéramos lo bastante afortunadas como para tener pollo frito!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=39
#. y4:msg_location=T16.P39
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Wait, fried chicken at the school store!?
msgctxt "12720_Akiyama"
msgid "Was it good?"
msgstr "¿Estaba bueno?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=40
#. y4:msg_location=T16.P40
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Wait, fried chicken at the school store!?
msgctxt "12732_Rio"
msgid "Totally! That's why you had to run to go buy it! They'd be sold out if you weren't fast enough."
msgstr "¡Totalmente! Por eso tenías que correr a comprarlo. Se acababa si no eras lo suficientemente rápida."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=41
#. y4:msg_location=T16.P41
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Wait, fried chicken at the school store!?
msgctxt "12744_Akiyama"
msgid "High school girls racing each other for fried chicken... Sounds like a game show. I would watch that."
msgstr "Chicas de secundaria corriendo por pollo frito... Suena como un concurso en la tele. Yo vería eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
#. y4:msg_phrase=42
#. y4:msg_location=T16.P42
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Wait, fried chicken at the school store!?
msgctxt "12756_Rio"
msgid "Nuh-uh! If there were boys around, we never would have done it!"
msgstr "¡Para nada! ¡Si hubiera habido chicos cerca, jamás lo habríamos hecho!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=0
#. y4:msg_location=T17.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12768_Rio"
msgid "I've been thinking..."
msgstr "He estado pensando..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=1
#. y4:msg_location=T17.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "12780_Akiyama"
msgid "About what?"
msgstr "¿De qué?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=2
#. y4:msg_location=T17.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12792_Rio"
msgid "I think I'm finally over my ex. I can think about it now without my heart aching."
msgstr "Creo que por fin superé a mi ex. Ahora puedo pensar en eso sin que me duela el corazón."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=3
#. y4:msg_location=T17.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "12804_Akiyama"
msgid "So you can look at it through a more objective lens?"
msgstr "¿Entonces puedes verlo con una perspectiva más objetiva?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=4
#. y4:msg_location=T17.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12816_Rio"
msgid "Right! And I noticed something."
msgstr "¡Exacto! Y me di cuenta de algo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=5
#. y4:msg_location=T17.P5
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12828_Rio"
msgid "When I find out that the person I'm with is better than me at something, I find it easier to just let them be."
msgstr "Cuando descubro que la persona con la que estoy es mejor que yo en algo, me resulta más fácil dejarla ser."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=6
#. y4:msg_location=T17.P6
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12840_Rio"
msgid "It helps me maintain a good relationship with them, I guess."
msgstr "Supongo que eso me ayuda a mantener una buena relación con ellos."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=7
#. y4:msg_location=T17.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "12852_Akiyama"
msgid "You mean it keeps you humble?"
msgstr "¿Te refieres a que te mantiene humilde?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=8
#. y4:msg_location=T17.P8
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12864_Rio"
msgid "Yes! So when there's nothing like that anymore, I start getting critical. I start nitpicking, you know?"
msgstr "¡Sí! Así que cuando ya no hay nada así, empiezo a ponerme crítica. Empiezo a fijarme en los detalles, ¿sabe?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=9
#. y4:msg_location=T17.P9
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12876_Rio"
msgid "It gets worse the more I get to know them."
msgstr "Y se pone peor cuanto más los conozco."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=10
#. y4:msg_location=T17.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "12888_Akiyama"
msgid "You start criticizing them more and more."
msgstr "Empiezas a criticarlos cada vez más."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=11
#. y4:msg_location=T17.P11
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12900_Rio"
msgid "Yeah. I don't mean to, it just happens."
msgstr "Sí. No es mi intención, simplemente sucede."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=12
#. y4:msg_location=T17.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12912_Rio"
msgid "I'd love to be a little less perceptive, honestly..."
msgstr "Si le soy sincera, me gustaría ser un poco menos perceptiva..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "12924_Akiyama"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=14
#. y4:msg_location=T17.P14
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "12936_Rio"
msgid "Yes. I feel more comfortable that way, personally..."
msgstr "Sí. Personalmente me siento más a gusto así..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=15
#. y4:msg_location=T17.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "12948_Akiyama"
msgid "I see... So did you just notice that recently?"
msgstr "Ya veo... ¿Y te diste cuenta de eso hace poco?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=16
#. y4:msg_location=T17.P16
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=17
#. y4:msg_decision_choices=1. That relationship's over. Forget about it. -> T17.P17 | 2. So basically, you don't like stupid men. -> T17.P27 | 3. Maybe you need a masochistic boyfriend. -> T17.P37
msgctxt "12960_Rio"
msgid "Yeah, pretty much."
msgstr "Sí, más o menos."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=172
#. y4:msg_phrase=0
#. y4:msg_location=T172.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T17.P17
#. y4:msg_branch_segment=T17.P17..P26
#. y4:msg_branch_target_text=That relationship's over. Forget about it.
#. y4:msg_branch_raw=01 11 00 11 00 00 00 2a 00 00 00 00 00 00 00 00
msgctxt "12972_Akiyama"
msgid "That relationship's over. Forget about it."
msgstr "Esa relación ya terminó. Olvídate de eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=45
#. y4:msg_location=T1.P45
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice="Rio, Queen of the Dance"
msgctxt "12984_Rio"
msgid "You think so?"
msgstr "¿De verdad lo cree?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=19
#. y4:msg_location=T17.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That relationship's over. Forget about it.
msgctxt "12996_Akiyama"
msgid "There's no point overanalyzing it. It all depends on the person, after all."
msgstr "No tiene sentido sobre analizarlo. Todo depende de la persona, al fin y al cabo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=38
#. y4:msg_location=T2.P38
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you really want a dog that nobody else wants?
msgctxt "13008_Rio"
msgid "I guess so, but still..."
msgstr "Supongo, pero aún así..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=21
#. y4:msg_location=T17.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That relationship's over. Forget about it.
msgctxt "13020_Akiyama"
msgid "When you meet somebody else, you'll probably find that your way of thinking will change, too."
msgstr "Cuando conozcas a alguien más, probablemente verás que tu forma de pensar cambiará."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=22
#. y4:msg_location=T17.P22
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That relationship's over. Forget about it.
msgctxt "13032_Rio"
msgid "Hmm... Really?"
msgstr "Hmm... ¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=23
#. y4:msg_location=T17.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That relationship's over. Forget about it.
msgctxt "13044_Akiyama"
msgid "Let's try it. How about going out with me?"
msgstr "Vamos a intentarlo. ¿Qué tal si sales conmigo?"

msgctxt "13056_Rio"
msgid "Hehehe. You can't trick me that easily. <Color:7>♥<Color:Default>"
msgstr "Je, je, je. No puedes engañarme tan fácilmente. <Color:7>♥<Color:Default>"

msgctxt "13068_Rio"
msgid "But I do feel a little better. Thanks, Akiyama-san! <Color:7>♥<Color:Default>"
msgstr "Pero ahora me siento un poco mejor. ¡Gracias, Akiyama-san! <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=11
#. y4:msg_location=T7.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Both legs bouncing sounds annoying.
msgctxt "13080_Akiyama"
msgid "Hehe."
msgstr "Je, je."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=173
#. y4:msg_phrase=0
#. y4:msg_location=T173.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T17.P27
#. y4:msg_branch_segment=T17.P27..P36
#. y4:msg_branch_target_text=So basically, you don't like stupid men.
#. y4:msg_branch_raw=01 11 00 1b 00 00 00 28 00 00 00 00 00 00 00 00
msgctxt "13092_Akiyama"
msgid "So basically, you don't like stupid men."
msgstr "O sea que, básicamente, no te gustan los hombres tontos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=28
#. y4:msg_location=T17.P28
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So basically, you don't like stupid men.
msgctxt "13104_Rio"
msgid "Yeah, I guess that's it."
msgstr "Sí, supongo que es eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=29
