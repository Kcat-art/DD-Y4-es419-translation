#. y4:msg_branch_choice=I know the boys would love you.
msgctxt "17640_Kiryu"
msgid "Hehehe."
msgstr "Je, je, je."

msgctxt "17652_松岡里緒奈：源氏名"
msgid "You wear sunglasses too, huh? And at night! That's pretty cool. <Color:7>♥<Color:Default>"
msgstr "Tú también llevas gafas de sol, ¿eh? ¡Y por la noche! Eso es muy genial. <Color:7>♥<Color:Default>"

msgctxt "17664_松岡里緒奈：源氏名"
msgid "But I think you'd look pretty dangerous with sunglasses on. Like some kind of fugitive or something. <Color:7>♥<Color:Default>"
msgstr "Pero creo que te verías muy peligroso con gafas de sol puestas. Como una especie de fugitivo o algo así. <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=117
#. y4:msg_phrase=2
#. y4:msg_location=T117.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "17676_Kiryu"
msgid "You're more right than you know..."
msgstr "Tienes más razón de la que crees..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=118
#. y4:msg_phrase=0
#. y4:msg_location=T118.P0
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "17688_松岡里緒奈：源氏名"
msgid "Hmm... Maybe I've been drinking too much. I've been exercising, but it doesn't seem to be having any effect."
msgstr "Hmm... Tal vez he estado bebiendo demasiado. He estado haciendo ejercicio, pero no parece tener ningún efecto."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=118
#. y4:msg_phrase=1
#. y4:msg_location=T118.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "17700_Kiryu"
msgid "I told you. Muscles develop most when you're taking a break from your training. If you drink then, it cancels out all of your hard work."
msgstr "Te lo dije. Los músculos se desarrollan más cuando te tomas un descanso de tu entrenamiento. Si bebes entonces, cancelas todo tu arduo trabajo."

msgctxt "17712_松岡里緒奈：源氏名"
msgid "You might be right. I'll be more careful from now on. <Color:7>♥<Color:Default>"
msgstr "Puede que tengas razón. Tendré más cuidado a partir de ahora. <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=119
#. y4:msg_phrase=0
#. y4:msg_location=T119.P0
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "17724_松岡里緒奈：源氏名"
msgid "So I'm homesick, huh?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=119
#. y4:msg_phrase=1
#. y4:msg_location=T119.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "17736_Kiryu"
msgid "Probably. Most people are happier being with their families than living alone."
msgstr "Probablemente. La mayoría de la gente es más feliz estando con su familia que viviendo sola."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=119
#. y4:msg_phrase=2
#. y4:msg_location=T119.P2
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "17748_松岡里緒奈：源氏名"
msgid "I guess you're right. Maybe I'll email someone in my family."
msgstr "Supongo que tienes razón. Tal vez le envíe un correo a alguien de mi familia."

msgctxt "17760_松岡里緒奈：源氏名"
msgid "Thanks for listening, Kiryu-san. <Color:7>♥<Color:Default>"
msgstr "Gracias por escuchar, Kiryu-san. <Color:7>♥<Color:Default>"

msgctxt "17772_松岡里緒奈：源氏名"
msgid "You really understand fashion. You don't need expensive clothes. With good fashion sense, you can look good in anything. <Color:7>♥<Color:Default>"
msgstr "Tú sí que entiendes de moda. No necesitas ropa cara. Con un buen sentido de la moda, te puede quedar bien cualquier cosa. <Color:7>♥<Color:Default>"

