#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You shouldn't have anything to do with them.
msgctxt "7824_Kiryu"
msgid "You can never tell what guys like that will do. And avoiding trouble is part of a leader's job, right?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
