msgctxt "4440_望月京子：源氏名"
msgid "I'm from Fukuoka Prefecture originally. I was pretty wild back when I was a student."
msgstr "Soy de la Prefectura de Fukuoka. Era una zona peligrosa cuando era estudiante."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
