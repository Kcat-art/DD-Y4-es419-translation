#. y4:msg_branch_raw=01 11 00 17 00 00 00 1f 00 00 00 00 00 00 00 00
msgctxt "7008_Akiyama"
msgid "How long have you been playing?"
msgstr "¿Hace cuánto juegas?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=24
#. y4:msg_location=T5.P24
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=How long have you been playing?
msgctxt "7020_Rio"
msgid "Since junior high!"
msgstr "¡Desde la secundaria!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=19
#. y4:msg_location=T3.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Nothing wrong with showing a little skin.
msgctxt "7032_Akiyama"
msgid "Oh yeah?"
msgstr "Ah, ¿sí?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=26
#. y4:msg_location=T5.P26
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=How long have you been playing?
msgctxt "7044_Rio"
msgid "I used to practice every day. Mostly without a ball and usually wearing shorts!"
msgstr "Solía practicar todos los días. ¡La mayoría de las veces sin pelota y generalmente usando pantalones cortos!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=27
#. y4:msg_location=T5.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=How long have you been playing?
msgctxt "7056_Akiyama"
msgid "Without a ball!? How does that work? And are we sure this is you we're talking about?"
msgstr "¿¡Sin pelota!? ¿Cómo funciona eso? ¿Y estamos seguros de que eres tú de quien hablamos?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=17
#. y4:msg_location=T5.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "7068_Rio"
msgid "Hehe, it's just a side of me that slips out sometimes."
msgstr "Jeje, es una faceta mía que se me escapa a veces."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=29
#. y4:msg_location=T5.P29
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=How long have you been playing?
msgctxt "7080_Akiyama"
msgid "It sounds like you put a lot of work in."
msgstr "Parece que le ponías mucho esfuerzo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=30
#. y4:msg_location=T5.P30
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=How long have you been playing?
msgctxt "7092_Rio"
msgid "I did... But after a while, I started skipping practice."
msgstr "Lo hacía... Pero después de un tiempo, empecé a saltarme los entrenamientos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=31
#. y4:msg_location=T5.P31
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=How long have you been playing?
msgctxt "7104_Akiyama"
msgid "Really? Why?"
msgstr "¿De verdad? ¿Por qué?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=32
#. y4:msg_location=T5.P32
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=How long have you been playing?
msgctxt "7116_Rio"
msgid "I don't know. I just got tired of it, I guess."
msgstr "Quizá solo perdí el interés, no lo sé."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=33
#. y4:msg_location=T5.P33
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=How long have you been playing?
msgctxt "7128_Akiyama"
msgid "Ah..."
msgstr "Ah..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=34
#. y4:msg_location=T5.P34
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=How long have you been playing?
msgctxt "7140_Akiyama"
msgid "Anyway, I'd like to see you in action. We should play some time."
msgstr "De todos modos, me gustaría verte en acción. Deberíamos jugar alguna vez."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
