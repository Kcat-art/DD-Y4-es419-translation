#. y4:msg_branch_segment=T6.P14..P20
#. y4:msg_branch_target_text=It is kinda rude. You need to pay attention to what your friends are saying, especially if you're the one asking them the question.
#. y4:msg_branch_raw=01 11 00 0e 00 00 00 11 00 00 00 00 00 00 00 00
msgctxt "17736_Kiryu"
msgid "It is kinda rude."
msgstr "Eso es un poco grosero."

