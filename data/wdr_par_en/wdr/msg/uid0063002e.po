#. y4:msg_location=T2.P1
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=0
msgctxt "292_Shizuka"
msgid "Um... Would you do me the honor of singing a song?"
msgstr "¿Me haría el honor de cantar una canción?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Shizuka
