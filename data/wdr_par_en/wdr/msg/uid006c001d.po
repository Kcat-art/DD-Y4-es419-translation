#. y4:msg_branch_raw=01 11 00 17 00 00 00 24 00 00 00 00 00 00 00 00
msgctxt "12144_Akiyama"
msgid "Are there other foods you can't eat?"
msgstr "¿Hay otros alimentos que no puedas comer?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=24
#. y4:msg_location=T15.P24
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are there other foods you can't eat?
msgctxt "12156_Rio"
msgid "None. I'm not a picky eater, either."
msgstr "Ninguno. Tampoco soy muy exigente con la comida."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=25
#. y4:msg_location=T15.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are there other foods you can't eat?
msgctxt "12168_Akiyama"
msgid "But you can't eat raw shrimp? Odd."
msgstr "¿Pero no puedes comer camarones crudos? Eso es raro."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
