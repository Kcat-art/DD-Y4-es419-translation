msgid "Thanks! Hope to see you again real soon!"
msgstr "¡Gracias! ¡Espero volver a verte pronto!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
