#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Hot springs are nice, aren't they?
msgctxt "7704_Akiyama"
msgid "Just take me with you once, okay?"
msgstr "Solo llévame contigo una vez, ¿vale?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
