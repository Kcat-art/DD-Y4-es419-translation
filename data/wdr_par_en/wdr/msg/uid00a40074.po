#. y4:msg_location=T1.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "172_Akiyama"
msgid "Ah, I see you've been waiting. Sorry I took so long."
msgstr "Vaya, llegaste temprano. Disculpa por la demora."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Nishihama
#. y4:msg_speaker_id=2
msgctxt "184_Nishihama"
msgid "No trouble at all, so long as you brought the money."
msgstr "No se preocupe. Solo espero que no haya olvidado el dinero."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Nishihama
#. y4:msg_speaker_id=2
msgctxt "196_Nishihama"
msgid "You did bring the money, right...?"
msgstr "No se le olvidó... ¿verdad?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "208_Akiyama"
msgid "Got it right here. Care to take a look?"
msgstr "Para nada. ¿Quieres echarle un vistazo?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Nishihama
#. y4:msg_speaker_id=2
msgctxt "220_Nishihama"
msgid "Oh, no, that won't be necessary! I trust you, Akiyama-san."
msgstr "Oh, no, no es necesario. Confío en usted, Akiyama-san."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "232_Akiyama"
msgid "You sure? All right, here you go."
msgstr "¿Estás seguro? Bueno, aquí tienes."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Nishihama
#. y4:msg_speaker_id=2
msgctxt "268_Nishihama"
msgid "Actually... there's one more favor I'd like to ask of you."
msgstr "De hecho... me gustaría pedirle un último favor."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "280_Akiyama"
msgid "Another one? What is it this time?"
msgstr "¿Otro favor? ¿En qué puedo ayudarle ahora?"

#. y4:line_status=translated
msgctxt "292_Nishihama"
msgid "Would you mind coming with me to give this to the\\r\nkidnapper? I'm too scared to go by myself."
msgstr "¿Le importaría acompañarme para entregarle esto al secuestrador?\\r\nEstoy demasiado nervioso como para ir solo."

#. y4:line_status=translated
msgctxt "304_Akiyama"
msgid "But you can't just show up with some random guy. What'll the\\r\nkidnapper do to your daughter if he sees me?"
msgstr "Pero no puedes aparecer con cualquier persona. ¿Qué pensará\\r\nel secuestrador si me ve?"

#. y4:line_status=translated
msgctxt "316_Nishihama"
msgid "Huh? Well, uh... It's a risk, but... I just can't go by\\r\nmyself."
msgstr "¿Eh? Es algo arriesgado, lo admito, pero...\\r\nno puedo ir solo."

#. y4:line_status=translated
msgctxt "328_Nishihama"
msgid "I'm begging you! Please come with me! I... I can't handle\\r\nthis much money alone!"
msgstr "¡Le ruego que me acompañe! ¡No puedo manejar una suma\\r\ntan grande de dinero solo!"

#. y4:line_status=translated
msgctxt "340_Akiyama"
msgid "You know I can't do that. What if something happened to\\r\nyour daughter?"
msgstr "Sabes que no puedo hacer eso... ¿Qué pasaría si le sucede algo\\r\na tu hija?"

#. y4:line_status=translated
msgctxt "352_Nishihama"
msgid "Please don't say that! Please, Akiyama-san, you just have to\\r\ncome with me! Please!"
msgstr "¡No diga eso, por favor! Se lo suplico, Akiyama-san. Necesito que\\r\nme acompañe. ¡Por favor!"

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=16
#. y4:msg_location=T1.P16
#. y4:msg_speaker=Nishihama
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=1
#. y4:msg_decision_choices=1. Go With Him -> T1.P17 | 2. Refuse -> T1.P14
msgctxt "364_Nishihama"
msgid "Don't make me do this alone! I'm on my knees here!"
msgstr "¡Por favor, no me deje hacerlo solo! ¡Estoy desesperado!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
