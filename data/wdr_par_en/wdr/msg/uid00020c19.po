msgctxt "72_Saejima"
msgid "(A cop... Can't afford to get caught right now. Better take a detour.)"
msgstr "(Mierda, la policía... Será mejor que tome otro camino)."

#. y4:line_status=reviewed
#. y4:translated_by=Keiner
