#. y4:msg_branch_raw=01 11 00 0b 00 00 00 12 00 00 00 00 00 00 00 00
msgctxt "352_Saejima"
msgid "Follow to the Dojo"
msgstr "Ir al dojo"

#. y4:line_status=translated
#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
