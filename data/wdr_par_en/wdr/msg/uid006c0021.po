#. y4:msg_branch_choice=There's no need to be sad about it.
msgctxt "12300_Akiyama"
msgid "There's no need to be sad about it. That's the way life is. I'm sure you'll meet someone new soon."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
