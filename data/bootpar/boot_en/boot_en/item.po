msgstr "Hecho con granos de café 100% brasileños. Suave y delicioso."

#. y4:line_status=translated
msgctxt "21309"
msgid "Café Latte"
msgstr "Café Latte"

#. y4:line_status=translated
msgctxt "91153"
msgid "An impressive combination of rich milk and Brazilian coffee beans."
msgstr "Una combinación impresionante de leche cremosa y granos de café brasileños."

#. y4:line_status=translated
msgctxt "21321"
msgid "Cappuccino"
msgstr "Capuccino"

#. y4:line_status=translated
msgctxt "91220"
msgid "An impressive blend of rich espresso and frothy milk."
msgstr "Una mezcla clásica de un rico expreso y leche espumosa."

#. y4:line_status=translated
msgctxt "21332"
msgid "Café Mocha"
msgstr "Café Mocha"

#. y4:line_status=translated
msgctxt "91274"
msgid "A popular drink made with espresso, chocolate, and cocoa."
msgstr "Una bebida popular a base de espresso, chocolate y cacao."

#. y4:line_status=translated
msgctxt "21344"
msgid "Royal Milk Tea"
msgstr "Té con Leche Royal"

#. y4:line_status=translated
msgctxt "91332"
msgid "A rich, refreshing beverage made with fresh milk."
msgstr "Una bebida deliciosa y refrescante elaborada con leche fresca."

#. y4:line_status=translated
msgctxt "21359"
msgid "Milk"
msgstr "Leche"

#. y4:line_status=translated
msgctxt "91382"
msgid "Nothing like a refreshing glass of milk."
msgstr "Nada como un refrescante vaso de leche."

#. y4:line_status=translated
msgctxt "21364"
msgid "Cocoa"
msgstr "Cacao"

#. y4:line_status=translated
msgctxt "91423"
msgid "This rich, tasty cocoa was brewed with specially selected cacao beans."
msgstr "Este cacao rico y sabroso fue elaborado con granos de cacao cuidadosamente seleccionados."

#. y4:line_status=translated
msgctxt "21370"
msgid "Vanilla Gelato"
msgstr "Helado de Vainilla"

#. y4:line_status=translated
msgctxt "91494"
msgid "A single scoop of our popular vanilla gelato, made with real vanilla beans."
msgstr "Una cucharada de nuestro popular helado de vainilla elaborado con auténticas vainas de vainilla."

#. y4:line_status=translated
msgctxt "21385"
msgid "Strawberry Gelato"
msgstr "Helado de Fresa"

#. y4:line_status=translated
msgctxt "91570"
msgid "Strawberry gelato is especially popular with girls because of its uniquely sweet and tangy flavor."
msgstr "El helado de fresa es especialmente popular entre las chicas por su inigualable sabor dulce y ácido."

#. y4:line_status=translated
msgctxt "21403"
msgid "Chocolate Gelato"
msgstr "Helado de Chocolate"

#. y4:line_status=translated
msgctxt "91669"
msgid "A single scoop of chocolate gelato. Adults love its slightly bitter taste."
msgstr "Una cucharada de helado de chocolate. A los adultos les encanta su sabor ligeramente amargo."

#. y4:line_status=translated
msgctxt "21420"
msgid "Azuki Gelato"
msgstr "Helado Azuki"

#. y4:line_status=translated
msgctxt "91744"
