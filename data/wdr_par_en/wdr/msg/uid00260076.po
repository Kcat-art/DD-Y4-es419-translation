#. y4:msg_phrase=40
#. y4:msg_location=T0.P40
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Maybe he's hungry.
msgctxt "828_Date"
msgid "Hey, good thinking! I'll go get some food for him!"
msgstr "¡Bien pensado! ¡Voy a buscarle un poco de comida!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=41
#. y4:msg_location=T0.P41
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Maybe he's hungry.
msgctxt "840_Kiryu"
msgid "Hold on, Date. What are you gonna get?"
msgstr "Un momento, Date. ¿Qué vas a buscar?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=42
#. y4:msg_location=T0.P42
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Maybe he's hungry.
msgctxt "852_Date"
msgid "Well, he's a baby, so... milk? That sounds right, I think."
msgstr "Bueno, es un bebé, así que... ¿leche? Creo que suena bien."

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
