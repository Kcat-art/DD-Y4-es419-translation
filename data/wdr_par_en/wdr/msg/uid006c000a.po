#. y4:msg_branch_choice=It's cute.
msgctxt "6300_Chihiro"
msgid "What's so cute about it?"
msgstr "¿Qué tiene de tierno?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=15
#. y4:msg_location=T5.P15
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=It's cute.
msgctxt "6312_Tanimura"
msgid "It makes you seem so delicate. Like a beautiful flower that needs care and love."
msgstr "Te hace ver delicada, como una preciosa flor que necesita amor y cuidado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=16
