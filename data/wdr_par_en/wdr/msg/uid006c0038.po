msgstr "Mejor te lo digo despues."

#. y4:line_status=translated
msgctxt "6264_Kiryu"
msgid "......"
msgstr "......"

#. y4:line_status=todo
msgctxt "6276_Kiryu"
msgid "What kind of food do you like?"
msgstr ""

