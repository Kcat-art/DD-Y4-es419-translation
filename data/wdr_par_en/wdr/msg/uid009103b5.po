#. y4:msg_decision_choices=1. Exchange -> T5.P7 | 2. Come Back Later -> T5.P6
msgctxt "524_Akaishi"
msgid "Would you like to exchange them?"
msgstr "¿Le gustaría intercambiarlos por una recompensa?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
