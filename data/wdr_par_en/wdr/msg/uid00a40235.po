#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Hear Him Out -> T0.P3 | 2. Turn Him Down -> T0.P1
msgctxt "176_Man in Black"
msgid "Have you reconsidered, Saejima-san?"
msgstr "¿Has cambiado de parecer, Saejima-san?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Turn Him Down
msgctxt "188_Saejima"
msgid "Sorry. Not interested. Find someone else."
msgstr "Lo lamento. No me interesa. Búscate a alguien más."

msgctxt "200_Man in Black"
msgid "I really do think you'd find this job worth your while.\\r\n"
"I'll be here if you change your mind."
msgstr "De verdad creo que este trabajo te viene como anillo al dedo.\\r\n"
"Estaré por aquí si cambias de opinión."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Hear Him Out
msgctxt "212_Saejima"
msgid "I don't come cheap, y'know."
msgstr "No salgo barato, ¿sabes?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Man in Black
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Hear Him Out
msgctxt "224_Man in Black"
msgid "I understand. But I'm happy to hear you're interested."
msgstr "Comprendo. Pero me alegra oír que estés interesado."

msgctxt "236_Takeda"
msgid "I'm Takeda, a manager at Oyamada Talent Productions.\\r\n"
"Let's head to our office to discuss the particulars."
msgstr "Me llamo Takeda, soy un manager en Oyamada Talent Productions.\\r\n"
"Acompañame a mi oficina para discutir los detalles."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Man in Black
#. y4:msg_speaker_id=0
msgctxt "284_Man in Black"
msgid "Excuse me, are you Saejima-san?"
msgstr "Perdona, ¿eres Saejima-san?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "296_Saejima"
msgid "Who's askin'?"
msgstr "¿Quién pregunta?"

msgctxt "308_Man in Black"
msgid "A friend. I'm a respectable businessman, I assure you.\\r\n"
"I've been looking for you."
msgstr "Un amigo. Me considero un hombre de negocios respetable, eso te lo garantizo.\\r\n"
"Llevo tiempo buscándote."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=4
#. y4:msg_location=T2.P4
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "320_Saejima"
msgid "How'd ya hear 'bout me, anyhow?"
msgstr "¿Cómo supiste sobre mí?"

msgctxt "332_Man in Black"
msgid "You can relax. I just happen to have some homeless men\\r\n"
"in my circle of acquaintances."
msgstr "Puedes estar relajado. Resulta que tengo a unos cuantos sin techo\\r\n"
"en mi lista de contactos."

msgctxt "344_Man in Black"
msgid "I asked one if he knew anybody who could help me out,\\r\n"
"and your name came up."
msgstr "Le pregunté a uno si conocía a alguien que me pudiera ayudar con algo,\\r\n"
"y surgió tu nombre."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=7
#. y4:msg_location=T2.P7
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "356_Saejima"
msgid "Alright, then. So whaddya want?"
msgstr "Bueno, entonces. ¿Qué es lo que quieres?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=8
#. y4:msg_location=T2.P8
#. y4:msg_speaker=Man in Black
#. y4:msg_speaker_id=0
msgctxt "368_Man in Black"
msgid "Actually, there's a little, uh, job I'd like you to do."
msgstr "De hecho, te tengo un pequeño, eh, trabajito con el que me gustaría que me ayudaras."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=9
#. y4:msg_location=T2.P9
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "380_Saejima"
msgid "A paying job?"
msgstr "¿Y ese trabajito es remunerado?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=10
#. y4:msg_location=T2.P10
#. y4:msg_speaker=Man in Black
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=1
#. y4:msg_decision_choices=1. Hear Him Out -> T2.P11 | 2. Turn Him Down -> T2.P15
msgctxt "392_Man in Black"
msgid "Yes. Can you spare a moment to hear more about it?"
msgstr "Claro que sí. ¿Me das un momento para explicártelo más a fondo?"

