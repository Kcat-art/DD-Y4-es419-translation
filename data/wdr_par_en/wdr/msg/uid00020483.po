#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Young Man
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Yeah, I got 'em.
msgctxt "228_Young Man"
msgid "...I don't see two silver plates. You're gonna walk out of here empty-handed until you satisfy your end of the bargain. Sorry about that."
msgstr "No los tienes, ¿verdad? Solo obtendrás la información cuando los consigas."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
