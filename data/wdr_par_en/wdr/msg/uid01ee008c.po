msgctxt "484_Player"
msgid "(Haruka's with me. What should I do?)"
msgstr "(Haruka está conmigo. ¿Qué podría hacer?)"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=4
#. y4:msg_phrase=3
#. y4:msg_location=T4.P3
