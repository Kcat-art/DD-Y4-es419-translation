#. y4:msg_speaker_id=0
msgctxt "4860_望月京子：源氏名"
msgid "Yeah, but if you're gonna dream, you might as well dream big, right?"
msgstr "Si, pero si tuviera un sueño, podría soñar en mas grande, ¿no?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "4872_望月京子：源氏名"
msgid "I want to impress people all over the world by singing my songs and playing my guitar."
msgstr "Quiero impresionar al mundo con mis canciones y junto con mi guitarra."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
