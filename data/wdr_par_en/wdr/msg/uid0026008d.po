msgctxt "56_Difficult Patron"
msgid "Help! He's gonna kill me!"
msgstr "¡A-ayuda! ¡Ese tipo me quiere matar!"

#. y4:line_status=translated
msgctxt "128_Casino Manager"
msgid "Thank you very much. For a moment there,\\r\nI wasn't sure what was going to happen."
msgstr "Gracias a Dios que esto salió mejor de lo que esperaba.\nSe lo agradezco mucho."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=3
msgctxt "140_Saejima"
msgid "Sorry for the ruckus."
msgstr "Perdón por el alboroto."

#. y4:line_status=translated
msgctxt "152_Casino Manager"
msgid "Not at all. You drove home an important point. We should\\r\nhave fewer troublemakers in here from now on."
msgstr "No tiene por qué disculparse. Les dio una buena lección.\nCon esto, estoy seguro de que empezaremos a ver menos\nbuscapleitos por aquí."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=3
msgctxt "164_Saejima"
msgid "Yeah? Hope so."
msgstr "Eso espero."

#. y4:line_status=translated
msgctxt "176_Casino Manager"
msgid "Now, about your payment. I'll be forwarding it\\r\nto Tadokoro-san, if that's all right with you."
msgstr "Y hablando de su paga, primero se lo haré llegar a\nTadokoro-san. Espero que no haya algún problema con eso."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=3
msgctxt "188_Saejima"
msgid "Yeah, no prob. We got an agreement, me and him."
msgstr "No, no lo hay. Tengo un trato con él."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Casino Manager
#. y4:msg_speaker_id=1
msgctxt "200_Casino Manager"
msgid "Very well. That's what I'll do, then."
msgstr "Muy bien. Entonces, así será."

#. y4:line_status=translated
msgctxt "212_Casino Manager"
msgid "And as a thank-you from me personally, I set aside\\r\nthese casino chips for you. Please take some time\\r\nto enjoy yourself, on the house."
msgstr "Quisiera darle un extra como agradecimiento de mi parte.\nPor favor, acepte estas fichas de casino. Cortesía de la\ncasa."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=3
msgctxt "236_Saejima"
msgid "Really? I appreciate that."
msgstr "Oh, vaya. Pues muchas gracias."

#. y4:line_status=translated
msgctxt "248_Casino Manager"
msgid "Come again for a game or two whenever you'd like.\\r\nWe'll be looking forward to seeing you."
msgstr "Puede pasar a jugar cuando quiera. Lo estaremos esperando\\r\ncon los brazos abiertos."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Casino Manager
#. y4:msg_speaker_id=1
msgctxt "260_Casino Manager"
msgid "Thanks again for your hard work today."
msgstr "Bueno, eso sería todo por hoy. Muchas gracias."
