#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Go ahead.
msgctxt "17292_Kiryu"
msgid "Sorry. I don't think I have enough money."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=34
#. y4:msg_section_label=Conversación 34
#. y4:msg_talk=115
#. y4:msg_phrase=4
#. y4:msg_location=T115.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Go ahead.
msgctxt "17304_Maya"
msgid "Huh!? You don't? That's disappointing..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=34
#. y4:msg_section_label=Conversación 34
#. y4:msg_talk=115
#. y4:msg_phrase=5
#. y4:msg_location=T115.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=No.
msgctxt "17316_Maya"
msgid "Aw. I never thought you were the cheap type."
msgstr ""

msgctxt "17328_Maya"
msgid "You're the romantic type, aren't you? I was so happy that you replied to my email. <Color:7>♥<Color:Default>"
msgstr "Eres del tipo romántico, ¿no? Estaba muy feliz cuando respondiste mi correo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=116
#. y4:msg_phrase=1
#. y4:msg_location=T116.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "17340_Kiryu"
msgid "Heh. It was nothing."
msgstr "Je, je. No fue nada."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=117
#. y4:msg_phrase=0
#. y4:msg_location=T117.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "17352_Maya"
msgid "The wrap party for that modeling job I emailed you about was so much fun! We went to the coolest little bar I've seen."
msgstr "La fiesta de despedida del trabajo de modelo de la que te hablé fue muy divertida. Fuimos al bar más genial que he visto."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=117
#. y4:msg_phrase=1
#. y4:msg_location=T117.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "17364_Kiryu"
msgid "That's nice."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=117
#. y4:msg_phrase=2
#. y4:msg_location=T117.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "17376_Maya"
msgid "They had some weird drinks there. I'd love to go back sometime."
msgstr "Tenían algunas bebidas curiosas. Me encantaría volver alguna vez."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=117
#. y4:msg_phrase=3
#. y4:msg_location=T117.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "17388_Kiryu"
msgid "Is drinking all you can talk about?"
msgstr "¿Solo sabes hablar sobre bebidas?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=118
#. y4:msg_phrase=0
#. y4:msg_location=T118.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "17400_Maya"
msgid "Like I wrote in my email, if you dress a child in fashionable clothes, they'll develop a good sense of fashion."
msgstr "Tal como escribí en mi email, si vistes a un niño con ropa de moda, cuando crezca desarrollará un gusto por la moda."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=118
#. y4:msg_phrase=1
#. y4:msg_location=T118.P1
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "17412_Maya"
msgid "So when I have a kid, I'll give her a thorough education about clothes."
msgstr "Así que cuando tenga un hijo, le daré una educación muy completa sobre la ropa."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=118
#. y4:msg_phrase=2
#. y4:msg_location=T118.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "17424_Kiryu"
msgid "Heh. I've never heard of a mother who wants to focus her child's education on fashion."
msgstr "Je. Nunca he oído hablar de una madre que se centre en la educación de su hijo en la moda."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=119
#. y4:msg_phrase=0
#. y4:msg_location=T119.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "17436_Maya"
msgid "Being so busy that I don't have time to party may be healthier for me. I don't end up staying out all night."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=119
#. y4:msg_phrase=1
#. y4:msg_location=T119.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "17448_Kiryu"
msgid "And you drink less, too."
msgstr "Y también bebes menos."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=119
#. y4:msg_phrase=2
#. y4:msg_location=T119.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "17460_Maya"
msgid "You're right! I owe my good health to everybody who helps me do my job here."
msgstr "¡Tiene razón! Debo mi buena salud a todos los que me ayudan a hacer mi trabajo aquí."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=120
#. y4:msg_phrase=0
#. y4:msg_location=T120.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "17472_Maya"
msgid "Even when I walk around with a hat and sunglasses, my fans can still recognize me."
msgstr "Incluso cuando voy por ahí con sombrero y gafas de sol, mis fans suelen reconocerme."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=120
#. y4:msg_phrase=1
#. y4:msg_location=T120.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "17484_Kiryu"
msgid "Well, you do stand out. After all, you keep getting stopped by the police."
msgstr "Bueno, sí que destacas. Después de todo, te sigue deteniendo la policía."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=120
#. y4:msg_phrase=2
#. y4:msg_location=T120.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "17496_Maya"
msgid "Hahaha! I don't mind when I get stopped by a fan, though!"
msgstr "¡Ja, ja, ja! ¡Pero no me importa que me pare un admirador!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
