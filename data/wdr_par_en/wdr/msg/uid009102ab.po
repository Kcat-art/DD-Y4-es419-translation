msgid "*speaking Tagalog*"
msgstr "*Naghahanap ako ng tao*"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Officer
#. y4:msg_speaker_id=2
msgctxt "92_Officer"
msgid "You wouldn't happen to speak English as well, would you?"
msgstr "¿Eh?... ¿No puedes hablar al menos inglés?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Woman
#. y4:msg_speaker_id=1
msgctxt "104_Woman"
msgid "*speaking Tagalog*"
msgstr "*Naghahanap ako ng tao*"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Officer
#. y4:msg_speaker_id=2
msgctxt "116_Officer"
msgid "It's no use. She doesn't understand a word I say."
msgstr "Esto es inútil... No me entiende."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "128_Tanimura"
msgid "Hey there, officer."
msgstr "Hola, oficial. Gracias por su arduo trabajo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Officer
#. y4:msg_speaker_id=2
msgctxt "140_Officer"
msgid "Oh, Tanimura-san! You couldn't have come at a better time!"
msgstr "¡Oh, Tanimura-san! ¡Llegas justo a tiempo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "152_Tanimura"
msgid "Is something wrong?"
msgstr "¿Pasa algo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Officer
#. y4:msg_speaker_id=2
msgctxt "164_Officer"
msgid "No, but it sounds like this woman is looking for someone. But she can't speak Japanese, so I'm not really sure what to do."
msgstr "No, pero da la impresión de que esta mujer busca a alguien.\nEl problema es que no habla japonés, así que no estoy seguro\nde como ayudarla."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Officer
#. y4:msg_speaker_id=2
msgctxt "176_Officer"
msgid "I was trying to get her to follow me back to the station so we could have an interpreter help us, but she doesn't seem keen on leaving this spot."
msgstr "Estaba tratando de hacerle entender que me siguiera a la\nestación para que un intérprete pudiera auxiliarla, pero no\nparece querer moverse de este lugar."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "188_Tanimura"
msgid "I see. I'll take things from here."
msgstr "Ah, ya entiendo. Déjamelo a mí."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Officer
#. y4:msg_speaker_id=2
msgctxt "200_Officer"
msgid "Thanks and sorry about this. Can I leave her to you then?"
msgstr "Gracias y disculpa la molestia.\n¿Puedo encargártela entonces?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "212_Tanimura"
msgid "No worries. If you had taken her to the station I would have been the interpreter anyways. So it saves time if I just do it here instead."
msgstr "No te preocupes. Si la hubieras llevado a la estación,\nyo tendría que hacer de intérprete de todas formas.\nAsí que ahorramos tiempo si me quedo con ella."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Officer
#. y4:msg_speaker_id=2
msgctxt "224_Officer"
msgid "Heheh. You got a point there. Thanks again."
msgstr "Je, je... Tienes razón. Entonces, gracias, la dejo en tus manos."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "248_Tanimura"
msgid "Well then."
msgstr "Bien, entonces."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "260_Tanimura"
msgid "[I'm a police officer. You can talk to me about whatever it is you're having trouble with.]"
msgstr "[Yo también soy oficial de policía. Si tienes algún problema,\npuedes hablarlo conmigo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Woman
#. y4:msg_speaker_id=1
msgctxt "272_Woman"
msgid "[Great! I finally found someone I can actually converse with!]"
msgstr "[¡Por fin! ¡Alguien con quien puedo conversar!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "284_Tanimura"
msgid "[My name is Tanimura. I'm with the Tokyo Metro Police Department. Who are you?]"
msgstr "[Me llamo Tanimura. Soy miembro del departamento de la policía\nmetropolitana de Tokio. ¿Me puedes decir quién eres?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Woman
#. y4:msg_speaker_id=1
msgctxt "296_Woman"
msgid "[I'm Nair. This is my first trip to Japan, and I still haven't got my bearings quite yet.]"
msgstr "[Yo soy Nair. Esta es mi primera vez en Japón, y todavía no\nme he podido orientar del todo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "308_Tanimura"
msgid "[Nair... Nice to meet you. I'm guessing you're from Southeast Asia?]"
msgstr "[Nair ¿eh?... Es un placer. Supongo que vienes del\nsudeste asiático, ¿no?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "320_Tanimura"
msgid "[Anyways, you're looking for someone right?]"
msgstr "[Entonces, ¿estás buscando a alguien, cierto?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "332_Nair"
msgid "[That's right. Well, actually I'm a detective too.]"
msgstr "[Así es. Bueno, en realidad, yo también soy detective.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "344_Tanimura"
msgid "[You? A detective?]"
msgstr "[¿Eres detective?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "356_Nair"
msgid "[That's right. I've followed a criminal to Japan to bring him to justice.]"
msgstr "[Así es. Vine a Japón tras un criminal que debe\nser llevado ante la justicia.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "368_Tanimura"
msgid "[Can you just do that? Do the Japanese police know what you're up to here?]"
msgstr "[¿Y eso puedes hacerlo así sin más? ¿La policía japonesa está\nal tanto de esto?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "380_Nair"
msgid "[I contacted the Japanese police before I left. They're supposed to be helping...]"
msgstr "[Me aseguré de contactarme con la policía japonesa antes de\nvenir. Se suponía que me ayudarían con la operación, pero...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "392_Nair"
msgid "[But once I got here everyone seemed so busy. No one would help me with my investigation.]"
msgstr "[Cuando llegué a Kamurocho, todos los policías parecían muy\nocupados, y ninguno me dio una mano en la investigación.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "404_Tanimura"
msgid "[Oh, I see. Everything's a bit of a mess right now, so I bet not everyone knows you're even here.]"
msgstr "[Ah, entiendo. Ahora mismo las cosas están un poco complicadas,\nasí que seguro muchos ni siquiera saben que estas aquí.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "416_Nair"
msgid "[I was also told I would be given an interpreter.]"
msgstr "[Comprendo. Aunque también se suponía que iba a tener\nun intérprete.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=31
#. y4:msg_location=T0.P31
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "428_Tanimura"
msgid "[And I'm guessing you didn't get that either? I apologize for the inconvenience.]"
msgstr "[Uh, y supongo que tampoco lo recibiste. Te pido disculpas por\ncualquier inconveniente.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=32
#. y4:msg_location=T0.P32
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "440_Nair"
msgid "[It's not your fault. I'm just happy to finally talk to someone I can understand.]"
msgstr "[No es culpa tuya, al contrario. Me alegra poder hablar\ncon alguien que pueda entenderme.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "452_Tanimura"
msgid "[Glad to be of assistance.]"
msgstr "[Me alegro de poder ayudar.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=34
#. y4:msg_location=T0.P34
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "464_Nair"
msgid "[But I have a little dilemma.]"
msgstr "[Pero tengo un problemita...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=35
#. y4:msg_location=T0.P35
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "476_Nair"
msgid "[We have permission to investigate, but we don't have the authority to make arrests.]"
msgstr "[Tenemos la autorización para proceder con la investigación,\ny todo eso. Pero no tenemos autorización para hacer arrestos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=36
#. y4:msg_location=T0.P36
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "488_Nair"
msgid "[In Japan, only the Japanese police are allowed to make arrests.]"
msgstr "[Al parecer en Japón, solo la policía local puede hacerlo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=37
#. y4:msg_location=T0.P37
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "500_Tanimura"
msgid "[You've got a point there, but it's not our investigation. We can't make an arrest without sufficient evidence.]"
msgstr "[Bueno, sí..., pero no es nuestra investigación. Si no hay\nevidencia suficiente, no podemos arrestar a nadie.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=38
#. y4:msg_location=T0.P38
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "512_Nair"
msgid "[There is evidence. That's why my colleagues and I came to Japan, hoping for some help from you guys.]"
msgstr "[Hay suficiente evidencia. Por eso mis compañeros y yo vinimos\na Japón, esperando alguna cooperación con algunos de los tuyos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=39
#. y4:msg_location=T0.P39
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "524_Tanimura"
msgid "[Colleagues?]"
msgstr "[¿Tus compañeros?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=40
#. y4:msg_location=T0.P40
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "536_Nair"
msgid "[They're out at the embassy now.]"
msgstr "[Ahora mismo ellos están en la embajada.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=41
#. y4:msg_location=T0.P41
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "548_Nair"
msgid "[Tanimura-san, would you come with me for a bit?]"
msgstr "[Tanimura-san, ¿podría acompañarme un momento?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=47
#. y4:msg_location=T0.P47
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "620_Tanimura"
msgid "[What is this place?]"
msgstr "[¿Qué es este lugar?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=48
#. y4:msg_location=T0.P48
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "632_Nair"
msgid "[We don't have cell phones that work in Japan right now, so this is our rendezvous point.]"
msgstr "[Como no tenemos una manera de comunicarnos en Japón, este es\nnuestro punto de encuentro.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=49
#. y4:msg_location=T0.P49
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "644_Tanimura"
msgid "[I see now. That's why you couldn't follow that officer to the police station.]"
msgstr "[Oh..., ahora entiendo por qué no querías irte del lugar, a\npesar de que aquel policía quería llevarte a la comisaria.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=50
#. y4:msg_location=T0.P50
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "656_Nair"
msgid "[The criminal we're seeking won't be in Japan for long. So we have to investigate quickly, along with the embassy and Japanese police.]"
msgstr "[El criminal que estamos buscando no estará en Japón por mucho.\nAsí que, tenemos que movernos lo más rápido posible y trabajar\njunto a la policía japonesa y la embajada.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=51
#. y4:msg_location=T0.P51
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "668_Nair"
msgid "[Tanimura-san, would you please help us? We have to catch our criminal!]"
msgstr "[¿Nos ayudará, Tanimura-san? Por favor. Necesitamos atrapar\na este criminal.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=52
#. y4:msg_location=T0.P52
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "680_Tanimura"
msgid "[Me?]"
msgstr "[¿Eh? ¿Yo?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=53
#. y4:msg_location=T0.P53
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "692_Nair"
msgid "[Yes, I beg of you! We'll take care of the investigation, but we need you to come along to make the arrest.]"
msgstr "[¡Sí, por favor! Nosotros haremos la investigación, pero\nnecesitamos que nos acompañes para arrestarlo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=54
#. y4:msg_location=T0.P54
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "704_Tanimura"
msgid "[I'm not sure...]"
msgstr "[Mmm... No sé.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=55
#. y4:msg_location=T0.P55
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "716_Tanimura"
msgid "(This sounds like more trouble than it's worth, but I guess the station will make me do it later, even if refuse right now.)"
msgstr "(Suena a otro problema más, pero seguramente los de la comisaria\nme encargarán ocuparme de esto de todas maneras, por más que me\nrehúse hacerlo ahora.)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=56
#. y4:msg_location=T0.P56
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "728_Tanimura"
msgid "(If that's the case, then it'd be easier for me if I did this my way.)"
msgstr "(Me conviene hacerlo por mi cuenta, será más fácil para mí\nsi lo hago de esta manera.)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=57
#. y4:msg_location=T0.P57
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "740_Tanimura"
msgid "[All right. I'll help.]"
msgstr "[Está bien. Te ayudaré.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=58
#. y4:msg_location=T0.P58
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "752_Nair"
msgid "[Really!? Thank you! Thank you, Tanimura-san!]"
msgstr "[¡¿De verdad?! ¡Gracias! ¡Muchas gracias, Tanimura-san!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=59
#. y4:msg_location=T0.P59
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "764_Tanimura"
msgid "[By the way, I have no problem arresting the criminal, but you guys don't have guns, right? Isn't that dangerous?]"
msgstr "[No tengo problema con darte una mano con el arresto, pero\nustedes van sin armas, ¿no? ¿No te parece un poco arriesgado?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=60
#. y4:msg_location=T0.P60
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "776_Nair"
msgid "[I don't usually carry a gun. A police officer's job is to capture criminals, not kill them.]"
msgstr "[No solemos portar un arma. El trabajo de un policía es\ncapturar criminales, no matarlos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=61
#. y4:msg_location=T0.P61
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "788_Tanimura"
msgid "[If that's true, you've done a good job at staying alive. Don't you have dangerous cases?]"
msgstr "[Con la cantidad de incidentes que hay últimamente, me sorprende\nque no te haya pasado nada.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=62
#. y4:msg_location=T0.P62
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "800_Nair"
msgid "[I may not look it, but I pack a pretty strong punch. Stronger than any of the gangs here.]"
msgstr "[Aunque no lo parezca, tengo un golpe muy efectivo. No perdería\ncontra ninguno de los delincuentes comunes de por aquí.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=63
#. y4:msg_location=T0.P63
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "812_Tanimura"
msgid "[Really? I wouldn't have guessed.]"
msgstr "[¿Eh? ¿De verdad? No lo parece.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=64
#. y4:msg_location=T0.P64
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "824_Nair"
msgid "[I can't win a head-on slugfest with men though. I use their own strength against them.]"
msgstr "[No podría ganarle un mano a mano, a un hombre. Lo que hago\nes utilizar su propia fuerza contra ellos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=65
#. y4:msg_location=T0.P65
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "836_Tanimura"
msgid "[So you're good at parrying, I guess? I prefer countering to simple brawls too, so I can understand your logic.]"
msgstr "[Ah, entonces, ¿eres buena contraatacando? Yo también prefiero\nmanejar la fuerza del oponente que hacerlo a puño limpio.\nAsí que, más o menos, entiendo la idea.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=66
#. y4:msg_location=T0.P66
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "848_Nair"
msgid "[Oh yeah? We should try sparring together then!]"
msgstr "[Ah, ¿sí? ¡Entonces, deberíamos tener un sparring juntos!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=67
#. y4:msg_location=T0.P67
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "860_Tanimura"
msgid "[Sparring?]"
msgstr "[¿Un sparring?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=68
#. y4:msg_location=T0.P68
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "872_Nair"
msgid "[Yeah. That way we can share techniques and help each other get better. Sparring is important, no matter what martial art you practice.]"
msgstr "[Exacto. Así podremos compartir técnicas y ayudarnos mutuamente.\nPracticar y mejorar, es muy importante sin importar el arte\nmarcial que desempeñes.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=69
#. y4:msg_location=T0.P69
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "884_Tanimura"
msgid "[I dunno if my style could be called a martial art...]"
msgstr "[Eh... no sé, mi forma de pelear no podría considerarse un\narte marcial.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=70
#. y4:msg_location=T0.P70
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "896_Tanimura"
msgid "[But all right. While we spar you can update me on the progress of the investigation.]"
msgstr "[Pero bueno, está bien. Mientras luchamos aprovecharé para\npreguntarte sobre la investigación.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=71
#. y4:msg_location=T0.P71
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "908_Nair"
msgid "[Sounds great. You can come here anytime and I'll fill you in.]"
msgstr "[Genial. Puedes venir cuando quieras y te pondré al tanto.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=72
#. y4:msg_location=T0.P72
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "920_Tanimura"
msgid "[Okay. When I have time then.]"
msgstr "[Bien, cuando tenga un rato libre me pasaré.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=73
#. y4:msg_location=T0.P73
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "932_Nair"
msgid "[Oh yeah, I was meaning to ask you something else.]"
msgstr "[Ah, por cierto, quería preguntarte una cosa...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=74
#. y4:msg_location=T0.P74
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "944_Nair"
msgid "[Have you heard of <Color:7>Revelations<Color:Default>?]"
msgstr "[¿Conoces las <Color:7>Revelaciones<Color:Default>?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=75
#. y4:msg_location=T0.P75
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "956_Tanimura"
msgid "[Revelations?]"
msgstr "[¿Revelaciones?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=76
#. y4:msg_location=T0.P76
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "968_Nair"
msgid "[Yeah, I heard there are times you can have epic <Color:7>Revelations<Color:Default>, just by witnessing certain special events throughout the city.]"
msgstr "[Sí, se supone que hay momentos donde puedes tener increíbles\n<Color:7>Revelaciones<Color:Default>, solo con presenciar ciertos sucesos\nespeciales mientras vas por la ciudad.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=77
#. y4:msg_location=T0.P77
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "980_Nair"
msgid "[People like us that train regularly can use that inspiration to discover new techniques.]"
msgstr "[Las personas como nosotros, que entrenamos\nconstantemente, tenemos esa chispa de inspiración\npara descubrir nuevas técnicas.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=78
#. y4:msg_location=T0.P78
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "992_Tanimura"
msgid "[Revelations, huh. I think I understand, but I'm not sure I know how it works.]"
msgstr "[Revelaciones, Mm... Creo que lo entiendo, pero no estoy seguro\nde como funciona.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=79
#. y4:msg_location=T0.P79
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "1004_Nair"
msgid "[When you witness the perfect shot, make sure to record it somehow!]"
msgstr "[Cuando presencies el momento perfecto.\n¡Asegúrate de registrarlo de alguna manera!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=80
#. y4:msg_location=T0.P80
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "1016_Nair"
msgid "[At least that's what someone told me.]"
msgstr "[...Eso fue lo que me dijo una persona que conocí hace poco.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=81
#. y4:msg_location=T0.P81
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "1028_Nair"
msgid "[I've been keeping memos of the various new things I've seen since coming to Japan, and I already have some technique-worthy material.]"
msgstr "[He estado tomando notas de las distintas cosas nuevas que he visto en Japón, y ya tengo suficiente material con potencial para desarrollar técnicas]."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=82
#. y4:msg_location=T0.P82
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "1040_Tanimura"
msgid "[That's interesting. I'll try using the notepad I always carry the next time I see something.]"
msgstr "[Interesante. La próxima vez, intentaré anotar lo que vea\nen mi bloc de notas.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=83
#. y4:msg_location=T0.P83
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "1052_Nair"
msgid "[Worth a try. I'll keep an eye out for things going on around town too.]"
msgstr "[Valdrá la pena. Yo también voy a estar atenta por si me\nencuentro algo interesante por la ciudad.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=84
#. y4:msg_location=T0.P84
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=9
msgctxt "1064_Nair"
msgid "[Anyways, sorry to ask so much of you. I may not be here for long, but I appreciate your help.]"
msgstr "[En fin, discúlpame por pedirte tanto. Puede que no me quede\nmucho tiempo en la ciudad, pero agradezco tu ayuda.]"

#. y4:line_status=translated
msgctxt "1076_Tanimura"
msgid "This information has been added as a <Color:14>memo<Color:Default>.\\r\nRead <Color:14>memos<Color:Default> by selecting <Color:14>Memos<Color:Default> in the Pause Menu.\\r\nYou can access the Pause Menu with the <Action:Button_Options@Adventure> button."
msgstr "Esta información ha sido añadida como una <Color:14>nota<Color:Default>.\\r\nLee las <Color:14>notas<Color:Default> seleccionando <Color:14>Notas<Color:Default> en el menú de pausa.\\r\nPuedes acceder al menú de pausa con el botón <Action:Button_Options@Adventure>."
