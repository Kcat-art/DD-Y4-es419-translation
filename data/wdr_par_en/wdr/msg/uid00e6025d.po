#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Panicking Man
#. y4:msg_speaker_id=0
msgctxt "204_Panicking Man"
msgid "Where the hell is he? We can't wait any longer, yo."
msgstr "¿Dónde demonios está? No podemos esperar más."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Angry Man
#. y4:msg_speaker_id=2
msgctxt "216_Angry Man"
msgid "What's holdin' him up? He won't even answer his frickin' phone."
msgstr "¿Por qué tarda tanto? Ni siquiera contesta su maldito teléfono."

#. y4:line_status=translated
msgctxt "228_Panicking Man"
msgid "Psh. At this rate, it'd be quicker to just find some random\\r\nguy on the street and have him go with us."
msgstr "Psh. A este ritmo, sería más rápido encontrar a algún desconocido\\r\nen la calle y que vaya con nosotros."

#. y4:line_status=translated
msgctxt "240_Angry Man"
msgid "I'm with you, man. He's gotta be at least as good-looking\\r\nas us. Hopefully even moreso."
msgstr "Estoy contigo, amigo. Tiene que ser al menos igual de guapo\\r\ncomo nosotros. Esperemos que aún más."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Panicking Man
#. y4:msg_speaker_id=0
msgctxt "252_Panicking Man"
msgid "Let's see... Good-looking... Hey, how about that guy?"
msgstr "Veamos... Guapo... Oye, ¿qué tal ese tipo?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
msgctxt "276_Tanimura"
msgid "...Hm?"
msgstr "... ¿Mm?"

#. y4:line_status=translated
msgctxt "288_Angry Man"
msgid "No way! That dude looks way too good. Did you forget the\\r\nwhole point of this party!?"
msgstr "¡No puede ser! Ese tipo se ve demasiado bien. ¡¿Olvidaste el propósito de esta fiesta?!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Panicking Man
#. y4:msg_speaker_id=0
msgctxt "300_Panicking Man"
msgid "Well, you said \"good-looking,\" so..."
msgstr "Bueno, dijiste \"guapo\", así que..."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
msgctxt "312_Tanimura"
msgid "You two talking about me?"
msgstr "¿Ustedes dos están hablando de mí?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Angry Man
#. y4:msg_speaker_id=2
msgctxt "324_Angry Man"
msgid "Uh! Well, er, the thing is... Hahaha..."
msgstr "¡Uh! Bueno, eh, la cosa es que... Ja, ja, ja..."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Panicking Man
#. y4:msg_speaker_id=0
msgctxt "336_Panicking Man"
msgid "The truth is, we're on our way to a mixer and one of the guys didn't show. So we're looking for someone else to go in his place."
msgstr "La verdad es que vamos a un encuentro y uno de los chicos no se presentó. Así que estamos buscando a alguien más que lo reemplace."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=12
#. y4:msg_location=T1.P12
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
msgctxt "348_Tanimura"
msgid "A mixer? You mean one of those group-date parties?"
msgstr "¿Un encuentro? ¿Te refieres a una de esas fiestas de citas grupales?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Panicking Man
#. y4:msg_speaker_id=0
msgctxt "360_Panicking Man"
msgid "Yeah. My friend here is the one who arranged everything. It was supposed to be three guys and three girls, but now we're short one guy."
msgstr "Sí. Mi amigo aquí es el que arregló todo. Se suponía que iban a ser tres chicos y tres chicas, pero ahora nos falta un chico."

#. y4:line_status=translated
msgctxt "372_Angry Man"
msgid "Yeah, so that's what's up. You, uh, wouldn't mind joining\\r\nus, would you?"
msgstr "Sí, eso es lo que pasa. A ti, eh, ¿No te importaría unirte\\r\na nosotros, lo harías?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
msgctxt "384_Tanimura"
msgid "Me?"
msgstr "¿Yo?"

#. y4:line_status=translated
msgctxt "396_Angry Man"
msgid "Yeah! All you gotta do is come chow down and knock back some brews with us for a couple hours. Everything's totally on us－heck, we'll even slip you some extra cash!"
msgstr "¡Sí! Todo lo que tienes que hacer es venir a comer y tomar algunas cervezas con nosotros durante un par de horas. Todo depende totalmente de nosotros, ¡incluso te daremos algo de dinero extra!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=17
#. y4:msg_location=T1.P17
#. y4:msg_speaker=Panicking Man
#. y4:msg_speaker_id=0
msgctxt "408_Panicking Man"
msgid "(Yusuke, are you sure? I thought you said he was too good-looking?)"
msgstr "(Yusuke, ¿estás seguro? ¿Pensé que habías dicho que era demasiado guapo?)"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=18
#. y4:msg_location=T1.P18
#. y4:msg_speaker=Angry Man
#. y4:msg_speaker_id=2
msgctxt "420_Angry Man"
msgid "(Dude, who cares! We're out of time here. What other choice do we have!?)"
msgstr "(¡Amigo, a quién le importa! No tenemos tiempo aquí. ¡¿Qué otra opción tenemos?!)"

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=19
#. y4:msg_location=T1.P19
#. y4:msg_speaker=Angry Man
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. I think I'll pass. -> T1.P20 | 2. All right, fine. -> T1.P23
msgctxt "432_Angry Man"
msgid "So how about it, man? Down to mix it up with us and a couple of fine young ladies?"
msgstr "Entonces, ¿qué dices, amigo? ¿Te animas a juntarte con nosotros y un par de chicas guapas?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=20
#. y4:msg_location=T1.P20
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I think I'll pass.
msgctxt "444_Tanimura"
msgid "Sorry, ask someone else. I've got things to do."
msgstr "Lo siento, pregunta a otra persona. Tengo cosas que hacer."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=21
#. y4:msg_location=T1.P21
#. y4:msg_speaker=Angry Man
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I think I'll pass.
msgctxt "456_Angry Man"
msgid "Oh, okay... Damn. Sorry to bother you."
msgstr "Oh, está bien... Diablos. Lo siento por molestarte."

#. y4:line_status=translated
msgctxt "468_Panicking Man"
msgid "If anything, we'll be looking around here for a while.\\r\nCome through if you change your mind!"
msgstr "En todo caso, estaremos dando vueltas por aquí por un rato más.\\r\n¡Únetenos si cambias de opinión!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=23
#. y4:msg_location=T1.P23
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "480_Tanimura"
msgid "I guess there are worse ways to kill time... All right, fine. I'll tag along."
msgstr "Supongo que hay peores formas de matar el tiempo... Muy bien, tú ganas. Te acompañaré."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=24
#. y4:msg_location=T1.P24
#. y4:msg_speaker=Panicking Man
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "492_Panicking Man"
msgid "For real!? Wow, thanks, man!"
msgstr "¡¿De verdad?! ¡Vaya, gracias, hombre!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=25
#. y4:msg_location=T1.P25
#. y4:msg_speaker=Angry Man
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "504_Angry Man"
msgid "Well, we're running out of time, so let me explain real quick."
msgstr "Bueno, se nos está acabando el tiempo, así que déjame explicarte muy rápido."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=26
#. y4:msg_location=T1.P26
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "516_Yusuke"
msgid "I'm Yusuke, and I arranged this get-together. This here's Naoya, and the guy who flaked out on us like a total bitch is Ryota."
msgstr "Soy Yusuke, y yo organicé este encuentro. Este es Naoya, y el tipo que se rajó como un total idiota es Ryota."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=27
#. y4:msg_location=T1.P27
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "528_Yusuke"
msgid "Oh, mind if we ask your name?"
msgstr "Oh, ¿te importa si preguntamos tu nombre?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=28
#. y4:msg_location=T1.P28
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "540_Tanimura"
msgid "Sure. Masayoshi Tanimura."
msgstr "Claro. Masayoshi Tanimura."

#. y4:line_status=translated
msgctxt "552_Yusuke"
msgid "Masayoshi Tanimura...san. All right then. The only thing is,\\r\nwe already told the girls our names, and it'd be kind of\\r\nawkward to try and change one of them now."
msgstr "Masayoshi Tanimura... San. Muy bien, entonces. Lo único es que,\\r\nya les dijimos a las chicas nuestros nombres, y sería un poco\\r\nincómodo tratar de cambiar uno de ellos ahora."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=30
#. y4:msg_location=T1.P30
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "564_Tanimura"
msgid "Yeah, huh."
msgstr "Eh, sí."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=31
#. y4:msg_location=T1.P31
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "576_Yusuke"
msgid "So would you be cool with us calling you \"Ryota\" at the party?"
msgstr "¿Así que estarías bien con que te llamáramos 'Ryota' en la fiesta?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=32
#. y4:msg_location=T1.P32
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "588_Tanimura"
msgid "It might get a little confusing, but I guess I can handle that."
msgstr "Podría ser un poco confuso, pero creo que puedo manejarlo."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=33
#. y4:msg_location=T1.P33
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "600_Naoya"
msgid "Yusuke, aren't you gonna tell him?"
msgstr "Yusuke, ¿no vas a decirle?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=34
#. y4:msg_location=T1.P34
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "612_Yusuke"
msgid "About what?"
msgstr "¿De qué?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=35
#. y4:msg_location=T1.P35
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "624_Naoya"
msgid "About not hooking up with Akino-chan, of course!"
msgstr "¡Sobre no salir con Akino-chan, por supuesto!"

#. y4:line_status=translated
msgctxt "636_Yusuke"
msgid "Whoa, hey, dude! That's not even what I... Look, forget\\r\nabout Akino-chan! We're just here to have fun, all right!?"
msgstr "¡Wooaw, eh, amigo! Eso no es ni lo que yo... ¡Mira, olvídate de Akino-chan!\\r\n¡Solo estamos aquí para divertirnos, ¡¿de acuerdo?!"

#. y4:line_status=translated
msgctxt "648_Naoya"
msgid "Bullshit we are! What are you gonna do if this guy and\\r\nAkino-chan hit it off? It could happen, you know!"
msgstr "¡A la mierda que sí! ¿Qué vas a hacer si este tipo y Akino-chan se llevan bien?\\r\n¡Podría pasar, sabes!"

#. y4:line_status=translated
msgctxt "660_Yusuke"
msgid "Yeah... You're right. Man, just picturing it in my head\\r\nmakes me feel depressed..."
msgstr "Sí... Tienes razón. Amigo, solo imaginarlo en mi cabeza me hace sentir deprimido..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=39
#. y4:msg_location=T1.P39
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "672_Tanimura"
msgid "Is there a particular girl you're after?"
msgstr "¿Hay alguna chica en particular que te interese?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=40
#. y4:msg_location=T1.P40
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "684_Naoya"
msgid "Yeah. That's actually the whole point of this little mixer today."
msgstr "Sí. De hecho, ese es todo el propósito de este pequeño encuentro hoy."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=41
#. y4:msg_location=T1.P41
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "696_Tanimura"
msgid "Oh, okay. I get it now."
msgstr "Oh, está bien. Ya entiendo."

#. y4:line_status=translated
msgctxt "708_Naoya"
msgid "Do you think you could help Yusuke get closer to Akino-chan?\\r\nThis sonuvabitch is super desperate, so I'm sure he'll\\r\nreturn the favor somehow if everything works out!"
msgstr "¿Crees que podrías ayudar a Yusuke a acercarse a Akino-chan?\\r\nEste pendejo está súper desesperado, ¡así que estoy seguro de que te\\r\ndevolverá el favor de alguna manera si todo sale bien!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=43
#. y4:msg_location=T1.P43
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "720_Naoya"
msgid "Come on, Yusuke! Don't make me do all the talking!"
msgstr "¡Vamos, Yusuke! ¡No me hagas hacer toda la conversación!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=45
#. y4:msg_location=T1.P45
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "744_Yusuke"
msgid "Please! Help a brother out!"
msgstr "¡Por favor! ¡Ayuda a un hermano!"

#. y4:line_status=translated
msgctxt "756_Tanimura"
msgid "Hah, how can I say no to that? All right, so tell me about\\r\nthis girl, Akino."
msgstr "Ja, ja, ¿cómo puedo decir que no a eso? Bien, cuéntame sobre esta chica, Akino."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=47
#. y4:msg_location=T1.P47
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "768_Naoya"
msgid "She's the organizer on the girls' side. She's really outspoken, but she has her quirks, too."
msgstr "Es la organizadora del lado de las chicas. Es muy expresiva, pero también tiene sus peculiaridades."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=48
#. y4:msg_location=T1.P48
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "780_Yusuke"
msgid "She says she hates strong-smelling food, but she really likes garlicky gyoza. And she likes sweet cocktails, but gets tipsy pretty quick..."
msgstr "Dice que odia la comida con olores fuertes, pero le encantan los gyozas con ajo. Y le gustan los cócteles dulces, pero se emborracha bastante rápido..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=49
#. y4:msg_location=T1.P49
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "792_Naoya"
msgid "...But if you try to be nice and get her a soft drink, she'll pretty much chew your head off!"
msgstr "...Pero si intentas ser amable y le traes una bebida sin alcohol, ¡te va a morder la cabeza!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=50
#. y4:msg_location=T1.P50
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "804_Tanimura"
msgid "Okay... What about the other two?"
msgstr "Está bien... ¿Y qué hay de las otras dos?"

#. y4:line_status=translated
msgctxt "816_Yusuke"
msgid "Well, their names are Haruko-chan and Konatsu-chan, but this\\r\nis the first time we're meeting them. So who knows."
msgstr "Bueno, se llaman Haruko-chan y Konatsu-chan, pero esta es la primera vez que las\\r conocemos. Así que quién sabe."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=52
#. y4:msg_location=T1.P52
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "828_Naoya"
msgid "If you're into either one of them, feel free to have at it."
msgstr "Si te gusta alguna de ellas, siéntete libre de intentarlo."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=53
#. y4:msg_location=T1.P53
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "840_Tanimura"
msgid "What, you're not interested?"
msgstr "¿Qué, no estás interesado?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=54
#. y4:msg_location=T1.P54
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "852_Naoya"
msgid "Me? Nah, I already have a girl I like. I'll be happy as long as things go well for my boy Yusuke."
msgstr "¿Yo? Nah, ya tengo a una chica que me gusta. Estaré feliz mientras las cosas vayan bien para mi compita Yusuke."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=55
#. y4:msg_location=T1.P55
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "864_Yusuke"
msgid "Hey, thanks, man..."
msgstr "Oye, gracias, amigo..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=56
#. y4:msg_location=T1.P56
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "876_Naoya"
msgid "Okay, it's almost time. We need to act like we're all buddy-buddy now... One team, one dream, feel me? We'll be counting on you, \"Ryota\"!"
msgstr "Está bien, ya casi es hora. Necesitamos actuar como si fuéramos muy amigos ahora... Un equipo, un sueño, ¿me entiendes? ¡Contaremos contigo, 'Ryota'!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=57
#. y4:msg_location=T1.P57
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "888_Tanimura"
msgid "Sure. Hey, is that one of them?"
msgstr "Claro. Oye, ¿esa es una de ellas?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=59
#. y4:msg_location=T1.P59
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=16
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "912_Akino"
msgid "Hey, guys!"
msgstr "¡Hey, chicos!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=60
#. y4:msg_location=T1.P60
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "924_Yusuke"
msgid "Oh, Akino! Uh, it's been a while!"
msgstr "¡Oh, Akino! Uh, ¡ha pasado su tiempo!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=61
#. y4:msg_location=T1.P61
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=16
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "936_Akino"
msgid "It sure has! Well, it looks like you're all here. Thanks for setting things up on the guys' side."
msgstr "¡Ciertamente! Bueno, parece que todos están aquí. Gracias por organizar todo del lado de los chicos."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=62
#. y4:msg_location=T1.P62
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "948_Yusuke"
msgid "Sure thing! Are your other friends on their way?"
msgstr "¡De nada! ¿Las otras chicas están en camino?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=63
#. y4:msg_location=T1.P63
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=16
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "960_Akino"
msgid "Hmm? Oh, Haruko and Konatsu are already waiting at the restaurant. I just took the liberty to pick you guys up!"
msgstr "¿Hmm? Oh, Haruko y Konatsu ya están esperando en el restaurante. ¡Solo tomé la libertad de recogerlos!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=64
#. y4:msg_location=T1.P64
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "972_Naoya"
msgid "You're always so on top of things, Akino-chan!"
msgstr "¡Siempre estás tan al tanto de todo, Akino-chan!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=65
#. y4:msg_location=T1.P65
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=16
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "984_Akino"
msgid "Haha, you know me. Well, shall we?"
msgstr "Ja, ja, ya me conoces. Bueno, ¿vamos?"

#. y4:line_status=translated
msgctxt "1008_Angry Man"
msgid "So, um, about what we were saying before...\\r\nWill you join us at the mixer?"
msgstr "Así que, um, sobre lo que estábamos hablando antes...\\r\n¿Te unirás a nosotros en el encuentro?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=20
#. y4:msg_location=T1.P20
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I think I'll pass.
msgctxt "1020_Tanimura"
msgid "Sorry, ask someone else. I've got things to do."
msgstr "Lo siento, pregunta a otra persona. Tengo cosas que hacer."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Angry Man
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I think I'll pass.
msgctxt "1032_Angry Man"
msgid "Oh, okay... Sorry to bother you."
msgstr "Oh, está bien... Lo siento por molestarte."

#. y4:line_status=translated
msgctxt "1044_Panicking Man"
msgid "If anything, we'll be looking around here for a while.\\r\nCome through if you change your mind!"
msgstr "En todo caso, estaremos dando vueltas por aquí por un rato más.\\r\n¡Únetenos si cambias de opinión!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=23
#. y4:msg_location=T1.P23
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1056_Tanimura"
msgid "I guess there are worse ways to kill time... All right, fine. I'll tag along."
msgstr "Supongo que hay peores formas de matar el tiempo... Muy bien, tú ganas. Te acompañaré."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=24
#. y4:msg_location=T1.P24
#. y4:msg_speaker=Panicking Man
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1068_Panicking Man"
msgid "For real!? Wow, thanks, man!"
msgstr "¡¿De verdad?! ¡Vaya, gracias, hombre!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=25
#. y4:msg_location=T1.P25
#. y4:msg_speaker=Angry Man
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1080_Angry Man"
msgid "Well, we're running out of time, so let me explain real quick."
msgstr "Bueno, se nos está acabando el tiempo, así que déjame explicarte muy rápido."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=26
#. y4:msg_location=T1.P26
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1092_Yusuke"
msgid "I'm Yusuke, and I arranged this get-together. This here's Naoya, and the guy who flaked out on us like a total bitch is Ryota."
msgstr "Soy Yusuke, y yo organicé este encuentro. Este es Naoya, y el tipo que se rajó como un total idiota es Ryota."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=27
#. y4:msg_location=T1.P27
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1104_Yusuke"
msgid "Oh, mind if we ask your name?"
msgstr "Oh, ¿te importa si preguntamos tu nombre?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=28
#. y4:msg_location=T1.P28
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1116_Tanimura"
msgid "Sure. Masayoshi Tanimura."
msgstr "Claro. Masayoshi Tanimura."

#. y4:line_status=translated
msgctxt "1128_Yusuke"
msgid "Masayoshi Tanimura...san. All right then. The only thing is,\\r\nwe already told the girls our names, and it'd be kind of\\r\nawkward to try and change one of them now."
msgstr "Masayoshi Tanimura... San. Muy bien, entonces. Lo único es que,\\r\nya les dijimos a las chicas nuestros nombres, y sería un poco\\r\nincómodo tratar de cambiar uno de ellos ahora."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=30
#. y4:msg_location=T1.P30
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1140_Tanimura"
msgid "Yeah, huh."
msgstr "Eh, sí."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=31
#. y4:msg_location=T1.P31
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1152_Yusuke"
msgid "So would you be cool with us calling you \"Ryota\" at the party?"
msgstr "¿Así que estarías bien con que te llamáramos 'Ryota' en la fiesta?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=32
#. y4:msg_location=T1.P32
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1164_Tanimura"
msgid "It might get a little confusing, but I guess I can handle that."
msgstr "Podría ser un poco confuso, pero creo que puedo manejarlo."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=33
#. y4:msg_location=T1.P33
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1176_Naoya"
msgid "Yusuke, aren't you gonna tell him?"
msgstr "Yusuke, ¿no vas a decirle?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=34
#. y4:msg_location=T1.P34
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1188_Yusuke"
msgid "About what?"
msgstr "¿De qué?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=35
#. y4:msg_location=T1.P35
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1200_Naoya"
msgid "About not hooking up with Akino-chan, of course!"
msgstr "¡Sobre no salir con Akino-chan, por supuesto!"

#. y4:line_status=translated
msgctxt "1212_Yusuke"
msgid "Whoa, hey, dude! That's not even what I... Look, forget\\r\nabout Akino-chan! We're just here to have fun, all right!?"
msgstr "¡Wooaw, eh, amigo! Eso no es ni lo que yo... ¡Mira, olvídate de Akino-chan!\\r\n¡Solo estamos aquí para divertirnos, ¡¿de acuerdo?!"

#. y4:line_status=translated
msgctxt "1224_Naoya"
msgid "Bullshit we are! What are you gonna do if this guy and\\r\nAkino-chan hit it off? It could happen, you know!"
msgstr "¡A la mierda que sí! ¿Qué vas a hacer si este tipo y Akino-chan se llevan bien?\\r\n¡Podría pasar, sabes!"

#. y4:line_status=translated
msgctxt "1236_Yusuke"
msgid "Yeah... You're right. Man, just picturing it in my head\\r\nmakes me feel depressed..."
msgstr "Sí... Tienes razón. Amigo, solo imaginarlo en mi cabeza me hace sentir deprimido..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=39
#. y4:msg_location=T1.P39
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1248_Tanimura"
msgid "Is there a particular girl you're after?"
msgstr "¿Hay alguna chica en particular que te interese?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=40
#. y4:msg_location=T1.P40
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1260_Naoya"
msgid "Yeah. That's actually the whole point of this little mixer today."
msgstr "Sí. De hecho, ese es todo el propósito de este pequeño encuentro hoy."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=41
#. y4:msg_location=T1.P41
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1272_Tanimura"
msgid "Oh, okay. I get it now."
msgstr "Oh, está bien. Ya entiendo."

#. y4:line_status=translated
msgctxt "1284_Naoya"
msgid "Do you think you could help Yusuke get closer to Akino-chan?\\r\nThis sonuvabitch is super desperate, so I'm sure he'll\\r\nreturn the favor somehow if everything works out!"
msgstr "¿Crees que podrías ayudar a Yusuke a acercarse a Akino-chan?\\r\nEste pendejo está súper desesperado, ¡así que estoy seguro de que te\\r\ndevolverá el favor de alguna manera si todo sale bien!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=43
#. y4:msg_location=T1.P43
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1296_Naoya"
msgid "Come on, Yusuke! Don't make me do all the talking!"
msgstr "¡Vamos, Yusuke! ¡No me hagas hacer toda la conversación!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=45
#. y4:msg_location=T1.P45
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1320_Yusuke"
msgid "Please! Help a brother out!"
msgstr "¡Por favor! ¡Ayuda a un hermano!"

#. y4:line_status=translated
msgctxt "1332_Tanimura"
msgid "Hah, how can I say no to that? All right, so tell me about\\r\nthis girl, Akino."
msgstr "Ja, ja, ¿cómo puedo decir que no a eso? Bien, cuéntame sobre esta chica, Akino."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=47
#. y4:msg_location=T1.P47
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1344_Naoya"
msgid "She's the organizer on the girls' side. She's really outspoken, but she has her quirks, too."
msgstr "Es la organizadora del lado de las chicas. Es muy expresiva, pero también tiene sus peculiaridades."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=48
#. y4:msg_location=T1.P48
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1356_Yusuke"
msgid "She says she hates strong-smelling food, but she really likes garlicky gyoza. And she likes sweet cocktails, but gets tipsy pretty quick..."
msgstr "Dice que odia la comida con olores fuertes, pero le encantan los gyozas con ajo. Y le gustan los cócteles dulces, pero se emborracha bastante rápido..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=49
#. y4:msg_location=T1.P49
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1368_Naoya"
msgid "...But if you try to be nice and get her a soft drink, she'll pretty much chew your head off!"
msgstr "...Pero si intentas ser amable y le traes una bebida sin alcohol, ¡te va a morder la cabeza!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=50
#. y4:msg_location=T1.P50
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1380_Tanimura"
msgid "Okay... What about the other two?"
msgstr "Está bien... ¿Y qué hay de las otras dos?"

#. y4:line_status=translated
msgctxt "1392_Yusuke"
msgid "Well, their names are Haruko-chan and Konatsu-chan, but this\\r\nis the first time we're meeting them. So who knows."
msgstr "Bueno, se llaman Haruko-chan y Konatsu-chan, pero esta es la primera vez que las\\r conocemos. Así que quién sabe."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=52
#. y4:msg_location=T1.P52
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1404_Naoya"
msgid "If you're into either one of them, feel free to have at it."
msgstr "Si te gusta alguna de ellas, siéntete libre de intentarlo."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=53
#. y4:msg_location=T1.P53
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1416_Tanimura"
msgid "What, you're not interested?"
msgstr "¿Qué, no estás interesado?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=54
#. y4:msg_location=T1.P54
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1428_Naoya"
msgid "Me? Nah, I already have a girl I like. I'll be happy as long as things go well for my boy Yusuke."
msgstr "¿Yo? Nah, ya tengo a una chica que me gusta. Estaré feliz mientras las cosas vayan bien para mi compita Yusuke."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=55
#. y4:msg_location=T1.P55
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1440_Yusuke"
msgid "Hey, thanks, man..."
msgstr "Oye, gracias, amigo..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=56
#. y4:msg_location=T1.P56
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1452_Naoya"
msgid "Okay, it's almost time. We need to act like we're all buddy-buddy now... One team, one dream, feel me? We'll be counting on you, \"Ryota\"!"
msgstr "Está bien, ya casi es hora. Necesitamos actuar como si fuéramos muy amigos ahora... Un equipo, un sueño, ¿me entiendes? ¡Contaremos contigo, 'Ryota'!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=57
#. y4:msg_location=T1.P57
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1464_Tanimura"
msgid "Sure. Hey, is that one of them?"
msgstr "Claro. Oye, ¿esa es una de ellas?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=59
#. y4:msg_location=T1.P59
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=16
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1488_Akino"
msgid "Hey, guys!"
msgstr "¡Hey, chicos!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=60
#. y4:msg_location=T1.P60
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1500_Yusuke"
msgid "Oh, Akino! Uh, it's been a while!"
msgstr "¡Oh, Akino! Uh, ¡ha pasado su tiempo!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=61
#. y4:msg_location=T1.P61
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=16
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1512_Akino"
msgid "It sure has! Well, it looks like you're all here. Thanks for setting things up on the guys' side."
msgstr "¡Ciertamente! Bueno, parece que todos están aquí. Gracias por organizar todo del lado de los chicos."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=62
#. y4:msg_location=T1.P62
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1524_Yusuke"
msgid "Sure thing! Are your other friends on their way?"
msgstr "¡De nada! ¿Las otras chicas están en camino?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=63
#. y4:msg_location=T1.P63
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=16
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1536_Akino"
msgid "Hmm? Oh, Haruko and Konatsu are already waiting at the restaurant. I just took the liberty to pick you guys up!"
msgstr "¿Hmm? Oh, Haruko y Konatsu ya están esperando en el restaurante. ¡Solo tomé la libertad de recogerlos!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=64
#. y4:msg_location=T1.P64
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=12
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1548_Naoya"
msgid "You're always so on top of things, Akino-chan!"
msgstr "¡Siempre estás tan al tanto de todo, Akino-chan!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=65
#. y4:msg_location=T1.P65
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=16
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=All right, fine.
msgctxt "1560_Akino"
msgid "Haha, you know me. Well, shall we?"
msgstr "Ja, ja, ya me conoces. Bueno, ¿vamos?"

