#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He might not forgive you, you know.
msgctxt "12048_松岡里緒奈：源氏名"
msgid "Maybe I shouldn't do it after all."
msgstr "Tal vez no deba hacerlo después de todo."

#. y4:msg_type=branch_dialogue
