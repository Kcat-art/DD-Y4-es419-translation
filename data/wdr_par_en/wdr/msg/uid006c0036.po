#. y4:msg_location=T7.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=We should go out for all-you-can-eat yakiniku.
msgctxt "6720_Kiryu"
msgid "I'll try and remember that."
msgstr "Lo tendre en cuenta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=9
