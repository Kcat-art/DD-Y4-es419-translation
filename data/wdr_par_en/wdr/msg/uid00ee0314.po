#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Hiyori
#. y4:msg_speaker_id=0
msgctxt "84_Hiyori"
msgid "Ugh... I flew off the handle and said I'd never come back, but... Now what?"
msgstr "Ugh... Me salí de control y dije que nunca volvería, pero... ¿Y ahora qué hago?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Hiyori
#. y4:msg_speaker_id=0
msgctxt "96_Hiyori"
msgid "I guess I can go grab my stuff when Dad isn't home, but I can't afford to live alone..."
msgstr "Supongo que puedo ir a buscar mis cosas cuando papá no esté en casa, pero no puedo permitirme vivir sola..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "108_Akiyama"
msgid "Hey. You could try working at a hostess club."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Hiyori
#. y4:msg_speaker_id=0
msgctxt "120_Hiyori"
msgid "A hostess club!?"
msgstr "¡¿Un club de hostess?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "132_Akiyama"
msgid "Sure. Look, I saw you fighting with your father earlier. I understand what you're going through."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Hiyori
#. y4:msg_speaker_id=0
msgctxt "144_Hiyori"
msgid "Oh..."
msgstr "Oh..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "156_Akiyama"
msgid "If you promise to work hard, I could even sort out a place for you to live."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Hiyori
#. y4:msg_speaker_id=0
msgctxt "168_Hiyori"
msgid "Really!?"
msgstr "¡¿En serio?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "180_Akiyama"
msgid "Sure."
msgstr "Claro."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Hiyori
#. y4:msg_speaker_id=0
msgctxt "192_Hiyori"
msgid "But I'm not pretty or sexy. I'm hardly the hostess type!"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "204_Akiyama"
msgid "Don't worry. I'll take care of everything."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Hiyori
#. y4:msg_speaker_id=0
msgctxt "216_Hiyori"
msgid "Really? Well... I guess it's worth a try. At least for a little while. Thanks."
msgstr "¿De verdad? Bueno... Supongo que vale la pena intentarlo. Al menos por un tiempo. Gracias."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=12
#. y4:msg_location=T1.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "228_Akiyama"
msgid "Then it's settled. C'mon, let's go to the club."
msgstr ""
