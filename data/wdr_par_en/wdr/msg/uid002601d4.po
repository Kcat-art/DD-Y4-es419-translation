#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe it needs a new battery.
msgctxt "2092_Tanimura"
msgid "Yes, you sure did."
msgstr "Sí, lo hicieron."

#. y4:line_status=translated
msgctxt "2104_Tall Man"
msgid "Doesn't that mean anything to you? Your heart isn't\\r\nmoved at all!?"
msgstr "¿Y? ¿Eso no significa nada para ti? ¡¿Tu corazón\\r\nno se ha conmovido ni un poquito?!"

