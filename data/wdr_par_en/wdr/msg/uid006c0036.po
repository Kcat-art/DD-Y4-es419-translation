#. y4:msg_location=T13.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "8880_Kiryu"
msgid "Hey, that's great."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=3
#. y4:msg_location=T13.P3
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "8892_松岡里緒奈：源氏名"
msgid "He's gorgeous and friendly. All the girls like him."
msgstr "Es guapo y simpático. A todas las chicas les gusta."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=4
#. y4:msg_location=T13.P4
