#. y4:msg_branch_raw=01 11 00 09 00 00 00 23 00 00 00 00 00 00 00 00
msgctxt "7980_Akiyama"
msgid "Both legs bouncing sounds annoying."
msgstr "Que sacuda ambas piernas ya es exagerado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
