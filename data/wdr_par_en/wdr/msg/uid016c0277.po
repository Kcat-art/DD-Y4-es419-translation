#. y4:msg_speaker_id=2
msgctxt "1476_峰村七海：源氏名"
msgid "Please enjoy your stay."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=9
#. y4:msg_phrase=2
#. y4:msg_location=T9.P2
