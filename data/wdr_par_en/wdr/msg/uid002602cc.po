#. y4:msg_location=T0.P49
#. y4:msg_speaker=Miki
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Be more open.
msgctxt "1064_Miki"
msgid "Right!"
msgstr "¡Voy!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=54
#. y4:msg_location=T0.P54
#. y4:msg_speaker=Master
#. y4:msg_speaker_id=16
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Be more open.
msgctxt "1124_Master"
msgid "So what'll it be?"
msgstr "Entonces, ¿qué les ofrezco?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
