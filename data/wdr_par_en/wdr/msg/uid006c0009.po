#. y4:msg_branch_segment=T2.P10..P16
#. y4:msg_branch_target_text=That's a pretty big difference.
#. y4:msg_branch_raw=01 11 00 0a 00 00 00 1f 00 00 00 00 00 00 00 00
msgctxt "5052_Kiryu"
msgid "That's a pretty big difference."
msgstr "Eso es una gran diferencia."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=11
#. y4:msg_location=T2.P11
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a pretty big difference.
msgctxt "5064_Maya"
msgid "Yeah. I think I don't stand out as much in Kamurocho."
msgstr "Sí, creo que no destaco tanto en Kamurocho."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=12
#. y4:msg_location=T2.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a pretty big difference.
msgctxt "5076_Kiryu"
msgid "But you still get stopped sometimes, so you must still stand out."
msgstr "Pero a veces te siguen deteniendo, así que debes seguir destacando."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=13
#. y4:msg_location=T2.P13
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a pretty big difference.
msgctxt "5088_Maya"
msgid "Really? I like attention, but not that kind!"
msgstr "¿De verdad? Me gusta la atención, ¡pero no de ese tipo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=14
#. y4:msg_location=T2.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a pretty big difference.
msgctxt "5100_Kiryu"
msgid "You'd think the cops would stop bothering you once they remember your face."
msgstr "Uno pensaría que los policías dejarían de molestarte una vez que recuerdan tu cara."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=15
#. y4:msg_location=T2.P15
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a pretty big difference.
msgctxt "5112_Maya"
msgid "I think I know their faces better than they know mine."
msgstr "Creo que conozco mejor sus caras mejor que la mía."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=16
#. y4:msg_location=T2.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a pretty big difference.
msgctxt "5124_Kiryu"
msgid "Heh, oh well."
msgstr "Je, je, je..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=128
#. y4:msg_phrase=0
#. y4:msg_location=T128.P0
#. y4:msg_choice_index=2
