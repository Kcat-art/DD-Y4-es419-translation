#. y4:msg_phrase=42
#. y4:msg_location=T3.P42
#. y4:msg_speaker=Surly Homeless Man
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why the hell not?
msgctxt "988_Surly Homeless Man"
msgid "Bah. A drink'd patch 'em right up."
msgstr "Bue. Un trago los arreglará de inmediato."

#. y4:line_status=translated
msgctxt "1000_Friendly Homeless Man"
msgid "I hate to ask, but could you buy these kittens something\\r\nyou think they'd like?"
msgstr "Odio pedirlo, pero ¿podrías comprarle algo que les guste\\r\na estos gatitos?"

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
