msgid "Are you from Osaka?"
msgstr "¿Eres de Osaka?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=28
#. y4:msg_phrase=8
#. y4:msg_location=T28.P8
