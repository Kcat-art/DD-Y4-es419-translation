msgctxt "164_Employee"
msgid "Welcome, sir. You can exchange money for chips here."
msgstr "Bienvenido, señor. Puede cambiar su dinero por fichas aquí."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "176_Employee"
msgid "How many would you like, sir?"
msgstr "¿Cuántas quiere, señor?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "200_Employee"
msgid "Very good, sir. Let me get you your chips."
msgstr "Muy bien, señor. Permítame traer sus fichas."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "212_Employee"
msgid "Here are your 50 chips. Thank you very much."
msgstr "Aquí tiene sus 50 fichas. Muchas gracias."

