msgctxt "72_Maria"
msgid "But... You're just a boy!"
msgstr "Pero... ¡Eres solo un niño!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "84_Tanimura"
msgid "You about ready to give it up now?"
msgstr "¿Te puedes rendir ahora?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "108_Tanimura"
msgid "(That's Maria... Gosh, it's almost like she wants people to notice her.)"
msgstr "(Esa es María... Por dios, es casi como si quisiera\\r\nque la gente se fijara en ella)."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "120_Tanimura"
msgid "Are you Maria-san?"
msgstr "¿Eres María-san?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Maria
#. y4:msg_speaker_id=0
msgctxt "132_Maria"
msgid "Hmmmm? Who's this little boy?"
msgstr "¿Hmmmm? ¿Quién es este niño?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Maria's Bodyguard
#. y4:msg_speaker_id=4
msgctxt "144_Maria's Bodyguard"
msgid "Freeze, motherfucker!"
msgstr "¡Quédate quieto, hijo de puta!"

#. y4:line_status=translated
msgctxt "156_Maria"
msgid "Oh, you can let him be! He's actually kinda cute... Hehe.\\r\nSo, can I help you out with something? You don't seem\\r\nlike such a bad guy."
msgstr "¡Oh, puedes dejarlo en paz! De hecho, es un poco lindo... Jeje.\\r\nEntonces, ¿puedo ayudarte con algo? No pareces\\r\ncomo un tipo tan malo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "168_Tanimura"
msgid "I need you to pay your tab at the Dragon Palace."
msgstr "Necesito que pagues la cuenta en el Palacio del Dragón."

#. y4:line_status=translated
msgctxt "180_Maria"
msgid "Oh, that's why you're here? Well, too bad. Why don't we just\\r\nforget about that little matter and have ourselves some fun?"
msgstr "Oh, ¿por eso estás aquí? Lástima. ¿Por qué no nos limitamos a\\r\n¿Olvidarnos de ese pequeño asunto y divertirnos un poco?"

#. y4:line_status=translated
msgctxt "192_Tanimura"
msgid "Honestly, I probably wouldn't mind, but don't you think\\r\nyou should pay people what you owe? It's only fair."
msgstr "Honestamente, seguro que no me importaría, ¿Pero\\r\nno deberías pagarle a la gente lo que debes? Es lo justo."

#. y4:line_status=translated
msgctxt "204_Maria"
msgid "I suppose. You certainly are a brave boy. So I guess\\r\nthere's no more room for negotiating?"
msgstr "Supongo. Ciertamente eres un chico valiente.\\r\n¿Así que supongo, no hay más espacio para negociar?"

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "216_Tanimura"
msgid "I guess not."
msgstr ""

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Maria
#. y4:msg_speaker_id=0
msgctxt "228_Maria"
msgid "In that case... I have no choice. Gentlemen! I want him out of my sight."
msgstr "En ese caso... No tengo otra opción.\\r\n¡Señores! Lo quiero fuera de mi vista."
