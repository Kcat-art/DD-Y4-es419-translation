#. y4:msg_branch_raw=01 11 00 57 00 00 00 08 00 00 00 00 00 00 00 00
msgctxt "2964_Saejima"
msgid "Cheating"
msgstr ""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
