#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "4080_Tanimura"
msgid "I really don't see many girls like you working at hostess clubs."
msgstr "La verdad no suelo ver a chicas como tú trabajando en clubes de hostess."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "4092_Chihiro"
msgid "You don't?"
msgstr "Ah, ¿no?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "4104_Tanimura"
msgid "Yeah. Why'd you start working here, anyway?"
msgstr "No. Pero cuéntame, ¿por qué decidiste trabajar aquí?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "4116_Chihiro"
msgid "Well... I have a dream."
msgstr "Porque... Tengo un sueño."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "4128_Tanimura"
msgid "A dream?"
msgstr "¿Un sueño?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "4140_Chihiro"
msgid "Yes. Don't laugh."
msgstr "Sí. No te rías."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "4152_Chihiro"
msgid "I want to be an actress."
msgstr "Yo quiero ser actriz."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "4164_Tanimura"
msgid "You do? Wow."
msgstr "¿Actriz? Guau."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "4176_Chihiro"
msgid "I go to college here, but the real reason I came to the city was to act."
msgstr "Estudio en una universidad de esta ciudad, pero la verdadera razón por la que vine fue para actuar."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "4188_Chihiro"
msgid "Ever since I was a little girl, I've looked up to the actresses on TV and in the movies."
msgstr "Desde pequeña he admirado a las actrices de la televisión y el cine."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "4200_Chihiro"
msgid "So I started working as a hostess to make money for acting lessons, voice training, stuff like that."
msgstr "Así que empecé a trabajar como hostess para pagar mis clases de actuación, interpretación, canto y cosas así."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "4212_Tanimura"
msgid "I see. Do those kinds of lessons cost a lot?"
msgstr "Entiendo. ¿Esas clases son muy caras?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "4224_Chihiro"
msgid "Yes. Acting school can be expensive."
msgstr "Sí, lo son. Pueden llegar a ser muy costosas."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "4236_Chihiro"
msgid "I couldn't make enough working normal part-time jobs, so I thought I'd try this."
msgstr "No conseguía lo suficiente en trabajos normales de tiempo parcial, así que pensé en darle una oportunidad a esto."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. What sort of actress do you want to be? -> T0.P15 | 2. You're both a college student and a hostess? -> T0.P23 | 3. How much money are you trying to make? -> T0.P30
msgctxt "4248_Chihiro"
msgid "I'm going to work as hard as I can to make my dream come true!"
msgstr "¡Voy a trabajar tan duro como pueda para hacer realidad mi sueño!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
