#. y4:msg_branch_choice=That last one's pretty obvious, don't you think?
msgctxt "9036_Noa"
msgid "What? No, not really."
msgstr "¿Qué? No, la verdad es que no."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=31
#. y4:msg_location=T13.P31
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That last one's pretty obvious, don't you think?
msgctxt "9048_Noa"
msgid "Why's it so hard to accept that women just wanna be treated well?"
msgstr "¿Por qué es tan difícil aceptar que las mujeres sólo quieren que las traten bien?"

