msgid "[Ever seen these guys before?]"
msgstr "[¿Has visto a estos tipos antes?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=3
#. y4:msg_location=T6.P3
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1172_Nair"
msgid "[Some, for common misdemeanors... I'm pretty sure they work under GG.]"
msgstr "[A algunos de ellos, pero solo por delitos menores... Estoy\nmuy segura de que trabajan bajo el mando de GG.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=4
#. y4:msg_location=T6.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "1184_Tanimura"
msgid "[If GG knows about us, then...]"
msgstr "[Si GG ya sabe de nosotros, entonces...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
