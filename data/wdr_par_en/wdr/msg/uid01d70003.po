msgctxt "88"
msgid "Would you like to continue?"
msgstr "¿Quieres continuar?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "100"
msgid "If you bet 500 chips on the next game, I'll set a triple payout. Care to test your luck?\\r\n(Blackjack: 5x wager, Double Down: 2x wager.)"
msgstr "Si apuestas 500 fichas en la siguiente partida, te doy el triple. ¿Quieres probar tu suerte?\\r\n(Blackjack: apuesta 5x, Double Down: apuesta 2x)"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "112"
msgid "If you wager 2,000 chips on the next game, I'll set a triple payout. Want to test your luck?\\r\n(Blackjack: 5x wager, Double Down: 2x wager.)"
msgstr "Si apuestas 2000 fichas en la siguiente partida, te doy el triple. ¿Quieres probar tu suerte?\\r\n(Blackjack: apuesta 5x, Double Down: apuesta 2x)"

