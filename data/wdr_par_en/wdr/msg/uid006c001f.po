#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It's probably because I enjoy my work.
msgctxt "4224_Noa"
msgid "Oh no, that's not what I meant. Not many people in finance seem to enjoy their jobs."
msgstr "Oh no, eso no es lo que quise decir. No mucha gente en finanzas parece disfrutar de sus trabajos..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
