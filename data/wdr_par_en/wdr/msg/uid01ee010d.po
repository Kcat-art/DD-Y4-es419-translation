msgstr "Dejar de Reclutar"

#. y4:msg_role=decision
#. y4:msg_decision_role=choice
#. y4:msg_decision_group=0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T2.P4
msgctxt "448_Akiyama"
msgid "Continue Recruiting"
msgstr "Continuar Reclutando"

#. y4:msg_role=decision
#. y4:msg_decision_role=choice
#. y4:msg_decision_group=1
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T7.P1
msgctxt "460_Akiyama"
msgid "Start Recruiting Again"
msgstr "Empezar a Reclutar de Nuevo"

#. y4:msg_role=decision
#. y4:msg_decision_role=choice
