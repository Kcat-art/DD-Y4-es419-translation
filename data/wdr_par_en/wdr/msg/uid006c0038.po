#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You can't let them get the upper hand.
msgctxt "7920_望月京子：源氏名"
msgid "Hey, thanks, Kiryu-san. But I'm sure I'll be fine."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=18
#. y4:msg_location=T10.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You want me to teach them a lesson?
msgctxt "7932_Kiryu"
msgid "You want me to teach them a lesson? We shouldn't wait until something happens."
msgstr "¿Quieres que les dé una visita? Devolverles lo que ellos dan, sería lo mejor antes que algo pase."

msgctxt "7944_望月京子：源氏名"
msgid "Thanks, I appreciate the thought. <Color:7>♥<Color:Default>"
msgstr "Ja, ja, ja, lo agradecería mucho. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=20
#. y4:msg_location=T10.P20
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You want me to teach them a lesson?
msgctxt "7956_望月京子：源氏名"
msgid "But I want to handle this myself. That's how I've always done things."
msgstr "Pero prefiero manejar esto por mí misma. Así siempre hice las cosas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=21
#. y4:msg_location=T10.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You want me to teach them a lesson?
msgctxt "7968_Kiryu"
msgid "Okay. Don't hesitate to call me if you're in trouble."
msgstr "Ok. No dudes llamar si pasa algo."

msgctxt "7980_望月京子：源氏名"
msgid "I won't. I'm glad you're on my side, Kiryu-san. <Color:7>♥<Color:Default>"
msgstr "No creo hacerlo. Pero me alegro de que estés de mi lado, Kiryu-san. <Color:7>♥<Color:Default>"

#. y4:msg_type=pre_context
