#. y4:msg_location=T1.P1
#. y4:msg_speaker=Fisherman
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Buy Bait
msgctxt "240_Fisherman"
msgid "Alrighty then, what would you like?"
msgstr "Muy bien, ¿qué le gustaría?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Fisherman
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Buy Bait
msgctxt "264_Fisherman"
msgid "Thanks! Hope to see you again real soon!"
msgstr "¡Gracias! ¡Espero volver a verte pronto!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Fisherman
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sell Fish
msgctxt "276_Fisherman"
msgid "Alrighty then, what do you got for me?"
msgstr "Muy bien, ¿qué me traes?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
