msgid "Hana"
msgstr "Hana"

#. y4:msg_type=id
#. y4:msg_label=Nombre interno
#. y4:msg_id_index=1
msgctxt "4688"
msgid "Akiyama"
msgstr "Akiyama"

msgctxt "256_Hana"
msgid "I can't believe I'm going to karaoke with you, Chief...\\r\n"
"I'm so excited. Now, what should I sing?"
msgstr "No puedo creer que vaya al karaoke contigo, Jefe...\\r\n"
"Estoy tan emocionada. Ahora, ¿qué debería cantar?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "268_Hana"
msgid "I think I'll try \"Raindrops.\" The lyrics are heartrending, but it's one of my favorite songs."
msgstr "Creo que intentaré \"Raindrops.\" La letra es desgarradora, pero es una de mis canciones favoritas."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "280_Hana"
msgid "Not bad, Chief! I never knew you were so good at cheering people on."
msgstr "¡Nada mal, Jefe! No sabía que eras tan bueno animando."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Sure. -> T2.P2 | 2. I'd rather not. -> T2.P4
msgctxt "292_Hana"
msgid "Aren't you going to sing? Oh, I know! Why don't we sing a duet!?"
msgstr "¿No va a cantar, jefe? ¡Ah, cierto!\n"
"¡¿Qué tal si hacemos un dúo?!"

