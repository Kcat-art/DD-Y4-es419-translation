#. y4:msg_location=T20.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "14496_Akiyama"
msgid "You're in a good mood today."
msgstr "Hoy estas de buen humor."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=2
#. y4:msg_location=T20.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "14508_Rio"
msgid "Hehe, you noticed, huh?"
msgstr "Je, je, se ha dado cuenta, ¿eh?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=3
#. y4:msg_location=T20.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "14520_Akiyama"
msgid "You find a briefcase full of money or something?"
msgstr "¿Encontraste un maletín lleno de dinero o algo así?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=4
#. y4:msg_location=T20.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "14532_Rio"
msgid "Not quite!"
msgstr "¡No del todo!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=5
#. y4:msg_location=T20.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "14544_Akiyama"
msgid "What, then?"
msgstr "¿Entonces qué?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=6
#. y4:msg_location=T20.P6
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "14556_Rio"
msgid "Okay. Are you ready?"
msgstr "Bueno. ¿Está listo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=7
#. y4:msg_location=T20.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "14568_Akiyama"
msgid "Heh, yeah. Spit it out."
msgstr "Je, sí. Escupelo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=8
#. y4:msg_location=T20.P8
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "14580_Rio"
msgid "My friend saw my column and contacted me."
msgstr "Mi amiga vio mi artículo y se puso en contacto conmigo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=9
#. y4:msg_location=T20.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "14592_Akiyama"
msgid "Your magazine column?"
msgstr "¿Tu columna en la revista?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=10
#. y4:msg_location=T20.P10
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "14604_Rio"
msgid "Yep. This friend was totally against me working in a hostess club. We fought about it, then we didn't talk for about a year."
msgstr "Sip. Esta amiga estaba totalmente en contra de que yo trabajara en un club de hostess. Discutimos por eso y luego no hablamos durante casi un año."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=11
#. y4:msg_location=T20.P11
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=20
#. y4:msg_decision_choices=1. That's great to hear. -> T20.P12 | 2. I wonder which photos she saw. -> T20.P24 | 3. Sounds like being in the magazine was worth it. -> T20.P31
msgctxt "14616_Rio"
msgid "She said she saw me in the magazine and apologized for how she'd treated me."
msgstr "Me dijo que me vio en la revista y se disculpó por cómo me había tratado."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
