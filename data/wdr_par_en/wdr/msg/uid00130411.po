#. y4:msg_speaker_id=0
msgctxt "200_Ehama"
msgid "I've always lived on the safe side. I studied a bit, went to an okay college, got an okay job, had an arranged marriage..."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
