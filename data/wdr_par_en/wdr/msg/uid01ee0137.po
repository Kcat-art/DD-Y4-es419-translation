#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "596_Player"
msgid "(Hmm... The Hard Game is 300 yen. I could play for free if I use a coupon...)"
msgstr "(300 yenes, una partida difícil. ¡Puedo jugar usando mi cupón gratis!)"

