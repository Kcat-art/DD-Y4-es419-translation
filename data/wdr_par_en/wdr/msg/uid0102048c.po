#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "56_Zhao"
msgid "So what kept you today? I thought you'd be here earlier."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "68_Tanimura"
msgid "This detective, Sugiuchi-san, was grilling me back at the station. Ever since that shooting, Homicide's been all up in my ass."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "80_Zhao"
msgid "Hah, police questioning police? That's ridiculous."
msgstr "¿Ah, la policía cuestiona a la policía? Es ridículo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "92_Tanimura"
msgid "Yeah, normally I wouldn't give a damn... But apparently, this wasn't just one random punk killing another."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "104_Tanimura"
msgid "It was significant enough to set the Tojo Clan against itself."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "116_Tanimura"
msgid "...Although why Homicide cares so much about mob activity is beyond me. That's what Organized Crime's for."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "128_Zhao"
msgid "Either way, we don't need another gang war in this city..."
msgstr "De cualquier manera, no necesitamos otra guerra entre bandas en esta ciudad..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "140_Tanimura"
msgid "Oh, and it's not just the Tojo Clan. I hear the Ueno Seiwa's involved."
msgstr "Oh, y no es solo el Clan Tojo. He oído que el Clan Ueno Seiwa también está involucrado."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "152_Zhao"
msgid "Ueno Seiwa? Wait, isn't that...?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "164_Tanimura"
msgid "Yeah. The same clan my dad was investigating after the Yoshiharu Ueno hit... Right around when he was murdered."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "176_Zhao"
msgid "...You think this is connected somehow?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "188_Tanimura"
msgid "Can't say. All I know is the Ueno Seiwa Clan's been quiet for 25 years..."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "200_Tanimura"
msgid "But now there's this shooting a week ago, and suddenly they've gone into overdrive? Something's definitely up."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "212_Tanimura"
msgid "Following this case could lead me to someone who knows the truth... about who killed my dad."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "224_Zhao"
msgid "You still looking for that woman?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "236_Tanimura"
msgid "Yeah, Yasuko Saejima. Her brother Taiga's the one who carried out the hit on Ueno."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "248_Tanimura"
msgid "She's been missing ever since that went down."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "260_Zhao"
msgid "And you really think this Yasuko Saejima knows why your father was killed?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "272_Tanimura"
msgid "Maybe, maybe not. But the last thing written in his notebook was, \"Meet with Yasuko Saejima.\" That has to mean something."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "284_Zhao"
msgid "So she might even be the last person who saw him alive..."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "296_Tanimura"
msgid "......"
msgstr "......"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Manager of Midori
#. y4:msg_speaker_id=7
msgctxt "332_Manager of Midori"
msgid "Is this Tanimura?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "344_Tanimura"
msgid "Yeah, speaking."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Manager of Midori
#. y4:msg_speaker_id=7
msgctxt "356_Manager of Midori"
msgid "This is Park, the manager at Midori."
msgstr "Este es Park, el manager de Midori."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "368_Tanimura"
msgid "Midori? Oh, right, the Korean salon. What do you want?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Manager of Midori
#. y4:msg_speaker_id=7
msgctxt "380_Manager of Midori"
msgid "Can you come here as soon as possible?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "392_Tanimura"
msgid "Why, the police raiding the place or something?"
msgstr ""

msgctxt "404_Manager of Midori"
msgid "No, nothing like that. It's about that woman\\r\n"
"you've been looking for."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Manager of Midori
#. y4:msg_speaker_id=7
msgctxt "416_Manager of Midori"
msgid "Someone who looks just like her is here right now."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=31
#. y4:msg_location=T0.P31
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "428_Tanimura"
msgid "Are you serious!?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=32
#. y4:msg_location=T0.P32
#. y4:msg_speaker=Manager of Midori
#. y4:msg_speaker_id=7
msgctxt "440_Manager of Midori"
msgid "That's why I'm calling! Hurry up, before she leaves."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "452_Tanimura"
msgid "Okay, be right there."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=37
#. y4:msg_location=T0.P37
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "500_Zhao"
msgid "Something wrong?"
msgstr "¿Todo bien?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=38
#. y4:msg_location=T0.P38
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "512_Tanimura"
msgid "I knew it. That killing set something in motion. Zhao-san, I think I found her."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=39
#. y4:msg_location=T0.P39
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "524_Zhao"
msgid "Wait, the woman we were just talking about!?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=40
#. y4:msg_location=T0.P40
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "536_Tanimura"
msgid "I don't know if it's really her, but I've got no reason to doubt it."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=41
#. y4:msg_location=T0.P41
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "548_Zhao"
msgid "I see. Then I suggest you be careful."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=42
#. y4:msg_location=T0.P42
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "560_Tanimura"
msgid "You think?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=43
#. y4:msg_location=T0.P43
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "572_Zhao"
msgid "I'm serious. You're telling me this woman shows up out of nowhere, right as the Ueno Seiwa make their biggest ruckus in 25 years?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=44
#. y4:msg_location=T0.P44
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "584_Zhao"
msgid "The timing's too perfect."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=45
#. y4:msg_location=T0.P45
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "596_Tanimura"
msgid "So you're saying she's involved somehow."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=46
#. y4:msg_location=T0.P46
#. y4:msg_speaker=Zhao
#. y4:msg_speaker_id=0
msgctxt "608_Zhao"
msgid "Well, you're about to find out, aren't you? Now go. Find her before she disappears again."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=47
#. y4:msg_location=T0.P47
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "620_Tanimura"
msgid "Right."
msgstr "Ya veo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=54
#. y4:msg_location=T0.P54
#. y4:msg_speaker=Mei Hua
#. y4:msg_speaker_id=15
msgctxt "704_Mei Hua"
msgid "You off and running already, Ma-chan?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=55
#. y4:msg_location=T0.P55
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "716_Tanimura"
msgid "Yep, business as usual. You know how it is."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=56
#. y4:msg_location=T0.P56
#. y4:msg_speaker=Mei Hua
#. y4:msg_speaker_id=15
msgctxt "728_Mei Hua"
msgid "Let us know if you need anything, okay? You know you're always welcome here."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=57
#. y4:msg_location=T0.P57
#. y4:msg_speaker=Mei Hua
#. y4:msg_speaker_id=15
msgctxt "740_Mei Hua"
msgid "After all, we couldn't be called Homeland if we weren't your home away from home!"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=58
#. y4:msg_location=T0.P58
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "752_Tanimura"
msgid "That's sweet, Mei Hua. Thank you."
msgstr ""
