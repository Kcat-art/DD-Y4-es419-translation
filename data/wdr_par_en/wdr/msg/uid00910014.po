#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Check Investigation
msgctxt "4904_Nair"
msgid "[Usually these types go out of their way to hide, but I hear GG is so strong, he's using this guy like some kind of advertisement.]"
msgstr "[Por lo general, estos tipos hacen lo posible por esconderse.\nPero escuché que GG es tan fuerte que usa a ese tipo como\nuna especie de publicidad.]"

#. y4:line_status=translated
