#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "4140_Kiryu"
msgid "Have you been working here long?"
msgstr "¿Llevas mucho tiempo trabajando?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4152_Maya"
msgid "Compared to the other girls, I guess so."
msgstr "A comparación con las otras chicas, creo que sí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "4164_Kiryu"
msgid "I see."
msgstr "Ya veo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4176_Maya"
msgid "But I've been thinking about quitting recently."
msgstr "Pero, últimamente, estaba pensando en renunciar."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "4188_Kiryu"
msgid "Really? Why?"
msgstr "¿En serio? ¿Por qué?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4200_Maya"
msgid "Hahaha! That's not something that I'd share with a first time customer."
msgstr "¡Ja, ja, ja! No es algo que compartiría con un cliente nuevo. "

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "4212_Kiryu"
msgid "Is there a reason why you have to quit?"
msgstr "¿Pero hay una razón por la que tienes que renunciar?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4224_Maya"
msgid "Well... I also work as a model."
msgstr "Bueno... También trabajo como modelo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "4236_Kiryu"
msgid "Ah. I should've known. You're so pretty, after all."
msgstr "Ah. Debería de haberlo sabido. Después de todo, eres preciosa."

msgctxt "4248_Maya"
msgid "Hehe. Thank you. <Color:7>♥<Color:Default>"
msgstr "Je, je. Gracias. <Color:7>♥<Color:Default>"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
