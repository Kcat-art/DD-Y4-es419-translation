#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=103
#. y4:msg_location=T0.P103
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Go Out to Eat
msgctxt "1732"
msgid "Well, if that's where you wanna go, Akiyama-san, I guess I'll go."
msgstr "Si ahí es donde quieres ir, Akiyama-san, supongo que iré."

msgctxt "1804"
msgid "Sounds fun! ♪ You'd better teach me how to play, then. <Color:7>♥<Color:Default>"
msgstr "¡Suena divertido! ♪ En ese caso será mejor que me enseñes a jugar. <Color:7>♥<Color:Default>"

