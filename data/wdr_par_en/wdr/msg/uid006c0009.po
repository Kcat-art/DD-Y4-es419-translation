#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a tricky issue.
msgctxt "4908_Maya"
msgid "Oh. I didn't expect you to be so indecisive."
msgstr ""

