#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Check Investigation
msgctxt "4928_Tanimura"
msgid "[The same killer is apparently still walking the streets of Kamurocho.]"
msgstr "[Al parecer ese mismo asesino está caminando por las calles de\nKamurocho.]"

#. y4:line_status=translated
