#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=0
msgctxt "88_Kido"
msgid "From what I know, he pays homeless people to gather intel."
msgstr "Se dice que ese informante utiliza a personas sin hogar para recopilar información."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=0
msgctxt "100_Kido"
msgid "Your best bet might be asking them."
msgstr "Así que tal vez puedas conseguir información de ese informante preguntándoles."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=0
msgctxt "148_Kido"
msgid "Oh yeah, let me tell you what I know about that informant."
msgstr "Ah, sí, déjame decirte lo que sé sobre ese informante."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "160_Saejima"
msgid "I'm all ears."
msgstr "Soy todo oídos."

#. y4:line_status=translated
msgctxt "172_Kido"
msgid "They say he keeps tabs on everything that happens\\r\nin Kamurocho, past and present."
msgstr "Dicen que sabe todo lo que sucede\\r\nen Kamurocho, pasado y presente."

#. y4:line_status=translated
msgctxt "184_Kido"
msgid "I don't know who the guy is or how he knows what he knows,\\r\nbut word on the street is there's not much he doesn't."
msgstr "No sé mucho sobre él, pero se rumorea que no hay nada sobre Kamurocho que este informante no conozca. Supuestamente, utiliza a personas sin hogar para recopilar información."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "196_Saejima"
msgid "Wonder how much of it's just rumor."
msgstr "¿Alguien así existe?"

#. y4:line_status=translated
msgctxt "208_Kido"
msgid "I'm just telling you what I've overheard. Apparently,\\r\nhe pays homeless people to gather his intel."
msgstr "Eso es todo lo que sé. Como sea, se dice que este\\r\ninformante utiliza a personas sin hogar para recopilar información."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=0
msgctxt "220_Kido"
msgid "You might have the best luck asking them about him."
msgstr "Así que, preguntarle a los indigentes podría darte\\r\nmás información sobre este informante."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Kido
#. y4:msg_speaker_id=0
msgctxt "232_Kido"
msgid "Oh, I almost forgot."
msgstr "Ah, por cierto."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "244_Saejima"
msgid "Forgot what?"
msgstr "¿Qué pasa...?"

#. y4:line_status=translated
msgctxt "256_Kido"
msgid "The streets are practically crawling with cops today.\\r\nBetter watch yourself out there."
msgstr "Hay muchos policías por aquí.\\r\nSería prudente tener cuidado."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=2
msgctxt "268_Saejima"
msgid "Alright."
msgstr "Está bien."
