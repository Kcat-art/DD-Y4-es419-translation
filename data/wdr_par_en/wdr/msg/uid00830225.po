#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Anguished Man
#. y4:msg_speaker_id=0
msgctxt "84_Anguished Man"
msgid "What a travesty! The most perfect melody just came to me!"
msgstr "¡Qué calamidad! ¡La melodía más perfecta acaba de surgir en mi mente!"

#. y4:line_status=translated
msgctxt "96_Anguished Man"
msgid "And I have nothing to jot it down with. Oh, no, no－it's\\r\nslipping away!"
msgstr "Y no tengo nada con qué anotarlo. ¡Oh, no, no... se\\r \nme está yendo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "108_Akiyama"
msgid "(Something to write with? I have just the thing.)"
msgstr "(¿Algo con lo que anotar?, tengo justo aquí la cosilla)."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "120_Akiyama"
msgid "Everything all right?"
msgstr "¿Todo bien?"

#. y4:line_status=translated
msgctxt "132_Anguished Man"
msgid "Ah! I'm very sorry, but you wouldn't happen to have anything\\r\nto write with, would you?"
msgstr "¡Ah! Lamento molestarlo, ¿pero no tendrá de casualidad\\r\nalgo para anotar?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "144_Akiyama"
msgid "I sure do."
msgstr "Porsupuesto."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Anguished Man
#. y4:msg_speaker_id=0
msgctxt "156_Anguished Man"
msgid "Oh, marvelous! May I borrow it?"
msgstr "¡Oh, maravilloso! ¿Puedo tomarlo prestado?"

#. y4:line_status=translated
msgctxt "168_Akiyama"
msgid "Of course. Be my guest. But, unfortunately, I can't let you\\r\nhave it for free."
msgstr "Claro. Todo tuyo. Pero, desafortunadamente, no puedo dejarte\\r\ntenerlo gratis."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Anguished Man
#. y4:msg_speaker_id=0
msgctxt "180_Anguished Man"
msgid "Yes, yes, that's fine! Please, just give it to me! Hurry! I'm losing the melody as we speak!"
msgstr "¡Sí, sí, está bien! ¡Por favor, dámelo! ¡Apurarte! ¡Estoy perdiendo la melodía mientras hablamos!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "192_Akiyama"
msgid "(He'll do.)"
msgstr "(Lo hará.)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "204_Akiyama"
msgid "Here you go."
msgstr "Aquí tienes."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Anguished Man
#. y4:msg_speaker_id=0
msgctxt "216_Anguished Man"
msgid "Oh, happy day!"
msgstr "¡Oh, feliz día!"

#. y4:line_status=translated
msgctxt "288_Composed Man"
msgid "You've been such a big help. Although to be honest, you\\r\nhaven't helped me so much as you've helped Japan's music\\r\nindustry. Heheh."
msgstr "Has sido una gran ayuda. A pesar de ser honesto, tu\\r\nno me ha ayudado tanto como has ayudado a la industria japonesa de la música\\r\n. Heheh."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=18
#. y4:msg_location=T1.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "300_Akiyama"
msgid "Uh-huh..."
msgstr "Uh-huh..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=19
#. y4:msg_location=T1.P19
#. y4:msg_speaker=Composed Man
#. y4:msg_speaker_id=5
msgctxt "312_Composed Man"
msgid "You may think you just casually handed me a pen, but in actuality, you were the midwife at the birth of a song that will go down in history."
msgstr "Puede que pienses que me has entregado un bolígrafo por casualidad, pero en realidad, fuiste la comadrona en el nacimiento de una canción que pasará a la historia."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=20
#. y4:msg_location=T1.P20
#. y4:msg_speaker=Composed Man
#. y4:msg_speaker_id=5
msgctxt "324_Composed Man"
msgid "Why, I may even mention you in my memoirs one day."
msgstr "Es posible que algún día te mencione en mis memorias."

#. y4:line_status=translated
msgctxt "336_Akiyama"
msgid "That's, uh, very kind of you. Now, in exchange for that\\r\npen..."
msgstr "Eso es, eh, muy amable de tu parte. Ahora bien, a cambio de eso\\r\npluma..."

#. y4:line_status=translated
msgctxt "348_Composed Man"
msgid "Yes, of course! I was so overcome with relief that I'd\\r\ncompletely forgotten. Name your price."
msgstr "¡Por supuesto que sí! Estaba tan abrumado por el alivio que\\r\ncompletamente olvidado. Nombra tu precio."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=23
#. y4:msg_location=T1.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "360_Akiyama"
msgid "Oh, er, I'd like something other than money, if that's all right."
msgstr "Oh, eh, me gustaría algo más que dinero, si eso está bien."

#. y4:line_status=translated
msgctxt "372_Composed Man"
msgid "Would you? Well, that might be a problem. I don't really\\r\nhave anything ideal..."
msgstr "¿Lo harías? Bueno, eso podría ser un problema. La verdad es que no\\r\ntengo nada ideal..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=25
#. y4:msg_location=T1.P25
#. y4:msg_speaker=Composed Man
#. y4:msg_speaker_id=5
msgctxt "384_Composed Man"
msgid "...Just this here."
msgstr "... Solo esto aquí."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=26
#. y4:msg_location=T1.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "396_Akiyama"
msgid "What is it?"
msgstr "¿Qué cosa?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=27
#. y4:msg_location=T1.P27
#. y4:msg_speaker=Composed Man
#. y4:msg_speaker_id=5
msgctxt "408_Composed Man"
msgid "Stomach medicine. I'm pretty weak downstairs, if you catch my drift."
msgstr "Medicina para el estómago. Estoy bastante débil abajo, si me entiendes."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=28
#. y4:msg_location=T1.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "420_Akiyama"
msgid "(Back to this again...)"
msgstr "(Volviendo a esto otra vez...)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=29
#. y4:msg_location=T1.P29
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "432_Akiyama"
msgid "Sure, I'll take it. Thanks."
msgstr "Claro, lo aceptaré. Gracias."

#. y4:line_status=translated
msgctxt "468_Composed Man"
msgid "I'll be sure to speak highly of you in my memoirs! \"The Man\\r\nWho Made Miracles\"! Has a nice ring to it."
msgstr "¡Me aseguraré de hablar muy bien de ti en mis memorias! \"El Hombre\\r\nque hizo milagros\"! Tiene gancho."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=33
#. y4:msg_location=T1.P33
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "480_Akiyama"
msgid "Something to look forward to. Bye, now."
msgstr "Algo que esperamos con ansias. Adiós, por ahora."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=34
#. y4:msg_location=T1.P34
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "492_Akiyama"
msgid "(Maybe there's someone else who needs this medicine...)"
msgstr "(Tal vez haya alguien más que necesite este medicamento...)"
