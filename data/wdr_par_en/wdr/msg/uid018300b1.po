#. y4:msg_speaker_id=9
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You're letting it bother you too much.
msgctxt "7244_Tanimura"
msgid "Yeah. It's important to be able to get over that kind of stuff, don't you think?"
msgstr "Sí. Es importante ser capaz de superar ese tipo de cosas, ¿no crees?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=5
#. y4:msg_phrase=20
