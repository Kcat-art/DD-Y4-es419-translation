#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'll make sure she gets home.
msgctxt "196_Tanimura"
msgid "Sure."
msgstr "Claro."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "220_Tanimura"
msgid "Yusuke, you know where she lives, right? How about you make sure she gets home?"
msgstr "Yusuke, sabes dónde vive, ¿no? ¿Podrías llevarla a casa?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
