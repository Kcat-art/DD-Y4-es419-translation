#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'd stay a human.
msgctxt "6420_Kiryu"
msgid "Well, I like dragons..."
msgstr "Bueno, me gustan los dragones..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=13
#. y4:msg_location=T6.P13
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'd stay a human.
msgctxt "6432_松岡里緒奈：源氏名"
msgid "But dragons are imaginary! They don't have dragons in zoos, do they?"
msgstr "¡Pero los dragones son imaginarios! No tienen dragones en los zoológicos, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
