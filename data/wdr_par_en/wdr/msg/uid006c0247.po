#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "2676_Tanimura"
msgid "Hi."
msgstr "Ah, el gusto es todo mío."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=11
#. y4:msg_location=T2.P11
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "2688_峰村七海：源氏名"
msgid "You're late! Just how long did you plan to keep me waiting here!?"
