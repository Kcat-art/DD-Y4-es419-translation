#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How about going out for a nice meal?
msgctxt "12288_望月京子：源氏名"
msgid "Really!? Anything I want?"
msgstr "¡¿De verdad?! ¿Puedo pedir cualquier cosa?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=8
#. y4:msg_location=T22.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How about going out for a nice meal?
msgctxt "12300_Kiryu"
msgid "Sure, anything. What do you feel like?"
msgstr "Claro, cualquier cosa. ¿Qué te parece?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=9
#. y4:msg_location=T22.P9
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How about going out for a nice meal?
msgctxt "12312_望月京子：源氏名"
msgid "Well... I want a huge Chinese feast!"
msgstr "Bueno... ¡Quiero un gran festín de comida china!"

msgctxt "12324_望月京子：源氏名"
msgid "You know, where they keep bringing dish after dish after dish until you're like, \"I can't eat any more!\" I've always wanted to try that! <Color:7>♥<Color:Default>"
msgstr "Ya sabes, El lugar donde siguen trayendo plato tras plato tras plato hasta que no des más, ¡Siempre he querido ir allí! <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=11
#. y4:msg_location=T22.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How about going out for a nice meal?
msgctxt "12336_Kiryu"
msgid "That sounds expensive..."
msgstr "Suena caro... (yo y mi gran bocota)"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=12
#. y4:msg_location=T22.P12
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How about going out for a nice meal?
msgctxt "12348_望月京子：源氏名"
msgid "I saw it on TV. I think they said it was roughly 3 million yen if you go to China."
msgstr "Lo vi en la TV. Creo que dijeron que ronda los 3 millones de yenes si es en China."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=13
#. y4:msg_location=T22.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How about going out for a nice meal?
msgctxt "12360_Kiryu"
msgid "3 million!? Um..."
msgstr "¡¿3 Millones?! Eeeh..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=14
#. y4:msg_location=T22.P14
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How about going out for a nice meal?
msgctxt "12372_望月京子：源氏名"
msgid "Oh, don't look so worried! I was just kidding!"
msgstr "Oh, ¡no te preocupes Kiryu-san! ¡Estaba bromeando!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=15
#. y4:msg_location=T22.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How about going out for a nice meal?
msgctxt "12384_Kiryu"
msgid "Whew..."
msgstr "Uf..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=16
#. y4:msg_location=T22.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I could take you on a trip somewhere.
msgctxt "12396_Kiryu"
msgid "I could take you on a trip somewhere. Is there someplace you want to go?"
msgstr "Podría llevarte de viaje. ¿Hay algún lugar que quieras ir?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=17
#. y4:msg_location=T22.P17
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I could take you on a trip somewhere.
msgctxt "12408_望月京子：源氏名"
msgid "For reals!? I don't know, that's a big question..."
msgstr "¡¿De verdad?! N-No sé, nunca lo pensé..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=18
#. y4:msg_location=T22.P18
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I could take you on a trip somewhere.
msgctxt "12420_望月京子：源氏名"
msgid "I know! I wanna go to Waiha!"
msgstr "¡Ya sé! ¡Quiero ir a Waiha!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=19
#. y4:msg_location=T22.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I could take you on a trip somewhere.
msgctxt "12432_Kiryu"
msgid "Huh? You mean Hawaii? Why do kids think it's cool to say everything backwards these days? Hawaii doesn't seem quite your style, though."
msgstr "¿Eh? ¿Quisiste decir Hawái? ¿Por qué los jóvenes de ahora dicen todo el revés? Aunque... Hawái no parece ser muy de tu estilo ¿Estas segura?"

#. y4:msg_type=branch_dialogue
