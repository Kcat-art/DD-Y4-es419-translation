#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4192_Noa"
msgid "Akiyama-san!?"
msgstr "¿¡Akiyama-san!?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "4204_Akiyama"
msgid "Sorry to keep you waiting."
msgstr "Lamento hacerle esperar."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4216_Noa"
msgid "But... isn't this supposed to be a date?"
msgstr "Eh... ¿qué significa esto?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
msgctxt "4228_Talk_No"
msgid "I thought we were going to be alone..."
msgstr "Pensé que tendríamos una cita, solo nosotros dos..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "4240_Akiyama"
msgid "......"
msgstr "......"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4252_Noa"
msgid "Could you please come back by yourself? I'll be waiting right here."
msgstr "¿Podrías volver solo por favor? Te estaré esperando aquí..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4264_Noa"
msgid "Akiyama-san!?"
msgstr "¿¡Akiyama-san!?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "4276_Akiyama"
msgid "Sorry to keep you waiting."
msgstr "Lamento hacerle esperar."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4288_Noa"
msgid "Why do you have that with you? You're not going to be taking care of business on our date, are you?"
msgstr "¿Eh? ¿Por qué llevas eso contigo? No pensarás en hacer tus asuntos durante nuestra cita, ¿verdad?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "4300_Akiyama"
msgid "All right. Sorry."
msgstr "...Tienes razón, perdón."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4312_Noa"
msgid "Okay. I'll just wait here. Come back when you're finished."
msgstr "Estaré esperando aquí, así que date prisa y termina con ello..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4324_Noa"
msgid "You're late! I was worried!"
msgstr "¡Llegas tarde! ¡Estaba preocupada!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "4336_Akiyama"
msgid "Sorry..."
msgstr "Lo siento..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4348_Noa"
msgid "Hmm. What should your punishment be? Oh, I know! You have to be extra nice today!"
msgstr "Cuál debería ser tu castigo... ¡Ya lo tengo! ¡Tienes que divertime todo el día! ♪"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "4360_Akiyama"
msgid "Heh, all right."
msgstr "Ah, está bien."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=6
#. y4:msg_location=T2.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "4396_Akiyama"
msgid "Hmm? Why are you looking around like that?"
msgstr "¿Pasa algo? ¿Por qué miras así a tu alrededor?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=7
#. y4:msg_location=T2.P7
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4408_Noa"
msgid "I... I think somebody's been following me. Since I left the club."
msgstr "Es que... desde que salí del club... siento que alguien me está siguiendo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=8
#. y4:msg_location=T2.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "4420_Akiyama"
msgid "Really? Who?"
msgstr "¿Eh? ¿Quién?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=9
#. y4:msg_location=T2.P9
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4432_Noa"
msgid "Um, let's see..."
msgstr "Yo creo que..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=10
#. y4:msg_location=T2.P10
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4444_Noa"
msgid "Oh! Over there!"
msgstr "¡Ah! ¡Ese de ahí!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=12
#. y4:msg_location=T2.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "4468_Akiyama"
msgid "That guy?"
msgstr "¿Ese tipo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=13
#. y4:msg_location=T2.P13
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4480_Noa"
msgid "Yeah. Actually... He's one of my customers."
msgstr "Sí. Y de hecho... es uno de mis clientes..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=14
#. y4:msg_location=T2.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "4492_Akiyama"
msgid "What!? You mean from the club?"
msgstr "¿¡Qué!? ¿Quieres decir del club?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=15
#. y4:msg_location=T2.P15
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4504_Noa"
msgid "Yeah."
msgstr "Sí..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
