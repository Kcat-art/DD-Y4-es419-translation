#. y4:msg_location=T9.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Doesn't matter to me.
msgctxt "12960_Akiyama"
msgid "I see."
msgstr "Ya veo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=5
#. y4:msg_location=T23.P5
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "12972_Erena"
msgid "You know, movies where the guy and the girl keep missing each other, but finally get together at the end?"
msgstr ""

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
