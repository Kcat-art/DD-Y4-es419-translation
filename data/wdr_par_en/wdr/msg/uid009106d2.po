#. y4:msg_speaker_id=1
msgctxt "120_Kiryu"
msgid "Complete control? What're you, some kind of control freak? We don't need your kind here."
msgstr ""

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
