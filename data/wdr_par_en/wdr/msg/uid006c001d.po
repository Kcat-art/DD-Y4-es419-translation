#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Hot springs are nice, aren't they?
msgctxt "7716_Rio"
msgid "Hmm, I have a better idea. Instead of me taking you, you should take me!"
msgstr "Hmm, tengo una mejor idea. ¡En lugar de que yo te lleve, tú deberías llevarme a mí!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
