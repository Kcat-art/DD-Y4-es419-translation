#. y4:msg_location=T0.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4092_Akiyama"
msgid "Well, in a way."
msgstr "Bueno, algo así."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4104_Noa"
msgid "You must be tired, then! You look like a hard worker!"
msgstr "¡Gracias por su gran esfuerzo! ♪\n"
"¡Usted parece alguien muy trabajador!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=15
#. y4:msg_location=T6.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a long time.
msgctxt "4116_Akiyama"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4128_Noa"
msgid "I think so. You've got a different aura than most guys."
msgstr "Yo creo que sí. Tiene un aura diferente al de la mayoría de personas."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
