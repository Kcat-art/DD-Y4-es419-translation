#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Yeah, I got 'em.
msgctxt "240_Tanimura"
msgid "Yeah, got 'em right here."
msgstr "Sí, los tengo aquí mismo."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
