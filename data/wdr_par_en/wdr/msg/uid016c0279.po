#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=9
#. y4:msg_phrase=2
#. y4:msg_location=T9.P2
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=3
