#. y4:msg_choice_index=2
#. y4:msg_branch_choice=There's nothing wrong with it.
msgctxt "10548_松岡里緒奈：源氏名"
msgid "Oh, I couldn't do that! I never let customers see me in my off-duty clothes."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
#. y4:msg_phrase=16
