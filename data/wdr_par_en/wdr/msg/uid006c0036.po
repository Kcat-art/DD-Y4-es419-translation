#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not good for you.
msgctxt "14508_松岡里緒奈：源氏名"
msgid "What? Why?"
msgstr "¿Qué? ¿Por qué?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=10
#. y4:msg_location=T28.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not good for you.
msgctxt "14520_Kiryu"
msgid "You've never had lasting success dieting this way, have you?"
msgstr "Nunca has tenido éxito duradero haciendo dieta de esta manera, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
