#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "2164_Minamida"
msgid "If you <Color:7>input<Color:Default> an enemy and are victorious against him, you become stronger. Nifty, don't you think?"
msgstr "Si consigues <Color:7>ingresar<Color:Default> a un enemigo y lo derrotas\n"
"te volverás más fuerte. Una maravilla, ¿no crees?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
