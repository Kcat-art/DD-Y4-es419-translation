#. y4:msg_speaker_id=2
msgctxt "11040_松岡里緒奈：源氏名"
msgid "Kiryu-san, I'm sorry I made you meet my mom."
msgstr "Kiryu-san, lamento haberte hecho conocer a mi madre."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
