#. y4:msg_location=T23.P35
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't worry too much about it.
msgctxt "16140_Rio"
msgid "Maybe not, but I don't want to have a bad personality, either."
msgstr "Tal vez no, pero tampoco quiero tener mala personalidad."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=36
#. y4:msg_location=T23.P36
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't worry too much about it.
msgctxt "16152_Akiyama"
msgid "There's no one correct answer. It entirely depends on the situation, you know?"
msgstr "No hay una respuesta correcta. Depende totalmente de la situación, ¿sabes?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=37
#. y4:msg_location=T23.P37
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't worry too much about it.
msgctxt "16164_Rio"
msgid "Yes..."
msgstr "Sí..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=0
#. y4:msg_location=T24.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16176_Rio"
msgid "Hehehe. So I'm planning something right now. Would you like to know what it is?"
msgstr "Je, je, je. Estoy planeando algo ahora mismo. ¿Le gustaría saber qué es?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=1
#. y4:msg_location=T24.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "16188_Akiyama"
msgid "It sounds like you want to tell me."
msgstr "Parece que quieres contarmelo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=2
#. y4:msg_location=T24.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16200_Rio"
msgid "I do!"
msgstr "¡Sí!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=3
#. y4:msg_location=T24.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "16212_Akiyama"
msgid "Hehe. All right then. Let's hear it."
msgstr "Je, je. Muy bien entonces. Escuchémoslo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=4
#. y4:msg_location=T24.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16224_Rio"
msgid "Are you ready?"
msgstr "¿Estás listo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=5
#. y4:msg_location=T24.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "16236_Akiyama"
msgid "It's about your dogs again, isn't it?"
msgstr "Se trata de tus perros de nuevo, ¿no es así?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=6
#. y4:msg_location=T24.P6
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16248_Rio"
msgid "Yep! Good guess!"
msgstr "¡Sip! ¡Buena suposición!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=7
#. y4:msg_location=T24.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "16260_Akiyama"
msgid "Heh. So? What's up?"
msgstr "Je. ¿Así que? ¿Qué pasa?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=8
#. y4:msg_location=T24.P8
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16272_Rio"
msgid "Well, I'm thinking about taking my dogs to the beach!"
msgstr "Bueno, ¡estoy pensando en llevar a mis perros a la playa!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=9
#. y4:msg_location=T24.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "16284_Akiyama"
msgid "The beach, huh?"
msgstr "La playa, ¿eh?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=10
#. y4:msg_location=T24.P10
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=24
#. y4:msg_decision_choices=1. Is that all? -> T24.P11 | 2. You're only taking your dogs? -> T24.P21 | 3. That seems really innocent. I like it. -> T24.P28
msgctxt "16296_Rio"
msgid "I've always dreamed about running with my dogs on a white, sandy beach."
msgstr "Siempre he soñado con correr con mis perros en una playa de arena blanca."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=11
#. y4:msg_location=T24.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Is that all?
msgctxt "16308_Akiyama"
msgid "Oh, is that all? Nothing else?"
msgstr "Oh, ¿eso es todo? ¿Nada más?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=12
#. y4:msg_location=T24.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Is that all?
msgctxt "16320_Rio"
msgid "Hey, I've wanted to do this for a long time."
msgstr "Oiga, he querido hacer esto durante mucho tiempo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=13
#. y4:msg_location=T24.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Is that all?
msgctxt "16332_Akiyama"
msgid "Maybe so, but..."
msgstr "Puede ser, pero..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=14
#. y4:msg_location=T24.P14
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Is that all?
msgctxt "16344_Rio"
msgid "Just think of my dogs running as fast as they can on the beach! Tell me that isn't cute!"
msgstr "¡Solo piense en mis perros corriendo lo más rápido que puedan en la playa! ¡Digame que eso no es lindo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=15
#. y4:msg_location=T24.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Is that all?
msgctxt "16356_Akiyama"
msgid "I guess so."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=16
#. y4:msg_location=T24.P16
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Is that all?
msgctxt "16368_Rio"
msgid "Is that all you can say?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=17
#. y4:msg_location=T24.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Is that all?
msgctxt "16380_Akiyama"
msgid "It just seems like a very average dream. I don't think it warrants planning."
msgstr "Parece un sueño muy normal. No creo que justifique la planificación."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=18
#. y4:msg_location=T24.P18
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Is that all?
msgctxt "16392_Rio"
msgid "But..."
msgstr "Pero..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=19
#. y4:msg_location=T24.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Is that all?
msgctxt "16404_Akiyama"
msgid "Just don't let your dogs leave any little \"gifts\" for the other people on the beach."
msgstr "Solo procura que tus perros no dejen “regalitos” para las demás personas en la playa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=20
#. y4:msg_location=T24.P20
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Is that all?
msgctxt "16416_Rio"
msgid "Hehe! Yeah, guess that's something to watch out for, huh?"
msgstr "¡Je, je! Sí, supongo que eso es algo a tener en cuenta, ¿eh?"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=194
#. y4:msg_phrase=0
#. y4:msg_location=T194.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T24.P21
#. y4:msg_branch_segment=T24.P21..P27
#. y4:msg_branch_target_text=You're only taking your dogs?
#. y4:msg_branch_raw=01 11 00 15 00 00 00 1d 00 00 00 00 00 00 00 00
msgctxt "16428_Akiyama"
msgid "You're only taking your dogs?"
msgstr "¿Solo llevarás a tus perros?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=22
#. y4:msg_location=T24.P22
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You're only taking your dogs?
msgctxt "16440_Rio"
msgid "Huh? But all I have are my dogs..."
msgstr "¿Eh? Pero todo lo que tengo son mis perros..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=23
#. y4:msg_location=T24.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You're only taking your dogs?
msgctxt "16452_Akiyama"
msgid "That's not what I meant. You not going with any other people to the beach?"
msgstr "No me refería a eso. ¿No vas a ir con más gente a la playa?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=24
#. y4:msg_location=T24.P24
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You're only taking your dogs?
msgctxt "16464_Rio"
msgid "Oh! Are you hinting at something, Akiyama-san?"
msgstr "¡Oh! ¿Está insinuando algo, Akiyama-san?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=25
#. y4:msg_location=T24.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You're only taking your dogs?
msgctxt "16476_Akiyama"
msgid "I was just wondering."
msgstr "Solo me da curiosidad."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=26
#. y4:msg_location=T24.P26
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You're only taking your dogs?
msgctxt "16488_Rio"
msgid "Hehehe. Hmm... Maybe I should invite someone along. But who? Do you have any suggestions, Akiyama-san?"
msgstr "Je, je, je. Hmm... Quizá debería invitar a alguien. ¿Pero a quién? ¿Tiene alguna sugerencia, Akiyama-san?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=27
#. y4:msg_location=T24.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You're only taking your dogs?
msgctxt "16500_Akiyama"
msgid "Ho boy..."
msgstr "Oh, cielos..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=28
#. y4:msg_location=T24.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That seems really innocent. I like it.
msgctxt "16512_Akiyama"
msgid "That seems really innocent. I like it. It's like something out of a fairy tale."
msgstr "Eso parece muy inocente. Me gusta. Es como algo sacado de un cuento de hadas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "16524_Rio"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=So what do you think now that you're doing it?
msgctxt "16536_Akiyama"
msgid "Yeah."
msgstr "Sí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=31
#. y4:msg_location=T24.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That seems really innocent. I like it.
msgctxt "16548_Rio"
msgid "Yay! My friends keep saying that everybody does that kind of thing, so it's not a big deal, but I knew you'd understand."
msgstr "¡Yay! Mis amigos siguen diciendo que todo el mundo hace ese tipo de cosas, así que no es gran cosa, pero sabía que usted lo entendería."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=32
#. y4:msg_location=T24.P32
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That seems really innocent. I like it.
msgctxt "16560_Akiyama"
msgid "Just 'cause everybody else does it doesn't make it bad."
msgstr "Que todo el mundo lo haga no significa que esté mal."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=33
#. y4:msg_location=T24.P33
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That seems really innocent. I like it.
msgctxt "16572_Akiyama"
msgid "I mean, when people go sightseeing, they usually go to the same places as everybody else. That's because those places are worth seeing, though."
msgstr "Quiero decir, cuando la gente hace turismo, normalmente va a los mismos lugares que todos los demás. Pero eso es porque esos lugares valen la pena."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=34
#. y4:msg_location=T24.P34
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That seems really innocent. I like it.
msgctxt "16584_Rio"
msgid "That's a nice way to look at it. There's usually a good reason everybody does something, right?"
msgstr "Esa es una buena manera de verlo. Por lo general, hay una buena razón por la que todos hacen algo, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=35
#. y4:msg_location=T24.P35
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That seems really innocent. I like it.
msgctxt "16596_Akiyama"
msgid "Yeah, exactly. You got it!"
msgstr "Sí, exactamente. ¡Lo entendiste!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=36
#. y4:msg_location=T24.P36
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That seems really innocent. I like it.
msgctxt "16608_Rio"
msgid "Do you want to go with me then, Akiyama-san!? Hehehe."
msgstr "¿Entonces quiere venir conmigo, Akiyama-san!? Je, je, je."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=37
#. y4:msg_location=T24.P37
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That seems really innocent. I like it.
msgctxt "16620_Akiyama"
msgid "Heh, I'll think about it."
msgstr "Je, me lo pensaré."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=0
#. y4:msg_location=T25.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16632_Rio"
msgid "I can play a whole song now!"
msgstr "¡Ahora puedo tocar una canción completa!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
