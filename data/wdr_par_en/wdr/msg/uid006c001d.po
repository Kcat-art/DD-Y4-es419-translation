#. y4:msg_branch_choice=You should try to be more aware of your behavior.
msgctxt "15876_Rio"
msgid "Yes."
msgstr "Sí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
