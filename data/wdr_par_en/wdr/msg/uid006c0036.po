#. y4:msg_location=T23.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "12696_Kiryu"
msgid "I've been thinking about you for a long time."
msgstr "Llevo mucho tiempo pensando en ti."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
