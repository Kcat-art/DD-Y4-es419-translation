msgctxt "25174"
msgid "Kampachi"
msgstr "Kampachi"

#. y4:line_status=translated
#. y4:item_index=353
#. y4:item_id=sushi_kanpachi
#. y4:item_icon=2d_yk_sushi_kanpachi
#. y4:item_field=description
#. y4:item_pair_context=25174
msgctxt "106271"
msgid "Most amberjack these days come from a hatchery, but mine come straight from the ocean."
msgstr "La mayoría de los Kampachi de hoy en día proceden de criaderos, pero el mío es directamente del océano."

#. y4:line_status=translated
#. y4:item_index=354
#. y4:item_id=sushi_buri
#. y4:item_icon=2d_yk_sushi_buri
#. y4:item_field=name
#. y4:item_pair_context=106358
msgctxt "25183"
msgid "Kamburi"
msgstr "Kamburi"

#. y4:line_status=translated
#. y4:item_index=354
#. y4:item_id=sushi_buri
#. y4:item_icon=2d_yk_sushi_buri
#. y4:item_field=description
#. y4:item_pair_context=25183
msgctxt "106358"
msgid "It might not be quite in season, but our winter amberjack is all-natural. Truly a fatty masterpiece."
msgstr "Puede que no esté completamente en temporada, pero nuestro medregal de invierno es 100% natural. Verdaderamente es una obra maestra grasosa."

#. y4:line_status=translated
#. y4:item_index=355
#. y4:item_id=sushi_hirame
#. y4:item_icon=2d_yk_sushi_hirame
#. y4:item_field=name
#. y4:item_pair_context=106459
msgctxt "25191"
msgid "Hirame"
msgstr "Hirame"

#. y4:line_status=translated
#. y4:item_index=355
#. y4:item_id=sushi_hirame
#. y4:item_icon=2d_yk_sushi_hirame
#. y4:item_field=description
#. y4:item_pair_context=25191
msgctxt "106459"
msgid "Hirame, AKA olive flounder, is right in season. And ours is all-natural."
msgstr "El hirame, también conocido como lenguado de oliva, está en su temporada. Y el nuestro es completamente natural."

#. y4:line_status=translated
#. y4:item_index=356
#. y4:item_id=sushi_shimaaji
#. y4:item_icon=2d_yk_sushi_shimaaji
#. y4:item_field=name
#. y4:item_pair_context=106532
msgctxt "25198"
msgid "Shima-aji"
msgstr "Shima-aji"

#. y4:line_status=translated
#. y4:item_index=356
#. y4:item_id=sushi_shimaaji
#. y4:item_icon=2d_yk_sushi_shimaaji
#. y4:item_field=description
#. y4:item_pair_context=25198
msgctxt "106532"
msgid "The choicest of all horse mackerel, a summer fish best eaten as sashimi or sushi."
msgstr "El más selecto de todos los jureles, un pescado de verano que se consume mejor como sashimi o sushi."

#. y4:line_status=translated
#. y4:item_index=357
#. y4:item_id=sushi_kinme
#. y4:item_icon=2d_yk_sushi_kinme
#. y4:item_field=name
#. y4:item_pair_context=106614
msgctxt "25208"
msgid "Kinmedai"
msgstr "Kinmedai"

#. y4:line_status=translated
#. y4:item_index=357
#. y4:item_id=sushi_kinme
#. y4:item_icon=2d_yk_sushi_kinme
#. y4:item_field=description
#. y4:item_pair_context=25208
msgctxt "106614"
msgid "This golden-eye snapper was freshly caught early this morning. It's oily and better than ever."
msgstr "Este Kimmedai estaba recién pescado esta mañana. Está aceitoso y mejor que nunca."

#. y4:line_status=translated
#. y4:item_index=358
#. y4:item_id=sushi_ikura
#. y4:item_icon=2d_yk_sushi_ikura
#. y4:item_field=name
#. y4:item_pair_context=106709
msgctxt "25217"
msgid "Ikura"
msgstr "Ikura"

#. y4:line_status=translated
#. y4:item_index=358
#. y4:item_id=sushi_ikura
#. y4:item_icon=2d_yk_sushi_ikura
#. y4:item_field=description
#. y4:item_pair_context=25217
msgctxt "106709"
msgid "Can you tell ocean-caught and farm-grown salmon roe apart? This here's the best in the industry."
msgstr "¿Puedes distinguir entre huevas de salmón naturales y artificiales? Aquí está lo mejor de la industria."

#. y4:line_status=translated
#. y4:item_index=359
#. y4:item_id=sushi_akagai
#. y4:item_icon=2d_yk_sushi_akagai
#. y4:item_field=name
#. y4:item_pair_context=106806
msgctxt "25223"
msgid "Akagai"
msgstr "Akagai"

#. y4:line_status=translated
#. y4:item_index=359
#. y4:item_id=sushi_akagai
#. y4:item_icon=2d_yk_sushi_akagai
#. y4:item_field=description
#. y4:item_pair_context=25223
msgctxt "106806"
msgid "Did you know that red clams have red blood? Ancient records speak of a red clam goddess named Princess Kisagahi."
msgstr "¿Sabías que los akagai tienen sangre roja? Los registros antiguos hablan de una diosa akagai llamada Princesa Kisagahi."

#. y4:line_status=translated
#. y4:item_index=360
#. y4:item_id=sushi_toro
#. y4:item_icon=2d_yk_sushi_toro
#. y4:item_field=name
#. y4:item_pair_context=106919
msgctxt "25230"
msgid "Otoro"
msgstr "Otoro"

#. y4:line_status=translated
#. y4:item_index=360
#. y4:item_id=sushi_toro
#. y4:item_icon=2d_yk_sushi_toro
#. y4:item_field=description
#. y4:item_pair_context=25230
msgctxt "106919"
msgid "This is the richest meat from my top-grade bluefin tuna. It'll melt in your mouth."
msgstr "Esta es la carne más rica de mi atún rojo de primera calidad. Se deshace en la boca."

#. y4:line_status=translated
#. y4:item_index=361
#. y4:item_id=sushi_awabi
#. y4:item_icon=2d_yk_sushi_awabi
#. y4:item_field=name
#. y4:item_pair_context=107002
msgctxt "25236"
msgid "Awabi"
msgstr "Awabi"

#. y4:line_status=translated
#. y4:item_index=361
#. y4:item_id=sushi_awabi
#. y4:item_icon=2d_yk_sushi_awabi
#. y4:item_field=description
#. y4:item_pair_context=25236
msgctxt "107002"
msgid "This is top-grade abalone right here. Discount hunters had best look elsewhere."
msgstr "Esto es abulón de primera calidad. Será mejor que los cazadores de descuentos busquen en otra parte."

#. y4:line_status=translated
#. y4:item_index=362
#. y4:item_id=sushi_uni
#. y4:item_icon=2d_yk_sushi_uni
#. y4:item_field=name
#. y4:item_pair_context=107082
msgctxt "25242"
msgid "Uni"
msgstr "Uni"

#. y4:line_status=translated
#. y4:item_index=362
#. y4:item_id=sushi_uni
#. y4:item_icon=2d_yk_sushi_uni
#. y4:item_field=description
#. y4:item_pair_context=25242
msgctxt "107082"
msgid "This top-grade sea urchin comes straight from Numazu Port."
msgstr "Erizo de mar de alta calidad directamente del Puerto de Numazu."

