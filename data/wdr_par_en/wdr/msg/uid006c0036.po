#. y4:msg_branch_choice=You think a hostess can be a good teacher?
msgctxt "4668_松岡里緒奈：源氏名"
msgid "What does being a hostess have to do with teaching?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=24
#. y4:msg_location=T1.P24
