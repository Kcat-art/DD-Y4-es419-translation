#. y4:msg_label=Diálogo
#. y4:msg_talk=109
#. y4:msg_phrase=1
#. y4:msg_location=T109.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "17268_Kiryu"
