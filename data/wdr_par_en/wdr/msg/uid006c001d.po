#. y4:msg_location=T15.P26
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are there other foods you can't eat?
msgctxt "12180_Rio"
msgid "That's what makes it so sad."
msgstr "Eso es lo que lo hace tan triste."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=27
#. y4:msg_location=T15.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are there other foods you can't eat?
msgctxt "12192_Akiyama"
msgid "Yeah, that's too bad."
msgstr "Sí... Es una lástima."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=28
#. y4:msg_location=T15.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are there other foods you can't eat?
msgctxt "12204_Akiyama"
msgid "Well, I suppose we shouldn't get sushi if we go out on a date, huh?"
msgstr "Bueno, supongo que no deberíamos comer sushi si salimos en una cita, ¿eh?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=29
#. y4:msg_location=T15.P29
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are there other foods you can't eat?
msgctxt "12216_Rio"
msgid "I can eat other kinds of fish, so I wouldn't mind! I love sushi!"
msgstr "Puedo comer otros tipos de pescado, ¡así que no me importaría! ¡Me encanta el sushi!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
