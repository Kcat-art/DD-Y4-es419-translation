#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'd stay a human.
msgctxt "6444_松岡里緒奈：源氏名"
msgid "This is giving me a headache..."
msgstr "Esto me está dando dolor de cabeza..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=15
