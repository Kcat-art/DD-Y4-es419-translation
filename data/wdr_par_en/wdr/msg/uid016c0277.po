#. y4:msg_branch_target_text=Why? Do I look like one?
#. y4:msg_branch_raw=01 11 00 0b 00 00 00 18 00 00 00 00 00 00 00 00
msgctxt "2196_Tanimura"
msgid "Why? Do I look like one?"
msgstr "¿Por qué? ¿Parezco uno?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=12
#. y4:msg_location=T34.P12
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why? Do I look like one?
msgctxt "2208_峰村七海：源氏名"
msgid "Well... You do look very confident. Like you can handle anything your job might throw at you."
msgstr "Bueno... Se ve muy seguro de sí mismo. Como si pudiera enfrentarse a cualquier cosa que el trabajo le depare."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=13
#. y4:msg_location=T34.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=21
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why? Do I look like one?
msgctxt "2220_Tanimura"
msgid "I'm a bit different than the average cop. I'm a detective."
msgstr "Digamos que soy diferente a un policía común. Yo soy un detective."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=14
#. y4:msg_location=T34.P14
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why? Do I look like one?
msgctxt "2232_峰村七海：源氏名"
msgid "Oh, I see!"
msgstr "¡Oh, ya veo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=15
#. y4:msg_location=T34.P15
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=21
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why? Do I look like one?
msgctxt "2244_Tanimura"
msgid "But if I keep working at it, I might get promoted some day."
msgstr "Pero si esforzándome en mi trabajo, puede que me asciendan algún día."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=16
#. y4:msg_location=T34.P16
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why? Do I look like one?
msgctxt "2256_峰村七海：源氏名"
msgid "Good luck!"
msgstr "¡Buena suerte!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=17
#. y4:msg_location=T34.P17
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=21
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Mm-hm. That's right.
msgctxt "2268_Tanimura"
msgid "Mm-hm. That's right. They made me chief inspector not long ago."
msgstr "Mm-hm. Así es. Me nombraron inspector jefe no hace mucho."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=18
#. y4:msg_location=T34.P18
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Mm-hm. That's right.
msgctxt "2280_峰村七海：源氏名"
msgid "Really? Wow!"
msgstr "Oh, ¿de verdad? ¡Vaya!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=19
#. y4:msg_location=T34.P19
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=21
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Mm-hm. That's right.
msgctxt "2292_Tanimura"
msgid "I'm just kidding... I didn't think you'd be so surprised."
msgstr "Estoy bromeando... No pensé que te sorprenderías tanto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=20
#. y4:msg_location=T34.P20
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
