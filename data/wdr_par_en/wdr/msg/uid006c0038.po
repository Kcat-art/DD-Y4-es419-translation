#. y4:msg_branch_choice=Yeah, but kids like me.
msgctxt "5988_望月京子：源氏名"
msgid "Seriously? I would have thought they'd start crying at the sight of you."
msgstr "¿De verdad? Pensaba que correrian de ti al verte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
