#. y4:msg_location=T2.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sounds like fate. You should buy him.
msgctxt "9168_Rio"
msgid "......"
msgstr "......"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=26
#. y4:msg_location=T9.P26
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I could never do that. I'm not very observant.
msgctxt "9180_Rio"
msgid "Wait! Now that I think about it, people who <Italic>think</Italic> they're unobservant are probably the most observant!"
msgstr "¡Espera! ¡Ahora que lo pienso, la gente que <Italic>piensa</Italic> que es poco observadora es probablemente la más observadora!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=27
#. y4:msg_location=T9.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I could never do that. I'm not very observant.
msgctxt "9192_Akiyama"
msgid "How's that work?"
msgstr "¿Cómo funciona eso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=28
#. y4:msg_location=T9.P28
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I could never do that. I'm not very observant.
msgctxt "9204_Rio"
msgid "A truly unobservant person would never notice that they're unobservant!"
msgstr "¡Una persona poco observadora nunca notaría que no es observadora!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=29
#. y4:msg_location=T9.P29
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I could never do that. I'm not very observant.
msgctxt "9216_Akiyama"
msgid "Hehe. Never thought of it that way before."
msgstr "Je, je. Nunca lo había pensado de esa forma."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=0
#. y4:msg_location=T10.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "9228_Rio"
msgid "Akiyama-san, how long have you been at your job?"
msgstr "Akiyama-san, ¿cuánto tiempo lleva usted en su trabajo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=1
#. y4:msg_location=T10.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "9240_Akiyama"
msgid "Hm, well... I think it's approaching around five years now?"
msgstr "Hmm, bueno... ¿creo que cinco años más o menos?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=2
#. y4:msg_location=T10.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "9252_Rio"
msgid "That's a pretty long while!"
msgstr "¡Eso es bastante tiempo!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=3
#. y4:msg_location=T10.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "9264_Akiyama"
msgid "What about you?"
msgstr "¿Qué hay de ti?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=4
#. y4:msg_location=T10.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "9276_Rio"
msgid "Not that long. I'm the type of person who has trouble sticking with things over time."
msgstr ""

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=5
#. y4:msg_location=T10.P5
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=10
#. y4:msg_decision_choices=1. I'm the same way. -> T10.P6 | 2. That's not good. -> T10.P18 | 3. Don't worry about it. You're still young. -> T10.P25
msgctxt "9288_Rio"
msgid "Maybe I just get bored too easily. I'm a jack of all trades and master of none."
msgstr "Tal vez me aburro con demasiada facilidad. Soy una todologa."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=151
#. y4:msg_phrase=0
#. y4:msg_location=T151.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T10.P6
#. y4:msg_branch_segment=T10.P6..P17
#. y4:msg_branch_target_text=I'm the same way.
#. y4:msg_branch_raw=01 11 00 06 00 00 00 11 00 00 00 00 00 00 00 00
msgctxt "9300_Akiyama"
msgid "I'm the same way."
msgstr "Yo soy igual."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=7
#. y4:msg_location=T10.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm the same way.
msgctxt "9312_Rio"
msgid "Really? You're a jack of all trades too, Akiyama-san?"
msgstr "¿De verdad? ¿Usted también es un todólogo, Akiyama-san?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=8
#. y4:msg_location=T10.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm the same way.
msgctxt "9324_Akiyama"
msgid "No, I just get bored easily."
msgstr "No, solo me aburro con facilidad."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=9
#. y4:msg_location=T10.P9
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm the same way.
msgctxt "9336_Rio"
msgid "...That doesn't sound very healthy."
msgstr "... Eso no suena muy saludable."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=10
#. y4:msg_location=T10.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm the same way.
msgctxt "9348_Akiyama"
msgid "Look, most people aren't doing what they really want with their lives."
msgstr "Mira, la mayoría de la gente no está haciendo lo que realmente quiere con su vida."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=11
#. y4:msg_location=T10.P11
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm the same way.
msgctxt "9360_Rio"
msgid "I guess that's true."
msgstr "Supongo que tiene razón."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=12
#. y4:msg_location=T10.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm the same way.
msgctxt "9372_Akiyama"
msgid "Yeah, yeah. And about being a jack of all trades..."
msgstr "Sí, sí. Y sobre ser todologa..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=13
#. y4:msg_location=T10.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm the same way.
msgctxt "9384_Akiyama"
msgid "Talented people like you catch on a lot quicker than the average person, so they want to try lots of different things."
msgstr "Las personas talentosas como tú aprenden mucho más rápido que el promedio, así que quieren probar muchas cosas diferentes."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=14
#. y4:msg_location=T10.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm the same way.
msgctxt "9396_Akiyama"
msgid "It may look like you get bored easily, but you're just trying to experience as much as you can."
msgstr "Puede parecer que te aburres fácilmente, pero solo estás tratando de experimentar todo lo que puedas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=15
#. y4:msg_location=T10.P15
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm the same way.
msgctxt "9408_Rio"
msgid "Ooh, that sounds about right! Maybe I've been trying too many things?"
msgstr "Oh, ¡eso suena bastante acertado! ¿Quizás he estado probando demasiadas cosas?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=16
#. y4:msg_location=T10.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm the same way.
msgctxt "9420_Akiyama"
msgid "Keep it up. Sooner or later, you'll find something you want to stick with."
msgstr "Sigue así. Tarde o temprano encontrarás algo con lo que quieras comprometerte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=17
#. y4:msg_location=T10.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm the same way.
msgctxt "9432_Rio"
msgid "Hehe, I hope so."
msgstr "Je, je, eso espero."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=18
#. y4:msg_location=T10.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's not good.
msgctxt "9444_Akiyama"
msgid "Being a jack of all trades is not good, though."
msgstr "Pero ser bueno en muchas cosas no siempre es bueno."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=19
#. y4:msg_location=T10.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's not good.
msgctxt "9456_Akiyama"
msgid "If you don't settle into something soon, your whole life will fly by without you finding what you want to do."
msgstr "Si no te adaptas a algo pronto, toda tu vida pasará volando sin que encuentres lo que quieres hacer."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=20
#. y4:msg_location=T10.P20
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's not good.
msgctxt "9468_Rio"
msgid "You're right..."
msgstr "Usted tiene razón..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=21
#. y4:msg_location=T10.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's not good.
msgctxt "9480_Akiyama"
msgid "But on the other hand, it shows you're a quick learner, so you've still got time."
msgstr "Pero, por otro lado, demuestra que aprendes rápido, por lo que aún tienes tiempo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=22
#. y4:msg_location=T10.P22
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's not good.
msgctxt "9492_Rio"
msgid "You mean it?"
msgstr "¿Lo dices en serio?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=23
#. y4:msg_location=T10.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's not good.
msgctxt "9504_Akiyama"
msgid "I was the same way. I had plenty of problems, but things came together for me eventually."
msgstr "A mí me pasó lo mismo. Tuve muchos problemas, pero al final las cosas me salieron bien."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=24
#. y4:msg_location=T10.P24
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's not good.
msgctxt "9516_Rio"
msgid "Hehehe. You certainly are persuasive, Akiyama-san."
msgstr "Je, je, je. Ciertamente, eres persuasivo, Akiyama-San."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=153
#. y4:msg_phrase=0
#. y4:msg_location=T153.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T10.P25
#. y4:msg_branch_segment=T10.P25..P31
#. y4:msg_branch_target_text=Don't worry about it. You're still young.
#. y4:msg_branch_raw=01 11 00 19 00 00 00 29 00 00 00 00 00 00 00 00
msgctxt "9528_Akiyama"
msgid "Don't worry about it. You're still young."
msgstr "No te preocupes por ello. Aún eres joven."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=26
#. y4:msg_location=T10.P26
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Don't worry about it. You're still young.
msgctxt "9540_Rio"
msgid "I shouldn't worry, huh?"
msgstr "No debería preocuparme, ¿eh?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=27
#. y4:msg_location=T10.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Don't worry about it. You're still young.
msgctxt "9552_Akiyama"
msgid "Sure. You'd be surprised how often people find something without meaning to."
msgstr "Claro. Te sorprendería la frecuencia con la que la gente encuentra algo sin querer."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=28
#. y4:msg_location=T10.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Don't worry about it. You're still young.
msgctxt "9564_Akiyama"
msgid "You just haven't found what fits you yet, that's all. Don't stress."
msgstr "Todavía no has encontrado lo que encaja contigo, eso es todo. No te estreses."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=29
#. y4:msg_location=T10.P29
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Don't worry about it. You're still young.
msgctxt "9576_Rio"
msgid "Hehe. So that means I might find it in the future then, huh?"
msgstr "Je, je. Así que eso significa que podría encontrarlo en el futuro, ¿eh?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=37
#. y4:msg_location=T8.P37
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a positive way to look at things.
msgctxt "9588_Akiyama"
msgid "Exactly."
msgstr "Exacto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=31
#. y4:msg_location=T10.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Don't worry about it. You're still young.
msgctxt "9600_Rio"
msgid "I'm so glad I talked to you about this, Akiyama-san!"
msgstr "¡Me alegro mucho de haberte hablado de esto, Akiyama-san!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=0
#. y4:msg_location=T11.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "9612_Rio"
msgid "So I did an interview today."
msgstr "Hoy hice una entrevista."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=1
#. y4:msg_location=T11.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "9624_Akiyama"
msgid "For your magazine column?"
msgstr "¿Para la columna de tu revista?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=2
#. y4:msg_location=T11.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "9636_Rio"
msgid "Yup! It was my very first interview!"
msgstr "¡Síp! ¡Fue mi primer entrevista!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=3
#. y4:msg_location=T11.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "9648_Akiyama"
msgid "Oh yeah? Was it fun?"
msgstr "¿Oh, de verdad? ¿Fue divertido?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=4
#. y4:msg_location=T11.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "9660_Rio"
msgid "Oh yeah, totally! But..."
msgstr "¡Oh, claro, totalmente! Pero..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=5
#. y4:msg_location=T11.P5
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "9672_Rio"
msgid "To be honest, I think I messed up a lot."
msgstr "Para ser honesta, creo que he metido mucho la pata."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=6
#. y4:msg_location=T11.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "9684_Akiyama"
msgid "Did somebody say something to you?"
msgstr "¿Alguien te dijo algo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=7
#. y4:msg_location=T11.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "9696_Rio"
msgid "No, everybody was very complimentary. They said it went well."
msgstr "No, todo el mundo fue muy halagador. Dijeron que había ido todo bien."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=8
#. y4:msg_location=T11.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "9708_Akiyama"
msgid "So what's the problem?"
msgstr "Entonces, ¿cuál es el problema?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=9
#. y4:msg_location=T11.P9
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "9720_Rio"
msgid "They were just a little too nice, you know? They're always like that to me. I can never tell what they're really thinking."
msgstr "Eran un poco demasiado amables, ¿sabes? Siempre son así conmigo. Nunca puedo decir lo que realmente están pensando."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=10
#. y4:msg_location=T11.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "9732_Akiyama"
msgid "I get what you're saying."
msgstr "Entiendo lo que dices."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=11
#. y4:msg_location=T11.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "9744_Akiyama"
msgid "Since this is your first time, you'd rather have them point out your faults so you can improve."
msgstr "Como esta es tu primera vez, prefieres que te señalen tus fallos para que puedas mejorar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=39
#. y4:msg_location=T4.P39
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Why did you pick the guitar?
msgctxt "9756_Rio"
msgid "Yes! Exactly!"
msgstr "¡Sí! ¡Exactamente!"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=13
#. y4:msg_location=T11.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=11
#. y4:msg_decision_choices=1. The problem is how you carry yourself. -> T11.P14 | 2. I can think of worse problems. -> T11.P31 | 3. That's too bad. -> T11.P40
msgctxt "9768_Akiyama"
msgid "I see..."
msgstr "Ya veo..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=154
#. y4:msg_phrase=0
#. y4:msg_location=T154.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T11.P14
#. y4:msg_branch_segment=T11.P14..P30
#. y4:msg_branch_target_text=The problem is how you carry yourself.
#. y4:msg_branch_raw=01 11 00 0e 00 00 00 26 00 00 00 00 00 00 00 00
msgctxt "9780_Akiyama"
msgid "The problem is how you carry yourself."
msgstr "El problema es cómo te comportas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=So what do you think now that you're doing it?
msgctxt "9792_Rio"
msgid "What do you mean?"
msgstr "¿A qué te refieres?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=16
#. y4:msg_location=T11.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9804_Akiyama"
msgid "Everyone carries themself in a certain way. Sometimes it's good, sometimes it's bad."
msgstr "Todo el mundo se comporta de cierta manera. A veces es bueno, a veces es malo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=17
#. y4:msg_location=T11.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9816_Rio"
msgid "I don't think I'm really getting it."
msgstr "No creo entenderlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=18
#. y4:msg_location=T11.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9828_Akiyama"
msgid "For example, someone might carry himself in a way that makes him seem dangerous and reckless."
msgstr "Por ejemplo, alguien puede comportarse de un modo que le haga parecer peligroso e imprudente."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=19
#. y4:msg_location=T11.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9840_Akiyama"
msgid "He could be the nicest guy in the world, but all people are gonna see is this dangerous man."
msgstr "Podría ser el tipo más amable del mundo, pero lo único que la gente va a ver es a ese hombre peligroso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=20
#. y4:msg_location=T11.P20
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9852_Rio"
msgid "I guess so..."
msgstr "Supongo..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=21
#. y4:msg_location=T11.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9864_Akiyama"
msgid "On the other hand, say someone carries himself in a mellow way that just makes him seem very nonthreatening."
msgstr "Por otro lado, supongamos que alguien se comporta de una manera tranquila que simplemente lo hace parecer muy inofensivo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=22
#. y4:msg_location=T11.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9876_Akiyama"
msgid "No one's going to be on their guard when someone like that shows up."
msgstr "Nadie estará en guardia cuando aparezca una persona así."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=23
#. y4:msg_location=T11.P23
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9888_Rio"
msgid "Oh! I think I see where you're going with this!"
msgstr "¡Oh! ¡Creo que sé a dónde quieres llegar con esto!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=24
#. y4:msg_location=T11.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9900_Akiyama"
msgid "That might be the problem in your case. No one's on their guard and asking a lot of you because you seem very nonthreatening."
msgstr "Ese podría ser el problema en tu caso. Nadie se pone en guardia y te pide mucho por qué pareces muy poco amenazante."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=25
#. y4:msg_location=T11.P25
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9912_Rio"
msgid "Now I get it!"
msgstr "¡Ahora lo entiendo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=26
#. y4:msg_location=T11.P26
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9924_Rio"
msgid "So... I probably shouldn't worry too much about it, huh?"
msgstr "Así que... probablemente no debería preocuparme demasiado por eso, ¿eh?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=27
#. y4:msg_location=T11.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9936_Akiyama"
msgid "Hmm... Well..."
msgstr "Mmm... Bueno..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=28
#. y4:msg_location=T11.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9948_Akiyama"
msgid "What I'm trying to say is that people aren't going to point out your faults because they don't expect much based on the way you carry yourself. You'll have to figure them out by yourself."
msgstr "Lo que quiero decir es que la gente no va a señalar tus defectos porque no esperan mucho de ti por tu forma de ser. Tendrás que descubrirlos por ti misma."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=29
#. y4:msg_location=T11.P29
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9960_Rio"
msgid "Wait, what!?"
msgstr "Espera, ¡¿qué?!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=30
#. y4:msg_location=T11.P30
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=The problem is how you carry yourself.
msgctxt "9972_Akiyama"
msgid "That doesn't sound so bad."
msgstr "Eso no suena tan mal."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=155
#. y4:msg_phrase=0
#. y4:msg_location=T155.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T11.P31
#. y4:msg_branch_segment=T11.P31..P39
#. y4:msg_branch_target_text=I can think of worse problems.
#. y4:msg_branch_raw=01 11 00 1f 00 00 00 1e 00 00 00 00 00 00 00 00
msgctxt "9984_Akiyama"
msgid "I can think of worse problems."
msgstr "Se me ocurren problemas peores."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "9996_Rio"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=33
#. y4:msg_location=T11.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can think of worse problems.
msgctxt "10008_Rio"
msgid "There must be things that I can improve on even if it's something small."
msgstr "Debe haber cosas en las que pueda mejorar, incluso si es algo sin importancia."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=34
#. y4:msg_location=T11.P34
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can think of worse problems.
msgctxt "10020_Akiyama"
msgid "Sure. You're human. There are always things you can improve on."
msgstr "Claro. Eres humana. Siempre hay cosas que puedes mejorar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=35
#. y4:msg_location=T11.P35
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can think of worse problems.
msgctxt "10032_Akiyama"
msgid "You'll just have to figure out what they are by yourself."
msgstr "Solo tienes que descubrir cuáles son por ti misma."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=36
#. y4:msg_location=T11.P36
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can think of worse problems.
msgctxt "10044_Rio"
msgid "Huh!?"
msgstr "¡¿Eh?!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=37
#. y4:msg_location=T11.P37
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can think of worse problems.
msgctxt "10056_Akiyama"
msgid "It's the same result whether someone else points it out or you figure it out on your own."
msgstr "El resultado es el mismo tanto si te lo indica otra persona o que lo descubras por tu cuenta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=38
#. y4:msg_location=T11.P38
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can think of worse problems.
msgctxt "10068_Rio"
msgid "I guess, but..."
msgstr "Supongo, pero..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=39
#. y4:msg_location=T11.P39
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can think of worse problems.
msgctxt "10080_Rio"
msgid "This is tricky."
msgstr "Esto es complicado."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=156
#. y4:msg_phrase=0
#. y4:msg_location=T156.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T11.P40
#. y4:msg_branch_segment=T11.P40..P52
#. y4:msg_branch_target_text=That's too bad.
#. y4:msg_branch_raw=01 11 00 28 00 00 00 0f 00 00 00 00 00 00 00 00
msgctxt "10092_Akiyama"
msgid "That's too bad."
msgstr "Eso es... una pena."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=41
#. y4:msg_location=T11.P41
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's too bad.
msgctxt "10104_Rio"
msgid "It is. I just want someone to tell me what I can improve on even if it's just something minor!"
msgstr "Así es. Sólo quiero que alguien me diga en qué puedo mejorar, ¡aunque sea algo sin importancia!"

