#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Whiny Man
#. y4:msg_speaker_id=0
msgctxt "56_Whiny Man"
msgid "Forget it! Those girls hate my guts!"
msgstr "¡Olvidalo! ¡Esas mujeres me odian!"

#. y4:line_status=translated
msgctxt "68_Calming Woman"
msgid "Don't give up now... After all, you've only seen three of\\r\nthem."
msgstr "No te rindas, además... Solo has visitado a tres mujeres."

#. y4:line_status=translated
msgctxt "80_Whiny Man"
msgid "Yeah, and each one gave me the same open-mouthed stare. My\\r\nbest jokes flew right over their heads!"
msgstr "Sí, y todas me miraron raro. ¡Mis chistes son de lo peor!"

#. y4:line_status=translated
msgctxt "92_Whiny Man"
msgid "I'm tellin' you, it isn't workin' out! It's no use. I'll\\r\nnever manage an article on hostess club tips and tricks."
msgstr "¡Ya te lo dije! Esto no está funcionando. Nunca podré escribir\\r\nuna revista sobre consejos y trucos para charlar con anfitrionas."

#. y4:line_status=translated
msgctxt "104_Akiyama"
msgid "Excuse me. I hate to interrupt, but if you're not going in,\\r\nwould you mind moving aside?"
msgstr "Perdonen, odio interrumpir, pero... Les importaría\\r\ndejarme pasar, ¿por favor?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Calming Woman
#. y4:msg_speaker_id=2
msgctxt "128_Calming Woman"
msgid "Ah, sorry! We'll get out of your way."
msgstr "Ah, ¡lo siento mucho! Ya nos vamos."

#. y4:line_status=translated
msgctxt "140_Akiyama"
msgid "Wait, aren't you Minamizawa-san? From the Mars Fighters\\r\ncomedy duo? Wow! I'm a big fan of yours!"
msgstr "Un momento, porfavor. ¿Usted no es Minamizawa-san del dúo de\\r\ncomediantes Mars Fighters? ¡Soy admirador suyo!"

#. y4:line_status=translated
msgctxt "152_Calming Woman"
msgid "See, Minamizawa-san? I told you you had plenty of fans in\\r\nKanto."
msgstr "¿Lo ves, Minamizawa-san? Te dije que en Tokio\\r\ntenías admiradores."

#. y4:line_status=translated
msgctxt "164_Akiyama"
msgid "Are you here for work? Hope it goes well. I'll be rooting\\r\nfor you."
msgstr "¿Está aquí por trabajo? Espero que le vaya bien.\\r\nSi necesita algo, cuente conmigo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Minamizawa
#. y4:msg_speaker_id=11
msgctxt "176_Minamizawa"
msgid "Thanks a lot. I appreciate it!"
msgstr "¡Muchas gracias! Lo aprecio mucho."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Calming Woman
#. y4:msg_speaker_id=2
msgctxt "188_Calming Woman"
msgid "(Minamizawa-san, this is your chance! This fan of yours seems to know the nightlife around here. Maybe he can tell us about the hostess clubs.)"
msgstr "(Minamizawa-san, ¡esta es tu oportunidad! Este admirador tuyo parece\\r\nvivir aquí. Tal vez pueda contarnos sobre los clubes de anfitrionas.)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Minamizawa
#. y4:msg_speaker_id=11
msgctxt "200_Minamizawa"
msgid "(What are you talkin' about? You want me to embarrass myself in front of a fan!?)"
msgstr "(¿De qué estás hablando? ¡¿Quieres que me avergüence enfrente de un fan?!)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Calming Woman
#. y4:msg_speaker_id=2
msgctxt "212_Calming Woman"
msgid "(Here's the thing, Minamizawa-san. Entertainers have to be responsible if they want to get hired back. Fulfilling your assignment is paramount.)"
msgstr "(Mira, Minamizawa-san. Los famosos deben ser responsables si quieren ser\\r\ncontratados o no. Cumplir con tu trabajo es importante.)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Calming Woman
#. y4:msg_speaker_id=2
msgctxt "224_Calming Woman"
msgid "(Keep up the spoiled-brat act, and I'll see to it you never darken the doorstep of our publishing house again.)"
msgstr "(Si vas a seguir quejándote me aseguraré de que nunca te representemos otra vez.)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Minamizawa
#. y4:msg_speaker_id=11
msgctxt "236_Minamizawa"
msgid "All right. Okay. I'll do it."
msgstr "(¡Está bien! De acuerdo, hagámoslo.)"

#. y4:line_status=translated
msgctxt "248_Calming Woman"
msgid "Excuse me! Do you happen to frequent hostess clubs, if I may\\r\nbe so bold as to ask?"
msgstr "Disculpe, ¿siempre va a clubes de anfitrionas?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=6
msgctxt "260_Akiyama"
msgid "Hm? Yeah, I guess you could say that."
msgstr "Hmm, sí, podría decirse que sí."

#. y4:line_status=translated
msgctxt "272_Ashibe"
msgid "Wonderful! Allow me to introduce myself. I am Ashibe, an\\r\neditor for \"Casanova,\" a magazine for men who want to\\r\nbecome more popular with the ladies. And, er..."
msgstr "¡Genial! Permíteme presentarme. Soy Ashibe, editora de “Casanova”, una revista para\\r\nhombres que quieren hacerse más populares con las mujeres. ¿Y usted es...?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=6
msgctxt "284_Akiyama"
msgid "Oh, I'm Akiyama."
msgstr "Oh, mucho gusto, soy Akiyama."

#. y4:line_status=translated
msgctxt "296_Ashibe"
msgid "The thing is, Akiyama-san, we've commissioned a series of\\r\narticles from Minamizawa-san here on some tips to use at the\\r\nclubs Jewel and Shine."
msgstr "Akiyama-san, lo que pasa es que le pedimos a Minamizawa-san escribir\\r\nconsejos para usar en los clubes Jewel y Shine."

#. y4:line_status=translated
msgctxt "308_Ashibe"
msgid "But it seems they do things differently out west, where\\r\nMinamizawa-san is from. He's having a hard time hitting it off with these Tokyo girls."
msgstr "Pero parece que en el oeste, donde vive Minamizawa-san, las cosas se hacen\\r\nde diferente modo. Y está teniendo dificultades para conectar con las chicas de Tokio."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=6
msgctxt "320_Akiyama"
msgid "Oh, I'm sorry to hear that..."
msgstr "Oh, ya veo..."

#. y4:line_status=translated
msgctxt "332_Ashibe"
msgid "Do you think you could give Minamizawa-san a little info on\\r\nsome of the girls at the clubs I've mentioned?"
msgstr "¿Cree que podría ayudar a Minamizawa-san sobre cómo platicar co\\r\nlas chicas de los clubes que le mencioné?"

#. y4:line_status=translated
msgctxt "344_Ashibe"
msgid "I'll pay you for your time, of course. Come on,\\r\nMinamizawa-san. Don't you have something to add?"
msgstr "Le compensaré por su tiempo, claro. Bien, Minamizawa-san, ¿algo qué decir?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Minamizawa
#. y4:msg_speaker_id=11
msgctxt "356_Minamizawa"
msgid "Please...?"
msgstr "¿Por favor?..."

#. y4:line_status=translated
msgctxt "368_Akiyama"
msgid "Well, I guess I could tell you about a couple of my\\r\nfavorites..."
msgstr "Bueno, creo que la mayoría de mis consejos podrían servirle..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Ashibe
#. y4:msg_speaker_id=15
msgctxt "380_Ashibe"
msgid "That would be wonderful! Thank you very much!"
msgstr "¡Eso es genial! ¡Muchas gracias!"

#. y4:line_status=translated
msgctxt "392_Ashibe"
msgid "We're working out of Cuez Bar in the Kamurocho Underground\\r\nMall. Could you stop by there when you have some info for\\r\nus?"
msgstr "Trabajamos en Cuez Bar en el centro comercial subterráneo de Kamurocho.\\r\n¿Podría pasarse por allí una vez tenga información para nosotros?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Minamizawa
#. y4:msg_speaker_id=11
msgctxt "404_Minamizawa"
msgid "Please, whenever you can!"
msgstr "¡Por favor, tómese su tiempo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=6
msgctxt "416_Akiyama"
msgid "Sure thing. I'll see you later, then."
msgstr "Claro, nos vemos luego entonces."
