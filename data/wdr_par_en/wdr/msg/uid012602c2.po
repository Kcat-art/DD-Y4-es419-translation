#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "100_Saejima"
msgid "(So this is the treasure, huh? Enough to keep those cats fat n' happy for life...)"
msgstr "(¿Así que este es el tesoro, eh? Suficiente para mantener gordos a esos gatos por toda su vida...)"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=1
msgctxt "124_Cat-loving Homeless Man"
msgid "Hey, pal! What are you doing down here?"
msgstr "¡Oye, Amigo! ¿Qué haces por aquí abajo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "136_Saejima"
msgid "Hey yourself."
msgstr "Oye, tú."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Give It to Him -> T0.P15 | 2. Keep the Cash -> T0.P5
msgctxt "148_Saejima"
msgid "(If this money's for the cats' upkeep, should I give it to the guy who's takin' care of 'em?)"
msgstr "(Este dinero es para el mantenimiento de los gatos, ¿debería dárselo al tipo que los está cuidando?)"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Keep the Cash
msgctxt "160_Saejima"
msgid "(It'll be alright. He seems more into the cats than the treasure, anyhow.)"
msgstr "(Estará bien. De todos modos, parecen interesarle más los gatos que el tesoro.)"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Keep the Cash
msgctxt "172_Cat-loving Homeless Man"
msgid "Um... Is something wrong?"
msgstr "¿Um... Pasa algo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Keep the Cash
msgctxt "184_Saejima"
msgid "Oh, uh... nope."
msgstr "Oh, eh... no nada."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Keep the Cash
msgctxt "196_Cat-loving Homeless Man"
msgid "All right, then. Whoa, look at the time. I've got places to be. See you!"
msgstr "Pues buen, entonces. Guau, mira la hora. Tengo cosas que hacer. ¡Nos vemos!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Keep the Cash
msgctxt "208_Saejima"
msgid "Yeah."
msgstr "Sí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Keep the Cash
msgctxt "232_Saejima"
msgid "(That left a bad taste in my mouth.)"
msgstr "(Me ha dejado mal sabor de boca.)"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "280_Saejima"
msgid "Great timin'. Here ya go."
msgstr "Qué buen momento. Toma."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "316_Cat-loving Homeless Man"
msgid "Goodness! Where'd this come from?"
msgstr "¡Dios mío! ¿De dónde has sacado esto?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "328_Saejima"
msgid "It was in the locker."
msgstr "Estaba en la taquilla."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "340_Cat-loving Homeless Man"
msgid "Ah, so this is the treasure? There really was something in there!"
msgstr "Ah, ¿entonces esto es el tesoro? ¡De verdad había algo ahí dentro!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "352_Saejima"
msgid "Yeah. I figured it's to pay for the cats' room n' board, so I'm givin' it to you."
msgstr "Sí. Imagino que es para pagar por la casita de los gatos, así que te lo daré a ti."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "364_Cat-loving Homeless Man"
msgid "What? You really don't have to do that!"
msgstr "¿Qué? ¡En serio, no tienes que hacer esto!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "376_Saejima"
msgid "You're the one who's lookin' after these little guys. Go on. Take it."
msgstr "Tú eres el que está cuidando a estos pequeños. Así que adelante. Tómalo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "388_Cat-loving Homeless Man"
msgid "Wow. I just... I don't know how to thank you."
msgstr "Wow. Es solo que... no sé como agradecértelo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "400_Cat-loving Homeless Man"
msgid "Oh, I know! I wouldn't call this a fair trade, but it's yours now."
msgstr "¡Oh, ya sé! No diría que esto es un intercambio equivalente, pero es tuyo ahora."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "448_Cat-loving Homeless Man"
msgid "I kept it because it was so cute, but now that I have these fellas, I want it to be yours. Call it a souvenir."
msgstr "Lo guardé porque era muy lindo, pero ahora que tengo a estos pequeñines, quiero que sea tuyo. Llévatelo como recuerdo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "460_Saejima"
msgid "Sure. Thanks."
msgstr "Claro. Gracias."

