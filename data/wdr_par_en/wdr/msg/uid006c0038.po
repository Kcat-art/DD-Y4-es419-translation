#. y4:msg_branch_raw=01 11 00 07 00 00 00 17 00 00 00 00 00 00 00 00
msgctxt "5976_Kiryu"
msgid "Yeah, but kids like me."
msgstr "En parte, a los niños les caigo bien."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
