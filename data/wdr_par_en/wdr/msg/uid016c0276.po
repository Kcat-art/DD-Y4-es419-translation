#. y4:msg_branch_raw=01 11 00 11 00 00 00 2b 00 00 00 00 00 00 00 00
msgctxt "1632_Kiryu"
msgid "Black hair will come back in style someday."
msgstr "El cabello negro volverá a estar de moda algún día."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
