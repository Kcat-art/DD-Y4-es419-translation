#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=There's nothing wrong with it.
msgctxt "10560_Kiryu"
msgid "There's nothing to be embarrassed about. I just want to see the real you."
msgstr "No hay nada de qué avergonzarse. Solo quiero ver tu verdadero yo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
