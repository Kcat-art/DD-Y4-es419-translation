#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Romance movies.
msgctxt "10980_Kiryu"
msgid "Well, I only watch the ones that Haruka watches, but..."
msgstr "Bueno, solo veo las que ve Haruka, pero..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
