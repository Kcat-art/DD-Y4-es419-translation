#. y4:msg_speaker_id=15
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You're letting it bother you too much.
msgctxt "7232_Himeka"
msgid "What!? Are you just blaming it on me being high strung!?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=5
#. y4:msg_phrase=19
#. y4:msg_location=T5.P19
