msgctxt "84_Akiyama"
msgid "(Not ones for subtlety are they...?)"
msgstr "(La discreción no es su fuerte, ¿No?)"

msgctxt "108_Akiyama"
msgid "Funny thing about counterfeiting...\\r\n"
"It always leaves a paper trail."
msgstr "Parece que encontré la maquina de imprimir billetes falsos."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Shady Man A
#. y4:msg_speaker_id=2
msgctxt "120_Shady Man A"
msgid "Where the hell'd you come from?"
msgstr "¿De dónde demonios saliste?"

msgctxt "132_Akiyama"
msgid "This fellow sent me here. Said this is where the magic\\r\n"
"happens."
msgstr "Este tipo me envió. Quiero hacer un tour por\\r\n"
"la casa de papel."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Shady Man A
#. y4:msg_speaker_id=2
msgctxt "144_Shady Man A"
msgid "That son of a bitch sold us out!"
msgstr "¡Ese hijo de puta nos vendió!"

msgctxt "156_Shady Man A"
msgid "I don't know what you think you're doin' here, but the only\\r\n"
"way you're leavin' is in a body bag."
msgstr "No se cómo llegaste aquí... Pero te vuelves en ambulancia."

msgctxt "168_Akiyama"
msgid "Heh. Actually, I happen to have a bone to pick with you\\r\n"
"guys. Forgive me if I go a little overboard."
msgstr "Je. De hecho, tengo una espina clavada por su culpa.\\r\n"
"Así que, por favor perdónenme si les rompo la cara."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Shady Man A
#. y4:msg_speaker_id=2
msgctxt "180_Shady Man A"
msgid "Bastard...! You're asking for it!"
msgstr "¡Bastardo...! ¡Tú te lo buscaste!"
