msgid "...I just stopped by here on a whim, but I have heard about you before, believe it or not."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
