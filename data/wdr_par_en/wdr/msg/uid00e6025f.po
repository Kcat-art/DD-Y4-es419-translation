#. y4:msg_phrase=44
#. y4:msg_location=T0.P44
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "628_Akino"
msgid "Whaaaat! But the night's still young! Let's go somewhere fun..."
msgstr "¿Queeee? ¡Pero la noche es joven! Vamos a algún lugar divertido..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
