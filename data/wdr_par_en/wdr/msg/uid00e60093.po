#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "248_Akiyama"
msgid "What do you think about big girls?"
msgstr "¿Qué opinas de las chicas de talla grande?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
