#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Hot springs are nice, aren't they?
msgctxt "7692_Rio"
msgid "Hehe, that does sound like a good idea. I always get excited when I have a goal!"
msgstr "Jeje, eso suena como una buena idea. ¡Siempre me emociono cuando tengo un objetivo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=32
