#. y4:msg_branch_segment=T0.P55..P59
#. y4:msg_branch_target_text=That's a wonderful concept. One must always think about reducing risk, and not just about pursuing returns.
#. y4:msg_branch_raw=01 11 00 37 00 00 00 14 00 00 00 00 00 00 00 00
msgctxt "2892_Saejima"
msgid "No Risk, High Return"
msgstr ""

