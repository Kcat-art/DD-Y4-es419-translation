#. y4:msg_label=Diálogo
#. y4:msg_talk=9
#. y4:msg_phrase=1
#. y4:msg_location=T9.P1
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=3
msgctxt "1404_Shizuka"
msgid "Please enjoy yourself."
msgstr "Por favor, diviértase."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=9
#. y4:msg_phrase=2
#. y4:msg_location=T9.P2
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=3
