#. y4:msg_speaker_id=0
msgctxt "17616_望月京子：源氏名"
msgid "I came to work on my motorcycle today. Maybe you could ride behind me?"
msgstr "Hoy vine al trabajo en moto. ¿Podrías ir atrás mía?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=117
#. y4:msg_phrase=1
#. y4:msg_location=T117.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "17628_Kiryu"
msgid "I think I'll pass..."
msgstr "Mejor paso, gracias."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=118
#. y4:msg_phrase=0
#. y4:msg_location=T118.P0
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "17640_望月京子：源氏名"
msgid "After getting your email, I sat down and added it all up!"
msgstr "Después que recibí tu email, ¡Me senté y anote todo!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=118
#. y4:msg_phrase=1
#. y4:msg_location=T118.P1
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "17652_望月京子：源氏名"
msgid "Taking a taxi was actually cheaper than parking in a parking lot. I was really surprised!"
msgstr "Tomar un taxi es de verdad más barato que buscar lugar para estacionarse. ¡Es de no creer!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=118
#. y4:msg_phrase=2
#. y4:msg_location=T118.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "17664_Kiryu"
msgid "They're expensive during the day."
msgstr "Durante el día son más caros."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=118
#. y4:msg_phrase=3
#. y4:msg_location=T118.P3
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "17676_望月京子：源氏名"
msgid "I'm gonna try taking taxis more often. Thanks for the tip."
msgstr "Voy a tomar taxis con más frecuencia. Gracias por el consejo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=119
#. y4:msg_phrase=0
#. y4:msg_location=T119.P0
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "17688_望月京子：源氏名"
msgid "Remember when I had writer's block, you said that sleeping might help?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=119
#. y4:msg_phrase=1
#. y4:msg_location=T119.P1
