msgid "Well, I fell asleep before I had a chance to read your email."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=119
#. y4:msg_phrase=2
#. y4:msg_location=T119.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
