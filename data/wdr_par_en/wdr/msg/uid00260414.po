#. y4:msg_branch_target=T3.P1
#. y4:msg_branch_segment=T3.P1..P5
#. y4:msg_branch_target_text=I don't have time for this. You'll have to deal with it yourself.
#. y4:msg_branch_raw=01 11 00 01 00 00 00 06 00 00 00 00 00 00 00 00
msgctxt "2112_Delivery Boy"
msgid "Refuse"
msgstr "Negarse"

#. y4:line_status=translated
#. y4:msg_type=choice
