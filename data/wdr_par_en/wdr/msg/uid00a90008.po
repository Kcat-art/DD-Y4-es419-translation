msgid "Haruka"
msgstr "Haruka"

#. y4:msg_type=id
#. y4:msg_label=Nombre interno
#. y4:msg_id_index=1
msgctxt "1252"
msgid "Kiryu"
msgstr "Kiryu"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
