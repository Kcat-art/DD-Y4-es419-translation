#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Short Man
#. y4:msg_speaker_id=0
msgctxt "148_Short Man"
msgid "Man, this guy is strong!"
msgstr "¡Amigo, este tipo es muy fuerte!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Tall Man
#. y4:msg_speaker_id=1
msgctxt "160_Tall Man"
msgid "Yeah, this cop's no joke. He's the real deal."
msgstr "Sí, este policía es auténtico. Va totalmente en serio."

#. y4:line_status=translated
msgctxt "172_Tanimura"
msgid "Come on, guys. You know us cops don't have a lot of time\\r\non our hands."
msgstr "Vamos, chicos. Ya saben que nosotros los policías no tenemos\\r\nmucho tiempo de sobra."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "184_Tanimura"
msgid "Please don't make more work for us."
msgstr "Por favor, no nos compliquen más el trabajo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Short Man
#. y4:msg_speaker_id=0
msgctxt "196_Short Man"
msgid "Yeah, but officer, you'd be out of a job without criminals like us!"
msgstr "Sí, pero oficial... ¡Se quedarían sin trabajo, sin criminales\\r\ncomo nosotros!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Short Man
#. y4:msg_speaker_id=0
msgctxt "208_Short Man"
msgid "You wouldn't want that to happen, right?"
msgstr "No querrías que eso pase, ¿verdad?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Tall Man
#. y4:msg_speaker_id=1
msgctxt "220_Tall Man"
msgid "Yo, wait a minute! If everybody became a good citizen, just think what a great place Kamurocho would be for everybody!"
msgstr "¡Oye, espera un segundo! ¡Si todo el mundo fuera un ciudadano\\r\nde bien, imagina como de bueno podría ser\\r\nKamurocho para todo el mundo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Short Man
#. y4:msg_speaker_id=0
msgctxt "232_Short Man"
msgid "Hey, you got a point..."
msgstr "Hm, bueno en eso tienes razón..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Tall Man
#. y4:msg_speaker_id=1
msgctxt "244_Tall Man"
msgid "Yeah! We should start a movement!"
msgstr "¡Sí! ¡Deberíamos empezar un movimiento!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Tall Man
#. y4:msg_speaker_id=1
msgctxt "256_Tall Man"
msgid "We won't do anything bad anymore! And that'll set off a chain reaction. Soon, all of Kamurocho will change!"
msgstr "¡Nunca más haremos una maldad! Esto provocará una reacción\\r\nen cadena. ¡Pronto, Kamurocho cambiará para mejor!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Short Man
#. y4:msg_speaker_id=0
msgctxt "268_Short Man"
msgid "Dude, that's a great idea!"
msgstr "¡Amigo, qué buena idea!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Short Man
#. y4:msg_speaker_id=0
msgctxt "280_Short Man"
msgid "I'm glad I chose to team up with you! I made the right choice, for sure!"
msgstr "¡Me alegro de haber formado equipo contigo!\\r\n¡Tome la decisión correcta, sin dudas!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Tall Man
#. y4:msg_speaker_id=1
msgctxt "292_Tall Man"
msgid "Thank you! I mean it, man! Let's start right away!"
msgstr "¡Gracias! De verdad, amigo. ¡Empecemos ahora mismo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "304_Tanimura"
msgid "We're still going to the station. You know that, right?"
msgstr "De todas maneras todavía los llevaré a la comisaría.\\r\n¿Lo saben, cierto?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Short Man
#. y4:msg_speaker_id=0
msgctxt "316_Short Man"
msgid "Right. Sorry."
msgstr "Sí, lo siento."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "388_Tanimura"
msgid "Man... What a royal pain in the..."
msgstr "Ah... Qué gran dolor de..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Businessman
#. y4:msg_speaker_id=10
msgctxt "400_Businessman"
msgid "Excuse me."
msgstr "Disculpe."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "412_Tanimura"
msgid "Yes?"
msgstr "¿Sí?"

#. y4:line_status=translated
msgctxt "424_Businessman"
msgid "This car... It's mine. Is there something I can\\r\nhelp you with?"
msgstr "Este coche... Es mío. ¿Hay algo en lo que\\r\npueda ayudarte?"

#. y4:line_status=translated
msgctxt "436_Tanimura"
msgid "Oh, this is yours? I apologize. I'm from the KPD.\\r\nI just caught a couple of men trying to break into\\r\nyour car."
msgstr "¿Ah, es tuyo? Disculpa. Soy del DPK.\\r\nAcabo de capturar a dos sujetos intentando entrar\\r\nen el coche."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Businessman
#. y4:msg_speaker_id=10
msgctxt "448_Businessman"
msgid "They were what!? Is my car all right!?"
msgstr "¡¿Intentando qué?! ¡¿Mi coche está bien?!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Businessman
#. y4:msg_speaker_id=10
msgctxt "460_Businessman"
msgid "Oh my god! What did they do to it!?"
msgstr "¡Ay dios mío! ¡¿Qué le hicieron?!"

#. y4:line_status=translated
msgctxt "472_Tanimura"
msgid "Well, there was a bit of a scuffle when I tried\\r\nto apprehend them..."
msgstr "Bueno, hubo cierta resistencia cuando\\r\nintente capturarlos..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Businessman
#. y4:msg_speaker_id=10
msgctxt "484_Businessman"
msgid "A scuffle? Who's going to pay for this!?"
msgstr "¿Resistencia? ¡¿Quién pagará por esto?!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=117
#. y4:msg_location=T2.P117
#. y4:msg_speaker=Tall Man
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe it needs a new battery.
msgctxt "496_Tanimura"
msgid "Uh..."
msgstr "Eh..."

#. y4:line_status=translated
msgctxt "508_Tanimura"
msgid "I'll have somebody from the station explain.\\r\nWould you mind giving them a call?"
msgstr "Alguien de la comisaria puede explicárselo.\\r\n¿Te importaría llamarlos?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=31
#. y4:msg_location=T0.P31
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "520_Tanimura"
msgid "Take care, sir!"
msgstr "¡Cuídese, señor!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=32
#. y4:msg_location=T0.P32
#. y4:msg_speaker=Businessman
#. y4:msg_speaker_id=10
msgctxt "532_Businessman"
msgid "Hey, wait a second!"
msgstr "¡Oye, espera!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=37
#. y4:msg_location=T0.P37
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "592_Tanimura"
msgid "(Whew... Guess I got out of that one.)"
msgstr "(Uuf... Me libré de esta)."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=38
#. y4:msg_location=T0.P38
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "604_Tanimura"
msgid "(I feel sorry for whoever has to deal with that at HQ!)"
msgstr "(¡Siento mucho por quien sea que tenga que lidiar\\r\ncon esto, en el cuartel!)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=39
#. y4:msg_location=T0.P39
#. y4:msg_speaker=Businessman
#. y4:msg_speaker_id=10
msgctxt "616_Businessman"
msgid "Oh, it looks unscathed... What a relief!"
msgstr "Ah, no tiene ningún rasguño... ¡Qué alivio!"

#. y4:line_status=translated
msgctxt "628_Tanimura"
msgid "There've been a lot of these break-ins lately.\\r\nTake care, okay?"
msgstr "Últimamente, ha habido muchos robos como este.\\r\nCuídese, ¿de acuerdo?"

#. y4:line_status=translated
msgctxt "640_Businessman"
msgid "Oh, thank you, officer! Please take this. It's not much,\\r\nbut I want to reward you for your effort!"
msgstr "¡Ah, gracias, oficial! Por favor, toma esto. ¡No es mucho,\\r\npero quiero recompensarte por tu esfuerzo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=44
#. y4:msg_location=T0.P44
#. y4:msg_speaker=Businessman
#. y4:msg_speaker_id=10
msgctxt "676_Businessman"
msgid "Thank you again!"
msgstr "¡Gracias de nuevo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Short Man
#. y4:msg_speaker_id=0
msgctxt "772_Short Man"
msgid "Shit! Somebody's coming!"
msgstr "¡Mierda! ¡Alguien viene!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Tall Man
#. y4:msg_speaker_id=1
msgctxt "784_Tall Man"
msgid "There is!? Dammit!"
msgstr "¡¿Eh?! ¡Maldición!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Short Man
#. y4:msg_speaker_id=0
msgctxt "796_Short Man"
msgid "Let's beat it!"
msgstr "¡Démosle una paliza!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "808_Tanimura"
msgid "(Damn. Those guys are fast.)"
msgstr "(Maldición. Estos tipos son rápidos)."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "820_Tanimura"
