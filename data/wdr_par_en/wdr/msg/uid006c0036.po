#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Romance movies.
msgctxt "10968_Kiryu"
msgid "Don't be so surprised. Everybody watches them, even me."
msgstr "No te sorprendas tanto. Todo el mundo las mira, incluso yo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
