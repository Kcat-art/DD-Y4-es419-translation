msgctxt "56_Tachikawa"
msgid "I gather you're looking for the underworld's top informant?"
msgstr "¿Supongo que estás buscando al mejor informante del inframundo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=1
msgctxt "68_Saejima"
msgid "Sure am."
msgstr "Sí."

#. y4:line_status=translated
msgctxt "80_Tachikawa"
msgid "Well, there are plenty of rumors circulating about him,\\r\nyet the man himself is hard to pin down."
msgstr "Bueno, hay muchos rumores circulando sobre él,\\r\nsin embargo el hombre es difícil de ubicar."

#. y4:line_status=translated
msgctxt "92_Tachikawa"
msgid "But he does have a number of homeless folks on his payroll.\\r\nThey collect intel and such."
msgstr "Pero sí tiene varios vagabundos en su nómina.\\r\nRecopilan información y tal."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Tachikawa
#. y4:msg_speaker_id=0
msgctxt "104_Tachikawa"
msgid "I've never met the guy, but I'd sure like to sometime."
msgstr "Nunca lo he conocido, pero me gustaría hacerlo alguna vez."
