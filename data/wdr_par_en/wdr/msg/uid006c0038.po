#. y4:msg_branch_choice=If I can make it.
msgctxt "12048_望月京子：源氏名"
msgid "Oh... Right. Sure, if you're free..."
msgstr "Oh... Cierto. Claro, si estás libre..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=19
