#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
#. y4:msg_phrase=22
#. y4:msg_location=T12.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It must've been a pretty boring movie.
msgctxt "9144_Akiyama"
msgid "Exactly. I think the problem was the movie you were watching."
msgstr "Exactamente. Creo que el problema era la película que estabas viendo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
