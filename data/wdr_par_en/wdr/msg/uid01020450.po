#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "116_Majima"
msgid "Mind tellin' me why ya dragged me all the way out here?"
msgstr ""

msgctxt "128_Shibata"
msgid "Heh. Your Kansai accent's gotten\\r\n"
"much better since I last saw you."
msgstr ""

msgctxt "140_Shibata"
msgid "I hear you've been hard at work. Now I see\\r\n"
"why Shimano-san's taken an interest in you."
msgstr ""

msgctxt "152_Majima"
msgid "So ya gonna tell me what this is\\r\n"
"about or not, Shibata-han?"
msgstr ""

msgctxt "176_Shibata"
msgid "You're all dressed up today.\\r\n"
"Going to a funeral?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "188_Majima"
msgid "Nah... Nothin' like that."
msgstr ""

msgctxt "200_Shibata"
msgid "Come to think of it, Sasai's boy Saejima\\r\n"
"was in his finest this morning, too."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "212_Majima"
msgid "And? What if he was?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "236_Shibata"
msgid "I'll skip right to the point."
msgstr ""

msgctxt "248_Shibata"
msgid "The Yoshiharu Ueno hit's going down today...\\r\n"
"but you're not going to be there, Majima."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "260_Majima"
msgid "Huh!? How did ya..."
msgstr ""

msgctxt "308_Shibata"
msgid "You and Saejima plan to ambush Ueno today,\\r\n"
"at a ramen joint en route home from prison."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "320_Shibata"
msgid "Is that correct?"
msgstr ""

msgctxt "344_Shibata"
msgid "Well, there's been a slight change of plans.\\r\n"
"You know how it is."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "356_Majima"
msgid "The hell are you talking about?"
msgstr ""

msgctxt "380_Shibata"
msgid "Patriarch Dojima doesn't think it's in our best interest\\r\n"
"to stamp out the Ueno Seiwa Clan just yet."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "404_Majima"
msgid "What? Why?"
msgstr "¿Qué? ¿Por qué?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "416_Shibata"
msgid "No need to get excited."
msgstr ""

msgctxt "428_Shibata"
msgid "The Dojima Family is simply\\r\n"
"asking you to follow orders."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=32
#. y4:msg_location=T0.P32
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "440_Majima"
msgid "C'mon, Shibata-han, gimme a reason here."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "452_Shibata"
msgid "The hit on Yoshiharu Ueno was a Dojima Family idea originally."
msgstr ""

msgctxt "464_Shibata"
msgid "It began as a bid to expand\\r\n"
"their turf here in the city."
msgstr ""

msgctxt "476_Shibata"
msgid "They left its execution to the Sasai Family.\\r\n"
"This much you already know, yes?"
msgstr ""

msgctxt "488_Majima"
msgid "Yeah. That's why it's me from the Dojima Family\\r\n"
"and Saejima on loan from Patriarch Sasai's place."
msgstr ""

msgctxt "500_Shibata"
msgid "That's right. But doesn't this whole scenario\\r\n"
"seem more than a little strange to you?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=38
#. y4:msg_location=T0.P38
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "512_Majima"
msgid "Whaddya mean?"
msgstr "¿A qué te refieres?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=39
#. y4:msg_location=T0.P39
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "524_Shibata"
msgid "How'd the Tojo find out?"
msgstr ""

msgctxt "536_Shibata"
msgid "How did we learn Ueno would be heading straight\\r\n"
"for a ramen shop immediately after his release?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=41
#. y4:msg_location=T0.P41
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "548_Shibata"
msgid "And let me ask you this."
msgstr ""

msgctxt "560_Shibata"
msgid "After being locked away for two years,\\r\n"
"would a chairman's first meal be noodles?"
msgstr ""

msgctxt "572_Shibata"
msgid "The Ueno Seiwa Clan ought to be throwing\\r\n"
"a lavish celebration in honor of his release."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=44
#. y4:msg_location=T0.P44
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "584_Majima"
msgid "Yeah, but..."
msgstr "Sí, pero..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=45
#. y4:msg_location=T0.P45
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "596_Shibata"
msgid "The whole thing stinks."
msgstr ""

msgctxt "608_Shibata"
msgid "It's likely the entire thing was planned\\r\n"
"by a traitor in Chairman Ueno's ranks."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=47
#. y4:msg_location=T0.P47
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "620_Majima"
msgid "A traitor?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=48
#. y4:msg_location=T0.P48
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "632_Shibata"
msgid "It's a tiny, cramped noodle shop at the edge of town."
msgstr ""

msgctxt "644_Shibata"
msgid "Would a top yakuza head straight from prison\\r\n"
"to a spot that practically begs for an ambush?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=50
#. y4:msg_location=T0.P50
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "656_Majima"
msgid "So why is he, then?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=51
#. y4:msg_location=T0.P51
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "668_Shibata"
msgid "I suspect this scenario was authored by two traitors."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=52
#. y4:msg_location=T0.P52
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "680_Shibata"
msgid "One from the Ueno Seiwa Clan, another from the Tojo."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=53
#. y4:msg_location=T0.P53
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "692_Majima"
msgid "Two of 'em?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=54
#. y4:msg_location=T0.P54
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "704_Shibata"
msgid "Yes. A mole on the inside to leak Ueno's plans..."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=55
#. y4:msg_location=T0.P55
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "716_Shibata"
msgid "And another to pass that news along to us."
msgstr ""

msgctxt "728_Shibata"
msgid "In other words, one traitor in the Ueno Seiwa Clan,\\r\n"
"and one traitor from within the Tojo Clan."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=57
#. y4:msg_location=T0.P57
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "740_Majima"
msgid "We know who they are?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=58
#. y4:msg_location=T0.P58
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "752_Shibata"
msgid "The Tojo Clan traitor, yes... Hideki Sasai."
msgstr ""

msgctxt "764_Shibata"
msgid "He's the one who procured the tip, and his man\\r\n"
"Taiga Saejima is on his way to perform the hit."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=60
#. y4:msg_location=T0.P60
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "776_Shibata"
msgid "The Sasai Family's patriarch received the info, so..."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=61
#. y4:msg_location=T0.P61
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "788_Majima"
msgid "Saejima's boss? Sasai-san?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=62
#. y4:msg_location=T0.P62
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "800_Shibata"
msgid "Sasai has ties to the Ueno Seiwa Clan."
msgstr ""

msgctxt "812_Shibata"
msgid "He told the Tojo Clan where Ueno would be\\r\n"
"and urged the brass to authorize a hit."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=64
#. y4:msg_location=T0.P64
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "824_Majima"
msgid "But why?"
msgstr "Pero, ¿por qué?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=65
#. y4:msg_location=T0.P65
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "836_Shibata"
msgid "To start a war."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=66
#. y4:msg_location=T0.P66
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "848_Majima"
msgid "What?"
msgstr "¿Qué?"

msgctxt "860_Shibata"
msgid "Sasai's creating a reason for the Tojo\\r\n"
"to strike the Ueno Seiwa Clan hard."
msgstr ""

msgctxt "872_Shibata"
msgid "And what better way is there than to anger\\r\n"
"the Ueno Seiwa Clan enough to declare war?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=69
#. y4:msg_location=T0.P69
#. y4:msg_speaker=Majima
#. y4:msg_speaker_id=3
msgctxt "884_Majima"
msgid "What's he stand to gain outta all this?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=70
#. y4:msg_location=T0.P70
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "896_Shibata"
msgid "Good question."
msgstr "Por qué será."

msgctxt "908_Shibata"
msgid "All I know is Ueno's death would give his clan\\r\n"
"ample enough reason to declare war on us."
msgstr ""

msgctxt "920_Shibata"
msgid "After all, it will have been the Tojo Clan\\r\n"
"that struck the first blow."
msgstr ""

msgctxt "932_Shibata"
msgid "No doubt Sasai will work with the Ueno\\r\n"
"Seiwa traitor to contain the situation."
msgstr ""

msgctxt "944_Shibata"
msgid "By playing peacemaker, he'll be on his way\\r\n"
"to becoming a top figure in the Tojo Clan."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=75
#. y4:msg_location=T0.P75
#. y4:msg_speaker=Shibata
#. y4:msg_speaker_id=6
msgctxt "956_Shibata"
msgid "Make sense?"
msgstr ""

msgctxt "980_Shibata"
msgid "So you see, Majima, we can't have a Dojima Family\\r\n"
"member like you getting mixed up in all of this."
msgstr ""

msgctxt "992_Shibata"
msgid "Join in on this hit and you'll cause problems\\r\n"
"for Patriarch Dojima, and for Shimano-san."
msgstr ""
