#. y4:msg_branch_choice=Do you fall asleep while doing your makeup?
msgctxt "11424_Maya"
msgid "Yeah, I've done that before. And some models even fall asleep while changing clothes."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=15
#. y4:msg_location=T21.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Do you fall asleep while doing your makeup?
msgctxt "11436_Kiryu"
msgid "I thought models had to change clothes in a hurry so they could wear as many outfits as possible."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=16
#. y4:msg_location=T21.P16
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Do you fall asleep while doing your makeup?
msgctxt "11448_Maya"
msgid "That's just during fashion shows. It's more relaxed during shoots."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=17
#. y4:msg_location=T21.P17
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Do you fall asleep while doing your makeup?
msgctxt "11460_Kiryu"
msgid "Heh. Sounds like fun."
msgstr "Je. Suena divertido."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=18
#. y4:msg_location=T21.P18
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Do you fall asleep while doing your makeup?
msgctxt "11472_Maya"
msgid "It is. I hope I can be a model forever."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=19
#. y4:msg_location=T21.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm a little disappointed.
msgctxt "11484_Kiryu"
msgid "I'm a little disappointed. Modeling seems so glamorous, but in reality you get bags under your eyes."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=20
#. y4:msg_location=T21.P20
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm a little disappointed.
msgctxt "11496_Maya"
msgid "Haha! That's okay. The makeup covers it up."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=21
#. y4:msg_location=T21.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm a little disappointed.
msgctxt "11508_Kiryu"
msgid "But you're not exactly relaxing and chatting in your dressing room."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=22
#. y4:msg_location=T21.P22
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm a little disappointed.
msgctxt "11520_Maya"
msgid "Nope. You have to rest when you get the chance."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=23
#. y4:msg_location=T21.P23
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm a little disappointed.
msgctxt "11532_Maya"
msgid "We try not to use any more energy than we have to."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=24
#. y4:msg_location=T21.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm a little disappointed.
msgctxt "11544_Kiryu"
msgid "Ah, I see."
msgstr "Oh, ya veo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=0
#. y4:msg_location=T22.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "11556_Maya"
msgid "That policeman from before keeps emailing me. It's getting annoying."
msgstr "Ese policía de antes sigue enviándome correos. Me está volviendo loca."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=1
#. y4:msg_location=T22.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "11568_Kiryu"
msgid "You gave him your email address?"
msgstr "¿Le diste tu correo electrónico?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=2
#. y4:msg_location=T22.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "11580_Maya"
msgid "Yeah. I thought knowing a policeman might come in handy."
msgstr "Sí. Pensé que conocer a un policía sería útil."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=3
#. y4:msg_location=T22.P3
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=22
#. y4:msg_decision_choices=1. Let me know if it gets to be a problem. -> T22.P4 | 2. Why don't you just screen his calls? -> T22.P10 | 3. You shouldn't give your email to just anybody. -> T22.P16
msgctxt "11592_Maya"
msgid "Now I'm regretting it."
msgstr "Y ahora me arrepiento..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=4
#. y4:msg_location=T22.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Let me know if it gets to be a problem.
msgctxt "11604_Kiryu"
msgid "Let me know if it gets to be a problem. I've got a few connections in the Kamurocho Police."
msgstr "Avísame si llega a ser un problema. Tengo algunos contactos en la policía de Kamurocho."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=5
#. y4:msg_location=T22.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Let me know if it gets to be a problem.
msgctxt "11616_Maya"
msgid "You do? That might help."
msgstr "¿Lo harías? Eso podría ayudar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=6
#. y4:msg_location=T22.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Let me know if it gets to be a problem.
msgctxt "11628_Kiryu"
msgid "But reporting a cop for stalking is a big deal, so..."
msgstr "Pero denunciar a un policía por acoso es un gran problema, así que..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=7
#. y4:msg_location=T22.P7
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Let me know if it gets to be a problem.
msgctxt "11640_Maya"
msgid "Haha, yeah. You're right. I'd like to see what would happen, though."
msgstr "Ja, ja. Tienes razón, pero me gustaría ver qué pasaría."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=8
#. y4:msg_location=T22.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Let me know if it gets to be a problem.
msgctxt "11652_Kiryu"
msgid "Let's just wait a bit longer and see if he gives up. If he doesn't stop after you ask him to, let me know."
msgstr "Esperemos un poco más a ver si se rinde. Si no para después de que se lo pidas, házmelo saber."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=9
#. y4:msg_location=T22.P9
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Let me know if it gets to be a problem.
msgctxt "11664_Maya"
msgid "Yeah. Hopefully it won't come to that."
msgstr "Sí. Esperemos que no llegue a eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=10
#. y4:msg_location=T22.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you just screen his calls?
msgctxt "11676_Kiryu"
msgid "Why don't you just ignore his emails? That should take care of it."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=11
#. y4:msg_location=T22.P11
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you just screen his calls?
msgctxt "11688_Maya"
msgid "I'm a little scared to do that."
msgstr "Me da un poco de miedo hacerlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=20
#. y4:msg_location=T13.P20
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You can't quit.
msgctxt "11700_Kiryu"
msgid "Why?"
msgstr "¿Tú?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=13
#. y4:msg_location=T22.P13
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you just screen his calls?
msgctxt "11712_Maya"
msgid "He might make a big deal about me not responding to his messages."
msgstr "Puede que monte un escándalo porque no respondo a sus mensajes."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=14
#. y4:msg_location=T22.P14
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you just screen his calls?
msgctxt "11724_Maya"
msgid "Instead of making him angry, I'd rather string him along with some boring messages until he gives up on his own."
msgstr "En lugar de enfadarle, prefiero darle largas con mensajes aburridos hasta que se rinda."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=15
#. y4:msg_location=T22.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't you just screen his calls?
msgctxt "11736_Kiryu"
msgid "Okay. Well, this cop is still being a nuisance."
msgstr "De acuerdo. Bueno, este policía sigue siendo una molestia."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=16
#. y4:msg_location=T22.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't give your email to just anybody.
msgctxt "11748_Kiryu"
msgid "You shouldn't give your email to just anybody. Didn't you think this kind of thing might happen?"
msgstr "No deberías dar tu email a nadie. ¿No pensaste que este tipo de cosas podrían pasar?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=17
#. y4:msg_location=T22.P17
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't give your email to just anybody.
msgctxt "11760_Maya"
msgid "I know it was a mistake. I just didn't think it was a big deal."
msgstr "Sé que fue un error. Simplemente, no pensé que fuera para tanto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=18
#. y4:msg_location=T22.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't give your email to just anybody.
msgctxt "11772_Kiryu"
msgid "You've got to be more careful. There are some bad people out there, you know."
msgstr "Tienes que tener más cuidado. Hay gente mala por ahí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=19
#. y4:msg_location=T22.P19
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't give your email to just anybody.
msgctxt "11784_Maya"
msgid "You don't have to rub it in. I figured he'd be safe, since he's a cop."
msgstr "No tienes que recordármelo. Pensé que estaría a salvo, ya que es policía."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=20
#. y4:msg_location=T22.P20
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't give your email to just anybody.
msgctxt "11796_Maya"
msgid "I was hoping that you could give me a little advice, but I guess you're more interested in scolding me."
msgstr "Esperaba que pudieras aconsejarme, pero supongo que estás más interesado en regañarme."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=29
#. y4:msg_location=T1.P29
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a tricky issue.
msgctxt "11808_Kiryu"
msgid "......"
msgstr "......"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=0
#. y4:msg_location=T23.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "11820_Maya"
msgid "Do you think I should email him back? It can't be a good idea to ignore him, can it?"
msgstr "¿Crees que deba enviarle un email? No me parece correcto ignorarlo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=1
#. y4:msg_location=T23.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "11832_Kiryu"
msgid "You're talking about that cop? What would you write?"
msgstr "¿Te refieres a ese policía? ¿Qué escribirías?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=2
#. y4:msg_location=T23.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "11844_Maya"
msgid "I don't know. Do you have any ideas?"
msgstr "No lo sé... ¿Tienes alguna idea?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=3
#. y4:msg_location=T23.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=23
#. y4:msg_decision_choices=1. You could ask him to come to the club. -> T23.P4 | 2. You could say you've already got a boyfriend. -> T23.P11 | 3. You could ask him how much money he has. -> T23.P18
msgctxt "11856_Kiryu"
msgid "Hmm. Well..."
msgstr "Mmm. Bueno..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=4
#. y4:msg_location=T23.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You could ask him to come to the club.
msgctxt "11868_Kiryu"
msgid "You could ask him to come to the club. You know, turn it into an advertisement."
msgstr "Puedes preguntarle si quiere que venga al club. Ya sabes, convertirlo en un anuncio."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=5
#. y4:msg_location=T23.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You could ask him to come to the club.
msgctxt "11880_Maya"
msgid "What!? I don't want him showing up here!"
msgstr "¿¡Qué!? ¡No quiero que aparezca por aquí!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=6
#. y4:msg_location=T23.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You could ask him to come to the club.
msgctxt "11892_Kiryu"
msgid "But if you can't avoid him, at least this way you'll be getting paid for it."
msgstr "Pero si no puedes evitarlo, al menos te pagarán por invitarlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=7
#. y4:msg_location=T23.P7
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You could ask him to come to the club.
msgctxt "11904_Maya"
msgid "Well, yeah. But I don't want to see him at all."
msgstr "Bueno, sí. Pero no quiero verlo para nada."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=8
#. y4:msg_location=T23.P8
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You could ask him to come to the club.
msgctxt "11916_Maya"
msgid "If he did become one of my customers, I couldn't avoid him."
msgstr "Si se convirtiera en uno de mis clientes, no podría evitarlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=9
#. y4:msg_location=T23.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You could ask him to come to the club.
msgctxt "11928_Kiryu"
msgid "Right. I guess that wasn't a very good idea."
msgstr "Cierto. Supongo que no fue una buena idea."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=10
#. y4:msg_location=T23.P10
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You could ask him to come to the club.
msgctxt "11940_Maya"
msgid "This is giving me such a headache."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=11
#. y4:msg_location=T23.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could say you've already got a boyfriend.
msgctxt "11952_Kiryu"
msgid "You could say you've already got a boyfriend. That should make him give up."
msgstr "Podrías decir que ya tienes novio. Eso debería bastar para que se rinda."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=12
#. y4:msg_location=T23.P12
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could say you've already got a boyfriend.
msgctxt "11964_Maya"
msgid "I don't think so. He tries to pick up girls who are waiting for their dates. He wouldn't care."
msgstr "No lo creo. Intenta coquetear con chicas que están esperando a sus citas. No le importaría."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=13
#. y4:msg_location=T23.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could say you've already got a boyfriend.
msgctxt "11976_Kiryu"
msgid "But if you at least say it, it wouldn't seem odd when you stop replying to his emails."
msgstr "Pero si lo dices, ya entenderá cuando dejes de responder a sus correos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=14
#. y4:msg_location=T23.P14
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could say you've already got a boyfriend.
msgctxt "11988_Maya"
msgid "Oh, I hadn't thought of that."
msgstr "No lo había pensado..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=15
#. y4:msg_location=T23.P15
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could say you've already got a boyfriend.
msgctxt "12000_Maya"
msgid "Okay, I'll try it. And you can be my boyfriend."
msgstr "Ok, lo intentaré. Y tú podrías ser mi novio."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=16
#. y4:msg_location=T23.P16
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could say you've already got a boyfriend.
msgctxt "12012_Maya"
msgid "That way, if he sees us together, I won't have to make up some excuse."
msgstr "Así, si nos ve juntos, no tendré que inventarme una excusa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=20
#. y4:msg_location=T1.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=There's nothing wrong with being devoted.
msgctxt "12024_Kiryu"
msgid "Heh. Good."
msgstr "Je. Está bien."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=18
#. y4:msg_location=T23.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could ask him how much money he has.
msgctxt "12036_Kiryu"
msgid "You could ask him how much money he has. He might lose interest if he thinks that's all you care about."
msgstr "Podrías preguntarle cuánto dinero tiene. Podría perder interés si piensa que eso es lo único que te importa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=19
#. y4:msg_location=T23.P19
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could ask him how much money he has.
msgctxt "12048_Maya"
msgid "Hahaha! That could work!"
msgstr "Ja, ja, ja ¡Podría funcionar!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=20
#. y4:msg_location=T23.P20
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could ask him how much money he has.
msgctxt "12060_Maya"
msgid "But what if I ask him and he turns out to be super rich?"
msgstr "Pero, ¿y si se lo pido y resulta que es millonario?"

msgctxt "12072_Kiryu"
msgid "Come on. When's the last time you met a rich cop?\\r\n"
"Especially one walking a beat."
msgstr "Vamos, ya. ¿Cuándo fue la última vez que conociste a un policía rico?\\r\n"
"Especialmente uno que camina a ritmo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=22
#. y4:msg_location=T23.P22
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could ask him how much money he has.
msgctxt "12084_Maya"
msgid "You never know. Maybe his family's rich and he's doing police work for fun."
msgstr "Nunca se sabe. Tal vez su familia es rica y hace trabajo policial por diversión."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=23
#. y4:msg_location=T23.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could ask him how much money he has.
msgctxt "12096_Kiryu"
msgid "Well, it's possible."
msgstr "Bueno, es una posibilidad."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=24
#. y4:msg_location=T23.P24
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could ask him how much money he has.
msgctxt "12108_Maya"
msgid "Hmm. I think I need another idea."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=0
#. y4:msg_location=T24.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "12120_Maya"
msgid "I'm really thinking about quitting my job here."
msgstr "Realmente estoy pensando en renunciar aquí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=1
#. y4:msg_location=T24.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "12132_Kiryu"
msgid "You are?"
msgstr "¿¡En serio!?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=12
#. y4:msg_location=T24.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=But you see me when I come to the club.
msgctxt "12144_Maya"
msgid "Yes."
msgstr "Sí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=3
#. y4:msg_location=T24.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "12156_Kiryu"
msgid "Okay... Do you mind telling me why?"
msgstr "Ok... ¿Y me puedes decir por qué?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=4
#. y4:msg_location=T24.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "12168_Maya"
msgid "It was great when I started, since my boyfriend was working a night job, but now working here is getting in the way."
msgstr "Fue genial cuando empecé, ya que mi novio tenía un trabajo nocturno, pero ahora trabajar aquí me distrae."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=5
#. y4:msg_location=T24.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "12180_Kiryu"
msgid "In the way? Of what?"
msgstr "¿Te distrae? ¿De qué?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=6
#. y4:msg_location=T24.P6
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=24
#. y4:msg_decision_choices=1. But you see me when I come to the club. -> T24.P7 | 2. You'd quit your job for me? -> T24.P16 | 3. I actually live in Okinawa. -> T24.P25
msgctxt "12192_Maya"
msgid "Of... Of seeing you."
msgstr "De... De verte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=7
#. y4:msg_location=T24.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=But you see me when I come to the club.
msgctxt "12204_Kiryu"
msgid "But you see me when I come to the club. Isn't that enough?"
msgstr "Pero, siempre me ves cuando vengo al club. ¿Eso no es suficiente?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=8
#. y4:msg_location=T24.P8
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=But you see me when I come to the club.
msgctxt "12216_Maya"
msgid "But then you're just one of my customers. I want our relationship to be more than that."
msgstr "Pero solo eres uno de mis clientes. Quiero que nuestra relación sea más que eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=9
#. y4:msg_location=T24.P9
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=But you see me when I come to the club.
msgctxt "12228_Maya"
msgid "Unless you don't want it to be. Maybe I'm just a hostess to you."
msgstr "A menos que no quieras que lo sea. Tal vez solo soy una Hostess para ti."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=10
#. y4:msg_location=T24.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=But you see me when I come to the club.
msgctxt "12240_Kiryu"
msgid "That's not true. I don't want our relationship to end at the club."
msgstr "Eso no es cierto. No quiero que nuestra relación termine en el club."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=11
#. y4:msg_location=T24.P11
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=But you see me when I come to the club.
msgctxt "12252_Maya"
msgid "Really!?"
msgstr "¡¿En serio?!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=12
#. y4:msg_location=T24.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=But you see me when I come to the club.
msgctxt "12264_Kiryu"
msgid "Yes."
msgstr "Sí."

msgctxt "12276_Maya"
msgid "Yay! I'm so happy! ♪"
msgstr "¡Sí! ¡Estoy muy feliz! ♪"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=14
#. y4:msg_location=T24.P14
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=But you see me when I come to the club.
msgctxt "12288_Maya"
msgid "But remember, I'll kill you if you request other hostesses after I quit."
msgstr "Pero recuerda, te mataré si solicitas otras Hostess después de que renuncie."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=15
#. y4:msg_location=T24.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=But you see me when I come to the club.
msgctxt "12300_Kiryu"
msgid "You don't have to worry about that. I think..."
msgstr "No tienes que preocuparte por eso. Creo..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=194
#. y4:msg_phrase=0
#. y4:msg_location=T194.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T24.P16
#. y4:msg_branch_segment=T24.P16..P24
#. y4:msg_branch_target_text=You'd quit your job for me?
#. y4:msg_branch_raw=01 11 00 10 00 00 00 1b 00 00 00 00 00 00 00 00
msgctxt "12312_Kiryu"
msgid "You'd quit your job for me?"
msgstr "¿Renunciarías por mí?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=17
#. y4:msg_location=T24.P17
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You'd quit your job for me?
msgctxt "12324_Maya"
msgid "Hehe. It's more for me than for you. I'm quitting because I want to see more of you."
msgstr "Je, je. Es más por mí que por ti. Lo dejo porque quiero ver más de ti."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=18
#. y4:msg_location=T24.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You'd quit your job for me?
msgctxt "12336_Kiryu"
msgid "I spend a lot of time out at night, you know."
msgstr "Paso mucho tiempo fuera por la noche."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=19
#. y4:msg_location=T24.P19
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You'd quit your job for me?
msgctxt "12348_Maya"
msgid "Huh? You do?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=20
#. y4:msg_location=T24.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You'd quit your job for me?
msgctxt "12360_Kiryu"
msgid "Yeah. Actually, I'm out almost all the time. I'm pretty busy. I don't have a lot of time to relax."
msgstr "Sí. En realidad, estoy fuera casi todo el tiempo. Estoy muy ocupado. No tengo mucho tiempo para relajarme."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=21
#. y4:msg_location=T24.P21
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You'd quit your job for me?
msgctxt "12372_Maya"
msgid "But you have enough time to come here."
msgstr "Pero tienes tiempo de sobra para venir aquí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=22
#. y4:msg_location=T24.P22
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You'd quit your job for me?
msgctxt "12384_Kiryu"
msgid "I make time to. It helps me get rid of stress. If I didn't come, I'd probably get sick."
msgstr "Saco tiempo para hacerlo. Me ayuda a liberarme del estrés. Si no viniera, probablemente me pondría mal."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=23
#. y4:msg_location=T24.P23
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You'd quit your job for me?
msgctxt "12396_Maya"
msgid "Hmm. It sounds like it would be better if I just stayed here."
msgstr "Mmm. Parece que sería mejor que me quedara aquí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=24
#. y4:msg_location=T24.P24
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You'd quit your job for me?
msgctxt "12408_Maya"
msgid "Aw. And I'd finally made up my mind, too."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=25
#. y4:msg_location=T24.P25
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I actually live in Okinawa.
msgctxt "12420_Kiryu"
msgid "I guess I hadn't mentioned this before, but I actually live in Okinawa."
msgstr "Cree que nunca te lo dije... Pero yo vivo en Okinawa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=26
#. y4:msg_location=T24.P26
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I actually live in Okinawa.
msgctxt "12432_Maya"
msgid "What!? You do!?"
msgstr "¿¡Qué!?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=27
#. y4:msg_location=T24.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I actually live in Okinawa.
msgctxt "12444_Kiryu"
msgid "Yeah. I've been taking care of some business here, but I'll go home when things are settled."
msgstr "Sí. He estado ocupándome de algunos asuntos aquí, pero volveré a casa cuando las cosas estén arregladas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=28
#. y4:msg_location=T24.P28
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I actually live in Okinawa.
msgctxt "12456_Maya"
msgid "Oh. I see."
msgstr "Oh, entiendo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=12
#. y4:msg_location=T21.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Aren't you working yourself a bit too hard?
msgctxt "12468_Kiryu"
msgid "I'm sorry."
msgstr "Lo siento."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=30
#. y4:msg_location=T24.P30
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I actually live in Okinawa.
msgctxt "12480_Maya"
msgid "No! I don't mind!"
msgstr "¡No, no! ¡Me parece excelente!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=31
#. y4:msg_location=T24.P31
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I actually live in Okinawa.
msgctxt "12492_Kiryu"
msgid "Huh?"
msgstr "Uh, ¿y eso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=32
#. y4:msg_location=T24.P32
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I actually live in Okinawa.
msgctxt "12504_Maya"
msgid "I'll go with you to Okinawa!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=33
#. y4:msg_location=T24.P33
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I actually live in Okinawa.
msgctxt "12516_Kiryu"
msgid "What!? You will?"
msgstr ""

msgctxt "12528_Maya"
msgid "Yes! A devoted woman like me won't let such a little thing get in the way. <Color:7>♥<Color:Default>"
msgstr "¡Sí! Una mujer devota como yo no dejará que algo tan insignificante se interponga en su camino. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=24
#. y4:msg_section_label=Conversación 24
#. y4:msg_talk=24
#. y4:msg_phrase=35
#. y4:msg_location=T24.P35
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I actually live in Okinawa.
msgctxt "12540_Kiryu"
msgid "Haha, I guess not."
msgstr "Ja, ja. Supongo que no."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=0
#. y4:msg_location=T25.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "12552_Maya"
msgid "Remember how I told you about my friend whose boyfriend cheated on her?"
msgstr "¿Recuerdas que te hablé de mi amiga cuyo novio la engañó?"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=33
#. y4:msg_section_label=Conversación 33
#. y4:msg_talk=226
#. y4:msg_phrase=0
#. y4:msg_location=T226.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T114.P2
#. y4:msg_branch_segment=T114.P2..P4
#. y4:msg_branch_target_text=Yay! All right then, I'll go ahead and order.
#. y4:msg_branch_raw=01 11 00 02 00 00 00 05 00 00 00 00 00 00 00 00
msgctxt "12564_Kiryu"
msgid "Sure."
msgstr "Claro."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=2
#. y4:msg_location=T25.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "12576_Maya"
msgid "Well, things kept on getting worse for her."
msgstr "Bueno, las cosas siguieron empeorando para ella."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=121
#. y4:msg_phrase=0
#. y4:msg_location=T121.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T0.P12
#. y4:msg_branch_segment=T0.P12..P19
#. y4:msg_branch_target_text=That's too bad. When do you plan on quitting?
#. y4:msg_branch_raw=01 11 00 0c 00 00 00 0f 00 00 00 00 00 00 00 00
msgctxt "12588_Kiryu"
msgid "That's too bad."
msgstr "Eso es... una pena."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=4
#. y4:msg_location=T25.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "12600_Maya"
msgid "I've been thinking of telling her to leave him. I'm not sure if it's my place to, though."
msgstr "He estado pensando en decirle que lo deje. Aunque no estoy segura de si me corresponde a mí hacerlo."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=5
#. y4:msg_location=T25.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=25
#. y4:msg_decision_choices=1. Sounds like a good idea to me. -> T25.P6 | 2. I don't think you should get involved. -> T25.P14 | 3. There are no right or wrong answers in love. -> T25.P23
msgctxt "12612_Maya"
msgid "I just want her to be happy."
msgstr "Solo quiero que sea feliz."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=6
#. y4:msg_location=T25.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sounds like a good idea to me.
msgctxt "12624_Kiryu"
msgid "Sounds like a good idea. I don't know her, but it isn't healthy to be in a relationship with a man who keeps on cheating."
msgstr "Parece una buena idea. No la conozco, pero no es sano estar en una relación con un hombre que la sigue engañando."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=7
#. y4:msg_location=T25.P7
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sounds like a good idea to me.
msgctxt "12636_Maya"
msgid "Right!"
msgstr "¡Tienes razón!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=8
#. y4:msg_location=T25.P8
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sounds like a good idea to me.
msgctxt "12648_Maya"
msgid "Still, she's pretty serious about him. You'd think she'd leave him, but..."
msgstr "Aun así, ella va muy en serio con él. Uno pensaría que ella lo dejaría, pero..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=9
#. y4:msg_location=T25.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sounds like a good idea to me.
msgctxt "12660_Kiryu"
msgid "Wait, she's not thinking about marrying him, is she?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=10
#. y4:msg_location=T25.P10
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sounds like a good idea to me.
msgctxt "12672_Maya"
msgid "Yes..."
msgstr "Sí..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=11
#. y4:msg_location=T25.P11
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sounds like a good idea to me.
msgctxt "12684_Maya"
msgid "That's why I don't know if this is something I should be getting involved with."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=12
#. y4:msg_location=T25.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sounds like a good idea to me.
msgctxt "12696_Kiryu"
msgid "But you could save her from a lifetime of unhappiness."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=13
#. y4:msg_location=T25.P13
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sounds like a good idea to me.
msgctxt "12708_Maya"
msgid "Yeah. Yeah, you're right! Thanks for listening!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=14
#. y4:msg_location=T25.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't think you should get involved.
msgctxt "12720_Kiryu"
msgid "I don't think you should get involved. You could end up making things worse."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=15
#. y4:msg_location=T25.P15
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't think you should get involved.
msgctxt "12732_Maya"
msgid "So I should just stay out of it?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=16
#. y4:msg_location=T25.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't think you should get involved.
msgctxt "12744_Kiryu"
msgid "No, not exactly. You should be there for her if she needs someone to talk to."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=17
#. y4:msg_location=T25.P17
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't think you should get involved.
msgctxt "12756_Kiryu"
msgid "But just listen. Don't bring your own opinion into it."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=18
#. y4:msg_location=T25.P18
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't think you should get involved.
msgctxt "12768_Maya"
msgid "But why can't I say anything?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=19
#. y4:msg_location=T25.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't think you should get involved.
msgctxt "12780_Kiryu"
msgid "Well, when people are depressed, an off-hand comment can hurt. You might do more harm than good."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=20
#. y4:msg_location=T25.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't think you should get involved.
msgctxt "12792_Kiryu"
msgid "It's better to let her heal over time."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=21
#. y4:msg_location=T25.P21
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't think you should get involved.
msgctxt "12804_Maya"
msgid "Okay."
msgstr "Está bien."

msgctxt "12816_Maya"
msgid "I guess being a friend means knowing when to give someone space. Thanks for the advice. <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=23
#. y4:msg_location=T25.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There are no right or wrong answers in love.
msgctxt "12828_Kiryu"
msgid "There are no right or wrong answers in love. Everybody's values are different."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=24
#. y4:msg_location=T25.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There are no right or wrong answers in love.
msgctxt "12840_Kiryu"
msgid "Even if you do what you think is right, there's no guarantee that it'll be right for her."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=25
#. y4:msg_location=T25.P25
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There are no right or wrong answers in love.
msgctxt "12852_Maya"
msgid "What? You mean you think they should stay together?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=26
#. y4:msg_location=T25.P26
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There are no right or wrong answers in love.
msgctxt "12864_Kiryu"
msgid "Not necessarily. But it's not our place to decide what's best for them."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=27
#. y4:msg_location=T25.P27
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There are no right or wrong answers in love.
msgctxt "12876_Maya"
msgid "Then I can't do anything for her..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=28
#. y4:msg_location=T25.P28
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There are no right or wrong answers in love.
msgctxt "12888_Kiryu"
msgid "It's better for her and for you if you don't get too involved."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=29
#. y4:msg_location=T25.P29
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There are no right or wrong answers in love.
msgctxt "12900_Kiryu"
msgid "Just tell her what you honestly feel. Then she can decide what she wants to do."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=30
#. y4:msg_location=T25.P30
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There are no right or wrong answers in love.
msgctxt "12912_Kiryu"
msgid "Even if it ends your friendship, it's better than regretting that you never said anything."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=31
#. y4:msg_location=T25.P31
#. y4:msg_speaker=Maya
