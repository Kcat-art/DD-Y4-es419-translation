#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Of course.
msgctxt "12288_Noa"
msgid "Well, I wouldn't want my boyfriend to come here and drink with other girls."
msgstr "Bueno, no me gustaría que mi novio viniera aquí a beber con otras chicas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
