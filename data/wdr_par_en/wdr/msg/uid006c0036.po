#. y4:msg_speaker_id=2
#. y4:msg_decision_group=10
#. y4:msg_decision_choices=1. I'm his biggest fan! -> T10.P12 | 2. I'd love to fight him just once. -> T10.P21 | 3. I'm jealous. -> T10.P31
msgctxt "7752_松岡里緒奈：源氏名"
msgid "That's right."
msgstr "Así es."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=12
#. y4:msg_location=T10.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm his biggest fan!
msgctxt "7764_Kiryu"
msgid "Wow, Thunder Matsuoka! I'm his biggest fan!"
msgstr "¡Guau, Thunder Matsuoka! ¡Soy su mayor fan!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=13
#. y4:msg_location=T10.P13
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm his biggest fan!
msgctxt "7776_松岡里緒奈：源氏名"
msgid "Really!? You're a fan of my dad?"
msgstr "¿¡De verdad!? ¿Eres fan de mi papá?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=14
#. y4:msg_location=T10.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm his biggest fan!
msgctxt "7788_Kiryu"
msgid "Yes. He was so strong and confident when he was younger. I always looked up to him."
msgstr "Sí. Era muy fuerte y seguro de sí mismo cuando era más joven. Siempre lo admiré."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=15
#. y4:msg_location=T10.P15
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm his biggest fan!
msgctxt "7800_松岡里緒奈：源氏名"
msgid "No way!"
msgstr "¡No puede ser!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=16
#. y4:msg_location=T10.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm his biggest fan!
msgctxt "7812_Kiryu"
msgid "Hey, could you get his autograph for me?"
msgstr "Oye, ¿podrías conseguirme su autógrafo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=17
#. y4:msg_location=T10.P17
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm his biggest fan!
msgctxt "7824_松岡里緒奈：源氏名"
msgid "What!? Are you joking!? Not unless hell freezes over!"
msgstr "¿¡Qué!? ¿¡Estás bromeando!? ¡No, a menos que el infierno se congele!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=18
#. y4:msg_location=T10.P18
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm his biggest fan!
msgctxt "7836_松岡里緒奈：源氏名"
msgid "I told you, I never want to see him again! Whose side are you on, anyway?"
msgstr "¡Ya lo habia dicho, no quiero volver a verlo! ¿De qué lado estás, de todos modos?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=19
#. y4:msg_location=T10.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm his biggest fan!
msgctxt "7848_Kiryu"
msgid "Hmm. Let me think..."
msgstr "Hmm. Déjame pensar..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=20
#. y4:msg_location=T10.P20
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'm his biggest fan!
msgctxt "7860_松岡里緒奈：源氏名"
msgid "You need to think about it!? Traitor!"
msgstr "¿¡Tienes que pensarlo!? ¡Traidor!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=152
#. y4:msg_phrase=0
#. y4:msg_location=T152.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T10.P21
#. y4:msg_branch_segment=T10.P21..P30
#. y4:msg_branch_target_text=I'd love to fight him just once.
#. y4:msg_branch_raw=01 11 00 15 00 00 00 20 00 00 00 00 00 00 00 00
msgctxt "7872_Kiryu"
msgid "I'd love to fight him just once."
msgstr "Me encantaría pelear con él solo una vez."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=22
#. y4:msg_location=T10.P22
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd love to fight him just once.
msgctxt "7884_松岡里緒奈：源氏名"
msgid "Huh!? You want to fight my dad?"
msgstr "¿¡Eh!? ¿Quieres pelear con mi papá?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=23
#. y4:msg_location=T10.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd love to fight him just once.
msgctxt "7896_Kiryu"
msgid "Sure. He may not be young, but he can still put on a good show."
msgstr "Seguro. Puede que no sea joven, pero aún puede dar un buen espectáculo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=24
#. y4:msg_location=T10.P24
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd love to fight him just once.
msgctxt "7908_松岡里緒奈：源氏名"
msgid "You know a lot about wrestling?"
msgstr "¿Sabes mucho de lucha libre?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=25
#. y4:msg_location=T10.P25
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd love to fight him just once.
msgctxt "7920_Kiryu"
msgid "Yeah. Back when I lived in Kamurocho, I went to wrestling matches all the time."
msgstr "Sí. Cuando vivía en Kamurocho, iba a combates de lucha libre todo el tiempo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=28
#. y4:msg_location=T2.P28
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "7932_松岡里緒奈：源氏名"
msgid "Oh..."
msgstr "Oh..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=27
#. y4:msg_location=T10.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd love to fight him just once.
msgctxt "7944_Kiryu"
msgid "So could you ask him if he'd go a round with me?"
msgstr "¿Podrías preguntarle si quiere hacer una ronda conmigo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=28
#. y4:msg_location=T10.P28
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd love to fight him just once.
msgctxt "7956_松岡里緒奈：源氏名"
msgid "What!? No! I don't want to get involved in something like that!"
msgstr "¿¡Qué!? ¡No! ¡No quiero involucrarme en algo así!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=29
#. y4:msg_location=T10.P29
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd love to fight him just once.
msgctxt "7968_Kiryu"
msgid "Oh. That's too bad."
msgstr "Oh. Que lastima."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=30
#. y4:msg_location=T10.P30
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd love to fight him just once.
msgctxt "7980_松岡里緒奈：源氏名"
msgid "Hey, don't look so sad about it!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=31
#. y4:msg_location=T10.P31
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm jealous.
msgctxt "7992_Kiryu"
msgid "I'm jealous. I can't believe he's really your father."
msgstr "Estoy celoso. No puedo creer que sea realmente tu padre."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=32
#. y4:msg_location=T10.P32
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm jealous.
msgctxt "8004_松岡里緒奈：源氏名"
msgid "Huh? Why!? What's so great about my dad, anyway?"
msgstr "¿Eh? ¿¡Por qué!? De todos modos, ¿qué tiene de bueno mi papá?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=33
#. y4:msg_location=T10.P33
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm jealous.
msgctxt "8016_Kiryu"
msgid "He's in his fifties, and he still manages to get into the ring and fight wrestlers half his age. He must really love the sport."
msgstr "Está en sus cincuenta años, y todavía se las arregla para subir al ring y pelear con luchadores de la mitad de su edad. Debe amar mucho el deporte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=34
#. y4:msg_location=T10.P34
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm jealous.
msgctxt "8028_松岡里緒奈：源氏名"
msgid "You've got that right. He's a wrestling fool."
msgstr "Tienes razón. Es un tonto de la lucha libre."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=35
#. y4:msg_location=T10.P35
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm jealous.
msgctxt "8040_松岡里緒奈：源氏名"
msgid "When I was young, he tried to make me into a wrestler!"
msgstr "¡Cuando era joven, trató de convertirme en una luchadora!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=36
#. y4:msg_location=T10.P36
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm jealous.
msgctxt "8052_Kiryu"
msgid "You? A wrestler?"
msgstr "¿Tú? ¿Una luchadora?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=37
#. y4:msg_location=T10.P37
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm jealous.
msgctxt "8064_Kiryu"
msgid "That sounds like something he'd do."
msgstr "Eso suena como algo que él haría."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=38
#. y4:msg_location=T10.P38
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm jealous.
msgctxt "8076_松岡里緒奈：源氏名"
msgid "Well, I don't care how much you love wrestling. You don't try to force your daughter into it."
msgstr "Bueno, no me importa cuánto ames la lucha libre. No tratas de forzar a tu hija a hacerlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=39
#. y4:msg_location=T10.P39
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'm jealous.
msgctxt "8088_Kiryu"
msgid "Your father's a great man. Maybe he had a hard time showing his love for you. Maybe his way was to connect with you through wrestling."
msgstr "Tu padre es un gran hombre. Tal vez tuvo dificultades para mostrar su amor por ti. Tal vez su forma era conectarse contigo a través de la lucha libre."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=40
#. y4:msg_location=T10.P40
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
