#. y4:msg_branch_target=T26.P42
#. y4:msg_branch_segment=T26.P42..P49
#. y4:msg_branch_target_text=Your mom must've been worried about you.
#. y4:msg_branch_raw=01 11 00 2a 00 00 00 28 00 00 00 00 00 00 00 00
msgctxt "17472_Akiyama"
msgid "Your mom must've been worried about you."
msgstr "Tu madre debió preocuparse mucho por ti."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=43
#. y4:msg_location=T26.P43
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Your mom must've been worried about you.
msgctxt "17484_Rio"
msgid "Yes... She was the one giving serious thought about my future, but then I ran away and got her even more worried."
msgstr "Sí... Ella era la que se preocupaba seriamente por mi futuro, pero luego yo huí y la preocupé aún más."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=44
#. y4:msg_location=T26.P44
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Your mom must've been worried about you.
msgctxt "17496_Rio"
msgid "I was such a child back then."
msgstr "Era tan inmadura en aquel entonces."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=45
#. y4:msg_location=T26.P45
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Your mom must've been worried about you.
msgctxt "17508_Akiyama"
msgid "Heh. You'll always be a child to your mother, though."
msgstr "Je. Aunque para tu madre siempre serás una niña."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=46
#. y4:msg_location=T26.P46
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Your mom must've been worried about you.
msgctxt "17520_Rio"
msgid "That's probably very true."
msgstr "Eso es probablemente muy cierto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=47
#. y4:msg_location=T26.P47
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Your mom must've been worried about you.
msgctxt "17532_Akiyama"
msgid "So you asked her on a \"date\" to try and make up for that?"
msgstr "¿Así que le pediste una \"cita\" para tratar de compensar eso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=48
#. y4:msg_location=T26.P48
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Your mom must've been worried about you.
msgctxt "17544_Rio"
msgid "Yep! I hope she has fun."
msgstr "¡Sip! Espero que se divierta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=49
#. y4:msg_location=T26.P49
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Your mom must've been worried about you.
msgctxt "17556_Akiyama"
msgid "I'm sure she will."
msgstr "Estoy seguro de que lo hará."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=0
#. y4:msg_location=T27.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "17568_Rio"
msgid "You asked a while ago about the kind of men I like, right?"
msgstr "Hace un tiempo me preguntó qué tipo de hombres me gustan, ¿verdad?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=1
#. y4:msg_location=T27.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "17580_Akiyama"
msgid "Yeah... I think I did ask you that."
msgstr "Sí... Creo que te pregunté eso."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=2
#. y4:msg_location=T27.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "17592_Rio"
msgid "But I never asked what kind of girls you like."
msgstr "Pero yo nunca le pregunté qué tipo de chicas le gustan a usted."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=3
#. y4:msg_location=T27.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "17604_Akiyama"
msgid "Are you sure you want to ask that?"
msgstr "¿Estás segura de que quieres saber eso?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=4
#. y4:msg_location=T27.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "17616_Rio"
msgid "What!? Am I not your type?"
msgstr "¿¡Qué!? ¿Acaso no soy su tipo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=5
#. y4:msg_location=T27.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "17628_Akiyama"
msgid "Hehe. I'm kidding."
msgstr "Jeje. Estoy bromeando."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=6
#. y4:msg_location=T27.P6
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=27
#. y4:msg_decision_choices=1. I like girls with pretty eyes. -> T27.P7 | 2. I like girls with curves in the right places. -> T27.P17 | 3. I'm looking at my type of girl right now. -> T27.P26
msgctxt "17640_Rio"
msgid "Oh! Don't scare me like that."
msgstr "¡Oh! No me asuste así."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=7
#. y4:msg_location=T27.P7
#. y4:msg_speaker=Akiyama
