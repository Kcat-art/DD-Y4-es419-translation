msgctxt "12120_Kiryu"
msgid "Maybe I could sing a song..."
msgstr "Tal vez podría ir a cantar..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=25
