#. y4:msg_location=T13.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "8700_Noa"
msgid "Wait a second! You never told me how you pick up girls!"
msgstr "¡Espera un segundo! ¡Nunca me dijiste cómo conquistas chicas!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
