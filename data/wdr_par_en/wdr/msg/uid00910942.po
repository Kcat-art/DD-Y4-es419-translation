#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "72_Kiryu"
msgid "This ends here. Tell me where your boss is hiding, now!"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Noir
#. y4:msg_speaker_id=1
msgctxt "84_Noir"
msgid "I've no idea. But you just wait, he'll pay you a visit soon enough."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "96_Kiryu"
msgid "Yeah? Then I'm done with you. See ya."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "108_Kiryu"
msgid "You could take a lesson from your brother, you know. It's a little something called free will."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Noir
#. y4:msg_speaker_id=1
msgctxt "120_Noir"
msgid "......"
msgstr "......"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "180_Kiryu"
msgid "Hey, you're... Rank Zero? You're part of the Dark Clan, too?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Mysterious Man
#. y4:msg_speaker_id=5
msgctxt "192_Mysterious Man"
msgid "Hmph. You must've met that good-for-nothing brother of mine. That simpleton, sticking ranks on people and gloating like the next messiah."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Mysterious Man
#. y4:msg_speaker_id=5
msgctxt "204_Mysterious Man"
msgid "He was nothing but a lowlife that ran off when he couldn't live up to our noble ideals."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Mysterious Man
#. y4:msg_speaker_id=5
msgctxt "216_Mysterious Man"
msgid "I'm Noir, of the Dark Clan. Do not confuse me with my brother."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "228_Kiryu"
msgid "Why are you all after me?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Noir
#. y4:msg_speaker_id=1
msgctxt "240_Noir"
msgid "As for that, I have no idea. But I follow my orders."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Noir
#. y4:msg_speaker_id=1
msgctxt "252_Noir"
msgid "I'm supposed to wait until the boss lures you here. You come, I beat you. Very simple."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "264_Kiryu"
msgid "Okay, then, next question. What's your group up to?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Noir
#. y4:msg_speaker_id=1
msgctxt "276_Noir"
msgid "That's on a need-to-know basis as well. I'm sure the boss will tell me himself when the time's right."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "288_Kiryu"
msgid "Heh... Now I get it."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Noir
#. y4:msg_speaker_id=1
msgctxt "300_Noir"
msgid "What's so funny?"
msgstr "¿De qué te ríes?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "312_Kiryu"
msgid "You may look and sound just like your brother, but he must have gotten all the brains."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=12
#. y4:msg_location=T1.P12
#. y4:msg_speaker=Noir
#. y4:msg_speaker_id=1
msgctxt "324_Noir"
msgid "What did you just say!?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "336_Kiryu"
msgid "Your brother, Rank Zero. At least that guy had a sense of purpose."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "348_Kiryu"
msgid "But you're just following someone else's orders. Orders you don't even understand. So, which one of you is the lowlife, now?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Noir
#. y4:msg_speaker_id=1
msgctxt "360_Noir"
msgid "Why you...!"
msgstr "¡Por qué tú...!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=16
#. y4:msg_location=T1.P16
#. y4:msg_speaker=Noir
#. y4:msg_speaker_id=1
msgctxt "372_Noir"
msgid "This conversation has gone on long enough. It's about time for you to die."
msgstr ""
