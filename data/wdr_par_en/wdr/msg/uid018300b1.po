#. y4:msg_phrase=12
#. y4:msg_location=T4.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=14
msgctxt "6140_Rio"
msgid "Oh, come on. Prepared for our table tennis match after we get out!"
msgstr "¡Vamos! ¡Preparado para nuestro partido de ping-pong después de salir de aquí!"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=4
#. y4:msg_phrase=13
#. y4:msg_location=T4.P13
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=14
#. y4:msg_decision_group=12
#. y4:msg_decision_choices=1. I'm ready to take you on. -> T4.P14 | 2. Let's take it easy. -> T4.P21 | 3. What'll you do for me if I win? -> T4.P26
msgctxt "6152_Rio"
msgid "I'm already getting into the right mood! Gotta focus if I'm gonna beat you!"
msgstr "¡Ya estoy entrando en el estado de ánimo adecuado! ¡Tengo que concentrarme si quiero ganarle!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=44
#. y4:msg_phrase=0
