#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Go to the Arena
msgctxt "740_Kiryu"
msgid "Yeah."
msgstr "Sí."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
