#. y4:msg_branch_segment=T1.P21..P29
#. y4:msg_branch_target_text=That's a tricky issue. It depends on what the man wants.
#. y4:msg_branch_raw=01 11 00 15 00 00 00 16 00 00 00 00 00 00 00 00
msgctxt "17568_Kiryu"
msgid "That's a tricky issue."
msgstr "Es... difícil de explicar."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
