#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a tricky issue.
msgctxt "4848_Kiryu"
msgid "Huh? What do you mean?"
msgstr "¿Eh? ¿A qué se refiere?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=24
#. y4:msg_location=T1.P24
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a tricky issue.
msgctxt "4860_Maya"
msgid "There must be a type of woman you prefer, right?"
msgstr "Debe haber un tipo de mujer que prefieras, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
