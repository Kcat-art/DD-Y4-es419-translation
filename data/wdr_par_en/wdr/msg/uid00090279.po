#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "120_Akiyama"
msgid "Any luck?"
msgstr "¿Cómo te fue?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Noriko
#. y4:msg_speaker_id=2
msgctxt "132_Noriko"
msgid "No, nothing..."
msgstr "No pude encontrar uno..."

#. y4:line_status=translated
msgctxt "144_Akiyama"
msgid "Then, I can't lend you the money. I'm afraid I'll have to\\r\nask you to leave."
msgstr "Entonces, no puedo prestarte el dinero. Me temo que tendré\\r\nque pedirte que te vayas."

#. y4:line_status=translated
msgctxt "156_Noriko"
msgid "I stopped into every single place looking for part-time\\r\nhelp! They all said I was too old."
msgstr "¡Fui a todas partes buscando algún trabajo a tiempo parcial!\\r\nTodos me dijeron que no podían contratarme por la edad."

#. y4:line_status=translated
msgctxt "168_Noriko"
msgid "I tried lots of stores and restaurants, but they told me\\r\nthey had enough help..."
msgstr "Probé en muchas tiendas y restaurantes, pero todos\\r\nme decían que ya tenían personal suficiente..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "180_Akiyama"
msgid "And?"
msgstr "¿Y? ¿Qué más?"

#. y4:line_status=translated
msgctxt "192_Noriko"
msgid "Three hours to find work in Kamurocho? It's just not\\r\npossible."
msgstr "¿Tres horas para encontrar trabajo en Kamurocho?\\r\nEs imposible."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "204_Akiyama"
msgid "Did you check the red-light district?"
msgstr "¿Revisaste la zona roja?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Noriko
#. y4:msg_speaker_id=2
msgctxt "216_Noriko"
msgid "What!?"
msgstr "¡¿Qué?!"

#. y4:line_status=translated
msgctxt "228_Akiyama"
msgid "You know－massage parlors, places like that. Somebody as\\r\ngood-looking as you should be able to find a willing\\r\nemployer, no problem."
msgstr "Ya sabes, lugares como los salones de masajes. Entretenimiento\\r\npara adultos. Alguien tan guapa como tú de seguro\\r\nes contratada rápidamente."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Noriko
#. y4:msg_speaker_id=2
msgctxt "240_Noriko"
msgid "I could never work in the sex industry!"
msgstr "¡No hay manera en que trabaje en la zona roja!"

#. y4:line_status=translated
msgctxt "252_Akiyama"
msgid "That's entirely up to you. But you won't get the loan until\\r\nyou pass the test."
msgstr "Eso depende totalmente de usted. Pero no obtendrás el\\r\npréstamo hasta que pases la prueba."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Noriko
#. y4:msg_speaker_id=2
msgctxt "264_Noriko"
msgid "But I..."
msgstr "Pero yo..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=16
#. y4:msg_location=T1.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "276_Akiyama"
msgid "I really must ask you to leave."
msgstr "Realmente debo pedirle que se vaya."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=20
#. y4:msg_location=T1.P20
#. y4:msg_speaker=Shiobara
#. y4:msg_speaker_id=6
msgctxt "324_Shiobara"
msgid "Akiyama-san, hasn't she been through enough already?"
msgstr "Akiyama-san, ¿acaso no cree que esto ya es demasiado?"

#. y4:line_status=translated
msgctxt "336_Akiyama"
msgid "Like I said, I don't give people money just because I feel\\r\nsorry for them."
msgstr "Como dije, no presto dinero a las personas solo porque me\\r\nden lastima."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=22
#. y4:msg_location=T1.P22
#. y4:msg_speaker=Shiobara
#. y4:msg_speaker_id=6
msgctxt "348_Shiobara"
msgid "Still..."
msgstr "Aún así..."

#. y4:line_status=translated
msgctxt "360_Akiyama"
msgid "If she truly wanted a new life for herself, she'd have gone\\r\nstraight into a massage parlor and asked for a job."
msgstr "Si realmente quisiera cambiar su vida, habría buscado trabajo\\r\nen la zona roja, sin importarle lo que dijeran los demás."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=24
#. y4:msg_location=T1.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "372_Akiyama"
msgid "I won't lend to anybody who's less than serious."
msgstr "No tengo intención de prestarle dinero a alguien que no va en serio."

#. y4:line_status=translated
msgctxt "384_Akiyama"
msgid "You were serious about changing your life, right? And I lent\\r\nyou your money."
msgstr "Recuerda que tú también tomaste una decisión difícil para\\r\ncambiar tu vida. Ibas completamente en serio.\nPor eso te presté el dinero."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=26
#. y4:msg_location=T1.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "396_Akiyama"
msgid "I helped you because you were sincere."
msgstr "Te ayudé porque lo diste todo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=27
#. y4:msg_location=T1.P27
#. y4:msg_speaker=Shiobara
#. y4:msg_speaker_id=6
msgctxt "408_Shiobara"
msgid "......"
msgstr "......"

#. y4:line_status=translated
msgctxt "420_Akiyama"
msgid "You said you didn't want to waste my five million yen. Are\\r\nyou really looking for a worthwhile way to spend it?"
msgstr "Dijiste que no querías desperdiciar mis cinco millones de yenes.\\r\nPero, ¿realmente estás buscando algo que quieras hacer ahora mismo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=27
#. y4:msg_location=T1.P27
#. y4:msg_speaker=Shiobara
#. y4:msg_speaker_id=6
msgctxt "432_Shiobara"
msgid "......"
msgstr "......"

#. y4:line_status=translated
msgctxt "444_Akiyama"
msgid "Because I can tell you right now, you won't find anything\\r\nby hanging around me."
msgstr "Si lo único que haces es quedarte a mi lado, nunca\\r\nencontrarás lo que quieres hacer."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=31
#. y4:msg_location=T1.P31
#. y4:msg_speaker=Shiobara
#. y4:msg_speaker_id=6
msgctxt "456_Shiobara"
msgid "...You're right."
msgstr "...Tienes razón."

#. y4:line_status=translated
msgctxt "468_Shiobara"
msgid "You lent me money, so I felt dependent on you. I'll give\\r\nsome more serious thought to what exactly it is I want to\\r\ndo."
msgstr "El pedirle dinero me hizo depende de usted.\\r\nPensaré más seriamente en qué es exactamente\\r\nlo que quiero hacer, y esta vez por mi cuenta."

#. y4:line_status=translated
msgctxt "528_Hana"
msgid "Are you sure about this, Chief? You could've let\\r\nShiobara-san work here, you know."
msgstr "¿Estás seguro de eso, Jefe? Podríamos haber contratado\\r\na Shiobara-san."

#. y4:line_status=translated
msgctxt "540_Akiyama"
msgid "No, it's better this way. He's a big boy. I'm sure he can\\r\nfigure out his hopes and dreams all by himself."
msgstr "No, es mejor así. Estoy seguro de que encontrará\\r\nlo que desea hacer por su cuenta."
