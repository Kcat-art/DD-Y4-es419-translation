msgid "You really like cars, don't you?"
msgstr "Te gustan mucho los autos, ¿verdad?"

msgctxt "8880_Noa"
msgid "I love them! <Color:7>♥<Color:Default>"
msgstr "¡Los adoro! <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=18
#. y4:msg_location=T13.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You really like cars, don't you?
msgctxt "8892_Akiyama"
msgid "And I suppose you don't like automatic transmissions, huh?"
msgstr "Y supongo que no te gustan las transmisiones automáticas, ¿eh?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=19
