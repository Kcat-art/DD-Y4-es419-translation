#. y4:msg_location=T13.P4
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "8724_Noa"
msgid "Hey! That's not fair!"
msgstr "Ey, ¡eso no es justo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
