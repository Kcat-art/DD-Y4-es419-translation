msgctxt "84_Saejima"
msgid "Hey, punk. You one of Shirakawa's agents?"
msgstr "A ver tú. ¿Eres un un peón de Shirakawa?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Businessman
#. y4:msg_speaker_id=2
msgctxt "96_Businessman"
msgid "If you must know, I am planning on voting for Shirakawa-san in the upcoming election. Is that a problem?"
msgstr "¿Qué pasa...? Pues, sí, pienso votar por Shirakawa en las próximas elecciones... ¿Y qué?"

msgctxt "108_Businessman"
msgid "Wait, are you trying to scare me into changing my vote?\\r\n"
"Who does Numai think he is, a yakuza?"
msgstr "Un Momento, ¿Me estás intimidando para que cambie mi voto?\\r\n"
"¿Qué se cree Numai, un miembro de la Yakuza?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
