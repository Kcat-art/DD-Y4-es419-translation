msgid "I knew you'd come through! I've got your back no matter what happens."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=4
#. y4:msg_location=T3.P4
