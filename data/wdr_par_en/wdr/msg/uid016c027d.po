msgstr "¿Sueles discutir con tus clientes?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=41
#. y4:msg_phrase=4
#. y4:msg_location=T41.P4
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
