#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd be a little surprised too.
msgctxt "9084_Akiyama"
msgid "Why don't you just skip the horror films from now on?"
msgstr "¿Por qué no pruebas con otras películas a partir de ahora?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
#. y4:msg_talk=12
