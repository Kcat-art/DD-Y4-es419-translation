msgid "What? Are you joking? I'm beginning to have second thoughts about this place..."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=5
