msgstr "......"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Older-Looking Man
#. y4:msg_speaker_id=6
msgctxt "224_Older-Looking Man"
msgid "Huh? Kiryu-san?"
msgstr "¿Eh? ¿Kiryu-san?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=12
msgctxt "236_Kiryu"
msgid "Aota? What're you doing here?"
msgstr "¿Aota? ¿Pero qué haces aquí?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Older-Looking Man
#. y4:msg_speaker_id=6
msgctxt "248_Aota"
msgid "......"
msgstr "......"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=12
msgctxt "260_Kiryu"
msgid "All the other color gang leaders moved on with their lives, in one way or another."
msgstr "Todos los líderes de las bandas de colores siguieron adelante con sus vidas, de una forma u otra."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=12
msgctxt "272_Kiryu"
msgid "Listen, I'm not going to lecture you if this is what you want to do. But is this really it for you?"
msgstr "Mira, no voy a sermonearte si esto es lo que quieres hacer. Pero, ¿de verdad es lo que quieres?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Aota
#. y4:msg_speaker_id=14
msgctxt "284_Aota"
msgid "Shaddup! The hell you think you know, anyway!?"
msgstr "¡Cállate! ¡¿Qué sabes tú, eh?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Older-Looking Man
#. y4:msg_speaker_id=6
msgctxt "296_Kiryu"
msgid "......"
msgstr "......"

