#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "14196_松岡里緒奈：源氏名"
msgid "Don't worry about it. I'll get a rematch against her someday."
msgstr "No te preocupes. Tendré una revancha contra el algún día."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
