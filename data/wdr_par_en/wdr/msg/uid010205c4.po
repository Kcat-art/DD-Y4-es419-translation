msgid "Hamazaki? What happened to him?"
msgstr "¿Hamazaki? ¿Qué le pasó?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Haruka
#. y4:msg_speaker_id=11
msgctxt "580_Haruka"
msgid "He's... He's gone. He just passed away in the hospital."
msgstr "Él... Él se ha ido. Acaba de fallecer en el hospital."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "592_Kiryu"
msgid "What?"
msgstr "¿Qué?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "604_Haruka"
msgid "According to the doctor, the cause of death was a gunshot\\r\nwound to the back."
msgstr "Segun el doctor, la causa de muerte fue un disparo\\r\nen la espalda."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "616_Kiryu"
msgid "......"
msgstr "......"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "628_Haruka"
msgid "......"
msgstr "......"

#. y4:line_status=todo
msgctxt "640_Kiryu"
msgid "All right, I understand. Thanks for being there in his final\\r\nmoments, Haruka."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Haruka
#. y4:msg_speaker_id=11
msgctxt "652_Haruka"
msgid "You don't have to thank me for that. And hey... Uncle Kaz?"
msgstr ""

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "664_Kiryu"
msgid "Hm? What is it?"
msgstr "¿Qué? ¿Qué es esto?"

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Haruka
#. y4:msg_speaker_id=11
msgctxt "676_Haruka"
msgid "Hamazaki-san died protecting you, didn't he?"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=16
#. y4:msg_location=T1.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "688_Kiryu"
msgid "...Yeah, it seems like it. He sacrificed his life for us."
msgstr ""

#. y4:line_status=todo
msgctxt "700_Haruka"
msgid "Then... I wish I could tell him how sorry I am. I was so\\r\nwrong about him."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=18
#. y4:msg_location=T1.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "712_Kiryu"
msgid "It's okay, Haruka."
msgstr ""

#. y4:line_status=todo
msgctxt "724_Haruka"
msgid "When Hamazaki-san was on his deathbed... he asked me to tell\\r\nyou something."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=20
#. y4:msg_location=T1.P20
#. y4:msg_speaker=Haruka
#. y4:msg_speaker_id=11
msgctxt "736_Haruka"
msgid "\"Keep the Tojo Clan safe from the cops. It's the only proof left that guys like us ever existed.\""
msgstr ""

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "748_Kiryu"
msgid "......"
msgstr "......"

#. y4:line_status=todo
msgctxt "760_Haruka"
msgid "He wanted you to tell Saejima-san, too. That was his dying\\r\nwish."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=23
#. y4:msg_location=T1.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "772_Kiryu"
msgid "Got it. Thanks for telling me all this, Haruka."
msgstr ""

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=24
#. y4:msg_location=T1.P24
#. y4:msg_speaker=Haruka
#. y4:msg_speaker_id=11
msgctxt "784_Haruka"
msgid "Of course."
msgstr "No se preocupe."

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=25
#. y4:msg_location=T1.P25
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "796_Kiryu"
msgid "By the way. What happened to Hamazaki's body?"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=26
#. y4:msg_location=T1.P26
#. y4:msg_speaker=Haruka
#. y4:msg_speaker_id=11
msgctxt "808_Haruka"
msgid "I had them send it back to Morning Glory. Is that okay?"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=27
#. y4:msg_location=T1.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "820_Kiryu"
msgid "Yeah, that's perfect. Sorry you had to go through all this."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=28
#. y4:msg_location=T1.P28
#. y4:msg_speaker=Haruka
#. y4:msg_speaker_id=11
msgctxt "832_Haruka"
msgid "It's okay. I'll be fine."
msgstr ""

#. y4:line_status=todo
msgctxt "844_Kiryu"
msgid "I should be back in Okinawa soon. And once I am, we'll make\\r\nsure he gets a proper burial."
msgstr ""

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=30
#. y4:msg_location=T1.P30
#. y4:msg_speaker=Haruka
#. y4:msg_speaker_id=11
msgctxt "856_Haruka"
msgid "Okay."
msgstr "Está bien."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=31
#. y4:msg_location=T1.P31
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "868_Kiryu"
msgid "Talk to you soon."
msgstr "Entonces hablamos en un rato."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=2
msgctxt "940_Date"
msgid "Where's Akiyama?"
msgstr "¿Dónde está Akiyama?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "952_Tanimura"
msgid "Over at his office. Said he needed some time alone."
msgstr "Seguro en su oficina. Dijo que necesitaba un momento a solas."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=4
#. y4:msg_location=T2.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "964_Tanimura"
msgid "Can't say I blame him. Not with how he felt about Yasuko-san."
msgstr "No lo culpo. No con lo que él sentía con Yasuko-san."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=5
#. y4:msg_location=T2.P5
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=2
msgctxt "976_Date"
msgid "Yeah... I can't imagine."
msgstr "Ya veo... No me lo imagino..."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "1000_Date"
msgid "Anyway, what now? Munakata has probably had his paws on that\\r\nfile for a while at this point."
msgstr "De todos modos, ¿Que pasara ahora? Munakata tiene probablemente en sus manos\\r\nesos archivos hace tiempo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=8
#. y4:msg_location=T2.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "1012_Kiryu"
msgid "Good question."
msgstr "Por qué será."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=11
#. y4:msg_location=T2.P11
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "1048_Tanimura"
msgid "Well, we can't let things end like this, that's for sure."
msgstr "Bueno, no podemos dejar que termine así, eso seguro."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "1060_Tanimura"
msgid "Yasuko-san's dead. Munakata's still on the force. And\\r\nnobody's doing a damn thing about it! You think I'm just\\r\ngonna sit around and let that stand!?"
msgstr "La muerte de Yasuko-san. Munakata sigue en la policía.\\r\n¡Nadie va a hacer alguna mierda sobre eso!\\r\n¡¿Crees que solo voy a quedarme haciendo nada?!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "1072_Date"
msgid "......"
msgstr "......"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=14
#. y4:msg_location=T2.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "1084_Kiryu"
msgid "Tanimura..."
msgstr "Tanimura..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=19
#. y4:msg_location=T2.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=6
msgctxt "1144_Kiryu"
msgid "Where are you going?"
msgstr "¿A dónde vas?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=20
#. y4:msg_location=T2.P20
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=9
msgctxt "1156_Saejima"
msgid "Don't gotta tell you that."
msgstr "No tengo que decirte nada..."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "1168_Kiryu"
msgid "Saejima. We have proof now that you didn't commit those\\r\nmurders twenty-five years ago. You'll be a free man once we get them to review your case."
msgstr "Saejima. Tenemos las pruebas sobre tu caso\\r\nde hace 25 años. Seras un hombre libre cuando revean tu caso."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "1180_Saejima"
msgid "Don't give a rat's ass one way or the other. Do whatever ya\\r\nwanna do."
msgstr "Me importa una mierda. Haz lo que quieras\\r\nMe da igual"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=23
#. y4:msg_location=T2.P23
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=9
msgctxt "1192_Saejima"
msgid "...I ain't goin' nowhere. Just gonna go get some fresh air."
msgstr "... No voy a ningún lado. Solo quiero ir a tomar aire fresco."
