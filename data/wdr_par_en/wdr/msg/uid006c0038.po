#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You're right.
msgctxt "4932_Kiryu"
msgid "No, not really. I don't like it very much actually."
msgstr "No, en verdad, no me gusta mucho."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=9
