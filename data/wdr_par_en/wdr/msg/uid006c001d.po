#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I bet I'd like it there if I were a girl.
msgctxt "12396_Akiyama"
msgid "Sure. It sounds like you had fun."
msgstr "Claro. Parece que te divertiste mucho."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
