#. y4:msg_branch_target=T2.P17
#. y4:msg_branch_segment=T2.P17..P23
#. y4:msg_branch_target_text=I get stopped sometimes myself.
#. y4:msg_branch_raw=01 11 00 11 00 00 00 1f 00 00 00 00 00 00 00 00
msgctxt "5136_Kiryu"
msgid "I get stopped sometimes myself."
msgstr "A veces yo mismo me detengo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=18
#. y4:msg_location=T2.P18
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I get stopped sometimes myself.
msgctxt "5148_Maya"
msgid "You do? Maybe we should start a club!"
msgstr "¿Lo haces? ¡Tal vez deberíamos crear un club!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=19
#. y4:msg_location=T2.P19
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I get stopped sometimes myself.
msgctxt "5160_Maya"
msgid "It must be because you have a wild and dangerous look about you."
msgstr "Eso debe ser porque tienes un aspecto salvaje y peligroso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=20
#. y4:msg_location=T2.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I get stopped sometimes myself.
msgctxt "5172_Kiryu"
msgid "Maybe. I usually just run away. I don't have the time."
msgstr "Tal vez. Por lo general, simplemente huyo. No tengo el tiempo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=21
#. y4:msg_location=T2.P21
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I get stopped sometimes myself.
msgctxt "5184_Maya"
msgid "But wouldn't that make you seem more suspicious?"
msgstr "Pero, ¿no te hace ver más sospechoso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=22
#. y4:msg_location=T2.P22
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I get stopped sometimes myself.
msgctxt "5196_Kiryu"
msgid "That's why I make sure they don't catch me."
msgstr "Eso es porque casi nunca me atrapan."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=23
#. y4:msg_location=T2.P23
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I get stopped sometimes myself.
msgctxt "5208_Maya"
msgid "Hahaha! It sounds like you're an expert. I should try running next time."
msgstr "¡Ja, ja, ja! Se ve que eres un experto. Deberías entrar en una maratón."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=24
#. y4:msg_location=T2.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try to wear less flashy clothes.
msgctxt "5220_Kiryu"
msgid "You could try to wear less flashy clothes. You do sort of stand out."
msgstr "Deberías usar ropa menos llamativa. De alguna manera te destacas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=25
#. y4:msg_location=T2.P25
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try to wear less flashy clothes.
msgctxt "5232_Maya"
msgid "But all the girls wear clothes like this."
msgstr "Pero todas las chicas se visten así."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=26
#. y4:msg_location=T2.P26
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try to wear less flashy clothes.
msgctxt "5244_Kiryu"
msgid "So why do they stop you all the time?"
msgstr "Entonces, ¿por qué te detienen todo el tiempo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=27
#. y4:msg_location=T2.P27
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try to wear less flashy clothes.
msgctxt "5256_Maya"
msgid "I don't know. I guess I have some kind of suspicious aura."
msgstr "No lo sé. Supongo que causo sospechas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=28
#. y4:msg_location=T2.P28
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try to wear less flashy clothes.
msgctxt "5268_Kiryu"
msgid "They probably want an excuse to talk with a famous model."
msgstr "Probablemente, quieren una excusa para hablar con una modelo famosa."

msgctxt "5280_Maya"
msgid "Ha! You'll make me blush if you keep talking like that. <Color:7>♥<Color:Default>"
msgstr "¡Ja! Me vas a sonrojar si sigues hablando así. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=30
#. y4:msg_location=T2.P30
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try to wear less flashy clothes.
msgctxt "5292_Kiryu"
msgid "Heh, sorry."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=0
#. y4:msg_location=T3.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "5304_Maya"
msgid "I hate arrogant men. You know, the kind of guy who acts like he knows you and bosses you around, even though you just met?"
msgstr "Odio a los hombres arrogantes. Ya sabes, ese tipo de persona que actúa como si fuera el jefe de todos y que te da órdenes, ¿Conoces a alguien así?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=1
#. y4:msg_location=T3.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "5316_Kiryu"
msgid "You're not talking about me, are you?"
msgstr "¿No estarás hablando de mí?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=2
#. y4:msg_location=T3.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "5328_Maya"
msgid "No, no. You're fine. A bit of swagger suits you."
msgstr "No, no. Usted está bien. A ti te va bien él fanfarroneó."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=3
#. y4:msg_location=T3.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "5340_Kiryu"
msgid "If you say so."
msgstr "¿Están listos?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=4
#. y4:msg_location=T3.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=3
#. y4:msg_decision_choices=1. They're fooling themselves. -> T3.P5 | 2. Young guys don't know what manners are. -> T3.P11 | 3. There's nothing you can do about it. -> T3.P16
msgctxt "5352_Maya"
msgid "But a lot of guys these days are all talk. They think they're so special."
msgstr "Pero un montón de hombres son solo charlatanes. Piensan que son muy especiales."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=5
#. y4:msg_location=T3.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're fooling themselves.
msgctxt "5364_Kiryu"
msgid "They're fooling themselves. They think they're being cool."
msgstr "Se están engañando ellos mismo. Piensan que son geniales."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=6
#. y4:msg_location=T3.P6
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're fooling themselves.
msgctxt "5376_Maya"
msgid "Right. They're trying so hard to impress girls, but it just ends up backfiring!"
msgstr "Verdad. Intenta impresionar a las chicas, ¡pero les sale el tiro por la culata!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=7
#. y4:msg_location=T3.P7
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're fooling themselves.
msgctxt "5388_Maya"
msgid "Being polite makes a much better impression."
msgstr "Ser cortés da una mejor impresión."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=8
#. y4:msg_location=T3.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're fooling themselves.
msgctxt "5400_Kiryu"
msgid "They're young. They don't know any better."
msgstr "Son jóvenes. No saben nada."

msgctxt "5412_Maya"
msgid "I'd take a polite older man over an arrogant young guy any day. They could learn a thing or two from you. <Color:7>♥<Color:Default>"
msgstr "Preferiría a un hombre mayor cortés que a un joven arrogante común. Podría aprender un par de cosas de ti. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=10
#. y4:msg_location=T3.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're fooling themselves.
msgctxt "5424_Kiryu"
msgid "Yeah."
msgstr "Sí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=11
#. y4:msg_location=T3.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Young guys don't know what manners are.
msgctxt "5436_Kiryu"
msgid "Young guys don't know what manners are. If you don't know someone, you should make an effort to be polite."
msgstr "Los jóvenes no conocen los modales. Si no conoces a alguien así, debes de hacer el esfuerzo de ser cortés."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=12
#. y4:msg_location=T3.P12
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Young guys don't know what manners are.
msgctxt "5448_Maya"
msgid "That's right! And it's not just young people. We get older customers like that, too."
msgstr "Así es. Y no solo los jóvenes. También tenemos clientes ancianos así."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=13
#. y4:msg_location=T3.P13
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Young guys don't know what manners are.
msgctxt "5460_Maya"
msgid "They order us around like we're their servants or something!"
msgstr "¡Nos dan órdenes como si fuéramos sus sirvientas o algo así!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=14
#. y4:msg_location=T3.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Young guys don't know what manners are.
msgctxt "5472_Kiryu"
msgid "I suppose one reason they come here is to blow off steam."
msgstr "Supongo que una de las razones por las que vienen aquí es para desahogarse."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=15
#. y4:msg_location=T3.P15
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Young guys don't know what manners are.
msgctxt "5484_Maya"
msgid "I hate people who can only make themselves feel better by tearing other people down."
msgstr "Odio a la gente que solo puede sentirse mejor despreciando a los demás."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=16
#. y4:msg_location=T3.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There's nothing you can do about it.
msgctxt "5496_Kiryu"
msgid "There's nothing you can do about it. Young guys don't have any accomplishments yet, so they try to make themselves look good."
msgstr "No hay nada que puedas hacer al respecto. Los jóvenes aún no tienen ningún logro, así que tratan de verse bien."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=17
#. y4:msg_location=T3.P17
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There's nothing you can do about it.
msgctxt "5508_Maya"
msgid "Why can't they just wait until they've got something real to brag about?"
msgstr "¿Por qué no pueden esperar a tener algo real de lo que presumir?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=18
#. y4:msg_location=T3.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There's nothing you can do about it.
msgctxt "5520_Kiryu"
msgid "Because they can't. If you look weak, the other guys eat you alive."
msgstr "Porque no pueden. Si pareces débil, los otros te comen vivo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=19
#. y4:msg_location=T3.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There's nothing you can do about it.
msgctxt "5532_Kiryu"
msgid "The first impression is particularly important. You have to take the initiative before the other guy does."
msgstr "La primera impresión es especialmente importante. Tienes que tomar la iniciativa antes de que el otro actúe."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=20
#. y4:msg_location=T3.P20
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There's nothing you can do about it.
msgctxt "5544_Maya"
msgid "So you agree with how those guys act? That's ridiculous."
msgstr "¿Así que estás de acuerdo con cómo actúan esos tipos? Eso es estúpido."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=21
#. y4:msg_location=T3.P21
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=There's nothing you can do about it.
msgctxt "5556_Maya"
msgid "Even if they do have to be like that with other guys, it's a total turnoff for girls."
msgstr "Incluso si tienen que ser así con otros chicos, es un desinterés total para las chicas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=29
#. y4:msg_location=T1.P29
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a tricky issue.
msgctxt "5568_Kiryu"
msgid "......"
msgstr "......"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=0
#. y4:msg_location=T4.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "5580_Maya"
msgid "My friend's boyfriend cheated on her. Again."
msgstr "El novio de mi amiga la volvió a engañar."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=1
#. y4:msg_location=T4.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "5592_Kiryu"
msgid "He's done it before?"
msgstr "¿Lo ha hecho antes?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=2
#. y4:msg_location=T4.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "5604_Maya"
msgid "Yep. This would be the third time. She almost broke up with him last time, but he begged her to forgive him, so I guess she took him back."
msgstr "Sip. Ya debe ser como la tercera vez. Ella casi termina su relación, pero él estaba rogando para  que le perdonara, y acepto sus disculpas."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=3
#. y4:msg_location=T4.P3
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "5616_Maya"
msgid "And now he's done it again! I can't believe it!"
msgstr "¡Y ahora lo volvió a hacer! ¡Es que no lo puedo creer!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=11
#. y4:msg_location=T20.P11
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's what I like about you.
msgctxt "5628_Kiryu"
msgid "Hmm..."
msgstr "Mmm..."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=5
#. y4:msg_location=T4.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=4
#. y4:msg_decision_choices=1. You really want to know why men cheat? -> T4.P6 | 2. She should leave him. -> T4.P14 | 3. It shows that he's a real man. -> T4.P22
msgctxt "5640_Maya"
msgid "I could never forgive that! Why do men have to cheat!?"
msgstr "¡Yo nunca lo perdonaría! ¿¡Por qué los hombres son mujeriegos!?"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=133
#. y4:msg_phrase=0
#. y4:msg_location=T133.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T4.P6
#. y4:msg_branch_segment=T4.P6..P13
#. y4:msg_branch_target_text=You really want to know why men cheat?
#. y4:msg_branch_raw=01 11 00 06 00 00 00 26 00 00 00 00 00 00 00 00
msgctxt "5652_Kiryu"
msgid "You really want to know why men cheat?"
msgstr "¿En serio quieres saber por qué los hombres engañan?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=7
#. y4:msg_location=T4.P7
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You really want to know why men cheat?
msgctxt "5664_Maya"
msgid "Yes!"
msgstr "¡Sí!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=8
#. y4:msg_location=T4.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You really want to know why men cheat?
msgctxt "5676_Kiryu"
msgid "But you said you could never forgive it. Does it matter what the reason is?"
msgstr "Pero dijiste que nunca podrías perdonarlo. ¿Importa cuál sea el motivo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=9
#. y4:msg_location=T4.P9
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You really want to know why men cheat?
msgctxt "5688_Maya"
msgid "Oh. I hadn't thought about it that way."
msgstr "Oh. No lo había pensado de esa manera."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=10
#. y4:msg_location=T4.P10
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You really want to know why men cheat?
msgctxt "5700_Maya"
msgid "But I'd still like to know!"
msgstr "¡Pero aun así me gustaría saberlo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=11
#. y4:msg_location=T4.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You really want to know why men cheat?
msgctxt "5712_Kiryu"
msgid "Well, it depends. Sometimes it's the man's fault, and sometimes it's the woman's."
msgstr "Bueno, depende. A veces es culpa del hombre y a veces de la mujer."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=12
#. y4:msg_location=T4.P12
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You really want to know why men cheat?
msgctxt "5724_Maya"
msgid "Either way, I think they should make a clean break instead of cheating."
msgstr "En cualquier caso, creo que deberían hacer una ruptura honesta en lugar de engañar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=13
#. y4:msg_location=T4.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You really want to know why men cheat?
msgctxt "5736_Kiryu"
msgid "Yes, you're right."
msgstr "Sí, tienes toda la razón."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=14
#. y4:msg_location=T4.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=She should leave him.
msgctxt "5748_Kiryu"
msgid "I don't know, but your friend's relationship isn't healthy. She should leave him."
msgstr "No lo sé, pero la relación de tu amigo no es sana. Ella debería de dejarlo definitivamente."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=15
#. y4:msg_location=T4.P15
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=She should leave him.
msgctxt "5760_Maya"
msgid "You're right. I'd have broken up with him after the first time."
msgstr "Tienes toda la razón. Yo habría roto después de la primera vez."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=16
#. y4:msg_location=T4.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=She should leave him.
msgctxt "5772_Kiryu"
msgid "Once and it's over?"
msgstr "¿Una vez y se acabó?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=17
#. y4:msg_location=T4.P17
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=She should leave him.
msgctxt "5784_Maya"
msgid "Yes. I can't forgive that kind of betrayal."
msgstr "Sí. No podría perdonar tal acto de traición."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=18
#. y4:msg_location=T4.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=She should leave him.
msgctxt "5796_Kiryu"
msgid "So you'd never cheat yourself, right?"
msgstr "Así que nunca te engañarías a ti misma, ¿no?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=19
#. y4:msg_location=T4.P19
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=She should leave him.
msgctxt "5808_Maya"
msgid "Of course not. I'm a devoted girlfriend."
msgstr "Por supuesto que no. Soy una novia leal."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=20
#. y4:msg_location=T4.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=She should leave him.
msgctxt "5820_Kiryu"
msgid "Good. I'd be reassured if I was your boyfriend."
msgstr "Bien. Me calmaría si yo fuera tu novio."

msgctxt "5832_Maya"
msgid "Thank you. <Color:7>♥<Color:Default>"
msgstr "Gracias. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=22
#. y4:msg_location=T4.P22
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It shows that he's a real man.
msgctxt "5844_Kiryu"
msgid "It shows that he's a real man. Your friend should be proud that her man can get that many girls."
msgstr "Él solo está demostrando su hombría. Esa tipa debería estar totalmente orgullosa de que su macho pueda conseguir un montón de mujeres."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=23
#. y4:msg_location=T4.P23
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It shows that he's a real man.
msgctxt "5856_Maya"
msgid "What the hell are you talking about!?"
msgstr "¿¡De qué carajos estás hablando!?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=24
#. y4:msg_location=T4.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It shows that he's a real man.
msgctxt "5868_Kiryu"
msgid "It takes money to date a girl. Just think how much it takes to date several girls at once."
msgstr "Se ocupa dinero para salir con una chica. Ahora imagínate cuanto costará salir con varias chicas a la vez."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=25
#. y4:msg_location=T4.P25
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It shows that he's a real man.
msgctxt "5880_Kiryu"
msgid "Your friend managed to land a guy who has that kind of resources. She should be happy."
msgstr "Tu amiga consiguió un macho con esos recursos. Debería estar contenta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=26
#. y4:msg_location=T4.P26
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It shows that he's a real man.
msgctxt "5892_Maya"
msgid "I can't believe you! Trying to justify it is even worse than sneaking around!"
msgstr "¡No lo puedo creer! ¡Engañar a una mujer es una cosa, pero justificarlo es incluso peor! "

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=27
#. y4:msg_location=T4.P27
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It shows that he's a real man.
msgctxt "5904_Maya"
msgid "I really thought you'd understand, too..."
msgstr "No lo entenderías..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=0
#. y4:msg_location=T5.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "5916_Maya"
msgid "You look like a strong drinker."
msgstr "Pareces ser un bebedor muy fuerte."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=1
#. y4:msg_location=T5.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "5928_Kiryu"
msgid "I suppose I am. What about you?"
msgstr "Supongo que lo soy. ¿Qué hay de ti?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=2
#. y4:msg_location=T5.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "5940_Maya"
msgid "Me? I'm a lightweight. I like alcohol, though."
msgstr "¿Yo? Soy ligera. Sin embargo, me gusta el alcohol."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=3
#. y4:msg_location=T5.P3
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=5
#. y4:msg_decision_choices=1. They have medicine for that, you know. -> T5.P4 | 2. Some people just can't drink. -> T5.P10 | 3. Try drinking more slowly. -> T5.P16
msgctxt "5952_Maya"
msgid "I wish I could become a stronger drinker."
msgstr "Desearía aguantar mucho más el alcohol."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=4
#. y4:msg_location=T5.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They have medicine for that, you know.
msgctxt "5964_Kiryu"
msgid "They have medicine for that, you know. You can take it before you drink."
msgstr "Existen medicamentos para eso, ya sabes. Lo puedes tomar antes de beber."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=5
#. y4:msg_location=T5.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They have medicine for that, you know.
msgctxt "5976_Maya"
msgid "I've heard of that. Sort of the same idea as antacid, right? Maybe I'll try it!"
msgstr "Escuche hablar de eso. Es algo similar a los antiácidos, ¿verdad? ¡Tal vez lo pruebe!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=6
#. y4:msg_location=T5.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They have medicine for that, you know.
msgctxt "5988_Kiryu"
msgid "You could also try tomato juice. It helps your body break down alcohol."
msgstr "También deberías probar el jugo de tomate. Eso ayuda a descomponer el alcohol."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=7
#. y4:msg_location=T5.P7
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They have medicine for that, you know.
msgctxt "6000_Maya"
msgid "Wow. You know a lot about this."
msgstr "Vaya. Sabes mucho de estas cosas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=8
#. y4:msg_location=T5.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They have medicine for that, you know.
msgctxt "6012_Kiryu"
msgid "Any serious drinker has to know how to sober up."
msgstr "Cualquier bebedor empedernido debe de saber como recuperar la sobriedad."

msgctxt "6024_Maya"
msgid "A gentleman and a strong drinker. That's just wonderful. <Color:7>♥<Color:Default>"
msgstr "Un caballero y un bebedor fuerte. Esto es simplemente maravilloso. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=10
#. y4:msg_location=T5.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Some people just can't drink.
msgctxt "6036_Kiryu"
msgid "Some people just can't drink. Your body just doesn't break down alcohol as well as other people."
msgstr "Algunas personas simplemente no pueden beber, su cuerpo no descompone el alcohol tan bien como a otras personas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=11
#. y4:msg_location=T5.P11
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Some people just can't drink.
msgctxt "6048_Maya"
msgid "So I'm just stuck like this?"
msgstr "Entonces, ¿estoy atrapada así?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=12
#. y4:msg_location=T5.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Some people just can't drink.
msgctxt "6060_Kiryu"
msgid "You can drink a little bit, right? Why not be satisfied with that?"
msgstr "Puedes beber un poco, ¿no? ¿Por qué no conformarse con eso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=13
#. y4:msg_location=T5.P13
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Some people just can't drink.
msgctxt "6072_Maya"
msgid "It's no fun. I want to be able to drink with my friends."
msgstr "No tiene chiste. Quiero poder beber con mis amigos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=14
#. y4:msg_location=T5.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Some people just can't drink.
msgctxt "6084_Kiryu"
msgid "But there's no real benefit to drinking. It costs money, and you could become addicted if you're not careful."
msgstr "Pero beber no tiene ningún beneficio real. Cuesta dinero y puedes volverte adicta si no tienes cuidado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=15
#. y4:msg_location=T5.P15
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Some people just can't drink.
msgctxt "6096_Maya"
msgid "Yeah, I guess you're right."
msgstr "Sí, supongo que tienes razón."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=16
#. y4:msg_location=T5.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Try drinking more slowly.
msgctxt "6108_Kiryu"
msgid "Try drinking more slowly. That way you can keep drinking for as long as your friends are."
msgstr "Intenta beber más despacio. Con eso podrás beber por más tiempo junto a tus amigos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=17
#. y4:msg_location=T5.P17
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Try drinking more slowly.
msgctxt "6120_Maya"
msgid "Yeah, that's pretty much my only choice."
msgstr "Sí, esa es casi mi única opción."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=18
#. y4:msg_location=T5.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Try drinking more slowly.
msgctxt "6132_Kiryu"
msgid "You just need to know your limits."
msgstr "Solo hay que conocer los límites."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=19
#. y4:msg_location=T5.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Try drinking more slowly.
msgctxt "6144_Kiryu"
msgid "And that's true for strong drinkers, too. Anyone can make the mistake of drinking too much."
msgstr "Y eso también es cierto para los bebedores empedernidos. Cualquiera puede cometer el error de beber demasiado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=20
#. y4:msg_location=T5.P20
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Try drinking more slowly.
msgctxt "6156_Maya"
msgid "I guess you're right. I'd rather drink slowly and enjoy myself than drink a lot and get sick."
msgstr "Supongo que tienes razón. Prefiero beber despacio y disfrutar que beber mucho y caer enferma."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=21
#. y4:msg_location=T5.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Try drinking more slowly.
msgctxt "6168_Kiryu"
msgid "It takes experience to know how to drink, but you'll get it eventually."
msgstr "Hace falta experiencia para saber beber, pero al final lo conseguirás."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=22
#. y4:msg_location=T5.P22
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Try drinking more slowly.
msgctxt "6180_Maya"
msgid "Yes. Thanks for your help!"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=0
#. y4:msg_location=T6.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "6192_Maya"
msgid "My friends get mad at me for saying the same things over and over again."
msgstr "Mis amigos se enojan conmigo por decir las mismas cosas una y otra vez."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=1
#. y4:msg_location=T6.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "6204_Kiryu"
msgid "Oh? Like what?"
msgstr "¿Oh? ¿Como cuales?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=2
#. y4:msg_location=T6.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "6216_Maya"
msgid "Well, today I asked my friend if she had eaten yet, and she said she had a hamburger."
msgstr "Hoy le he preguntado a mi amiga si ya había comido y me ha dicho que había comido una hamburguesa."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=3
#. y4:msg_location=T6.P3
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "6228_Maya"
msgid "Ten minutes later, I was like, \"So, have you eaten yet?\" And she was like, \"I told you, I had a hamburger!\""
msgstr "Diez minutos después, le dije: \"¿Ya comiste algo?\" Y ella me dijo: \"¡Ya te lo dije, me comí una hamburguesa!\""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=4
#. y4:msg_location=T6.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "6240_Kiryu"
msgid "That's pretty bad."
msgstr "Eso es bastante malo."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
