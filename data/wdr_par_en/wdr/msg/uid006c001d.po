#. y4:msg_branch_target_text=You're a little different from the other girls.
#. y4:msg_branch_raw=01 11 00 1e 00 00 00 2f 00 00 00 00 00 00 00 00
msgctxt "4320_Akiyama"
msgid "You're a little different from the other girls."
msgstr "Eres un tanto diferente a las demás chicas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=31
#. y4:msg_location=T0.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "4332_Rio"
msgid "Different? What do you mean?"
msgstr "¿Diferente? ¿A qué te refieres?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=32
#. y4:msg_location=T0.P32
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "4344_Akiyama"
msgid "Well, you're not the kind of girl I'd expect in these establishments."
msgstr "Bueno, no eres el tipo de chica que esperaría en estos establecimientos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "4356_Rio"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=So what do you think now that you're doing it?
msgctxt "4368_Akiyama"
msgid "Yeah."
msgstr "Sí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=35
#. y4:msg_location=T0.P35
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "4380_Rio"
msgid "Oh, hm..."
msgstr "Oh, hm..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=36
#. y4:msg_location=T0.P36
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "4392_Rio"
msgid "Do you think I'm not cut out for this job?"
msgstr "¿Crees que no estoy hecha para este trabajo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=37
#. y4:msg_location=T0.P37
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "4404_Akiyama"
msgid "That's not what I meant."
msgstr "No me refería a eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=38
#. y4:msg_location=T0.P38
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "4416_Rio"
msgid "Oh... It wasn't?"
msgstr "¿Ah, no?"

msgctxt "4428_Rio"
msgid "Akiyama-san! I have some great news! ♪"
msgstr "¡Akiyama-san! ¡Tengo grandes noticias! ♪"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "4440_Akiyama"
msgid "Hm? What's up?"
msgstr "¿Qué pasa?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "4452_Rio"
msgid "I'm gonna be writing a column in a magazine!"
msgstr "¡Voy a tener mi propia sección en una revista!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "4464_Akiyama"
msgid "A magazine? You?"
msgstr "¿Tu propia sección? ¿Solo tú?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "4476_Akiyama"
msgid "Wow, congratulations! That's a pretty big deal."
msgstr "¡Vaya, felicidades! Es una gran noticia."

msgctxt "4488_Rio"
msgid "I know! <Color:7>♥<Color:Default>"
msgstr "¡Lo sé! <Color:7>♥<Color:Default>"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "4500_Akiyama"
msgid "Hehe. So what sort of column is it?"
msgstr "Jeje. Entonces, ¿qué tipo de columna es?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "4512_Rio"
msgid "I'm going to write about different girls each issue. Like, girls from other clubs, I mean."
msgstr "Voy a presentar a varias chicas, de otros locales también."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "4524_Akiyama"
msgid "Other clubs? You mean other hostess clubs?"
msgstr "¿A otras hostess?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "4536_Rio"
msgid "...Maybe."
msgstr "Probablemente..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "4548_Rio"
msgid "But I don't think it has to be just hostesses."
msgstr "Pero creo que también podría mostrar a chicas de otros trabajos."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "4560_Akiyama"
msgid "Huh? Well, who else?"
msgstr "¿Cómo así?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=12
#. y4:msg_location=T1.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "4572_Rio"
msgid "Well, they just said I should profile other girls, so I thought it might be cool to write about girls with all sorts of occupations."
msgstr "Solo dijeron que deben ser chicas. Si muestro de otras ocupaciones también, podría ser interesante, ¿no?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "4584_Akiyama"
msgid "That makes sense. Sounds interesting."
msgstr "Hmm, puede ser interesante."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "4596_Rio"
msgid "Oh! I have to think of a name for my column!"
msgstr "¡Oh! ¡Tengo que ponerle nombre a la sección!"

