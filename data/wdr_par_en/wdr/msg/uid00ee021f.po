#. y4:msg_speaker_id=2
msgctxt "156_Akiyama"
msgid "You can send the bill over to my secretary Hana-chan. Sorry for the trouble."
msgstr "Perdón, pero... ¿podrías cobrarle a Hana-chan de mi parte?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Employee
#. y4:msg_speaker_id=0
