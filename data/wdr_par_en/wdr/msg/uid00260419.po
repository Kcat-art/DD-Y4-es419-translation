msgid "Alps Staff"
msgstr "Empleado de Alps"

#. y4:line_status=translated
msgctxt "1084"
msgid "Kiryu"
msgstr "Kiryu"

#. y4:line_status=translated
msgctxt "56_Alps Staff"
msgid "Welcome."
msgstr "Bienvenido."

#. y4:line_status=translated
msgctxt "68_Kiryu"
msgid "I need to get some curry."
msgstr "Necesito conseguir un poco de curry."

#. y4:line_status=translated
msgctxt "80_Alps Staff"
msgid "Certainly."
msgstr "Ciertamente."

#. y4:line_status=translated
msgctxt "92_Kiryu"
msgid "Can I get it to go?"
msgstr "Puedo pedirlo para llevar?"

#. y4:line_status=translated
msgctxt "104_Alps Staff"
msgid "I'm sorry, sir. We don't currently offer a takeout menu."
msgstr "Lo siento, señor. Actualmente no ofrecemos menú para llevar."

#. y4:line_status=translated
msgctxt "116_Kiryu"
msgid "You don't? All right, thanks anyway."
msgstr "¿No? Está bien, gracias de todos modos."

#. y4:line_status=translated
msgctxt "128_Alps Staff"
msgid "Sorry about that, sir."
msgstr "Perdón por eso, señor."

#. y4:line_status=translated
msgctxt "140_Kiryu"
msgid "(Guess I can't get it here. I better go look someplace else.)"
msgstr "(Supongo que no puedo conseguirlo aquí. Mejor voy a ver en otro lugar.)"

