#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
msgctxt "168"
msgid "You got a copy of <Color:8>Fishing Champ Magazine<Color:Default>."
msgstr "Has obtenido una copia de <Color:8>revista del Campeón de la Pesca<Color:Default>."

#. y4:msg_type=id
#. y4:msg_label=Nombre interno
#. y4:msg_id_index=0
msgctxt "3224"
msgid "Fisherman"
msgstr "Pescador"

#. y4:msg_type=id
#. y4:msg_label=Nombre interno
#. y4:msg_id_index=1
msgctxt "3228"
msgid "Player"
msgstr "Player"

#. y4:msg_type=id
#. y4:msg_label=Nombre interno
