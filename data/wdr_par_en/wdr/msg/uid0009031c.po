#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Arima
#. y4:msg_speaker_id=0
msgctxt "80_Arima"
msgid "Setsuko! What's this I hear about a job hunt!?"
msgstr "¡Setsuko! ¡¿Cómo es eso de que andas buscando trabajo por toda la ciudad?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Arima
#. y4:msg_speaker_id=0
msgctxt "92_Arima"
msgid "What the hell's going on!?"
msgstr "¡¿Qué diablos crees que haces?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Setsuko
#. y4:msg_speaker_id=2
msgctxt "104_Setsuko"
msgid "Well..."
msgstr "Bueno..."

msgctxt "116_Arima"
msgid "Look, don't worry about the company. Shiobara and I were\\r\n"
"just putting the finishing touches on our partnership\\r\n"
"agreement."
msgstr "No tienes que preocuparte por la empresa. Shiobara y yo\\r\n"
"estamos firmando los últimos acuerdos de nuestra\\r\n"
"colaboración."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Shiobara
#. y4:msg_speaker_id=4
msgctxt "128_Shiobara"
msgid "Hello?"
msgstr "¿Hola?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Arima
#. y4:msg_speaker_id=0
msgctxt "152_Arima"
msgid "Shiobara-san! What are you doing here?"
msgstr "¡Shiobara-san! ¿Qué está haciendo aquí?"

msgctxt "164_Shiobara"
msgid "I could ask you the same thing, disappearing in the middle\\r\n"
"of signing our agreement."
msgstr "Podría preguntarle lo mismo, Arima-san. Desapareciste\\r\n"
"en medio de la firma de nuestro acuerdo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Shiobara
#. y4:msg_speaker_id=4
msgctxt "176_Shiobara"
msgid "Oh, I see your wife is here, too. What's going on?"
msgstr "Ah, veo que tu mujer también está aquí. ¿Qué está pasando?"

msgctxt "188_Arima"
msgid "Nothing. Nothing at all. Let's head back and finish up that\\r\n"
"paperwork."
msgstr "Nada, no pasa nada. Regresemos y terminemos con el\\r\n"
"papeleo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Arima
#. y4:msg_speaker_id=0
msgctxt "200_Arima"
msgid "Just don't embarrass me anymore. Got it?"
msgstr "Solo no me vuelvas a avergonzar. ¡¿Entendiste?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=8
msgctxt "212_Akiyama"
msgid "Who's embarrassing whom?"
msgstr "¿Quién está avergonzando a quién?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Shiobara
#. y4:msg_speaker_id=4
msgctxt "236_Shiobara"
msgid "Akiyama-san!"
msgstr "¡Akiyama-san!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Setsuko
#. y4:msg_speaker_id=2
msgctxt "248_Setsuko"
msgid "...!?"
msgstr "¡¿...?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Arima
#. y4:msg_speaker_id=0
msgctxt "260_Arima"
msgid "Why are you here, anyway?"
msgstr "¿Por qué estás aquí?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=8
msgctxt "272_Akiyama"
msgid "I own the place."
msgstr "Este es mi club."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Arima
#. y4:msg_speaker_id=0
msgctxt "284_Arima"
msgid "What!?"
msgstr "¡¿Qué?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Setsuko
#. y4:msg_speaker_id=2
msgctxt "296_Setsuko"
msgid "Oh!"
msgstr "¡Oh!"

msgctxt "308_Akiyama"
msgid "What you do with Shiobara is none of my concern, but this\\r\n"
"lady here is my customer."
msgstr "No es de mi incumbencia lo que hagas con Shiobara,\\r\n"
"pero Setsuko-san es mi cliente."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=8
msgctxt "320_Akiyama"
msgid "Stay out of her way, and let her finish her test!"
msgstr "¡Mantente fuera de su camino y deja que termine su prueba!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Arima
#. y4:msg_speaker_id=0
msgctxt "332_Arima"
msgid "How dare you!"
msgstr "¡¿Cómo dices?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Shiobara
#. y4:msg_speaker_id=4
msgctxt "344_Shiobara"
msgid "Why would you be taking his test?"
msgstr "¿Por qué la propietaria está haciendo una de tus pruebas?"

msgctxt "356_Akiyama"
msgid "You probably haven't realized this yet, but Tenjin Loans\\r\n"
"is... well..."
msgstr "Probablemente no te hayas dado cuenta, pero Préstamos\\r\n"
"Tenjin está..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Arima
#. y4:msg_speaker_id=0
msgctxt "368_Arima"
msgid "Shut up!"
msgstr "¡Cállate!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Arima
#. y4:msg_speaker_id=0
msgctxt "380_Arima"
msgid "C'mon, guys! Get him!"
msgstr "¡Vamos, chicos! ¡A por él!"
