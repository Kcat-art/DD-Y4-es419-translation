#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't remember the first song you learned?
msgctxt "16752_Akiyama"
msgid "You can't remember the first song you learned? Seems like something you should make a note of."
msgstr "¿No puedes recordar la primera canción que aprendiste? Parece algo que deberías haber anotado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=11
#. y4:msg_location=T25.P11
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't remember the first song you learned?
msgctxt "16764_Rio"
msgid "But it's a weird name."
msgstr "Pero es un nombre extraño."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=12
#. y4:msg_location=T25.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't remember the first song you learned?
msgctxt "16776_Akiyama"
msgid "I guess..."
msgstr "Supongo..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=13
#. y4:msg_location=T25.P13
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't remember the first song you learned?
msgctxt "16788_Rio"
msgid "I was excited to tell you, Akiyama-san, but now..."
msgstr "Estaba emocionada por contárselo, Akiyama-san, pero ahora..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=16
#. y4:msg_location=T15.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's the big deal? It's just raw shrimp.
msgctxt "16800_Akiyama"
msgid "Sorry..."
msgstr "Lo siento..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=197
#. y4:msg_phrase=0
#. y4:msg_location=T197.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T25.P15
#. y4:msg_branch_segment=T25.P15..P21
#. y4:msg_branch_target_text=Can you sing and play at the same time?
#. y4:msg_branch_raw=01 11 00 0f 00 00 00 27 00 00 00 00 00 00 00 00
msgctxt "16812_Akiyama"
msgid "Can you sing and play at the same time?"
msgstr "¿Puedes cantar y tocar al mismo tiempo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=16
#. y4:msg_location=T25.P16
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Can you sing and play at the same time?
msgctxt "16824_Rio"
msgid "Yes! You should see me holding the guitar and singing! I'm just like a pro!"
msgstr "¡Sí! ¡Deberías verme sosteniendo la guitarra y cantando! ¡Soy como una profesional!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=17
#. y4:msg_location=T25.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Can you sing and play at the same time?
msgctxt "16836_Akiyama"
msgid "Heh, guess it's time to start planning a camping trip then."
msgstr "Je, supongo que es hora de empezar a planear una acampada."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=18
#. y4:msg_location=T25.P18
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Can you sing and play at the same time?
msgctxt "16848_Rio"
msgid "Hehe! Please, you're just going to make me nervous!"
msgstr "¡Jeje! Por favor, ¡me vas a poner nerviosa!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=19
#. y4:msg_location=T25.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Can you sing and play at the same time?
msgctxt "16860_Akiyama"
msgid "You make one mistake, and the mood gets destroyed."
msgstr "Cometes un solo error y se arruina el ambiente."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=20
#. y4:msg_location=T25.P20
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Can you sing and play at the same time?
msgctxt "16872_Rio"
msgid "That'd be terrible! I have to practice some more first."
msgstr "¡Eso sería terrible! Primero tengo que practicar un poco más."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=21
#. y4:msg_location=T25.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Can you sing and play at the same time?
msgctxt "16884_Akiyama"
msgid "Good plan."
msgstr "Buen plan."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=198
#. y4:msg_phrase=0
#. y4:msg_location=T198.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T25.P22
#. y4:msg_branch_segment=T25.P22..P27
#. y4:msg_branch_target_text=I'd like to hear it sometime.
#. y4:msg_branch_raw=01 11 00 16 00 00 00 1d 00 00 00 00 00 00 00 00
msgctxt "16896_Akiyama"
msgid "I'd like to hear it sometime."
msgstr "Me gustaría escucharla alguna vez."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=23
#. y4:msg_location=T25.P23
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'd like to hear it sometime.
msgctxt "16908_Rio"
msgid "Okay! Oh, but I might get nervous from being watched. I might not play that well..."
msgstr "¡Está bien! Oh, pero puede que me ponga nerviosa si me miran. Tal vez no toque tan bien..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=24
#. y4:msg_location=T25.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'd like to hear it sometime.
msgctxt "16920_Akiyama"
msgid "Then you should practice playing in front of folks. I wouldn't mind helping you with that."
msgstr "Entonces deberías practicar tocando frente a otras personas. No me importaría ayudarte con eso."

msgctxt "16932_Rio"
msgid "Um, Akiyama-san, that's a little... pervy! <Color:7>♥<Color:Default>"
msgstr "Um, Akiyama-san, eso suena un poco... ¡Pervertido! <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=26
#. y4:msg_location=T25.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'd like to hear it sometime.
msgctxt "16944_Akiyama"
msgid "Not at all. I just want to help you improve."
msgstr "Para nada. Solo quiero ayudarte a mejorar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=27
#. y4:msg_location=T25.P27
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'd like to hear it sometime.
msgctxt "16956_Rio"
msgid "Akiyama-san, you silver-tongued devil, you! Hehe!"
msgstr "¡Akiyama-san, tu diablo de lengua plateada! ¡Je, je!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=0
#. y4:msg_location=T26.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16968_Rio"
msgid "So I've got a date tomorrow!"
msgstr "¡Tengo una cita mañana!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=1
#. y4:msg_location=T26.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "16980_Akiyama"
msgid "A... date?"
msgstr "¿Una... cita?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=2
#. y4:msg_location=T26.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16992_Rio"
msgid "Yep! A date with my mom!"
msgstr "¡Sip! ¡Una cita con mi mamá!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=3
#. y4:msg_location=T26.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "17004_Akiyama"
msgid "Oh, that's what you meant! Don't do that to me..."
msgstr "Ah, ¡a eso te referías! No me asustes así..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=4
#. y4:msg_location=T26.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "17016_Rio"
msgid "Hehehe! Scared you, huh?"
msgstr "¡Je, je, je! Te asusté, ¿eh?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=5
#. y4:msg_location=T26.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "17028_Akiyama"
msgid "Heh. So, where are you going?"
msgstr "Je. Entonces, ¿a dónde van a ir?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=6
#. y4:msg_location=T26.P6
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "17040_Rio"
msgid "I thought I'd take her to a play she's been wanting to see for a while."
msgstr "Pensé llevarla a ver una obra que ha querido ver desde hace tiempo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=7
#. y4:msg_location=T26.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "17052_Akiyama"
msgid "Sounds like you and your mom are pretty close. Do you hang out a lot?"
msgstr "Parece que tú y tu mamá son muy cercanas. ¿Pasan mucho tiempo juntas?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=8
#. y4:msg_location=T26.P8
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "17064_Rio"
msgid "Not really."
msgstr "En realidad, no."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=9
#. y4:msg_location=T26.P9
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "17076_Rio"
msgid "Actually, I ran away from home once when I was in high school."
msgstr "En realidad, una vez me escapé de casa cuando estaba en la secundaria."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=10
#. y4:msg_location=T26.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "17088_Akiyama"
msgid "Wow. Why?"
msgstr "Wow. ¿Por qué?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=11
#. y4:msg_location=T26.P11
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "17100_Rio"
msgid "They were forcing me to go to this cram school for civil servant stuff..."
msgstr "Me obligaban a ir a esta academia para cosas de funcionarios públicos..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=12
#. y4:msg_location=T26.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "17112_Akiyama"
msgid "Wait, they have that kind of cram school?"
msgstr "Espera, ¿existen ese tipo de academias?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=13
#. y4:msg_location=T26.P13
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "17124_Rio"
msgid "Yes, and it's not easy."
msgstr "Sí, y no es fácil."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=14
#. y4:msg_location=T26.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "17136_Akiyama"
msgid "Huh. I see..."
msgstr "Hmm… ya veo..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=15
#. y4:msg_location=T26.P15
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "17148_Rio"
msgid "I wanted to go to college instead, though. My mom and I got into a huge fight over it."
msgstr "Pero yo quería ir a la universidad. Mi mamá y yo tuvimos una gran discusión por eso."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=16
#. y4:msg_location=T26.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "17160_Akiyama"
msgid "Then you ran away."
msgstr "Y entonces te escapaste."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
#. y4:msg_phrase=17
#. y4:msg_location=T26.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
