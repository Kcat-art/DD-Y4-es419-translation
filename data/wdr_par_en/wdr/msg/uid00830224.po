#. y4:msg_speaker_id=1
msgctxt "152_Akiyama"
msgid "Hey there. Everything all right?"
msgstr ""

msgctxt "164_Writhing Man"
msgid "Urgh. Ooh. I know there's a one-in-a-million chance of this,\\r\n"
"but do you happen to have any stomach medicine on you? Oh,\\r\n"
"please say yes..."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "188_Writhing Man"
msgid "No, I don't. I'm sorry."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Writhing Man
#. y4:msg_speaker_id=0
msgctxt "200_Writhing Man"
msgid "Oh, I... Okay..."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "212_Writhing Man"
msgid "Oh, you know what? I do!"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Writhing Man
#. y4:msg_speaker_id=0
msgctxt "224_Writhing Man"
msgid "Are you serious!? Oh, thank goodness! Please, can I have it?"
msgstr ""

msgctxt "236_Akiyama"
msgid "I feel bad saying it, but I'm afraid I can't let you have it\\r\n"
"for free. Sorry."
msgstr ""

msgctxt "248_Writhing Man"
msgid "I'll pay! Oh, I'll pay! Before it's too late... Please!\\r\n"
"Quickly! Help, help, help!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Never Mind
msgctxt "260_Akiyama"
msgid "I really am sorry."
msgstr "De verdad que lo siento."

msgctxt "272_Writhing Man"
msgid "Oh, god. I told you I'd pay, didn't I? I'm at the end of my\\r\n"
"rope here!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Never Mind
msgctxt "284_Akiyama"
msgid "(I feel bad for the guy, but there might be a better trade out there with my name on it.)"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "296_Akiyama"
msgid "All right, fine. Take this, then."
msgstr ""

msgctxt "368_Composed Man"
msgid "Aaah... I'm saved. ♥"
msgstr ""

msgctxt "380_Composed Man"
msgid "Sorry you had to see me like that. It wasn't pretty. I mean,\\r\n"
"talk about catching a man at his worst! Heheheh."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=22
#. y4:msg_location=T1.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "392_Akiyama"
msgid "No problem..."
msgstr ""

msgctxt "404_Composed Man"
msgid "Oh, that's right! I must thank you. I forgot myself for a\\r\n"
"moment there."
msgstr ""

msgctxt "416_Composed Man"
msgid "It's a little on the small side. I pray you won't take\\r\n"
"offense."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=25
#. y4:msg_location=T1.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "428_Akiyama"
msgid "Er, do you have anything besides money? Anything will do."
msgstr ""

msgctxt "440_Composed Man"
msgid "Hmm, anything but money? Don't hear that too often. You one\\r\n"
"of those minimalist types or something?"
msgstr ""

msgctxt "452_Composed Man"
msgid "One moment. Let's see what I have here... What can I give\\r\n"
"you...?"
msgstr ""

msgctxt "464_Yoshio Iketeru"
msgid "Oh, I know. Would this do the trick? This is a ballpoint pen\\r\n"
"that popular model Yoshio Iketeru－aka yours truly－\\r\n"
"helped design."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=29
#. y4:msg_location=T1.P29
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Give It to Him
msgctxt "476_Akiyama"
msgid "A pen...?"
msgstr ""

msgctxt "488_Yoshio Iketeru"
msgid "Geez, don't get so excited... This is all I have. Well,\\r\n"
"this, and money."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
