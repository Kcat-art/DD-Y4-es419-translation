#. y4:msg_branch_target_text=So what do you think now that you're doing it?
#. y4:msg_branch_raw=01 11 00 09 00 00 00 2e 00 00 00 00 00 00 00 00
msgctxt "4068_Akiyama"
msgid "So what do you think now that you're doing it?"
msgstr "Entonces, ¿qué piensas ahora que lo estás haciendo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=So what do you think now that you're doing it?
msgctxt "4080_Rio"
msgid "It's tons of fun! I get to talk with so many different people and learn a whole lot!"
msgstr "¡Es muy divertido! ¡Hablo con mucha gente y aprendo muchísimo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
