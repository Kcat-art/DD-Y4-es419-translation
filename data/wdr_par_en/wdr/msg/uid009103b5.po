msgid "Thanks."
msgstr "Gracias."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=26
#. y4:msg_location=T6.P26
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=0
