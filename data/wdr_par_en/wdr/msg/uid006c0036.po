#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I could pick out an outfit for you.
msgctxt "10488_松岡里緒奈：源氏名"
msgid "Well then, what clothes do you think would look good on me?"
msgstr "Entonces, ¿qué ropa crees que me quedaría bien?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
