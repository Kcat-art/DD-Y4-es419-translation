msgctxt "344_Kiryu"
msgid "(Sure, I'll do it for Haruka...)"
msgstr "(Claro, lo haré por Haruka...)"

msgctxt "368_Haruka"
msgid "Uncle Kaz! Hit ten or more targets in a Normal Game! I know you can do it!"
msgstr ""

#. y4:msg_role=decision
#. y4:msg_decision_role=prompt
#. y4:msg_decision_group=0
msgctxt "380_Kiryu"
msgid "(Hit ten or more targets in a normal game... One try is 300 yen. Should I do it?)"
msgstr ""

msgctxt "392_Kiryu"
msgid "Okay, I'll give it a try."
msgstr "De acuerdo, lo intentaré."

msgctxt "404_Haruka"
msgid "Good luck, Uncle Kaz!"
msgstr "¡Buena suerte, Tío Kaz!"

msgctxt "428_Kiryu"
msgid "(Not right now.)"
msgstr "(Ahora no)."

msgctxt "440_Haruka"
msgid "Aww, I really wanted to see you do it..."
msgstr ""

msgctxt "452_Kiryu"
msgid "(Wish I had enough money to play... 300 yen shouldn't be too hard to come by, though.)"
msgstr ""

msgctxt "464_Haruka"
msgid "Aww, c'mon..."
msgstr ""

msgctxt "476_Kiryu"
msgid "Press <Action:Button_Cross@Battingcenter> at the right time to hit the balls pitched by the pitching machine. Hit the home run targets to earn points."
msgstr "Prensa <Action:Button_Cross@Battingcenter> en el momento adecuado para golpear las bolas lanzadas por la máquina de lanzar. Golpea los objetivos de jonrones para ganar puntos."

msgctxt "488_Kiryu"
msgid "There are five targets in the Normal Game. Each target will grant the same number of points, but once a target is hit, it will not be restored until all the remaining targets are also hit."
msgstr ""

msgctxt "500_Kiryu"
msgid "Use <Action:Button_LS_Up@Battingcenter><Action:Button_LS_Down@Battingcenter><Action:Button_LS_Left@Battingcenter><Action:Button_LS_Right@Battingcenter> to aim your swing. If you aim well enough, you can hit three targets at once and earn three times the points."
msgstr ""

msgctxt "512_Kiryu"
msgid "Once you hit all the targets, a bonus target will appear. However, you only get one chance to hit it. The bonus target disappears after one pitch, whether you hit it or not. Aim carefully and go for a new high score!"
msgstr ""

