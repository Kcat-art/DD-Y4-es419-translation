#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=We should go out for all-you-can-eat yakiniku.
msgctxt "6744_Kiryu"
msgid "Hey, I can't solve all your problems."
msgstr "Oye, no puedo resolver todos tus problemas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
