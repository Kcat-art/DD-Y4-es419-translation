#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Surly Homeless Man
#. y4:msg_speaker_id=0
msgctxt "72_Surly Homeless Man"
msgid "That hurt, dammit!"
msgstr "¡Eso dolió, maldita sea!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Friendly Homeless Man
#. y4:msg_speaker_id=2
msgctxt "84_Friendly Homeless Man"
msgid "Ouch... You could've gone a little easier on us, you know."
msgstr "Ouch... Podrías haber sido un poco más gentil con nosotros, sabes."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "120_Cat-loving Homeless Man"
msgid "Hey, pal!"
msgstr "¡Oye, amigo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "132_Cat-loving Homeless Man"
msgid "What are you guys doing here?"
msgstr "¿Qué hacen ustedes aquí?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Surly Homeless Man
#. y4:msg_speaker_id=0
msgctxt "144_Surly Homeless Man"
msgid "Bah!"
msgstr "¡Bah!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Friendly Homeless Man
#. y4:msg_speaker_id=2
msgctxt "156_Friendly Homeless Man"
msgid "What a hypocrite! You're after the treasure too, aren't you?"
msgstr "¡Qué hipócrita! También has venido por el tesoro, ¿no?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "168_Cat-loving Homeless Man"
msgid "What treasure? Is this about those notes?"
msgstr "¿Cuál tesoro? ¿Hablas de las notas?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "180_Cat-loving Homeless Man"
msgid "Are you two seriously trying to mug our friend here?"
msgstr "¿De verdad están tratando de robar a nuestro amigo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Striped Kitten
#. y4:msg_speaker_id=6
msgctxt "204_Striped Kitten"
msgid "Ffft!"
msgstr "¡Ffft!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Striped Kitten
#. y4:msg_speaker_id=6
msgctxt "216_White Kitten"
msgid "Ffft!"
msgstr "¡Ffft!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Surly Homeless Man
#. y4:msg_speaker_id=0
msgctxt "228_Surly Homeless Man"
msgid "Shit!"
msgstr "¡Mierda!"

#. y4:line_status=translated
msgctxt "240_Saejima"
msgid "Well, it kinda does belong to the cats ya saved.\\r\nI can see why you'd be interested."
msgstr "Bueno, de cierto modo le pertenece a los gatos que salvaron.\\r\nPuedo entender el porqué están interesados."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "252_Saejima"
msgid "How 'bout we open it right now, together?"
msgstr "¿Qué tal si lo abrimos ahora, juntos?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Friendly Homeless Man
#. y4:msg_speaker_id=2
msgctxt "264_Friendly Homeless Man"
msgid "Now, there's a fine idea!"
msgstr "¡Qué buena idea!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "276_Cat-loving Homeless Man"
msgid "Are you sure about this, pal?"
msgstr "¿Estás seguro de esto, amigo?"

#. y4:line_status=translated
msgctxt "288_Saejima"
msgid "They won't be satisfied till they see what's inside.\\r\nGimme a sec."
msgstr "No van a estar satisfechos hasta que vean lo que hay dentro.\\r\nDenme un segundo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "324_Saejima"
msgid "What is this? A stuffed toy?"
msgstr "¿Qué es esto? ¿Un peluche?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Surly Homeless Man
#. y4:msg_speaker_id=0
msgctxt "336_Surly Homeless Man"
msgid "A what? That's impossible!"
msgstr "¿Un qué? ¡Imposible!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Friendly Homeless Man
#. y4:msg_speaker_id=2
msgctxt "348_Friendly Homeless Man"
msgid "Is that the best lie you could come up with? You're bullshitting us, trying to keep the real treasure for yourself. Admit it!"
msgstr "¿Esa es la mejor mentira que te pudiste inventar? No estás tomando por tontos, tratando de quedarte con el tesoro real para ti. ¡Admítelo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "360_Saejima"
msgid "I ain't lyin'. See for yourself."
msgstr "No estoy mintiendo. Míralo por ti mismo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Friendly Homeless Man
#. y4:msg_speaker_id=2
msgctxt "384_Friendly Homeless Man"
msgid "All right, lemme see... Huh. It really is a stuffed toy."
msgstr "Vale, vamos a ver... eh. De verdad solo es un peluche."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Surly Homeless Man
#. y4:msg_speaker_id=0
msgctxt "396_Surly Homeless Man"
msgid "Still, you must be keeping something from us!"
msgstr "¡Aun así, seguro que estás ocultándonos algo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "408_Saejima"
msgid "Not a thing. Besides, I ain't had the chance to hide anything."
msgstr "Para nada. Además, no tuve oportunidad de esconderles nada."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Surly Homeless Man
#. y4:msg_speaker_id=0
msgctxt "420_Surly Homeless Man"
msgid "What a monumental waste of time."
msgstr "Qué tremenda perdida de tiempo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "432_Saejima"
msgid "Ya don't want it?"
msgstr "¿No lo quieres?"

#. y4:line_status=translated
msgctxt "444_Surly Homeless Man"
msgid "That junk's worth squat. If I knew that was the \"treasure,\"\\r\nI would've stayed put and just kept drinking."
msgstr "Esa basura no vale nada. Si hubiera sabido que eso era el \"tesoro,\"\\r\nmejor me hubiera quedado bebiendo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=32
#. y4:msg_location=T0.P32
#. y4:msg_speaker=Friendly Homeless Man
#. y4:msg_speaker_id=2
msgctxt "456_Friendly Homeless Man"
msgid "Too bad. We really thought we were onto something big."
msgstr "Qué mal. De verdad pensamos que era algo grande."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "468_Cat-loving Homeless Man"
msgid "I wonder if this plush was meant for the cats?"
msgstr "¿Me pregunto si este peluche era para los gatos?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=34
#. y4:msg_location=T0.P34
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "480_Saejima"
msgid "Who knows? Maybe."
msgstr "¿Quién sabe? Tal vez."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=35
#. y4:msg_location=T0.P35
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "492_Cat-loving Homeless Man"
msgid "Why would anybody go to such trouble to hide a toy... Huh?"
msgstr "¿Por qué alguien se esforzaría tanto por esconder un peluche... eh?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=36
#. y4:msg_location=T0.P36
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "504_Saejima"
msgid "What?"
msgstr "¿Qué?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=37
#. y4:msg_location=T0.P37
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "516_Cat-loving Homeless Man"
msgid "I thought I saw the plush twinkle."
msgstr "Creo que vi al peluche brillar."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=38
#. y4:msg_location=T0.P38
#. y4:msg_speaker=Striped Kitten
#. y4:msg_speaker_id=6
msgctxt "528_Striped Kitten"
msgid "Mrowr."
msgstr "Miauh."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=39
#. y4:msg_location=T0.P39
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "540_Cat-loving Homeless Man"
msgid "You want us to take a look?"
msgstr "¿Quieren que le echemos un vistazo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=40
#. y4:msg_location=T0.P40
#. y4:msg_speaker=Striped Kitten
#. y4:msg_speaker_id=6
msgctxt "552_Striped Kitten"
msgid "Prowrl..."
msgstr "Ñaau..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=41
#. y4:msg_location=T0.P41
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "564_Cat-loving Homeless Man"
msgid "Let's see here... Oh, what's this?"
msgstr "Veamos qué hay aquí... Oh, ¿qué es esto?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=42
#. y4:msg_location=T0.P42
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "576_Cat-loving Homeless Man"
msgid "Hey! Isn't this a key for one of the lockers in the underground mall?"
msgstr "¡Oye! ¿Acaso esta llave no es para una de esas taquillas en el centro comercial subterráneo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=45
#. y4:msg_location=T0.P45
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "612_Saejima"
msgid "Looks that way."
msgstr "Así parece."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=46
#. y4:msg_location=T0.P46
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "624_Cat-loving Homeless Man"
msgid "Ah, so that's where the real treasure is. Great news, huh, pal?"
msgstr "Ah, así que ahí es donde está el verdadero tesoro. Grandes noticias, ¿eh, amigo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "636_Saejima"
msgid "Ya don't want it?"
msgstr "¿No lo quieres?"

#. y4:line_status=translated
msgctxt "648_Cat-loving Homeless Man"
msgid "Just having these handsome boys around is all I need!\\r\nIsn't that right?"
msgstr "Lo único que necesito es a estos hermosos gatitos cerca\\r\n¿No es así?"

#. y4:line_status=todo
#. y4:msg_type=dialogue
