#. y4:msg_speaker_id=0
msgctxt "5940_望月京子：源氏名"
msgid "That's probably why scary looking customers tend to like me. You know, yakuza guys."
msgstr "Quizás esa es la razón por la que chicos más imponentes les gusto más. Ya sabes, a los yakuzas."

#. y4:msg_type=pre_context
