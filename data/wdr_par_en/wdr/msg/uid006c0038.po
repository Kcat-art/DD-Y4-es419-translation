#. y4:msg_location=T1.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "4500_Kiryu"
msgid "So that's what got you interested in music?"
msgstr "¿Así que de ahí viene tus intereses por la música?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
