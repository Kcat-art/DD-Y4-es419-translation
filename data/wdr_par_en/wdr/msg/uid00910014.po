#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Check Investigation
msgctxt "4916_Tanimura"
msgid "[So he's looking to scare the surrounding organizations into submission. Clever.]"
msgstr "[Entonces lo que busca es asustar a las organizaciones cercanas\npara someterlas. Qué astuto.]"

#. y4:line_status=translated
