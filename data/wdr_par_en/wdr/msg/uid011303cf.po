#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Something Comical
msgctxt "2724_Saejima"
msgid "(Guess that went okay.)"
msgstr "(Supongo que salió bien)."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=70
#. y4:msg_location=T1.P70
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2736_Saejima"
msgid "Heheh... That mask is startin' to look better on ya."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=71
#. y4:msg_location=T1.P71
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2748_Ehama"
msgid "Yes, I'm starting to feel like a hero when I wear it. Masks are actually pretty cool like that."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=72
#. y4:msg_location=T1.P72
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2760_Ehama"
msgid "If I win that tournament and become a champion..."
msgstr ""

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=1
#. y4:msg_phrase=73
