msgctxt "56_Tanimura"
msgid "Hey, I think I found it."
msgstr ""

#. y4:line_status=todo
msgctxt "68_Hisai"
msgid "You did...?"
msgstr ""

#. y4:line_status=todo
msgctxt "212_Tanimura"
msgid "(This report is missing something... just like Katsuragi said. According to him, he should be the one listed as the killer. But all that's here is the part Saejima played.)"
msgstr ""

#. y4:line_status=todo
msgctxt "248_Tanimura"
msgid "(Dad... and Sugiuchi? They worked the case together?)"
msgstr ""

#. y4:line_status=todo
msgctxt "260_Tanimura"
msgid "(Why haven't I heard this before? What the hell's going on?)"
msgstr ""

#. y4:line_status=translated
msgctxt "320_Tanimura"
msgid "Huh..."
msgstr "Huh..."

#. y4:line_status=todo
msgctxt "332_Hisai"
msgid "What did you find out?"
msgstr ""

#. y4:line_status=todo
msgctxt "344_Tanimura"
msgid "More than I expected."
msgstr ""

#. y4:line_status=translated
