#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=A strong-willed woman.
msgctxt "5136_Chihiro"
msgid "\"Down that drink right now, you lowly worm!\""
msgstr "\"¡Toma esa bebida ahora mismo, miserable gusano!\""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
