msgctxt "726\t789"
msgid "Welcome to your new home."
msgstr "A partir de hoy, esta es tu celda."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "801\t842"
msgid "Get in."
msgstr "Entra."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1016\t1076"
msgid "Hands out."
msgstr "Las esposas."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1292\t1463"
msgid "Dinner's at 1700. All other rules\\nare in the papers we've provided for you."
msgstr "La cena es las cinco de la tarde. En cuando a las normas,\\nestán detalladas en los documentos que te dieron."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1478\t1586"
msgid "You should know, this isn't your average prison."
msgstr "Te advierto que esta prisión no es como las demás."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1590\t1711"
msgid "If you want to relish the final\\nscraps of life before your execution..."
msgstr "Si quieres vivir aunque sea un poco más\\nantes de que llegue tu ejecución..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1713\t1812"
msgid "Keep your head down and follow orders."
msgstr "será mejor que no llames la atención."

