#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=If you're not sure, you shouldn't do it.
msgctxt "8976_松岡里緒奈：源氏名"
msgid "Oh, is that jealousy I'm hearing?"
msgstr "Oh, ¿son esos celos los que estoy escuchando?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=11
#. y4:msg_location=T13.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=If you're not sure, you shouldn't do it.
msgctxt "8988_Kiryu"
msgid "It's not that. Going out with the popular guy can make things... complicated."
msgstr "No es eso. Salir con el chico popular puede hacer las cosas... complicadas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
