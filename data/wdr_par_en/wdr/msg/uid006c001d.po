#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6852_Rio"
msgid "I'm not gonna take it easy on you. You still wanna do it?"
msgstr "No esperes que me contenga. ¿En serio lo quieres intentar?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
