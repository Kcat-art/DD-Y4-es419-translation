#. y4:msg_speaker_id=0
msgctxt "4080_Noa"
msgid "Are you on your way home from work today?"
msgstr "¿Estaba de camino a casa? De seguro salía del trabajo..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
