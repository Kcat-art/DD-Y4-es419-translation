#. y4:msg_branch_target=T5.P7
#. y4:msg_branch_segment=T5.P7..P14
#. y4:msg_branch_target_text=Even if it's not true?
#. y4:msg_branch_raw=01 11 00 07 00 00 00 16 00 00 00 00 00 00 00 00
msgctxt "6420_Akiyama"
msgid "Even if it's not true?"
msgstr "¿Aunque no sea cierto?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=8
#. y4:msg_location=T5.P8
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Even if it's not true?
msgctxt "6432_Erena"
msgid "I'm too stupid to be able to tell when somebody's lyin' to me anyway."
msgstr "Soy demasiado estúpida para darme cuenta de cuándo alguien me está mintiendo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=9
#. y4:msg_location=T5.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Even if it's not true?
msgctxt "6444_Akiyama"
msgid "Heheh. Stupid people don't say they're stupid."
msgstr "Je, je, je. La gente estúpida no dice abiertamente que lo es."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=27
#. y4:msg_location=T2.P27
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I think you've got it wrong.
msgctxt "6456_Erena"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=11
#. y4:msg_location=T5.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Even if it's not true?
msgctxt "6468_Akiyama"
msgid "Sure. They're too stupid to know it."
msgstr "Claro. Son demasiado estúpidos para saberlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=12
#. y4:msg_location=T5.P12
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Even if it's not true?
msgctxt "6480_Erena"
msgid "Haha! Maybe I'm not stupid after all."
msgstr "¡Ja, ja! Quizás no soy estúpida después de todo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=13
#. y4:msg_location=T5.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Even if it's not true?
msgctxt "6492_Akiyama"
msgid "Wait, you just noticed that? Maybe I should take back what I just said."
msgstr "Espera, ¿te diste cuenta? Tal vez debería retirar lo dicho."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=14
#. y4:msg_location=T5.P14
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Even if it's not true?
msgctxt "6504_Erena"
msgid "Hey! That's not fair!"
msgstr "Ey, ¡eso no es justo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=15
#. y4:msg_location=T5.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'm no fan of empty flattery.
msgctxt "6516_Akiyama"
msgid "I'm no fan of empty flattery. It's just embarrassing."
msgstr "No soy fanático de los halagos vacíos. Es simplemente vergonzoso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=16
#. y4:msg_location=T5.P16
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'm no fan of empty flattery.
msgctxt "6528_Erena"
msgid "Really? Don't let me down!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=17
#. y4:msg_location=T5.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'm no fan of empty flattery.
msgctxt "6540_Akiyama"
msgid "I haven't exactly lived a perfect life, so when I hear it, I always think they have an ulterior motive."
msgstr "No he vivido exactamente una vida perfecta que digamos, así que cuando los escucho, siempre pienso que vienen con alguna segunda intención detrás."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=18
#. y4:msg_location=T5.P18
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'm no fan of empty flattery.
msgctxt "6552_Erena"
msgid "That's not true. Yer a great guy!"
msgstr "Eso no es cierto. ¡Eres un buen chico!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=19
#. y4:msg_location=T5.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'm no fan of empty flattery.
msgctxt "6564_Akiyama"
msgid "Even if I am, the people flattering me can't tell that just by looking at me, can they? They don't know what kind of life I've led."
msgstr "Incluso si lo soy, las personas que simplemente me halagan no pueden saberlo con tan solo mirarme, ¿no es así? No saben qué tipo de vida he llevado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=20
#. y4:msg_location=T5.P20
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'm no fan of empty flattery.
msgctxt "6576_Akiyama"
msgid "That's particularly true in Kamurocho. You never know what people are up to around here."
msgstr "Eso es algo particularmente cierto en Kamurocho. Nunca se sabe lo que la gente está tramando por aquí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=21
#. y4:msg_location=T5.P21
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'm no fan of empty flattery.
msgctxt "6588_Erena"
msgid "Really? That's pretty scary..."
msgstr "¿En serio? Eso es bastante aterrador..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=22
#. y4:msg_location=T5.P22
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'm no fan of empty flattery.
msgctxt "6600_Erena"
msgid "Tokyo can be kind of intimidatin'."
msgstr "Tokio puede ser un poco intimidante."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=138
#. y4:msg_phrase=0
#. y4:msg_location=T138.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T5.P23
#. y4:msg_branch_segment=T5.P23..P29
#. y4:msg_branch_target_text=Yep, you sure are pretty.
#. y4:msg_branch_raw=01 11 00 17 00 00 00 19 00 00 00 00 00 00 00 00
msgctxt "6612_Akiyama"
msgid "Yep, you sure are pretty."
msgstr "Sip, tu realmente eres guapa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=24
#. y4:msg_location=T5.P24
