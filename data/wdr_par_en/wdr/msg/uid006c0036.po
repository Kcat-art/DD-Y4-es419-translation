#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Maybe you should stop drinking.
msgctxt "7080_Kiryu"
msgid "Why not start today? You're not really going to quit, right?"
msgstr "¿Por qué no empezar hoy mismo? Realmente no vas a dejarlo, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=12
