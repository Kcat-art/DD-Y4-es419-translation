#. y4:msg_location=T4.P0
#. y4:msg_speaker=Friendly Homeless Man
#. y4:msg_speaker_id=5
msgctxt "1264_Friendly Homeless Man"
msgid "Here, kitty-kitty! We got some fish for you!"
msgstr "¡Gatito, gatito! ¡Toma un poco de pescado!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
