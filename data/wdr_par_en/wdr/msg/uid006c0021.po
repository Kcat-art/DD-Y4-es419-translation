#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's with young girls these days?
msgctxt "4980_Akiyama"
msgid "I heard you. What about it?"
msgstr "Sí. ¿Y qué tiene?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=34
#. y4:msg_location=T1.P34
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's with young girls these days?
msgctxt "4992_Erena"
msgid "Well, you're gonna have to try harder if ya want me to leave him for you."
msgstr "Bueno, vas a tener que esforzarte más si quieres que lo deje por ti."

