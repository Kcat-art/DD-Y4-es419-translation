#. y4:msg_decision_choices=1. Go to the Arena -> T1.P5 | 2. I need to prepare some more. -> T1.P10
msgctxt "728_Man"
msgid "Now then, is everybody ready to depart?"
msgstr "Ahora, ¿está todo el mundo preparado para salir?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
