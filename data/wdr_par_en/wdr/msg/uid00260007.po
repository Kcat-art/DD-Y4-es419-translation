#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Distinguished Homeless Man
#. y4:msg_speaker_id=0
msgctxt "88_Distinguished Homeless Man"
msgid "Amazing work, kid. You got them all."
msgstr "Un trabajo increíble, chico. Los atrapaste a todos."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "100_Tanimura"
msgid "Time for you to live up to your end of the bargain."
msgstr "Es hora de que cumplas con tu parte del trato."

#. y4:line_status=translated
msgctxt "112_Distinguished Homeless Man"
msgid "Of course. And we've prepared a little bonus for you\\r\nas well."
msgstr "Claro. Y hemos preparado un pequeño bono para ti\\r\ntambién."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Scowling Homeless Man
#. y4:msg_speaker_id=5
msgctxt "124_Scowling Homeless Man"
msgid "Here, take this to your friend who was stupid enough to put up his restaurant for collateral."
msgstr "Toma, llévale esto a tu amigo que fue lo suficientemente estúpido\\r\ncomo para poner su restaurante como garantía."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "160_Tanimura"
msgid "How did you know about that!?"
msgstr "¡¿Cómo te enteraste de eso?!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Groomed Homeless Man
#. y4:msg_speaker_id=7
msgctxt "172_Groomed Homeless Man"
msgid "Don't underestimate us just because we're homeless. We have eyes and ears across this whole city."
msgstr "No nos subestimes solo porque no tenemos hogar.\\r\nTenemos ojos y oídos en toda esta ciudad."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "184_Tanimura"
msgid "Apparently! But are you really sure about this? It's a lot of money."
msgstr "¡Y ya me doy cuenta! Pero, ¿estás realmente seguro de esto?\\r\nEs mucho dinero."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Distinguished Homeless Man
#. y4:msg_speaker_id=0
msgctxt "196_Distinguished Homeless Man"
msgid "No worries. If those three had gotten away, we would've lost a great deal more."
msgstr "No te preocupes. Si esos tres se hubieran escapado,\\r\nhabríamos perdido mucho más."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "208_Tanimura"
msgid "All right. I feel like I owe you one now, but thank you very much."
msgstr "Muy bien. Siento que les debo una ahora, pero muchas gracias."

#. y4:line_status=translated
msgctxt "220_Groomed Homeless Man"
msgid "And you're welcome at the Palace anytime, too!\\r\nSwing on by sometime!"
msgstr "¡Y también eres bienvenido en el Palacio en cualquier momento!\\r\n¡Pásate por aquí alguna vez!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "232_Tanimura"
msgid "Thanks, will do."
msgstr "Gracias, lo haré."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Distinguished Homeless Man
#. y4:msg_speaker_id=0
msgctxt "256_Distinguished Homeless Man"
msgid "Looking good, kid! You're almost there!"
msgstr "¡Vas muy bien, niño! ¡Ya casi estás!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "268_Tanimura"
msgid "(One more to go, huh?)"
msgstr "(Solo falta uno, ¿eh?)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Distinguished Homeless Man
#. y4:msg_speaker_id=0
msgctxt "328_Distinguished Homeless Man"
msgid "Hey, you got one! Keep up the good work!"
msgstr "¡Oye, atrapaste a uno! ¡Sigue con el buen trabajo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "340_Tanimura"
msgid "(One down, two to go...)"
msgstr "(Uno menos, solo quedan dos...)"
