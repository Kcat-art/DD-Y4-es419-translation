msgctxt "12624_Erena"
msgid "I'm afraid it'll just be the same if I get involved with somebody else."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=7
#. y4:msg_location=T22.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't worry about what the other person thinks.
msgctxt "12636_Akiyama"
msgid "Don't worry about what the other person thinks. You should just be yourself."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=8
#. y4:msg_location=T22.P8
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't worry about what the other person thinks.
msgctxt "12648_Erena"
msgid "That's easy to say, but I always end up wantin' to change myself to please whoever I'm seeing."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=9
#. y4:msg_location=T22.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't worry about what the other person thinks.
msgctxt "12660_Akiyama"
msgid "That might be okay to some degree, but I think you take it a little too far."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=10
#. y4:msg_location=T22.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't worry about what the other person thinks.
msgctxt "12672_Akiyama"
msgid "If he doesn't like you for who you really are, you're never going to have a real future."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=11
#. y4:msg_location=T22.P11
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't worry about what the other person thinks.
msgctxt "12684_Erena"
msgid "Ya think so? I've never been in a long-term relationship, so I don't know."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=12
#. y4:msg_location=T22.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't worry about what the other person thinks.
msgctxt "12696_Akiyama"
msgid "Then why don't you give it a try next time?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=13
#. y4:msg_location=T22.P13
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't worry about what the other person thinks.
msgctxt "12708_Erena"
msgid "Alright. I think I will."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=14
#. y4:msg_location=T22.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So what are you saying?
msgctxt "12720_Akiyama"
msgid "So what are you saying? You plan to be alone for the rest of your life?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=15
#. y4:msg_location=T22.P15
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So what are you saying?
msgctxt "12732_Erena"
msgid "Right now that don't sound so bad."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=16
#. y4:msg_location=T22.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So what are you saying?
msgctxt "12744_Akiyama"
msgid "Seriously?"
msgstr "¿En serio?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=17
#. y4:msg_location=T22.P17
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So what are you saying?
msgctxt "12756_Erena"
msgid "I'm just so sick of it all. Maybe I should just stick to relationships like the ones I got with my customers here. It's not as tiring."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=18
#. y4:msg_location=T22.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So what are you saying?
msgctxt "12768_Akiyama"
msgid "Look, you're a little down right now, but I know you're going to want to have another relationship sooner or later. Cheer up."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=19
#. y4:msg_location=T22.P19
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=So what are you saying?
msgctxt "12780_Erena"
msgid "Maybe you're right, but I don't really want to talk about it right now. Sorry, but do you mind if we change the subject?"
msgstr ""

