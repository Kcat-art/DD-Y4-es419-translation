msgctxt "5060_Tanimura"
msgid "[A weapons buyer I arrested in Kamurocho was apparently doing work for GG.]"
msgstr "[Detuve a un comprador de armas en Kamurocho, aparentemente\nestaba trabajando para GG.]"

#. y4:line_status=translated
