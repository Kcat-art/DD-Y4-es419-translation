#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "308_Kiryu"
msgid "No..."
msgstr "No..."
