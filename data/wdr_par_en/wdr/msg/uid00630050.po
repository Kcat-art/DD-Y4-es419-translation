#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd rather not.
msgctxt "352_Maya"
msgid "Huh? Seriously? You're no fun..."
msgstr "¿Eh? ¿En serio? No eres divertido..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
