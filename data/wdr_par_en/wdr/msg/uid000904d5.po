#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=3
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I need to prepare some more.
msgctxt "320_Akiyama"
msgid "Whoops, looks like I forgot something, too. I'll just go and grab it."
msgstr "Vaya, parece que olvidé algo. Iré a agarrarlo."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
