#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a good idea.
msgctxt "11868_松岡里緒奈：源氏名"
msgid "Yes, but... I'm kinda afraid... He can be pretty scary."
msgstr "Sí, pero... Tengo un poco de miedo... El puede ser un poco aterrador."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
