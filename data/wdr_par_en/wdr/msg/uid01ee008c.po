#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Haruka
#. y4:msg_speaker_id=0
msgctxt "280_Haruka"
msgid "What took you so long, Uncle Kaz? I got tired of waiting..."
msgstr "¿Por qué demoraste tanto, tío Kaz? Me cansé de esperar..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Lily
#. y4:msg_speaker_id=2
msgctxt "304_Haruka"
msgid "Oh, you're back, Akiyama-san. Shall we go, then?"
msgstr "Ah, ahí estás, Akiyama-san. ¿Vamos?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Yasuko
#. y4:msg_speaker_id=4
msgctxt "316_Haruka"
msgid "Oh, Kiryu-san, I've been waiting for you. Shall we go, then?"
msgstr "Ah, Kiryu-san, te estaba esperando. ¿Nos vamos?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=5
msgctxt "352_Tanimura"
msgid "(This is no time to be making detours. They took Zhao-san somewhere off Senryo Avenue.)"
msgstr "(No es momento de tomar desvíos. Se llevaron a Zhao-san para algún lugar fuera de la avenida Senryo)."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=6
msgctxt "376_Saejima"
msgid "(Karaoke used to be in bars, but looks like there's places that specialize in it...)"
msgstr "(El karaoke solía estar en bares, pero parece que ahora hay lugares dedicados a ello...)."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=6
msgctxt "388_Saejima"
msgid "(Singin' just ain't my thing...)"
msgstr "(Cantar simplemente no es mi cosa...)."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=0
#. y4:msg_location=T3.P0
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=6
msgctxt "424_Saejima"
msgid "(A karaoke place, huh? Singin' just ain't my thing...)"
msgstr "(¿Un lugar de karaoke, eh? Cantar simplemente no es mi cosa...)."

