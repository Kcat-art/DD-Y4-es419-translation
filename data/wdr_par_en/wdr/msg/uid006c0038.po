#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe I could sing a song...
msgctxt "12132_望月京子：源氏名"
msgid "Huh!? You want to sing, Kiryu-san?"
msgstr "¡¿Eh?! ¿Quieres cantar, Kiryu-san?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=26
#. y4:msg_location=T21.P26
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe I could sing a song...
msgctxt "12144_Kiryu"
msgid "Sure. You don't get the chance to sing a song on stage every day."
msgstr "Claro. No siempre se tiene la oportunidad de cantar en un escenario."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=27
#. y4:msg_location=T21.P27
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Maybe I could sing a song...
msgctxt "12156_望月京子：源氏名"
msgid "Hey, this isn't karaoke! Don't be ridiculous!"
msgstr "¡Ey, esto no es un karaoke! ¡No seas tonto!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=28
