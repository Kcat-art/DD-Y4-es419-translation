msgctxt "104_Ihara"
msgid "Where's the hundred bottles of champagne we ordered!?\\r\nIt's been ten minutes already!"
msgstr "¡¿Dónde están las cien botellas de champán que ordenamos?!\n¡Ya pasaron diez minutos!"

#. y4:line_status=reviewed
