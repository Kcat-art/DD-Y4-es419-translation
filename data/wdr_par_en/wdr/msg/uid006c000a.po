#. y4:msg_location=T9.P4
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "7668_Chihiro"
msgid "Ready? Watch my eyebrows! First the right one..."
msgstr "¿Preparado? ¡Mira mis cejas! Primero el de la derecha..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
