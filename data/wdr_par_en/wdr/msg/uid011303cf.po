#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2268_Saejima"
msgid "If yer family is that important to ya... How's about tryin' to get 'em back?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=32
#. y4:msg_location=T1.P32
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
