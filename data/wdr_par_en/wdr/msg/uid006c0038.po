#. y4:msg_speaker_id=0
msgctxt "4452_望月京子：源氏名"
msgid "Looking back on it now, I can see how stupid I was. But it was fun at the time."
msgstr "Mirándolo bien ahora, que tontita era jejeje. Fue una época divertida en su día."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
