#. y4:msg_branch_target=T2.P9
#. y4:msg_branch_segment=T2.P9..P17
#. y4:msg_branch_target_text=I never would've guessed you felt that way. You sound like a guy.
#. y4:msg_branch_raw=01 11 00 09 00 00 00 15 00 00 00 00 00 00 00 00
msgctxt "14388_Akiyama"
msgid "You sound like a guy."
msgstr "Suenas como un chico..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=9
#. y4:msg_location=T29.P9
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's good news for guys who want to date you.
msgctxt "14400_Noa"
msgid "But that's the kind of girl you like, right?"
msgstr "Pero ese es el tipo de chica que te gusta, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=10
#. y4:msg_location=T29.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's good news for guys who want to date you.
msgctxt "14412_Akiyama"
msgid "I suppose. I certainly couldn't go out with somebody who doesn't like ramen."
msgstr "Supongo que sí. Ciertamente, no podría salir con alguien a quien no le gusta el ramen."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=29
#. y4:msg_phrase=11
#. y4:msg_location=T29.P11
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's good news for guys who want to date you.
msgctxt "14424_Noa"
msgid "Haha! You don't have to worry about that with me!"
msgstr "¡Jaja! ¡No tiene que preocuparse por eso conmigo!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=29
#. y4:msg_section_label=Conversación 29
#. y4:msg_talk=209
#. y4:msg_phrase=0
#. y4:msg_location=T209.P0
#. y4:msg_choice_index=2
