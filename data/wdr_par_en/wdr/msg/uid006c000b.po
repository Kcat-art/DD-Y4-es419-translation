#. y4:msg_decision_group=2
#. y4:msg_decision_choices=1. Just call me if something happens. -> T2.P23 | 2. You have to tell it to them straight. -> T2.P30 | 3. Maybe you should learn self defense. -> T2.P42
msgctxt "5040_Himeka"
msgid "How can I let 'em know without burnin' their butts?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=23
#. y4:msg_location=T2.P23
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Just call me if something happens.
msgctxt "5052_Tanimura"
msgid "Just call me if something happens. I'll drop whatever I'm doing and come help."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=24
#. y4:msg_location=T2.P24
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Just call me if something happens.
msgctxt "5064_Himeka"
msgid "But, Tanimura-san... Ain't that gonna be an inconvenience for you?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=25
#. y4:msg_location=T2.P25
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Just call me if something happens.
msgctxt "5076_Tanimura"
msgid "It's fine. After all, protecting the public is my job."
msgstr ""

msgctxt "5088_Himeka"
msgid "Wow, really? That's a huge weight off my shoulders! <Color:7>♥<Color:Default>"
msgstr ""

msgctxt "5100_Himeka"
msgid "A cop who races to rescue the damsel in distress. It's like somethin' you'd see out of a movie! ♪"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=28
#. y4:msg_location=T2.P28
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Just call me if something happens.
msgctxt "5112_Tanimura"
msgid "You think?"
msgstr ""

msgctxt "5124_Himeka"
msgid "I feel much safer knowin' I can count on you, Tanimura-san! <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=30
#. y4:msg_location=T2.P30
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You have to tell it to them straight.
msgctxt "5136_Tanimura"
msgid "You have to tell it to them straight. That's the best way to deal with guys like that."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=31
#. y4:msg_location=T2.P31
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You have to tell it to them straight.
msgctxt "5148_Himeka"
msgid "I should just say I think they're creeps?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=32
#. y4:msg_location=T2.P32
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You have to tell it to them straight.
msgctxt "5160_Tanimura"
msgid "Well... Maybe soften it up a little. You don't want to make things worse than they already are."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=33
#. y4:msg_location=T2.P33
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You have to tell it to them straight.
msgctxt "5172_Himeka"
msgid "So what should I say?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=34
#. y4:msg_location=T2.P34
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You have to tell it to them straight.
msgctxt "5184_Tanimura"
msgid "Well... You could tell them that you have a boyfriend so you can't get involved with anyone else."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=35
#. y4:msg_location=T2.P35
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You have to tell it to them straight.
msgctxt "5196_Himeka"
msgid "But I don't have a boyfriend right now..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=36
#. y4:msg_location=T2.P36
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You have to tell it to them straight.
msgctxt "5208_Tanimura"
msgid "They don't have to know that."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=37
#. y4:msg_location=T2.P37
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You have to tell it to them straight.
msgctxt "5220_Himeka"
msgid "What if they wanna meet him?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=38
#. y4:msg_location=T2.P38
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You have to tell it to them straight.
msgctxt "5232_Himeka"
msgid "Hey, maybe you could pretend to be my boyfriend!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=39
#. y4:msg_location=T2.P39
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You have to tell it to them straight.
msgctxt "5244_Tanimura"
msgid "I suppose I wouldn't mind that."
msgstr ""

msgctxt "5256_Himeka"
msgid "Alrighty! From now on, I'll say I have a boyfriend. If they ask to meet him, you're the one who's comin' to dinner! ♪"
msgstr ""

msgctxt "5268_Himeka"
msgid "Hehehe. I'm countin' on you when the time comes! <Color:7>♥<Color:Default>"
msgstr ""

