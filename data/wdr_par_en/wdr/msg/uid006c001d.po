#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Both legs bouncing sounds annoying.
msgctxt "8004_Akiyama"
msgid "Hehe."
msgstr "Jeje."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=12
#. y4:msg_location=T7.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Both legs bouncing sounds annoying.
msgctxt "8016_Rio"
msgid "But to tell you the truth..."
msgstr "Pero a decir verdad..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=13
#. y4:msg_location=T7.P13
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Both legs bouncing sounds annoying.
msgctxt "8028_Rio"
msgid "I used to do that when I was in high school, too! They say that people who do it end up poor, so I stopped."
msgstr "Yo también lo hacía cuando estaba en la secundaria. Dicen que la gente que lo hace acaba siendo pobre, así que dejé de hacerlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=14
#. y4:msg_location=T7.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Both legs bouncing sounds annoying.
msgctxt "8040_Akiyama"
msgid "Hahaha. I'm pretty sure that's an old wives' tale."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=15
#. y4:msg_location=T7.P15
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Both legs bouncing sounds annoying.
msgctxt "8052_Rio"
msgid "Of course it is, but you want to be sure, you know?"
msgstr "Claro que lo es, pero uno tiene que estar seguro, ¿sabes?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=16
#. y4:msg_location=T7.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Both legs bouncing sounds annoying.
msgctxt "8064_Akiyama"
msgid "I guess it does make you look poor somehow. Maybe that's how that idea got started."
msgstr "Supongo que de alguna manera te hace parecer pobre. Tal vez así es como comenzó esa idea."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=17
#. y4:msg_location=T7.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Both legs bouncing sounds annoying.
msgctxt "8076_Rio"
msgid "Yeah, you might be right!"
msgstr "Sí. ¡Puede que tengas razón!"

