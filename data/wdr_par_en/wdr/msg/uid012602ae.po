#. y4:msg_speaker=White Kitten
#. y4:msg_speaker_id=7
msgctxt "672_White Kitten"
msgid "Mrowr!"
msgstr ""

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=51
#. y4:msg_location=T0.P51
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "684_Saejima"
msgid "Alright."
msgstr "Está bien."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=52
#. y4:msg_location=T0.P52
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "696_Cat-loving Homeless Man"
msgid "Oh, but I do have a favor to ask you."
msgstr "Oh, pero tengo un favor que pedirte."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=53
#. y4:msg_location=T0.P53
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "708_Cat-loving Homeless Man"
msgid "Would you mind naming them for me?"
msgstr "¿Te importaría ponerles nombre?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=54
#. y4:msg_location=T0.P54
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "720_Saejima"
msgid "Name 'em?"
msgstr "¿Ponerles nombre?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=55
#. y4:msg_location=T0.P55
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "732_Cat-loving Homeless Man"
msgid "You're the reason they're still alive. I'm sure they'd be honored."
msgstr "Eres la razón por la cual siguen vivos. Estoy seguro de que estarían honrados si lo hicieras."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=56
#. y4:msg_location=T0.P56
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "744_Cat-loving Homeless Man"
msgid "C'mon, please?"
msgstr "¿Vamos, Por favor?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=57
#. y4:msg_location=T0.P57
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "756_Saejima"
msgid "(What're some good cat names?)"
msgstr "(¿Cuáles son buenos nombre para gatos?)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=60
#. y4:msg_location=T0.P60
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "792_Cat-loving Homeless Man"
msgid "%s and %s, huh? Nice! I like them."
msgstr "¿%s y %s, eh? ¡Genial! Me gustan."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=61
#. y4:msg_location=T0.P61
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "804_Saejima"
msgid "Take care of 'em, now."
msgstr "Ahora, cuídalos bien."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=62
#. y4:msg_location=T0.P62
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "816_Cat-loving Homeless Man"
msgid "Certainly! If you ever wanna see them, just come by the theater underground! They'd love that."
msgstr "¡Por supuesto! ¡Si alguna vez quieres verlos, solo pásate por el Subterráneo del teatro! Les va a encantar verte."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=63
#. y4:msg_location=T0.P63
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=4
msgctxt "828_Cat-loving Homeless Man"
msgid "Wouldn't you?"
msgstr "¿Lo harás?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=64
#. y4:msg_location=T0.P64
#. y4:msg_speaker=鄂ｮ謠媽謐ｨ縺ｦ迪ｫ�ｼ｡
#. y4:msg_speaker_id=25
msgctxt "840_置換_捨て猫Ａ"
msgid "Prrr..."
msgstr "Prrr..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=65
#. y4:msg_location=T0.P65
#. y4:msg_speaker=鄂ｮ謠媽謐ｨ縺ｦ迪ｫ�ｼ｢
#. y4:msg_speaker_id=26
msgctxt "852_置換_捨て猫Ｂ"
msgid "Mew!"
msgstr "¡Miau!"

#. y4:line_status=translated
msgctxt "864_Cat-loving Homeless Man"
msgid "I'm gonna make a little house for these fine lads.\\r\nPromise you'll come by and see them!"
msgstr "Les haré una casita a estos muchachos.\\r\n¡Prométeme que los vendrás a ver!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "924_Saejima"
msgid "Say, I bet I can use that key here."
msgstr "Apuesto a que puedo usar esa llave aquí."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Surly Homeless Man
#. y4:msg_speaker_id=0
msgctxt "936_Surly Homeless Man"
msgid "Why don't I take that off your hands?"
msgstr "¿Debería quitarte eso de las manos?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "948_Saejima"
msgid "You were tailin' me all this time?"
msgstr "¿Me seguiste todo este tiempo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Friendly Homeless Man
#. y4:msg_speaker_id=2
msgctxt "960_Friendly Homeless Man"
msgid "Now, now. You don't have to put it like that."
msgstr "Bueno, bueno. No tienes que decirlo así."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=8
msgctxt "972_Saejima"
msgid "You, too?"
msgstr "¿Tú, también?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Friendly Homeless Man
#. y4:msg_speaker_id=2
msgctxt "984_Friendly Homeless Man"
msgid "We did rescue those cats, after all. It's only natural to expect a little good karma."
msgstr "Rescatamos a esos gatos, después de todo. Es obvio recibir algo de buen karma."

#. y4:line_status=translated
msgctxt "1008_Surly Homeless Man"
msgid "Bah! You just want your hands on the treasure, same as us!\\r\nHand over that key already!"
msgstr "¡Bah! ¡Lo único que quieres es poner tus manos en el tesoro, igual que nosotros!\\r\n¡Danos esa llave ahora!"
