#. y4:msg_speaker_id=1
msgctxt "764_Nair"
msgid "[Oh, Tanimura-san. What's that you have there?]"
msgstr "[Ah, Tanimura-san. ¿Qué llevas ahí?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "776_Tanimura"
msgid "(I can't spar or investigate while holding this briefcase. I should probably come back later.)"
msgstr "(No puedo pelear ni investigar si llevo el maletín. Debería\nvolver más tarde.)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=1
#. y4:msg_location=T3.P1
#. y4:msg_speaker=Gang Underling
#. y4:msg_speaker_id=3
msgctxt "800_Gang Underling"
msgid "[Shit... Don't you move!]"
msgstr "[Mierda... ¡No te muevas!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=2
#. y4:msg_location=T3.P2
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "812_Tanimura"
msgid "[Sorry, but we don't have time to talk. You're going to let us in.]"
msgstr "[Lo siento, no tenemos tiempo para charlar. Ahora vas a dejarnos\nentrar.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=1
#. y4:msg_location=T4.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "860_Tanimura"
msgid "[This is it... I guess.]"
msgstr "[Este es el lugar... creo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=2
#. y4:msg_location=T4.P2
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "872_Nair"
msgid "[Yep.]"
msgstr "[Sí.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=3
#. y4:msg_location=T4.P3
#. y4:msg_speaker=Gang Underling
#. y4:msg_speaker_id=3
msgctxt "884_Gang Underling"
msgid "[I knew you'd show up. You have no idea what you're getting yourselves into.]"
msgstr "[Sabía que vendrían. No tienen ni idea donde se están metiendo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=4
#. y4:msg_location=T4.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "896_Tanimura"
msgid "[If you're here then this must be the right place.]"
msgstr "[Si ustedes están aquí, entonces es el lugar correcto.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=5
#. y4:msg_location=T4.P5
#. y4:msg_speaker=Gang Underling
#. y4:msg_speaker_id=3
msgctxt "908_Gang Underling"
msgid "[You sure about that? Either way, you're not gonna live to find out!]"
msgstr "[¿Estás seguro de eso? ¡Sea como sea, no vivirás para saberlo!]"

