msgid "Sorry, gonna have to pass."
msgstr "Lo siento, voy a tener que pasar."

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
msgctxt "200_Player"
msgid "I'm good."
msgstr "Estoy bien."

#. y4:line_status=reviewed
#. y4:reviewed_by=Keiner
