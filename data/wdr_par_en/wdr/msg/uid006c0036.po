#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "14220_Kiryu"
msgid "Okay then. Just be careful."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
