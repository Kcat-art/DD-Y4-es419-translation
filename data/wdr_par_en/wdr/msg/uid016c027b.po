#. y4:msg_talk=12
#. y4:msg_phrase=2
#. y4:msg_location=T12.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2040_Maya"
msgid "So, did you find a girl you like?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=3
#. y4:msg_location=T12.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "2052_Kiryu"
msgid "Yeah. I'm looking at her right now."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=4
#. y4:msg_location=T12.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2064_Maya"
msgid "Hahaha! You're going to make me blush!"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=5
#. y4:msg_location=T12.P5
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2076_Maya"
msgid "If you like me so much, why don't you request me next time?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=6
#. y4:msg_location=T12.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "2088_Kiryu"
msgid "All right. I'll do that."
msgstr ""

msgctxt "2100_Himeka"
msgid "The dialogue will end after one round if you've\\r\n"
"entered a club more than once. Please report when this message is displayed."
msgstr "El diálogo terminará después de una ronda\\r\n"
"cuando entre al club más de una vez. Contacte a un programador si ve este mensaje."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=14
#. y4:msg_phrase=0
#. y4:msg_location=T14.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2112_Maya"
msgid "Kiryu-san... You didn't request me today..."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=14
#. y4:msg_phrase=1
#. y4:msg_location=T14.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "2124_Kiryu"
msgid "Oh, right. I didn't mean anything by it. I just wanted a little change of pace."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=14
#. y4:msg_phrase=2
#. y4:msg_location=T14.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=3
msgctxt "2136_Maya"
msgid "I've been staying here because you request me, but maybe I'll quit after all."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=14
#. y4:msg_phrase=3
#. y4:msg_location=T14.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "2148_Kiryu"
msgid "Wait a minute. Don't do anything hasty. I'll request you next time. I promise."
msgstr ""

msgctxt "2160_Maya"
msgid "Hehe. Cross your heart? <Color:7>♥<Color:Default>"
msgstr ""

msgctxt "2172_Himeka"
msgid "The dialogue will end after one round if you've\\r\n"
"entered a club more than once. Please report when this message is displayed."
msgstr "El diálogo terminará después de una ronda\\r\n"
"cuando entre al club más de una vez. Contacte a un programador si ve este mensaje."

msgctxt "2184_Maya"
msgid "Maya Mori does not appear for Kiryu's 2nd.\\r\n"
