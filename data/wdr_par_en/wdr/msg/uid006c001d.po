#. y4:msg_speaker_id=2
msgctxt "7872_Rio"
msgid "Have you met Yokoyama-kun? He's one of the attendants here."
msgstr "¿Conoces a Yokoyama-kun? Es uno de los empleados del lugar."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
