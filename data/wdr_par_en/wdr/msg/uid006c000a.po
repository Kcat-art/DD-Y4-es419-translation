#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That takes coordination.
msgctxt "7740_Tanimura"
msgid "That takes coordination. I certainly couldn't do it."
msgstr "Eso requiere coordinación. Desde luego yo no podría hacerlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=11
#. y4:msg_location=T9.P11
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That takes coordination.
msgctxt "7752_Chihiro"
msgid "Hehe! You know, you should try it! You might have my special talent too."
msgstr "¡Je, je! ¡Debería intentarlo! Puede que también tenga mi talento especial."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=12
#. y4:msg_location=T9.P12
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That takes coordination.
msgctxt "7764_Tanimura"
msgid "Uh, I think I'll pass."
msgstr "Eh, no. Mejor paso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=13
#. y4:msg_location=T9.P13
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That takes coordination.
msgctxt "7776_Chihiro"
msgid "What? Oh, come on! Be a man! I mean, I did it, didn't I?"
msgstr "¿Qué? ¡Ah, por favor! ¡Sé un hombre! Yo sí pude, ¿no?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=14
#. y4:msg_location=T9.P14
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That takes coordination.
msgctxt "7788_Tanimura"
msgid "Yeah, but..."
msgstr "Sí, pero..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=15
#. y4:msg_location=T9.P15
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That takes coordination.
msgctxt "7800_Chihiro"
msgid "Okay, it'll be your homework! You have to learn to do it by the time I see you next!"
msgstr "Bien, ¡será su tarea para llevar a casa! ¡Tendrá que aprender a hacerlo para la próxima vez que nos veamos!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=16
#. y4:msg_location=T9.P16
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That takes coordination.
msgctxt "7812_Tanimura"
msgid "Are you serious?"
msgstr "¿Lo dice en serio?"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=149
#. y4:msg_phrase=0
#. y4:msg_location=T149.P0
