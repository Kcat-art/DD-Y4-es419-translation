#. y4:msg_choice_index=1
#. y4:msg_branch_choice=There's no need to be sad about it.
msgctxt "12360_Akiyama"
msgid " Just remember that I'm here if you ever need to talk to somebody."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
