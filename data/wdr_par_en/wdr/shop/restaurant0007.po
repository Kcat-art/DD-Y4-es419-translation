msgid "Quit"
msgstr "Salir"

#. y4:line_status=reviewed
#. y4:translated_by=Kcat0
#. y4:reviewed_by=Kcat0
msgctxt "433"
msgid "Cancel the order."
msgstr "Cancelar pedido."

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
msgctxt "451"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=reviewed
#. y4:translated_by=Kcat0
#. y4:reviewed_by=Kcat0
msgctxt "457"
msgid "Order the currently selected item."
msgstr "Pagar el objeto seleccionado."

#. y4:line_status=translated
msgctxt "492"
msgid "(I haven't picked anything.)"
msgstr "(No he escogido nada)"

#. y4:line_status=translated
msgctxt "521"
msgid "(I'm short on cash.)"
msgstr "(Me hace falta dinero)"

#. y4:line_status=translated
msgctxt "542"
msgid "Thank you. Your total comes to %s."
msgstr "Gracias. El precio total es de %s."

#. y4:line_status=translated
msgctxt "577"
msgid "(I can't eat anymore...)"
msgstr "(No puedo comer más...)"

#. y4:line_status=translated
msgctxt "625"
msgid "The limited-edition Kamuro Burger: an enticing\ncombination of avocado, tomato, and cheese."
msgstr "La hamburguesa Kamuro de edición limitada: una\ntentadora combinación de aguacate, tomate, y\nqueso."

#. y4:line_status=translated
msgctxt "716"
msgid "Our classic burger set, with a Smile Burger, fries, and\na drink."
msgstr "Nuestro clásico combo, con una Hamburguesa Smile, papas\nfritas y una bebida."

#. y4:line_status=translated
msgctxt "781"
msgid "This set includes a Smile Cheeseburger, fries, and a\ndrink."
msgstr "Este combo incluye una Hamburguesa de Queso Smile,\npapas fritas y una bebida."

#. y4:line_status=translated
msgctxt "841"
msgid "This set includes a Teriyaki Smile Burger with special\nsauce, fries, and a drink."
msgstr "Este combo incluye una Hamburguesa Teriyaki Smile con\nsalsa especial, papas fritas y una bebida."

#. y4:line_status=translated
msgctxt "923"
msgid "As advertised, this set comes with a King Smile \nBurger, fries, and a drink."
msgstr "Como se anuncia, este combo viene con una\nHamburguesa Rey Smile, papas fritas y una\nbebida."

#. y4:line_status=translated
msgctxt "1000"
msgid "A tasty Tuna Burger with a unique texture. Fries and \na drink come with this set."
msgstr "Una sabrosa hamburguesa de atún con una textura\núnica. Las papas fritas y una bebida vienen con este\ncombo."

#. y4:line_status=translated
msgctxt "1082"
msgid "A tender, stewed pork burger with fries and a drink."
msgstr "Una tierna hamburguesa de cerdo estofado con papas fritas y una bebida."

#. y4:line_status=translated
msgctxt "1135"
msgid "A Smile Shake made with fresh milk. Sure to put a \nsmile on anyone's face."
msgstr "Un Batido Smile hecho con leche fresca. Seguro que\npone una sonrisa en la cara de cualquiera."

#. y4:line_status=translated
msgctxt "1210"
msgid "The golden-fried standard of french fries. Served \nwith a smile."
msgstr "El estándar dorado de las papas fritas. Servidas\ncon una sonrisa."

