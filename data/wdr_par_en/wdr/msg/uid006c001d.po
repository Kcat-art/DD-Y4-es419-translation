#. y4:msg_branch_target_text=That's great to hear.
#. y4:msg_branch_raw=01 11 00 0c 00 00 00 15 00 00 00 00 00 00 00 00
msgctxt "14628_Akiyama"
msgid "That's great to hear."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=13
#. y4:msg_location=T20.P13
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's great to hear.
msgctxt "14640_Rio"
msgid "Gosh, it's just like a TV show! I guess things like this really do happen!"
msgstr "¡Vaya, es como un programa de televisión! ¡Supongo que cosas como esta realmente suceden!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=14
#. y4:msg_location=T20.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's great to hear.
msgctxt "14652_Akiyama"
msgid "It feels good to get a little recognition, doesn't it?"
msgstr "Se siente bien recibir un poco de reconocimiento, ¿no?"

msgctxt "14664_Rio"
msgid "Yep! ♪"
msgstr "¡Sip! ♪"

#. y4:msg_type=branch_dialogue
