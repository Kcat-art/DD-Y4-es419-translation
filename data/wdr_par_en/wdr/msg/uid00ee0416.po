msgid "Hey, man, thanks for the booze the other day."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Homeless Man
#. y4:msg_speaker_id=0
msgctxt "128_Homeless Man"
msgid "I've got your back no matter what happens. You ever get caught in a fight nearby, I'll be there for you!"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Homeless Man
#. y4:msg_speaker_id=0
msgctxt "140_Homeless Man"
msgid "Wha? Huh? I'm outta booze."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Homeless Man
#. y4:msg_speaker_id=0
msgctxt "152_Homeless Man"
msgid "Hey, you there. Can you be a pal and get me some booze?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Homeless Man
#. y4:msg_speaker_id=0
msgctxt "164_Homeless Man"
msgid "Don't worry, I don't expect you to do it for free. I'll pay you back. You always treat me nice, so I owe you anyway."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Homeless Man
#. y4:msg_speaker_id=0
