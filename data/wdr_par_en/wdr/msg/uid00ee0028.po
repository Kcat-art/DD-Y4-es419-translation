#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "156_Manager"
msgid "What would you like to purchase?"
msgstr "¿Qué le gustaría comprar?"

#. y4:line_status=translated
msgctxt "216_Manager"
msgid "Thank you very much."
msgstr "Muchas gracias."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "228_Manager"
msgid "What do you have to sell?"
msgstr "¿Que tiene para vender?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "252_Manager"
msgid "Thank you for your patronage."
msgstr "Gracias por su preferencia."

#. y4:line_status=translated
msgctxt "264_Manager"
msgid "I'm here to buy."
msgstr "Estoy aquí para comprar."

#. y4:line_status=translated
msgctxt "276_Manager"
msgid "I'm here to sell."
msgstr "Estoy aquí para vender."

#. y4:line_status=translated
msgctxt "288_Manager"
msgid "Never mind."
msgstr "No importa."

