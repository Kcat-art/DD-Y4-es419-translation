#. y4:msg_branch_segment=T8.P16..P23
#. y4:msg_branch_target_text=How much would you say you've recovered?
#. y4:msg_branch_raw=01 11 00 10 00 00 00 28 00 00 00 00 00 00 00 00
msgctxt "8568_Akiyama"
msgid "How much would you say you've recovered?"
msgstr "¿Cuánto crees que has recuperado?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=17
#. y4:msg_location=T8.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How much would you say you've recovered?
msgctxt "8580_Rio"
msgid "Hmm... Maybe 60 or 70%?"
msgstr "Hmm... ¿Quizas el 60 o el 70%?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=18
#. y4:msg_location=T8.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How much would you say you've recovered?
msgctxt "8592_Akiyama"
msgid "So you're making progress then."
msgstr "Así que estás progresando entonces."

msgctxt "8604_Rio"
msgid "I think so. ♪"
msgstr "Creo que sí. ♪"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=20
#. y4:msg_location=T8.P20
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How much would you say you've recovered?
msgctxt "8616_Akiyama"
msgid "I think you're beautiful as you are, though."
msgstr "Sin embargo, creo que eres hermosa tal como eres."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=21
#. y4:msg_location=T8.P21
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How much would you say you've recovered?
msgctxt "8628_Rio"
msgid "No, I still have a ways to go. At least that's how I feel about it."
msgstr "No, aún me queda camino por recorrer. Al menos así es como yo lo siento."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=22
#. y4:msg_location=T8.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=How much would you say you've recovered?
msgctxt "8640_Akiyama"
msgid "Heh, I see... Well, I think you're doing great so far. Keep at it."
msgstr "Ya veo... Bueno, creo que lo has estádo haciendo muy bien hasta ahora. Sigue así."

msgctxt "8652_Rio"
msgid "Thanks! <Color:7>♥<Color:Default>"
msgstr "¡Gracias! <Color:7>♥<Color:Default>"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
