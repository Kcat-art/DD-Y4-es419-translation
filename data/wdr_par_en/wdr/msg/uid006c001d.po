#. y4:msg_location=T25.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "16644_Akiyama"
msgid "You mean on the guitar?"
msgstr "¿Te refieres en la guitarra?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=2
#. y4:msg_location=T25.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16656_Rio"
msgid "Yep yep! It's not a very hard one, but still."
msgstr "¡Sip, sip! No es muy difícil, pero aún así."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=3
#. y4:msg_location=T25.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "16668_Akiyama"
msgid "What song is it?"
msgstr "¿Qué canción es?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=4
#. y4:msg_location=T25.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16680_Rio"
msgid "Umm... Something Tapclon?"
msgstr "Umm... ¿Algo Tapclon?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=5
#. y4:msg_location=T25.P5
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16692_Rio"
msgid "No, that's not right. Placton?"
msgstr "No, eso no es. ¿Placton?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=6
#. y4:msg_location=T25.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "16704_Akiyama"
msgid "Uh..."
msgstr "Eh..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=7
#. y4:msg_location=T25.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "16716_Rio"
msgid "What was it again?"
msgstr "¿Cómo era?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=25
#. y4:msg_section_label=Conversación 25
#. y4:msg_talk=25
#. y4:msg_phrase=8
#. y4:msg_location=T25.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "16728_Akiyama"
msgid "How am I supposed to know?"
msgstr "¿Cómo se supone que voy a saberlo?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
