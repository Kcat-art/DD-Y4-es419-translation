#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "56_Hana"
msgid "Oh, Chief. Welcome back."
msgstr "Ah, jefe, bienvenido de vuelta."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "92_Akiyama"
msgid "Hey, Hana-chan."
msgstr "Hola Hana-chan."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "104_Akiyama"
msgid "Glad to see you're doing better. You really shouldn't mess with people like that."
msgstr "Me alegra que estés bien. Por favor, no hagas locuras así otra vez."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "116_Hana"
msgid "Don't you worry, boss. It'll never happen again. Not after all the self-defense training I've got planned!"
msgstr "Sí, gracias. ¡Me haré más fuerte para no volver a pasar por algo así!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "128_Akiyama"
msgid "......"
msgstr "......"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "140_Hana"
msgid "So, what happened with that lady who came here for the one hundred million?"
msgstr "¿Y qué pasó con esa clienta, la que vino a pedir cien millones?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "152_Akiyama"
msgid "What, Lily-chan?"
msgstr "Ah, ¿te refieres a Lily-chan?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "164_Hana"
msgid "Please tell me you didn't loan her the whole thing at once."
msgstr "No me diga que le dio una suma tan grande así como así."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "176_Akiyama"
msgid "Actually, I did. Just now."
msgstr "¿Eh? Sí, se lo presté. Hace un rato, de hecho."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "188_Hana"
msgid "What!?"
msgstr "¡¿Qué?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "200_Akiyama"
msgid "Yeah, funny thing, really. And, er... don't be mad, but somehow I don't think we'll be seeing that money again."
msgstr "O sea, verás... cómo decirlo... no es fácil de explicar, pero... probablemente ese dinero no vuelva."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "212_Hana"
msgid "What!? What's <Italic>that</Italic> supposed to mean!?"
msgstr "¡¿Qué?! ¡¿Está hablando en serio?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "224_Akiyama"
msgid "I dunno. Lily-chan told me she'd pay it back, but I get the feeling that's not gonna happen."
msgstr "No es que Lily-chan no quisiera pagar, ella dijo que lo haría. Pero, no me da la sensación de que vaya a devolverlo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "236_Hana"
msgid "And you lent it to her anyway!?"
msgstr "Entonces, ¿usted le prestó esa enorme cantidad de dinero sabiendo que no lo recuperaría?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "248_Akiyama"
msgid "Pretty much."
msgstr "Más o menos."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "260_Hana"
msgid "What's wrong with you!?"
msgstr "¡¿Por qué haría algo así?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "272_Akiyama"
msgid "What's the big deal? Last I checked, this was my company. I can lend money to who I want, when I want."
msgstr "¡Vamos! Yo soy el jefe, ¿no? Si quiero prestarle a alguien, lo hago. Ese es mi estilo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "284_Hana"
msgid "Chief..."
msgstr "Jefe..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "296_Akiyama"
msgid "Besides, this is hardly the first time this sort of thing's happened. Why make a fuss about it now?"
msgstr "¿Qué pasa ahora, Hana-chan? Esto no es nada nuevo, ¿verdad?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "308_Akiyama"
msgid "What do you have against Lily-chan?"
msgstr "¿Por qué solo con Lily-chan te estás poniendo así?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "320_Akiyama"
msgid "Hana-chan? What's wrong?"
msgstr "¿Mmm? ¿Hana-chan? ¿Qué pasa?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "332_Hana"
msgid "Grr... That's it! I quit!"
msgstr "¡Ya basta! ¡Renuncio! ¡Dejo la empresa!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "344_Akiyama"
msgid "Huh?"
msgstr "¿Qué?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "356_Akiyama"
msgid "(Well, that's not good. I need to get after her, fast.)"
msgstr "(Esto no pinta bien. Será mejor que la alcance rápido)."
