msgid "......"
msgstr "......"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
msgctxt "404_Naoya"
msgid "All right, you're up, brotha!"
msgstr "Está bien, ¡es tu turno, hermano!"

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. A detective. -> T0.P10 | 2. Ryota. -> T0.P18 | 3. Masa. -> T0.P25
msgctxt "416_Tanimura"
msgid "Oh, uh, right. I'm..."
msgstr "Oh, eh, correcto. Soy..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=A detective.
msgctxt "428_Tanimura"
msgid "I'm a detective for the KPD. Community Safety Division."
msgstr "Soy detective del DPK. División de Seguridad Comunitaria."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=A detective.
msgctxt "440_Yusuke"
msgid "You are!? Holy shit!"
msgstr "¡¿Lo eres?! ¡Santo mierda!"

#. y4:line_status=translated
msgctxt "452_Akino"
msgid "A detective!? Omigosh, that's so cool! Wait a minute,\\r\nYusuke, why are you acting so surprised? You guys are\\r\nbest buds, right?"
msgstr "¡¿Un detective?! ¡Oh Dios, eso es tan genial! Espera un momento,\\r\n¿Yusuke, por qué actúas tan sorprendido? Ustedes\\r\nson mejores amigos, ¿verdad?"

#. y4:line_status=translated
msgctxt "464_Naoya"
msgid "Of course they are! It's just that... we forget what he does\\r\nsometimes. Yeah! Job's so crazy, it trips us out every time\\r\nwe hear it! Ain't that right, my man?"
msgstr "¡Por supuesto que lo son! Es solo que... a veces olvidamos lo que él hace.\\r\n¡Sí! Su trabajo es tan loco que nos sorprende cada vez que lo oímos.\\r\n¿No es así, amigo mío?"

#. y4:line_status=translated
msgctxt "476_Yusuke"
msgid "Right...! I meant it more like, \"Holy shit, you <Italic>are</Italic> a detective, aren't you!\" Haha...ha. Oh, and his name's－"
msgstr "¡Correcto...! Lo quise decir más como, \"¡Santo cielo, realmente <Italic>eres</Italic> un detective, ¿verdad?!\" Ja, ja... ja. Oh, y su nombre es..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=A detective.
msgctxt "488_Akino"
msgid "Ryota-kun, right? I read it in the email. Nice to meet you!"
msgstr "Ryota-kun, ¿verdad? Lo leí en el correo electrónico. ¡Un placer conocerte!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=A detective.
msgctxt "500_Tanimura"
msgid "Nice to meet you all."
msgstr "Un placer conocerlos a todos."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=A detective.
msgctxt "512_Naoya"
msgid "(Hey, think you could pull your act together? But damn... You're really a detective!? That's nuts!)"
msgstr "(¡Oye!, ¿crees que podrás organizarte? Pero maldita sea... ¡¿realmente eres un detective?! ¡Eso es una locura!)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Ryota.
msgctxt "524_Tanimura"
msgid "I'm Ryota. I went to high school with these characters."
msgstr "Soy Ryota. Fui a la secundaria con estos personajes."

#. y4:line_status=translated
msgctxt "536_Yusuke"
msgid "Yeah, what he said. We sort of bumped into each other the other day, and he told me he was single. Guess my boy's ready to hang and ready to bang－er, make a bang, that is."
msgstr "Sí, lo que él dijo. Nos encontramos el otro día, y me dijo que estaba soltero. Supongo que mi amigo está listo para salir y listo para... bueno, hacer ruido, eso es."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Ryota.
msgctxt "548_Akino"
msgid "Whoa, I never would've guessed you were single! Waste of hotness, if ya ask me."
msgstr "¡Vaya, nunca habría adivinado que estabas soltero! Una pena que esté tan bueno, si me preguntas."

#. y4:line_status=translated
msgctxt "560_Yusuke"
msgid "Uh... Sure! Yeah. Totally. Guy's as hot as... a brick oven!\\r\nMakes me wonder why he hasn't had a girlfriend in years!\\r\nKnow what I mean, Naoya?"
msgstr "Este... ¡Seguro! Sí. Totalmente. El chico es tan caliente como... ¡Un horno de ladrillos!\\r\n¡Me hace preguntarme por qué no ha tenido novia en años!\\r\n¿Sabes a lo que me refiero, Naoya?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Ryota.
msgctxt "572_Naoya"
msgid "I do. Maybe it's 'cause he's got secrets to hide. Deep-down issues. Literal skeletons in the closet!"
msgstr "Lo sé. Tal vez sea porque tiene secretos que ocultar. Problemas profundos. ¡Esqueletos literales en el armario!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Ryota.
msgctxt "584_Naoya"
msgid "Come on, Ryota, don't look at me like that. Relax! I'm just yankin' your chain, man! It's how close friends who <Italic>clearly</Italic> go way back joke around!"
msgstr "Vamos, Ryota, no me mires así. ¡Relájate! ¡Solo estoy jugando contigo, hermano! ¡Así bromean  los amigos cercanos que <Italic>claramente</Italic> tienen una larga amistad!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Ryota.
msgctxt "596_Yusuke"
msgid "(Keep it up, Tanimura-san! You're doing great!)"
msgstr "(¡Sigue así, Tanimura-san! ¡Lo estás haciendo genial!)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "608_Tanimura"
msgid "I'm Masa."
msgstr "Soy Masa."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "620_Akino"
msgid "Masa? I was sure I read the name \"Ryota\" in Yusuke's email..."
msgstr "¿Masa? Estaba segura de haber leído el nombre \"Ryota\" en el correo de Yusuke..."

#. y4:line_status=translated
msgctxt "632_Yusuke"
msgid "Ohhh! Uh, about that－"
msgstr "¡Ohhh! Eh, sobre eso－"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "644_Naoya"
msgid "Ryota's last name is Masaoka. Ryota, we're all friends here, so just use your first name, okay?"
msgstr "El apellido de Ryota es Masaoka. Ryota, todos somos amigos aquí, así que solo usa tu primer nombre, ¿de acuerdo?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "656_Tanimura"
msgid "Oh, right. Of course. Sorry about that. Let's give this another try. My name's Ryota. Nice to meet you ladies."
msgstr "Oh, cierto. Claro. Lo siento por eso. Intentémoslo de nuevo. Me llamo Ryota. Un placer conocerlas, chicas."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "668_Akino"
msgid "Nice to meet <Italic>you</Italic>!"
msgstr "¡Un placer conocerte a <Italic>ti</Italic>!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=31
#. y4:msg_location=T0.P31
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "680_Naoya"
msgid "All right, that wraps up the boys! Girls, you're up."
msgstr "¡Está bien, eso concluye con los chicos! Chicas, ustedes son las siguientes."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=32
#. y4:msg_location=T0.P32
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "692_Yusuke"
msgid "Hey, who put you in charge!?"
msgstr "¡Ey, ¿quién te puso a cargo?!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "704_Akino"
msgid "Now now, no bickering, boys! I'll start things off. I arranged this little mixer on the girls' side, and my name is Akino!"
msgstr "Okay, okay, ¡sin peleas, chicos! Yo empiezo. Organicé esta pequeña reunión del lado de las chicas, y me llamo Akino."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
