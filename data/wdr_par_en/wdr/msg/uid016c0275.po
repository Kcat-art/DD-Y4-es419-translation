#. y4:msg_location=T22.P0
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=3
msgctxt "1740_Himeka"
msgid "I'm Himeka. Nice to meet you."
msgstr "Me llamo Himeka. Encantada de conocerte."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=1
#. y4:msg_location=T22.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=15
msgctxt "1752_Akiyama"
msgid "I'm Shun Akiyama. Likewise."
msgstr "Soy Shun Akiyama. Encantado."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=2
#. y4:msg_location=T22.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=15
msgctxt "1764_Akiyama"
msgid "Hey! I've seen you somewhere before. Were you in a magazine recently?"
msgstr "¡Eh! Creo que te he visto antes. ¿Saliste en una revista hace poco?"

msgctxt "1776_Himeka"
msgid "Haha! ♪ How'd ya know? I'm flattered you remembered! <Color:7>♥<Color:Default>"
msgstr "¡Jaja! ♪ ¿En serio? ¡Qué detalle que me reconozcas! <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=4
#. y4:msg_location=T22.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=15
msgctxt "1788_Akiyama"
msgid "You're famous. I suppose you get a lot of folks requesting you."
msgstr "Eres una celebridad. Me imagino que no paras de recibir solicitudes, ¿eh?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=5
#. y4:msg_location=T22.P5
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=3
msgctxt "1800_Himeka"
msgid "Not really. Sometimes I have no requests, like now."
msgstr "No realmente. Hay ocasiones, como ahora, en las que nadie me solicita."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=22
#. y4:msg_phrase=6
#. y4:msg_location=T22.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=15
msgctxt "1812_Akiyama"
msgid "Guess I got lucky then, huh?"
msgstr "Supongo que estoy de suerte."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=23
#. y4:msg_phrase=0
#. y4:msg_location=T23.P0
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=3
msgctxt "1824_Himeka"
msgid "Hey, do you like comedians, Akiyama-san?"
msgstr "Akiyama-san, ¿te gustan los comediantes?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=23
#. y4:msg_phrase=1
#. y4:msg_location=T23.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=15
msgctxt "1836_Akiyama"
msgid "Hmm... As much as anyone, I guess. I've never gone to a live show or anything. Why do you ask?"
msgstr "Bueno... Como a cualquiera, imagino. Jamás he ido a un show en vivo. ¿Por qué lo preguntas?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=23
#. y4:msg_phrase=2
#. y4:msg_location=T23.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=15
msgctxt "1848_Akiyama"
msgid "Are you into comedians?"
msgstr "¿Te gustan los comediantes?"

msgctxt "1860_Himeka"
msgid "Hehehe. ♪ Well, if I'm gonna go out with a guy, he's gotta be able to make me laugh. <Color:7>♥<Color:Default>"
msgstr "Jejeje. ♪ Bueno, si salgo con un chico, mínimo que me haga reír, ¿sabes? <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=23
#. y4:msg_phrase=4
#. y4:msg_location=T23.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=15
msgctxt "1872_Akiyama"
msgid "Huh, I see... Well, that means I'm no good then."
msgstr "Ah, ya veo... Claramente no cumplo con lo que buscas."

msgctxt "1884_Himeka"
msgid "I don't believe that. ♪ I'm sure you could crack a joke if you tried. Try one right now! You'll get me interested for sure. <Color:7>♥<Color:Default>"
msgstr "¡No digas eso! ♪ Sé que tienes algún chiste guardado por ahí. ¡Inténtalo! No puede ser tan malo. <Color:7>♥<Color:Default>"

msgctxt "1896_Shizuka"
msgid "Hehehe. ♪ Isn't that a little tough to do in the spur of the moment? <Color:7>♥<Color:Default>"
msgstr "Jejeje. ♪ ¿No es un poquito difícil improvisar así de repente? <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=23
#. y4:msg_phrase=7
#. y4:msg_location=T23.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=15
msgctxt "1908_Akiyama"
msgid "Hoo boy..."
msgstr "Ay, cielos..."

