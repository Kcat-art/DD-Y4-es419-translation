msgid "[Hello?]"
msgstr "[¿Hola?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=13
#. y4:msg_location=T6.P13
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "1292_Marcos"
msgid "[Nair, get out of there!]"
msgstr "[Nair, ¡sal de ahí!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=14
#. y4:msg_location=T6.P14
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1304_Nair"
msgid "[Marcos! Are you okay!?]"
msgstr "[¡Marcos! ¡¿Estás bien?!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=15
#. y4:msg_location=T6.P15
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "1316_Marcos"
msgid "[Don't worry about me, just get out of there! Garcia's with me!]"
msgstr "[¡No te preocupes por mí! ¡Debes salir de ahí! ¡Garcia está\nconmigo!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=16
#. y4:msg_location=T6.P16
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "1328_Marcos"
msgid "[Chasing GG at the club was just a trap to catch us!]"
msgstr "[¡Seguir a GG al club fue solo una trampa para atraparnos!]"

#. y4:line_status=translated
msgctxt "1340_Marcos"
msgid "[Even the interpreter was－ Ugh!]"
msgstr "[Y el intérprete también - ¡Aagh!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=18
#. y4:msg_location=T6.P18
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
