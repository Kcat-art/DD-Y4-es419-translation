msgctxt "1324_Surly Homeless Man"
msgid "Yeah, I didn't think so."
msgstr "Sí, creo que no está funcionando."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
