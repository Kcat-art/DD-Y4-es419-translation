#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a positive way to look at things.
msgctxt "8820_Akiyama"
msgid "Exactly."
msgstr "Exacto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=38
#. y4:msg_location=T8.P38
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a positive way to look at things.
msgctxt "8832_Rio"
msgid "I feel a little better. Thank you."
msgstr "Me siento un poco mejor. Gracias."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=39
#. y4:msg_location=T8.P39
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a positive way to look at things.
msgctxt "8844_Akiyama"
msgid "Heh. Keep at it. I'm sure you'll get even more beautiful."
msgstr "Je. Sigue así. Seguro que te pondrás aún más bonita."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
