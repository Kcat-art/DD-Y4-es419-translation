#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You're right.
msgctxt "4908_Kiryu"
msgid "You're right. Great songs can really move you."
msgstr "Tienes razón. Las grandes canciones son las que pueden moverte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
