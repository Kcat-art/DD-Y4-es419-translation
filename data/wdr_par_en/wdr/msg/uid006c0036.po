#. y4:msg_branch_choice=You should've talked to him.
msgctxt "11736_Kiryu"
msgid "Sometimes you just have to do something and hope for the best. Try it and you'll probably find it wasn't as hard as you feared."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
