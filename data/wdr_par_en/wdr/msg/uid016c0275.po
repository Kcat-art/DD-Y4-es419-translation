msgctxt "1500_Kiryu"
msgid "You said your name was Himeka? I'm Kazuma Kiryu.\\r\n"
"Nice to meet you."
msgstr "Has dicho que tu nombre era Himeka, ¿verdad? Yo soy Kazuma Kiryu. Encantado."

msgctxt "1512_Himeka"
msgid "Hello, Kiryu-san. Nice to meet you too! ♪"
msgstr "Hola, Kiryu. ¡Encantada de conocerte también! ♪"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=16
#. y4:msg_phrase=2
#. y4:msg_location=T16.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "1524_Kiryu"
msgid "Are you from Kansai by any chance?"
msgstr "¿No serás de Kansai por casualidad?"

msgctxt "1536_Himeka"
msgid "I am. ♪ How do you feel about girls with Kansai accents, Kiryu-san?"
msgstr "Lo soy. ♪ ¿Qué te parecen las chicas con acento de Kansai, Kiryu?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=16
#. y4:msg_phrase=4
#. y4:msg_location=T16.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "1548_Kiryu"
msgid "I fell for a girl from Kansai once."
msgstr "Una vez me enamoré de una chica de Kansai."

msgctxt "1560_Himeka"
msgid "Really? ♪ It's cool ya can talk about yer old girlfriends like that. That's a sign of maturity. <Color:7>♥<Color:Default>"
msgstr "¿De verdad? ♪ Me alegra que puedas hablar de tus ex novias así. Eso demuestra madurez. <Color:7>♥<Color:Default>"

msgctxt "1572_Himeka"
msgid "You seem the serious type. ♪ Not like the men in Osaka."
msgstr "Pareces un tipo serio. ♪ No como los hombres en Osaka."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=17
#. y4:msg_phrase=1
#. y4:msg_location=T17.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "1584_Kiryu"
msgid "That can't be entirely true. Sure, many comedians are from Osaka, but there must be serious men there as well."
msgstr "No creo que sean todos así. Es verdad que muchos comediantes son de Osaka, pero también deben haber hombres serios."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=17
#. y4:msg_phrase=2
#. y4:msg_location=T17.P2
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=3
msgctxt "1596_Himeka"
msgid "Hmm. Probably. I'm not much into that type of man, so..."
msgstr "Hmm. Es posible. No me atraen mucho, así que..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=17
#. y4:msg_phrase=3
#. y4:msg_location=T17.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "1608_Kiryu"
msgid "You like a man with a sense of humor?"
msgstr "¿Te gustan los hombres con sentido del humor?"

msgctxt "1620_Himeka"
msgid "Yeah, I suppose. ♪ They're the most fun to talk to! <Color:7>♥<Color:Default>"
msgstr "Supongo que sí. ♪ ¡Tienen las conversaciones más divertidas! <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=17
#. y4:msg_phrase=5
#. y4:msg_location=T17.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "1632_Kiryu"
msgid "I see..."
msgstr "Ya veo..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=18
#. y4:msg_phrase=0
#. y4:msg_location=T18.P0
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=3
msgctxt "1644_Himeka"
msgid "Have you traveled anywhere recently, Kiryu-san?"
msgstr "¿Has viajado a algún sitio recientemente, Kiryu?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=18
#. y4:msg_phrase=1
#. y4:msg_location=T18.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "1656_Kiryu"
msgid "No... To be honest, I'm traveling right now. I actually live in Okinawa."
msgstr "No... De hecho, estoy de viaje ahora. Vivo en Okinawa."

msgctxt "1668_Himeka"
msgid "Really? ♪ I love travelin' with my family. Wish I could go on a trip sometime soon."
msgstr "¿Ah sí? ♪ A mí me encanta viajar con mi familia. Ojalá pudiera irme de viaje pronto."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=18
#. y4:msg_phrase=3
#. y4:msg_location=T18.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=8
msgctxt "1680_Kiryu"
msgid "Speaking of traveling, some of the kids I'm looking after just came back from their school trip."
msgstr "Hablando de viajar, algunos de los niños de los que cuido acaban de volver de un viaje escolar."

msgctxt "1692_Himeka"
msgid "Ooh, I loved school trips! ♪ Travelin' with your friends is way more fun than goin' by yourself! <Color:7>♥<Color:Default>"
msgstr "¡Ooh, me encantaban los viajes escolares! ♪ ¡Viajar con amigos siempre es mas divertido que viajar solo! <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
