msgctxt "6440_Akiyama"
msgid "Huh..."
msgstr "Huh..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=47
