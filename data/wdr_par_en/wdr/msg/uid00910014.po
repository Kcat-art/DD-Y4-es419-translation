#. y4:msg_branch_choice=Check Investigation
msgctxt "4952_Tanimura"
msgid "[I wonder if he was brought over here as a bodyguard. In any case, this means GG is not alone.]"
msgstr "[Me pregunto si lo trajeron como guardaespaldas. Sea como sea,\nesto significa que GG no está solo.]"

#. y4:line_status=translated
