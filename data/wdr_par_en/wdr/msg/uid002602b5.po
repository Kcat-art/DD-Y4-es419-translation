#. y4:msg_location=T4.P9
#. y4:msg_speaker=Surly Homeless Man
#. y4:msg_speaker_id=7
msgctxt "1372_Surly Homeless Man"
msgid "Huh? What are you lookin' at?"
msgstr "¿Eh? ¿Qué estás mirando?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=4
#. y4:msg_phrase=10
#. y4:msg_location=T4.P10
#. y4:msg_speaker=Friendly Homeless Man
#. y4:msg_speaker_id=5
msgctxt "1384_Friendly Homeless Man"
msgid "Hey, take it easy fellas. Say, pal, are you a cat lover?"
msgstr "Oye, no seas así, ¿qué tal?\\r\n¿Te gustan los gatos?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
