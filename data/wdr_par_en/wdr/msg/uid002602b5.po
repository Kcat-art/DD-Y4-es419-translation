#. y4:msg_location=T4.P1
#. y4:msg_speaker=Surly Homeless Man
#. y4:msg_speaker_id=7
msgctxt "1276_Surly Homeless Man"
msgid "Want some beer...? Huh! Darn things just won't warm up to me."
msgstr "¿O quieres un poco de cerveza? ¡Agh!\\r\nEstas cosas no me agradan."

#. y4:line_status=translated
msgctxt "1288_Cat-loving Homeless Man"
msgid "Aw, you guys aren't seeing cat's eye to cat's eye with them.\\r\nWatch and learn."
msgstr "Aggh, no están entendiendo los sentimientos del gato.\\r\nMiren y aprendan."

#. y4:line_status=translated
