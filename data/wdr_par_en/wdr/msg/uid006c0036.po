#. y4:msg_speaker_id=0
msgctxt "14412_Kiryu"
msgid "You're quiet today. What's wrong?"
msgstr "Hoy estás callada. ¿Qué pasa?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
