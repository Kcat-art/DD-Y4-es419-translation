#. y4:msg_speaker_id=0
msgctxt "12204_望月京子：源氏名"
msgid "Kiryu-san, what would you do if my band won the contest?"
msgstr "Kiryu-san, ¿Qué harías si mi banda gana el concurso?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=1
#. y4:msg_location=T22.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "12216_Kiryu"
msgid "Well... I suppose I'd be surprised."
msgstr "Bueno... Supongo que me alegraría."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=2
#. y4:msg_location=T22.P2
