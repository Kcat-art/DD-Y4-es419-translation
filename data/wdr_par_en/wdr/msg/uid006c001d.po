msgid "You're a terrible liar, you know."
msgstr "Eres una mentirosa terrible, sabes."

msgctxt "13620_Rio"
msgid "Hehehehehe. ♪"
msgstr "Je, je, je, je. ♪"

#. y4:msg_type=branch_dialogue
