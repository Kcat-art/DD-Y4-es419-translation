#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd rather not.
msgctxt "352_Shizuka"
msgid "I see... I apologize for being so selfish."
msgstr "Ya veo... Me disculpo por ser tan egoísta."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=0
#. y4:msg_location=T3.P0
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=0
msgctxt "364_Shizuka"
msgid "That was very awkward..."
msgstr "Eso fue muy incómodo..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
