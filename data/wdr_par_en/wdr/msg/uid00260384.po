#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Smith
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=A hot spring.
msgctxt "368_Smith"
msgid "Sounds good to me! Then let's get crackin'!"
msgstr "¡A mí me parece bien! ¡Entonces vamos a ponernos manos a la obra!"

