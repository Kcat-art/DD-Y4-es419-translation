#. y4:msg_branch_target_text=You shouldn't worry too much about it.
#. y4:msg_branch_raw=01 11 00 1d 00 00 00 26 00 00 00 00 00 00 00 00
msgctxt "16068_Akiyama"
msgid "You shouldn't worry too much about it."
msgstr "No deberías preocuparte demasiado por eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=45
#. y4:msg_location=T1.P45
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice="Rio, Queen of the Dance"
msgctxt "16080_Rio"
msgid "You think so?"
msgstr "¿De verdad lo cree?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=31
#. y4:msg_location=T23.P31
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't worry too much about it.
msgctxt "16092_Akiyama"
msgid "Nobody's perfect. There are worse things than being a little critical of your friends."
msgstr "Nadie es perfecto. Hay cosas peores que ser un poco crítica con tus amigos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=32
#. y4:msg_location=T23.P32
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't worry too much about it.
msgctxt "16104_Rio"
msgid "So you're saying I shouldn't worry about turning mean?"
msgstr "¿Entonces está diciendo que no debería preocuparme por volverme mala?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=33
#. y4:msg_location=T23.P33
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't worry too much about it.
msgctxt "16116_Akiyama"
msgid "How should I put this?"
msgstr "¿Cómo debería decir esto?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=34
#. y4:msg_location=T23.P34
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You shouldn't worry too much about it.
msgctxt "16128_Akiyama"
msgid "Nobody ever got rich by having a nice personality, right?"
msgstr "Nadie se ha hecho rico por tener una personalidad agradable, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
