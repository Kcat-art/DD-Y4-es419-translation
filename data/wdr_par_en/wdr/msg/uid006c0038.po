#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "5916_Kiryu"
msgid "Most women are pretty reserved when they meet me for the first time, but not you."
msgstr "Muchas mujeres son bastante reservas la primera vez que me conocen, pero tu no."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
