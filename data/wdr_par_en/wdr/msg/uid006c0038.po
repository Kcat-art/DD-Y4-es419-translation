msgctxt "5412_望月京子：源氏名"
msgid "But you do check out other women while you're already with one, right? That's unacceptable!"
msgstr "Pero si estás con tu chica y sigues fijándote en otras, ¡eso es repugnante!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
