msgid "And now your company's in the same position mine was... My\\r\napologies if this is too forward, but you have to downsize."
msgstr "Y ahora tu empresa está en la misma situación que la mía... \\r\nPerdona si soy muy directo, pero tienes que reducir personal."

#. y4:line_status=translated
msgctxt "872"
msgid "You got a copy of <Color:8>Memoirs of an Action Star<Color:Default>."
msgstr "Obtuviste una copia de <Color:8>Crónicas de una estrella de acción<Color:Default>."

#. y4:line_status=translated
msgctxt "980"
msgid "You gained 5,000 EXP."
msgstr "Has obtenido 5000 de EXP."

