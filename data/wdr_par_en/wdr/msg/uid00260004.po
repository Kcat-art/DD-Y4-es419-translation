#. y4:msg_location=T1.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "144_Tanimura"
msgid "I'm from the Dragon Palace. It's time to pay your tab."
msgstr "Soy del Palacio del Dragón. Es hora de pagar la cuenta."

msgctxt "156_Kamei"
msgid "Hmph. I had to beat down that old man just the other day.\\r\n"
"I guess they'll never learn."
msgstr "Hmph. Tuve que golpear a ese viejo el otro día.\\r\n"
"Supongo que nunca aprenderán."

msgctxt "168_Kamei"
msgid "They don't call me \"Doctor Badass\" for nothing, you know.\\r\n"
"I guess you'll soon find out!"
msgstr "No me llaman \"Doctor Brutal\" por nada, ya sabes.\\r\n"
"¡Supongo que pronto lo descubrirás!"
