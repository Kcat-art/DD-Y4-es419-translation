#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=0
msgctxt "108_Takashi"
msgid "Hm, he said the guy would be wearing a blue jacket..."
msgstr "Mmm, dijo que el tipo llevaría una chaqueta azul..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Sketchball
#. y4:msg_speaker_id=1
msgctxt "120_Sketchball"
msgid "Hey, kid."
msgstr "Oi, chico."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Sketchball
#. y4:msg_speaker_id=1
msgctxt "132_Sketchball"
msgid "You don't look like the kinda guy who spends his time in places like these. What do you say I cut you a deal, help you bring in the green?"
msgstr "No pareces el tipo de persona que frecuenta lugares como estos. ¿Qué te parece si te hago una oferta y te ayudo a ganar algo de dinero?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=0
msgctxt "144_Takashi"
msgid "A deal? What kind of deal?"
msgstr "¿Una oferta? ¿De qué tipo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=5
msgctxt "156_Kiryu"
msgid "(Huh? Why is Tanimura involved in this?)"
msgstr "(¿Ese es... Tanimura? ¿Qué hace aquí?)"

#. y4:line_status=translated
msgctxt "168_Sketchball"
msgid "I've got a way to squeeze the yen out of these chumps like\\r\nyou won't believe. And it's my own method, so nobody knows but me."
msgstr "Tengo una manera de sacar yenes a estos tontos que\\r no te lo vas a creer. Y es un método mío, así que nadie lo sabe excepto yo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=0
msgctxt "180_Takashi"
msgid "...How do you do it?"
msgstr "Y... ¿Cómo lo haces?"

#. y4:line_status=translated
msgctxt "192_Sketchball"
msgid "Not so fast. Secrets aren't free, you know? I'm gonna need\\r\na little something in return."
msgstr "No tan rápido. Los secretos no son gratis, ¿sabes?\\r\nVoy a necesitar algo a cambio."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=0
msgctxt "204_Takashi"
msgid "Wait, you're not talking about cheating, are you?"
msgstr "Espera, no estarás hablando de hacer trampa, ¿verdad?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Sketchball
#. y4:msg_speaker_id=1
msgctxt "216_Sketchball"
msgid "It's not cheating if you don't get caught."
msgstr "No es trampa si no te pillan."

#. y4:line_status=translated
msgctxt "228_Sketchball"
msgid "Look, I'm sure you need the spare change. Maybe you've got\\r\na girlfriend you wanna take care of? Or a wife?"
msgstr "Mira, estoy seguro de que necesitas algo de dinero extra. ¿Tal vez\\r\ntienes una novia a la que quieres mantener? ¿O una esposa?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=0
msgctxt "240_Takashi"
msgid "Well..."
msgstr "Bueno..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=5
msgctxt "252_Kiryu"
msgid "(Don't tell me Takashi's going to fall for this...)"
msgstr "(No me digas que Takashi va a caer en esto...)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Sketchball
#. y4:msg_speaker_id=1
msgctxt "264_Sketchball"
msgid "What do you say? Offer's on the table, take it or leave it."
msgstr "¿Qué dices? La oferta está sobre la mesa, lo tomas o lo dejas."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=16
#. y4:msg_location=T1.P16
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=0
msgctxt "276_Takashi"
msgid "I'll pass."
msgstr "Paso."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=17
#. y4:msg_location=T1.P17
#. y4:msg_speaker=Sketchball
#. y4:msg_speaker_id=1
msgctxt "288_Sketchball"
msgid "What? You gotta be kidding me, kid."
msgstr "¿Qué? Tienes que estar de broma, chico."

#. y4:line_status=translated
msgctxt "300_Takashi"
msgid "I'm not. My girlfriend would never want me to cheat to\\r\nstrike it rich. I don't plan on letting her down."
msgstr "Ni loco. Mi novia nunca querría que yo hiciera eso para\\r\ntener dinero. No pienso decepcionarla."

#. y4:line_status=translated
msgctxt "312_Takashi"
msgid "I'd rather bust my ass making a decent, honest living. One I\\r\ncan be proud of, even if it doesn't pay that much."
msgstr "Prefiero partirme el lomo trabajando para tener un sustento digno.\\r\nUno del que pueda estar orgulloso, aunque no gane mucho."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=20
#. y4:msg_location=T1.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=5
msgctxt "324_Kiryu"
msgid "(Guess he's more principled than I realized.)"
msgstr "(Parece que subestimé sus principios)."

#. y4:line_status=translated
msgctxt "336_Sketchball"
msgid "Huh, too bad. This was your chance at a big score, and you\\r\njust left it on the table. Your loss, kid."
msgstr "Vaya, una lástima. Era tu gran oportunidad, y la dejaste\\r\npasar. Tú te lo pierdes."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=25
#. y4:msg_location=T1.P25
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=0
msgctxt "384_Takashi"
msgid "Florist-san? It's Takashi."
msgstr "¿Florista-san? Soy yo, Takashi."

#. y4:line_status=translated
msgctxt "396_Takashi"
msgid "I'm not sure how, but that guy was definitely cheating. I'm\\r\nsure of it."
msgstr "No estoy seguro de cómo, pero ese tipo definitivamente\\r\nestaba haciendo trampas. Se lo prometo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=27
#. y4:msg_location=T1.P27
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=0
msgctxt "408_Takashi"
msgid "Huh? Another job?"
msgstr "¿Eh? ¿Otro trabajo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=28
#. y4:msg_location=T1.P28
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=0
msgctxt "420_Takashi"
msgid "Nakamichi Alley? Sure, I'll head right over."
msgstr "¿El callejón Nakamichi? Claro, iré enseguida."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=30
#. y4:msg_location=T1.P30
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=5
msgctxt "444_Kiryu"
msgid "What did he say, Takashi?"
msgstr "¿Qué te dijo, Takashi?"

#. y4:line_status=translated
msgctxt "456_Takashi"
msgid "Apparently he'll take care of the cheater now that he knows\\r\nwhat he's up to. Oh, and I'm getting sent on another mission."
msgstr "Parece que se encargará del tramposo ahora que sabe lo que\\r\nestá haciendo. Ah, y me han asignado otra misión."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=32
#. y4:msg_location=T1.P32
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=5
msgctxt "468_Kiryu"
msgid "What is it this time?"
msgstr "¿Qué ocurre esta vez?"

#. y4:line_status=translated
msgctxt "480_Takashi"
msgid "Well, some guy in Nakamichi Alley is scouting for new girls\\r\nto join his hostess club. But it sounds more like harassment\\r\nthan regular scouting."
msgstr "Resulta que un tipo en el callejón Nakamichi está reclutando\\r\nchicas para su club de hostess. Pero parece más acoso que\\r\nun reclutamiento normal."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=34
#. y4:msg_location=T1.P34
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=0
msgctxt "492_Takashi"
msgid "So the Florist asked me to stop him."
msgstr "Así que el Florista me pidió que lo detuviera."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=35
#. y4:msg_location=T1.P35
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=5
msgctxt "504_Kiryu"
msgid "Not a bad idea."
msgstr "Ya veo..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=36
#. y4:msg_location=T1.P36
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=0
msgctxt "516_Takashi"
msgid "Welp, I'd better hurry over there. See you later!"
msgstr "Bueno, será mejor que me dé prisa en llegar. ¡Nos vemos!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=38
#. y4:msg_location=T1.P38
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=5
msgctxt "540_Kiryu"
msgid "(...I should probably follow him to Nakamichi Alley. Just to make sure he's safe.)"
msgstr "(...Creo que debería seguirlo hasta el callejón Nakamichi. Nada más para ver que esté bien)."
