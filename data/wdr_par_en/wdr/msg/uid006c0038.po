msgid "Are you proud of anything, Kiryu-san?"
msgstr "¿Kiryu-san, estás orgulloso de algo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
