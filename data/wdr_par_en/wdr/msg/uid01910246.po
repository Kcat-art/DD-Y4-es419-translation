msgctxt "352"
msgid "Jumping"
msgstr "Saltar"

msgctxt "56_Jumping"
msgid "Press <Action:Button_Cross@Chase> to jump during chase events. Timing your jumps allows you to avoid trash cans, bicycles, and other obstacles."
msgstr "Presiona <Action:Button_Cross@Chase> para saltar durante los eventos de persecución. Sincronizar tus saltos te permite evitar botes de basura, bicicletas y otros obstáculos."
