#. y4:msg_speaker_id=0
msgctxt "280_Ajikawa"
msgid "Akiyama-san!"
msgstr "¡Akiyama-san!"

msgctxt "292_Ajikawa"
msgid "You have those \"mouthwatering texture\" and offal dish\\r\n"
"recommendations for me yet?"
msgstr "¿Ya tienes una recomendación de algún Menú, que tenga un\\r\n"
"sabor que haga agua la boca, y el plato de menudos?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Tell Him
msgctxt "304_Akiyama"
msgid "Sure, I'm ready."
msgstr "Sí, lo tengo."

msgctxt "316_Ajikawa"
msgid "First, please tell me what your favorite yakiniku shop is\\r\n"
"called."
msgstr "Bien, en primer lugar dime como se llama tu restaurante de\\r\n"
"yakiniku favorito, por favor."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
