#. y4:msg_branch_segment=T5.P16..P22
#. y4:msg_branch_target_text=Try drinking more slowly. That way you can keep drinking for as long as your friends are.
#. y4:msg_branch_raw=01 11 00 10 00 00 00 19 00 00 00 00 00 00 00 00
msgctxt "17712_Kiryu"
msgid "Try drinking more slowly."
msgstr "Intenta beber más despacio."

