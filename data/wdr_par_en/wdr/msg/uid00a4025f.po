#. y4:line_status=translated
msgctxt "128_Akiyama"
msgid "Hey, how's it going? I'm a scout for a hostess club.\\r\nInterested?"
msgstr "¡Mucho gusto! Trabajo como cazatalentos en un club de hostess,\\r\n¿le interesa?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Subdued Woman
#. y4:msg_speaker_id=2
msgctxt "140_Subdued Woman"
msgid "A hostess club, huh? I don't know..."
msgstr "¿Un club de hostess? Bueno, yo..."

#. y4:line_status=translated
msgctxt "152_Akiyama"
msgid "Oh, I understand completely. You probably have some\\r\nobjections to the industry. But you know..."
msgstr "Oh, ya veo. Supongo que está en contra de ese tipo de “trabajo”,\\r\npero, ¿sabe?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=There's a lot of money in it.
msgctxt "164_Akiyama"
msgid "Just do your best, and you'll be raking in the cash."
msgstr "¡Créame que se hace el mayor esfuerzo para ganar mucho dinero!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
