#. y4:msg_branch_segment=T0.P66..P70
#. y4:msg_branch_target_text=Sodachi-san, huh? Did he really learn fighting theory somewhere? I tell you, he's nothing more than comic relief.
#. y4:msg_branch_raw=01 11 00 42 00 00 00 07 00 00 00 00 00 00 00 00
msgctxt "2916_Saejima"
msgid "Sodachi"
msgstr "Sodachi"

