#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You should try to be more aware of your behavior.
msgctxt "15828_Rio"
msgid "Aware? How?"
msgstr "¿Ser mas consciente? ¿Cómo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
