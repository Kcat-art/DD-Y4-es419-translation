#. y4:msg_branch_target=T6.P21
#. y4:msg_branch_segment=T6.P21..P28
#. y4:msg_branch_target_text=You already told me about this.
#. y4:msg_branch_raw=01 11 00 15 00 00 00 1f 00 00 00 00 00 00 00 00
msgctxt "6444_Kiryu"
msgid "You already told me about this."
msgstr "Pero ya me estás hablando de esto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=22
#. y4:msg_location=T6.P22
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You already told me about this.
msgctxt "6456_Maya"
msgid "Huh!? I did!? Oh no, it happened again!"
msgstr "¿¡Eh!? ¿¡Lo hice!? ¡Caramba, ha vuelto a pasar!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=23
#. y4:msg_location=T6.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You already told me about this.
msgctxt "6468_Kiryu"
msgid "Just kidding."
msgstr "Es broma."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=24
#. y4:msg_location=T6.P24
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You already told me about this.
msgctxt "6480_Maya"
msgid "What!? Why you! Don't scare me like that!"
msgstr "¿¡Qué!? ¡No me asustes así!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=25
#. y4:msg_location=T6.P25
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You already told me about this.
msgctxt "6492_Kiryu"
msgid "Haha. It sounds like you really don't know what you've talked about before."
msgstr "Ja, ja. Parece que realmente no sabes de lo que has hablado antes."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=26
#. y4:msg_location=T6.P26
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You already told me about this.
msgctxt "6504_Maya"
msgid "Yeah, you're right. Maybe I've got a bad memory."
msgstr "Sí, tienes razón. Es posible que tenga mala memoria."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=27
#. y4:msg_location=T6.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You already told me about this.
msgctxt "6516_Kiryu"
msgid "If you tell me about this again, we'll know."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=28
#. y4:msg_location=T6.P28
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You already told me about this.
msgctxt "6528_Maya"
msgid "Then I'd better be extra careful not to mention this again!"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=0
#. y4:msg_location=T7.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "6540_Maya"
msgid "I wish I had a driver's license."
msgstr "Desearía tener una licencia para conducir."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=1
#. y4:msg_location=T7.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "6552_Kiryu"
msgid "You don't have one? Well, you can go to driving school."
msgstr "¿No tienes una? Bueno, siempre puedes ir a la escuela de manejo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=2
#. y4:msg_location=T7.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "6564_Maya"
msgid "I went once, but I took too long, so they kicked me out."
msgstr "Fui una vez, pero tardé mucho y me echaron."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=3
#. y4:msg_location=T7.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "6576_Kiryu"
msgid "Why'd you take so long?"
msgstr "¿Por qué te tardaste tanto?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=4
#. y4:msg_location=T7.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "6588_Maya"
msgid "I was too busy. I couldn't find the time to go to school."
msgstr "Estaba muy ocupada. No encontraba el tiempo para ir a la escuela."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=5
#. y4:msg_location=T7.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "6600_Kiryu"
msgid "Ah. That makes sense."
msgstr "Oh. Eso tiene sentido."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=6
#. y4:msg_location=T7.P6
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=7
#. y4:msg_decision_choices=1. You should get one when you get the chance. -> T7.P7 | 2. You don't need a license. -> T7.P13 | 3. Driving schools can be expensive. -> T7.P19
msgctxt "6612_Maya"
msgid "It's kinda strange for a girl my age to not have a license, huh? I just don't want to go back to driving school."
msgstr "Es raro que una chica de mi edad no tenga carnet, ¿verdad? No quiero volver a la escuela de manejo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=7
#. y4:msg_location=T7.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You should get one when you get the chance.
msgctxt "6624_Kiryu"
msgid "You should get one when you get the chance. Who knows when you might need a license?"
msgstr "Deberías conseguir una cuando tengas la oportunidad. ¿Quién sabe cuándo podrías necesitar una licencia?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=8
#. y4:msg_location=T7.P8
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You should get one when you get the chance.
msgctxt "6636_Maya"
msgid "Yeah, that's a good point. I should make the time to go, huh?"
msgstr "Sí, es un buen punto. Debería dedicar mi tiempo para ir, ¿eh?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=9
#. y4:msg_location=T7.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You should get one when you get the chance.
msgctxt "6648_Kiryu"
msgid "Yeah. Will you buy a car when you get your license?"
msgstr "Sí. ¿Te comprarás un coche cuando te saques la licencia?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=10
#. y4:msg_location=T7.P10
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You should get one when you get the chance.
msgctxt "6660_Maya"
msgid "I want one, but going to driving school costs money too. I'll probably have to wait a while."
msgstr "Quiero uno, pero ir a la escuela de manejo también cuesta dinero. Quizá tenga que esperar un tiempo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=11
#. y4:msg_location=T7.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You should get one when you get the chance.
msgctxt "6672_Kiryu"
msgid "So getting a license is just the first step."
msgstr "Obtener una licencia es solo el primer paso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=12
#. y4:msg_location=T7.P12
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You should get one when you get the chance.
msgctxt "6684_Maya"
msgid "That's right. Okay, I'm really gonna do it this time!"
msgstr "Así es. De acuerdo, ¡esta vez lo voy a hacer de verdad!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=13
#. y4:msg_location=T7.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You don't need a license.
msgctxt "6696_Kiryu"
msgid "If your boyfriend can drive, you don't need a license."
msgstr "Si tu novio puede conducir, no necesitas una licencia."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=14
#. y4:msg_location=T7.P14
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You don't need a license.
msgctxt "6708_Maya"
msgid "But I want to drive myself! And sometimes I need to go shopping."
msgstr "Pero yo quiero conducir. Además, necesito ir de compras."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=15
#. y4:msg_location=T7.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You don't need a license.
msgctxt "6720_Kiryu"
msgid "Go shopping with your boyfriend. You can get him to treat you to dinner, too."
msgstr "Vete de compras con tu novio. También puedes conseguir que te invite a cenar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=16
#. y4:msg_location=T7.P16
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You don't need a license.
msgctxt "6732_Maya"
msgid "Um, I know some girls focus on the size of a man's wallet, but I'm not like that."
msgstr "Sé que algunas chicas se fijan en el tamaño de la cartera de un hombre, pero yo no soy así."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=17
#. y4:msg_location=T7.P17
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You don't need a license.
msgctxt "6744_Maya"
msgid "And if I have enough free time to get a boyfriend, I have enough time to get my license instead."
msgstr "Y si tengo tiempo libre para tener pareja, también lo tengo para sacarme la licencia."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's too bad.
msgctxt "6756_Kiryu"
msgid "Oh."
msgstr "Oh."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=19
#. y4:msg_location=T7.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Driving schools can be expensive.
msgctxt "6768_Kiryu"
msgid "Driving schools can be expensive. I understand why you don't want to go back."
msgstr "Las escuelas de manejo pueden ser caras."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=20
#. y4:msg_location=T7.P20
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Driving schools can be expensive.
msgctxt "6780_Maya"
msgid "Yeah. I wonder if there's some kind of discount I could get."
msgstr "Exacto. Me pregunto si hay algún tipo de descuento que pueda obtener."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=21
#. y4:msg_location=T7.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Driving schools can be expensive.
msgctxt "6792_Kiryu"
msgid "And even after you get your license, it can be expensive to own a car. You'd need to make some changes in your life."
msgstr "E incluso después de sacarte la licencia, puede resultar caro tener un coche. Tendrías que hacer algunos cambios en tu vida."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=22
#. y4:msg_location=T7.P22
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Driving schools can be expensive.
msgctxt "6804_Maya"
msgid "True..."
msgstr "Cierto..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=23
#. y4:msg_location=T7.P23
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Driving schools can be expensive.
msgctxt "6816_Maya"
msgid "But having a car would change my life in other ways. I could go for drives whenever I wanted."
msgstr "Pero tener un coche cambiaría mi vida de otras maneras. Podría salir a dar una vuelta siempre que quisiera."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=24
#. y4:msg_location=T7.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Driving schools can be expensive.
msgctxt "6828_Kiryu"
msgid "And there are places that are hard to get to by train."
msgstr "Y hay lugares a los que son difíciles de llegar en tren."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=25
#. y4:msg_location=T7.P25
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Driving schools can be expensive.
msgctxt "6840_Maya"
msgid "The more I talk about it, the more I want to get a license after all. Maybe I will go back to driving school."
msgstr "Cuanto más hablo de ello, más ganas tengo de sacarme la licencia después de todo. Quizá vuelva a la escuela de manejo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
