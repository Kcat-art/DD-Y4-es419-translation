#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You should try to be more aware of your behavior.
msgctxt "15888_Akiyama"
msgid "Hmm... Now that I've said it, I can't think of anything off the top of my head right now."
msgstr "Mmm... Ahora que lo he dicho, no se me ocurre nada más en este momento."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
#. y4:msg_phrase=15
