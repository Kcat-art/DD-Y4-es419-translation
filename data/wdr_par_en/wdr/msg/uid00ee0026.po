msgid "Foreign Man"
msgstr "Hombre Extranjero"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "128_Tanimura"
msgid "Excuse me, I'd like to pass through here."
msgstr "Disculpe, quiero pasar por aquí."

msgctxt "140_Man"
msgid "這里是進入禁止。"
msgstr "這里是進入禁止。"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "152_Tanimura"
msgid "(Doesn't look like he understands Japanese.)"
msgstr "(Creo que no entiende japonés)."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "164_Tanimura"
msgid "\"Excuse me, are you Chinese? I'm a policeman. Could you let me through?\""
msgstr "\"Disculpe, ¿es chino? Soy policía, ¿me podría dejar pasar?\""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=4
#. y4:msg_location=T2.P4
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=1
msgctxt "176_Man"
msgid "\"Go right ahead.\""
msgstr "\"Adelante\"."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=1
#. y4:msg_location=T3.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "236_Kiryu"
msgid "Hey, could you move?"
msgstr "Oiga, ¿podría moverse?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=2
#. y4:msg_location=T3.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=3
msgctxt "248_Akiyama"
msgid "Hey there, pal. Think you could move out of my way?"
msgstr "Hey, amigo. ¿Podrías moverte?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=3
#. y4:msg_location=T3.P3
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
msgctxt "260_Saejima"
msgid "Hey, you're in my way."
msgstr "Oye, estás en mi camino."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=4
#. y4:msg_location=T3.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "272_Tanimura"
msgid "This place definitely wouldn't have been chosen."
msgstr "Este lugar definitivamente no habría sido elegido."

msgctxt "284_Foreign Man"
msgid "這里是進入禁止。"
msgstr "這里是進入禁止。"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=7
#. y4:msg_location=T3.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "308_Kiryu"
msgid "(A foreigner... Doesn't look like he understands Japanese. I guess I'll avoid Little Asia for now.)"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=8
#. y4:msg_location=T3.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=3
msgctxt "320_Akiyama"
msgid "(Doesn't look like he has any interest in letting me through.)"
msgstr "(Parece que no tiene ningún interés en dejarme pasar.)"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=9
#. y4:msg_location=T3.P9
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=4
msgctxt "332_Saejima"
msgid "(Doesn't look like he's gonna let me through. Best to avoid causin' trouble.)"
msgstr "(No parece que me vaya a dejar pasar. Mejor me evito problemas)."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=4
#. y4:msg_location=T3.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "344_Tanimura"
msgid "This place definitely wouldn't have been chosen."
msgstr "Este lugar definitivamente no habría sido elegido."
