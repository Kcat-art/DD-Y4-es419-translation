#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Don't you gain weight eating like that?
msgctxt "7548_Akiyama"
msgid "Ah. That explains it."
msgstr "Ah. Eso lo explica."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=26
