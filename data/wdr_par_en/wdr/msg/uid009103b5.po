#. y4:msg_decision_choices=1. High-grade Platinum -> T5.P8 | 2. Eye of the Dragon -> T5.P10 | 3. Super High-voltage Battery -> T5.P12 | 4. Never Mind -> T5.P6
msgctxt "548_Akaishi"
msgid "Great. What do you want to exchange them for?"
msgstr "Genial. ¿Por qué quieres intercambiarlos?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=5
#. y4:msg_phrase=14
#. y4:msg_location=T5.P14
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Exchange
msgctxt "632_Akaishi"
msgid "We appreciate all your help."
msgstr "Estamos realmente agradecidos con tu ayuda."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=1
#. y4:msg_location=T6.P1
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=0
msgctxt "656_Akaishi"
msgid "Thanks for your hard work, Tanimura-san."
msgstr "Gracias por tu arduo trabajo, Tanimura-san."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=2
#. y4:msg_location=T6.P2
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=0
msgctxt "668_Akaishi"
msgid "So far, you've resolved %s incidents. Every five you manage to take care of, I'll have to give you something to thank you."
msgstr "Hasta ahora, has resuelto %s incidentes. Por cada cinco resueltos te daré una recompensa como agradecimiento."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=3
#. y4:msg_location=T6.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
msgctxt "680_Tanimura"
msgid "All right."
msgstr "Ah, entiendo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=4
#. y4:msg_location=T6.P4
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=0
msgctxt "692_Akaishi"
msgid "Thank you again for your continued cooperation!"
msgstr "¡Gracias de nuevo por su continua cooperación!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=1
#. y4:msg_location=T6.P1
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=0
