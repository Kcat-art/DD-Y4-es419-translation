#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a good idea.
msgctxt "11880_松岡里緒奈：源氏名"
msgid "What if he doesn't accept my apology?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=9
#. y4:msg_location=T21.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a good idea.
msgctxt "11892_Kiryu"
msgid "The Thunder Matsuoka I know wouldn't do that to his daughter after she'd worked up the courage to apologize."
msgstr "El Thunder Matsuoka que conozco no le haría eso a su hija después de que ella se armara de valor para disculparse."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
