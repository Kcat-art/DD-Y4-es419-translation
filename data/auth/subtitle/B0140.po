#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "199\t259"
msgid "This the place?"
msgstr "¿Este es el lugar?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1366\t1426"
msgid "You first."
msgstr "Tú primero."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1429\t1526"
msgid "Me? How come?"
msgstr "¿Qué? ¿Por qué yo?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1549\t1693"
msgid "Escapin' was your idea, not mine."
msgstr "Tú fuiste el que planeó esta fuga."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1681\t1790"
msgid "Only right you get goin' before me."
msgstr "Por eso mismo, tienes que ir adelante."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1792\t1954"
msgid "Besides, if you don't make it out,\\nthis plan ain't worth shit to me."
msgstr "Además, si no lo logras,\\neste plan no tendría sentido para mí."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2000\t2069"
msgid "The hell are you saying, man?"
msgstr "¿Qué rayos dices?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2086\t2214"
msgid "I'm done makin' mistakes.\\nWonderin' how different things'd be."
msgstr "Ya no quiero fallar otra vez."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2235\t2333"
msgid "And I'm done regrettin', too."
msgstr "Y no pienso arrepentirme de esto."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2337\t2466"
msgid "Yeah, ya might not be the nicest guy."
msgstr "Podrás ser el tipo más horrible del mundo,"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2471\t2594"
msgid "But ya didn't stab me in the back."
msgstr "pero no nunca has traicionado."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "2609\t2684"
msgid "That's all that matters now."
msgstr "Eso es todo lo único que me importa."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2727\t2837"
msgid "Damn, man. You really\\nare stuck in the past."
msgstr "O sea que tú, aún no has\\nsoltado lo de hace veinticinco años..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2838\t2960"
msgid "Just get movin'!\\nThe guards'll be here any second!"
msgstr "¡Ya deja eso!\\n¡Date prisa que vienen los guardias!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4006\t4066"
msgid "Saejima!"
msgstr "¡Saejima!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4347\t4409"
msgid "Saejima, get up here!"
msgstr "¡Saejima! ¡Date prisa!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4421\t4531"
msgid "Saejima! What the hell're you doing!? C'mon!"
msgstr "¡Saejima! ¡¿Qué estás haciendo?! ¡Ven!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4544\t4619"
msgid "Listen. Don't wait up."
msgstr "¡Ve adelantándote!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4674\t4724"
msgid "You outta your mind!?"
msgstr "¡¿Qué rayos estás diciendo?!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4725\t4811"
msgid "I'm gonna buy ya a bit of time."
msgstr "Yo los detendré por un rato."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4830\t4944"
msgid "You start swimmin'. Go."
msgstr "Así podrás llegar al mar y escapar."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4976\t5036"
msgid "Saejima..."
msgstr "Saejima..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5113\t5173"
msgid "Just move!"
msgstr "¡Apresúrate!"

