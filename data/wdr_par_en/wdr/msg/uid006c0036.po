#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe that's your fate.
msgctxt "8700_松岡里緒奈：源氏名"
msgid "Then maybe my luck won't get any better if we start seeing each other..."
msgstr "Entonces puede que mi suerte no mejore si empezamos a vernos..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
