msgstr "Basura blanda. Ni idea de lo que es."

#. y4:line_status=translated
msgctxt "24048"
msgid "Good Metal Garbage"
msgstr "Basura metálica buena"

#. y4:line_status=translated
msgctxt "102858"
msgid "Good metal garbage."
msgstr "Basura metálica buena."

#. y4:line_status=translated
msgctxt "24067"
msgid "Fair Metal Garbage"
msgstr "Basura metálica normal"

