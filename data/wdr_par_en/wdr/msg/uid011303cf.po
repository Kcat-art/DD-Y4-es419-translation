#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2196_Saejima"
msgid "What's the matter? What's that sigh for?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=26
#. y4:msg_location=T1.P26
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2208_Ehama"
msgid "I was just thinking about my wife and son leaving me."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=27
#. y4:msg_location=T1.P27
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2220_Ehama"
msgid "When I think about it, I must have been a pretty lousy father. My wife took care of everything."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=28
#. y4:msg_location=T1.P28
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2232_Ehama"
msgid "And I <Italic>still</Italic> didn't carry out any of my family duties."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=1
#. y4:msg_phrase=29
#. y4:msg_location=T1.P29
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=His sense o' justice.
msgctxt "2244_Ehama"
msgid "I never did well at work either, and ended up getting laid off. Anyone in their right mind would have left me."
msgstr ""

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
