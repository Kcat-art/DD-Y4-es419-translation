#. y4:msg_branch_target_text=You came to Tokyo all by yourself?
#. y4:msg_branch_raw=01 11 00 14 00 00 00 22 00 00 00 00 00 00 00 00
msgctxt "4320_Akiyama"
msgid "You came to Tokyo all by yourself?"
msgstr "¿Viniste a Tokio sola?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You came to Tokyo all by yourself?
msgctxt "4332_Erena"
msgid "Yep. But my sister will be coming soon, too."
msgstr "Sip, pero mi hermana vendrá pronto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You came to Tokyo all by yourself?
msgctxt "4344_Akiyama"
msgid "Oh? Is she a college student or something?"
msgstr "¿Ah, sí? ¿Es universitaria o algo así?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You came to Tokyo all by yourself?
msgctxt "4356_Erena"
msgid "No. She's the same as me."
msgstr "No. Está igual que yo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You came to Tokyo all by yourself?
msgctxt "4368_Akiyama"
msgid "The same? You mean she's a hostess, too?"
msgstr "¿Igual? ¿O sea que también es una hostess?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You came to Tokyo all by yourself?
msgctxt "4380_Erena"
msgid "Yeah. We both work at hostess clubs."
msgstr "Sí. Las dos trabajamos en lo mismo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You came to Tokyo all by yourself?
msgctxt "4392_Akiyama"
msgid "For real?"
msgstr "¿En serio?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You came to Tokyo all by yourself?
msgctxt "4404_Erena"
msgid "Surprised? Haha."
msgstr "¿Te sorprende? Ja, ja."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You came to Tokyo all by yourself?
msgctxt "4416_Akiyama"
msgid "Sort of. But it's interesting."
msgstr "Más o menos. Pero me parece interesante."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You came to Tokyo all by yourself?
msgctxt "4428_Erena"
msgid "That's not even the craziest part! For a while, we were both workin' at the same club!"
msgstr "¡Y eso ni siquiera es lo mejor! ¡Llegamos a trabajar en el mismo club!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You came to Tokyo all by yourself?
msgctxt "4440_Akiyama"
msgid "Wow. So is she planning on working here, then?"
msgstr "Vaya, ¿entonces va a venir a trabajar acá?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=31
#. y4:msg_location=T0.P31
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You came to Tokyo all by yourself?
msgctxt "4452_Erena"
msgid "Maybe."
msgstr "Tal vez."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=123
#. y4:msg_phrase=0
#. y4:msg_location=T123.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T0.P32
#. y4:msg_branch_segment=T0.P32..P41
#. y4:msg_branch_target_text=I guess Kyoto is a bit slower-paced, huh?
#. y4:msg_branch_raw=01 11 00 20 00 00 00 29 00 00 00 00 00 00 00 00
msgctxt "4464_Akiyama"
msgid "I guess Kyoto is a bit slower-paced, huh?"
msgstr "Supongo que los lentos son los de Kioto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess Kyoto is a bit slower-paced, huh?
msgctxt "4476_Erena"
msgid "They walk so slow! I always get so annoyed when I'm stuck walkin' behind someone."
msgstr "¡Son muy lentos! Me estresa bastante ir detrás de alguien y ver cómo camina tan lento."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=34
#. y4:msg_location=T0.P34
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess Kyoto is a bit slower-paced, huh?
msgctxt "4488_Akiyama"
msgid "I know the feeling."
msgstr "Te entiendo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=35
#. y4:msg_location=T0.P35
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess Kyoto is a bit slower-paced, huh?
msgctxt "4500_Erena"
msgid "Of course, people tell me that I walk fast, so that may be part of it."
msgstr "Sí, aunque la gente me dice que soy de caminar rápido, así que puede ser eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=36
#. y4:msg_location=T0.P36
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess Kyoto is a bit slower-paced, huh?
msgctxt "4512_Akiyama"
msgid "Yeah, if you're a fast walker and most people from Kyoto walk slowly, it must seem especially slow."
msgstr "Puede ser, si de por sí caminas rápido, como camina la gente de Kioto debe ser peor."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=37
#. y4:msg_location=T0.P37
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess Kyoto is a bit slower-paced, huh?
msgctxt "4524_Akiyama"
msgid "But Tokyo is just about perfect for you, huh?"
msgstr "Pero Tokio te calza perfecto, ¿no?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=38
#. y4:msg_location=T0.P38
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess Kyoto is a bit slower-paced, huh?
msgctxt "4536_Erena"
msgid "Oh yeah, totally!"
msgstr "¡Ah sí, sin duda!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=39
#. y4:msg_location=T0.P39
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess Kyoto is a bit slower-paced, huh?
msgctxt "4548_Akiyama"
msgid "Heheh. Sounds like you might fit in better here than at home. When it comes to walking at a fast pace, at least."
msgstr "Me parece que podrías encajar mejor acá que donde vivías, por lo menos si de caminar rápido se trata."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=40
#. y4:msg_location=T0.P40
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess Kyoto is a bit slower-paced, huh?
msgctxt "4560_Erena"
msgid "Yeah... But I am gettin' annoyed with the crowds here."
msgstr "Sí... Pero aun así, me molestan las multitudes."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=41
#. y4:msg_location=T0.P41
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess Kyoto is a bit slower-paced, huh?
msgctxt "4572_Akiyama"
msgid "Heheh, I guess every place has its pros and cons."
msgstr "Supongo que cada lugar tiene sus pros y sus contras."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
