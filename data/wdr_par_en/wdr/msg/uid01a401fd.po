msgctxt "56_Saejima"
msgid "Alright, now. Where's the taxi stand from here?"
msgstr "Bien. ¿Hacia donde está la parada de taxis desde aquí?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Makiko
#. y4:msg_speaker_id=2
msgctxt "68_Makiko"
msgid "Park Boulevard East. By the entrance to West Park."
msgstr "Al este del Parque Boulevard. Por de la entrada del Parque Oeste."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "80_Saejima"
msgid "Yeah? Been outta town a while. Gotta get my bearings again."
msgstr "¿Sí? No había estado en la ciudad hace mucho tiempo. Tengo que volver a orientarme."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "92_Saejima"
msgid "Welp, let's hustle."
msgstr "Pues bien, apurémonos."

msgctxt "104_Makiko"
msgid "Don't boss me around. You're my bodyguard!\\r\n"
"Would a little professionalism literally kill you?"
msgstr "No me des órdenes. ¡Eres mi guardaespaldas!\\r\n"
"¿Acaso no puedes ser un poco más profesional?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "116_Saejima"
msgid "Huh?"
msgstr "Uh, ¿y eso?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Makiko
#. y4:msg_speaker_id=2
msgctxt "128_Makiko"
msgid "Honestly. Where'd President Useless find this weirdo...?"
msgstr "¿De verdad? ¿De dónde habrá salido este rarito...?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "140_Saejima"
msgid "What're ya waitin' for? C'mon, West Park ain't far."
msgstr "¿Qué esperas? Vamos, el Parque Oeste no está tan lejos."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Makiko
#. y4:msg_speaker_id=2
msgctxt "152_Makiko"
msgid "Hang on. I need to use the ladies' room."
msgstr "Espera un poco. Necesito usar el baño."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "164_Saejima"
msgid "Then hold it. There's stalkers after ya, remember?"
msgstr "Entonces aguántate. Tienes acosadores, ¿recuerdas?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Makiko
#. y4:msg_speaker_id=2
msgctxt "176_Makiko"
msgid "Sorry, I can't hold it. Wait here, I'll be right back."
msgstr "Lo siento, pero no me puedo aguantar. Espérame aquí, Ya vuelvo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "200_Saejima"
msgid "(Man. This kid's a real pain in the ol' asshole.)"
msgstr "(Vaya. Esta chica es un verdadero dolor de cabeza)"

