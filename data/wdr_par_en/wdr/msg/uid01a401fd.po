#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Takeda
#. y4:msg_speaker_id=7
msgctxt "320_Takeda"
msgid "Saejima-san! Where's Makiko-chan?"
msgstr "¡Saejima-san! ¿Dónde está Makiko-chan?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "332_Saejima"
msgid "She's on the can. I'm just waitin' for her to wipe up."
msgstr "Está en el baño. La estoy esperando a que se limpie."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Takeda
#. y4:msg_speaker_id=7
msgctxt "344_Takeda"
msgid "The bathroom at the office? But she didn't come back in!"
msgstr "¿El baño de la oficina? ¡Pero si ni volvió a entrar!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "356_Saejima"
msgid "Guess she got away."
msgstr "Supongo que se ha escapado."

msgctxt "368_Takeda"
msgid "Oh, no! Some trolls just posted on her fansite,\\r\n"
"threatening to attack her! You don't think...?"
msgstr "¡Oh, no! ¡Unos trolls acaban de postear en su fanpage,\\r\n"
"que irán a atacarla! ¿Crees que la hayan...?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "380_Saejima"
msgid "Alright, I'll find her. You go tell your boss."
msgstr "Bueno, iré a buscarla. Infórmale a tu jefa."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Takeda
#. y4:msg_speaker_id=7
msgctxt "392_Takeda"
msgid "On it!"
msgstr "¡Voy!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "416_Saejima"
msgid "(Well, fuck me. Better check around here first.)"
msgstr "(Vaya, maldita sea. Será mejor que la busque por aquí cerca primero.)"
