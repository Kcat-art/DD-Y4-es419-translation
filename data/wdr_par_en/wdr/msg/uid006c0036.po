msgid "What's wrong? Did you drink too much?"
msgstr "¿Qué pasa? ¿Has bebido demasiado?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
