#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=5
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I need to prepare some more.
msgctxt "344_Saejima"
msgid "I'm gonna go get warmed up."
msgstr "Voy a calentar."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I need to prepare some more.
msgctxt "368_Tanimura"
msgid "I should get ready, too."
msgstr "Debería prepararme también."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=17
#. y4:msg_location=T1.P17
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I need to prepare some more.
msgctxt "392_Man"
msgid "Very well. Just let me know when you're ready. I'll be waiting here until dawn."
msgstr "Muy bien. Hazmelo saber cuando estés listo. Esperaré aquí hasta el amanecer."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
msgctxt "428_Man"
msgid "Ah, Kiryu-san. I've heard quite a bit about you. Please, allow me to be your guide."
msgstr "Ah, Kiryu-san. He oído hablar bastante de tí. Por favor, déjame ser tu guía."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "440_Kiryu"
msgid "All right..."
msgstr "Claro..."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
