msgid "My name is Sodachi and this is Saejima-san. Shall we go ahead and start training then?"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Ehama
#. y4:msg_speaker_id=9
