#. y4:msg_branch_target=T9.P17
#. y4:msg_branch_segment=T9.P17..P23
#. y4:msg_branch_target_text=That's your special talent?
#. y4:msg_branch_raw=01 11 00 11 00 00 00 1b 00 00 00 00 00 00 00 00
msgctxt "7824_Tanimura"
msgid "That's your special talent?"
msgstr "¿Ese es tu talento especial?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=18
#. y4:msg_location=T9.P18
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's your special talent?
msgctxt "7836_Chihiro"
msgid "Isn't it great? I practiced for a while!"
msgstr "¿No es genial? ¡Llevo tiempo practicándolo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=19
#. y4:msg_location=T9.P19
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's your special talent?
msgctxt "7848_Tanimura"
msgid "Er... It's a little underwhelming."
msgstr "Eh... No es gran cosa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=20
#. y4:msg_location=T9.P20
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's your special talent?
msgctxt "7860_Chihiro"
msgid "Oh... Well, at least you're honest."
msgstr "Ah... Bueno, por lo menos está siendo honesto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=21
#. y4:msg_location=T9.P21
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's your special talent?
msgctxt "7872_Tanimura"
msgid "But it's just my personal opinion."
msgstr "Pero es solo mi opinión."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=22
#. y4:msg_location=T9.P22
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That's your special talent?
msgctxt "7884_Chihiro"
msgid "No, I get it. I won't show off my special talents anymore."
msgstr "No, no. Lo entiendo. Ya no voy a mostrar más mi talento especial."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
