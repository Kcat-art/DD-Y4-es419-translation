#. y4:msg_location=T2.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "4848_Kiryu"
msgid "That's a big dream."
msgstr "Es un buen objetivo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
