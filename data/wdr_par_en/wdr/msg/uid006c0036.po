msgctxt "7128_松岡里緒奈：源氏名"
msgid "But there could still be something wrong with me, right?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=16
#. y4:msg_location=T8.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You're young. I'm sure you'll be fine.
msgctxt "7140_Kiryu"
msgid "If there is, I'll look after you."
msgstr "Si lo hay, cuidaré de ti."

msgctxt "7152_松岡里緒奈：源氏名"
msgid "You will? That's so kind of you! <Color:7>♥<Color:Default>"
msgstr "¿Lo harás? ¡Eso es muy amable de su parte! <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
