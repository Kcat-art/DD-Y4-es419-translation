msgid "(If I have to look, might as well be here...)"
msgstr "(Si tengo que mirar, mejor que sea aquí...)"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=21
#. y4:msg_phrase=0
#. y4:msg_location=T21.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
