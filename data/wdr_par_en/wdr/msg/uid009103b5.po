#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Come Back Later
msgctxt "536_Akaishi"
msgid "Okay. Let me know if you change your mind."
msgstr "Bueno. Me avisas si cambias de opinión."

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=1
