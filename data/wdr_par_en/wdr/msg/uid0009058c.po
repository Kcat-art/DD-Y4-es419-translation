#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "84_Tanimura"
msgid "Hey, you there. Mind explaining why you're loitering around?"
msgstr "Eh, tú. ¿Me puede explicar por qué está dando vueltas por aquí?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Businessman
#. y4:msg_speaker_id=1
msgctxt "96_Businessman"
msgid "Eep! Are you with the police!?"
msgstr "¡¡Ah!! ¿¡No me digas que eres... un policía!?"

#. y4:line_status=translated
msgctxt "108_Tanimura"
msgid "That's right. Now state your business here. If I didn't\\r\nknow any better, I'd say you were up to something shady."
msgstr "Efectivamente. Ahora diga qué lo trae por aquí. Si no\\r\nsupiera, juraría que está en algo ilícito."

#. y4:line_status=translated
msgctxt "120_Businessman"
msgid "Ah, no, that's not... Uh... Look, officer, I'm just a normal\\r\nguy trying to decide which club to go. Honest to goodness!"
msgstr "Ah, no, eso no es... Ehh... Mire, Soy solo un tipo normal\\r\ntratando de decidir a qué club ir. ¡De verdad!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "132_Tanimura"
msgid "What? Are you serious?"
msgstr "¿Qué? ¿Hablas en serio?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Businessman
#. y4:msg_speaker_id=1
msgctxt "144_Businessman"
msgid "Yeah... See, I've been hearing good things about both Midori over here and the massage parlor to the east."
msgstr "Sí... Me han llegado buenos rumores sobre el lugar Midori aquí y sobre el salón de masajes que está al este."

#. y4:line_status=translated
msgctxt "156_Businessman"
msgid "I've been standing here for what feels like hours trying to\\r\ndecide, but... Agh! I still can't make up my mind!"
msgstr "Llevo horas aquí parado dándole vueltas al asunto, pero...\\r\n¡Uf! ¡Sigo sin poder decidirme!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "168_Tanimura"
msgid "Uh...huh. Well, okay then. Sorry to bother you."
msgstr "...Entiendo. Perdón por interrumpir."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Businessman
#. y4:msg_speaker_id=1
msgctxt "180_Businessman"
msgid "Oh, no problem. I just wish I could make a decision..."
msgstr "Oh, no se preocupe. Solo quisiera poder tomar una decisión..."
