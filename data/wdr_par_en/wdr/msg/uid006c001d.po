#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's a positive way to look at things.
msgctxt "8760_Akiyama"
msgid "Not at all! A pessimist wouldn't put in the hard work like you're doing!"
msgstr "Para nada. ¡Un pesimista no se esforzaría tanto como tú!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
