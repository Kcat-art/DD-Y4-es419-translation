#. y4:msg_decision_choices=1. Sorry, not this time. -> T0.P44 | 2. All right, sure. -> T0.P46
msgctxt "616_Haruka"
msgid "I wanna go, too! Can I come with you?"
msgstr "¡Yo también quiero ir! ¿Puedo ir contigo?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
