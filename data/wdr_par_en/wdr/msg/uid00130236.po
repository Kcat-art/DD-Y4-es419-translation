msgctxt "128_Tanimura"
msgid "I'm with the police! You oughta think twice about fighting in the middle of the street!"
msgstr "¡Soy de la policía! ¡Deberías pensártelo dos veces antes de pelear en medio de la calle!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "140_Stern-Looking Yakuza"
msgid "Aw, shit..."
msgstr "Tch, mierda..."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "152_Infuriated Yakuza"
msgid "Better back your po-lice ass up, or you're gonna be the first one I take out!"
msgstr "Mejor mueve tu politrasero o ¡yo seré el primero en patearte fuera de aquí!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
#. y4:msg_role=decision
#. y4:msg_decision_role=prompt
#. y4:msg_decision_group=0
msgctxt "164_Tanimura"
msgid "(He sure took off in a hurry...)"
msgstr "(Sin duda, salió corriendo a toda prisa...)"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "176_Tanimura"
msgid "Hey, get back here! Stop!"
msgstr "¡Oye, vuelve aquí! ¡Alto!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "200_Tanimura"
msgid "Might as well take this guy on first. He seems to love police officers."
msgstr "Mejor empezar por este tipo. Parece que le encantan los policías."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "212_Tanimura"
msgid "You asked for it!"
msgstr "¡Tú lo pediste!"

