#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Tell Him
msgctxt "340_Akiyama"
msgid "It's \"Banrai,\" on Shichifuku Street."
msgstr "Eh... \"Banrai\" de la calle Shichifuku."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
