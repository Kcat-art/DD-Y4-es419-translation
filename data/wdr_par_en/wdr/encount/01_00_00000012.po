#. y4:msg_location=T2.P0
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
msgctxt "152_Man"
msgid "Urgh... I'm sorry! Forgive me! I was totally out of bounds!"
msgstr "Urgh... ¡Lo siento! ¡Perdóname! ¡Estaba totalmente fuera de lugar!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
