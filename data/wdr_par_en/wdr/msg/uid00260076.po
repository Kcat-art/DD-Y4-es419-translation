#. y4:line_status=translated
msgctxt "468_Date"
msgid "Man... I don't even know how to start with this one. This is\\r\ntougher than any case I've ever handled."
msgstr "Uf... no sé ni por dónde empezar con esto. Es más difícil\\r \nque cualquier caso en el que haya trabajado."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=12
msgctxt "480_Kiryu"
msgid "Date-san, what's all the noise?"
msgstr "Date, ¿qué es todo este ruido?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=1
msgctxt "492_Date"
msgid "Kiryu! Just the guy I wanted to see!"
msgstr "¡Kiryu! ¡Justo el hombre que andaba buscando!"

#. y4:line_status=translated
msgctxt "504_Date"
msgid "I'm in a real bind here! Think you can get this kid to shut\\r\nup for me?"
msgstr "¡Estoy en apuros! ¿Serías capaz de hacer que este nene\\r\nse calle por mí?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=12
msgctxt "516_Kiryu"
msgid "Me? I don't know what to do with a baby! Whose kid is it, anyway?"
msgstr "¿Yo? ¡No tengo ni idea de bebés! ¿De quién es, por cierto?"

#. y4:line_status=translated
msgctxt "528_Date"
msgid "We can talk about that later! I've just about gone deaf from\\r\nan hour of this damn crying! Just take him!"
msgstr "¡Eso lo podemos discutir después! ¡Estoy por quedarme sordo\\r\ndespués de una hora de aguantar estos llantos! ¡Llévatelo!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=12
msgctxt "540_Kiryu"
msgid "What makes you think I'll do any better?"
msgstr "¿Qué te hace pensar que yo lo haré mejor?"

#. y4:line_status=translated
msgctxt "552_Date"
msgid "You've got an orphanage, don't you? You probably deal with\\r\nthis stuff all the time!"
msgstr "Tienes un orfanato, ¿no? ¡Seguro que estás acostumbrado\\r\na estas cosas!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=12
msgctxt "564_Kiryu"
msgid "I mean, yeah... but they're grade schoolers."
msgstr "A ver, sí... pero son estudiantes de primaria."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=1
msgctxt "576_Date"
msgid "Grade schoolers, babies, what's the difference? Just take him!"
msgstr "Estudiantes de primaria, bebés, ¿cuál es la diferencia? \\r\n¡Sólo llévatelo!"

#. y4:line_status=translated
msgctxt "588_Kiryu"
msgid "Hold on. You already went through all this when you had your\\r\ndaughter. You should know way more than I do!"
msgstr "Un momento. Tú ya pasaste por esto cuando tuviste a tu hija.\\r\n¡Deberías saber más de esto que yo!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=1
msgctxt "600_Date"
msgid "Yeah, and if I were any good at taking care of kids, I'd still be happily married."
msgstr "Sí, y si se me diera bien cuidar de ellos, \\r\nseguiría felizmente casado."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=12
msgctxt "612_Kiryu"
msgid "...Guess you have a point."
msgstr "...Tienes toda la razón."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Date
#. y4:msg_speaker_id=1
msgctxt "624_Date"
msgid "Well then, just give it up and take him!"
msgstr "¡Bueno, basta ya, llévatelo!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=12
msgctxt "708_Kiryu"
msgid "Here we go..."
msgstr "Allá vamos..."

