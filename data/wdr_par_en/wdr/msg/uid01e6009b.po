#. y4:msg_speaker_id=0
msgctxt "168_Hana"
msgid "Hi, Chief."
msgstr "Hola, jefe."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=1
#. y4:msg_location=T4.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "180_Akiyama"
msgid "Hi, Hana-chan. I brought you something to eat."
msgstr "Hola, Hana-chan. Te he traído algo de comer."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=2
#. y4:msg_location=T4.P2
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "192_Hana"
msgid "You whaaat!?"
msgstr "¡¿Que tu quééé?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=3
#. y4:msg_location=T4.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "204_Akiyama"
msgid "The deluxe kalbi lunch set from Kanrai. Your favorite!"
msgstr "El set de kalbi de lujo del Kanrai. ¡Tu favorito!"

msgctxt "216_Hana"
msgid "Oh, uh, thank you very much! But I'm not very hungry... You\\r\n"
"can have it."
msgstr "Oh, uh, ¡pues muchas gracias! Pero no tengo mucha hambre... Te\\r\n"
"lo puedes comer tú."

msgctxt "228_Akiyama"
msgid "What? But you love their special kalbi! Just take it. You\\r\n"
"can always eat it later."
msgstr "¿Cómo? ¡Pero si te encanta su kalbi especial! Mejor guárdalo. Siempre\\r\n"
"te los puedes comer luego."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=6
#. y4:msg_location=T4.P6
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "240_Hana"
msgid "It'd be a shame to let it spoil. Please, eat it."
msgstr "Sería una lástima que se pudra. Por favor, comételo tú."

msgctxt "252_Akiyama"
msgid "Well, all right... But what's going on? Ordinarily, you'd be\\r\n"
"snatching it out of my hands."
msgstr "Bueno, pues... ¿Te pasa algo? Normalmente, ya me lo estarías\\r\n"
"quitando de las manos."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=11
#. y4:msg_location=T4.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "300_Akiyama"
msgid "Are you sure you're not hungry, Hana-chan?"
msgstr "¿Segura que no tienes hambre, Hana-chan?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=12
#. y4:msg_location=T4.P12
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "312_Hana"
msgid "I'm sure. Please eat it."
msgstr "Estoy segurísima. Por favor, comételo tú."

msgctxt "324_Akiyama"
msgid "Well, I say something's up. But if you really don't need it,\\r\n"
"I'm not going to force you."
msgstr "Está bien, Diría que te pasa algo. Pero si de verdad no lo quieres,\\r\n"
"No te voy a forzar."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=19
#. y4:msg_location=T4.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "396_Akiyama"
msgid "You're not on a diet, are you, Hana-chan?"
msgstr "Hana-Chan, no estarás a dieta, ¿verdad?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=20
#. y4:msg_location=T4.P20
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "408_Hana"
msgid "......"
msgstr "......"

msgctxt "420_Akiyama"
msgid "That's it, isn't it! You're dieting! I just know it! Well,\\r\n"
"am I right? Huh?"
msgstr "Es eso, ¿verdad? ¡Estás a dieta! ¡Lo sabía!\\r\n"
"¿Le atiné, cierto?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=22
#. y4:msg_location=T4.P22
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "432_Hana"
msgid "Enough!"
msgstr "¡Suficiente!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=23
#. y4:msg_location=T4.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "444_Akiyama"
msgid "Yikes!"
msgstr "¡Vaya!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=24
#. y4:msg_location=T4.P24
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "456_Hana"
msgid "So what if I'm dieting? What's wrong with that?"
msgstr "¿Y qué si estoy a dieta? ¿Algún problema?"

msgctxt "468_Akiyama"
msgid "Nothing... It's just－my Hana-chan, dieting?"
msgstr "Nada... Es solo que... － mi Hana-chan, ¿a dieta?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=26
#. y4:msg_location=T4.P26
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "480_Hana"
msgid "Are you saying it'd be pointless for me to diet?"
msgstr "¿Estás insinuando que no tiene sentido que haga dieta?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=27
#. y4:msg_location=T4.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "492_Akiyama"
msgid "No, no, that's not it at all..."
msgstr "No, no, para nada..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=28
#. y4:msg_location=T4.P28
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "504_Hana"
msgid "Well, what is it, then!?"
msgstr "Bueno, entonces, ¿Qué es, si no?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=29
#. y4:msg_location=T4.P29
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "516_Akiyama"
msgid "You're wonderful just the way you are."
msgstr "Eres maravillosa tal y como eres."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=30
#. y4:msg_location=T4.P30
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "528_Hana"
msgid "Don't gimme that crap, Chief! Men don't date fat women."
msgstr "¡No me vengas con esa basura, Jefe! A los hombres no les gusta salir con gordas."

msgctxt "540_Akiyama"
msgid "That's not true. There are plenty of men who'd gladly prefer\\r\n"
"a curvier woman like yourself."
msgstr "Eso no es cierto. Hay muchos hombres que con gusto prefieren\\r\n"
"chicas curvilíneas como tú."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=32
#. y4:msg_location=T4.P32
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "552_Hana"
msgid "Hmm..."
msgstr "Mmm..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=33
#. y4:msg_location=T4.P33
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "564_Akiyama"
msgid "What?"
msgstr "¿Qué?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=34
#. y4:msg_location=T4.P34
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "576_Hana"
msgid "Okay, then, bring me one."
msgstr "Bien, pues, tráeme uno."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=35
#. y4:msg_location=T4.P35
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "588_Akiyama"
msgid "Bring you one what?"
msgstr "¿Traerte un qué?"

msgctxt "600_Hana"
msgid "You have thirty minutes to bring in a man who likes chubby\\r\n"
"girls like me!"
msgstr "¡Te doy treinta minutos para que me traigas un chico que al que le guste una chica gordita\\r\n"
"como yo!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=37
#. y4:msg_location=T4.P37
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "612_Akiyama"
msgid "Kinda short notice, don't you think...?"
msgstr "Que poca antelación, ¿No crees...?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=38
#. y4:msg_location=T4.P38
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "624_Hana"
msgid "If there are so many of them, one measly man should be easy to find!"
msgstr "Si crees que hay tantos, ¡un mísero hombre debería ser fácil de encontrar!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=39
#. y4:msg_location=T4.P39
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "636_Akiyama"
msgid "But..."
msgstr "Pero..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=40
#. y4:msg_location=T4.P40
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "648_Hana"
msgid "You have twenty-nine minutes and forty-five seconds left... Forty-four... Forty-three..."
msgstr "Te van quedando veintinueve minutos y cuarenta y cinco segundos... Cuarenta y cuatro... Cuarenta y tres..."
