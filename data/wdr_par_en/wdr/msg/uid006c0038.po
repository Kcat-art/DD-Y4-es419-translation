#. y4:msg_location=T10.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "7764_Kiryu"
msgid "Is your band okay?"
msgstr "Pero, ¿tu banda está bien?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=5
#. y4:msg_location=T10.P5
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "7776_望月京子：源氏名"
msgid "For the moment. But I heard them talking smack about us."
msgstr "Hasta ahora no paso nada. Pero ya me llego que hablan mal de mi banda."

