#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
msgctxt "152_Man"
msgid "Sorry for going off on you like that."
msgstr "Siento haberme ido así de la lengua."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=0
msgctxt "164_Man"
msgid "This oughta put things right again."
msgstr "Esto debería arreglar las cosas."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
