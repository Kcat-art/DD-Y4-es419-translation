#. y4:item_icon=2d_yk_fudoumyouounobelt
#. y4:item_field=description
#. y4:item_pair_context=33627
msgctxt "133003"
msgid "This belt helps you lift heavy enemies as if they weigh nothing at all."
msgstr "Este cinturón te ayuda a levantar enemigos pesados como si no pesaran nada."

#. y4:line_status=translated
#. y4:item_index=897
#. y4:item_id=shisanobelt
#. y4:item_icon=2d_yk_shisanobelt
