#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=There's nothing wrong with being devoted.
msgctxt "4800_Maya"
msgid "Ha! I hadn't thought of that! I guess that's possible."
msgstr "¡Ja! ¡No lo había pensado! Pero creo que es posible."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
