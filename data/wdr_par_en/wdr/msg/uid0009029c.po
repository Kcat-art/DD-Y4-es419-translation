#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Kiss-ass
#. y4:msg_speaker_id=0
msgctxt "80_Kiss-ass"
msgid "Well, hello there, Akiyama-san! Fancy meeting you here!"
msgstr "Oh, ¡hola, Akiyama-san! ¡Qué coincidencia!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "92_Akiyama"
msgid "I'm sorry. You are...?"
msgstr "Disculpe, ¿pero usted es...?"

#. y4:line_status=translated
msgctxt "104_Arima"
msgid "The competition! You've no doubt heard of Tenjin Loans.\\r\nI'm Arima, its president."
msgstr "¡La competencia! Seguro que ha oído hablar de Préstamos Tenjin.\\r\nSoy Arima, su presidente."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "116_Akiyama"
msgid "Ah, yes. I've heard rumors."
msgstr "Ah, sí. He oído rumores."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Arima
#. y4:msg_speaker_id=3
msgctxt "128_Arima"
msgid "Well, we won't get into what kind of rumors! Haha."
msgstr "Bueno, ¡no necesita creer en esos rumores! Ja, ja."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "140_Akiyama"
msgid "Did you need something?"
msgstr "¿Tienes algún asunto conmigo?"

#. y4:line_status=translated
msgctxt "152_Arima"
msgid "I was just heading over to your office to talk to you about\\r\na little something."
msgstr "No, en realidad quería consultarte sobre un pequeño asunto.\\r\nPor eso iba de camino a tu oficina."

#. y4:line_status=translated
msgctxt "164_Arima"
msgid "My office is right over there, though. Mind if I take a\\r\nminute of your time?"
msgstr "Pero mira, mi oficina está justo ahí. ¿Le importa si tomo un\\r\nminuto de tu tiempo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "176_Akiyama"
msgid "......"
msgstr "......"

#. y4:line_status=translated
msgctxt "188_Arima"
msgid "Don't worry, I won't bite. Really, I just want you to hear\\r\nme out."
msgstr "No te preocupes, yo no muerdo. Realmente solo me gustaría\\r\nque me escuches un ratito."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "200_Akiyama"
msgid "All right, I'd be happy to."
msgstr "Bueno, entonces iré."
