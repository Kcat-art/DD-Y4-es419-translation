#. y4:msg_branch_choice=I could pick out an outfit for you.
msgctxt "10476_Kiryu"
msgid "Of course. I even trained a few hostesses in the past."
msgstr "Claro. Incluso entrené a algunas hostess en el pasado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
