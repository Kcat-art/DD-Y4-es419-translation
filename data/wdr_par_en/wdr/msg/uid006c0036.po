#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a good idea.
msgctxt "11904_松岡里緒奈：源氏名"
msgid "Yeah, you're probably right!"
msgstr "¡Sí, probablemente tengas razón!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=11
