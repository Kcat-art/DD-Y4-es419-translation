msgctxt "300"
msgid "Quit"
msgstr "Salir"

#. y4:line_status=translated
msgctxt "305"
msgid "Cancel the order."
msgstr "Cancelar el pedido."

#. y4:line_status=translated
msgctxt "323"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=translated
msgctxt "329"
msgid "Order the currently selected item."
msgstr "Pagar el objeto seleccionado actualmente."

#. y4:line_status=translated
msgctxt "364"
msgid "(I haven't picked anything.)"
msgstr "(No he escogido nada)"

#. y4:line_status=translated
msgctxt "393"
msgid "(I'm short on cash.)"
msgstr "(Me hace falta dinero)"

#. y4:line_status=translated
msgctxt "414"
msgid "Very well, sir."
msgstr "Muy bien, señor."

#. y4:line_status=translated
msgctxt "430"
msgid "(I can't eat anymore...)"
msgstr "(No puedo comer más...)"

#. y4:line_status=translated
msgctxt "474"
msgid "Spaghetti made with eggplant, tomato sauce, and \nsavory bacon imported from Denmark."
msgstr "Espaguetis elaborados con berenjena, salsa de\ntomate y sabroso tocino importado de Dinamarca."

#. y4:line_status=translated
msgctxt "559"
msgid "Made with succulent mini shrimp and rich tomato \ncream sauce. A delightful and savory delicacy."
msgstr "Elaborado con suculentos mini camarones y una\nrica salsa de crema de tomate. Un manjar\ndelicioso y sabroso."

#. y4:line_status=translated
msgctxt "655"
msgid "Carefully simmered, rich meat sauce on our specially \nprepared spaghetti noodles."
msgstr "Rica salsa de carne específicamente preparada para\nnuestros deliciosos fideos espagueti."

#. y4:line_status=translated
msgctxt "737"
msgid "This delicious spaghetti dish is made with authentic \nspicy cod roe from Hakata."
msgstr "Este delicioso plato de espaguetis se elabora con\nauténticas huevas de pescado picantes de Hakata."

#. y4:line_status=translated
msgctxt "818"
msgid "This is our Rich Egg Carbonara, with a tasty soft-boiled\negg on top and creamy sauce."
msgstr "Esta deliciosa carbonara lleva un un huevo cocido\nencima, además de sabrosa salsa cremosa."

