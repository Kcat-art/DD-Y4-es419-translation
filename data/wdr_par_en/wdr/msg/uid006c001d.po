#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "6732_Rio"
msgid "I wish I could play some table tennis."
msgstr "Me encantaría poder jugar ping-pong."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
