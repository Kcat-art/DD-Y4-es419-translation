msgctxt "392"
msgid "Quit"
msgstr "Salir"

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "397"
msgid "Cancel the order."
msgstr "Cancelar el pedido."

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "415"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=translated
msgctxt "421"
msgid "Order the currently selected item.  "
msgstr "Pedir el objeto actualmente seleccionado.  "

#. y4:line_status=reviewed
#. y4:translated_by=dani64amv
#. y4:reviewed_by=dani64amv
msgctxt "458"
msgid "(I haven't picked anything.)  "
msgstr "(No he escogido nada)."

#. y4:line_status=reviewed
#. y4:translated_by=dani64amv
#. y4:reviewed_by=dani64amv
msgctxt "489"
msgid "(I'm short on cash.)  "
msgstr "(Me hace falta dinero)."

#. y4:line_status=translated
msgctxt "512"
msgid "Thank you. That'll be %s."
msgstr "Gracias. Eso sería %s."

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "538"
msgid "(I can't carry any more stuff.)"
msgstr "(No puedo llevar más cosas)."

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "570"
msgid "(They're sold out.)"
msgstr "(Están agotados)."

#. y4:line_status=translated
msgctxt "590"
msgid "The limited-edition Kamuro Burger: an enticing\ncombination of avocado, tomato, and cheese. To go."
msgstr "La hamburguesa Kamuro de edición limitada: una tentadora\ncombinación de aguacate, tomate, y queso. Para llevar."

#. y4:line_status=translated
msgctxt "688"
msgid "Our classic burger set, with a Smile Burger, fries, and\na drink. To go."
msgstr "Nuestro clásico combo, con una Hamburguesa Smile,\npapas fritas y una bebida. Para llevar."

#. y4:line_status=translated
msgctxt "760"
msgid "This set includes a Smile Cheeseburger, fries, and a\ndrink. To go."
msgstr "Este combo incluye una hamburguesa de queso Smile,\npapas fritas y una bebida. Para llevar."

#. y4:line_status=translated
msgctxt "827"
msgid "This set includes a Teriyaki Smile Burger with special\nsauce, fries, and a drink. To go."
msgstr "Este combo incluye una hamburguesa Teriyaki Smile\ncon salsa especial, papas fritas y una bebida. Para llevar."

#. y4:line_status=translated
msgctxt "916"
msgid "As advertised, this set comes with a King Smile \nBurger, fries, and a drink. To go."
msgstr "Como se anuncia, este combo viene con una Hamburguesa Rey Smile, papas fritas y una bebida. Para llevar."

#. y4:line_status=translated
msgctxt "1000"
msgid "A tasty Tuna Burger with a unique texture. Fries and \na drink come with this set. To go."
msgstr "Una sabrosa hamburguesa de atún con una textura única. \nPatatas fritas y una bebida. Para llevar."

#. y4:line_status=translated
msgctxt "1089"
msgid "A tender, stewed pork burger with fries and a drink.\nTo go."
msgstr "Una tierna hamburguesa de cerdo estofado con papas\nfritas y una bebida. Para llevar."

#. y4:line_status=translated
msgctxt "1149"
msgid "A Smile Shake made with fresh milk. Sure to put a \nsmile on anyone's face. To go."
msgstr "Un batido Smile hecho con leche fresca. Seguro que \nhará sonreír a cualquiera. Para llevar."

#. y4:line_status=translated
msgctxt "1231"
msgid "The golden-fried standard of french fries. Served \nwith a smile. To go."
msgstr "Las clásicas y doradas papas fritas. Servidas con una sonrisa. Para llevar."

