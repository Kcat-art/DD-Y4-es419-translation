msgctxt "6708_松岡里緒奈：源氏名"
msgid "Really!? I just love salted tongue with green onions!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
