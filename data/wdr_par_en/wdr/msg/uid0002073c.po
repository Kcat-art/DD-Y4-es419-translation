#. y4:msg_branch_choice=Sorry, not this time.
msgctxt "628_Kiryu"
msgid "Sorry, Haruka. Not this time."
msgstr "Lo siento, Haruka. Esta vez no."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=45
#. y4:msg_location=T0.P45
#. y4:msg_speaker=Haruka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sorry, not this time.
msgctxt "640_Haruka"
msgid "Oh... Then promise you'll take me next time!"
msgstr "Oh... ¡Entonces prométeme que me llevarás la próxima vez!"

