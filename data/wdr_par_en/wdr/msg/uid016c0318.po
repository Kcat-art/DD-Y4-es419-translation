#. y4:msg_branch_target=T2.P4
msgctxt "900_Player"
msgid "\"You're making a good living. It's not so bad.\""
msgstr "\"Estás viviendo bien. No es para tanto.\""

#. y4:msg_role=decision
#. y4:msg_decision_role=choice
#. y4:msg_decision_group=2
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T2.P5
msgctxt "912_Player"
msgid "\"I hate it when people cancel on me suddenly.\""
msgstr "\"Odio cuando la gente me cancela de repente\"."

