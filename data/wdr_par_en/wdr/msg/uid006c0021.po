#. y4:msg_branch_target_text=I like shochu. You know, sweet potato liquor?
#. y4:msg_branch_raw=01 11 00 0d 00 00 00 2d 00 00 00 00 00 00 00 00
msgctxt "6852_Akiyama"
msgid "I like shochu. You know, sweet potato liquor?"
msgstr "Me gusta el shochu, el licor de camote. ¿Conoces?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=14
#. y4:msg_location=T6.P14
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I like shochu. You know, sweet potato liquor?
msgctxt "6864_Erena"
msgid "Really? You like shochu!?"
msgstr "¿De verdad? ¡¿Te gusta el shochu?!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=15
#. y4:msg_location=T6.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I like shochu. You know, sweet potato liquor?
msgctxt "6876_Akiyama"
msgid "Sure. You too?"
msgstr "Claro. ¿Tú también?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=16
#. y4:msg_location=T6.P16
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I like shochu. You know, sweet potato liquor?
msgctxt "6888_Erena"
msgid "I love it. It's probably the kind of liquor I drink the most."
msgstr "Me encanta. Probablemente es el tipo de licor que más bebo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=17
#. y4:msg_location=T6.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I like shochu. You know, sweet potato liquor?
msgctxt "6900_Akiyama"
msgid "It is good, isn't it? It's got a crisp, clear flavor."
msgstr "Es bueno, ¿a que sí? Tiene un sabor crujiente y claro."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=18
#. y4:msg_location=T6.P18
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I like shochu. You know, sweet potato liquor?
msgctxt "6912_Erena"
msgid "But I usually start out with a cocktail, or a cassis orange."
msgstr "Pero normalmente empiezo con un cóctel, o un cassis de naranja."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=19
#. y4:msg_location=T6.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I like shochu. You know, sweet potato liquor?
msgctxt "6924_Akiyama"
msgid "Really? Why?"
msgstr "¿En serio? ¿Por qué?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=20
#. y4:msg_location=T6.P20
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I like shochu. You know, sweet potato liquor?
msgctxt "6936_Erena"
msgid "I guess it's just because I think I look cute drinkin' them."
msgstr "Tal vez es solo porque creo que me veo linda tomando."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=21
#. y4:msg_location=T6.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I like shochu. You know, sweet potato liquor?
msgctxt "6948_Akiyama"
msgid "Heheh. I see..."
msgstr "Je, je. Ya veo..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=22
#. y4:msg_location=T6.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I drink a lot of whiskey.
msgctxt "6960_Akiyama"
msgid "I drink a lot of whiskey. Bourbon, scotch. That kind of thing."
msgstr "Frecuento mucho el whisky. Bourbon, whisky escocés. Ese tipo de cosas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=23
#. y4:msg_location=T6.P23
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I drink a lot of whiskey.
msgctxt "6972_Erena"
msgid "Wow. Those are some hard drinks. Most girls can't drink that sort of thing."
msgstr "Wow. Esos son tragos fuertes. La mayoría de las chicas no pueden beber ese tipo de cosas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=24
#. y4:msg_location=T6.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I drink a lot of whiskey.
msgctxt "6984_Akiyama"
msgid "Yeah. I wonder why that is."
msgstr "Sip. Me pregunto el por qué."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=25
#. y4:msg_location=T6.P25
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I drink a lot of whiskey.
msgctxt "6996_Erena"
msgid "Maybe because they're brown?"
msgstr "¿Quizás será porque se ven aburridos?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=26
#. y4:msg_location=T6.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I drink a lot of whiskey.
msgctxt "7008_Akiyama"
msgid "Haha! That's an interesting theory."
msgstr "¡Ja, ja! Es una teoría interesante."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=27
#. y4:msg_location=T6.P27
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I drink a lot of whiskey.
msgctxt "7020_Erena"
msgid "I mean, maybe we'd like 'em better if they were cute and colorful, like cocktails."
msgstr "Quiero decir, tal vez nos gustarían más si fueran lindos y coloridos, como los cócteles."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=28
#. y4:msg_location=T6.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I drink a lot of whiskey.
msgctxt "7032_Akiyama"
msgid "I see... That actually makes sense. You can be surprisingly perceptive sometimes."
msgstr "Ya veo... Eso realmente tiene sentido. A veces puedes ser sorprendentemente perceptiva."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=29
#. y4:msg_location=T6.P29
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I drink a lot of whiskey.
msgctxt "7044_Erena"
msgid "Surprisingly? I think ya mean incredibly!"
msgstr "¿Sorprendentemente? ¡Querrás decir increíblemente!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=30
#. y4:msg_location=T6.P30
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I drink a lot of whiskey.
msgctxt "7056_Akiyama"
msgid "Hahahah! All right, incredibly perceptive."
msgstr "¡Ja, ja, ja! Muy bien, increíblemente perceptiva entonces."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=0
#. y4:msg_location=T7.P0
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "7068_Erena"
msgid "It must be nice to go on a date in Tokyo."
msgstr "Debe ser agradable tener una cita en Tokio."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=1
#. y4:msg_location=T7.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "7080_Akiyama"
msgid "Depends on where you go."
msgstr "Depende de a dónde vayas."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=2
#. y4:msg_location=T7.P2
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "7092_Erena"
msgid " But there're lots of romantic spots, aren't there?"
msgstr " Pero hay muchos lugares románticos, ¿no?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=3
#. y4:msg_location=T7.P3
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "7104_Erena"
msgid "What kind of place would you take me if we were goin' on a date?"
msgstr "¿A qué tipo de lugar me llevarías si fuéramos a una cita?"

