#. y4:msg_location=T11.P2
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "8016_望月京子：源氏名"
msgid "I was walking toward Kamurocho Station the other day when this young couple called out to me. I think they were in high school."
msgstr "El otro día estaba caminando hacia la estación de Kamurocho cuando una pareja de jóvenes me llamo. Creo que eran de secundaria."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=3
#. y4:msg_location=T11.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "8028_Kiryu"
msgid "And?"
msgstr "¿Y? ¿Qué más?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=4
#. y4:msg_location=T11.P4
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "8040_望月京子：源氏名"
msgid "The two of them met at one of our gigs!"
msgstr "¡La pareja se había conocido en mis conciertos!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=5
#. y4:msg_location=T11.P5
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "8052_望月京子：源氏名"
msgid "So I'm like cupid to them, basically."
msgstr "Así que me dijeron que soy como su cupido para ellos, básicamente."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=30
#. y4:msg_section_label=Conversación 30
#. y4:msg_talk=30
#. y4:msg_phrase=5
#. y4:msg_location=T30.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=30
#. y4:msg_decision_choices=1. Be the best indie musician you can be. -> T30.P6 | 2. I hope you make it big soon. -> T30.P11 | 3. Didn't you promise to write me a song? -> T30.P16
msgctxt "8064_Kiryu"
msgid "I see."
msgstr "Ya veo."

msgctxt "8076_望月京子：源氏名"
msgid "They said they're going to keep coming to our gigs together. <Color:7>♥<Color:Default>"
msgstr "Dijeron también que iban a ir a mis conciertos juntos, qué bonito. <Color:7>♥<Color:Default>"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=8
#. y4:msg_location=T11.P8
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "8088_望月京子：源氏名"
msgid "It sounds silly, but... I felt like I'd made a difference in their lives."
msgstr "Suena un poco tonto, pero... Sentí que hice un clic en sus vidas. ¿Sabes?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=9
#. y4:msg_location=T11.P9
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=11
#. y4:msg_decision_choices=1. Keep working hard for your fans. -> T11.P10 | 2. So some of your fans are high school kids? -> T11.P18 | 3. It's ironic to think of you as cupid. -> T11.P27
msgctxt "8100_望月京子：源氏名"
msgid "It made me glad I chose to be a musician."
msgstr "Eso me alegra la decisión de dedicarme a la música."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=154
#. y4:msg_phrase=0
#. y4:msg_location=T154.P0
#. y4:msg_choice_index=1
