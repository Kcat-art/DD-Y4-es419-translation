msgctxt "13644_Akiyama"
msgid "I take my time and lick it."
msgstr "Me tomo mi tiempo y lo lamo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
