msgid "Well? Want another go-round?"
msgstr "Entonces, ¿qué opina? ¿Quiere intentarlo?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Scout from Another Club
#. y4:msg_speaker_id=1
