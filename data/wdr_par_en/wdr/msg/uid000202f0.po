#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "240_Akiyama"
msgid "*sigh* Here we go again."
msgstr "*suspira* Aquí vamos de nuevo."
