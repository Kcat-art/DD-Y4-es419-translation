msgctxt "1292"
msgid "Chase Battles (Fleeing)"
msgstr "Persecuciones (huir)"

#. y4:line_status=translated
msgctxt "56_Chase Battles (Fleeing)"
msgid "When you find yourself fleeing during a chase battle, try to accomplish your goal before your Chase Gauge is fully depleted.\\r\n\\r\nYour current objective is <Color:7>to reach Sky Finance<Color:Default>."
msgstr "Cuando te encuentres huyendo durante una persecución, intenta cumplir tu objetivo antes de que se agote por completo tu barra de persecución.\\r\n\\r\nTu objetivo actual es llegar a <Color:7>Sky Finance<Color:Default>."

#. y4:line_status=translated
msgctxt "68_Chase Battles (Fleeing)"
msgid "Use <Action:Button_LS_Up@Chase><Action:Button_LS_Down@Chase><Action:Button_LS_Left@Chase><Action:Button_LS_Right@Chase> to run during chase events.\\r\n\\r\nMake it all the way to Sky Finance without getting caught by the police."
msgstr "Utiliza <Action:Button_LS_Up@Chase><Action:Button_LS_Down@Chase><Action:Button_LS_Left@Chase><Action:Button_LS_Right@Chase> correr durante los eventos de persecución.\\r\n\\r\nLlega hasta Sky Finance sin ser atrapado por la policía."

#. y4:line_status=translated
#. y4:translated_by=Keiner
msgctxt "80_Chase Battles (Fleeing)"
msgid "This information has been added as a <Color:14>memo<Color:Default>.\\r\nRead <Color:14>memos<Color:Default> by selecting <Color:14>Memos<Color:Default> in the Pause Menu.\\r\nYou can access the Pause Menu with the <Action:Button_Options@Adventure> button."
msgstr "Esta información ha sido añadida como una <Color:14>nota<Color:Default>.\nLee las <Color:14>notas<Color:Default> seleccionando <Color:14>Notas<Color:Default> en el menú de pausa.\nPuedes acceder al menú de pausa con el botón <Action:Button_Options@Adventure>."

