#. y4:line_status=translated
msgctxt "116_峰村七海：源氏名"
msgid "The yakiniku here is delicious. You're a bit of a gourmet, huh?"
msgstr "Este yakiniku está buenísimo. ¡Tú sí sabes, ¿eh?!"

#. y4:line_status=translated
msgctxt "128_Tanimura"
msgid "Come on. Let's go in."
msgstr "Vamos, entremos."

#. y4:line_status=translated
msgctxt "152_峰村七海：源氏名"
msgid "The yakiniku here is delicious. You're a bit of a gourmet, huh?"
msgstr "Este yakiniku está buenísimo. ¡Tú sí sabes, ¿eh?!"

#. y4:line_status=translated
msgctxt "164_Tanimura"
msgid "Hold on... Seems I didn't bring enough money."
msgstr "Espera... Parece que no traje suficiente dinero."

#. y4:line_status=translated
msgctxt "176_峰村七海：源氏名"
msgid "I'm sorry, I must have misheard you. What did you say?"
msgstr "Disculpe, creo que no lo escuche bien. ¿Qué dijo?"

#. y4:line_status=translated
msgctxt "188_Tanimura"
msgid "Um... I mean... Sorry."
msgstr "Eh... Quiero decir... Perdón."

#. y4:line_status=translated
msgctxt "200_峰村七海：源氏名"
msgid "I don't believe it! You can't manage your own finances? How do you even survive as an adult?"
msgstr "¡No me lo puedo creer! ¿Acaso no puede manejar su propio dinero? ¿Cómo es que logra sobrevivir siendo un adulto?"

#. y4:line_status=translated
msgctxt "212_峰村七海：源氏名"
msgid "I'm going home. Goodbye."
msgstr "Me voy a casa. Adiós."

#. y4:line_status=translated
msgctxt "224_Tanimura"
msgid "(I should've checked my money earlier...)"
msgstr "(Debí haber revisado mi dinero antes...)"

#. y4:line_status=translated
msgctxt "332_峰村七海：源氏名"
msgid "That was great! You're good at picking restaurants."
msgstr "¡Estuvo delicioso! Es usted muy bueno eligiendo restaurantes."

#. y4:line_status=translated
msgctxt "344_Tanimura"
msgid "Glad you liked it."
msgstr "Me alegra que te haya gustado."

#. y4:line_status=translated
msgctxt "356_峰村七海：源氏名"
msgid "Thanks for the meal! I hope we go out again sometime soon. <Color:7>♥<Color:Default>"
msgstr "¡Gracias por la comida! Espero que volvamos a salir juntos pronto. <Color:7>♥<Color:Default>"

#. y4:line_status=translated
msgctxt "392_峰村七海：源氏名"
msgid "Thanks for the meal. It wasn't quite as good as I expected, but it was okay."
msgstr "Gracias por la cena. No estuvo tan deliciosa como pensé, pero estuvo bien."

#. y4:line_status=translated
msgctxt "404_Tanimura"
msgid "I see..."
msgstr "Ya veo..."

#. y4:line_status=translated
msgctxt "416_峰村七海：源氏名"
msgid "I gotta get going. Bye."
msgstr "Me tengo que ir. Chao."

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
msgctxt "440_峰村七海：源氏名"
msgid "......"
msgstr "......"

#. y4:line_status=translated
msgctxt "452_Tanimura"
msgid "Is everything ok?"
msgstr "¿Va todo bien?"

#. y4:line_status=translated
msgctxt "464_峰村七海：源氏名"
msgid "Yeah... I just didn't care for some of the dishes."
msgstr "Sí... es solo que no me interesa ninguno de los platos."

#. y4:line_status=translated
msgctxt "476_Tanimura"
msgid "Oh..."
msgstr "Oh..."

#. y4:line_status=translated
msgctxt "488_峰村七海：源氏名"
msgid "I should be going. I'll see you at the club."
msgstr "Me tengo que ir. Nos vemos en el club."

#. y4:line_status=translated
msgctxt "500_Tanimura"
msgid "(Guess she didn't enjoy all the food...)"
msgstr "(Creo que no disfrutó de la comida...)."

