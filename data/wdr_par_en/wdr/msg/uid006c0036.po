#. y4:msg_branch_target_text=You want to go to a batting cage and hit a few?
#. y4:msg_branch_raw=01 11 00 16 00 00 00 2f 00 00 00 00 00 00 00 00
msgctxt "6192_Kiryu"
msgid "You want to go to a batting cage and hit a few?"
msgstr "¿Quieres ir a una jaula de bateo y batear unos cuantos?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=23
#. y4:msg_location=T5.P23
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You want to go to a batting cage and hit a few?
msgctxt "6204_松岡里緒奈：源氏名"
msgid "Huh!? Are you asking me out?"
msgstr "¿¡Eh!? ¿Me estás invitando a salir?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=24
#. y4:msg_location=T5.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You want to go to a batting cage and hit a few?
msgctxt "6216_Kiryu"
msgid "Sure. I'd like to see how good you really are."
msgstr "Seguro. Me gustaría ver lo buena que eres realmente."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=25
#. y4:msg_location=T5.P25
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You want to go to a batting cage and hit a few?
msgctxt "6228_松岡里緒奈：源氏名"
msgid "Um, I don't know. I might be busy later."
msgstr "Um, no lo sé. Es posible que esté ocupada más tarde."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=28
#. y4:msg_location=T2.P28
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You could find a roommate.
msgctxt "6240_Kiryu"
msgid "Oh..."
msgstr "Oh..."

msgctxt "6252_松岡里緒奈：源氏名"
msgid "But thanks for asking me. Maybe we'll get a chance to go sometime. <Color:7>♥<Color:Default>"
msgstr "Pero gracias por preguntarme. Tal vez tengamos la oportunidad de ir en algún momento. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=28
#. y4:msg_location=T5.P28
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You want to go to a batting cage and hit a few?
msgctxt "6264_Kiryu"
msgid "Okay."
msgstr "Está bien."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=0
#. y4:msg_location=T6.P0
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "6276_松岡里緒奈：源氏名"
msgid "You know, I often go to the zoo by myself."
msgstr "Sabes, a menudo voy sola al zoológico."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=1
#. y4:msg_location=T6.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "6288_Kiryu"
msgid "Not on a date or anything?"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=2
#. y4:msg_location=T6.P2
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "6300_松岡里緒奈：源氏名"
msgid "No. I just like looking at the big animals. It makes me feel... powerful."
msgstr "No. Me gusta mirar a los animales grandes. Me hace sentir... poderosa."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
