#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Maybe you should stop drinking.
msgctxt "7068_松岡里緒奈：源氏名"
msgid "Okay! I'll stop drinking starting tomorrow!"
msgstr "¡Bien! ¡Dejaré de beber a partir de mañana!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=11
