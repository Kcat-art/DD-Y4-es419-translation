#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=0
msgctxt "72_Player"
msgid "Excuse me. Can I talk to you for a minute?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Kyoko
#. y4:msg_speaker_id=2
msgctxt "84_Kyoko"
msgid "What? No, you can't have my number."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=0
msgctxt "96_Player"
msgid "I don't want your number. I was wondering if you were interested in working as a hostess."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Kyoko
#. y4:msg_speaker_id=2
msgctxt "108_Kyoko"
msgid "You mean like, at a club?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=0
msgctxt "120_Player"
msgid "I couldn't help overhearing your conversation."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=0
msgctxt "132_Player"
msgid "If you need money, working at a hostess club is a great option."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Kyoko
#. y4:msg_speaker_id=2
msgctxt "144_Kyoko"
msgid "Hmm... Actually, that might be interesting."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Kyoko
#. y4:msg_speaker_id=2
msgctxt "156_Kyoko"
msgid "...Sure. I'll do it."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=0
msgctxt "168_Player"
msgid "Then it's settled! I'll show you to the club. Come on."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Kyoko
#. y4:msg_speaker_id=2
msgctxt "192_Kyoko"
msgid "We sure didn't get many people at the show today..."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Ken the Guitarist
#. y4:msg_speaker_id=6
msgctxt "204_Ken the Guitarist"
msgid "We even had to pay for the tickets 'cause no one would buy them. I'd take any kind of sales at this point. Hell, even 500 yen would break a new record..."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Jiro the Bassist
#. y4:msg_speaker_id=8
msgctxt "216_Jiro the Bassist"
msgid "Right now, we're losing money every time we play a show."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Shinya the Drummer
#. y4:msg_speaker_id=10
msgctxt "228_Shinya the Drummer"
msgid "And I can't really ask my parents for money..."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Kyoko
#. y4:msg_speaker_id=2
msgctxt "240_Kyoko"
msgid "Come on, guys. Don't talk like that."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Ken the Guitarist
#. y4:msg_speaker_id=6
msgctxt "252_Ken the Guitarist"
msgid "Sorry. I gotta go to work. See you later."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Kyoko
#. y4:msg_speaker_id=2
msgctxt "264_Kyoko"
msgid "Bye, then."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Jiro the Bassist
#. y4:msg_speaker_id=8
msgctxt "276_Jiro the Bassist"
msgid "I've gotta get going too."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Kyoko
#. y4:msg_speaker_id=2
msgctxt "288_Kyoko"
msgid "Huh? I thought you didn't work today."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Jiro the Bassist
#. y4:msg_speaker_id=8
msgctxt "300_Jiro the Bassist"
msgid "My job at the convenience store isn't making me enough cash. I've gotta go out and find another job."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Shinya the Drummer
#. y4:msg_speaker_id=10
msgctxt "312_Shinya the Drummer"
msgid "I'll head off too, then. See ya."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Kyoko
#. y4:msg_speaker_id=2
msgctxt "324_Kyoko"
msgid "I really need to get a job, too..."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=0
msgctxt "348_Player"
msgid "(I could try recruiting her for the club.)"
msgstr ""
