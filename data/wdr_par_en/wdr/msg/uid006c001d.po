#. y4:msg_branch_raw=01 11 00 24 00 00 00 20 00 00 00 00 00 00 00 00
msgctxt "7752_Akiyama"
msgid "I bet you look good in a yukata."
msgstr "Apuesto a que luces genial en un yukata."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
