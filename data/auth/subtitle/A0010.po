msgctxt "585\t645"
msgid "<Italic>Sky Finance</Italic>"
msgstr "<Italic>Sky Finance</Italic>"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1434\t1524"
msgid "A serial killer, now?"
msgstr "¿Un asesino en serie?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1613\t1674"
msgid "Scary shit..."
msgstr "Qué miedo..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1725\t1890"
msgid "<Italic>Murder Spree Rocks Kamurocho!\\nSerial Killer on the Loose!</Italic>"
msgstr "<Italic>¡Una ola de asesinatos sacude Kamurocho!\\n¡Un asesino en serie anda suelto!</Italic>"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "3262\t3336"
msgid "All right, all right!"
msgstr "¡Ah, está bien!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3395\t3463"
msgid "Hm? Hana-chan?"
msgstr "¿Mh? ¿Hana-chan?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3492\t3534"
msgid "Hey, how's it hanging?"
msgstr "Ey, ¿quién habla?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3535\t3592"
msgid "Oh, finally."
msgstr "Ah, respondió."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3596\t3717"
msgid "Where the <Italic>heck</Italic> have you been!?"
msgstr "Oiga, ¡¿dónde rayos está ahora mismo?!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3731\t3832"
msgid "What, me? I'm, uh, at a client's?"
msgstr "¿Quién, yo? Esto, eh, acabo de salir."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "3811\t3873"
msgid "And I'm the Queen of France."
msgstr "Suena a mentira."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3874\t3968"
msgid "You're still at the office, aren't you?"
msgstr "Sigue en la oficina, ¿no?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "3964\t4074"
msgid "Why didn't you answer any of my calls!?"
msgstr "¡Uah! ¡¿Entonces por qué no contestaba mis llamadas?!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4132\t4215"
msgid "Hey! Are you even listening!?"
msgstr "¡Oiga! ¡¿Me está escuchando?!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4235\t4319"
msgid "Ugh, this stupid phone..."
msgstr "¿Eh? ¿Será que se fue la señal?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4309\t4348"
msgid "Akiyama-san?"
msgstr "¿Akiyama-san?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4349\t4449"
msgid "Akiyama-san!\\nEarth to Akiyama-san!"
msgstr "¡Akiyama-saan!\\n¿Puede escucharmeee?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4450\t4587"
msgid "Yeah, yeah. I can hear you.\\nLook, I'm sorry!"
msgstr "Sí, sí, puedo escucharte.\\n¡Perdón! ¡Perdón de verdad!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4593\t4674"
msgid "So what's the word?\\nYou need something?"
msgstr "Entonces, dime.\\n¿Necesitas algo?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4660\t4710"
msgid "What?"
msgstr "Pero..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4711\t4861"
msgid "Of course I need something!\\nWhy else would I have called!?"
msgstr "¡¿Qué estás diciendo?!\\n¡Si te llamo es porque hay cosas que hacer!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4864\t4959"
msgid "Right, sorry, okay!\\nMy bad."
msgstr "¡Oh, tienes razón, lo siento!\\nMi error."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4960\t5004"
msgid "What can I do you for?"
msgstr "Entonces, ¿qué hay para hacer?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "5005\t5115"
msgid "Do you have any idea what day it is today?"
msgstr "¿Tiene la remota idea de qué día es hoy?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5143\t5178"
msgid "Today?"
msgstr "¿Hoy?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5179\t5260"
msgid "Well, er..."
msgstr "Bueno, hoy..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "5269\t5310"
msgid "Is it..."
msgstr "es tu..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5311\t5358"
msgid "Your birthday?"
msgstr "¿cumpleaños?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5359\t5403"
msgid "No!"
msgstr "¡No!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "5404\t5492"
msgid "Can you just look at the calendar!?"
msgstr "¡Apúrese y dele un vistazo al calendario!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5666\t5771"
msgid "Ohhh, right. Collection day!"
msgstr "Oh, cierto. ¡Día de recolección!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "5754\t5824"
msgid "You forgot again, didn't you!?"
msgstr "¡Cómo olvida algo como eso!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "5825\t5916"
msgid "Hey, come on now, I didn't forget."
msgstr "Qué va, por supuesto que no lo olvidé."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5922\t6032"
msgid "I was just giving it some time,\\nwaiting for the, uh..."
msgstr "Pensaba salir en un rato,\\nsolo estaba algo indeciso..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "6033\t6071"
msgid "You know..."
msgstr "Tú ya sabes por qué..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "6072\t6167"
msgid "I don't know.\\nFor what!?"
msgstr "No sé.\\n¡¿Por qué?!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "6179\t6252"
msgid "Isn't it obvious?"
msgstr "Bueno, es que hoy..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "6284\t6357"
msgid "For the rain to stop."
msgstr "...está lloviendo mucho."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "6495\t6600"
msgid "It's been dry out there for hours, Chief."
msgstr "Si su excusa era la lluvia, lamento decirle que paró hace horas."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "6652\t6725"
msgid "Now would you <Italic>please</Italic> get moving?"
msgstr "Ahora, ¡<Italic>por favor</Italic>, salga a trabajar!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "6725\t6834"
msgid "I'll be back just after I swing by\\nKanrai for a kalbi bento."
msgstr "Iré a la oficina después de pasar por Kanrai\\na comprar un kalbi bento especial."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "6834\t6894"
msgid "See you soon."
msgstr "Nos vemos."

