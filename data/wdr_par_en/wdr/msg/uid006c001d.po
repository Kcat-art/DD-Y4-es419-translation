#. y4:msg_location=T18.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "13296_Rio"
msgid "Do you like soft serve ice cream?"
msgstr "¿A usted le gusta el helado suave?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=1
#. y4:msg_location=T18.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "13308_Akiyama"
msgid "Ice cream? Where'd that come from?"
msgstr "¿Helado? ¿A qué viene eso?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=2
#. y4:msg_location=T18.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "13320_Rio"
msgid "Just tell me. Do you like it? Do you eat it a lot?"
msgstr "Solo dígame. ¿Le gusta? ¿Lo come mucho?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=3
#. y4:msg_location=T18.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "13332_Akiyama"
msgid "I guess so. As much as the next guy."
msgstr "Supongo. Como cualquier persona."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=4
#. y4:msg_location=T18.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "13344_Rio"
msgid "Aha! I knew it!"
msgstr "¡Ajá! ¡Lo sabía!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=5
#. y4:msg_location=T18.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "13356_Akiyama"
msgid "What about it?"
msgstr ""

msgctxt "13368_Rio"
msgid "I saw an old man eating an ice cream cone on the street today. It was soooo cute! <Color:7>♥<Color:Default>"
msgstr "Hoy vi a un anciano comiéndose un cono de helado en la calle. ¡Era taaan tierno! <Color:7>♥<Color:Default>"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=7
#. y4:msg_location=T18.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "13380_Akiyama"
msgid "Uh... huh..."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=8
#. y4:msg_location=T18.P8
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "13392_Rio"
msgid "He was eating it kinda weird, like he'd never had one before. He was concentrating so hard on it."
msgstr "Lo comía de una forma rara, como si nunca hubiera probado uno. Estaba súper concentrado."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=9
#. y4:msg_location=T18.P9
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "13404_Rio"
msgid "But he was really enjoying it!"
msgstr "¡Pero lo estaba disfrutando muchísimo!"

msgctxt "13416_Rio"
msgid "So I was just imagining how you'd eat one, Akiyama-san. <Color:7>♥<Color:Default>"
msgstr "Así que me imaginé cómo lo comería usted, Akiyama-san. <Color:7>♥<Color:Default>"

