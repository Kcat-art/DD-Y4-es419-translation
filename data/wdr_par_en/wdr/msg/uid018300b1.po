msgid "Tourist hotspots attract all kinds of people. It's no surprise that you get a few bad eggs among them."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=5
