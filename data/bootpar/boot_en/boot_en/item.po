msgstr "Huevo a la Carbonara"

#. y4:line_status=translated
msgctxt "90701"
msgid "This is our Rich Egg Carbonara, featuring creamy sauce and a tasty soft-boiled egg on top."
msgstr "Esta es nuestra rica Carbonara de huevo, con salsa cremosa y un sabroso huevo pochado por encima."

#. y4:line_status=translated
msgctxt "21246"
msgid "Grapefruit Juice"
msgstr "Jugo de Pomelo"

#. y4:line_status=translated
msgctxt "90792"
msgid "Nothing like a swig of grapefruit juice to cool you down. Tangy, refreshing, and full of vitamins."
msgstr "Nada como un trago de jugo de toronja para refrescarse. Ácido, refrescante y lleno de vitaminas."

#. y4:line_status=translated
msgctxt "21263"
msgid "Blood Orange Juice"
msgstr "Jugo de Naranja Sanguina"

#. y4:line_status=translated
msgctxt "90891"
msgid "Made from freshly juiced Italian oranges that provide a refreshing blend of sweet and sour flavors."
msgstr "Hecho con naranjas italianas recién exprimidas que ofrecen una mezcla refrescante de sabores dulces y ácidos."

#. y4:line_status=translated
msgctxt "21282"
msgid "Hot Coffee"
msgstr "Café Caliente"

#. y4:line_status=translated
msgctxt "90991"
msgid "This hot coffee is made with 100 percent Brazilian coffee beans for a rich, authentic flavor."
msgstr "Este café caliente está hecho con 100％ granos de café brasileño para un sabor rico y auténtico."

#. y4:line_status=translated
msgctxt "21293"
msgid "American Coffee"
msgstr "Café Americano"

#. y4:line_status=translated
msgctxt "91085"
