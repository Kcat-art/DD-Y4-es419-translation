#. y4:msg_branch_choice=Osaka.
msgctxt "1968_Erena"
msgid "Nope! I'm from Kyoto."
msgstr "Fallaste.\n"
"La gran Erena es de Kioto. ♪"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=28
#. y4:msg_phrase=9
#. y4:msg_location=T28.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=23
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Osaka.
msgctxt "1980_Akiyama"
msgid "Kyoto? Really? I never would've guessed."
msgstr "¿Kioto? ¿De verdad? Nunca lo hubiera adivinado..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=28
