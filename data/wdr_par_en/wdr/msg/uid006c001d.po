#. y4:msg_location=T15.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11868_Rio"
msgid "I'm so miserable..."
msgstr "Soy tan miserable..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=1
#. y4:msg_location=T15.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11880_Akiyama"
msgid "What's wrong?"
msgstr "¿Qué ocurre?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=2
#. y4:msg_location=T15.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11892_Rio"
msgid "I'm in love, but I know I can't keep indulging."
msgstr "Estoy enamorada, pero parece que mi amor no es recíproco."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=3
#. y4:msg_location=T15.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11904_Akiyama"
msgid "Uh, what're you talking about?"
msgstr "Eh, ¿de qué estás hablando?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=4
#. y4:msg_location=T15.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11916_Rio"
msgid "Hm? Oh, I'm in love with raw shrimp, but I can't eat it anymore."
msgstr "¿Hmm? Oh, estoy enamorada de los camarones crudos, pero ya no puedo comerlos."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=5
#. y4:msg_location=T15.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11928_Akiyama"
msgid "Oh. Why not?"
msgstr "Aw. ¿Por qué no?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=6
#. y4:msg_location=T15.P6
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11940_Rio"
msgid "I had some at a sushi restaurant the other day, and I broke out in hives. I hadn't had it for a while so I thought maybe it'd be okay, but..."
msgstr "Comí unos en un restaurante de sushi el otro día, y me salieron ronchas. Como hacía tiempo que no los probaba, pensé que tal vez no pasaría nada, pero..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=7
#. y4:msg_location=T15.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11952_Rio"
msgid "For the last year, I've broken out every time I've had raw shrimp. I'm fine if it's steamed or grilled though."
msgstr "Durante el último año, me han salido ronchas cada vez que he comido camarones crudos. Sin embargo, estoy bien si están al vapor o a la parrilla."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=8
#. y4:msg_location=T15.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11964_Akiyama"
msgid "Hm."
msgstr ""

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=9
#. y4:msg_location=T15.P9
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=15
#. y4:msg_decision_choices=1. What's the big deal? It's just raw shrimp. -> T15.P10 | 2. I thought you were talking about a man. -> T15.P17 | 3. Are there other foods you can't eat? -> T15.P23
msgctxt "11976_Rio"
msgid "I love it, but seems it doesn't love me!"
msgstr "¡Los amo, pero parece que ellos no me aman a mí!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=166
#. y4:msg_phrase=0
#. y4:msg_location=T166.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T15.P10
#. y4:msg_branch_segment=T15.P10..P16
#. y4:msg_branch_target_text=What's the big deal? It's just raw shrimp.
#. y4:msg_branch_raw=01 11 00 0a 00 00 00 2a 00 00 00 00 00 00 00 00
msgctxt "11988_Akiyama"
msgid "What's the big deal? It's just raw shrimp."
msgstr "No es para tanto. Son solo camarones crudos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=11
#. y4:msg_location=T15.P11
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's the big deal? It's just raw shrimp.
msgctxt "12000_Rio"
msgid "But I love it!"
msgstr "¡Pero me encantan!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=12
#. y4:msg_location=T15.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's the big deal? It's just raw shrimp.
msgctxt "12012_Akiyama"
msgid "Hmm... But aren't you in a better place than people too poor to even buy raw shrimp?"
msgstr "Hmm... ¿No estás en una mejor situación que las personas que son demasiado pobres para comprar camarones crudos?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=13
#. y4:msg_location=T15.P13
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's the big deal? It's just raw shrimp.
msgctxt "12024_Rio"
msgid "No, it's worse! At least a poor person can hope to eat it someday. I never can!"
msgstr "¡No, es peor! Al menos alguien pobre puede soñar con comerlos algún día. ¡Yo jamás podré!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=14
#. y4:msg_location=T15.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's the big deal? It's just raw shrimp.
msgctxt "12036_Akiyama"
msgid "Good point."
msgstr "Buen punto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=15
#. y4:msg_location=T15.P15
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's the big deal? It's just raw shrimp.
msgctxt "12048_Rio"
msgid "You're not really doing a good job of cheering me up..."
msgstr "La verdad, usted no estás haciendo un gran trabajo para animarme..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=16
#. y4:msg_location=T15.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's the big deal? It's just raw shrimp.
msgctxt "12060_Akiyama"
msgid "Sorry..."
msgstr "Lo siento..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=17
#. y4:msg_location=T15.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I thought you were talking about a man.
msgctxt "12072_Akiyama"
msgid "I thought you were talking about a man. You had me worried for a second there."
msgstr "Pensé que hablabas de un hombre. Me preocupaste por un segundo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=18
#. y4:msg_location=T15.P18
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I thought you were talking about a man.
msgctxt "12084_Rio"
msgid "Hehehe. Now why would you think that?"
msgstr "Je, je. ¿Y por qué pensó eso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=19
#. y4:msg_location=T15.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I thought you were talking about a man.
msgctxt "12096_Akiyama"
msgid "Come on! You really made it sound like something else!"
msgstr "¡Vamos! ¡Lo hiciste sonar como algo totalmente distinto!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
