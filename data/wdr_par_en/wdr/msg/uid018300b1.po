#. y4:msg_speaker_id=15
msgctxt "7148_Himeka"
msgid "Whenever I go to famous hot springs, there are always people with horrible manners. I get so mad at them!"
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=5
