msgid "Would you now?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
