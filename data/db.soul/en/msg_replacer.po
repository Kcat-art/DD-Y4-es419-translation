msgctxt "20\t105796\t52\tCHK"
msgid "Eliminate all enemies except the sniper within the time limit."
msgstr "Elimina a todos los enemigos excepto al francotirador dentro del límite de tiempo."

#. y4:line_status=translated
msgctxt "20\t105859\t53\tCHK"
msgid "Eliminate all enemies within the time limit.\nOnly firearms will inflict damage."
msgstr "Elimina a todos los enemigos dentro del límite de tiempo.\nSolo las armas de fuego infligirán daño."

#. y4:line_status=translated
msgctxt "20\t105939\t54\tCHK"
msgid "Eliminate the enemy within the time limit.\nDo not fall down."
msgstr "Elimina al enemigo dentro del límite de tiempo.\nNo te caigas."

#. y4:line_status=translated
msgctxt "20\t106000\t55\tCHK"
msgid "Eliminate all enemies."
msgstr "Elimina a todos los enemigos."

#. y4:line_status=translated
msgctxt "20\t106023\t56\tCHK"
msgid "Eliminate Minami within the time limit."
msgstr "Elimina a Minami dentro del tiempo límite."

#. y4:line_status=translated
msgctxt "20\t106063\t57\tCHK"
msgid "Eliminate Majima within the time limit."
msgstr "Elimina a Majima dentro del tiempo límite."

#. y4:line_status=translated
msgctxt "20\t106103\t58\tCHK"
msgid "Eliminate Sugiuchi within the time limit."
msgstr "Elimina a Sugiuchi dentro del tiempo límite."

#. y4:line_status=translated
msgctxt "20\t106145\t59\tCHK"
msgid "Eliminate Tanimura and Akiyama within the time limit."
msgstr "Elimina a Tanimura y Akiyama dentro del tiempo límite."

#. y4:line_status=translated
msgctxt "20\t106199\t60\tCHK"
msgid "Eliminate more enemies than Hana-chan."
msgstr "Elimina a más enemigos que Hana-chan."

#. y4:line_status=translated
msgctxt "20\t106238\t61\tCHK"
msgid "Eliminate all enemies within the time limit using only <Action:Battle_Guard@Combat>."
msgstr "Elimina a todos los enemigos dentro del límite de tiempo usando solo <Action:Battle_Guard@Combat>."

#. y4:line_status=translated
msgctxt "20\t106323\t62\tCHK"
msgid "Eliminate the enemy. Attacks involving direct contact are prohibited."
msgstr "Elimina al enemigo. Se prohíben los ataques que impliquen contacto directo."

#. y4:line_status=translated
msgctxt "20\t106393\t63\tCHK"
msgid "Eliminate the enemy with exactly 10 attacks."
msgstr "Elimina al enemigo con exactamente 10 ataques."

#. y4:line_status=translated
msgctxt "20\t106438\t64\tCHK"
msgid "Stay alive. Attacking the enemy is prohibited."
msgstr "Sobrevive. Atacar al enemigo está prohibido."

#. y4:line_status=translated
msgctxt "20\t106485\t65\tCHK"
msgid "Keep Minami from picking up the microphone."
msgstr "Evita que Minami coja el micrófono."

#. y4:line_status=translated
msgctxt "20\t106529\t66\tCHK"
msgid "Destroy the farthest stone wall within the time limit."
msgstr "Destruye el muro de piedra más lejano dentro del límite de tiempo."

#. y4:line_status=translated
msgctxt "20\t106584\t67\tCHK"
msgid "Eliminate all enemies in time using only Heat Actions.\nRepeated Heat Actions will inflict no damage."
msgstr "Elimina a todos los enemigos a tiempo usando solo acciones de calor.\nLas acciones repetidas de calor no infligirán daño."

#. y4:line_status=translated
msgctxt "20\t106685\t68\tCHK"
msgid "Eliminate the enemies in red-blue-yellow order.\nDo not eliminate any enemy in black."
msgstr "Elimina a todos los enemigos en orden Rojo-Azul-Amarillo.\nNo elimines a ningún enemigo de Negro."

#. y4:line_status=translated
msgctxt "20\t106770\t69\tCHK"
msgid "Arrest everyone. Do not use any other means to eliminate anyone."
msgstr "Arresta a todo el mundo. No uses ningún otro método para eliminar a alguien."

#. y4:line_status=translated
msgctxt "20\t106835\t70\tCHK"
