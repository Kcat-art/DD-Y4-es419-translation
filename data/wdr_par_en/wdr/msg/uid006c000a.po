msgctxt "4584_Tanimura"
msgid "Can you try a little bit for me? I'd like to see what it looks like."
msgstr "¿Actuarias un poco para mí? Me gustaría ver cómo es."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Can you try a little bit for me?
msgctxt "4596_Chihiro"
msgid "What!? You mean right here!?"
msgstr "¡¿Qué?! ¡¿Actuar aquí mismo?!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Can you try a little bit for me?
msgctxt "4608_Chihiro"
msgid "Um... Okay. Just a little bit."
msgstr "Eh... Bueno, pero solo un poco."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Can you try a little bit for me?
msgctxt "4632_Chihiro"
msgid "\"Hear me, traveler! You who stand before the gate!\""
msgstr "\"¡Escuchadme, viajero! ¡Vos que os plantáis ante la gran puerta!\""

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=9
