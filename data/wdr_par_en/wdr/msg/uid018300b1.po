#. y4:msg_branch_choice=You're pretty careful about things.
msgctxt "5144_Kiryu"
msgid "You're pretty careful about a lot of things. Whoever said a model's work is easy?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
