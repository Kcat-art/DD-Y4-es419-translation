#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "120_Radio"
msgid "We have a report of a suspicious transaction taking place behind Kotobuki Drugs."
msgstr "Tenemos un reporte de una transacción sospechosa en el lugar detrás de Kotobuki Drugs."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "132_Radio"
msgid "The dealer is suspected to be a member of the Kamurocho Guard."
msgstr "El distribuidor es sospechoso de ser miembro de los \"Guardias de Kamurocho\"."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "144_Radio"
msgid "Assistance requested from officers in the area."
msgstr "Requiero asistencia de oficiales en el área."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "192_Tanimura"
msgid "Hey, maybe it's that guy from the rumors!"
msgstr "?! ¡Seguro es el chico de los rumores!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
