#. y4:msg_location=T0.P26
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you ever think about doing something else?
msgctxt "4332_Tanimura"
msgid "You're still young. Have you ever thought about doing something else?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you ever think about doing something else?
msgctxt "4344_Himeka"
msgid "Why would I? I love bein' a hostess."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you ever think about doing something else?
msgctxt "4356_Tanimura"
msgid "Maybe there's other stuff you'd enjoy just as much?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you ever think about doing something else?
msgctxt "4368_Himeka"
msgid "But I got no skills aside from bein' cheerful. What else would I do?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you ever think about doing something else?
msgctxt "4380_Tanimura"
msgid "......"
msgstr "......"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=31
#. y4:msg_location=T0.P31
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you ever think about doing something else?
msgctxt "4392_Himeka"
msgid "I'm sorry, Tanimura-san. I didn't mean to shoot ya down like that."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4404_Himeka"
msgid "Hey, Tanimura-san, do you ever feel like you can't trust the folks around ya?"
msgstr "Tanimura-san… ¿Alguna vez has sentido que no puedes confiar en nadie a tu alrededor?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4416_Tanimura"
msgid "Well, honestly, there aren't a lot of people I trust completely... Why do you ask?"
msgstr "Honestamente, no suelo confiar del todo en casi nadie… ¿Por qué lo dices?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4428_Himeka"
msgid "Well, I have a blog. I started it to keep in touch with my regulars."
msgstr "Pues es que tengo un blog. Lo empecé para mantenerme en contacto con mis clientes habituales."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4440_Himeka"
msgid "I write about what I eat or movies I like. It's just silly stuff like that, mostly."
msgstr "Pongo cosas como lo que comí o alguna peli que me encantó. Nada serio, solo tonterías mías."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4452_Himeka"
msgid "I get lots of comments from my readers, too. They're always cheerin' me on and stuff!"
msgstr "Recibo un montón de mensajitos. ¡Siempre me están animando, je, je!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4464_Tanimura"
msgid "Is that right? I'd love to see it."
msgstr "¿Ah, sí? Me encantaría verlo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4476_Himeka"
msgid "Well, recently, somebody's been leavin' nasty comments like, \"You're just a tease, leading men on!\" Things like that."
msgstr "Aunque, últimamente, me han escrito cosas horribles, como: \"Solo estás jugando con los hombres\". Comentarios así."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4488_Himeka"
msgid "But that just couldn't be further from the truth..."
msgstr "Pero no podría estar más lejos de la realidad..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4500_Tanimura"
msgid "You have any idea who's doing it?"
msgstr "¿Tienes alguna idea de quién podría estar detrás de esto?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4512_Himeka"
msgid "Maybe... I kinda think it could be one of the girls here."
msgstr "Puede... Creo que podría ser una de mis compañeras aquí."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=1
#. y4:msg_decision_choices=1. They're jealous of you. -> T1.P11 | 2. You can't get along with everybody. -> T1.P18 | 3. Just don't worry about it. -> T1.P24
msgctxt "4524_Himeka"
msgid "I just wanna enjoy my work, y'know? Why do they gotta try and take the wind outta my sails?"
msgstr "Solo quiero disfrutar de mi trabajo, ¿sabes? ¿Por qué tienen que desanimarme?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're jealous of you.
msgctxt "4536_Tanimura"
msgid "They're jealous of you. It burns their asses when they see you enjoying your job so much."
msgstr "Tienen celos de ti. Les carcome por dentro ver como disfrutas de tu trabajo tanto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=12
#. y4:msg_location=T1.P12
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're jealous of you.
msgctxt "4548_Himeka"
msgid "Then why don't they just enjoy it, too?"
msgstr "Entonces, ¿por qué no lo disfrutan ellas también?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're jealous of you.
msgctxt "4560_Tanimura"
msgid "Not everyone has your optimism. Haven't you ever felt depressed before?"
msgstr "No todo el mundo es igual de optimista que tú. ¿Alguna vez te has sentido deprimida?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're jealous of you.
msgctxt "4572_Himeka"
msgid "Well, sure, but..."
msgstr "Bueno, claro, pero..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're jealous of you.
msgctxt "4584_Tanimura"
msgid "Some people just gotta drag others down with them. Don't let it get to you."
msgstr "Hay infelices que quieren hundir a los demás con ellos. No permitas que lo hagan."

msgctxt "4596_Himeka"
msgid "Oh, Tanimura-san, you're so mature. I feel a bit better after talkin' about it with you. <Color:7>♥<Color:Default>"
msgstr "Aww, Tanimura-san, eres tan maduro. Me siento un poquito mejor después de hablar contigo. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=17
#. y4:msg_location=T1.P17
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They're jealous of you.
msgctxt "4608_Tanimura"
msgid "Heh. You sure recovered fast."
msgstr ""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=125
#. y4:msg_phrase=0
#. y4:msg_location=T125.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T1.P18
#. y4:msg_branch_segment=T1.P18..P23
#. y4:msg_branch_target_text=You can't get along with everybody.
#. y4:msg_branch_raw=01 11 00 12 00 00 00 23 00 00 00 00 00 00 00 00
msgctxt "4620_Tanimura"
msgid "You can't get along with everybody."
msgstr "Nunca puedes contentar a todo el mundo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=19
#. y4:msg_location=T1.P19
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You can't get along with everybody.
msgctxt "4632_Himeka"
msgid "You really think so? That's kinda depressin'."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=20
#. y4:msg_location=T1.P20
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You can't get along with everybody.
msgctxt "4644_Tanimura"
msgid "But that shouldn't keep you from trusting people. Don't let them get to you."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=21
#. y4:msg_location=T1.P21
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You can't get along with everybody.
msgctxt "4656_Himeka"
msgid "I get you. I may not look it, but I'm actually kinda sensitive."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=22
#. y4:msg_location=T1.P22
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You can't get along with everybody.
msgctxt "4668_Himeka"
msgid "You're right! I gotta be stronger! Can ya help me become a stronger woman, Tanimura-san?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=23
#. y4:msg_location=T1.P23
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You can't get along with everybody.
