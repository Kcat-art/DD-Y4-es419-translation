#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You really like cars, don't you?
msgctxt "8916_Akiyama"
msgid "That's going to be tough. Lots of young guys don't even have cars."
msgstr "Eso va a ser duro. Muchos chicos jóvenes ni siquiera tienen autos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=21
#. y4:msg_location=T13.P21
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You really like cars, don't you?
msgctxt "8928_Noa"
msgid "Oh, it doesn't have to be a young guy. I don't care much about age."
msgstr "Oh, no tiene que ser un chico joven. No me importa mucho la edad."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=22
