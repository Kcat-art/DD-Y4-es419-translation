#. y4:msg_speaker_id=0
msgctxt "14076_Kiryu"
msgid "What happened?"
msgstr "¿Por qué?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
