#. y4:msg_branch_target_text=You must have a bad memory.
#. y4:msg_branch_raw=01 11 00 06 00 00 00 1b 00 00 00 00 00 00 00 00
msgctxt "17724_Kiryu"
msgid "You must have a bad memory."
msgstr "Debes de tener mala memoria."

