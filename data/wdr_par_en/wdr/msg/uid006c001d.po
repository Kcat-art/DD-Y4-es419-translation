#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6888_Rio"
msgid "So what kind of stakes should we play for?"
msgstr "¿Qué deberíamos apostar?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=14
#. y4:msg_location=T5.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6900_Akiyama"
msgid "You must be good if you're that confident."
msgstr "Debes ser buena si tienes tanta confianza."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=15
#. y4:msg_location=T5.P15
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6912_Rio"
msgid "I used to play the boys at my college for their lunches. I ate like a queen back then, hehe."
msgstr "Solía jugar con los chicos de mi universidad por sus almuerzos. Comí como una reina en ese entonces, jeje."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=16
#. y4:msg_location=T5.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6924_Akiyama"
msgid "Seriously? You sure that was you and not someone else?"
msgstr "¿En serio? ¿Seguro que eras tú y no otra persona?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=17
#. y4:msg_location=T5.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6936_Rio"
msgid "Hehe, it's just a side of me that slips out sometimes."
msgstr "Jeje, es una faceta mía que se me escapa a veces."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=18
#. y4:msg_location=T5.P18
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6948_Rio"
msgid "Alright, so what are we playing for?"
msgstr "Ahora, ¿por qué vamos a jugar?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=19
#. y4:msg_location=T5.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6960_Akiyama"
msgid "Well, if I win, you have to let me do something to you."
msgstr "Bueno, si gano, tienes que dejarme hacerte algo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=20
#. y4:msg_location=T5.P20
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6972_Rio"
msgid "Huh!? What do you want to do to me?"
msgstr "¿¡Eh!? ¿Qué quieres hacerme?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=21
#. y4:msg_location=T5.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6984_Akiyama"
msgid "Flick you on the forehead."
msgstr "Golpearte en la frente."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=22
#. y4:msg_location=T5.P22
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6996_Rio"
msgid "Oh, hehehe. You scared me there!"
msgstr "Uy, jejeje. ¡Casi me asustas!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=5
