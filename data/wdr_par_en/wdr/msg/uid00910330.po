#. y4:msg_branch_choice=Don't Get Involved
msgctxt "980_Kiryu"
msgid "(He's not a little kid anymore. He needs to learn how to fend for himself.)"
msgstr "(Ya no es un niño. Debe aprender a defenderse solo)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=6
#. y4:msg_location=T2.P6
