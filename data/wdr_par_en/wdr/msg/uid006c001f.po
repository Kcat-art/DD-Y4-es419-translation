msgctxt "7464_Noa"
msgid "Heh, that makes sense."
msgstr "Je, Eso tiene sentido."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
