#. y4:msg_branch_raw=01 11 00 15 00 00 00 23 00 00 00 00 00 00 00 00
msgctxt "6384_Tanimura"
msgid "You should train yourself to drink."
msgstr "Deberías entrenar para beber más."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=22
#. y4:msg_location=T5.P22
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should train yourself to drink.
msgctxt "6396_Chihiro"
msgid "Huh? Train myself how?"
msgstr "¿Eh? ¿Entrenar? ¿Cómo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=23
#. y4:msg_location=T5.P23
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should train yourself to drink.
msgctxt "6408_Tanimura"
msgid "Force yourself to drink. You'll get used to it eventually. Come on, bottoms up!"
msgstr "Oblígate a beber. Mientras más bebas te acostumbraras con el tiempo. ¡Vamos, hasta el fondo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=24
#. y4:msg_location=T5.P24
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should train yourself to drink.
msgctxt "6420_Chihiro"
msgid "...I don't want to do that."
msgstr "... No quiero hacer eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=25
#. y4:msg_location=T5.P25
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should train yourself to drink.
msgctxt "6432_Tanimura"
msgid "But you'd be a big hit at parties. You could see how many drinks you could down before you pass out."
msgstr "Pero serias el alma de las fiestas. Podrías ver cuantas botellas te bebes antes de desmayarte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=26
#. y4:msg_location=T5.P26
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should train yourself to drink.
msgctxt "6444_Chihiro"
msgid "But that would be dangerous!"
msgstr "¡Pero eso sería peligroso!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=27
#. y4:msg_location=T5.P27
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should train yourself to drink.
msgctxt "6456_Tanimura"
msgid "Yeah. Maybe. But not being able to drink is a problem."
msgstr "Eh, sí. Tal vez. Pero no poder beber es un problema."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=28
#. y4:msg_location=T5.P28
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should train yourself to drink.
msgctxt "6468_Chihiro"
msgid "Why!? It's terrible for people to try to force others to drink!"
msgstr "¡¿Por qué?! ¡Es horrible que las personas intenten obligarle a otras a beber!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=29
#. y4:msg_location=T5.P29
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should train yourself to drink.
msgctxt "6480_Tanimura"
msgid "Sorry..."
msgstr "Lo siento..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
