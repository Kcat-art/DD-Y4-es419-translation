msgstr "Nada como un refrescante vaso de leche."

#. y4:line_status=translated
msgctxt "91423\tEXPLANATION"
msgid "This rich, tasty cocoa was brewed with specially selected cacao beans."
msgstr "Este cacao rico y sabroso fue elaborado con granos de cacao cuidadosamente seleccionados."

#. y4:line_status=translated
msgctxt "91494\tEXPLANATION"
msgid "A single scoop of our popular vanilla gelato, made with real vanilla beans."
msgstr "Una cucharada de nuestro popular helado de vainilla elaborado con auténticas vainas de vainilla."

#. y4:line_status=translated
msgctxt "91570\tEXPLANATION"
msgid "Strawberry gelato is especially popular with girls because of its uniquely sweet and tangy flavor."
msgstr "El helado de fresa es especialmente popular entre las chicas por su inigualable sabor dulce y ácido."

#. y4:line_status=translated
msgctxt "91669\tEXPLANATION"
