#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Ain't gonna happen.
msgctxt "1540_Surly Homeless Man"
msgid "Bah! Then quit wasting our time!"
msgstr "¡Bah! ¡Entones no nos hagas perder el tiempo!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
