#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe I should try that one myself.
msgctxt "6156_Erena"
msgid "You? Hahahah! That's a good one!"
msgstr "¿Tú? ¡Ja, ja, ja! ¡Esa es buena!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=22
#. y4:msg_location=T4.P22
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe I should try that one myself.
msgctxt "6168_Erena"
msgid "But I bet the girl would love it."
msgstr "Pero apuesto a que a la chica le encantaría."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=23
#. y4:msg_location=T4.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe I should try that one myself.
msgctxt "6180_Akiyama"
msgid "No, really. I think it's a great idea. I'm going to have to try it sometime."
msgstr "No, hablo en serio. Creo que es una gran idea. Voy a tener que intentarlo alguna vez."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=24
#. y4:msg_location=T4.P24
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe I should try that one myself.
msgctxt "6192_Erena"
msgid "Really? Just keep in mind, rose gold is my favorite."
msgstr "¿De verdad? Solo ten en cuenta que el oro rosado es mi favorito."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=25
#. y4:msg_location=T4.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe I should try that one myself.
msgctxt "6204_Akiyama"
msgid "I didn't say I'd give it to you, did I?"
msgstr "Nunca dije que sería para ti, ¿no es así?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=26
#. y4:msg_location=T4.P26
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe I should try that one myself.
msgctxt "6216_Erena"
msgid "Oh sure. You've got to keep it a secret or it isn't going to be a surprise. I understand. But I'll be lookin' forward to it."
msgstr "Oh, no pasa nada. Tienes que mantenerlo en secreto o si no, no contaría como una sorpresa. Lo entiendo. Pero estaré deseando que llegue."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=27
#. y4:msg_location=T4.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe I should try that one myself.
msgctxt "6228_Akiyama"
msgid "You're an optimist, aren't you?"
msgstr "Si que eres optimista."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=28
#. y4:msg_location=T4.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I don't know... Putting it in her food?
msgctxt "6240_Akiyama"
msgid "I don't know... Putting it in her food? I'm not sure that's such a great idea."
msgstr "No lo sé... ¿Colocarlo en la comida? No estoy seguro de que sea una gran idea."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=29
#. y4:msg_location=T4.P29
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I don't know... Putting it in her food?
msgctxt "6252_Erena"
msgid "Huh? Whaddya mean!?"
msgstr "¿Eh? ¡¿Qué quieres decir?!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=30
#. y4:msg_location=T4.P30
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I don't know... Putting it in her food?
msgctxt "6264_Akiyama"
msgid "I mean, it's not very sanitary, is it?"
msgstr "Quiero decir, no es muy seguro que digamos, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=31
#. y4:msg_location=T4.P31
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I don't know... Putting it in her food?
msgctxt "6276_Erena"
msgid "I wouldn't mind."
msgstr "A mí no me importaría."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=32
#. y4:msg_location=T4.P32
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I don't know... Putting it in her food?
msgctxt "6288_Akiyama"
msgid "What if she swallows it before she notices it's in there? Or breaks a tooth on it?"
msgstr "¿Qué pasa si se lo traga antes de darse cuenta de que está allí? ¿O si se rompe un diente?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=33
#. y4:msg_location=T4.P33
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I don't know... Putting it in her food?
msgctxt "6300_Erena"
msgid "That wouldn't be good."
msgstr "Eso no terminaría bien."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=34
#. y4:msg_location=T4.P34
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I don't know... Putting it in her food?
msgctxt "6312_Akiyama"
msgid "Still, I like the idea of surprising somebody with a present."
msgstr "Aun así, me gusta la idea de sorprender a alguien con un regalo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=35
#. y4:msg_location=T4.P35
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I don't know... Putting it in her food?
msgctxt "6324_Erena"
msgid "I know. I'm so jealous of her."
msgstr "Completamente. Estoy tan celosa de ella."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=0
#. y4:msg_location=T5.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "6336_Akiyama"
msgid "Your eyes sure are big, aren't they?"
msgstr "Realmente tienes unos ojos muy grandes."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=1
#. y4:msg_location=T5.P1
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "6348_Erena"
msgid "Really? Actually, I get told that a lot."
msgstr "¿En serio? De hecho, me lo dicen mucho."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=2
#. y4:msg_location=T5.P2
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "6360_Erena"
msgid "People tell me to stop starin' at them because it feels like they'll be sucked in!"
msgstr "¡La gente me dice que deje de mirarlos porque parece que van a ser absorbidos!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=3
#. y4:msg_location=T5.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "6372_Akiyama"
msgid "Haha! I think I know what they mean. Your eyes are really cute."
msgstr "¡Ja, ja! Creo que entiendo a dónde van con eso. Tus ojos son realmente lindos."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=4
#. y4:msg_location=T5.P4
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "6384_Erena"
msgid "Oh, I know."
msgstr "Lo sé."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=5
#. y4:msg_location=T5.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "6396_Akiyama"
msgid "Heheh. You seem happy."
msgstr "Je, je, je. Pareces contenta."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=6
#. y4:msg_location=T5.P6
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=5
#. y4:msg_decision_choices=1. Even if it's not true? -> T5.P7 | 2. I'm no fan of empty flattery. -> T5.P15 | 3. Yep, you sure are pretty. -> T5.P23
msgctxt "6408_Erena"
msgid "What can I say? I love compliments, even if they aren't true."
msgstr "¿Qué puedo decir? Me encantan los cumplidos, aunque no sean ciertos."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=136
