#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "164_Akiyama"
msgid "Well, let's get started."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "176_キャバ育名前"
msgid "Yes, let's."
msgstr "Sí, vamos."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "188_Akiyama"
msgid "First, let's get you changed into an outfit that brings out the best of your natural beauty. Don't worry, I guarantee you'll look great."
msgstr "Primero, vamos a cambiarte a un atuendo que resalte lo mejor de tu belleza natural. No te preocupes, te garantizo que te verás genial."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "224_Akiyama"
msgid "Not bad."
msgstr "Nada mal."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "236_キャバ育名前"
msgid "Really? This is a little embarrassing..."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "248_Akiyama"
msgid "It's time to go out on the club floor. Don't worry. I'm sure you'll get customers."
msgstr "Es hora de que salgas. No te preocupes. Estoy seguro de que conseguirás clientes."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "260_キャバ育名前"
msgid "Okay..."
msgstr "Bueno..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "296_Akiyama"
msgid "%s, huh? That works. You'll use that name at the club from now on."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "308_キャバ育名前"
msgid "Okay, thank you."
msgstr "De acuerdo, gracias."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "320_Akiyama"
msgid "First, let's get you changed into an outfit that brings out the best of your natural beauty. Don't worry, I guarantee you'll look great."
msgstr "Primero, vamos a cambiarte a un atuendo que resalte lo mejor de tu belleza natural. No te preocupes, te garantizo que te verás genial."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=0
#. y4:msg_location=T3.P0
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=5
msgctxt "344_Player"
msgid "Welcome to Elise. We're going to make you into this club's number one hostess."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=1
#. y4:msg_location=T3.P1
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=5
msgctxt "356_Player"
msgid "You'll need to come up with a name to use in the club. What would you like your name to be?"
msgstr ""

msgctxt "428_Akiyama"
msgid "I'm not quite sure how to pronounce that... Why don't we\\r\n"
"come up with something a bit more natural?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=5
#. y4:msg_phrase=1
#. y4:msg_location=T5.P1
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "488_キャバ育名前"
msgid "Sorry, I know I should've called..."
msgstr ""

msgctxt "500_Akiyama"
msgid "It's okay. I haven't been the best manager, either.\\r\n"
"I'll be sure to do a better job from now on."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=5
#. y4:msg_phrase=3
#. y4:msg_location=T5.P3
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "512_キャバ育名前"
msgid "Okay."
msgstr "Está bien."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=1
#. y4:msg_location=T6.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "548_Akiyama"
msgid "You're working really hard. I hope it's not cutting into your band time."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=2
#. y4:msg_location=T6.P2
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "560_キャバ育名前"
msgid "Nah, all of the other members work part-time, too, so we don't get the chance to practice often."
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=3
#. y4:msg_location=T6.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "572_Akiyama"
msgid "All right."
msgstr "Está bien."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=4
#. y4:msg_location=T6.P4
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "584_キャバ育名前"
msgid "We can't work part-time jobs forever, though. Not if we want to make decent money."
msgstr "No podemos andar con trabajos a medio tiempo para siempre. No si queremos ahorrar buen dinero."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=5
#. y4:msg_location=T6.P5
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "596_キャバ育名前"
msgid "But if we get real jobs, we'll have no time left for the band. Ain't easy trying to chase after your dreams, huh?"
msgstr "Pero si conseguimos trabajos a tiempo completo, no tendremos tiempo para ensayar. No es fácil seguir tus sueños..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=6
#. y4:msg_location=T6.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "608_Akiyama"
msgid "Don't worry about it too much. You never know what'll happen in life. Don't underestimate yourself."
msgstr "No te gastes mucho pensando en eso. Nunca sabrás lo que te prepara la vida. No te subestimes."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=7
#. y4:msg_location=T6.P7
#. y4:msg_speaker=繧ｭ繝｣繝占ご蜷榊燕
#. y4:msg_speaker_id=2
msgctxt "620_キャバ育名前"
msgid "Maybe you're right... Thanks!"
msgstr ""
