#. y4:msg_branch_segment=T14.P13..P19
#. y4:msg_branch_target_text=I can tell you care about the other girls.
#. y4:msg_branch_raw=01 11 00 0d 00 00 00 2a 00 00 00 00 00 00 00 00
msgctxt "11712_Akiyama"
msgid "I can tell you care about the other girls."
msgstr "Se nota que te preocupas por las chicas del club."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=14
#. y4:msg_location=T14.P14
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can tell you care about the other girls.
msgctxt "11724_Rio"
msgid "It's not so much that."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=15
#. y4:msg_location=T14.P15
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can tell you care about the other girls.
msgctxt "11736_Rio"
msgid "I just thought she'd be cuter if she smiled more."
msgstr "Solo pensé que se vería más bonita si sonriera más seguido."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=16
#. y4:msg_location=T14.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can tell you care about the other girls.
msgctxt "11748_Akiyama"
msgid "It's great that you think in such a positive way. That's a real gift."
msgstr "Me encanta tu forma de pensar. Esa actitud positiva es un don."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=45
#. y4:msg_location=T1.P45
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice="Rio, Queen of the Dance"
msgctxt "11760_Rio"
msgid "You think so?"
msgstr "¿De verdad lo cree?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=18
#. y4:msg_location=T14.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can tell you care about the other girls.
msgctxt "11772_Akiyama"
msgid "I sure do."
msgstr "Porsupuesto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=19
#. y4:msg_location=T14.P19
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I can tell you care about the other girls.
msgctxt "11784_Rio"
msgid "Hehe. I'm happy to hear you say that."
msgstr "Je, je. Me alegra oírlo decir eso."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=165
#. y4:msg_phrase=0
#. y4:msg_location=T165.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T14.P20
#. y4:msg_branch_segment=T14.P20..P25
#. y4:msg_branch_target_text=Show me the face you made.
#. y4:msg_branch_raw=01 11 00 14 00 00 00 1a 00 00 00 00 00 00 00 00
msgctxt "11796_Akiyama"
msgid "Show me the face you made."
msgstr "Muéstrame la cara que hiciste."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=21
#. y4:msg_location=T14.P21
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Show me the face you made.
msgctxt "11808_Rio"
msgid "No! That's too embarrassing! Stop teasing me..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=22
#. y4:msg_location=T14.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Show me the face you made.
msgctxt "11820_Akiyama"
msgid "No, I just meant that you should feel relaxed enough with me that you feel comfortable doing that kind of thing."
msgstr "No, lo decía porque me gustaría que te sintieras lo bastante a gusto conmigo como para hacer esas cosas sin pena."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=23
#. y4:msg_location=T14.P23
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Show me the face you made.
msgctxt "11832_Rio"
msgid "Relaxed?"
msgstr "¿A gusto?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=24
#. y4:msg_location=T14.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Show me the face you made.
msgctxt "11844_Akiyama"
msgid "You've got a great smile, but it would be nice if you felt comfortable enough to pull funny faces in front of me once in a while."
msgstr "Tienes una sonrisa preciosa, pero sería lindo que te sintieras cómoda como para hacer caras graciosas frente a mí de vez en cuando."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=25
#. y4:msg_location=T14.P25
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Show me the face you made.
msgctxt "11856_Rio"
msgid "That's sweet. But you know, saying things like that just makes me smile more!"
msgstr "Qué tierno. Pero sabe, ¡decir cosas así solo me hace sonreír más!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
