#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "1883\t1943"
msgid "Why?"
msgstr "¿Tú?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2497\t2597"
msgid "Why're you... still here?"
msgstr "Tú, ¿por qué?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2737\t2876"
msgid "Eh. Thought it'd leave\\na bad taste in my mouth."
msgstr "Pensé que me dejaría\\nun mal sabor de boca."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2904\t2970"
msgid "Ditching you and all."
msgstr "Eso de dejarte atrás."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3065\t3125"
msgid "Besides..."
msgstr "Después de todo..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3159\t3250"
msgid "You're only the second one."
msgstr "tú eres el segundo."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "3393\t3534"
msgid "The second guy who's ever trusted me."
msgstr "El segundo tipo que alguna vez ha confiado en mí."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4171\t4238"
msgid "It's all you this time."
msgstr "Ahora es tu turno."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4326\t4403"
msgid "We made it up here safe."
msgstr "Llegados a este punto, ya estamos a salvo."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4406\t4550"
msgid "Only one thing left now.\\nIt's us against the sea."
msgstr "Lo único que queda es ver\\nsi llegamos a tierra antes de ahogarnos."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "4572\t4637"
msgid "Your clock's ticking."
msgstr "No queda mucho tiempo."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4643\t4681"
msgid "Get down there."
msgstr "Baja de una vez."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4697\t4761"
msgid "I get ya, but I..."
msgstr "Pero yo..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4763\t4823"
msgid "You're on death row!"
msgstr "¡Tú eres el condenado a muerte!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4842\t4946"
msgid "The quicker you can\\nget outta here, the better."
msgstr "Cuando escapemos al primero\\nque buscarán es a ti, adelántate."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4970\t5030"
msgid "But..."
msgstr "Tú..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5052\t5189"
msgid "Don't worry.\\nI got everything I need right here."
msgstr "No te preocupes por mí.\\nTengo una carta de triunfo."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5217\t5318"
msgid "The thing you took from\\nthe warden's office?"
msgstr "¿Es lo que tomaste de la\\noficina del director de la prisión?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "5334\t5486"
msgid "Yup. This here's my ticket back into business."
msgstr "Sí. Gracias a esto podré volver a las andadas."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "5533\t5593"
msgid "Now move!"
msgstr "¡Ya vete!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5836\t5896"
msgid "Catch ya later..."
msgstr "Nos vemos..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5894\t5935"
msgid "Brother."
msgstr "Kyoudai."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "5969\t6029"
msgid "Brother?"
msgstr "¿Kyoudai?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "6040\t6100"
msgid "Ya heard me."
msgstr "Sí."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "6100\t6280"
msgid "Hasn't been long,\\nbut we're partners in crime now."
msgstr "Como puedes notar,\\nahora somos compañeros de crimen."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "6301\t6361"
msgid "Brothers."
msgstr "Kyoudais."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "6406\t6466"
msgid "Saejima..."
msgstr "Saejima..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "6900\t6960"
msgid "Saejima!"
msgstr "¡Saejima!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "6994\t7102"
msgid "If we both somehow make it outta this alive..."
msgstr "Si salimos vivos de aquí y arreglamos nuestros asuntos..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "7103\t7173"
msgid "How 'bout we team up?"
msgstr "¿qué te parece si formamos equipo?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "7208\t7287"
msgid "You and me'd be unstoppable!"
msgstr "¡Juntos seríamos imparables!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "7278\t7403"
msgid "The Tojo... Hell, the whole country could be ours!"
msgstr "¡El Clan Tojo, no, todo Japón podría ser nuestro!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "7413\t7520"
msgid "So, whaddya say?\\nPretty convincing, huh?"
msgstr "¿Y? ¿Qué te parece?\\nBastante convincente, ¿no?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "7543\t7595"
msgid "Hamazaki..."
msgstr "Hamazaki..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "7596\t7635"
msgid "All you've gotta do is make it to shore."
msgstr "Lo único que debes hacer es..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "7704\t7764"
msgid "Hamazaki!"
msgstr "¡Hamazaki!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "7831\t7899"
msgid "Not on my watch."
msgstr "No dejaré que te escapes."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "7933\t8003"
msgid "Criminal scum."
msgstr "Pedazo de mierda."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "8018\t8085"
msgid "Hamazaki!"
msgstr "¡Hamazaki!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "8248\t8308"
msgid "Saejima..."
msgstr "Saejima..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "8403\t8463"
msgid "Kiryu."
msgstr "Kiryu."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "8466\t8613"
msgid "Once you hit shore,\\nsearch out a man named Kiryu."
msgstr "Una vez que llegues a la orilla,\\nbusca a un hombre llamado Kiryu."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "8646\t8739"
msgid "Whaddya mean?\\nWe're goin' together, brother!"
msgstr "¿Qué?\\n¡¿Qué crees que haces, oi?!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "8762\t8865"
msgid "He's here, in Okinawa."
msgstr "Está aquí, en Okinawa."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "8871\t8942"
msgid "Dependable guy."
msgstr "Confía en ese hombre."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "8946\t9041"
msgid "It's Kiryu, got it?"
msgstr "¡Es Kiryu! Recuérdalo."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "9060\t9104"
msgid "Hamazaki?"
msgstr "¿Hamazaki?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "9105\t9201"
msgid "Hamazaki! C'mon!"
msgstr "¡Hamazaki! ¡Oi!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "9326\t9386"
msgid "What are you doing!?\\nLet go!"
msgstr "¿Qué estás haciendo?\\n¡Suéltame!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "9464\t9563"
msgid "No! Stop!"
msgstr "¡Detente! ¡No!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "9564\t9610"
msgid "Don't do it!"
msgstr "¡No lo hagas!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "9747\t9791"
msgid "Hamazaki?"
msgstr "¿Hamazaki?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "9797\t9857"
msgid "Hamazaki!"
msgstr "¡Hamazaki!"

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "9906\t9966"
msgid "Shit!"
msgstr "¡Mierda!"

