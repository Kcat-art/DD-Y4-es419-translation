#. y4:translated_by=MasterCry
#. y4:reviewed_by=Kcat0
msgctxt "204_Player"
msgid "(Amoebatar? Sounds like something the girls at the club would be into.)"
msgstr "(¿Amoebatar? Puede ser un buen tema de conversación con las chicas del club)."

