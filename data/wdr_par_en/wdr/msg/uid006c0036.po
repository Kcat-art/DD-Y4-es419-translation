#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a good idea.
msgctxt "11856_Kiryu"
msgid "That's a good idea. I'm sure it'll cheer up your father."
msgstr "Esa es una buena idea. Seguro que animará a tu padre."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
