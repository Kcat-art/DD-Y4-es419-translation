msgstr "......"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "320_Taniguchi"
msgid "That's when I got your message, Miki, and now here I am."
msgstr "Y justo recibí tu mensaje, Miki-chan. Así que vine volando."

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
msgctxt "332_Miki"
msgid "......"
msgstr "......"

#. y4:line_status=reviewed
#. y4:translated_by=Karu2nd
#. y4:reviewed_by=Karu2nd
msgctxt "344_Taniguchi"
msgid "I'm so sorry. You must've really missed me. But I won't\\r\nstray again. See you at the club!"
msgstr "Lamento haberte hecho sentir sola, Miki-chan. Pero no te seré infiel nunca más. ¡Sigamos adelante juntos! ¡Te veo en el club!"

