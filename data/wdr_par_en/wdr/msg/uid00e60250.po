msgstr "De verdad lo compraste, ¿eh?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=1
msgctxt "592_Rio"
msgid "Hey! You told me to do it!"
msgstr "¡Hey! ¡Tú me dijiste que lo hiciera!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "604_Akiyama"
msgid "You agonized about it for over an hour! If I hadn't said something, we'd still be in there."
msgstr "¡Estabas dándole vueltas más de una hora! Si no hubiera dicho nada, todavía seguiríamos allí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=1
msgctxt "616_Rio"
msgid "Yeah, you're right..."
msgstr "Sí, tienes razón..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "628_Akiyama"
msgid "Well, I hope he gets along with your other dog."
msgstr "Bueno, espero que se lleve bien con tu otro perro."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=1
msgctxt "640_Rio"
msgid "I'm sure he will. But first, I have to take him to the groomer. They'll make him nice and cute!"
msgstr "Estoy segura que sí. Pero primero, debo llevarle a la peluquería. ¡Lo dejarán bonito y adorable!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "652_Akiyama"
msgid "Groomer? Like a beauty salon for dogs?"
msgstr "¿Peluquería? ¿Como un salón de belleza para perros?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=1
msgctxt "664_Rio"
msgid "That's right! I'm going to get him a full doggie makeover!"
msgstr "¡Eso es! ¡Voy a ir para que le hagan un cambio de imagen perruno completo!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
