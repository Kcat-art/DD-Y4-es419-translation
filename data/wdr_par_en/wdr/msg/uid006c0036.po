#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not good for you.
msgctxt "14472_Kiryu"
msgid "Eating nothing all day isn't good for you. Drinking on an empty stomach is especially bad."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=7
#. y4:msg_location=T28.P7
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not good for you.
msgctxt "14484_松岡里緒奈：源氏名"
msgid "I know, but I have to lose weight somehow..."
msgstr "Lo sé, pero tengo que perder peso de alguna manera..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=8
#. y4:msg_location=T28.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not good for you.
msgctxt "14496_Kiryu"
msgid "But not like this. Even if you do lose weight by not eating, you'll gain it all back."
msgstr "Pero no así. Incluso si pierdes peso al no comer, lo recuperarás todo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
