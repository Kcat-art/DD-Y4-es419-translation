#. y4:msg_speaker_id=0
msgctxt "6984_Kiryu"
msgid "And?"
msgstr "¿Y? ¿Qué más?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
