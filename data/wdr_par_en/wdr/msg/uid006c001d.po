#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice="Rio, Queen of the Dance"
msgctxt "7764_Rio"
msgid "You think so?"
msgstr "¿Tú crees?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=38
#. y4:msg_location=T6.P38
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you look good in a yukata.
msgctxt "7776_Akiyama"
msgid "Yeah. I'd like to see what you look like in one."
msgstr "Sí. Me encantaría verte con uno puesto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=39
#. y4:msg_location=T6.P39
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you look good in a yukata.
msgctxt "7788_Rio"
msgid "Oh, Akiyama-san, you're just saying that."
msgstr "Ay, Akiyama-san, solo lo dices para quedar bien."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=40
#. y4:msg_location=T6.P40
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you look good in a yukata.
msgctxt "7800_Akiyama"
msgid "No, I mean it."
msgstr "En verdad lo pienso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=41
#. y4:msg_location=T6.P41
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you look good in a yukata.
msgctxt "7812_Rio"
msgid "Hehe, thanks. I didn't think it'd be that big of a deal. Do you like girls in yukatas?"
msgstr "Jeje, gracias. No pensé que sería para tanto. ¿Te gustan las chicas en yukatas?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=42
#. y4:msg_location=T6.P42
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you look good in a yukata.
msgctxt "7824_Akiyama"
msgid "Yeah. But to be completely accurate, I enjoy taking the yukatas off of girls."
msgstr "Sí. Pero para ser completamente preciso, disfruto quitándole los yukatas a las chicas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=43
#. y4:msg_location=T6.P43
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you look good in a yukata.
msgctxt "7836_Rio"
msgid "Hehehe. Do you imagine that every time you see a girl in a yukata?"
msgstr "Jejeje. ¿Te imaginas eso cada vez que ves a una chica con un yukata?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=44
#. y4:msg_location=T6.P44
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you look good in a yukata.
msgctxt "7848_Akiyama"
msgid "Pretty much... A little daydreaming never hurt anybody."
msgstr "Bastante... Nunca pasó nada por fantasear un poco."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=45
#. y4:msg_location=T6.P45
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you look good in a yukata.
msgctxt "7860_Rio"
msgid "Oh, you do have fun, don't you?"
msgstr "Oh, tú sí que sabes divertirte, ¿eh?"

