msgctxt "248"
msgid "You got the <Color:8>Briefcase with 30 Million Yen<Color:Default>."
msgstr "Obtuviste un <Color:8>maletín con 30 millones de yenes<Color:Default>."

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
msgctxt "2880"
msgid "Akiyama"
msgstr "Akiyama"

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
msgctxt "2884"
msgid "Hana"
msgstr "Hana"

#. y4:line_status=translated
msgctxt "2888"
