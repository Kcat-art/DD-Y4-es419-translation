#. y4:msg_location=T10.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "7668_Kiryu"
msgid "Oh, you mean the guy who runs Kamuro Pro Wrestling? He's getting on in the years. He's been wrestling since I was a kid."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=5
#. y4:msg_location=T10.P5
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "7680_松岡里緒奈：源氏名"
msgid "Yes... I've never told this to anybody before..."
msgstr "Sí... Nunca le había dicho esto a nadie antes..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=6
#. y4:msg_location=T10.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "7692_Kiryu"
msgid "What is it?"
msgstr "¿Qué cosa?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=7
#. y4:msg_location=T10.P7
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "7704_松岡里緒奈：源氏名"
msgid "Thunder Matsuoka is my dad."
msgstr "Thunder Matsuoka es mi papá."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=8
#. y4:msg_location=T10.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "7716_Kiryu"
msgid "What!? Really!?"
msgstr "¡¿Qué?! ¡¿De verdad?!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=9
#. y4:msg_location=T10.P9
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "7728_松岡里緒奈：源氏名"
msgid "Don't tell anybody!"
msgstr "¡No le digas a nadie!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=10
#. y4:msg_location=T10.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "7740_Kiryu"
msgid "The father you had that fight with was... Thunder Matsuoka?"
msgstr "El padre con el que tuviste esa pelea fue... ¿Thunder Matsuoka?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=11
#. y4:msg_location=T10.P11
