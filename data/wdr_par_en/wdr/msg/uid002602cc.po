#. y4:line_status=translated
msgctxt "548_Akiyama"
msgid "First, let's go over the basics of how to interact with a\\r\ncustomer on a date."
msgstr "Primero, vamos a repasar los conceptos básicos de como\\r\ninteractuar con un cliente."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
