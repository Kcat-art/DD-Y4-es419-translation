#. y4:msg_branch_target=T0.P7
#. y4:msg_branch_segment=T0.P7..P15
#. y4:msg_branch_target_text=It's probably because I enjoy my work.
#. y4:msg_branch_raw=01 11 00 07 00 00 00 26 00 00 00 00 00 00 00 00
msgctxt "4164_Akiyama"
msgid "It's probably because I enjoy my work."
msgstr "De seguro es porque disfruto mi trabajo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
