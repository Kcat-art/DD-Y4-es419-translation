msgid "[......]"
msgstr "[......]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=19
#. y4:msg_location=T6.P19
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1364_Nair"
msgid "[Marcos! ...Marcos!]"
msgstr "[¡Marcos!... ¡Marcos!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=20
#. y4:msg_location=T6.P20
#. y4:msg_speaker=Threatening Man
#. y4:msg_speaker_id=21
msgctxt "1376_Threatening Man"
msgid "[Now listen up, you idiots.]"
msgstr "[Ahora escúchenme, idiotas.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=21
#. y4:msg_location=T6.P21
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1388_Nair"
msgid "[Is this GG?]"
msgstr "[¿Eres GG?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=22
#. y4:msg_location=T6.P22
#. y4:msg_speaker=GG
#. y4:msg_speaker_id=22
msgctxt "1400_GG"
msgid "[That's one of my aliases.]"
msgstr "[Es uno de mis seudónimos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=23
#. y4:msg_location=T6.P23
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1412_Nair"
msgid "[What are you planning on doing with Marcos!? We know you've got Garcia, too!]"
msgstr "[¿Qué piensas hacer con Marcos? ¡Sabemos que tienes a Garcia\ntambién!]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=24
#. y4:msg_location=T6.P24
#. y4:msg_speaker=GG
#. y4:msg_speaker_id=22
msgctxt "1424_GG"
msgid "[That's entirely up to you.]"
msgstr "[Eso dependerá de ti.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=25
#. y4:msg_location=T6.P25
#. y4:msg_speaker=GG
#. y4:msg_speaker_id=22
msgctxt "1436_GG"
msgid "[If you intend to keep snooping around, then you'll all be taking a trip to the bottom of the sea.]"
msgstr "[Si insisten en meterse donde no les llaman, todos van a\nterminar en el fondo del mar.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=26
#. y4:msg_location=T6.P26
#. y4:msg_speaker=GG
#. y4:msg_speaker_id=22
msgctxt "1448_GG"
msgid "[But if you keep to yourselves, I'll let them go when the time is right.]"
msgstr "[Pero si se mantuvieran al margen, los dejaría ir cuando\nllegue el momento adecuado.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=27
#. y4:msg_location=T6.P27
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1460_Nair"
msgid "[Let them go? We're not that stupid. Someone as evil as you would never be so gracious.]"
msgstr "[¿Dejarlos ir? No somos idiotas. Alguien tan horrible como tú,\nnunca haría algo por generosidad.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=28
#. y4:msg_location=T6.P28
#. y4:msg_speaker=GG
#. y4:msg_speaker_id=22
msgctxt "1472_GG"
msgid "[Then do as you like. Their fate is up to you.]"
msgstr "[Haz lo que quieras. El destino de tus amigos, depende de ti.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=29
#. y4:msg_location=T6.P29
#. y4:msg_speaker=GG
#. y4:msg_speaker_id=22
msgctxt "1484_GG"
msgid "[So don't forget.]"
msgstr "[No lo olvides.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=30
#. y4:msg_location=T6.P30
#. y4:msg_speaker=GG
#. y4:msg_speaker_id=22
msgctxt "1496_GG"
msgid "*click*"
msgstr "*click*"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=37
#. y4:msg_location=T6.P37
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1580_Nair"
msgid "[I don't get it... What the hell is GG up to?]"
msgstr "[No lo entiendo..., ¿qué está tramando GG?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=38
#. y4:msg_location=T6.P38
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "1592_Tanimura"
msgid "[I don't know what his goal is, but there's something else I don't get.]"
msgstr "[No sé cuál sea su propósito, pero hay algo más que no me\ncuadra.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=39
#. y4:msg_location=T6.P39
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "1604_Tanimura"
msgid "[The first person to call was Marcos.]"
msgstr "[La primera persona en llamarte fue Marcos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=40
#. y4:msg_location=T6.P40
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "1616_Tanimura"
msgid "[If Marcos was captured, how could he be free to use the phone?]"
msgstr "[Si lo capturaron, ¿cómo pudo usar el teléfono para llamar?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=41
#. y4:msg_location=T6.P41
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "1628_Tanimura"
msgid "[The only explanation is that GG had Marcos make the call.]"
msgstr "[La única explicación sería que GG le dijo a Marcos que hiciera\nesa llamada.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=42
#. y4:msg_location=T6.P42
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1640_Nair"
msgid "[To inform us that he was okay?]"
msgstr "[¿Para informar que estaba bien?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=43
#. y4:msg_location=T6.P43
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "1652_Tanimura"
msgid "[I guess? He kept Marcos alive and even went out of his way to let us know. I'm pretty sure he wants to make a deal.]"
msgstr "[Eso creo. GG mantuvo a Marcos con vida e incluso hizo que nos\nllamara. Estoy seguro de que quiere hacer algún tipo de trato.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=44
#. y4:msg_location=T6.P44
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "1664_Tanimura"
msgid "[And if that's the case, then he probably wasn't lying about his end of the bargain.]"
msgstr "[Si ese es el caso, probablemente no este mintiendo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=45
#. y4:msg_location=T6.P45
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1676_Nair"
msgid "[You mean he'll let everyone go if we keep to ourselves?]"
msgstr "[¿Te refieres a que los dejara ir si no hacemos nada?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=46
#. y4:msg_location=T6.P46
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "1688_Tanimura"
msgid "[Exactly. And if he doesn't intend to keep them hostage or to kill you, it means he's got some kind of reason.]"
msgstr "[Precisamente. Si no planea tenerlos como rehenes ni\nasesinarlos, significa que tendrá algún motivo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=47
#. y4:msg_location=T6.P47
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1700_Nair"
msgid "[What the hell is GG up to?]"
msgstr "[¿Qué diablos estará tramando GG?]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=48
#. y4:msg_location=T6.P48
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "1712_Tanimura"
msgid "[I have a feeling if you do as he says and stay out of his business, you'll all be allowed to return home safely.]"
msgstr "[Tengo el presentimiento que si haces lo que dice, y ya no te\nmetes en sus asuntos, todos ustedes podrían regresar a casa\nsanos y salvos.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=49
#. y4:msg_location=T6.P49
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "1724_Tanimura"
msgid "[But you'll also miss your only chance to bring him down.]"
msgstr "[Pero..., también perderías la única oportunidad de atraparlo.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=50
#. y4:msg_location=T6.P50
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1736_Nair"
msgid "[Talk about tough decisions...]"
msgstr "[Es una decisión difícil...]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=51
#. y4:msg_location=T6.P51
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=2
msgctxt "1748_Tanimura"
msgid "[This is out of my hands now. Ultimately, this is a decision that you will have to make.]"
msgstr "[No está en mí decidir. Al final, esto es una decisión que\ntendrás que enfrentar tú.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=18
#. y4:msg_location=T6.P18
#. y4:msg_speaker=Marcos
#. y4:msg_speaker_id=20
msgctxt "1760_Nair"
msgid "[......]"
msgstr "[......]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=53
#. y4:msg_location=T6.P53
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1772_Nair"
msgid "[I wanna get the criminal who killed my family.]"
msgstr "[Quiero atrapar al criminal que asesino a mi familia.]"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=54
#. y4:msg_location=T6.P54
#. y4:msg_speaker=Nair
#. y4:msg_speaker_id=1
msgctxt "1784_Nair"
msgid "[And I'm sure Marcos feels the same. I know if I go home just because the killer told me to, I'll regret it for the rest of my life.]"
msgstr "[Y estoy segura de que Marcos piensa igual. Sí, me voy solo\nporque el asesino me lo dijo; sé que lo lamentaré por el resto\nde mi vida.]"

