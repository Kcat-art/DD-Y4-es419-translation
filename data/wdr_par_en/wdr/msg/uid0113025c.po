msgid "This is a bulletin from HQ."
msgstr "Este es un boletín del cuartel general."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "264_Radio"
msgid "An assault has been reported on West Shichifuku Street. The assailant has fled the scene."
msgstr "Un asalto fue reportado al oeste de la calle Shichifuku. El agresor ha huido del lugar."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "276_Radio"
