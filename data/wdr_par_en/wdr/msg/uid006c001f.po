#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Don't you gain weight eating like that?
msgctxt "7560_Noa"
msgid "Yeah. I couldn't eat sweets if I thought I might get fat."
msgstr "Sí. No podría comer dulces si pensara que podría engordar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=27
