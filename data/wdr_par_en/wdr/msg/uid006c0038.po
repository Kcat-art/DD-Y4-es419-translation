#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You're right.
msgctxt "4920_望月京子：源氏名"
msgid "Right! Do you listen to Western music, Kiryu-san?"
msgstr "¡Eso es! ¿Escuchas música occidental, Kiryu-san?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=8
