#. y4:msg_phrase=68
#. y4:msg_location=T0.P68
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=9
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You take care of her, Yusuke.
msgctxt "916_Naoya"
msgid "Thanks again, man!"
msgstr "¡Gracias otra vez, amigo!"

