#. y4:msg_speaker=Player
#. y4:msg_speaker_id=0
msgctxt "928_Player"
msgid "(I should come back when I'm alone.)"
msgstr "(Debería volver cuando este solo.)"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "952_Minamida"
msgid "There you are. Hm? What's that suitcase for?"
msgstr "Ahí estás. ¿Mm? ¿Y ese maletín para que es?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "964_Minamida"
msgid "Oh! Are you going to invest in my machine? Of course I would be happy to accept your money! Heheheh..."
msgstr "¡Ah! ¿Vas a invertir en mi máquina? ¡Estaré encantado de aceptar tu dinero! Je, je, je..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=0
msgctxt "976_Player"
msgid "(I can't let him have this suitcase. I'll have to come back later.)"
msgstr "(No puedo dejarle tener el maletín. Tendré que volver más tarde.)"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=0
#. y4:msg_location=T4.P0
#. y4:msg_speaker=Man in White
#. y4:msg_speaker_id=2
msgctxt "988_Man in White"
msgid "Hm? Who are you? Do you need something?"
msgstr "¿Mm? ¿Quién eres? ¿Necesitas algo?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1000_Man in White"
msgid "Oh! Are you going to invest in my machine? Of course I would be happy to accept your money! Heheheh..."
msgstr "¡Ah! ¿Vas a invertir en mi máquina? ¡Estaré encantado de aceptar tu dinero! Je, je, je..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=0
msgctxt "1012_Player"
msgid "(I can't let him have this suitcase. I'll have to come back later.)"
msgstr "(No puedo dejarle tener el maletín. Tendré que volver más tarde.)"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=0
#. y4:msg_location=T3.P0
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1024_Minamida"
msgid "Hm? Oh, it's you, Kiryu-kun."
msgstr "¿Mm? Ah, eres tú, Kiryu-kun."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=1
#. y4:msg_location=T3.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=3
msgctxt "1036_Kiryu"
msgid "And you're... Minamida. It sure has been a while."
msgstr "Eres... Minamida, sí que ha pasado tiempo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=2
#. y4:msg_location=T3.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=3
msgctxt "1048_Kiryu"
msgid "Are you still working on that invention of yours?"
msgstr "¿Todavía sigues trabajando en aquel invento tuyo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=3
#. y4:msg_location=T3.P3
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1060_Minamida"
msgid "Heheheh. Don't assume it's the same as that hunk of junk a year back."
msgstr "Je, je, je. No pienses que es igual al montón de chatarra del año\n"
"pasado."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=4
#. y4:msg_location=T3.P4
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1072_Minamida"
msgid "I call this the Inner Fighter VII Revolution! Or the IF7-R, for short."
msgstr "¡Lo llamo Inner Fighter VII Revolution! O simplemente\n"
"IF7-R, para abreviar."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=5
#. y4:msg_location=T3.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=3
msgctxt "1084_Kiryu"
msgid "The IF7-R, huh..."
msgstr "El IF7-R, eh..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=6
#. y4:msg_location=T3.P6
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1096_Minamida"
msgid "It's got a slew of new features, and the structure's way more stable. Hehehehe."
msgstr "Tiene un montón de características nuevas, y la estructura\n"
"también es mucho más estable. Je, je, je."

msgctxt "1108_Minamida"
msgid "Compared to before, some of the mechanisms have changed,\\r\n"
"so be careful about that."
msgstr "A comparación de antes, algunos mecanismos cambiaron, así que\\r\n"
"ten cuidado con eso."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
