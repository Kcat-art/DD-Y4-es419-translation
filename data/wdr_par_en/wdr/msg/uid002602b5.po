#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why the hell not?
msgctxt "940_Saejima"
msgid "(Seems like it finally dropped its guard.)"
msgstr "(Parece que por fin bajó la guardia.)"

#. y4:line_status=translated
msgctxt "952_Cat-loving Homeless Man"
msgid "Wow, you're good. Poor things wouldn't even give me\\r\nthe time of day."
msgstr "Wow, eres bueno. Pobrecitos ni siquiera me darían\\r\nla hora en la calle."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
