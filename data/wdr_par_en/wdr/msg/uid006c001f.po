#. y4:msg_branch_target=T10.P9
#. y4:msg_branch_segment=T10.P9..P14
#. y4:msg_branch_target_text=What a creep.
#. y4:msg_branch_raw=01 11 00 09 00 00 00 0d 00 00 00 00 00 00 00 00
msgctxt "7716_Akiyama"
msgid "What a creep."
msgstr "Qué rarito."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=10
#. y4:msg_location=T10.P10
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What a creep.
msgctxt "7728_Noa"
msgid "I know! Oh, why does this have to happen to me?"
msgstr "¡Lo sé! Oh, ¿Por qué me tiene que pasar esto a mí?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=11
#. y4:msg_location=T10.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What a creep.
msgctxt "7740_Akiyama"
msgid "When you first met him, did you notice anything strange?"
msgstr "La primera vez que lo conociste, ¿notaste algo extraño?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=12
#. y4:msg_location=T10.P12
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What a creep.
msgctxt "7752_Noa"
msgid "No, he was just a normal customer. But after a while, he started to change."
msgstr "No, era un cliente normal. Pero después de un tiempo, empezó a cambiar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=13
#. y4:msg_location=T10.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What a creep.
msgctxt "7764_Akiyama"
msgid "Maybe there's something about you that drives men insane..."
msgstr "Tal vez hay algo en ti que vuelve locos a los hombres..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=10
#. y4:msg_phrase=14
#. y4:msg_location=T10.P14
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What a creep.
msgctxt "7776_Noa"
msgid "What!? Are you saying it's my fault!?"
msgstr "¿¡Qué!? ¿¡Está diciendo que es mi culpa!?"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
#. y4:msg_talk=152
