#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll pass.
msgctxt "9528_松岡里緒奈：源氏名"
msgid "Seriously? Aww, you're such a party pooper..."
msgstr "¿En serio? Aww, eres un aguafiestas..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=24
