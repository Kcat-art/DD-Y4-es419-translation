#. y4:msg_location=T5.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I bet he was Italian.
msgctxt "5916_Akiyama"
msgid " Italians think that it's polite to try to hit on a pretty girl when they see one."
msgstr " Ya sabes, los italianos creen que es de mala educación no coquetear con una chica cuando la ven."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=13
#. y4:msg_location=T5.P13
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I bet he was Italian.
msgctxt "5928_Noa"
msgid "Really? You mean I wasn't the only one he's said that to?"
msgstr "¿De verdad? ¿Quiere decir que no he sido la única a la que le han dicho eso?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
