#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You're right.
msgctxt "4944_望月京子：源氏名"
msgid "Why? Because you don't understand the lyrics?"
msgstr "¿Por qué? ¿No entiendes lo que dicen o por sus letras?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=10
#. y4:msg_location=T2.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You're right.
msgctxt "4956_Kiryu"
msgid "No, I just don't like the songs. If they had songs in English that sounded like traditional Japanese ballads, I'd probably listen to them."
msgstr "No, simplemente no me gustan. Si las canciones en inglés sonaran como baladas tradicionales japonesas, posiblemente las escucharía."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
