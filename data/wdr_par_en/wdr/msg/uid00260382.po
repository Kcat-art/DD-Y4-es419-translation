msgctxt "144_Tanimura"
msgid "...Well?"
msgstr "... ¿Y bien?"

#. y4:line_status=translated
msgctxt "156_Smith"
msgid "Yes! This is it! This is exactly what I was talking about!\\r\nWhat's the name of this game again?"
msgstr "¡Sí! ¡Esto es! ¡Esto es exactamente de lo que estaba hablando!\\r\n¿Cómo era que se llamaba este juego?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "168_Tanimura"
msgid "It's called shogi."
msgstr "Se llama shogi."

#. y4:line_status=translated
msgctxt "180_Smith"
msgid "That's right! Shogi! The tension in here's so thick,\\r\nyou could cut it with a knife!"
msgstr "¡Así es! ¡Shogi! La tensión aquí es tan tensa,\\r\n¡que podrías cortarla con un cuchillo!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Smith
#. y4:msg_speaker_id=0
msgctxt "192_Smith"
msgid "This's some good shit, m'dude!"
msgstr "¡Esta es la mierda que buscaba, amigo!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "204_Tanimura"
msgid "(Well, he sounds satisfied.)"
msgstr "(Bueno, parece satisfecho)."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "216_Tanimura"
msgid "I'm happy for you. So is it cool if I leave now?"
msgstr "Me alegro por ti. Entonces, ¿está bien si me voy ahora?"

#. y4:line_status=translated
msgctxt "228_Smith"
msgid "Well, if you wouldn't mind kickin' it with me for a little\\r\nlonger, there is one more place I want to go. But that's it."
msgstr "Bueno, si no te importara pasarla conmigo por un rato\\r\nmás, hay un lugar más al que quiero ir. Pero eso es todo."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "240_Tanimura"
msgid "...Might as well see this through. Fine, where to?"
msgstr "... Bien, debería haber visto venir esa. Bien, ¿a dónde?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Smith
#. y4:msg_speaker_id=0
msgctxt "252_Smith"
msgid "I want to go somewhere where only men are allowed..."
msgstr "Quiero ir a un lugar donde solo se permitan hombres..."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "264_Tanimura"
msgid "Uh... I'm not quite sure I get it."
msgstr "Este... No estoy muy seguro de entenderlo."

#. y4:line_status=translated
msgctxt "276_Smith"
msgid "You know what I mean! I forgot the exact name...\\r\nLet's see here..."
msgstr "¡Sabes a lo que me refiero! Olvidé el nombre exacto...\\r\nDéjame ver..."

#. y4:line_status=translated
msgctxt "288_Smith"
msgid "It's a place where it's men only, and everybody is naked.\\r\nThey rub shoulders and communicate with each other.\\r\nSomething like that."
msgstr "Es un lugar donde solo hay hombres y todos están desnudos.\\r\nSe codean y se comunican entre sí.\\r\nAlgo así."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "300_Tanimura"
msgid "...Drawing a total blank here."
msgstr "... No se me enciende ni una bombilla a decir verdad."

#. y4:line_status=translated
msgctxt "312_Smith"
msgid "Oh, come on! You know what I mean! A men's only place\\r\nwhere everybody's naked! Japan is known for this shit!"
msgstr "¡Vamos! ¡Sabes a lo que me refiero! Un lugar solo para hombres\\r\n¡Donde todo el mundo está desnudo! ¡Japón es conocido por esta mierda!"

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
