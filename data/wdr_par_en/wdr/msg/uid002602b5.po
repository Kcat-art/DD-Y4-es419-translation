#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why the hell not?
msgctxt "976_Cat-loving Homeless Man"
msgid "We gotta get some nutrition into these little guys."
msgstr "Tenemos que nutrir un poco a estos pequeñines."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
