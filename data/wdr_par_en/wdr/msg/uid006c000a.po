#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=A pure and innocent woman.
msgctxt "5040_Chihiro"
msgid "Huh? That's your type?"
msgstr "Oh, así que ese es su ideal."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
