#. y4:msg_location=T0.P1
#. y4:msg_speaker=Matsuyama
#. y4:msg_speaker_id=2
msgctxt "144_Matsuyama"
msgid "Yeah. I think I must've eaten at every single place in town."
msgstr "Sí. Creo que he comido en casi todos los lugares de la ciudad."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
