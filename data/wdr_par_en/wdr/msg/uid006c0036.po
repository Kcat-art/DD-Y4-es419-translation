#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a good idea.
msgctxt "11916_Kiryu"
msgid "So when are you going to do it?"
msgstr "Entonces, ¿cuándo lo vas a hacer?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=12
#. y4:msg_location=T21.P12
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's a good idea.
msgctxt "11928_松岡里緒奈：源氏名"
msgid "I think I'm gonna need about a week to work up the courage."
msgstr "Creo que voy a necesitar una semana para armarme de valor."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
