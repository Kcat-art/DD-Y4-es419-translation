#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=21
msgctxt "2076_Tanimura"
msgid "Hi. I'm Tanimura."
msgstr "Hola. Me llamo Tanimura."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=2
#. y4:msg_location=T34.P2
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "2088_峰村七海：源氏名"
msgid "You're quite young, aren't you, Tanimura-san? What do you do for a living?"
msgstr "Es usted muy joven, Tanimura-san, ¿o me equivoco? ¿A qué se dedica?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=3
#. y4:msg_location=T34.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=21
msgctxt "2100_Tanimura"
msgid "I'm a policeman."
msgstr "Soy policía."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=4
#. y4:msg_location=T34.P4
#. y4:msg_speaker=蟲ｰ譚台ｸ�豬ｷ�ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Unfortunately, no. -> T34.P5 | 2. Why? Do I look like one? -> T34.P11 | 3. Mm-hm. That's right. -> T34.P17
msgctxt "2112_峰村七海：源氏名"
msgid "Really? You're a policeman!? Are you one of the higher-ups, by any chance?"
msgstr "Oh, ¡¿policía?! Por casualidad, ¿no será usted un alto mando?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=5
#. y4:msg_location=T34.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=21
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Unfortunately, no.
msgctxt "2124_Tanimura"
msgid "Unfortunately, no. I'm just an ordinary beat cop."
msgstr "Lastimosamente, no. Soy un policía común y corriente."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=34
#. y4:msg_phrase=6
