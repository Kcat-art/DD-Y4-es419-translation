#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Why don't you look for a boyfriend?
msgctxt "4872_Kiryu"
msgid "Why don't you look for a boyfriend? That's the simplest solution."
msgstr "¿Por qué no te buscas un novio? Es la solución más sencilla."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=10
#. y4:msg_location=T2.P10
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Why don't you look for a boyfriend?
msgctxt "4884_松岡里緒奈：源氏名"
msgid "Easier said than done. I can't seem to meet anybody I like."
msgstr "Es más fácil decirlo que hacerlo. Parece que no puedo conocer a nadie que me guste."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=11
#. y4:msg_location=T2.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Why don't you look for a boyfriend?
msgctxt "4896_Kiryu"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=12
#. y4:msg_location=T2.P12
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Why don't you look for a boyfriend?
msgctxt "4908_松岡里緒奈：源氏名"
msgid "Well, I've got pretty high standards."
msgstr "Bueno, tengo estándares bastante altos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=13
#. y4:msg_location=T2.P13
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Why don't you look for a boyfriend?
msgctxt "4920_松岡里緒奈：源氏名"
msgid "Most men just can't live up to them."
msgstr "La mayoría de los hombres no pueden estar a su altura."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=14
#. y4:msg_location=T2.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Why don't you look for a boyfriend?
msgctxt "4932_Kiryu"
msgid "What about me?"
msgstr "¿Y yo qué?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=15
#. y4:msg_location=T2.P15
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Why don't you look for a boyfriend?
msgctxt "4944_松岡里緒奈：源氏名"
msgid "Hmm... Well, you're handsome enough, but I have to know you better to say for sure."
msgstr "Hmm... Bueno, Usted es bastante guapo, pero tengo que conocerlo mejor para decirlo con certeza."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=16
#. y4:msg_location=T2.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Why don't you look for a boyfriend?
msgctxt "4956_Kiryu"
msgid "So you're saying I should come to the club more often?"
msgstr "¿Estás diciendo que debería venir al club más a menudo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=17
