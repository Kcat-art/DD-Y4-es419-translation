#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Yes -> T0.P16 | 2. No -> T0.P19
msgctxt "324_Saigo"
msgid "Are you ready?"
msgstr "¿Estás listo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Yes
msgctxt "336_Akiyama"
msgid "Ready as I'll ever be."
msgstr "Ja, claro que estoy listo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Saigo
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Yes
msgctxt "348_Saigo"
msgid "All right! Start!"
msgstr "¡Muy bien! ¡Comencemos!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=No
msgctxt "372_Akiyama"
msgid "I just remembered something I have to do..."
msgstr "Acabo de recordar que tenía que hacer algo..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Saigo
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=No
msgctxt "384_Saigo"
msgid "Huh? You starting to slack off?"
msgstr "¿Eh? ¿Te empiezas a acobardar?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Saigo
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=No
msgctxt "396_Saigo"
msgid "But if you have other business, I can't stop you. Come back when you have more time."
msgstr "Pero si tienes cosas que hacer, no puedo detenerte. Vuelve cuando tengas tiempo."

