#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "14208_松岡里緒奈：源氏名"
msgid "Next time, I'll be in tiptop shape!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
