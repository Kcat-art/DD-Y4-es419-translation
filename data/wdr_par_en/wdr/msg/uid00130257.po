#. y4:msg_phrase=33
#. y4:msg_location=T1.P33
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=3
msgctxt "480_Tanimura"
msgid "Mmhm, of course."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=34
#. y4:msg_location=T1.P34
#. y4:msg_speaker=Akaishi
#. y4:msg_speaker_id=0
msgctxt "492_Akaishi"
msgid "Thank you, Tanimura-san. Please come see me if there's anything I can do for you."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=35
#. y4:msg_location=T1.P35
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=3
msgctxt "504_Tanimura"
msgid "You bet. See you around."
msgstr ""

