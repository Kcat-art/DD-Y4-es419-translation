msgctxt "92_Shizuka"
msgid "Kiryu-san..."
msgstr "Kiryu-san..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "104_Kiryu"
msgid "What's wrong? You sound down."
msgstr "¿Qué pasa? Suenas desanimada."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=1
msgctxt "116_Shizuka"
msgid "Well, my purse got stolen..."
msgstr "Pues, la verdad es que... me robaron el bolso..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "128_Kiryu"
msgid "What? Where?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=1
msgctxt "140_Shizuka"
msgid "Just a minute ago. I was walking down Pink Street."
msgstr "Hace un momento... mientras caminaba por la Calle Pink..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=1
msgctxt "152_Shizuka"
msgid "A man ran up behind me and snatched it."
msgstr "Un hombre corrió por detrás y me lo quitó."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "164_Kiryu"
msgid "What did he look like?"
msgstr "¿Cómo era el ladrón?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=1
msgctxt "176_Shizuka"
msgid "It was so sudden... I didn't get a good look at him. I just know it was a man."
msgstr "Fue todo tan de repente... No lo pude ver bien. Solo sé que era un hombre."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "188_Kiryu"
msgid "Hmm... Still, a man walking around with a woman's purse will stand out."
msgstr "Mmm... Aun así, un hombre caminando con un bolso de mujer llamará la atención."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "200_Kiryu"
msgid "I'll take a look around there."
msgstr "Voy a darme una vuelta por ahí."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=1
msgctxt "212_Shizuka"
msgid "Thank you. There were some important things in that purse..."
msgstr "Gracias. Había algunas cosas importantes en ese bolso..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "224_Kiryu"
msgid "I bet. I'll call you if I find anything."
msgstr "Seguro. Te llamo si encuentro algo."
