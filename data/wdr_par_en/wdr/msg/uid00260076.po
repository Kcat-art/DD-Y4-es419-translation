#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Maybe he's hungry.
msgctxt "984_Kiryu"
msgid "What do you mean?"
msgstr "¿A qué te refieres?"

#. y4:line_status=translated
msgctxt "996_Date"
msgid "When I told the store clerk I was getting milk for my kid,\\r\nshe told me a baby shouldn't be drinking cow milk at this\\r\nage!"
msgstr "¡Cuando le dije al dependiente que buscaba leche para mi \\r\nniño, me dijo que un bebé no debería beber leche de vaca\\r\na su edad!"

#. y4:line_status=translated
msgctxt "1008_Date"
msgid "So I ended up buying formula instead. I'm glad at least\\r\nsomeone knows what they're talking about around here."
msgstr "Así que compré leche en polvo para bebés. Me alegra saber\\r\nque al menos alguien ahí fuera sabe de lo que habla."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
