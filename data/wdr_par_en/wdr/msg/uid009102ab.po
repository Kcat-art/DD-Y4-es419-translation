#. y4:msg_speaker_id=0
msgctxt "56_Tanimura"
msgid "(I wonder what the fastest way into Kamurocho Central Parking is...)"
msgstr "(Cuál será el camino más rápido para ir al estacionamiento\ncentral de Kamurocho...)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
