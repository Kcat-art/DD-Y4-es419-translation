#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not good for you.
msgctxt "14532_松岡里緒奈：源氏名"
msgid "How did you know that!?"
msgstr "¿¡Cómo lo supiste!?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=12
