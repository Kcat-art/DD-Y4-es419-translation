#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not good for you.
msgctxt "14544_Kiryu"
msgid "Heh, you're pretty easy to read."
msgstr "Je, eres bastante fácil de leer."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=13
#. y4:msg_location=T28.P13
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not good for you.
msgctxt "14556_松岡里緒奈：源氏名"
msgid "I don't know what to do. Should I exercise more?"
msgstr "No sé qué hacer. ¿Debería ejercitarme mas?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=14
#. y4:msg_location=T28.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not good for you.
msgctxt "14568_Kiryu"
msgid "I think you're getting enough exercise now. You should lose weight if you keep at it."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=15
#. y4:msg_location=T28.P15
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not good for you.
msgctxt "14580_松岡里緒奈：源氏名"
msgid "Really? That makes me feel a little better."
msgstr "¿De verdad? Eso me hace sentir un poco mejor."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=16
#. y4:msg_location=T28.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't I buy you something tasty?
msgctxt "14592_Kiryu"
msgid "Why don't I buy you something tasty? I wouldn't want you to faint from hunger."
msgstr "¿Por qué no te compro algo sabroso? No me gustaría que te desmayaras de hambre."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=17
#. y4:msg_location=T28.P17
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't I buy you something tasty?
msgctxt "14604_松岡里緒奈：源氏名"
msgid "Hey! That's not going to help my diet!"
msgstr "¡Ey! ¡Eso no va a ayudar a mi dieta!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=18
#. y4:msg_location=T28.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't I buy you something tasty?
msgctxt "14616_Kiryu"
msgid "I know you want to look good, but don't do it at the expense of your health. So what do you want to eat?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=19
#. y4:msg_location=T28.P19
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't I buy you something tasty?
msgctxt "14628_松岡里緒奈：源氏名"
msgid "Kiryu-san! Ugh. Well... M...Meat..."
msgstr "Kiryu-san! Ugh. Bueno... C...Carne..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=20
#. y4:msg_location=T28.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't I buy you something tasty?
msgctxt "14640_Kiryu"
msgid "You don't need anything heavy like that. As long as it's nutritious. How about something lighter?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=21
#. y4:msg_location=T28.P21
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't I buy you something tasty?
msgctxt "14652_松岡里緒奈：源氏名"
msgid "But I love meat..."
msgstr "Pero me encanta la carne..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=22
#. y4:msg_location=T28.P22
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Why don't I buy you something tasty?
msgctxt "14664_Kiryu"
msgid "Uh... Maybe we should start by talking about what makes up a balanced diet."
msgstr "Este... Quizás deberíamos empezar hablando de lo que compone una dieta equilibrada."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
