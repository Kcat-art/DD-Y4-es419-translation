#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Buyer
#. y4:msg_speaker_id=2
msgctxt "108_Buyer"
msgid "I really owe you for this. Talk to you later."
msgstr "Te debo una por esto. Hablamos luego."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Man in Disguise
#. y4:msg_speaker_id=0
