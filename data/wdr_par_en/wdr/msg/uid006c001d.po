#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I hear a lot of people quit after a few weeks.
msgctxt "9060_Rio"
msgid "Huh? Why?"
msgstr "¿Eh? ¿Por qué?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=17
