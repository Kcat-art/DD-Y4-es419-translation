msgid "I won't object if that's what you want."
msgstr "No me voy a oponer si eso es lo que quieres."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=39
#. y4:msg_location=T0.P39
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Go Shopping
msgctxt "812"
msgid "I wonder what is in season right now? Oh, now I am excited!"
msgstr "Me pregunto qué estará de temporada ahora mismo. Oh, ¡ahora estoy emocionada!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
