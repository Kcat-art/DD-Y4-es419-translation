#. y4:msg_branch_segment=T1.P13..P75
#. y4:msg_branch_target_text=Don't know. I'd say both are important. Sure, efficiency's important, but yer ideas are too extreme.
#. y4:msg_branch_raw=01 11 00 0d 00 00 00 0b 00 00 00 00 00 00 00 00
msgctxt "3012_Saejima"
msgid "Don't know."
msgstr ""

#. y4:msg_type=choice
