msgid "Quit"
msgstr "Salir"

#. y4:line_status=reviewed
#. y4:translated_by=Kcat0
#. y4:reviewed_by=Kcat0
msgctxt "433"
msgid "Cancel the order."
msgstr "Cancelar pedido."

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
msgctxt "451"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=reviewed
#. y4:translated_by=Kcat0
#. y4:reviewed_by=Kcat0
msgctxt "457"
msgid "Order the currently selected item."
msgstr "Pagar el objeto seleccionado."

#. y4:line_status=translated
msgctxt "492"
msgid "(I haven't picked anything.)"
msgstr "(No he escogido nada)"

#. y4:line_status=translated
msgctxt "521"
msgid "(I'm short on cash.)"
msgstr "(Me hace falta dinero)"

#. y4:line_status=translated
msgctxt "542"
msgid "Thank you. Your total comes to %s."
msgstr "Gracias. El precio total es de %s."

#. y4:line_status=translated
msgctxt "577"
msgid "(I can't eat anymore...)"
msgstr "(No puedo comer más...)"

#. y4:line_status=translated
msgctxt "625"
msgid "Our limited-edition black gelato. Looks can be\ndeceiving: it's actually chock-full of fruity flavor."
msgstr "Nuestro helato negro de edición limitada. Las\napariencias pueden engañar: en realidad tiene un\nfuerte sabor frutal."

#. y4:line_status=translated
msgctxt "726"
msgid "A single scoop of our popular vanilla gelato made \nwith real vanilla beans."
msgstr "Una cucharada de nuestro popular helado de\nvainilla elaborado con auténticas vainas de\nvainilla."

#. y4:line_status=translated
msgctxt "802"
msgid "Strawberry gelato is especially popular with girls for \nits uniquely sweet and tangy flavor."
msgstr "El helado de fresa es especialmente popular entre las\nchicas por su inigualable sabor dulce y ácido."

#. y4:line_status=translated
msgctxt "895"
msgid "A single scoop of chocolate gelato. Its slightly bitter \ntaste is popular with adults."
msgstr "Una bola de helado de chocolate. Su sabor ligeramente\namargo es popular entre los adultos."

#. y4:line_status=translated
msgctxt "982"
msgid "Popular gelato made with sweet azuki beans. Loved \nby all ages."
msgstr "Helado popular elaborado con judías azuki dulces.\nPopular entre todas las edades."

#. y4:line_status=translated
msgctxt "1046"
msgid "Who doesn't enjoy the sweet, sugary taste of caramel\ngelato?"
msgstr "¿A quién no le gusta el sabor dulce y azucarado del\nhelado de caramelo?"

#. y4:line_status=translated
msgctxt "1107"
msgid "A single scoop of coffee gelato made with \nhigh-quality mocha bean extract."
msgstr "Una bola de helado de café elaborado con\nextracto de moca de granos de alta\ncalidad."

#. y4:line_status=translated
msgctxt "1183"
msgid "Can't decide on one flavor? Get two with a double \nscoop!"
msgstr "¿No puedes decidirte por un solo sabor? Pues\n¡Obtén dos con una doble bola!"

#. y4:line_status=translated
msgctxt "1241"
msgid "Three flavors at once? Someone's feeling \nadventurous."
msgstr "¿Tres sabores a la vez? Alguien se siente\naudaz."

