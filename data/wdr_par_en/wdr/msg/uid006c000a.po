#. y4:msg_location=T9.P0
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "7620_Chihiro"
msgid "So! Would you like to see my special talent?"
msgstr "¿Le gustaría ver mi talento especial?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=1
#. y4:msg_location=T9.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "7632_Tanimura"
msgid "You've got a special talent?"
msgstr "¿Tienes un talento especial?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=2
#. y4:msg_location=T9.P2
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
msgctxt "7644_Chihiro"
msgid "Yes! I've been practicing and perfecting it."
msgstr "¡Sí! Estuve practicando y perfeccionándolo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=3
#. y4:msg_location=T9.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "7656_Tanimura"
msgid "You sound confident. All right, let's see it."
msgstr "Pareces muy confiada. Bueno, muéstramelo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
