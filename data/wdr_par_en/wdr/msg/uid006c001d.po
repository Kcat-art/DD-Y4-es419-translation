#. y4:msg_location=T5.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "6756_Rio"
msgid "Yeah. I haven't played it at all recently..."
msgstr "Sí. Hace bastante que no juego..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=3
#. y4:msg_location=T5.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "6768_Akiyama"
msgid "So you used to play? I have a hard time picturing that."
msgstr "¿Así que solías jugar? Me cuesta imaginarme eso."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=4
#. y4:msg_location=T5.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "6780_Rio"
msgid "I'm pretty good, actually! I bet I could beat your pants off, Akiyama-san!"
msgstr "¡Soy bastante buena, de hecho! ¡Apuesto a que podría partirte el trasero, Akiyama-san!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=5
#. y4:msg_location=T5.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "6792_Akiyama"
msgid "That sounds like a challenge!"
msgstr "Ah, ¿te crees que me asusta eso?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
