#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6864_Akiyama"
msgid "Yeah, bring it on."
msgstr "Sí, adelante."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=12
#. y4:msg_location=T5.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=All right, then. Let's play!
msgctxt "6876_Rio"
msgid "Awesome! I can't wait!"
msgstr "¡Genial! ¡No puedo esperar!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
