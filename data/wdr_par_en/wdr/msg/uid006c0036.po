#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Romance movies.
msgctxt "11004_Kiryu"
msgid "Uh, never mind."
msgstr "Eh, olvídalo."

msgctxt "11016_松岡里緒奈：源氏名"
msgid "Huh... You're kinda scary looking at first glance, but you have a sensitive side, too. <Color:7>♥<Color:Default>"
msgstr "Eh... Eres un poco aterrador a primera vista, pero también tienes un lado sensible. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=28
#. y4:msg_location=T18.P28
