#. y4:msg_location=T2.P2
#. y4:msg_speaker=Man
#. y4:msg_speaker_id=5
msgctxt "356_Man"
msgid "Long time no see!"
msgstr "¡Cuánto tiempo sin verle!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "368_Kiryu"
msgid "(Hey, isn't this the Florist's son?)"
msgstr "(Oye, ¿no es el hijo del Florista?)"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=4
#. y4:msg_location=T2.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "380_Kiryu"
msgid "You're Takashi, right?"
msgstr "¿Eres Takashi, verdad?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=5
#. y4:msg_location=T2.P5
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "392_Takashi"
msgid "That's me!"
msgstr "¡Así es!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=6
#. y4:msg_location=T2.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "404_Kiryu"
msgid "Hey, good to see you."
msgstr "Ey, qué gusto verte."

#. y4:line_status=translated
msgctxt "416_Kiryu"
msgid "What are you doing hanging around here? Don't tell me you\\r\nand your girlfriend got in another fight?"
msgstr "¿Qué haces por aquí? No me digas que tú\\r \ny tu novia tuvieron otra pelea."

#. y4:line_status=translated
msgctxt "428_Takashi"
msgid "No chance. Kyoka and I are sailing smooth. Not a cloud in\\r\nthe sky."
msgstr "Para nada. Kyoka y yo estamos mejor que nunca, todo va\\r \nsobre ruedas."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=9
#. y4:msg_location=T2.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "440_Kiryu"
msgid "Heh, glad to hear it."
msgstr "Je, me alegro mucho."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=10
#. y4:msg_location=T2.P10
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "452_Takashi"
msgid "There <Italic>is</Italic> something I wanted to ask you, though."
msgstr "Aunque sí hay <Italic>algo</Italic> que quería preguntarle."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=11
#. y4:msg_location=T2.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "464_Kiryu"
msgid "What's that?"
msgstr "¿Purgatorio?"

#. y4:line_status=translated
msgctxt "476_Takashi"
msgid "You know that time you helped me out a couple of years ago?\\r\nWe went to that information dealer in the Millennium Tower,\\r\nremember?"
msgstr "¿Recuerda cuando me ayudó hace un par de años?\\r \nFuimos a ver a aquel informante en la Torre Millennium,\\r \n¿se acuerda?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=13
#. y4:msg_location=T2.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "488_Kiryu"
msgid "In the Millennium Tower?"
msgstr "¿En la Torre Millennium?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=14
#. y4:msg_location=T2.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "500_Kiryu"
msgid "(Now that I think about it, the Florist <Italic>was</Italic> shacked up in there for a little while.)"
msgstr "(Pensándolo bien, el Florista <Italic>estuvo</Italic> allí un tiempo.)"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=15
#. y4:msg_location=T2.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "512_Kiryu"
msgid "Oh, right. You must be talking about the Florist of Sai."
msgstr "Ah, cierto. Debes estar hablando del Florista de Sai."

#. y4:line_status=translated
msgctxt "524_Takashi"
msgid "That's the one! You wouldn't happen to know where I could\\r\nfind him again, would you?"
msgstr "¡Ese mismo! No sabrá dónde podría\\r\nencontrarlo de nuevo, ¿verdad?"

#. y4:line_status=translated
msgctxt "536_Takashi"
msgid "I tried going back to that same room in the Millennium\\r\nTower, but it had been turned into some kinda yakuza office! I could barely believe my eyes!"
msgstr "Intenté volver a esa misma sala en la Torre\\r \nMillennium, ¡pero la convirtieron en una especie de oficina yakuza! ¡Casi no podía creerlo!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=2
#. y4:msg_phrase=18
#. y4:msg_location=T2.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "548_Kiryu"
msgid "What do you need the Florist for?"
msgstr "¿Y para qué necesitas al Florista?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
