#. y4:msg_branch_target_text=Your personality can't change that quickly.
#. y4:msg_branch_raw=01 11 00 10 00 00 00 2b 00 00 00 00 00 00 00 00
msgctxt "15912_Akiyama"
msgid "Your personality can't change that quickly."
msgstr "Tu personalidad no puede cambiar tan rápido."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
