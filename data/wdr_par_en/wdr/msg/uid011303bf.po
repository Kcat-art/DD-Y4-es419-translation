#. y4:msg_branch_target_text=Are ya serious? I never do it. Ain't it creepy for a guy like me to be checkin' himself out?
#. y4:msg_branch_raw=01 11 00 2b 00 00 00 10 00 00 00 00 00 00 00 00
msgctxt "3060_Saejima"
msgid "I don't do that."
msgstr ""

