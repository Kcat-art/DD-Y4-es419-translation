#. y4:msg_branch_raw=01 11 00 11 00 00 00 16 00 00 00 00 00 00 00 00
msgctxt "5112_Tanimura"
msgid "A strong-willed woman."
msgstr "Una mujer de carácter fuerte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
