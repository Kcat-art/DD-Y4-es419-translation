#. y4:msg_decision_choices=1. Recommend cocktails. -> T0.P141 | 2. Recommend oolong tea. -> T0.P144
msgctxt "1988_Tanimura"
msgid "Okay then, what'll it be?"
msgstr "Está bien, ¿qué va a ser?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=141
#. y4:msg_location=T0.P141
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "2000_Tanimura"
msgid "How about yuzu honey sours?"
msgstr "¿Qué tal los cocteles de yuzu con miel ácidos?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=142
#. y4:msg_location=T0.P142
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "2012_Yusuke"
msgid "Oh, yeah. That sounds good. Hey, Akino, I hope you like yuzu honey sours."
msgstr "Oh, sí. Eso suena bien. Oye, Akino, espero que te gusten los cocteles de yuzu con miel ácidos."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=143
#. y4:msg_location=T0.P143
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "2024_Akino"
msgid "That's exactly what I was thinking! How did you know? You're awesome, Yusuke."
msgstr "¡Eso era exactamente lo que pensaba! ¿Cómo lo supiste? Eres genial, Yusuke."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=144
#. y4:msg_location=T0.P144
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "2036_Tanimura"
msgid "Maybe we've had enough alcohol. How about we switch over to something else? Like oolong tea?"
msgstr "Tal vez ya hemos tenido suficiente alcohol. ¿Qué tal si cambiamos a otra cosa? ¿Como té oolong?"

#. y4:line_status=translated
msgctxt "2048_Yusuke"
msgid "Oh... All right. That seems like a pretty safe bet.\\r\nAkino, how about we order oolong tea next?"
msgstr "Oh... Está bien. Eso parece una apuesta bastante segura. Akino,\\r\n¿qué tal si después pedimos té oolong?"

#. y4:line_status=translated
msgctxt "2060_Akino"
msgid "What!? Are you trying to be my dad or something?\\r\nI'm not done drinking yet!"
msgstr "¡¿Qué?! ¿Estás tratando de ser mi papá o algo así?\\r\n¡Aún no he terminado de beber!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
