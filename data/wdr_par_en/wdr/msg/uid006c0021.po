#. y4:msg_branch_raw=01 11 00 23 00 00 00 2e 00 00 00 00 00 00 00 00
msgctxt "5004_Akiyama"
msgid "Is this something you tell all your customers?"
msgstr "¿Le dices eso a todos tus clientes?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
