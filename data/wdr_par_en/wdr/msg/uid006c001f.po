#. y4:msg_branch_segment=T28.P20..P26
#. y4:msg_branch_target_text=I guess you did it again.
#. y4:msg_branch_raw=01 11 00 14 00 00 00 19 00 00 00 00 00 00 00 00
msgctxt "14208_Akiyama"
msgid "I guess you did it again."
msgstr "Supongo que lo hiciste de nuevo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=21
#. y4:msg_location=T28.P21
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess you did it again.
msgctxt "14220_Noa"
msgid "What's that supposed to mean!?"
msgstr "¿¡Qué se supone que significa eso!?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=22
#. y4:msg_location=T28.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess you did it again.
msgctxt "14232_Akiyama"
msgid "There seems to be something about you that causes men to lose their minds."
msgstr "Parece que hay algo en ti que hace que los hombres pierdan la cabeza."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=23
#. y4:msg_location=T28.P23
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess you did it again.
msgctxt "14244_Noa"
msgid "But I'm not doing anything to encourage them!"
msgstr "¡Pero no estoy haciendo nada para provocarlos!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=24
#. y4:msg_location=T28.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess you did it again.
msgctxt "14256_Akiyama"
msgid "Maybe you should change your image. You could try a more feminine look."
msgstr "Quizá deberías cambiar de imagen. Podrías probar con un look más femenino."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=25
#. y4:msg_location=T28.P25
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I guess you did it again.
msgctxt "14268_Noa"
msgid "Wait, so I'm not feminine enough for you?"
msgstr "Espera, así que no soy lo suficientemente feminina para usted?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
