#. y4:msg_branch_raw=01 11 00 08 00 00 00 25 00 00 00 00 00 00 00 00
msgctxt "5184_Akiyama"
msgid "I guess you can be cute when you try."
msgstr "Supongo que puedes ser linda si lo intentas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
