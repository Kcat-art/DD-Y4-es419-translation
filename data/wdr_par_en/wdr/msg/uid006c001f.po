#. y4:msg_speaker_id=2
msgctxt "4140_Akiyama"
msgid "Aura?"
msgstr "¿Aura?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. It's probably because I enjoy my work. -> T0.P7 | 2. Do you like hardworking men? -> T0.P16 | 3. You're just saying that. -> T0.P22
msgctxt "4152_Noa"
msgid "There's just something about you that seems different. I can't put my finger on it..."
msgstr "Tiene algo que lo rodea que se siente completamente diferente a las demás personas."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
