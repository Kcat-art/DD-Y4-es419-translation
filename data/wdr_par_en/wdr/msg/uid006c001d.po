#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Hot springs are nice, aren't they?
msgctxt "7680_Akiyama"
msgid "Heh. At this point, you might as well go to all of the hot springs in Izu."
msgstr "Je. Con lo que llevas, ya podrías bañarte en todas las aguas termales de Izu."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=31
