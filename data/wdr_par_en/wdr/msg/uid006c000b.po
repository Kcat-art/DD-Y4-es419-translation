#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4020_Himeka"
msgid "Y'know, before I started workin' here, I had a normal office job."
msgstr "¿Sabes? Antes de empezar a trabajar aquí, tenía un trabajo de oficina cualquiera."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4032_Tanimura"
msgid "Really? That's a surprise."
msgstr "¿De verdad? Qué sorpresa."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4044_Himeka"
msgid "Ain't it? I mean, me in an office? But it was alright even if it was borin'."
msgstr "¡¿Verdad que sí?! O sea, ¿yo en una oficina? Aunque era medio aburrido, no estuvo tan mal."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4056_Himeka"
msgid "I got up at the same time every morning and went to work, then went out with my friends at night."
msgstr "Todos los días era lo mismo: me levantaba temprano, iba a trabajar y por la noche salía con mis amigas."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4068_Tanimura"
msgid "Sounds like a pretty normal lifestyle."
msgstr "Suena como una vida de lo más normal."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4080_Himeka"
msgid "Yeah, but honestly? I was attracted to the glitter and excitement of hostess clubs ever since I was a tiny thing."
msgstr "Pues sí, siendo sincera... desde niña me encantaba todo ese glamur y emoción de los clubes de hostess."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4092_Himeka"
msgid "I kept imaginin' how fun it'd be to wear a pretty dress and have folks fussin' over me."
msgstr "Me la pasaba soñando con lo genial que sería ponerme un vestido lindo y que todos se volvieran locos por mí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4104_Himeka"
msgid "So I finally decided, \"Y'know what? Life's too short to worry 'bout the details.\" That's when I started workin' here."
msgstr "Así que al final pensé: \"¿Sabes qué? La vida es demasiado corta para andar pensando tanto en todo\". Y así fue como terminé trabajando aquí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
msgctxt "4116_Tanimura"
msgid "Was the cabaret life everything you'd dreamed it was?"
msgstr "¿Cumplió el cabaret con todas esas expectativas que tenías?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
msgctxt "4128_Himeka"
msgid "Tons more fun than bein' a corporate drone! I'm so glad I got out of the rat race. Here, I get to talk to all sorts o' people all while drinkin'!"
msgstr "¡Esto es mil veces más divertido que ser una esclava de oficina! Estoy tan feliz de haber salido de esa rutina. ¡Aquí puedo hablar con todo tipo de gente mientras bebo!"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Sounds like you were born to be a hostess. -> T0.P11 | 2. You might've even made it as a pop star. -> T0.P19 | 3. Do you ever think about doing something else? -> T0.P26
msgctxt "4140_Himeka"
msgid "Everyone here is real nice. I was even the top-earnin' hostess one month!"
msgstr "Todos aquí son súper amables. ¡Hasta fui la hostess que más ganó en un mes!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=121
#. y4:msg_phrase=0
#. y4:msg_location=T121.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T0.P11
#. y4:msg_branch_segment=T0.P11..P18
#. y4:msg_branch_target_text=Sounds like you were born to be a hostess.
#. y4:msg_branch_raw=01 11 00 0b 00 00 00 2a 00 00 00 00 00 00 00 00
msgctxt "4152_Tanimura"
msgid "Sounds like you were born to be a hostess."
msgstr "Da la impresión de que ser hostess siempre fue tu destino."

msgctxt "4164_Himeka"
msgid "I really think so! ♪ I'm so happy I jumped ship at my old place and dove head first into the hostess life."
msgstr "¡Totalmente! ♪ No me arrepiento para nada de haber dejado mi antiguo empleo y meterme de lleno en esto de ser hostess."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sounds like you were born to be a hostess.
msgctxt "4176_Tanimura"
msgid "Sounds like even the bad times don't get you down, huh? That's a great attitude to have."
msgstr "Da la impresión de que ni en los peores días te vienes abajo, ¿eh? Eso dice mucho de ti."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sounds like you were born to be a hostess.
msgctxt "4188_Himeka"
msgid "That's a real kind thing to say. Thanks!"
msgstr "Eso fue muy tierno de tu parte. ¡Gracias!"

msgctxt "4200_Himeka"
msgid "Hey, Tanimura-san, if there's anything I can ever do for ya, just let me know. <Color:7>♥<Color:Default>"
msgstr "Tanimura-san, si alguna vez puedo hacer algo por ti, solo házmelo saber, ¿vale? <Color:7>♥<Color:Default>"

msgctxt "4212_Himeka"
msgid "I may not look it, but I am a professional when it comes to servin' customers. ♪"
msgstr "Puede que no lo parezca, pero soy toda una profesional cuando se trata de atender clientes. ♪"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sounds like you were born to be a hostess.
msgctxt "4224_Tanimura"
msgid "Just talking with you is enough for me."
msgstr "Hablar contigo es más que suficiente, de verdad."

msgctxt "4236_Himeka"
msgid "Hehehe. Tanimura-san, you don't look it, but yer quite the gentleman. <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You might've even made it as a pop star.
msgctxt "4248_Tanimura"
msgid "You're cute, and you've got personality. I bet you could make it as a pop star."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You might've even made it as a pop star.
msgctxt "4260_Himeka"
msgid "Aww, come off it! I'm flattered ya think so much of me, Tanimura-san, but it'd never happen."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You might've even made it as a pop star.
msgctxt "4272_Tanimura"
msgid "You don't think so? Well, I think you'd be pretty popular."
msgstr ""

msgctxt "4284_Himeka"
msgid "Naw, I wouldn't... but it's sweet of you to say. <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Himeka
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You might've even made it as a pop star.
msgctxt "4296_Himeka"
msgid "Oh, I know! Maybe I can be your own private pop star! How about it? You'd be my fan, wouldn't ya?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You might've even made it as a pop star.
msgctxt "4308_Tanimura"
msgid "Of course."
msgstr "No se preocupe."

msgctxt "4320_Himeka"
msgid "Hehe! Then that makes you the first member of the official Himeka Fan Club! <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
