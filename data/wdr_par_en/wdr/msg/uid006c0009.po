#. y4:msg_branch_segment=T5.P4..P9
#. y4:msg_branch_target_text=They have medicine for that, you know. You can take it before you drink.
#. y4:msg_branch_raw=01 11 00 04 00 00 00 26 00 00 00 00 00 00 00 00
msgctxt "17688_Kiryu"
msgid "They have medicine for that, you know."
msgstr "Existen medicamentos para eso, ya sabes."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=137
#. y4:msg_phrase=0
#. y4:msg_location=T137.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T5.P10
#. y4:msg_branch_segment=T5.P10..P15
#. y4:msg_branch_target_text=Some people just can't drink. Your body just doesn't break down alcohol as well as other people.
#. y4:msg_branch_raw=01 11 00 0a 00 00 00 1d 00 00 00 00 00 00 00 00
msgctxt "17700_Kiryu"
msgid "Some people just can't drink."
msgstr "Algunas personas simplemente no pueden beber."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=138
#. y4:msg_phrase=0
#. y4:msg_location=T138.P0
