#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It's probably because I enjoy my work.
msgctxt "4176_Noa"
msgid "You do? What kind of work is it?"
msgstr "¿Lo hace? ¿Qué clase de trabajo es?"

