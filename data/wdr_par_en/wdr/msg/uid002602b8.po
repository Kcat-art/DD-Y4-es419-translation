#. y4:msg_talk=2
#. y4:msg_phrase=9
#. y4:msg_location=T2.P9
#. y4:msg_speaker=Striped Kitten
#. y4:msg_speaker_id=2
msgctxt "656_White Kitten"
msgid "Mew!"
msgstr "¡Miau!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=35
#. y4:msg_location=T2.P35
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=0
msgctxt "668_Saejima"
msgid "(Welp. Maybe I'll check it out when the mood strikes.)"
msgstr "(Bueno. quizás lo revise cuando tenga ganas.)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=37
#. y4:msg_location=T2.P37
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=6
msgctxt "692_Cat-loving Homeless Man"
msgid "Okay, fellas, you wanna play?"
msgstr "Bien, chicos, ¿quieren jugar?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=38
#. y4:msg_location=T2.P38
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=6
msgctxt "704_Cat-loving Homeless Man"
msgid "Hey, look!"
msgstr "¡Oigan, miren!"

#. y4:line_status=translated
msgctxt "716_Saejima"
msgid "They seem to like ya just fine now. I can't take 'em.\\r\nSo you treat 'em good, alright?"
msgstr "Parece que ya les caen bien. No me los puedo llevar.\\r\nAsí que trátenlos bien, ¿de acuerdo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=41
#. y4:msg_location=T2.P41
#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=6
msgctxt "740_Cat-loving Homeless Man"
msgid "You bet!"
msgstr "¡Daré lo mejor de mí!"

