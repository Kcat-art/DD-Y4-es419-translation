#. y4:msg_branch_segment=T0.P93..P98
#. y4:msg_branch_target_text=You're better off without a girlfriend. You don't want to be led astray by immaterial things like love. It could lower your efficiency.
#. y4:msg_branch_raw=01 11 00 5d 00 00 00 17 00 00 00 00 00 00 00 00
msgctxt "2976_Saejima"
msgid "Not Having a Girlfriend"
msgstr ""

#. y4:msg_type=choice
