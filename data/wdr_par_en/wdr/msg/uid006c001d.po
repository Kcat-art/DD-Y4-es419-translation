#. y4:msg_location=T19.P1
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "13860_Rio"
msgid "The pin-up model job?"
msgstr "¿El trabajo de modelo de calendario?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=So what do you think now that you're doing it?
msgctxt "13872_Akiyama"
msgid "Yeah."
msgstr "Sí."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=26
#. y4:msg_section_label=Conversación 26
#. y4:msg_talk=26
