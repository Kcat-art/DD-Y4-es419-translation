#. y4:msg_choice_index=1
#. y4:msg_branch_choice=There's no need to be sad about it.
msgctxt "12372_Erena"
msgid "Thanks for worrying about me."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
