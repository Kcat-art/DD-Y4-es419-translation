msgctxt "132_Kiryu"
msgid "You said you've already tried all the ramen around here, right?"
msgstr "Dijiste que ya probaste todo el ramen de por aquí, ¿verdad?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
