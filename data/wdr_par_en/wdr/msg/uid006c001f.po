#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You really like cars, don't you?
msgctxt "8904_Noa"
msgid "That's right! It's manual or nothing for me!"
msgstr "¡Así es! ¡Es manual o nada para mí!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=20
