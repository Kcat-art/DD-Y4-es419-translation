#. y4:msg_location=T8.P0
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "6852_Maya"
msgid "Uh-oh."
msgstr "Oh-ou."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "6864_Kiryu"
msgid "What's wrong?"
msgstr "¿Qué ocurre?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=2
#. y4:msg_location=T8.P2
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "6876_Maya"
msgid "My friend sent me the funniest picture yesterday. I wanted to show it to you, but I think I deleted it."
msgstr "Mi amiga me envió una foto muy divertida ayer. Quería mostrártela, pero creo que la borre."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=3
#. y4:msg_location=T8.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "6888_Kiryu"
msgid "What kind of picture was it?"
msgstr "¿Qué clase de foto era esa?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=4
#. y4:msg_location=T8.P4
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "6900_Maya"
msgid "I was standing on top of a bar with a backpack or something on my back."
msgstr "Estaba encima de una barra con una mochila o algo así a la espalda."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=5
#. y4:msg_location=T8.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "6912_Kiryu"
msgid "Heh. Were you drunk?"
msgstr "Je. ¿Estabas ebria?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=6
#. y4:msg_location=T8.P6
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "6924_Maya"
msgid "I think so. I don't remember it at all."
msgstr "Eso creo. No recuerdo nada."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=7
#. y4:msg_location=T8.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "6936_Kiryu"
msgid "I thought you didn't drink much."
msgstr "Pensaba que no bebías mucho."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=8
#. y4:msg_location=T8.P8
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=8
#. y4:msg_decision_choices=1. See if she can send it to you again. -> T8.P9 | 2. You used to get drunk a lot? -> T8.P16 | 3. A backpack? -> T8.P22
msgctxt "6948_Maya"
msgid "Oh, it was from last year. I don't know why she just sent it to me now."
msgstr "Oh, era del año pasado. No entiendo por qué me lo acaba de enviar ahora."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=9
#. y4:msg_location=T8.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=See if she can send it to you again.
msgctxt "6960_Kiryu"
msgid "See if she can send it to you again. I'd like to see it for myself."
msgstr "A ver si te lo puede enviar otra vez. Me gustaría verlo por mí mismo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=10
#. y4:msg_location=T8.P10
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=See if she can send it to you again.
msgctxt "6972_Maya"
msgid "Hehe. I'm warning you now, it's pretty funny."
msgstr "Je, je. Te lo advierto ahora, es bastante chistoso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=11
#. y4:msg_location=T8.P11
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=See if she can send it to you again.
msgctxt "6984_Maya"
msgid "The first time I saw it, I thought, \"What the hell is this girl doing!?\""
msgstr "La primera vez que la vi, pensé: \"¿Qué demonios está haciendo esta chica?\"."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=12
#. y4:msg_location=T8.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=See if she can send it to you again.
msgctxt "6996_Kiryu"
msgid "Heh. Now I really have to see it."
msgstr "Je. Ahora sí que tengo que verla."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=13
#. y4:msg_location=T8.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=See if she can send it to you again.
msgctxt "7008_Kiryu"
msgid "Why don't you forward it directly to my phone?"
msgstr "¿Por qué no lo reenvías directamente a mi teléfono?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=14
#. y4:msg_location=T8.P14
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=See if she can send it to you again.
msgctxt "7020_Maya"
msgid "No way! Then you'll keep it forever! I'll show it to you, but just once!"
msgstr "¡Nunca! ¡Entonces te lo quedarás para siempre! ¡Te lo enseñaré, pero solo una vez!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=15
#. y4:msg_location=T8.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=See if she can send it to you again.
msgctxt "7032_Kiryu"
msgid "Heh. Fine."
msgstr "Je. Está bien"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=16
#. y4:msg_location=T8.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You used to get drunk a lot?
msgctxt "7044_Kiryu"
msgid "You used to get drunk a lot? Not many people would climb onto a bar, even if they were drunk."
msgstr "¿Solías beber mucho? No mucha gente se subía a una barra, aunque estuviera borracha."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=17
#. y4:msg_location=T8.P17
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You used to get drunk a lot?
msgctxt "7056_Maya"
msgid "You're probably right. I could've gotten in trouble."
msgstr "Probablemente tengas razón. Podría haberme metido en problemas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=18
#. y4:msg_location=T8.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You used to get drunk a lot?
msgctxt "7068_Kiryu"
msgid "You're lucky you didn't get banned."
msgstr "Tienes suerte de que no te hayan vetado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=19
#. y4:msg_location=T8.P19
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You used to get drunk a lot?
msgctxt "7080_Maya"
msgid "And why was my friend taking that picture? She should've stopped me."
msgstr "¿Y por qué estaba mi amiga sacando esa foto? Ella debería haberme frenado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=20
#. y4:msg_location=T8.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You used to get drunk a lot?
msgctxt "7092_Kiryu"
msgid "Heh. Must be because you're a model and all."
msgstr "Je. Debe ser porque eres modelo y todo eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=21
#. y4:msg_location=T8.P21
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You used to get drunk a lot?
msgctxt "7104_Maya"
msgid "Is that supposed to be a compliment?"
msgstr "¿Eso es un cumplido?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=22
#. y4:msg_location=T8.P22
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=A backpack?
msgctxt "7116_Kiryu"
msgid "A backpack? Were you traveling?"
msgstr "¿Una mochila? ¿Andabas de viaje?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=23
#. y4:msg_location=T8.P23
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=A backpack?
msgctxt "7128_Maya"
msgid "Oh no, it wasn't mine. I think it belonged to somebody else at the bar."
msgstr "Ah, no, eso no era mío. Creo que era de otra persona en el bar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=24
#. y4:msg_location=T8.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=A backpack?
msgctxt "7140_Kiryu"
msgid "But why were you wearing it?"
msgstr "Pero, ¿por qué lo llevabas puesto?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=25
#. y4:msg_location=T8.P25
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=A backpack?
msgctxt "7152_Maya"
msgid "Uh, that's hard to say."
msgstr "Bueno... es complicado de decir."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=26
#. y4:msg_location=T8.P26
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=A backpack?
msgctxt "7164_Maya"
msgid "When I get drunk, I like to wear anything I can get my hands on. Bags, jewelry, other people's clothes..."
msgstr "Cuando me embriago, me gusta ponerme cualquier cosa que caiga en mis manos. Bolsos, joyas, ropa de otras personas..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=27
#. y4:msg_location=T8.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=A backpack?
msgctxt "7176_Kiryu"
msgid "That sounds like a problem."
msgstr "Eso suena a problemas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=28
#. y4:msg_location=T8.P28
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=A backpack?
msgctxt "7188_Kiryu"
msgid "Maybe you could put a lot of clothes on before you get drunk?"
msgstr "¿Podrías ponerte mucha ropa antes de emborracharte?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=29
#. y4:msg_location=T8.P29
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=A backpack?
msgctxt "7200_Maya"
msgid "Haha! That just might work."
msgstr "¡Ja, ja! Eso podría funcionar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=30
#. y4:msg_location=T8.P30
