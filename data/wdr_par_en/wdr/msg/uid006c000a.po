#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=A pure and innocent woman.
msgctxt "5052_Tanimura"
msgid "If I had to choose."
msgstr "Si tuviera que elegir. Sí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=13
#. y4:msg_location=T2.P13
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=A pure and innocent woman.
msgctxt "5064_Chihiro"
msgid "But that sounds like me. I mean, it's odd to say that myself, but..."
msgstr "Pero eso suena a alguien como yo. Es extraño decirlo yo misma, pero..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
