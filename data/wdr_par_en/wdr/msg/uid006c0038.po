#. y4:msg_speaker_id=0
msgctxt "7752_望月京子：源氏名"
msgid "They suck."
msgstr "Son unos malditos."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=10
#. y4:msg_section_label=Conversación 10
