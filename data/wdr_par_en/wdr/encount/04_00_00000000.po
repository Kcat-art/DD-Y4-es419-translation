msgid "Aqua Devils Member"
msgstr "Miembro de Aqua Devils"

#. y4:msg_type=id
#. y4:msg_label=Nombre interno
#. y4:msg_id_index=1
msgctxt "3632"
msgid "Talk_Yes"
msgstr "Talk_Yes"

#. y4:msg_type=id
#. y4:msg_label=Nombre interno
#. y4:msg_id_index=2
msgctxt "3636"
msgid "Talk_Odosu"
msgstr "Talk_Odosu"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "128_Aqua Devils Member"
msgid "Hey, old man! Heard you messed up our boys real good, yeah?"
msgstr "¡Eh, viejo! Oí que les hiciste mucho daño a nuestros chicos, ¿verdad?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "140_Aqua Devils Member"
msgid "Time to show you what happens when you piss on the Kamurocho Aqua Devils!"
msgstr "¡Es hora de mostrarte lo que sucede cuando orinas en los Kamurocho Aqua Devils!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "152_Aqua Devils Member"
msgid "Been looking for you, old man."
msgstr "Te he estado buscando, anciano."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "164_Aqua Devils Member"
msgid "Think you can fuck with us and just walk away? Karma's a bitch!"
msgstr "¿Crees que puedes meterte con nosotros y simplemente irte? ¡El Karma no perdona!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "176_Aqua Devils Member"
msgid "The Kamurocho Aqua Devils never give up and never surrender once we start up a fight."
msgstr "Los Kamurocho Aqua Devils nunca se rinden y nunca se rinden una vez que comenzamos una pelea."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "188_Aqua Devils Member"
msgid "You ain't gonna walk outta here!"
msgstr "¡No vas a salir de aquí!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "224_Aqua Devils Member"
msgid "Dammit..."
msgstr "Maldición..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "236_Aqua Devils Member"
msgid "We're not giving up just yet! You best watch yourself!"
msgstr "¡Aún no nos rendimos! ¡Más te vale tener cuidado!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "248_Aqua Devils Member"
msgid "You're stronger than they say..."
msgstr "Eres más fuerte de lo que dicen..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=4
#. y4:msg_location=T2.P4
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "260_Aqua Devils Member"
msgid "Fuck! We're gonna have to call in Onitake-san for this one..."
msgstr "¡Joder! Vamos a tener que llamar a Onitake-san para esto..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=5
#. y4:msg_location=T2.P5
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "272_Aqua Devils Member"
msgid "Urgh... You're too much."
msgstr "Urgh... Eres muy fuerte."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=6
#. y4:msg_location=T2.P6
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "284_Aqua Devils Member"
msgid "But don't get too full of yourself, gramps. You're finished. History. Apologizing won't fix shit now."
msgstr "Pero no te creas demasiado, abuelo. Ya eres historia. Disculparse no arreglará una mierda ahora."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=7
#. y4:msg_location=T2.P7
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "296_Aqua Devils Member"
msgid "Onitake-san himself's in town. He's staking your ass out over in Kamuro Central Parking Lot. You don't even have a chance."
msgstr "El mismísimo Onitake-san está en la ciudad. Te está persiguiendo\n"
"por todo el estacionamiento central de Kamurocho. No tienes\n"
"ninguna oportunidad."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "332_Aqua Devils Member"
msgid "We're not giving up just yet! You best watch yourself!"
msgstr "¡Aún no nos rendimos! ¡Más te vale tener cuidado!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=2
#. y4:msg_location=T3.P2
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "344_Aqua Devils Member"
msgid "You're stronger than they say... Fuck! We're gonna have to call in Onitake-san for this one..."
msgstr "Eres más fuerte de lo que dicen... ¡Maldición! Vamos a tener que llamar a Onitake-san para esto..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=7
#. y4:msg_location=T2.P7
#. y4:msg_speaker=Aqua Devils Member
#. y4:msg_speaker_id=0
msgctxt "356_Aqua Devils Member"
msgid "Onitake-san himself's in town. He's staking your ass out over in Kamuro Central Parking Lot. You don't even have a chance."
msgstr "El mismísimo Onitake-san está en la ciudad. Te está persiguiendo\n"
"por todo el estacionamiento central de Kamurocho. No tienes\n"
"ninguna oportunidad."
