#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You should try to be more aware of your behavior.
msgctxt "15864_Akiyama"
msgid "Oh."
msgstr "Oh."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
