#. y4:msg_decision_choices=1. That's not good for you. -> T28.P6 | 2. Why don't I buy you something tasty? -> T28.P16 | 3. Why are you dieting? -> T28.P23
msgctxt "14460_松岡里緒奈：源氏名"
msgid "I haven't eaten anything since I woke up..."
msgstr "No he comido nada desde que me desperté..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
