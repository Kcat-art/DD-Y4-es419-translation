#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Don't you gain weight eating like that?
msgctxt "7572_Akiyama"
msgid "But you ate too much this time, right? Maybe you should watch it."
msgstr "Pero esta vez has comido demasiado, ¿verdad? Tal vez deberías tener cuidado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=28
