#. y4:msg_branch_segment=T1.P6..P9
#. y4:msg_branch_target_text=Exactly. Trainin' should always be based on efficiency.
#. y4:msg_branch_raw=01 11 00 06 00 00 00 1d 00 00 00 00 00 00 00 00
msgctxt "2988_Saejima"
msgid "Efficiency is most important."
msgstr ""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=21
#. y4:msg_phrase=0
#. y4:msg_location=T21.P0
