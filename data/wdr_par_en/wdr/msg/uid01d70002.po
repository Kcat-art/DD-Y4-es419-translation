#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "312"
msgid "The dealer wins. The next round begins."
msgstr "El Crupier gana. La siguiente ronda empezará."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "324"
msgid "The dealer won that one."
msgstr "El Crupier ganó esta ronda."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "336"
msgid "It's a tie. The next round begins."
msgstr "Empate. La siguiente ronda empezará."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "348"
msgid "It's a tie. The next round begins."
msgstr "Empate. La siguiente ronda empezará.\n"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "360"
msgid "One of your hands is a draw."
msgstr "Una de tus manos es un empate."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "372"
msgid "The house lost that one. The next round begins."
msgstr "La casa perdió esta ronda. La siguiente ronda empezará."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "384"
msgid "The house lost that one."
msgstr "La casa perdió esta ronda."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "396"
msgid "The house won that one."
msgstr "La casa gano esta ronda.\n"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "408"
msgid "You won."
msgstr "Ganaste."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "420"
msgid "One of your hands won."
msgstr "Una de tus manos gano."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "432"
msgid "Both of your hands won."
msgstr "Ambas manos ganaron."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "444"
msgid "The dealer wins against both of your hands."
msgstr "El Crupier gana contra ambas manos."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "456"
msgid "Both of your hands won. A one of your hands is a Six-Card Under. Impressive!"
msgstr "Ambas manos ganaron. Una de tus manos es un Six-Card Under. ¡Impresionante!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "468"
msgid "Both of your hands won. And both are Six-Card Charlies! You really have the devil's luck."
msgstr "¡Ambas manos ganaron! ¡Y ambas son Six-Card Charlies! ¡Tienes una suerte de otro mundo!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "480"
msgid "One of your hands won. Congratulations on getting a Six Under!"
msgstr "Una de tus manos ganó. ¡Felicidades por conseguir un Six Under!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "492"
msgid "You have a Six Under: six cards totaling under twenty-one. That means you automatically win!"
msgstr "Tienes Six Under con un total inferior a veintiuno. ¡Eso significa que ganas automáticamente!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "504"
msgid "Your insurance bet won. Good move!"
msgstr "Tu apuesta al seguro ganó. ¡Buena jugada!"

