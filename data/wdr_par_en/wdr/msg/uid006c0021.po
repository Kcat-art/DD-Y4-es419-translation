#. y4:msg_choice_index=1
#. y4:msg_branch_choice=There's no need to be sad about it.
msgctxt "12324_Akiyama"
msgid "That's okay. Take your time. I'm not saying you have to start looking for a new love right away."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
