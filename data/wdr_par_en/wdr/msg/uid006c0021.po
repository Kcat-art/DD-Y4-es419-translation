#. y4:msg_branch_target_text=What's your favorite place in Tokyo?
#. y4:msg_branch_raw=01 11 00 0b 00 00 00 24 00 00 00 00 00 00 00 00
msgctxt "4212_Akiyama"
msgid "What's your favorite place in Tokyo?"
msgstr "¿Cuál es el lugar que más te gusta de Tokio?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's your favorite place in Tokyo?
msgctxt "4224_Erena"
msgid "Well, actually I haven't been able to get around much. Do ya know any fun places to go?"
msgstr "Bueno, no he tenido la oportunidad de conocer bien el lugar. ¿Me podrías recomendar algún lugar para divertirme?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's your favorite place in Tokyo?
msgctxt "4236_Akiyama"
msgid "Hm? Well, sure... But everybody has different tastes."
msgstr "¿Eh? Claro, sí... Pero supongo que para gustos, colores."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's your favorite place in Tokyo?
msgctxt "4248_Akiyama"
msgid "What kind of things do you like? Maybe I can show you around a little bit."
msgstr "¿Qué tipo de lugares te gustan? Tal vez así pueda llevarte a conocer algunos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's your favorite place in Tokyo?
msgctxt "4260_Erena"
msgid "Really? That'd be great."
msgstr "¿De verdad? Estaría divertido."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's your favorite place in Tokyo?
msgctxt "4272_Akiyama"
msgid "Do you want to go sightseeing? Or maybe out eating, or shopping?"
msgstr "¿Pero quieres ir a conocer lugares? ¿O tal vez salir a comer o ir de compras?"

msgctxt "4284_Erena"
msgid "Well, maybe some sightseein' first, then a nice\\r\n"
"drink afterwards."
msgstr "Bueno, conocer un poco, y después tomar algo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's your favorite place in Tokyo?
msgctxt "4296_Akiyama"
msgid "If we can find the time, that'd be nice."
msgstr "Si consigo tiempo libre, por supuesto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What's your favorite place in Tokyo?
msgctxt "4308_Erena"
msgid "Yeah, I'll be looking forward to it."
msgstr "Sí. Estaré esperando con ansias."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=122
