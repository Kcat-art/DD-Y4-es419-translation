#. y4:msg_branch_target_text=I always throw away the cone.
#. y4:msg_branch_raw=01 11 00 25 00 00 00 1d 00 00 00 00 00 00 00 00
msgctxt "13740_Akiyama"
msgid "I always throw away the cone."
msgstr "Siempre tiro el cucurucho."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=38
#. y4:msg_location=T18.P38
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I always throw away the cone.
msgctxt "13752_Rio"
msgid "What!? Why?"
msgstr "¡¿Qué?! ¡¿Por qué?!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=39
#. y4:msg_location=T18.P39
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I always throw away the cone.
msgctxt "13764_Akiyama"
msgid "It doesn't really have any flavor. Once the ice cream's gone, I toss it."
msgstr "Realmente no tiene ningún sabor. Una vez que se acaba el helado, lo tiro."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=40
#. y4:msg_location=T18.P40
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I always throw away the cone.
msgctxt "13776_Rio"
msgid "No! The whole point is to eat the ice cream with the cone! They go great together! You're missing the perfect harmony of cream and cone!"
msgstr "¡No! ¡La gracia está en comer el helado con el cucurucho! ¡Van perfecto juntos! ¡Te estás perdiendo la armonía ideal entre la crema y el cucurucho!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=41
#. y4:msg_location=T18.P41
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I always throw away the cone.
msgctxt "13788_Akiyama"
msgid "Harmony?"
msgstr "¿Armonía?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=42
#. y4:msg_location=T18.P42
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I always throw away the cone.
msgctxt "13800_Rio"
msgid "Men just don't get this kind of thing, do they? You cook all day for them, and they always just say, \"yeah, it's fine, whatever\"!"
msgstr "Los hombres no entienden estas cosas, ¿verdad? Una cocina para ellos todo el día, y siempre dicen: ¡“Sí, está bien, lo que sea”!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=43
#. y4:msg_location=T18.P43
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I always throw away the cone.
msgctxt "13812_Akiyama"
msgid "That's not always the case."
msgstr "No siempre es así."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=44
#. y4:msg_location=T18.P44
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I always throw away the cone.
msgctxt "13824_Rio"
msgid "I'm so hurt."
msgstr "Estoy tan herida."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=45
#. y4:msg_location=T18.P45
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I always throw away the cone.
msgctxt "13836_Akiyama"
msgid "It's just an ice cream cone!"
msgstr "¡Es solo un cucurucho de helado!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=0
#. y4:msg_location=T19.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "13848_Akiyama"
msgid "You're still wondering what to do about that job, aren't you?"
msgstr "Aún te estás preguntando qué hacer con ese trabajo, ¿verdad?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
