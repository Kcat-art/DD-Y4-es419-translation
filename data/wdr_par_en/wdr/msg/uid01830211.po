#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker="Akiyama"
#. y4:msg_speaker_id=0
msgctxt "80_\"Akiyama\""
msgid "Should be around here somewhere..."
msgstr "Debería estar por aquí en alguna parte..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Mysterious Woman
#. y4:msg_speaker_id=1
msgctxt "92_Mysterious Woman"
msgid "You the courier?"
msgstr "¿Tú eres el repartidor?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "128_Akiyama"
msgid "(No way!)"
msgstr "(¡No me jodas!)"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker="Akiyama"
#. y4:msg_speaker_id=0
msgctxt "140_\"Akiyama\""
msgid "Yep! That's me!"
msgstr "Sí. ¡Ese soy yo!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Mysterious Woman
#. y4:msg_speaker_id=1
msgctxt "152_Mysterious Woman"
msgid "Here are the goods, as discussed. You know the way there?"
msgstr "Aquí tengo la mercancía, tal como lo discutimos. ¿Sabes cómo llegar?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker="Akiyama"
#. y4:msg_speaker_id=0
msgctxt "164_\"Akiyama\""
msgid "Yeah, yeah. Like the back of my hand."
msgstr "Sí, obvio. Conozco el lugar como la palma de mi mano."

#. y4:line_status=translated
msgctxt "176_Mysterious Woman"
msgid "If you let anything happen to this... you know what will\\r\nhappen to you."
msgstr "Si le pasa algo a esto... ya conoces\\r\nlas consecuencias."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker="Akiyama"
#. y4:msg_speaker_id=0
msgctxt "188_\"Akiyama\""
msgid "You can count on me."
msgstr "Puedes confiar en mí."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Mysterious Woman
#. y4:msg_speaker_id=1
msgctxt "200_Mysterious Woman"
msgid "Just don't make any mistakes."
msgstr "No la cagues."

#. y4:line_status=translated
msgctxt "272_\"Akiyama\""
msgid "Phew... Pretty aggressive for a woman... I guess that's just\\r\nhow it goes in the underworld."
msgstr "Fiu... Bastante agresiva para ser una mujer... supongo que así\\r\nes como funciona este mundo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "284_Akiyama"
msgid "Yeah, who knew?"
msgstr "Así es, ¿Quién lo hubiera dicho?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker="Akiyama"
#. y4:msg_speaker_id=0
msgctxt "296_\"Akiyama\""
msgid "Okay, let's be on our way, then, shall we?"
msgstr "Bueno, entonces, ¿nos vamos?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "308_Akiyama"
msgid "Do you want me to carry the case?"
msgstr "¿Quieres que te lleve el maletín?"

#. y4:line_status=translated
msgctxt "320_\"Akiyama\""
msgid "No, no. You haven't earned my trust yet... I can't risk\\r\nanything happening to it. I'll carry it."
msgstr "No, no. Aún no tienes mi confianza... No puedo arriesgarme a\\r\nque algo le pase. Mejor lo llevo yo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "332_Akiyama"
msgid "But aren't you supposed to be testing me?"
msgstr "¿Pero no se supone que esto era una prueba?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker="Akiyama"
#. y4:msg_speaker_id=0
msgctxt "344_\"Akiyama\""
msgid "Never mind that! Let's go already!"
msgstr "¡No importa! ¡Ya vámonos!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "356_Akiyama"
msgid "Okay, okay..."
msgstr "Vale, vale..."
