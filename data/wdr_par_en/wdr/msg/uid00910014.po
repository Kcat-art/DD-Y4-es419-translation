msgid "[Of course!]"
msgstr "[¡Claro!]"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=5
#. y4:msg_phrase=5
#. y4:msg_location=T5.P5
#. y4:msg_speaker=Investigation Report 1
#. y4:msg_speaker_id=7
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Check Investigation
msgctxt "992_Investigation Report 1"
msgid "The criminal is a Southeast Asian male in Japan. Nair and her colleagues have permission to investigate, but no authority to make arrests."
msgstr "El criminal es un hombre del sudeste asiático actualmente\nubicado en Japón. Nair y sus compañeros tienen permiso para\ninvestigar, pero sin autoridad de realizar arrestos."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=5
#. y4:msg_phrase=6
#. y4:msg_location=T5.P6
#. y4:msg_speaker=Investigation Report 2
#. y4:msg_speaker_id=8
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Check Investigation
msgctxt "1004_Investigation Report 2"
msgid "The criminal's codename is \"GG.\" GG murdered Nair's parents and brother before making off with their money. A witness identified someone resembling GG at a Kamurocho club popular among foreigners. An interpreter was also secured."
msgstr "Nombre en clave del criminal \"GG\". GG asesino al hermano y los\npadres de Nair, antes de huir con su dinero. Un testigo\nidentifico a alguien con cierta semejanza en un club popular\nen Kamurocho. También consiguió un intérprete."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=5
#. y4:msg_phrase=7
#. y4:msg_location=T5.P7
#. y4:msg_speaker=Investigation Report 3
#. y4:msg_speaker_id=9
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Check Investigation
msgctxt "1016_Investigation Report 3"
msgid "Someone claiming to be named GG entered the club and avoided contact with other customers, to the point of suspicion. Possible rendezvous attempt. Must investigate the reason behind this."
msgstr "Alguien que alega llamarse GG entro al club y evito contacto con\notros clientes, hasta el punto de levantar sospechas. Posible\npunto de encuentro. Se debe investigar el motivo de esto."

#. y4:line_status=translated
msgctxt "1028_Investigation Report 4"
msgid "Investigation report by Tanimura.\\r\n\\r\nA well-known and feared assassin was spotted in Kamurocho. Possibility that GG is accompanied by members of his organization."
msgstr "Informe de investigación de Tanimura.\\r\n\\r\nSe avistó a un conocido asesino en Kamurocho. Hay posibilidad de que GG esté acompañado por miembros de su organización."

#. y4:line_status=translated
