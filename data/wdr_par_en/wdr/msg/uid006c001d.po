#. y4:msg_branch_choice=I could never do that. I'm not very observant.
msgctxt "9144_Rio"
msgid "Aww... Never? That's a strong word to use."
msgstr "Aw... ¿Nunca? Esa es una palabra muy fuerte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=24
#. y4:msg_location=T9.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I could never do that. I'm not very observant.
msgctxt "9156_Akiyama"
msgid "Hmm. Sorry..."
msgstr "Mmm. Lo siento..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
