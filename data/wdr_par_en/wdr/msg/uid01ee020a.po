msgid "Go to the rooftop?"
msgstr "¿Ir a la azotea?"

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
msgctxt "1408"
msgid "Akiyama"
msgstr "Akiyama"

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
