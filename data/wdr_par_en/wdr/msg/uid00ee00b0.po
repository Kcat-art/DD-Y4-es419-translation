#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Go In Anyway -> T1.P5 | 2. Forget It -> T1.P7
msgctxt "340_Kiryu"
msgid "(Shoot, I forgot Haruka was with me! What now!?)"
msgstr "(¡Diablos, olvidé que Haruka estaba conmigo! ¿Y ahora qué hago!?)"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
