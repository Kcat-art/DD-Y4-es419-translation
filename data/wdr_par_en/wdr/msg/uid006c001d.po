#. y4:msg_location=T26.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=26
#. y4:msg_decision_choices=1. How long did you run away for? -> T26.P18 | 2. I can understand how you must've felt. -> T26.P32 | 3. Your mom must've been worried about you. -> T26.P42
msgctxt "13884_Rio"
msgid "Yeah..."
msgstr "Sí..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=4
#. y4:msg_location=T19.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "13896_Rio"
msgid "I think it's amazing that some girls can get naked in front of strangers, but I'm not sure if I can."
msgstr "Me parece increíble que algunas chicas puedan desnudarse delante de desconocidos, pero no estoy segura de si yo puedo hacerlo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=5
#. y4:msg_location=T19.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "13908_Akiyama"
msgid "Yeah, it's not easy."
msgstr "Sí, no es algo fácil."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=6
#. y4:msg_location=T19.P6
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "13920_Rio"
msgid "I worry about what other people might think, too..."
msgstr "También me preocupa lo que las personas puedan pensar..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=7
#. y4:msg_location=T19.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "13932_Akiyama"
msgid "You know what I think?"
msgstr "¿Sabes lo que creo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=25
#. y4:msg_location=T28.P25
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Is this a trap?
msgctxt "13944_Rio"
msgid "What?"
msgstr "¿Qué?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=9
#. y4:msg_location=T19.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "13956_Akiyama"
msgid "The fact you're spending so much time debating this means that part of you wants to do it."
msgstr "Que el hecho de que dediques tanto tiempo a debatirlo significa que una parte de ti quiere hacerlo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=10
#. y4:msg_location=T19.P10
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "13968_Rio"
msgid "That's possible."
msgstr "Es posible."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=11
#. y4:msg_location=T19.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "13980_Akiyama"
msgid "What about it interests you?"
msgstr "¿Qué es lo que te atrae de esa idea?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=12
#. y4:msg_location=T19.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "13992_Rio"
msgid "Mm... I don't quite know how to explain it."
msgstr "Mmm... No sé muy bien cómo explicarlo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=13
#. y4:msg_location=T19.P13
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "14004_Rio"
msgid "I think I'd feel like I really achieved something if I could go through with it."
msgstr "Creo que si pudiera hacerlo, sentiría que realmente logré algo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=14
#. y4:msg_location=T19.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "14016_Akiyama"
msgid "So you'd feel accomplished?"
msgstr "¿Te sentirías realizada?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=15
#. y4:msg_location=T19.P15
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "14028_Rio"
msgid "Yes! That's it."
msgstr "¡Sí! Es eso."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=16
#. y4:msg_location=T19.P16
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "14040_Rio"
msgid "I don't feel the same sense of accomplishment in my work here that I used to."
msgstr "No siento la misma sensación de satisfacción en mi trabajo aquí que solía sentir antes."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=17
#. y4:msg_location=T19.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "14052_Rio"
msgid "And there's something freeing about being able to stand naked and pose in front of everybody."
msgstr "Y hay algo liberador en poder estar desnuda y posar frente a todos sin miedo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=9
#. y4:msg_section_label=Conversación 9
#. y4:msg_talk=9
#. y4:msg_phrase=7
#. y4:msg_location=T9.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "14064_Akiyama"
msgid "I get it now."
msgstr "Ya entiendo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=19
#. y4:msg_location=T19.P19
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "14076_Rio"
msgid "You do?"
msgstr "¿De verdad?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=20
#. y4:msg_location=T19.P20
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "14088_Akiyama"
msgid "You want to try something new."
msgstr "Quieres probar algo nuevo."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=21
#. y4:msg_location=T19.P21
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=19
#. y4:msg_decision_choices=1. That's not a bad thing. -> T19.P22 | 2. Then you should make this decision on your own. -> T19.P37 | 3. You could try something else. -> T19.P45
msgctxt "14100_Rio"
msgid "Hmm... Hmm! Yes!"
msgstr "¡Ajá! ¡Sí!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=178
#. y4:msg_phrase=0
#. y4:msg_location=T178.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T19.P22
#. y4:msg_branch_segment=T19.P22..P36
#. y4:msg_branch_target_text=That's not a bad thing.
#. y4:msg_branch_raw=01 11 00 16 00 00 00 17 00 00 00 00 00 00 00 00
msgctxt "14112_Akiyama"
msgid "That's not a bad thing."
msgstr "Eso no tiene nada de malo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "14124_Rio"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=24
#. y4:msg_location=T19.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14136_Akiyama"
msgid "Of course. It's important to challenge yourself. You can't gain anything without taking action yourself."
msgstr "Por supuesto. Es importante retarse a uno mismo. No puedes lograr nada si no tomas acción por tu cuenta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=25
#. y4:msg_location=T19.P25
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14148_Rio"
msgid "You're right!"
msgstr "¡Tiene razón!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=26
#. y4:msg_location=T19.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14160_Akiyama"
msgid "You don't have to decide right away, right?"
msgstr "No tienes que decidirlo de inmediato, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=27
#. y4:msg_location=T19.P27
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14172_Rio"
msgid "Right."
msgstr "Ya veo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=28
#. y4:msg_location=T19.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14184_Akiyama"
msgid "Then take your time and think about it. It's not the kind of decision you should make spur of the moment."
msgstr "Entonces tómate tu tiempo y piénsalo. No es el tipo de decisión que debas tomar en el calor del momento."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=29
#. y4:msg_location=T19.P29
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14196_Rio"
msgid "Hehehe. You're right."
msgstr "Je, je, je. Tiene razón."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=30
#. y4:msg_location=T19.P30
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14208_Rio"
msgid "I thought that being unsure was my problem. That I was being indecisive."
msgstr "Pensaba que mi inseguridad era el problema. Que estaba siendo indecisa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=31
#. y4:msg_location=T19.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14220_Rio"
msgid "But that's only natural, isn't it?"
msgstr "Pero eso es algo natural, ¿no cree?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=32
#. y4:msg_location=T19.P32
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14232_Akiyama"
msgid "Heh, of course. You're allowed to be unsure."
msgstr "Je, por supuesto. Es completamente válido sentirse insegura."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=33
#. y4:msg_location=T19.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14244_Rio"
msgid "It's strange..."
msgstr "Es extraño..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=34
#. y4:msg_location=T19.P34
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14256_Akiyama"
msgid "Hm?"
msgstr "¿Mm?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=35
#. y4:msg_location=T19.P35
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14268_Rio"
msgid "Nothing... Thanks for listening to my problems, Akiyama-san!"
msgstr "Nada... ¡Gracias por escucharme, Akiyama-san!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=36
#. y4:msg_location=T19.P36
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's not a bad thing.
msgctxt "14280_Akiyama"
msgid "Any time."
msgstr "Cuando quieras."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=179
#. y4:msg_phrase=0
#. y4:msg_location=T179.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T19.P37
#. y4:msg_branch_segment=T19.P37..P44
#. y4:msg_branch_target_text=Then you should make this decision on your own.
#. y4:msg_branch_raw=01 11 00 25 00 00 00 2f 00 00 00 00 00 00 00 00
msgctxt "14292_Akiyama"
msgid "Then you should make this decision on your own."
msgstr "Entonces deberías tomar esa decisión por tu cuenta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=38
#. y4:msg_location=T19.P38
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Then you should make this decision on your own.
msgctxt "14304_Rio"
msgid "Um... Don't you have any advice for me?"
msgstr "Emm... ¿No tiene ningún consejo para mí?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=39
#. y4:msg_location=T19.P39
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Then you should make this decision on your own.
msgctxt "14316_Akiyama"
msgid "It's your life, Rio-chan. You need to figure this out for yourself."
msgstr "Es tu vida, Rio-chan. Tienes que descubrir esto por ti misma."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=40
#. y4:msg_location=T19.P40
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Then you should make this decision on your own.
msgctxt "14328_Rio"
msgid "You're kind of strict, Akiyama-san..."
msgstr "Usted es un poco estricto, Akiyama-san..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=41
#. y4:msg_location=T19.P41
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Then you should make this decision on your own.
msgctxt "14340_Akiyama"
msgid "Would you rather I just told you what to do? I know you're struggling with this, but I respect you too much to just feed you an easy answer."
msgstr "¿Preferirías que simplemente te dijera qué hacer? Sé qué estás batallando con esto, pero te respeto demasiado como para darte una respuesta fácil."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=42
#. y4:msg_location=T19.P42
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Then you should make this decision on your own.
msgctxt "14352_Rio"
msgid "That's sweet of you, but... I'm really, actually lost here."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=43
#. y4:msg_location=T19.P43
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Then you should make this decision on your own.
msgctxt "14364_Rio"
msgid "I just wanted a little help is all."
msgstr "Solo quería un poco de ayuda, eso es todo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=31
#. y4:msg_location=T2.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sounds like fate. You should buy him.
msgctxt "14376_Akiyama"
msgid "......"
msgstr "......"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=45
#. y4:msg_location=T19.P45
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try something else.
msgctxt "14388_Akiyama"
msgid "You could try something else. There are plenty of other ways to challenge yourself."
msgstr "Puedes probar otra cosa. Hay muchas otras formas de desafiarte a ti misma."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=46
#. y4:msg_location=T19.P46
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try something else.
msgctxt "14400_Rio"
msgid "So you don't think it's a good idea?"
msgstr "¿Entonces cree que no es una buena idea?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=47
#. y4:msg_location=T19.P47
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try something else.
msgctxt "14412_Akiyama"
msgid "No, I'm just saying there are other ways to feel proud of yourself."
msgstr "No, solo digo que hay otras maneras de sentirte orgullosa de ti misma."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=48
#. y4:msg_location=T19.P48
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try something else.
msgctxt "14424_Rio"
msgid "Something else? I never really thought about other options."
msgstr "¿Algo más? Nunca había considerado otras opciones."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=49
#. y4:msg_location=T19.P49
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try something else.
msgctxt "14436_Akiyama"
msgid "Then take this opportunity to think about it. Maybe there's something else you'd like to do."
msgstr "Entonces aprovecha esta oportunidad para pensarlo. Tal vez haya algo más que te gustaría hacer."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=50
#. y4:msg_location=T19.P50
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try something else.
msgctxt "14448_Rio"
msgid "That's true. I still have a lot of time. I'll give it more thought."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=51
#. y4:msg_location=T19.P51
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try something else.
msgctxt "14460_Akiyama"
msgid "If you ever need someone to talk to, I'm here."
msgstr "Si algún día necesitas hablar con alguien, estaré aquí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=52
#. y4:msg_location=T19.P52
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You could try something else.
msgctxt "14472_Rio"
msgid "Thank you, Akiyama-san!"
msgstr "¡Gracias, Akiyama-san!"

msgctxt "14484_Rio"
msgid "Hehehe. <Color:7>♥<Color:Default>"
msgstr "Je, je, je. <Color:7>♥<Color:Default>"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
