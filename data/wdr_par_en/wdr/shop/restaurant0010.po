msgctxt "428"
msgid "Quit"
msgstr "Salir"

#. y4:line_status=reviewed
#. y4:translated_by=Kcat0
#. y4:reviewed_by=Kcat0
msgctxt "433"
msgid "Cancel the order."
msgstr "Cancelar pedido."

#. y4:line_status=reviewed
#. y4:reviewed_by=Kcat0
msgctxt "451"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=reviewed
#. y4:translated_by=Kcat0
#. y4:reviewed_by=Kcat0
msgctxt "457"
msgid "Order the currently selected item."
msgstr "Pagar el objeto seleccionado."

#. y4:line_status=translated
msgctxt "492"
msgid "(I haven't picked anything.)"
msgstr "(No he escogido nada)"

#. y4:line_status=translated
msgctxt "521"
msgid "(I'm short on cash.)"
msgstr "(Me hace falta dinero)"

#. y4:line_status=translated
msgctxt "542"
msgid "Very well, sir."
msgstr "Muy bien, señor."

#. y4:line_status=translated
msgctxt "558"
msgid "(I can't eat anymore...)"
msgstr "(No puedo comer más...)"

#. y4:line_status=translated
msgctxt "602"
msgid "Prepared from fresh tomatoes and mozzarella with a\nlight olive oil drizzle."
msgstr "Preparado a partir de tomates frescos y mozzarella\ncon un liviano aceite de oliva."

#. y4:line_status=translated
msgctxt "678"
msgid "Soft Hokkaido octopus and zesty ponzu sauce make this\ncarpaccio really stand out."
msgstr "El suave pulpo de Hokkaido y la vibrante salsa ponzu\nhacen que este carpaccio realmente destaque."

#. y4:line_status=translated
msgctxt "760"
msgid "A salad of avocado and shrimp topped with a light\nJapanese-style dressing."
msgstr "Una ensalada de aguacate y camarones cubierta con\nun aderezo ligero al estilo japonés."

#. y4:line_status=translated
msgctxt "835"
msgid "Spicy, bite-sized, Hawaiian-style Portuguese sausages.\nGoes great with beer."
msgstr "Salchichas portuguesas al estilo hawaiano, picantes y\nen porciones pequeñas. Combina muy bien con cerveza."

#. y4:line_status=translated
msgctxt "912"
msgid "Fries made from fresh strips of burdock. Enjoy their\ncrunchy goodness!"
msgstr "Papas fritas hechas de tiras frescas de bardana.\n¡Disfruta de su crujiente sabor!"

#. y4:line_status=translated
msgctxt "983"
msgid "Spicy fries made by seasoning Hokkaido Matilda\npotatoes with chipotle salt."
msgstr "Papas fritas picantes sazonadas con sal de\nchipotle hechas con papas Matilda de Hokkaido."

#. y4:line_status=translated
msgctxt "1059"
msgid "Oven-roasted, fragrant, spicy chorizo sausage seasoned\nwith chipotle salt."
msgstr "Chorizo aromático y picante, asado al horno y sazonado\ncon sal de chipotle."

#. y4:line_status=translated
msgctxt "1134"
msgid "Fresh, tender sea snails from Akkeshi, roasted in garlic\nbutter."
msgstr "Caracoles marinos frescos y tiernos de Akkeshi, asados\nen mantequilla de ajo."

#. y4:line_status=translated
msgctxt "1199"
msgid "This Roman pizza is basic Margherita-style, made with\nfresh tomato sauce and basil."
msgstr "Esta pizza romana es el básico estilo Margherita,\nlleva salsa de tomate fresco y albahaca."

