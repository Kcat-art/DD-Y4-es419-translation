msgctxt "84_Fickle Baseball Fan"
msgid "Hey, I heard someone saw Baba over at the batting center\\r\n"
"just now!"
msgstr "Hey, ¡he oído que alguien ha visto a Baba en el centro de bateo\\r\n"
"justo ahora!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Soccer Fan
#. y4:msg_speaker_id=2
msgctxt "96_Soccer Fan"
msgid "Uh, should I know who that is?"
msgstr "Uh, ¿debería saber quién es?"

msgctxt "108_Fickle Baseball Fan"
msgid "Oh c'mon, you can't tell me you don't know Baba! He's super\\r\n"
"famous!"
msgstr "Oh vamos, ¡no puedes decirme que no conoces a Baba! ¡Es súper\\r\n"
"famoso!"

msgctxt "120_Fickle Baseball Fan"
msgid "He can pitch like you wouldn't believe! What do they call\\r\n"
"him, again?"
msgstr "¡Puede lanzar como no creerías! ¿Cómo es que le llaman?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
