#. y4:line_status=translated
msgctxt "172_The Florist"
msgid "While you've been looking for me, I've had my eye on you.\\r\nSo, is there something you wanted to ask me?"
msgstr "Mientras me buscabas, the he estado observando.\\r\nDime, ¿Querías preguntarme algo?"

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
