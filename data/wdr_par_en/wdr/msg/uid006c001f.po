msgctxt "6036_Akiyama"
msgid "That's quite an interesting experience."
msgstr "Qué interesante experiencia."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=23
#. y4:msg_location=T5.P23
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's quite an interesting experience.
msgctxt "6048_Noa"
msgid "I don't need that kind of experience! I was so embarrassed I thought I'd die."
msgstr "¡No necesito ese tipo de experiencias! Fue tan vergonzosa..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=24
#. y4:msg_location=T5.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's quite an interesting experience.
msgctxt "6060_Akiyama"
msgid "What if it was somebody you liked instead of a stranger? Would you kiss him on a crowded train?"
msgstr "¿Y si te lo pidiera el chico que te gusta? ¿Lo besarías en el tren?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=25
