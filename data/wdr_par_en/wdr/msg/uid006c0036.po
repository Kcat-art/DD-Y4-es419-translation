#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are you sure you're a strong drinker?
msgctxt "14316_Kiryu"
msgid "Are you sure you're not a lightweight?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=22
#. y4:msg_location=T27.P22
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are you sure you're a strong drinker?
msgctxt "14328_松岡里緒奈：源氏名"
msgid "What!? Of course I'm sure! How could you doubt me like that?"
msgstr "¿¡Qué!? ¡Por supuesto que estoy segura! ¿Cómo pudiste dudar de mí de esa manera?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=23
#. y4:msg_location=T27.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are you sure you're a strong drinker?
msgctxt "14340_Kiryu"
msgid "Well, you might be strong for a woman, but you were facing someone with a man's tolerance, right?"
msgstr "Bueno, puede que seas fuerte para ser mujer, pero te enfrentabas a alguien con la tolerancia de un hombre, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=24
#. y4:msg_location=T27.P24
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are you sure you're a strong drinker?
msgctxt "14352_松岡里緒奈：源氏名"
msgid "That doesn't matter! I've never lost a drinking contest before!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=25
#. y4:msg_location=T27.P25
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are you sure you're a strong drinker?
msgctxt "14364_Kiryu"
msgid "Maybe all the opponents you've defeated up until now have been lightweights?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=26
#. y4:msg_location=T27.P26
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are you sure you're a strong drinker?
msgctxt "14376_松岡里緒奈：源氏名"
msgid "Kiryu-san! You don't believe in me, do you?"
msgstr "¡Kiryu-san! No crees en mí, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
