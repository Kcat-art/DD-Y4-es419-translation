msgctxt "1680"
msgid "Hana"
msgstr "Hana"

#. y4:msg_type=id
#. y4:msg_label=Nombre interno
#. y4:msg_id_index=1
msgctxt "1684"
msgid "Akiyama"
msgstr "Akiyama"

msgctxt "120_Hana"
msgid "I can't believe I'm going to karaoke with you, Chief...\\r\n"
"I'm so excited. Now, what should I sing?"
msgstr "No puedo creer que vaya al karaoke contigo, Jefe...\\r\n"
"Estoy tan emocionada. Ahora, ¿qué debería cantar?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "132_Hana"
msgid "Oh, I know! Why don't we sing a duet? You know how to sing \"Pure Love in Kamurocho,\" right, Chief!?"
msgstr "¡Oh, lo sé! ¿Por qué no cantamos un dueto? Sabes cantar \"Pure Love in Kamurocho\", ¿verdad, Jefe!?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=0
#. y4:msg_location=T2.P0
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "144_Hana"
msgid "Hehe... Don't you think we were completely in sync? We were flowing like pros."
msgstr "Jeje... ¿No crees que estábamos completamente sincronizados? Fluíamos como profesionales."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "156_Akiyama"
msgid "Heheh, I guess so."
msgstr "Heheh, supongo que sí."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=0
#. y4:msg_location=T3.P0
#. y4:msg_speaker=Hana
#. y4:msg_speaker_id=0
msgctxt "168_Hana"
msgid "Chief... Stop getting in my way."
msgstr "Jefe... Deje de meterse en mi camino."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=1
#. y4:msg_location=T3.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "180_Akiyama"
msgid "Sorry..."
msgstr "Lo siento..."

msgctxt "192_Hana"
msgid "That was perfect! I think we could release a CD. <Color:7>♥<Color:Default>"
msgstr "¡Eso fue perfecto! Creo que podríamos lanzar un CD. <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=4
#. y4:msg_phrase=1
#. y4:msg_location=T4.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=1
msgctxt "204_Akiyama"
msgid "Heheh, sure."
msgstr "Jejeje, claro."
