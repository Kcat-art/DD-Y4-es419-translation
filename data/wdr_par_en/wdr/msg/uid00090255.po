#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Suited Stalker
#. y4:msg_speaker_id=0
msgctxt "56_Suited Stalker"
msgid "Ugh... I'm not giving up so easily!"
msgstr "Ugh... ¡No me voy a rendir tan fácilmente!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Delusional Nerd
#. y4:msg_speaker_id=2
msgctxt "68_Delusional Nerd"
msgid "This is just another trial that I have to overcome to prove my love!"
msgstr "¡Esta es solo otra prueba que tengo que superar para demostrar mi amor!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Man Blind to Reality
#. y4:msg_speaker_id=3
msgctxt "80_Man Blind to Reality"
msgid "Ow... You'll have to do better than that!"
msgstr "Ow... ¡Tendrás que hacerlo mejor que eso!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=4
msgctxt "92_Noa"
msgid "Just stop it! All of you!"
msgstr "¡Deténganse! ¡Todos ustedes!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Suited Stalker
#. y4:msg_speaker_id=0
msgctxt "104_Suited Stalker"
msgid "Noa-chan..."
msgstr "Noa-chan..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=4
msgctxt "116_Noa"
msgid "Look... It's nice that you all like me, but..."
msgstr "Miren... Esta bien que les guste a todos, pero..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
msgctxt "128_Talk_Gakkari"
msgid "I'm sorry! I don't feel that way about you!"
msgstr "¡Lo siento! ¡No me siento así por ustedes!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Delusional Nerd
#. y4:msg_speaker_id=2
msgctxt "140_Delusional Nerd"
msgid "...!"
msgstr "¡...!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=4
msgctxt "152_Noa"
msgid "So please... Stop following me around."
msgstr "Así que por favor... Dejen de seguirme a todas partes."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Man Blind to Reality
#. y4:msg_speaker_id=3
msgctxt "164_Man Blind to Reality"
msgid "No... I don't buy it. Are you going out with somebody else?"
msgstr "No... Yo no lo compro. ¿Estás saliendo con otra persona?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Man Blind to Reality
#. y4:msg_speaker_id=3
msgctxt "176_Man Blind to Reality"
msgid "If not, I'm not giving up!"
msgstr "Si no, ¡no me rendiré!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=4
msgctxt "188_Noa"
msgid "Um... Yes, I am going out with someone."
msgstr "Um... Sí, estoy saliendo con alguien."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Man Blind to Reality
#. y4:msg_speaker_id=3
msgctxt "212_Man Blind to Reality"
msgid "Huh?"
msgstr "Uh, ¿y eso?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Suited Stalker
#. y4:msg_speaker_id=0
msgctxt "224_Suited Stalker"
msgid "Huh!?"
msgstr "¡¿Eh?!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Delusional Nerd
#. y4:msg_speaker_id=2
msgctxt "236_Delusional Nerd"
msgid "HUH!?"
msgstr "¿¡EH!?"

#. y4:line_status=translated
msgctxt "248_Noa"
msgid "Isn't that right, darling? <Color:255,200,200,255>♥<Color:Default>"
msgstr "¿No es así, cariño? <Color:255,200,200,255>♥<Color:Default>"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=8
msgctxt "260_Akiyama"
msgid "Huh? Me?"
msgstr "¿Eh? ¿Yo?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=4
msgctxt "272_Noa"
msgid "Come on, Akiyama-san. Let's go."
msgstr "Vamos, Akiyama-san. Vámonos."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=8
msgctxt "296_Akiyama"
msgid "Uh... Okay."
msgstr "Oh... Está bien."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=30
#. y4:msg_location=T0.P30
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=8
msgctxt "416_Akiyama"
msgid "You did it. You finally got rid of them."
msgstr "Lo hiciste. Finalmente te deshiciste de ellos."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=31
#. y4:msg_location=T0.P31
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=4
msgctxt "428_Noa"
msgid "It's all thanks to you."
msgstr "Todo es gracias a ti."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=32
#. y4:msg_location=T0.P32
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=8
msgctxt "440_Akiyama"
msgid "I never figured pretending to be your boyfriend would make them give up. We should've just done that from the start."
msgstr "Nunca imaginé que fingir ser tu novio haría que se dieran por vencidos. Deberíamos haberlo hecho desde el principio."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=4
msgctxt "452_Noa"
msgid "Hehe. What do you mean pretending?"
msgstr "Jeje. ¿A qué te refieres con fingir?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Man Blind to Reality
#. y4:msg_speaker_id=3
msgctxt "464_Akiyama"
msgid "Huh?"
msgstr "Uh, ¿y eso?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=35
#. y4:msg_location=T0.P35
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=4
msgctxt "476_Noa"
msgid "I'd like you to be my real boyfriend!"
msgstr "¡Me gustaría que fueras mi novio de verdad!"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=36
#. y4:msg_location=T0.P36
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=8
msgctxt "488_Akiyama"
msgid "Really? Is this how you envisioned it happening?"
msgstr "¿De verdad? ¿Es así como imaginaste que sucedería?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=37
#. y4:msg_location=T0.P37
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=4
msgctxt "500_Noa"
msgid "Why not?"
msgstr "¿Por qué no?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=38
#. y4:msg_location=T0.P38
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=8
msgctxt "512_Akiyama"
msgid "Seriously?"
msgstr "¿En serio?"

#. y4:line_status=translated
msgctxt "524_Noa"
msgid "Yes. Please. <Color:255,200,200,255>♥<Color:Default>"
msgstr "Sí. Por favor. <Color:255,200,200,255>♥<Color:Default>"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=40
#. y4:msg_location=T0.P40
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=8
msgctxt "536_Akiyama"
msgid "Well, okay..."
msgstr "Bueno, está bien..."
