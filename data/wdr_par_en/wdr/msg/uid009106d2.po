#. y4:msg_speaker_id=7
msgctxt "288_Akaishi"
msgid "Black Nightmare... What a bizarre group. They seemed much more sophisticated than the usual riffraff."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "300_Kiryu"
msgid "I wouldn't worry about it too much."
msgstr ""

