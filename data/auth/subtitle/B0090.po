msgctxt "1295\t1355"
msgid "As promised."
msgstr "Lo prometido."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1391\t1552"
msgid "Had a buddy copy one for you.\\nGuy was a pro before he got tossed in here."
msgstr "A escondidas de los guardias, hice que un preso\\nexperto en ese tipo de cosas hiciera una copia."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1582\t1683"
msgid "That cell won't keep you cooped up anymore."
msgstr "Con eso debería ser suficiente para que escapes de tu celda."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1728\t1809"
msgid "Still didn't say I'd do it."
msgstr "Todavía no he dicho que vaya a hacerlo."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "1869\t1978"
msgid "No problem there.\\nYou'll do it."
msgstr "Lo harás.\\nSé que lo harás."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2014\t2090"
msgid "You don't have a choice."
msgstr "No tienes otra opción."

