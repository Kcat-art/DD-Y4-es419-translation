msgctxt "136_Owner of Kyushu No. 1 Star"
msgid "Welcome! What'll it be?"
msgstr "¡Bienvenido! ¿Qué va a pedir?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "160_Haruka"
msgid "Uncle Kaz! I'm really craving some ramen... Can I get some <Color:8>Kyushu Tonkotsu Ramen<Color:Default>?"
msgstr "¡Tío Kaz! Estoy con ganas de ramen... ¿Podemos ir por un <Color:8>Kyushu Tonkotsu Ramen<Color:Default>?"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "172_Kiryu"
msgid "(Haruka wants me to get her some <Color:8>Kyushu Tonkotsu Ramen<Color:Default>...)"
msgstr "(Haruka quiere comer <Color:8>Kyushu Tonkotsu Ramen<Color:Default>...)"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "196_Haruka"
msgid "But I wanted that <Color:8>Kyushu Tonkotsu Ramen<Color:Default>..."
msgstr "Pero si de verdad quería un <Color:8>Kyushu Tonkotsu Ramen<Color:Default>..."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "208_Owner of Kyushu No. 1 Star"
msgid "Is that so? Well, I hope you actually order something next time!"
msgstr "¿Aja? Bueno, ¡los espero a la próxima que pidan!"

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "232_Haruka"
msgid "Thanks, Uncle Kaz! I can't wait to dig in!"
msgstr "¡Gracias, tío Kaz! ¡Está sabroso! "

#. y4:line_status=translated
#. y4:translated_by=MasterCry
msgctxt "400_Haruka"
msgid "Mmm, that was so good. ♥ Thanks for treating me!"
msgstr "Hmm, estuvo increíble. ♥ ¡Gracias por traerme! ♥ "

#. y4:line_status=translated
msgctxt "412_Kiryu"
msgid "(Haruka sure is happy...)"
msgstr "(Haruka parece feliz...)."

#. y4:line_status=translated
#. y4:translated_by=MasterCry
