#. y4:msg_branch_choice=Romance movies.
msgctxt "10992_松岡里緒奈：源氏名"
msgid "Huh? Who's Haruka?"
msgstr "¿Eh? ¿Quién es Haruka?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
