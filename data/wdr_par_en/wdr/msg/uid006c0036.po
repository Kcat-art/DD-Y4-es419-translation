#. y4:msg_speaker_id=2
#. y4:msg_decision_group=23
#. y4:msg_decision_choices=1. Make peace with your father first. -> T23.P15 | 2. That's hard to say. -> T23.P24 | 3. Let's give this a little more time. -> T23.P30
msgctxt "12708_松岡里緒奈：源氏名"
msgid "Does that mean you share my feelings?"
msgstr "¿Significa eso que compartes mis sentimientos?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=23
#. y4:msg_section_label=Conversación 23
#. y4:msg_talk=23
