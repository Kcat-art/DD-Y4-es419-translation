#. y4:msg_location=T3.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "5196_Kiryu"
msgid "Why do you ask?"
msgstr "¿Por qué la pregunta?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=2
#. y4:msg_location=T3.P2
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "5208_望月京子：源氏名"
msgid "I'm just curious. It's been six months since I broke up with my boyfriend. He cheated on me, so I punched him in the face."
msgstr "Por curiosidad. Pasaron ya seis meses desde que rompí con mi novio. Me engaño, así que lo golpee en la cara."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=3
#. y4:msg_location=T3.P3
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "5220_望月京子：源氏名"
msgid "Where are all the good guys hiding, am I right?"
msgstr "¿Dónde estarán los buenos chicos, no?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=4
#. y4:msg_location=T3.P4
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "5232_Kiryu"
msgid "What sort of guy do you like?"
msgstr "¿Qué clase de chicos te gustan, Kyoko?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=5
#. y4:msg_location=T3.P5
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "5244_望月京子：源氏名"
msgid "Well... Forgetting looks for a minute, I like a man with integrity."
msgstr "Bueno... Dejando las apariencias a un lado, me gusta un hombre por su como es."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=6
#. y4:msg_location=T3.P6
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "5256_望月京子：源氏名"
msgid "And I can't stand men who cheat or can't see things through."
msgstr "No soporto a los infieles o los hombres con falta de compromiso, vaya que le de igual, eso me enfada."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
