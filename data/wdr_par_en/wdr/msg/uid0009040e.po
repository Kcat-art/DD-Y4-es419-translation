#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Tell Him
msgctxt "328_Akiyama"
msgid "It's \"Korai,\" on Shichifuku Street."
msgstr "Es \"Korai\", de la calle Shichifuku."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
