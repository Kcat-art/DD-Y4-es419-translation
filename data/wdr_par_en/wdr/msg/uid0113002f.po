#. y4:msg_branch_segment=T0.P2..P5
#. y4:msg_branch_target_text=Every student's goal is to win a tournament. Work to have your students win in as few turns as possible. The sooner the victory, the better the prize purse and the easier it is to earn a good evaluation and rank.
#. y4:msg_branch_raw=01 11 00 02 00 00 00 0b 00 00 00 00 00 00 00 00
msgctxt "716_Saejima"
msgid "Tournaments"
msgstr "Torneos"

