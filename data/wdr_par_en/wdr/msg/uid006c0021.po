#. y4:msg_location=T4.P11
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It sounds like he's trying pretty hard.
msgctxt "6036_Erena"
msgid "Right?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=12
#. y4:msg_location=T4.P12
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It sounds like he's trying pretty hard.
msgctxt "6048_Erena"
msgid "If somebody did something like that for me, I'd melt!"
msgstr "Si alguien hiciera algo así por mí, ¡me derretiría ahí mismo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=13
#. y4:msg_location=T4.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It sounds like he's trying pretty hard.
msgctxt "6060_Akiyama"
msgid "He's creative, I'll give him that."
msgstr "Es creativo, le doy un punto por eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=14
#. y4:msg_location=T4.P14
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It sounds like he's trying pretty hard.
msgctxt "6072_Erena"
msgid "Why is she always the one who has stuff like that happen to her? It's not fair!"
msgstr "¿Por qué siempre es ella a la que le pasan este tipo de cosas? ¡No es justo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=15
#. y4:msg_location=T4.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It sounds like he's trying pretty hard.
msgctxt "6084_Akiyama"
msgid "Hahah. Don't ask me."
msgstr "Ja, ja, ja. A mí no me preguntes."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=16
#. y4:msg_location=T4.P16
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It sounds like he's trying pretty hard.
msgctxt "6096_Erena"
msgid "I'm jealous."
msgstr "Estoy tan celosa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=17
#. y4:msg_location=T4.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It sounds like he's trying pretty hard.
msgctxt "6108_Akiyama"
msgid "Well, do you want me to give you a present?"
msgstr "Bueno, ¿quieres que te haga un regalo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=18
#. y4:msg_location=T4.P18
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It sounds like he's trying pretty hard.
msgctxt "6120_Erena"
msgid "Really? Just remember, you've got to be pretty creative if ya want to impress me."
msgstr "¿De verdad? Recuerda que tienes que ser muy creativo si quieres impresionarme."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=4
#. y4:msg_phrase=19
#. y4:msg_location=T4.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=It sounds like he's trying pretty hard.
msgctxt "6132_Akiyama"
msgid "Maybe I should've kept my mouth shut..."
msgstr "Tal vez debería haber mantenido la boca cerrada..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=134
