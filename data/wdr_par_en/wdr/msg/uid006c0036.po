#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'll pass.
msgctxt "9516_Kiryu"
msgid "Okay, but... I'm still not going to go overboard. I prefer to drink slowly and savor it."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
