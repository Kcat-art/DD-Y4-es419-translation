#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I wouldn't mind being a teacher there.
msgctxt "12528_Rio"
msgid "Hehehe. As it turns out, a lot of guys say that."
msgstr "Jejeje. Resulta que muchos chicos dicen eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
