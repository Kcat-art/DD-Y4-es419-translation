#. y4:msg_decision_group=22
#. y4:msg_decision_choices=1. They say dogs take after their masters. -> T22.P7 | 2. You sound like you're enjoying taking care of him, at least. -> T22.P12 | 3. It sounds like he could use better training. -> T22.P19
msgctxt "15444_Rio"
msgid "The first thing I do when I get home is clean up after him..."
msgstr "Lo primero que hago al llegar a casa es limpiar todo..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=187
#. y4:msg_phrase=0
#. y4:msg_location=T187.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T22.P7
#. y4:msg_branch_segment=T22.P7..P11
#. y4:msg_branch_target_text=They say dogs take after their masters.
#. y4:msg_branch_raw=01 11 00 07 00 00 00 27 00 00 00 00 00 00 00 00
msgctxt "15456_Akiyama"
msgid "They say dogs take after their masters."
msgstr "Dicen que los perros se parecen a sus dueños."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=8
#. y4:msg_location=T22.P8
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They say dogs take after their masters.
msgctxt "15468_Rio"
msgid "Hey! That's kinda mean! Besides, you were the one who convinced me to buy him in the first place!"
msgstr "¡Oiga! Eso fue un poco grosero… ¡Además, fue usted quien me convenció de comprarlo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=9
#. y4:msg_location=T22.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They say dogs take after their masters.
msgctxt "15480_Akiyama"
msgid "Haha. Yeah, I guess I did."
msgstr "Ja, ja. Sí, supongo que hice eso."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=10
#. y4:msg_location=T22.P10
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They say dogs take after their masters.
msgctxt "15492_Rio"
msgid "He is really smart though. I just wish he'd get housebroken already."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=11
#. y4:msg_location=T22.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=They say dogs take after their masters.
msgctxt "15504_Akiyama"
msgid "Heh... I'm sure he'll get it some day."
msgstr "Je… Seguro que algún día aprenderá."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=188
#. y4:msg_phrase=0
#. y4:msg_location=T188.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T22.P12
#. y4:msg_branch_segment=T22.P12..P18
#. y4:msg_branch_target_text=You sound like you're enjoying taking care of him, at least.
#. y4:msg_branch_raw=01 11 00 0c 00 00 00 3c 00 00 00 00 00 00 00 00
msgctxt "15516_Akiyama"
msgid "You sound like you're enjoying taking care of him, at least."
msgstr "Suena a que estás disfrutando el cuidar de él."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=13
#. y4:msg_location=T22.P13
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You sound like you're enjoying taking care of him, at least.
msgctxt "15528_Rio"
msgid "You can tell? Yeah, it's actually a lot of fun."
msgstr "¿Se nota? Sí, en realidad es muy divertido."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=14
#. y4:msg_location=T22.P14
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You sound like you're enjoying taking care of him, at least.
msgctxt "15540_Rio"
msgid "I mean, it is a little depressing to have to clean up after him so often, but I love having him around!"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=15
#. y4:msg_location=T22.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You sound like you're enjoying taking care of him, at least.
msgctxt "15552_Akiyama"
msgid "I'm just picturing you following him around with a mop."
msgstr "Acabo de imaginarte a ti corriendo detrás de él con un trapeador."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=16
#. y4:msg_location=T22.P16
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You sound like you're enjoying taking care of him, at least.
msgctxt "15564_Rio"
msgid "Oh my gosh, Akiyama-san! Hahaha!"
msgstr "¡Dios mío, Akiyama-san! ¡Ja, ja, ja!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=17
#. y4:msg_location=T22.P17
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You sound like you're enjoying taking care of him, at least.
msgctxt "15576_Akiyama"
msgid "Well, I hope he gets housebroken soon."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=18
#. y4:msg_location=T22.P18
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You sound like you're enjoying taking care of him, at least.
msgctxt "15588_Rio"
msgid "Hehehe. Yeah, me too."
msgstr "Jejeje. Sí, yo también."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=189
#. y4:msg_phrase=0
#. y4:msg_location=T189.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T22.P19
#. y4:msg_branch_segment=T22.P19..P28
#. y4:msg_branch_target_text=It sounds like he could use better training.
#. y4:msg_branch_raw=01 11 00 13 00 00 00 2c 00 00 00 00 00 00 00 00
msgctxt "15600_Akiyama"
msgid "It sounds like he could use better training."
msgstr "Parece que le vendría bien un mejor entrenamiento."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=20
#. y4:msg_location=T22.P20
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It sounds like he could use better training.
msgctxt "15612_Rio"
msgid "You'd think so, right? I thought I must be doing something wrong, so I went back and talked to the people at the pet store."
msgstr "Se podría pensar que sí, ¿verdad? Pensé que debía estar haciendo algo mal, así que volví y hablé con la gente de la tienda de animales."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=21
#. y4:msg_location=T22.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It sounds like he could use better training.
msgctxt "15624_Akiyama"
msgid "What did they say?"
msgstr "¿Y qué te dijeron?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=22
#. y4:msg_location=T22.P22
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It sounds like he could use better training.
msgctxt "15636_Rio"
msgid "That he's always been like that..."
msgstr "Que siempre ha sido así..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=23
#. y4:msg_location=T22.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It sounds like he could use better training.
msgctxt "15648_Akiyama"
msgid "That's it?"
msgstr "¿Solo eso?"

#. y4:msg_type=branch_dialogue
