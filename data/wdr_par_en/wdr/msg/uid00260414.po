#. y4:msg_decision_group=1
#. y4:msg_decision_choices=1. Refuse -> T4.P8 | 2. Help Him -> T4.P13
msgctxt "2040_Delivery Boy"
msgid "......"
msgstr "......"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=5
#. y4:msg_location=T6.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=10
msgctxt "2052_Kiryu"
msgid "Something wrong?"
msgstr "¿Todo bien?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=7
#. y4:msg_location=T6.P7
#. y4:msg_speaker=Delivery Boy
#. y4:msg_speaker_id=0
msgctxt "2076_Delivery Boy"
msgid "Huh? Oh, it's really nothing. Okay, it's actually something, but I'll take care of it... somehow."
msgstr "¿Eh? Oh, en realidad no es nada. Okey, en realidad es algo, pero me ocuparé de ello... de alguna manera."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=6
#. y4:msg_phrase=8
#. y4:msg_location=T6.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=10
msgctxt "2088_Kiryu"
msgid "If you're sure..."
msgstr "Si estás seguro..."

#. y4:line_status=translated
#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
