#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're just saying that.
msgctxt "4416_Akiyama"
msgid "Heh. You're funny. I like that."
msgstr "Je, je, je. Qué señorita más interesante..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4428_Noa"
msgid "Um... I feel like somebody's been following me recently."
msgstr "Sabes... siento que alguien me ha estado siguiendo últimamente."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4440_Akiyama"
msgid "What? Like a stalker?"
msgstr "¡Oi oi! ¡Pero qué miedo! ¿Te refieres a un acosador?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
msgctxt "4452_Noa"
msgid "I hope not, but it's been going on for a week."
msgstr "Espero que no, pero llevo una semana con esa sensación..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "4464_Akiyama"
msgid "Hmm. Has anything like this happened before?"
msgstr "Hmm. ¿Te había pasado algo así antes?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
