msgid "(I haven't picked anything.)"
msgstr "(No he escogido nada)"

#. y4:line_status=translated
msgctxt "393"
msgid "(I'm short on cash.)"
msgstr "(Me hace falta dinero)"

#. y4:line_status=translated
msgctxt "414"
msgid "Thank you. Your total comes to %s."
msgstr "Gracias. El precio total es de %s."

#. y4:line_status=translated
msgctxt "449"
msgid "(I can't eat anymore...)"
msgstr "(No puedo comer más...)"

#. y4:line_status=translated
msgctxt "493"
msgid "A standard menu item offering the authentic taste of\nKyushu tonkotsu ramen."
msgstr "Un plato estándar que ofrece el auténtico sabor del\nramen tonkotsu de Kyushu."

#. y4:line_status=translated
msgctxt "569"
msgid "Our famous tonkotsu ramen topped with tender, \njuicy pork belly that'll melt in your mouth."
msgstr "Nuestro famoso ramen tonkotsu cubierto con\nsuave y jugosa panceta de cerdo que se deshace\nen la boca."

#. y4:line_status=translated
msgctxt "661"
msgid "Tasty tonkotsu ramen topped with succulent, thin \nslices of roast pork."
msgstr "Sabroso ramen tonkotsu cubierto con suculentas y\nfinas lonchas de cerdo asado."

#. y4:line_status=translated
msgctxt "733"
msgid "This tonkotsu ramen is topped with spicy roe \nimported straight from Kyushu."
msgstr "Este ramen tonkotsu lleva huevas picantes\nimportadas directamente de Kyushu."

#. y4:line_status=translated
msgctxt "810"
msgid "Delicious tonkotsu ramen topped with a soft-boiled\negg."
msgstr "Delicioso ramen tonkotsu cubierto con un huevo\ncocido a baja temperatura."

