msgctxt "2236_Tanimura"
msgid "......"
msgstr "......"

#. y4:line_status=translated
msgctxt "2248_Tall Man"
msgid "He's right! This was the only thing we could do\\r\nwith our lives!"
msgstr "¡Él está diciendo la verdad! ¡Esto era lo único\\r\nque podíamos hacer para vivir!"

#. y4:line_status=translated
