#. y4:msg_location=T2.P33
#. y4:msg_speaker=Striped Kitten
#. y4:msg_speaker_id=2
msgctxt "644_Striped Kitten"
msgid "Mrowr!"
msgstr ""

#. y4:line_status=translated
#. y4:msg_type=dialogue
