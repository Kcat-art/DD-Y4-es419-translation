msgctxt "200_Man on a Date?"
msgid "Yes?"
msgstr "¿Sí?"

msgctxt "212_Akiyama"
msgid "This may seem like a strange question, but do you like big\\r\n"
"girls?"
msgstr "Esto puede parecer una pregunta rara, ¿pero te gustan las chicas\\r\n"
"de talla grande?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Man on a Date?
#. y4:msg_speaker_id=2
msgctxt "224_Man on a Date?"
msgid "What do you mean by that?"
msgstr "¿Qué quieres decir?"

msgctxt "236_Akiyama"
msgid "I mean, as far as your taste in women goes, you prefer\\r\n"
"larger women to slimmer ones, right?"
msgstr "Quiero decir, teniendo en cuenta tu gusto en mujeres, Prefieres a\\r\n"
"chicas más rellenitas que las delgadas, ¿cierto?"

msgctxt "248_Man on a Date?"
msgid "Huh? No, if I had to pick, I'd probably go with a slimmer\\r\n"
"girl..."
msgstr "¿Eh? No, si tuviera que elegir, iría tras una chica\\r\n"
"delgada..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "260_Akiyama"
msgid "Really? Seeing your girlfriend, I'd think otherwise."
msgstr "¿De verdad? Viendo a tu novia, pensaría lo contrario."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Man on a Date?
#. y4:msg_speaker_id=2
msgctxt "272_Man on a Date?"
msgid "Girlfriend? Oh, her? She's my sister."
msgstr "¿Novia? ¿Oh, ella? Es mi hermana."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
