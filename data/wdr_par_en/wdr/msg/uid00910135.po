msgctxt "1120_Minamida"
msgid "Do you want to hear a more detailed explanation on the machine?"
msgstr "¿Quieres que te explique más detalladamente como funciona?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=9
#. y4:msg_location=T3.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=3
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That won't be necessary.
msgctxt "1132_Kiryu"
msgid "No, I'm fine. It's not my first time."
msgstr "No será necesario. No es mi primera vez."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=10
#. y4:msg_location=T3.P10
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That won't be necessary.
msgctxt "1144_Minamida"
msgid "Oh? Then, come back anytime if you want to play. I'll be waiting!"
msgstr "¿Eh? Bueno, vuelve cuando quieras jugar.\n"
"¡Te estaré esperando!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=11
#. y4:msg_location=T3.P11
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1156_Minamida"
msgid "Very well, I will explain in detail!"
msgstr "¡Bien, entonces te lo explicaré al detalle!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=12
#. y4:msg_location=T3.P12
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1168_Minamida"
msgid "To play, you must first <Color:7>input<Color:Default> information on your enemy."
msgstr "Para jugar, primero debes <Color:7>ingresar<Color:Default> la información sobre tu enemigo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=13
#. y4:msg_location=T3.P13
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1180_Minamida"
msgid "However, the only information you can <Color:7>input<Color:Default> is that of particularly strong enemies, ones who made a lasting impression on you."
msgstr "Sin embargo, la única información que puedes <Color:7>ingresar<Color:Default> es la de enemigos\n"
"particularmente fuertes que te dejaron con una gran impresión."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=14
#. y4:msg_location=T3.P14
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1192_Minamida"
msgid "If you <Color:7>input<Color:Default> an enemy and are victorious against him, you become stronger. Nifty, don't you think?"
msgstr "Si consigues <Color:7>ingresar<Color:Default> a un enemigo y lo derrotas\n"
"te volverás más fuerte. Una maravilla, ¿no crees?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=15
#. y4:msg_location=T3.P15
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1204_Minamida"
msgid "But, some punks broke the machine. And now that feature no longer works."
msgstr "Pero unos matones rompieron la máquina.\n"
"Y ahora esa función ya no sirve."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=16
#. y4:msg_location=T3.P16
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1216_Minamida"
msgid "I will need some money to be able to fix it, and that's where you come in!"
msgstr "Necesitaré algo de dinero para poder arreglarlo, ¡y ahí es donde\n"
"entras tú!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=17
#. y4:msg_location=T3.P17
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1228_Minamida"
msgid "Would you mind donating some funds so I can repair and modify this baby? I might not look it, but I'm flat broke."
msgstr "¿Te importaría donar fondos para que le haga unos arreglitos a\n"
"esta belleza? No lo aparento, pero estoy en la ruina."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=18
#. y4:msg_location=T3.P18
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1240_Minamida"
msgid "Of course, there's something in it for you too. If the machine is upgraded, the user will be able to receive various bits of useful information."
msgstr "Y por supuesto, también obtendrás algo a cambio. Si la máquina\n"
"se mejora, el usuario podrá acceder a información muy útil."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=19
#. y4:msg_location=T3.P19
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1252_Minamida"
msgid "Please think it over. Heheheh..."
msgstr "Solo pido que lo consideres. Je, je, je..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=0
#. y4:msg_location=T4.P0
#. y4:msg_speaker=Man in White
#. y4:msg_speaker_id=2
msgctxt "1264_Man in White"
msgid "Hm? Who are you? Do you need something?"
msgstr "¿Mm? ¿Quién eres? ¿Necesitas algo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=1
#. y4:msg_location=T4.P1
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "1276_Tanimura"
msgid "I'm Tanimura, a detective here in Kamurocho. What are you doing down here?"
msgstr "Soy Tanimura, un detective aquí en Kamurocho.\n"
"¿Qué haces aquí abajo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=2
#. y4:msg_location=T4.P2
#. y4:msg_speaker=Man in White
#. y4:msg_speaker_id=2
msgctxt "1288_Man in White"
msgid "My name is Dr. Minamida. And I'm not doing anything wrong at all!"
msgstr "Mi nombre es Dr. Minamida. ¡Y no estoy haciendo nada malo!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=3
#. y4:msg_location=T4.P3
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "1300_Tanimura"
msgid "If you're not doing anything wrong, then what's got you so flustered? And... what's this?"
msgstr "Si no estás haciendo nada malo, ¿por qué estás tan nervioso?\n"
"Y..., ¿qué es esa cosa?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=4
#. y4:msg_location=T4.P4
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1312_Minamida"
msgid "Ah, this here is the Inner Fighter VII Revolution! Or IF7-R, for short."
msgstr "Ah, ¡esto que está aquí es el Inner Fighter VII Revolution!\n"
"O el IF7-R, para abreviar."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=5
#. y4:msg_location=T4.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "1324_Tanimura"
msgid "The IF7-R?"
msgstr "¿El IF7-R?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=6
#. y4:msg_location=T4.P6
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1336_Minamida"
msgid "The IF7-R is the arcade machine of the future, and I invented it! Heheheh..."
msgstr "¡El IF7-R es la máquina de arcade del futuro, y la invente yo!\n"
"Je, je, je..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=7
#. y4:msg_location=T4.P7
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "1348_Tanimura"
msgid "An arcade machine? This doesn't really look like one, no matter which way you spin it. I think it's time you started telling the truth."
msgstr "¿Una máquina de arcade? No importa como lo mires, esto\n"
"no se parece a una. Creo que es hora de que empieces a\n"
"decir la verdad."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=8
#. y4:msg_location=T4.P8
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1360_Minamida"
msgid "I am! This is the greatest invention of the century!"
msgstr "¡Lo es! ¡Este es el mayor invento del siglo!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=9
#. y4:msg_location=T4.P9
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1372_Minamida"
msgid "The IF7-R provides <Italic>the</Italic> ultimate arcade experience. It allows realistic battles in a virtual world."
msgstr "El IF7-R proporciona la experiencia de arcade <Italic>definitiva</Italic>.\n"
"Con ella tendrás peleas realistas en un mundo virtual."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=10
#. y4:msg_location=T4.P10
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "1384_Tanimura"
msgid "Hm... Can't you think of a better lie than that?"
msgstr "Mm... ¿No podías pensar en una mentira mejor que esa?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=11
#. y4:msg_location=T4.P11
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1396_Minamida"
msgid "I told you it's not a lie! Try it for yourself. Then you'll see I'm telling you the truth."
msgstr "¡Te digo que no es una mentira! Pruébalo por ti mismo.\n"
"Entonces verás que estoy diciendo la verdad."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=12
#. y4:msg_location=T4.P12
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1408_Minamida"
msgid "One game is 10,000 yen. Sorry, no discounts."
msgstr "Una partida cuesta 10.000 yenes. Sin descuentos, lo siento."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=13
#. y4:msg_location=T4.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "1420_Tanimura"
msgid "That's a lot for a single game. Must be a pretty good business for you."
msgstr "Eso es muchísimo para una sola partida.\n"
"Debe ser un gran negocio para ti."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=14
#. y4:msg_location=T4.P14
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "1432_Tanimura"
msgid "But it does look like fun. I'll tell you what, I won't bother you if you let me play your game."
msgstr "Pero parece divertido. Veamos, si me dejas jugar\n"
"no te molestaré."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=15
#. y4:msg_location=T4.P15
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1444_Minamida"
msgid "Of course. Anyone can play anytime they want."
msgstr "Por supuesto, cualquiera puede jugar cuando quiera."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
