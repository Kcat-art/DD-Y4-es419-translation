#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Want me to go with you?
msgctxt "12084_松岡里緒奈：源氏名"
msgid "Really? You'd do that!? Thanks!"
msgstr "¿¡En serio!? ¿¡Harías eso!? ¡Gracias!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
