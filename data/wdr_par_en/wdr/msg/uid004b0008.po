#. y4:msg_location=T1.P5
#. y4:msg_speaker=Idol Blogger
#. y4:msg_speaker_id=0
msgctxt "144_Idol Blogger"
msgid "Ohmigosh, I posted on my old blog that I was starting a new one on Amoeblog! There was even a link! Did you even read the top post?"
msgstr "Ay dios mío, ¡pero si publiqué en mi antiguo blog que estaba empezando uno nuevo en Amoeblog! Incluso había un enlace. ¿Has leído por lo menos el primer post?"

#. y4:line_status=reviewed
#. y4:translated_by=Keiner
#. y4:reviewed_by=Keiner
