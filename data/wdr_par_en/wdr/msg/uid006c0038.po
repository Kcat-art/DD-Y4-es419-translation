#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=If I can make it.
msgctxt "12060_Kiryu"
msgid "Sorry. I'm not always free to play around whenever I want."
msgstr "Perdón. No siempre estoy con tiempo para jugar cuando quiero."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=20
#. y4:msg_location=T21.P20
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=If I can make it.
msgctxt "12072_望月京子：源氏名"
msgid "Play around!? It sounds like this doesn't mean a thing to you."
msgstr "¡¿Jugar?! Parece que no te importa..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=21
#. y4:msg_location=T21.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=If I can make it.
msgctxt "12084_Kiryu"
msgid "I didn't mean it like that. It's just that I'm a pretty busy guy..."
msgstr "No quería decirlo de esa manera. Solo que algunas veces estoy muy ocupado..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=22
#. y4:msg_location=T21.P22
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=If I can make it.
msgctxt "12096_望月京子：源氏名"
msgid "Sorry for interrupting your busy schedule! Don't worry about trying to make it!"
msgstr "¡Perdón por malgastar tu OCUPADO tiempo! ¡No te preocupes en ir!"

#. y4:msg_type=branch_dialogue
