#. y4:msg_decision_choices=1. Be Mild and Ignore Him -> T2.P1 | 2. BE SPICY and Lend a Hand -> T2.P2
msgctxt "780_Kiryu"
msgid "(That guy's really in a pinch...)"
msgstr "(Ese tipo está realmente en un aprieto...)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=1
#. y4:msg_location=T2.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Be Mild and Ignore Him
msgctxt "792_Kiryu"
msgid "(Eh, not my problem.)"
msgstr "(Eh, no es mi problema.)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=BE SPICY and Lend a Hand
msgctxt "804_Kiryu"
msgid "(I should probably bail him out. He did the same for me before, after all.)"
msgstr "(Probablemente debería rescatarlo. Él hizo lo mismo por mí antes, después de todo.)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=BE SPICY and Lend a Hand
msgctxt "816_Kiryu"
msgid "That's enough, you guys."
msgstr "Eso es suficiente, chicos."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=4
#. y4:msg_location=T2.P4
#. y4:msg_speaker=Macho Punk
#. y4:msg_speaker_id=9
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=BE SPICY and Lend a Hand
msgctxt "828_Macho Punk"
msgid "What's it to you, bitch? Keep your nose outta this!"
msgstr "¿Qué te importa, perra? ¡Mantén tu nariz fuera de esto!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=5
#. y4:msg_location=T2.P5
#. y4:msg_speaker=Purple-suited Punk
#. y4:msg_speaker_id=14
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=BE SPICY and Lend a Hand
msgctxt "840_Purple-suited Punk"
msgid "You this guy's sidekick or somethin'? Sure don't look it."
msgstr "¿Eres el compañero de este tipo o algo así? Porque no lo pareces."

#. y4:line_status=translated
msgctxt "852_Man in Tights"
msgid "Ah, the random man from before! I'm ashamed you have to\\r\nsee me like this, with my proverbial curry spilled hither which\\r\nway..."
