#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2880\t2924"
msgid "The hell was that?"
msgstr "¡¿Qué carajos fue eso?!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "2926\t3015"
msgid "Who's makin' that noise?"
msgstr "¡¿Quién está haciendo ruido?!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3057\t3110"
msgid "Hey, I was sleeping..."
msgstr "Oi, estaba durmiendo..."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3129\t3175"
msgid "What's going on in here!?"
msgstr "¡¿A qué viene todo este alboroto?!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3177\t3240"
msgid "Who's responsible for this?\\nCome forward, now!"
msgstr "¿Quién es responsable de esto?\\n¡Salga, ahora!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3505\t3565"
msgid "That's..."
msgstr "Ese es..."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "3579\t3639"
msgid "Saejima."
msgstr "Saejima."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "3657\t3728"
msgid "You better have a good reason for this, Saejima!"
msgstr "¡¿Qué significa esto, Saejima?!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4252\t4336"
msgid "How did you get out of your cell?"
msgstr "¿Cómo demonios saliste de tu celda?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4389\t4462"
msgid "You don't really think you can escape?"
msgstr "¿Acaso piensas fugarte?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4530\t4641"
msgid "You realize what happens\\nwhen you step out of line, yeah?"
msgstr "Sabes muy bien lo que va a\\npasar si haces esto, ¿no?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4733\t4823"
msgid "Hey! Lemme out, too!"
msgstr "¡Oi! ¡Sácame a mí también!"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4833\t4934"
msgid "No hole for you this time."
msgstr "El aislamiento no es suficiente para ti."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "4943\t5029"
msgid "We're gonna bash your brains in right here."
msgstr "No me dejas otra que matarte."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "5053\t5118"
msgid "Hope you're ready."
msgstr "Ninguna queja, ¿verdad?"

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "5174\t5278"
msgid "Okay, boys. Time to put this stray down."
msgstr "Bien. Entonces no nos vamos a contener."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "5286\t5388"
msgid "His execution date's come early."
msgstr "No dejen que este imbécil salga de la habitación."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "5642\t5702"
msgid "Do it!"
msgstr "¡A por él!"

