#. y4:msg_branch_raw=01 11 00 0b 00 00 00 11 00 00 00 00 00 00 00 00
msgctxt "13428_Akiyama"
msgid "I take big bites."
msgstr "Yo le doy mordidas grandes."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=12
#. y4:msg_location=T18.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13440_Rio"
msgid "Ooh, how manly!"
msgstr "¡Ohh, qué masculino!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=13
#. y4:msg_location=T18.P13
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13452_Rio"
msgid "But don't you get ice cream all around your mouth that way?"
msgstr "¿Pero no terminas con helado por toda la boca si lo comes de esa manera?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=14
#. y4:msg_location=T18.P14
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13464_Akiyama"
msgid "Yeah, but that's just the way it is. You can't really avoid it."
msgstr "Sí, pero así son las cosas. No se puede evitar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=15
#. y4:msg_location=T18.P15
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13476_Rio"
msgid "That's cute! I'd like to see you with ice cream on your face!"
msgstr "¡Eso es adorable! ¡Me gustaría verlo con helado en su cara!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=16
#. y4:msg_location=T18.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13488_Akiyama"
msgid "Cute? Me?"
msgstr "¿Adorable? ¿Yo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=17
#. y4:msg_location=T18.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13500_Rio"
msgid "I like it when men show their vulnerable side like that."
msgstr "Me gusta cuando los hombres muestran su lado vulnerable."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=33
#. y4:msg_location=T0.P33
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're a little different from the other girls.
msgctxt "13512_Akiyama"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=19
#. y4:msg_location=T18.P19
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13524_Rio"
msgid "Hehe! Yes! That innocent, childlike look is just adorable!"
msgstr "¡Je, je! ¡Sí! ¡Esa expresión inocente, como de niño, es simplemente encantadora!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=20
#. y4:msg_location=T18.P20
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13536_Rio"
msgid "Of course, I wouldn't want men to act like that all the time..."
msgstr "Por supuesto, no me gustaría que los hombres actuaran así todo el tiempo..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=21
#. y4:msg_location=T18.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13548_Akiyama"
msgid "Oh, yeah..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=22
#. y4:msg_location=T18.P22
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13560_Rio"
msgid "We should go out for ice cream sometime!"
msgstr "¡Deberíamos salir a comer helado algún día!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=23
#. y4:msg_location=T18.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13572_Akiyama"
msgid "Okay, but I don't much like the idea of you observing the way I eat."
msgstr "Está bien, pero no me gusta mucho la idea de que observes la forma en la que como."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=18
#. y4:msg_section_label=Conversación 18
#. y4:msg_talk=18
#. y4:msg_phrase=24
#. y4:msg_location=T18.P24
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I take big bites.
msgctxt "13584_Rio"
msgid "Okay! I won't watch you then."
msgstr "¡Está bien! Entonces no lo miraré."

#. y4:msg_type=branch_dialogue
