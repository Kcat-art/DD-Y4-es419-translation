msgstr "Los rumores dicen que este brazalete especial trae buena suerte."

#. y4:line_status=translated
#. y4:item_index=915
#. y4:item_id=carisma_ring
#. y4:item_icon=2d_yk_carisma_ring
#. y4:item_field=name
#. y4:item_pair_context=134390
