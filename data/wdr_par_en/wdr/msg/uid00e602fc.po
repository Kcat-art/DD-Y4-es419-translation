msgctxt "108_Street Punk"
msgid "Want us to leave? We're gonna need a going-away present."
msgstr "¿Quieres que nos vayamos? Nos vendría bien un regalo de despedida."

msgctxt "120_Saejima"
msgid "Shut the fuck up! My fist in your face is all\\r\n"
"you freeloaders deserve!"
msgstr "¡Cierra la puta boca! ¡Hacerte comer mis puños es lo\n"
"único que unos parásitos como ustedes merecen!"
