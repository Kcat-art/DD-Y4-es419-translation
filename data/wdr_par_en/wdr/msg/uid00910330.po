#. y4:msg_speaker_id=15
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Break Things Up
msgctxt "992_Kiryu"
msgid "Hey, Kotaro. What's all this about?"
msgstr "Hola, Kotaro. ¿Qué está pasando aquí?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=7
#. y4:msg_location=T2.P7
#. y4:msg_speaker=Kotaro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Break Things Up
msgctxt "1004_Kotaro"
msgid "Kiryu-san! I'm, uh, just a little busy right now. Can it wait?"
msgstr "Kiryu! Estoy, eh, un poco ocupado ahora. ¿Es urgente?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=8
#. y4:msg_location=T2.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=15
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Break Things Up
msgctxt "1016_Kiryu"
msgid "What do you mean, busy? Aren't these guys your customers?"
msgstr "¿Cómo que urgente? ¿Estos no son clientes tuyos?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=9
#. y4:msg_location=T2.P9
#. y4:msg_speaker=Street Punk
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Break Things Up
msgctxt "1028_Street Punk"
msgid "Yeah, we <Italic>are</Italic> customers! You responsible for this kid? Where'd he learn his manners!?"
msgstr "¡Sí, somos <Italic>clientes</Italic>! ¿Estás a cargo \\r de éste? ¿¡De dónde saca esos modales!?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=2
#. y4:msg_phrase=10
#. y4:msg_location=T2.P10
