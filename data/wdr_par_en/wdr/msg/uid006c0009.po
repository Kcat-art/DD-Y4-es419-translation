#. y4:msg_branch_target=T1.P6
#. y4:msg_branch_segment=T1.P6..P13
#. y4:msg_branch_target_text=I have to agree with her. Someone hanging around you all the time can be tiring.
#. y4:msg_branch_raw=01 11 00 06 00 00 00 19 00 00 00 00 00 00 00 00
msgctxt "17544_Kiryu"
msgid "I have to agree with her."
msgstr "Estoy de acuerdo con ella."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=125
#. y4:msg_phrase=0
#. y4:msg_location=T125.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T1.P14
#. y4:msg_branch_segment=T1.P14..P20
#. y4:msg_branch_target_text=There's nothing wrong with being devoted. A man would be lucky to have such a woman.
#. y4:msg_branch_raw=01 11 00 0e 00 00 00 29 00 00 00 00 00 00 00 00
msgctxt "17556_Kiryu"
msgid "There's nothing wrong with being devoted."
msgstr "No hay nada de malo en que seas comprometida."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
