#. y4:msg_branch_target=T2.P24
#. y4:msg_branch_segment=T2.P24..P30
#. y4:msg_branch_target_text=You could try to wear less flashy clothes. You do sort of stand out.
#. y4:msg_branch_raw=01 11 00 18 00 00 00 2a 00 00 00 00 00 00 00 00
msgctxt "17604_Kiryu"
msgid "You could try to wear less flashy clothes."
msgstr "Deberías usar ropa menos llamativa."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=130
#. y4:msg_phrase=0
#. y4:msg_location=T130.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T3.P5
#. y4:msg_branch_segment=T3.P5..P10
#. y4:msg_branch_target_text=They're fooling themselves. They think they're being cool.
#. y4:msg_branch_raw=01 11 00 05 00 00 00 1b 00 00 00 00 00 00 00 00
msgctxt "17616_Kiryu"
msgid "They're fooling themselves."
msgstr "Se están engañando ellos mismo."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=131
#. y4:msg_phrase=0
#. y4:msg_location=T131.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T3.P11
#. y4:msg_branch_segment=T3.P11..P15
#. y4:msg_branch_target_text=Young guys don't know what manners are. If you don't know someone, you should make an effort to be polite.
#. y4:msg_branch_raw=01 11 00 0b 00 00 00 27 00 00 00 00 00 00 00 00
msgctxt "17628_Kiryu"
msgid "Young guys don't know what manners are."
msgstr "Los jóvenes no conocen los modales."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=132
#. y4:msg_phrase=0
#. y4:msg_location=T132.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T3.P16
#. y4:msg_branch_segment=T3.P16..P22
#. y4:msg_branch_target_text=There's nothing you can do about it. Young guys don't have any accomplishments yet, so they try to make themselves look good.
#. y4:msg_branch_raw=01 11 00 10 00 00 00 24 00 00 00 00 00 00 00 00
msgctxt "17640_Kiryu"
msgid "There's nothing you can do about it."
msgstr "No hay nada que puedas hacer al respecto."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=133
#. y4:msg_phrase=0
#. y4:msg_location=T133.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T4.P6
#. y4:msg_branch_segment=T4.P6..P13
#. y4:msg_branch_target_text=You really want to know why men cheat?
#. y4:msg_branch_raw=01 11 00 06 00 00 00 26 00 00 00 00 00 00 00 00
msgctxt "17652_Kiryu"
msgid "You really want to know why men cheat?"
msgstr "¿En serio quieres saber por qué los hombres engañan?"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=134
#. y4:msg_phrase=0
#. y4:msg_location=T134.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T4.P14
#. y4:msg_branch_segment=T4.P14..P21
#. y4:msg_branch_target_text=I don't know, but your friend's relationship isn't healthy. She should leave him.
#. y4:msg_branch_raw=01 11 00 0e 00 00 00 15 00 00 00 00 00 00 00 00
msgctxt "17664_Kiryu"
msgid "She should leave him."
msgstr "Ella debería de dejarlo definitivamente."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
#. y4:msg_talk=135
#. y4:msg_phrase=0
#. y4:msg_location=T135.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T4.P22
#. y4:msg_branch_segment=T4.P22..P27
#. y4:msg_branch_target_text=It shows that he's a real man. Your friend should be proud that her man can get that many girls.
#. y4:msg_branch_raw=01 11 00 16 00 00 00 1e 00 00 00 00 00 00 00 00
msgctxt "17676_Kiryu"
msgid "It shows that he's a real man."
msgstr "Él solo está demostrando su hombría."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=136
#. y4:msg_phrase=0
