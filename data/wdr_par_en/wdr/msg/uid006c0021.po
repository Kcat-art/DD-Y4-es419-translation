#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=He picked you up, just like that!?
msgctxt "4848_Erena"
msgid "Oh, just that we're goin' out."
msgstr "Oh, solo que vamos a salir."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
