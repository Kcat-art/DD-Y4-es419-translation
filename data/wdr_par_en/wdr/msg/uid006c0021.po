#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you sure you didn't love him?
msgctxt "12408_Erena"
msgid "I'm not sure if breakin' up was the right thing to do."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=16
#. y4:msg_location=T21.P16
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you sure you didn't love him?
msgctxt "12420_Akiyama"
msgid "This isn't something that you can know the answer to right away. You have to let some time pass to be able to look at things objectively."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
