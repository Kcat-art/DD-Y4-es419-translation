#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I'd like to be a lion.
msgctxt "6528_Kiryu"
msgid "It's not like I'm really going to do it..."
msgstr ""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
