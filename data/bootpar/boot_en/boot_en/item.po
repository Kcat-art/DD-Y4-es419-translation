msgstr "Basura cilíndrica. No estoy seguro de que es."

#. y4:line_status=translated
msgctxt "24022"
msgid "Boxy Garbage"
msgstr "Basura cuadrada"

#. y4:line_status=translated
msgctxt "102788"
msgid "Boxy garbage. Not sure what it is."
msgstr "Basura cuadrada. Ni idea de lo que es."

#. y4:line_status=translated
msgctxt "24035"
