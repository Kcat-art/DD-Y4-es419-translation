#. y4:msg_choice_index=1
#. y4:msg_branch_choice=There's a lot of money in it.
msgctxt "200_Subdued Woman"
msgid "I'm not interested in the sex industry! Get lost!"
msgstr "¡No me interesa trabajar en cosas sexuales! ¡Adiós!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=There's a lot of money in it.
msgctxt "212_Akiyama"
msgid "(Yikes. Blew that one...)"
msgstr "(Caray, mis palabras no fueron las correctas...)."

#. y4:line_status=translated
msgctxt "260_Akiyama"
msgid "Haven't you heard? Working as a hostess is a dream job for\\r\nyoung women these days. In fact, hostess club fashion mags\\r\nare all the rage."
msgstr "Trabajar en un club de hostess es el sueño de muchas\\r\nmujeres jóvenes y hermosas, hoy en día estos clubes están\\r\nde moda a tal punto de salir en revistas."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=12
#. y4:msg_location=T1.P12
#. y4:msg_speaker=Subdued Woman
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=This just might be your dream job.
msgctxt "272_Subdued Woman"
msgid "Huh? Really?"
msgstr "¿Eh? ¿De verdad?"

#. y4:line_status=translated
msgctxt "284_Akiyama"
msgid "Really. Are you sure a cute girl like you wouldn't be\\r\ninterested?"
msgstr "Por ejemplo, una mujer joven y linda como usted, nos vendría bien.\\r\n¿Le interesa?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Subdued Woman
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=This just might be your dream job.
msgctxt "296_Subdued Woman"
msgid "Me, cute? Gosh..."
msgstr "¿Yo? ¿Linda? Oh, vaya..."

#. y4:line_status=translated
msgctxt "308_Akiyama"
msgid "It's true! Sure, there's plenty of cute girls around here,\\r\nbut they're not the ones who caught my eye."
msgstr "¡Lo digo en serio! Hay miles de mujeres en estas zonas, pero\\r\nnadie me llamó la atención tanto como usted."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=16
#. y4:msg_location=T1.P16
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=This just might be your dream job.
msgctxt "320_Akiyama"
msgid "Be pretty great to make yourself even more fabulous, no?"
msgstr "Ser linda también le beneficia para volverse popular, ¿sabe?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
