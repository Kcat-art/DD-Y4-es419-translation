#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Why don't you look for a boyfriend?
msgctxt "4968_松岡里緒奈：源氏名"
msgid "Hehe! That could work."
msgstr "¡Jeje! Eso podría funcionar."

#. y4:msg_type=choice
