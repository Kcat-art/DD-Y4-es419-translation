msgctxt "195\t254"
msgid "Thank god."
msgstr "Qué alivio."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "255\t347"
msgid "I was half expectin' ya to be all flab."
msgstr "Pensé que te vería todo flacucho."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "361\t478"
msgid "Wouldn't have survived all these years\\nwithout a way to fight back."
msgstr "25 años en prisión,\\nentrenando todos los días."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "483\t582"
msgid "You're the one livin' it easy."
msgstr "A diferencia de ti, que has tenido una vida fácil."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "589\t741"
msgid "Then I guess I don't gotta pull any punches."
msgstr "Entonces supongo que no necesito tomármelo con calma."

#. y4:line_status=reviewed
#. y4:reviewed_by=Karu
msgctxt "750\t818"
msgid "Least we agree on that."
msgstr "Tómalo como quieras."

#. y4:line_status=reviewed
#. y4:translated_by=Karu
#. y4:reviewed_by=Karu
msgctxt "823\t904"
msgid "Let's do this, brother!"
msgstr "¡Ahí voy, kyoudai!"

