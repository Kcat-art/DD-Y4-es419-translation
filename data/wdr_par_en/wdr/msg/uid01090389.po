msgctxt "92_Kiryu"
msgid "Takashi? It's Kiryu."
msgstr "¿Takashi? Soy Kiryu."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=3
msgctxt "104_Takashi"
msgid "Oh, Kiryu-san. Did you hear anything?"
msgstr "Oh, Kiryu-san. ¿Averiguaste algo?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "116_Kiryu"
msgid "I did, actually. The Florist gave me the details on your father."
msgstr "De hecho sí. El Florista me ha hablado de tu padre."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=3
msgctxt "128_Takashi"
msgid "He did!?"
msgstr "¡¿De verdad?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "140_Kiryu"
msgid "Yeah. Are you free?"
msgstr "Sí. Será mejor que nos veamos en persona."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=3
msgctxt "152_Takashi"
msgid "Of course! I'll wait for you out front of the Millennium Tower!"
msgstr "¡Por supuesto! ¡Le esperaré delante de la Torre Millenium!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "164_Kiryu"
msgid "Got it. See you soon."
msgstr "Entendido. Nos vemos pronto."
