msgid "......"
msgstr "......"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=3
msgctxt "128_Shizuka"
msgid "Maybe I can finally wash your back when I'm done with my studies."
msgstr "Tal vez finalmente pueda lavarte la espalda cuando termine con mis estudios."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "140_Kiryu"
msgid "All right. I'll be waiting for you to return from America."
msgstr "De acuerdo. Estaré esperando a que vuelvas de América."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Shizuka
#. y4:msg_speaker_id=3
msgctxt "152_Shizuka"
msgid "Thank you! Um... Could I get one more hug before I go?"
msgstr "¡Gracias! Um... ¿Podría darme un abrazo más antes de irme?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=9
#. y4:msg_location=T0.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
