#. y4:msg_branch_choice=Sure.
msgctxt "304_Akiyama"
msgid "A duet, huh? Sure, why not? How about \"Pure Love in Kamurocho\"?"
msgstr "¿Un dúo? Interesante.\n"
"¿Qué tal \"Pure Love in Kamurocho\"?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
