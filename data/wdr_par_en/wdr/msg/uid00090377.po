#. y4:msg_speaker_id=0
msgctxt "188_Kiryu"
msgid "So. You're looking for the Florist, right?"
msgstr "Está buscando al Florista, ¿verdad?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "200_Takashi"
msgid "Kiryu-san!"
msgstr "¡Kiryu-san!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
msgctxt "212_Takashi"
msgid "That's right. I've got a favor I wanna ask him."
msgstr "Sí, quiero pedirle un favor."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "224_Kiryu"
msgid "Hm. I know where to find him, but..."
msgstr "Mmm. Sé dónde encontrarlo, pero..."

#. y4:line_status=translated
msgctxt "236_Takashi"
msgid "If you know, then you have to tell me! Please, it's really\\r\nimportant!"
msgstr "¡Si lo sabe, tiene que decírmelo! ¡Por favor, es muy\\r \nimportante!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Turn Him Down
msgctxt "260_Kiryu"
msgid "Sorry, I can't tell you."
msgstr "Lo siento, no puedo decírtelo."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Turn Him Down
msgctxt "272_Takashi"
msgid "Huh? But..."
msgstr "¿Eh? Pero..."

#. y4:line_status=translated
msgctxt "284_Takashi"
msgid "No, I understand. Sorry for putting you in that position,\\r\nKiryu-san."
msgstr "No, lo entiendo. Perdón por ponerle en esa tesitura,\\r \nKiryu-san."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Take Him to the Florist
msgctxt "296_Kiryu"
msgid "All right, I'll take you to him."
msgstr "Está bien, te llevaré con él."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Takashi
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Take Him to the Florist
msgctxt "308_Takashi"
msgid "You will!? Thanks a ton, Kiryu-san!"
msgstr "¡¿En serio?! ¡Muchas gracias, Kiryu-san!"

#. y4:line_status=translated
