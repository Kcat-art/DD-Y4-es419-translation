#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should go for a more feminine look.
msgctxt "10644_松岡里緒奈：源氏名"
msgid "Hmm, you think so?"
msgstr "Hmm, ¿eso crees?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=17
#. y4:msg_section_label=Conversación 17
#. y4:msg_talk=17
