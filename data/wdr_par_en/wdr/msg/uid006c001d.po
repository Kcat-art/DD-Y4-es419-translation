#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Hot springs are nice, aren't they?
msgctxt "7668_Rio"
msgid "I wonder where I should go next."
msgstr "Me pregunto dónde debería ir ahora."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=30
