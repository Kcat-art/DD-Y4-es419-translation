#. y4:line_status=translated
msgctxt "280"
msgid "Quit"
msgstr "Salir"

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "285"
msgid "Cancel the order."
msgstr "Cancelar el pedido."

#. y4:line_status=translated
msgctxt "303"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=translated
msgctxt "309"
msgid "Order the currently selected item.  "
msgstr "Pedir el objeto actualmente seleccionado.  "

#. y4:line_status=translated
msgctxt "346"
msgid "(I haven't picked anything.)  "
msgstr "(No he escogido nada)"

#. y4:line_status=reviewed
#. y4:translated_by=dani64amv
#. y4:reviewed_by=dani64amv
msgctxt "377"
msgid "(I'm short on cash.)  "
msgstr "(Me hace falta dinero)."

#. y4:line_status=translated
msgctxt "400"
msgid "Thanks. That'll be %s."
msgstr "Gracias, eso serían %s."

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "423"
msgid "(I can't carry any more stuff.)"
msgstr "(No puedo llevar más cosas)."

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "455"
msgid "(They're sold out.)"
msgstr "(Están agotados)."

#. y4:line_status=translated
msgctxt "475"
msgid "This is a plate made of platinum. Pretty rare and \nworth a lot."
msgstr "Este es un plato hecho de platino. Bastante raro y \ncostoso."

#. y4:line_status=translated
msgctxt "539"
msgid "This plate is made of gold. It's worth its weight in... \nWell, it's made of gold. Need I say more?"
msgstr "Este plato está hecho de oro. Lo vale por su peso en... \nBueno, está hecho de oro. ¿Hace falta decir más?"

#. y4:line_status=translated
msgctxt "638"
msgid "This plate is made of silver. Only worth a fraction of a\ngold plate, but valuable nonetheless."
msgstr "Este plato está hecho de plata. Solo vale una fracción de un \nplato de oro, pero nada valioso."

#. y4:line_status=translated
msgctxt "733"
msgid "A plate made of bronze. Nothing special, but it could\nprobably fetch some decent cash."
msgstr "Un plato hecho de bronce. Nada especial, pero\nprobablemente podría valer algo de dinero."

#. y4:line_status=translated
msgctxt "820"
msgid "This plate is made of iron. Might be more useful for \nbeating someone over the head, but it's still worth a\nfistful of yen."
msgstr "Este plato está hecho de hierro. Podría ser más útil para\ngolpear a alguien en la cabeza, pero aun así vale un\npuñado de yenes."

