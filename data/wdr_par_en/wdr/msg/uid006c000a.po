#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What sort of actress do you want to be?
msgctxt "4320_Tanimura"
msgid "You're welcome."
msgstr "No es nada."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=What sort of actress do you want to be?
msgctxt "4332_Chihiro"
msgid "I'll do my best. You just wait and see!"
msgstr "Daré lo mejor de mí. ¡Solo espera y verás!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=22
