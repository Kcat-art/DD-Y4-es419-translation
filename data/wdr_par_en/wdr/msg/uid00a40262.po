#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You looked like you needed money.
msgctxt "176_Akiyama"
msgid "Sorry! I was just kidding..."
msgstr "¡Uy, perdona! ¡Estaba jugando!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Girl du Jour
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You looked like you needed money.
msgctxt "188_Girl du Jour"
msgid "Hmph! Leave me alone!"
msgstr "¡Ugh! ¡Déjame en paz!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You looked like you needed money.
msgctxt "200_Akiyama"
msgid "Sorry..."
msgstr "Lo siento..."

msgctxt "248_Akiyama"
msgid "Because you're cute! Got to be cute if you want to be a\\r\n"
"hostess."
msgstr "¡Porque eres un encanto! Eres perfecta para\\r\n"
"ser hostess."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Girl du Jour
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You're cute.
msgctxt "260_Girl du Jour"
msgid "Oh, uh, I see..."
msgstr "Oh, um, ya veo..."

msgctxt "272_Akiyama"
msgid "That's right! So what do you think? It's not easy work, but\\r\n"
"it's good work if you give it your all."
msgstr "¿Qué opina? No es un trabajo que se tome a la ligera,\\r\n"
"¡pero es perfecto si se esfuerza al máximo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Girl du Jour
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You're cute.
msgctxt "284_Girl du Jour"
msgid "Hmm... Could you maybe tell me more?"
msgstr "Oh... ¿Le importaría contarme más al respecto?"

msgctxt "296_Akiyama"
msgid "Of course! Just leave me your cell number, and I'll be in\\r\n"
"touch."
msgstr "No hay problema! Solo deme su número de teléfono y\\r\n"
"me pondré en contacto con usted."

#. y4:msg_type=branch_dialogue
