#. y4:msg_location=T0.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=So what do you think now that you're doing it?
msgctxt "4224_Akiyama"
msgid "Yeah."
msgstr "Sí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What about it interested you?
msgctxt "4236_Akiyama"
msgid "So what about being a hostess interested you?"
msgstr "¿Qué fue lo que te llamó la atención de trabajar como hostess?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What about it interested you?
msgctxt "4248_Rio"
msgid "Well, I didn't really know what goes on inside a hostess club at first."
msgstr "Bueno, al principio no sabía muy bien como funcionaban las cosas dentro de los clubes."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What about it interested you?
msgctxt "4260_Rio"
msgid "But it's a pretty popular job for girls right now, so I wondered what sort of world a hostess club might be."
msgstr "Pero como actualmente es un empleo bastante popular entre las chicas, sentí que era el momento para entrar al sector."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=26
#. y4:msg_location=T0.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What about it interested you?
msgctxt "4272_Akiyama"
msgid "It sounds like you're the adventurous type."
msgstr "Da la impresión de que te gustan las aventuras."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=27
#. y4:msg_location=T0.P27
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What about it interested you?
msgctxt "4284_Rio"
msgid "I am, and I'm loving it here!"
msgstr "¡Así es, y me encanta estar aquí!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=28
#. y4:msg_location=T0.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What about it interested you?
msgctxt "4296_Akiyama"
msgid "Heh. Well, it's good you like being adventurous. Just don't get mixed up with the wrong kind of people."
msgstr "Heh. Bueno, está bien que te guste ser aventurera. Siempre y cuando evites mezclarte con la gente equivocada."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=29
#. y4:msg_location=T0.P29
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What about it interested you?
msgctxt "4308_Rio"
msgid "Hah, don't worry, I won't!"
msgstr "¡Jaja, tranquilo, no lo haré!"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=0
