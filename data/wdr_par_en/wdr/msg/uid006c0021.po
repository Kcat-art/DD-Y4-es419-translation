#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's with young girls these days?
msgctxt "4908_Erena"
msgid "Hahah! You're not that old yourself."
msgstr "¡Ja, ja, ja! Tampoco es que seas tan viejo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=28
#. y4:msg_location=T1.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's with young girls these days?
msgctxt "4920_Akiyama"
msgid "Hey, I've got one foot in the grave! Well, maybe not in the grave, but I'm within walking distance of the cemetery!"
msgstr "Ya tengo medio pie en la tumba, bueno, puede que en la tumba no cómo tal, pero sí llegando al cementerio."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
