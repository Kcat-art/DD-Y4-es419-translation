msgid "Tanimura"
msgstr "Tanimura"

#. y4:line_status=translated
msgctxt "120_Chihiro"
msgid "Here goes!\\r\nNow you get to hear the results of my voice training! <Color:7>♥<Color:Default>"
msgstr "¡Ahora sí!\\r\n¡Tendrá que escuchar los resultados de mis clases de canto! <Color:7>♥<Color:Default>"

#. y4:line_status=translated
msgctxt "132_Chihiro"
msgid "Hmm, what should I sing?\\r\nHow about \"Get to the Top\"? <Color:7>♥<Color:Default>"
msgstr "Mmm, ¿qué debería cantar?\\r\n¡Ah! ¿Qué tal si canto: \"Get to the Top\"? <Color:7>♥<Color:Default>"

#. y4:line_status=translated
msgctxt "144_Chihiro"
msgid "Hehe, thanks!"
msgstr "Je, je, ¡gracias!"

#. y4:line_status=translated
msgctxt "156_Chihiro"
msgid "You made it really hard to sing..."
msgstr "Hiciste que cantar se me hiciera mucho más difícil..."

#. y4:line_status=translated
msgctxt "168_Tanimura"
msgid "Sorry."
msgstr "Lo siento."

#. y4:line_status=translated
msgctxt "180_Chihiro"
msgid "That felt SO good! <Color:7>♥<Color:Default>\\r\nAnd it's all thanks to you cheering me on! <Color:7>♥<Color:Default>"
msgstr "¡Eso estuvo BUENÍSIMO! <Color:7>♥<Color:Default>\\r\n¡Y todo gracias a que usted estaba animándome! <Color:7>♥<Color:Default>"

