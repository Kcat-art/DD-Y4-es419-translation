#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are there other foods you can't eat?
msgctxt "12228_Akiyama"
msgid "All right then."
msgstr "Muy bien."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
#. y4:msg_talk=15
#. y4:msg_phrase=31
#. y4:msg_location=T15.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Are there other foods you can't eat?
msgctxt "12240_Rio"
msgid "Hehe. Well, thanks for worrying about me."
msgstr "Je, je. Bueno, gracias por preocuparse por mí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=16
#. y4:msg_section_label=Conversación 16
#. y4:msg_talk=16
