#. y4:msg_phrase=40
#. y4:msg_location=T0.P40
#. y4:msg_speaker=Konatsu
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "788_Konatsu"
msgid "......"
msgstr "......"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=41
#. y4:msg_location=T0.P41
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "800_Yusuke"
msgid "What do you do for work, Konatsu-chan?"
msgstr "¿En dónde trabajas, Konatsu-chan?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=42
#. y4:msg_location=T0.P42
#. y4:msg_speaker=Konatsu
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "812_Konatsu"
msgid "Huh? Oh, um. I work part-time at a bookstore. Yeah..."
msgstr "¿Yo? Oh, um. Trabajo a medio tiempo en una librería. Sí, en eso..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=43
#. y4:msg_location=T0.P43
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "824_Naoya"
msgid "Oh snap, you're a part-timer!? That's pretty much what I am!"
msgstr "¡Oh, vaya! ¿Eres una trabajadora a medio tiempo? ¡Eso es prácticamente lo que soy!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=44
#. y4:msg_location=T0.P44
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "836_Yusuke"
msgid "Yeah, a part-time worker and a full-time flake! Sorry about this guy, Konatsu-chan. He kinda... gets carried away sometimes."
msgstr "Sí, ¡un trabajador a medio tiempo y un holgazán a tiempo completo! Lo siento por este tipo, Konatsu-chan. A veces... se deja llevar."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=45
#. y4:msg_location=T0.P45
#. y4:msg_speaker=Konatsu
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "848_Konatsu"
msgid "Oh, that's... no problem..."
msgstr "Oh, eso... no es un problema..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=46
#. y4:msg_location=T0.P46
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "860_Akino"
msgid "Well, all right! Now that we got that taken care of, let's get some food! Who's hungry!?"
msgstr "¡Bueno, está bien! Ahora que hemos resuelto eso, ¡vamos a comer! ¡¿Quién tiene hambre?!"

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=0
#. y4:msg_phrase=47
#. y4:msg_location=T0.P47
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_decision_group=1
#. y4:msg_decision_choices=1. I like pan-fried gyoza. -> T0.P48 | 2. I'll leave it up to Yusuke. -> T0.P53
msgctxt "872_Akino"
msgid "Anything you'd recommend, Ryota-kun?"
msgstr "¿Algo que recomiendes, Ryota-kun?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=48
#. y4:msg_location=T0.P48
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "884_Tanimura"
msgid "How about some gyoza? Can't go wrong with those, y'know?"
msgstr "¿Qué tal unas gyozas? No se puede fallar con eso, ¿sabes?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=49
#. y4:msg_location=T0.P49
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "896_Akino"
msgid "Wow, are you psychic or something? I <Italic>love</Italic> gyoza! Looks like we're two of a kind already!"
msgstr "¡Vaya! ¿Eres psíquico o algo así? ¡Me <Italic>encantan</Italic> las gyozas! ¡Parece que ya somos dos de la misma clase!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=50
#. y4:msg_location=T0.P50
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "908_Yusuke"
msgid "Hey, I like gyoza too! That must mean we're... uh... three of a kind? Ahahaha..."
msgstr "¡Ey, a mí también me gustan las gyozas! Eso debe significar que somos... uh... ¿Un trío del mismo palo? Ja, ja, ja, ja..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=51
#. y4:msg_location=T0.P51
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "920_Yusuke"
msgid "(Hey, Tanimura-san... You do remember today's objective, don't you?)"
msgstr "(Oye, Tanimura-san... ¿Recuerdas el objetivo de hoy, verdad?)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=52
#. y4:msg_location=T0.P52
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "932_Tanimura"
msgid "Water is fine for now."
msgstr "El agua está bien por ahora."

#. y4:line_status=translated
msgctxt "944_Tanimura"
msgid "You know, I'm so indecisive at times like these...\\r\nYusuke, why don't you pick something for us?"
msgstr "Sabes, soy tan indeciso en momentos como este... Yusuke, ¿por qué no eliges\\r\nalgo para nosotros?"

#. y4:line_status=translated
msgctxt "956_Yusuke"
msgid "Right... How about something filling and mouthwatering...\\r\nOh, I know! We should get some pan-fried gyoza!"
msgstr "Correcto... ¿Qué tal algo abundante y delicioso...? Oh, ¡ya sé!\\r\n¡Deberíamos conseguir unas gyozas fritos!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=55
#. y4:msg_location=T0.P55
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "968_Akino"
msgid "Ooh, great choice, Yusuke! Aside from the garlicky smell, I could eat those all day!"
msgstr "¡Oh, gran elección, Yusuke! Aparte del olor a ajo, ¡podría comer eso todo el día!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=56
#. y4:msg_location=T0.P56
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "980_Yusuke"
msgid "(Thanks for the assist, Tanimura-san!)"
msgstr "(¡Gracias por la asistencia, Tanimura-san!)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=63
#. y4:msg_location=T0.P63
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1064_Naoya"
msgid "So the other day Yusuke was at work, and this girl totally asks him out!"
msgstr "Así que el otro día, Yusuke estaba en el trabajo, ¡y esta chica le pide salir!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=64
#. y4:msg_location=T0.P64
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1076_Yusuke"
msgid "Shut up, Naoya! We don't have to talk about that here!"
msgstr "¡Cállate, Naoya! ¡No tenemos que hablar de eso aquí!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=65
#. y4:msg_location=T0.P65
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1088_Akino"
msgid "Why not? I wanna hear more!"
msgstr "¿Por qué no? ¡Quiero escuchar más!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=66
#. y4:msg_location=T0.P66
#. y4:msg_speaker=Haruko
#. y4:msg_speaker_id=10
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1100_Haruko"
msgid "Yeah! You can't just end a story before it gets to the juicy stuff!"
msgstr "¡Sí! ¡No puedes simplemente terminar una historia antes de llegar a lo interesante!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=67
#. y4:msg_location=T0.P67
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1112_Naoya"
msgid "Apparently, this girl was real old-school about it. She left a love letter in his desk!"
msgstr "Aparentemente, esta chica fue muy a la antigua. ¡Dejó una carta de amor en su escritorio!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=68
#. y4:msg_location=T0.P68
#. y4:msg_speaker=Haruko
#. y4:msg_speaker_id=10
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1124_Haruko"
msgid "Aww, that is pretty old-fashioned! Nobody does that kind of thing anymore... except maybe Konatsu."
msgstr "¡Aww, eso es bastante anticuado! Nadie hace ese tipo de cosas ya... excepto tal vez Konatsu."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=69
#. y4:msg_location=T0.P69
#. y4:msg_speaker=Konatsu
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1136_Konatsu"
msgid "Hey, Haruko-chan!"
msgstr "¡Ey, Haruko-chan!"

#. y4:line_status=translated
msgctxt "1148_Haruko"
msgid "Come on, there's nothing wrong with that! Last time I\\r\nchecked, a girl's allowed to confess her love shyly, right?\\r\nAnyway, what'd you do after you got the letter, Yusuke-kun?"
msgstr "Vamos, ¡no hay nada de malo en eso! La última vez que revisé, ¡una chica puede\\r\nconfesar su amor tímidamente, verdad? De todos modos, ¿qué hiciste después\\r\nde recibir la carta, Yusuke-kun?"

#. y4:line_status=translated
msgctxt "1160_Naoya"
msgid "Well, here's the part where Yusuke highlights just how much\\r\nof a gentleman he really is: he decided to handwrite her a\\r\nletter back! And boy, did he keep messing up..."
msgstr "Bueno, aquí es donde Yusuke destaca cuán caballero es realmente:\\r\ndecidió escribirle una carta a mano.\\r\n¡Y vaya, que seguía equivocándose!"

#. y4:line_status=translated
msgctxt "1172_Naoya"
msgid "He even made me go buy more paper for him! And he works at a\\r\nprinting company, people! There should be loads of it there!"
msgstr "¡Incluso me hizo ir a comprar más papel para él! ¡Y él trabaja en una empresa de\\r\nimpresión, gente! ¡Debería haber montones de eso ahí!"

#. y4:line_status=translated
msgctxt "1184_Haruko"
msgid "Amazing! So what did he write back? Let me guess... It was a\\r\nrejection letter, right?"
msgstr "¡Increíble! ¿Entonces él escribió de vuelta? Déjame adivinar... Fue una carta\\r\nde rechazo, ¿verdad?"

#. y4:line_status=translated
msgctxt "1196_Naoya"
msgid "Okay, so this is where it gets good. I thought he'd just put\\r\nsomething simple like \"Nope, not interested,\" but he went\\r\nand said, \"I'm sorry, but I'm currently into someone else.\""
msgstr "Está bien, aquí es donde se pone bueno. Pensé que solo pondría algo simple\\r\ncomo \"Nop, no estoy interesado\", pero dijo \"Lo siento, pero actualmente\\r\nme interesa otra persona\"."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=75
#. y4:msg_location=T0.P75
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1208_Akino"
msgid "Wow, he went through all that trouble."
msgstr "Vaya, se tomó todo ese trabajo."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=76
#. y4:msg_location=T0.P76
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1220_Yusuke"
msgid "Enough about this! Let's change the subject! New topic, please!"
msgstr "¡Suficiente sobre esto! ¡Cambiemos de tema! ¡Nuevo tema, por favor!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=77
#. y4:msg_location=T0.P77
#. y4:msg_speaker=Konatsu
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1232_Konatsu"
msgid "Um, you know..."
msgstr "Um, sabes..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=78
#. y4:msg_location=T0.P78
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1244_Yusuke"
msgid "Hm?"
msgstr "¿Mm?"

#. y4:line_status=translated
msgctxt "1256_Konatsu"
msgid "I think that was a wonderful thing to do, Yusuke-san,\\r\nclearing things up for her like that. I'm sure she\\r\nunderstands your feelings... You're quite sincere."
msgstr "Creo que fue una cosa maravillosa de hacer, Yusuke-san, aclarar las cosas para\\r\nella así. Estoy segura de que entiende tus sentimientos...\\r\nEres bastante sincero."

#. y4:line_status=translated
msgctxt "1268_Yusuke"
msgid "Oh... Thanks... I honestly didn't think much of it at the\\r\ntime, but I appreciate the compliment all the same.\\r\nAhahaha..."
msgstr "Oh... Gracias... Honestamente, no pensé mucho en eso en ese momento,\\r\npero aprecio el cumplido de todos modos.\\r\nJa, ja, ja, ja..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=81
#. y4:msg_location=T0.P81
#. y4:msg_speaker=Konatsu
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1280_Konatsu"
msgid "I meant it."
msgstr "Lo digo en serio."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=82
#. y4:msg_location=T0.P82
#. y4:msg_speaker=Haruko
#. y4:msg_speaker_id=10
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1292_Haruko"
msgid "Ooh, Konatsu! Are you into Yusuke-kun?"
msgstr "¡Oh, Konatsu! ¿Te gusta Yusuke-kun?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=83
#. y4:msg_location=T0.P83
#. y4:msg_speaker=Konatsu
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1304_Konatsu"
msgid "No! Well, I mean, I'm not saying I <Italic>don't</Italic> like him... Ugh, dammit, Haruko!"
msgstr "¡No! Bueno, no estoy diciendo que <Italic>no</Italic> me guste... ¡Ugh, maldita sea, Haruko!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=84
#. y4:msg_location=T0.P84
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1316_Akino"
msgid "Come on, Haruko! Don't put her on the spot like that! Go easy on the girl."
msgstr "Vamos, Haruko. ¡No la pongas en una situación así! Sé más cuidadosa con ella."

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=0
#. y4:msg_phrase=85
#. y4:msg_location=T0.P85
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_decision_group=2
#. y4:msg_decision_choices=1. Very! -> T0.P86 | 2. Akino is cute too. -> T0.P100 | 3. Haruko has a great personality. -> T0.P107
msgctxt "1328_Naoya"
msgid "You know what, Konatsu-chan? You're adorable. Isn't she, Ryota?"
msgstr "¿Sabes qué, Konatsu-chan? Eres adorable. ¿No es así, Ryota?"

#. y4:line_status=translated
msgctxt "1340_Tanimura"
msgid "Yeah. A lot of girls nowadays are so masculine. Not that\\r\nthat's a problem, but... I dunno. Konatsu-chan just seems\\r\nlike the type of girl that makes me want to protect her."
msgstr "Sí. Muchas chicas hoy en día son tan masculinas. No es que sea un problema,\\r\npero... no sé. Konatsu-chan parece el tipo de chica que me hace\\r\nquerer protegerla."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=87
#. y4:msg_location=T0.P87
#. y4:msg_speaker=Konatsu
#. y4:msg_speaker_id=11
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1352_Konatsu"
msgid "I am? Sorry... I don't want to make you do that..."
msgstr "¿Yo? Lo siento... no quiero darte a entender eso..."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=88
#. y4:msg_location=T0.P88
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1364_Naoya"
msgid "You don't have to apologize!"
msgstr "¡No tienes que disculparte!"

#. y4:line_status=translated
msgctxt "1376_Haruko"
msgid "Yeah! Just say, \"Thanks!\" in that cute little voice of yours! Since you're so feminine and all－unlike me, apparently."
msgstr "¡Sí! ¡Solo di, \"¡Gracias!\" en esa dulce vocecita tuya! Como si fueras tan femenina y todo eso— con una gran diferencia de mí, aparentemente."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=90
#. y4:msg_location=T0.P90
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1388_Akino"
msgid "Haruko, what's that supposed to mean? Did Ryota-kun's comment rub you the wrong way?"
msgstr "¿Haruko, qué se supone que significa eso? ¿Te molestó el comentario de Ryota-kun?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=91
#. y4:msg_location=T0.P91
#. y4:msg_speaker=Haruko
#. y4:msg_speaker_id=10
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1400_Haruko"
msgid "Heck no! I'm not <Italic>that</Italic> sensitive, you know!"
msgstr "¡De ninguna manera! ¡No soy <Italic>tan</Italic> sensible, ¿sabes?!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=92
#. y4:msg_location=T0.P92
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1412_Naoya"
msgid "Haruko-chan, I actually find you quite feminine. And attractive. Thought you'd like to know."
msgstr "Haruko-chan, de hecho, te encuentro bastante femenina. Y atractiva. Pensé que te gustaría saberlo."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=93
#. y4:msg_location=T0.P93
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1424_Tanimura"
msgid "Actually, Yusuke was just saying how cute Akino-san looks today, too."
msgstr "En realidad, Yusuke estaba diciendo qué linda se ve Akino-san hoy también."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=94
#. y4:msg_location=T0.P94
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1436_Yusuke"
msgid "Wait, what!?"
msgstr "Espera, ¡¿qué?!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=95
#. y4:msg_location=T0.P95
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1448_Akino"
msgid "Hah! Yeah right, Ryota-kun. I know Yusuke doesn't see me like that. Nice try, though."
msgstr "¡Ja! Claro, Ryota-kun. Sé que Yusuke no me ve de esa manera. Buen intento, sin embargo."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=96
#. y4:msg_location=T0.P96
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1460_Yusuke"
msgid "To be honest, that's not exactly... true."
msgstr "Para ser honesto, eso no es exactamente... cierto."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=97
#. y4:msg_location=T0.P97
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1472_Akino"
msgid "Uh...?"
msgstr "¿Eh...?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=98
#. y4:msg_location=T0.P98
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1484_Yusuke"
msgid "I mean, Ryota's totally right. Lately I really have noticed how pretty you are, and... yeah."
msgstr "Quiero decir, Ryota tiene toda la razón. Últimamente, realmente he notado lo bonita que eres, y... sí."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=99
#. y4:msg_location=T0.P99
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1496_Akino"
msgid "What!? No way! I never would've expected to hear something like that from you, Yusuke. But thanks!"
msgstr "¡¿Qué?! ¡No puede ser! Nunca hubiera esperado escuchar algo así de ti, Yusuke. ¡Pero gracias!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=100
#. y4:msg_location=T0.P100
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1508_Tanimura"
msgid "Well... Not only is Akino-san really cheerful and cute, but everybody here is great."
msgstr "Bueno... No solo Akino-san es realmente alegre y linda, sino que todos aquí son geniales."

#. y4:line_status=translated
msgctxt "1520_Yusuke"
msgid "Wha－!?"
msgstr "¡¿Qué－?!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=102
#. y4:msg_location=T0.P102
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1532_Akino"
msgid "Aww, thanks, Ryota-kun! Even if you're only being nice!"
msgstr "¡Aww, gracias, Ryota-kun! ¡Incluso si solo estás siendo amable!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=103
#. y4:msg_location=T0.P103
#. y4:msg_speaker=Haruko
#. y4:msg_speaker_id=10
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1544_Haruko"
msgid "So nothing about me!?"
msgstr "¡¿Entonces, nada sobre mí?!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=104
#. y4:msg_location=T0.P104
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1556_Tanimura"
msgid "Haruko-san, you're a lot of fun. It's easy to relax with you here."
msgstr "Haruko-san, eres muy divertida. Es fácil relajarse contigo aquí."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=105
#. y4:msg_location=T0.P105
#. y4:msg_speaker=Haruko
#. y4:msg_speaker_id=10
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1568_Haruko"
msgid "Are you just saying that out of pity? Well, whatever."
msgstr "¿Lo dices solo por compasión? Bueno, lo que sea."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=106
#. y4:msg_location=T0.P106
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1580_Naoya"
msgid "(Hey, Tanimura-san! Don't forget why we're here today! You need to make Yusuke look good!)"
msgstr "(¡Oye, Tanimura-san! ¡No olvides por qué estamos aquí hoy! ¡Necesitas hacer que Yusuke luzca bien!)"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=107
#. y4:msg_location=T0.P107
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1592_Tanimura"
msgid "Well... Haruko-san is a great conversationalist, and she has an awesome personality."
msgstr "Bueno... Haruko-san es una gran conversadora, y tiene una personalidad increíble."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=108
#. y4:msg_location=T0.P108
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1604_Yusuke"
msgid "Wow, Ryota, I didn't know you were after Haruko-chan. Heheh."
msgstr "Wow, Ryota, no sabía que estabas detrás de Haruko-chan. Je, je."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=109
#. y4:msg_location=T0.P109
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1616_Akino"
msgid "Hmm. So Haruko's more your type, Ryota-kun?"
msgstr "Hmm. ¿Así que Haruko es más tu tipo, Ryota-kun?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=110
#. y4:msg_location=T0.P110
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1628_Naoya"
msgid "Guess Ryota's more outspoken than he looks. How about you, Yusuke? What's your take?"
msgstr "Supongo que Ryota es más directo de lo que parece. ¿Y tú, Yusuke? ¿Qué opinas?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=111
#. y4:msg_location=T0.P111
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1640_Yusuke"
msgid "Huh!? Umm... I think everyone here is great? Yeah!"
msgstr "¡¿Eh?! Umm... ¿Creo que todos aquí son geniales? ¡Sí!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=112
#. y4:msg_location=T0.P112
#. y4:msg_speaker=Akino
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1652_Akino"
msgid "Come on, Yusuke. Are you hiding something?"
msgstr "Vamos, Yusuke. ¿No estarás escondiendo algo?"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=113
#. y4:msg_location=T0.P113
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1664_Yusuke"
msgid "No, not at all!"
msgstr "¡No, en absoluto!"

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=114
#. y4:msg_location=T0.P114
#. y4:msg_speaker=Naoya
#. y4:msg_speaker_id=4
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1676_Naoya"
msgid "But Yusuke did tell me how cute he thought you were the other day when you guys bumped into each other again."
msgstr "Pero Yusuke me dijo lo linda que pensó que eras el otro día cuando se encontraron otra vez."

#. y4:line_status=translated
#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
