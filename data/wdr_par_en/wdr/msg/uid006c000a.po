#. y4:msg_branch_raw=01 11 00 0a 00 00 00 25 00 00 00 00 00 00 00 00
msgctxt "6612_Tanimura"
msgid "I don't think I'd get along with one."
msgstr "No creo que pueda llevarme bien con una."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=11
#. y4:msg_location=T6.P11
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I don't think I'd get along with one.
msgctxt "6624_Chihiro"
msgid "Really?"
msgstr "¿De verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=12
#. y4:msg_location=T6.P12
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I don't think I'd get along with one.
msgctxt "6636_Tanimura"
msgid "We'd have nothing to talk about. I mean, I don't watch anime."
msgstr "No tendríamos cosas de las que hablar. Como yo no veo anime y esas cosas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=13
#. y4:msg_location=T6.P13
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I don't think I'd get along with one.
msgctxt "6648_Chihiro"
msgid "Oh... You don't like me, then?"
msgstr "Ah..., entonces, ¿no le gusto?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=14
#. y4:msg_location=T6.P14
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I don't think I'd get along with one.
msgctxt "6660_Tanimura"
msgid "Huh? But you said you weren't an otaku..."
msgstr "¿Eh? Pero dijiste que no eras otaku..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=15
#. y4:msg_location=T6.P15
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I don't think I'd get along with one.
msgctxt "6672_Chihiro"
msgid "It's okay. I understand. I won't talk about anime anymore."
msgstr "No, está bien, entiendo. Ya no voy a volver a hablar de anime."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
