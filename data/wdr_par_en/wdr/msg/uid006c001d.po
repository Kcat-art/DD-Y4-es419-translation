#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I sort of understand what you mean.
msgctxt "8700_Rio"
msgid "Yeah, kinda like that!"
msgstr "¡Sí, algo así!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=8
#. y4:msg_section_label=Conversación 8
#. y4:msg_talk=8
#. y4:msg_phrase=28
#. y4:msg_location=T8.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I sort of understand what you mean.
msgctxt "8712_Akiyama"
msgid "But you know what? I bet he's already regretting it. I know I'd never let a girl like you get away."
msgstr "¿Pero sabes qué? Apuesto a que ya se está arrepintiendo. Sé que nunca dejaría ir a una chica como tú."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
