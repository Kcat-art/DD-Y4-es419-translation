msgstr "(Veamos...)"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=8
#. y4:msg_phrase=0
#. y4:msg_location=T8.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "648_Akiyama"
msgid "Your eyes are nice and big."
msgstr "Tienes unos ojos son grandes y bonitos."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=8
#. y4:msg_phrase=1
#. y4:msg_location=T8.P1
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "660_Noa"
msgid "Huh? Why are you talking about my eyes?"
msgstr "¿Eh? ¿Por qué habla de mis ojos tan de repente?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=8
#. y4:msg_phrase=2
#. y4:msg_location=T8.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "672_Akiyama"
msgid "I've been thinking about them. They're quite charming."
msgstr "Es que, me llaman mucho la atención. Siento como si atrajeran inconscientemente. Son encantadores."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=8
#. y4:msg_phrase=3
#. y4:msg_location=T8.P3
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "684_Noa"
msgid "But I want you to look at my legs! Hmph, never mind."
msgstr "¿Qué cosas raras está diciendo? ¡Mire las piernas! ¡Las piernas!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=8
#. y4:msg_phrase=4
#. y4:msg_location=T8.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "696_Akiyama"
msgid "Um... Okay..."
msgstr "Ah... Bueno..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=9
#. y4:msg_phrase=0
#. y4:msg_location=T9.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "708_Akiyama"
msgid "You've got a cute mouth."
msgstr "Tienes una linda boca."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=9
#. y4:msg_phrase=1
#. y4:msg_location=T9.P1
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "720_Noa"
msgid "Really? What do you think is cute about it?"
msgstr "Muy linda. ♪\n"
"Pero, ¿qué crees que tiene de linda?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=9
#. y4:msg_phrase=2
#. y4:msg_location=T9.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "732_Akiyama"
msgid "Uh, well... It looks very... kissable?"
msgstr "Uh, bueno... Se ve muy... ¿Besable?"

msgctxt "744_Noa"
msgid "Hahaha! Nice try! Control yourself, please. <Color:7>♥<Color:Default>"
msgstr "¡Ja, ja, ja! ♪ ¡Aunque diga eso, no pasará! <Color:7>♥<Color:Default> ¡Aún falta mucho para algo así! <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=10
#. y4:msg_phrase=0
#. y4:msg_location=T10.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "756_Akiyama"
msgid "Your hands are very pretty. You've got nice long fingers."
msgstr "Tus manos son preciosas. Tienes dedos largos y bonitos."

msgctxt "768_Noa"
msgid "Oh? Well, that's nice of you to say, but... I really wanted you to look at my legs. <Color:7>♥<Color:Default>"
msgstr "¿Oh? Bueno, es muy amable de su parte decirlo, pero... realmente quería que mirara mis piernas. <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=10
#. y4:msg_phrase=2
#. y4:msg_location=T10.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "780_Akiyama"
msgid "I like your hands better."
msgstr "Prefiero las manos a las piernas."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=10
#. y4:msg_phrase=3
#. y4:msg_location=T10.P3
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "792_Noa"
msgid "Hehe, do you have some kind of hand fetish?"
msgstr "¿Acaso Akiyama-san tiene un fetiche de manos?\n"
"¡Ja, ja, pero qué cosa más interesante! ♪"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=0
#. y4:msg_location=T11.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "804_Akiyama"
msgid "You're right. Your legs are very beautiful."
msgstr "Ciertamente tienes piernas muy hermosas."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=1
#. y4:msg_location=T11.P1
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "816_Noa"
msgid "Ha! I told you!"
msgstr "¿Verdad, verdad? ♪"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=2
#. y4:msg_location=T11.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "828_Akiyama"
msgid "But I can't get a very good look because of that dress."
msgstr "Pero este vestido no me ayuda en absoluto. Con un leotardo sería otra cosa."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=3
#. y4:msg_location=T11.P3
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "840_Noa"
msgid "Hmm. Would you like to see me in a leotard?"
msgstr "¿Le gustaría verme con un leotardo? <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=4
#. y4:msg_location=T11.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "852_Akiyama"
msgid "Heh, I sure would."
msgstr "Je, claro que me gustaría."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=5
#. y4:msg_location=T11.P5
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "864_Noa"
msgid "Well then, I'll bring in one of my ballet photos."
msgstr "Bien bien, entonces cuando pueda le traeré una foto. ♪"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=11
#. y4:msg_phrase=6
#. y4:msg_location=T11.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "876_Akiyama"
msgid "Oh. So I can't see it in person?"
msgstr "Oh, así que no podré verlo en persona..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=0
#. y4:msg_location=T12.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "888_Akiyama"
msgid "Your hair looks great today."
msgstr "Tu cabello se increíble hoy."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=1
#. y4:msg_location=T12.P1
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "900_Noa"
msgid "My hair? What about my legs?"
msgstr "Oiga, ¡Mire mis piernas, mis piernas!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=2
#. y4:msg_location=T12.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "912_Akiyama"
msgid "I just think your hair looks cute."
msgstr "Pero, es que tu cabello está muy bonito."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=3
#. y4:msg_location=T12.P3
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "924_Noa"
msgid "But it doesn't have anything to do with ballet, does it? It's not like I work that hard on it."
msgstr "¡Pero el cabello no tiene nada que ver con el ballet! Además, es fácil de arreglar."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=4
#. y4:msg_location=T12.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "936_Akiyama"
msgid "Oh, okay. Let's take a look at those legs of yours, then..."
msgstr "Es verdad. Bueno, entonces miraré las piernas..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=5
#. y4:msg_location=T12.P5
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "948_Noa"
msgid "Hmph! I don't want to show you anymore! Too bad!"
msgstr "¡Hmph! ¡Ya no quiero mostrárselas! ¡Qué lástima! ♪"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=12
#. y4:msg_phrase=6
#. y4:msg_location=T12.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "960_Akiyama"
msgid "Hey, that's not fair."
msgstr "Oi oi, eso no es justo."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=0
#. y4:msg_location=T13.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "972_Akiyama"
msgid "Yes, very nice indeed..."
msgstr "Es verdad, qué buena figura tienes..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=1
#. y4:msg_location=T13.P1
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "984_Noa"
msgid "Hey! Watch where you're looking!"
msgstr "¡Oiga! ¡Cuidado dónde mira! ¡¿Acaso es un viejo verde?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=2
#. y4:msg_location=T13.P2
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "996_Akiyama"
msgid "Well, you said you were confident about your figure, didn't you?"
msgstr "Bueno, es que me dijiste que tenías confianza en tu figura."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=3
#. y4:msg_location=T13.P3
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1008_Noa"
msgid "Yes, but I just meant my legs!"
msgstr "¡Claro que lo dije! ¡Pero solo podía ver mis piernas!"

msgctxt "1020_Noa"
msgid "But thanks for the compliment anyway. <Color:7>♥<Color:Default>"
msgstr "Bueno, gracias por el cumplido de todos modos. <Color:7>♥<Color:Default>"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=5
#. y4:msg_location=T13.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1032_Akiyama"
msgid "Heheh."
msgstr "Je, je, je."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=13
#. y4:msg_phrase=1
#. y4:msg_location=T13.P1
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1044_Noa"
msgid "Hey! Watch where you're looking!"
msgstr "¡Oiga! ¡Cuidado dónde mira! ¡¿Acaso es un viejo verde?!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=14
#. y4:msg_phrase=1
#. y4:msg_location=T14.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1056_Akiyama"
msgid "Well, if I stared at your legs, that'd just make me a dirty old man, right?"
msgstr "¿Eh? Pero si me quedo viendo tus piernas también pareceré un viejo verde, ¿no lo crees?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=14
#. y4:msg_phrase=2
#. y4:msg_location=T14.P2
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1068_Noa"
msgid "I didn't say stare. You're not embarrassed, are you?"
msgstr "Pero no le dije que pegue sus ojos a mis piernas. ♪ ¿No será que tiene algo de vergüenza?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=14
#. y4:msg_phrase=3
#. y4:msg_location=T14.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1080_Akiyama"
msgid "What? No, not at all."
msgstr "¿Qué? No, para nada."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=14
#. y4:msg_phrase=4
#. y4:msg_location=T14.P4
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=2
msgctxt "1092_Noa"
msgid "Sure... You know, you can be pretty cute sometimes."
msgstr "Uy, por lo visto Akiyama-san tiene un lado inocente. ♪"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=14
#. y4:msg_phrase=5
#. y4:msg_location=T14.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1104_Akiyama"
msgid "Hmph. Whatever..."
msgstr "Hmph. Como sea..."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=15
#. y4:msg_phrase=0
#. y4:msg_location=T15.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1116_Akiyama"
msgid "(Oh, I guess I'll play along...)"
msgstr "(Oh, supongo que le seguiré el juego...)"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=16
#. y4:msg_phrase=0
#. y4:msg_location=T16.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1128_Akiyama"
msgid "(What's she mumbling, anyway?)"
msgstr "(¿Qué está murmurando, de todos modos?)"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=17
#. y4:msg_phrase=0
#. y4:msg_location=T17.P0
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "1140_Akiyama"
msgid "(Aren't you supposed to move your fingers slowly in a circle when you do something like this?)"
msgstr "(¿No se supone que debes mover los dedos lentamente en círculo cuando haces algo así?)"

