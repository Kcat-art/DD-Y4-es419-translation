msgid "I'll be waiting right here for the booze!"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=0
#. y4:msg_location=T3.P0
#. y4:msg_speaker=Homeless Man
#. y4:msg_speaker_id=0
msgctxt "188_Homeless Man"
msgid "Ahh, there you are. Did you get me some booze?"
msgstr ""

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=3
#. y4:msg_phrase=2
#. y4:msg_location=T3.P2
#. y4:msg_speaker=Homeless Man
#. y4:msg_speaker_id=0
