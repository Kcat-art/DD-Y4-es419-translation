#. y4:msg_location=T0.P139
#. y4:msg_speaker=Yusuke
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Masa.
msgctxt "1976_Yusuke"
msgid "Oh... For sure."
msgstr "Oh... Sí, claro."

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=4
#. y4:msg_section_label=Conversación 4
