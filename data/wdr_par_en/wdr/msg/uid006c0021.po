#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=It must've been a pretty boring movie.
msgctxt "9156_Erena"
msgid "I see! I've got to go rent a different DVD and see what happens."
msgstr "¡Ya veo! Iré a alquilar un DVD diferente y ver como sale todo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
