#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's quite an interesting experience.
msgctxt "6072_Noa"
msgid "What!?"
msgstr "¡¿EH?!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=26
#. y4:msg_location=T5.P26
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=That's quite an interesting experience.
msgctxt "6084_Noa"
msgid "No, I couldn't do it! That kind of thing should be done in private."
msgstr "¡No, no podría! Ese tipo de cosas deben hacerse en privado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
