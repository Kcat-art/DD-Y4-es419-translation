#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you sure you didn't love him?
msgctxt "12384_Akiyama"
msgid "Are you sure you didn't love him? Sometimes you don't really appreciate what you have until it's gone."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=14
#. y4:msg_location=T21.P14
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you sure you didn't love him?
msgctxt "12396_Erena"
msgid "Well, I don't know... I didn't hate him. And the reason I was with him in the first place was because I liked him."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=15
