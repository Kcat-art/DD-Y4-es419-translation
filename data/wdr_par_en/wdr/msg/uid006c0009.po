#. y4:msg_branch_choice=What if you don't like the guy?
msgctxt "9348_Kiryu"
msgid "Huh. If you're going to be picky and choose like that, why don't you just tell the guys you like first?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
