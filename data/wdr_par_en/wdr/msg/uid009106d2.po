#. y4:msg_phrase=0
#. y4:msg_location=T1.P0
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "480_Kiryu"
msgid "You're the boss of Black Nightmare?"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=1
#. y4:msg_location=T1.P1
#. y4:msg_speaker=Man in Black Suit
#. y4:msg_speaker_id=16
msgctxt "492_Man in Black Suit"
msgid "Yeah, I'm Rank Zero. And these two are Rank One. Elite fighters, the only two of their kind in our gang."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=2
#. y4:msg_location=T1.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "504_Kiryu"
msgid "Let me ask you this: why are you trying to defeat me and rise to the top of the gang hierarchy?"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Rank 0
#. y4:msg_speaker_id=0
msgctxt "516_Rank 0"
msgid "Simple. I'm tired of petty power struggles with those morons from the other gangs."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=4
#. y4:msg_location=T1.P4
#. y4:msg_speaker=Rank 0
#. y4:msg_speaker_id=0
msgctxt "528_Rank 0"
msgid "That's why I traveled the nation, recruiting members who are not only the cream of the crop, but who also share my views."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=5
#. y4:msg_location=T1.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "540_Kiryu"
msgid "Hmm... So if you beat me, the town's going to be inundated with rank-whatever gangs?"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=6
#. y4:msg_location=T1.P6
#. y4:msg_speaker=Rank 0
#. y4:msg_speaker_id=0
msgctxt "552_Rank 0"
msgid "Yeah, more or less."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=7
#. y4:msg_location=T1.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "564_Kiryu"
msgid "Heh, talk about boring."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=8
#. y4:msg_location=T1.P8
#. y4:msg_speaker=Rank 0
#. y4:msg_speaker_id=0
msgctxt "576_Rank 0"
msgid "What did you just say!?"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=9
#. y4:msg_location=T1.P9
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "588_Kiryu"
msgid "Listen, I'm not exactly a fan of gangs, but it's not like I'm totally opposed to them, either."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "600_Kiryu"
msgid "Dirtbags, scum of the earth, the worst of the worst. They'll always be lumped in together, and the yakuza are really no different."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "612_Kiryu"
msgid "But even gangs and yakuza don't go around calling people by rank and treating them like they're less than human."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=12
#. y4:msg_location=T1.P12
#. y4:msg_speaker=Rank 0
#. y4:msg_speaker_id=0
msgctxt "624_Rank 0"
msgid "Yeah, okay. Whatever you say, pal."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Rank 0
#. y4:msg_speaker_id=0
msgctxt "636_Rank 0"
msgid "So, what's it gonna be? You're not going to just turn tail and run now, are you?"
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "648_Kiryu"
msgid "No. I'm going to crush you right here, right now. It's the right thing to do, for the sake of Kamurocho's future."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Rank 0
#. y4:msg_speaker_id=0
msgctxt "660_Rank 0"
msgid "The right thing to do? Whatever! Let's see how tough you talk after I smack you down to size."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=16
#. y4:msg_location=T1.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=1
msgctxt "672_Kiryu"
msgid "But if I win, I don't want to see you in Kamurocho ever again."
msgstr ""

#. y4:line_status=todo
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=17
#. y4:msg_location=T1.P17
#. y4:msg_speaker=Rank 0
#. y4:msg_speaker_id=0
msgctxt "684_Rank 0"
msgid "That's one big if! Now, let's see what you got!"
msgstr ""
