#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "14148_Kiryu"
msgid "All right. I'll get revenge for you."
msgstr "Muy bien, me vengaré por ti."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
#. y4:msg_phrase=8
#. y4:msg_location=T27.P8
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "14160_松岡里緒奈：源氏名"
msgid "I don't know. I don't think even you could out-drink her."
msgstr "No lo sé. Creo que ni siquiera tú podrías beber más que ella."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
