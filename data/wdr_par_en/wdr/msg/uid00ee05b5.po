#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=0
#. y4:msg_location=T0.P0
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "56_Kamiyama"
msgid "Hey, you... You really laid it on those guys back there. I can tell you're on the side of justice."
msgstr "Oye... Sí que le diste una buena a esos tipos allá atrás. Te digo que estás del lado de la justicia."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=2
msgctxt "68_Player"
msgid "Oh yeah? I appreciate the compliment, but I'm actually kinda in a hurry here."
msgstr "¿En serio? Te lo agradezco.\nLo siento, pero estoy un poco apurado..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "80_Kamiyama"
msgid "Oh, wait! Uh, here... Take this, please! Take a look at it when you have the time!"
msgstr "¡Oh, espera! Por favor, toma esto.\nSi tienes tiempo, échale un vistazo."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=5
#. y4:msg_location=T0.P5
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=2
msgctxt "116_Player"
msgid "A weapon catalog? What're you trying to imply here?"
msgstr "¿Un catálogo de armas? ¿Insinúas algo?"

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=6
#. y4:msg_location=T0.P6
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "128_Kamiyama"
msgid "Oh, nothing at all! Promise! I just thought you might be interested in my... choice wares. They'd be sure to help you out in a pinch, so stop by my shop if you're interested."
msgstr "¡Oh, nada de nada! ¡Te lo prometo! Solo pensé que podrías estar interesado en mis... productos. Seguro que te sacaran de cualquier apuro, así que pásate por mi tienda si te interesa."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=7
#. y4:msg_location=T0.P7
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "140_Kamiyama"
msgid "You know that back alley up in the northeast part of the city? That's where I'm shacked up. It's a bit of a maze back there... so sorry in advance."
msgstr "La tienda está en el noreste de Kamurocho,\nen una zona un poco complicada. Puedes venir más tarde."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=8
#. y4:msg_location=T0.P8
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "152_Kamiyama"
msgid "Anyway, see you later. Hope you stop by soon!"
msgstr "En fin, hasta luego.\n¡Espero que te pases pronto!"

#. y4:line_status=translated
#. y4:translated_by=Keiner
msgctxt "164_Kamiyama"
msgid "This information has been added as a <Color:14>memo<Color:Default>.\\r\nRead <Color:14>memos<Color:Default> by selecting <Color:14>Memos<Color:Default> in the Pause Menu.\\r\nYou can access the Pause Menu with the <Action:Button_Options@Adventure> button."
msgstr "Esta información ha sido añadida como una <Color:14>nota<Color:Default>.\nLee las <Color:14>notas<Color:Default> seleccionando <Color:14>Notas<Color:Default> en el menú de pausa.\nPuedes acceder al menú de pausa con el botón <Action:Button_Options@Adventure>."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "176_Kamiyama"
msgid "Want to come by my shop now? I'll show you how to get there."
msgstr "¿Te gustaría venir a la tienda ahora?\nPuedo llevarte."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=2
msgctxt "188_Player"
msgid "Huh? Oh, no, uh..."
msgstr "¿Eh? No, gracias..."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Kamiyama
#. y4:msg_speaker_id=0
msgctxt "200_Kamiyama"
msgid "It's this way. It's very close by!"
msgstr "Está por aquí. Muy cerca."

#. y4:line_status=translated
#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Player
#. y4:msg_speaker_id=2
msgctxt "212_Player"
msgid "(Here we go, I guess...)"
msgstr "(Aquí vamos, creo...)."

