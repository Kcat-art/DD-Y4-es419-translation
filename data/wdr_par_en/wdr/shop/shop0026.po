msgctxt "252"
msgid "Quit"
msgstr "Salir"

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "257"
msgid "Cancel the order."
msgstr "Cancelar el pedido."

#. y4:line_status=translated
msgctxt "275"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=translated
msgctxt "281"
msgid "Order the currently selected item.  "
msgstr "Pedir el objeto actualmente seleccionado.  "

#. y4:line_status=translated
#. y4:translated_by=dani64amv
msgctxt "318"
msgid "(I haven't picked anything.)  "
msgstr "(No he escogido nada)."

#. y4:line_status=reviewed
#. y4:translated_by=dani64amv
#. y4:reviewed_by=dani64amv
msgctxt "349"
msgid "(I'm short on cash.)  "
msgstr "(Me hace falta dinero)."

#. y4:line_status=translated
msgctxt "372"
msgid "Thanks... %s, please."
msgstr "Son %s por favor."

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "394"
msgid "(I can't carry any more stuff.)"
msgstr "(No puedo llevar más cosas)."

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "426"
msgid "(They're sold out.)"
msgstr "(Están agotados)."

#. y4:line_status=translated
msgctxt "446"
msgid "Standard issue for Special Weapons and Tactics units.\nIt holds up well against bullets."
msgstr "Edición estándar para unidades de armas y tácticas\nespeciales. Resiste bien contra las balas."

#. y4:line_status=translated
msgctxt "534"
msgid "This light-weight breastplate protects against bullets \nand can be worn under a suit."
msgstr "Esta coraza ligera protege contra las balas \ny puede usarse debajo de un traje."

#. y4:line_status=translated
msgctxt "620"
msgid "Will really help psych you up before a fight."
msgstr "Realmente te ayudará a mentalizarte antes\nde una pelea."

#. y4:line_status=translated
msgctxt "666"
msgid "Only for those who truly understand the dangers of \nthe business."
msgstr "Solo para aquellos que realmente entienden los \npeligros del negocio."

