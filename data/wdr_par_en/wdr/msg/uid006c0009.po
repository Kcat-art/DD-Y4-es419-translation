#. y4:msg_phrase=10
#. y4:msg_location=T0.P10
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
msgctxt "4260_Maya"
msgid "I originally started here because my boyfriend worked at night, and I wanted to be on the same schedule."
msgstr "Comencé aquí debido a que mi novio trabajaba en la noche, y yo quería estar en el mismo horario."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=11
#. y4:msg_location=T0.P11
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. That's too bad. -> T0.P12 | 2. You did that for your boyfriend? Wow. -> T0.P20 | 3. Why don't you stay for a bit longer? -> T0.P26
msgctxt "4272_Maya"
msgid "But I broke up with him a while ago, and I've been busy with modeling work, so I'm thinking about quitting my job here."
msgstr "Pero rompí con el hace tiempo, y ahí estuve ocupada con el trabajo de modelaje, así que estoy pensando en dejar este trabajo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=12
#. y4:msg_location=T0.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's too bad.
msgctxt "4284_Kiryu"
msgid "That's too bad. When do you plan on quitting?"
msgstr "Que lastima. ¿Hasta cuando piensas renunciar?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=13
#. y4:msg_location=T0.P13
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's too bad.
msgctxt "4296_Maya"
msgid "The sooner the better, I guess."
msgstr "Cuanto antes, mejor."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=14
#. y4:msg_location=T0.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's too bad.
msgctxt "4308_Kiryu"
msgid "Oh."
msgstr "Oh."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=15
#. y4:msg_location=T0.P15
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's too bad.
msgctxt "4320_Maya"
msgid "Aw. Are you disappointed you won't be able to see me?"
msgstr "Oh. ¿Te entristece no poder verme?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=16
#. y4:msg_location=T0.P16
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's too bad.
msgctxt "4332_Kiryu"
msgid "A little. I don't know you very well yet."
msgstr "Un poco. Aunque no te conozca del todo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=17
#. y4:msg_location=T0.P17
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's too bad.
msgctxt "4344_Maya"
msgid "That's true. We just met."
msgstr "Eso es cierto. Apenas nos conocemos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=18
#. y4:msg_location=T0.P18
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's too bad.
msgctxt "4356_Maya"
msgid "But I wouldn't mind getting to know you better. Maybe I can stay a bit longer."
msgstr "Pero no me molestaría conocerte un poco más. Quizás me pueda quedar un poco más."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=19
#. y4:msg_location=T0.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=That's too bad.
msgctxt "4368_Kiryu"
msgid "Heh. All right, then. I'll come back and see you."
msgstr "Je, está bien. Entonces volveré a verte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=20
#. y4:msg_location=T0.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You did that for your boyfriend? Wow.
msgctxt "4380_Kiryu"
msgid "You did that for your boyfriend? Wow. I don't think most girls would do that."
msgstr "¿Dices que lo hiciste por tu novio? Vaya. Dudo mucho que la mayoría de chicas harían algo similar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=21
#. y4:msg_location=T0.P21
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You did that for your boyfriend? Wow.
msgctxt "4392_Maya"
msgid "Well, I was thinking about his career, too. I couldn't have him changing jobs all the time."
msgstr "Bueno, yo también estaba pensando en su carrera. No podía tenerlo cambiando de trabajo todo el tiempo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=22
#. y4:msg_location=T0.P22
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You did that for your boyfriend? Wow.
msgctxt "4404_Maya"
msgid "It was easier for me to work around his schedule."
msgstr "Era más fácil para mí trabajar con su horario."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=23
#. y4:msg_location=T0.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You did that for your boyfriend? Wow.
msgctxt "4416_Kiryu"
msgid "Still, that was good of you."
msgstr "Pese a eso, eso fue bueno de tu parte."

msgctxt "4428_Maya"
msgid "Hehe. Thanks. <Color:7>♥<Color:Default>"
msgstr "Je, je. Gracias. <Color:7>♥<Color:Default>"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=25
#. y4:msg_location=T0.P25
#. y4:msg_speaker=Maya
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You did that for your boyfriend? Wow.
msgctxt "4440_Maya"
msgid "But we broke up, so it doesn't matter now."
msgstr "Pero rompimos, así que ya no importa."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=123
