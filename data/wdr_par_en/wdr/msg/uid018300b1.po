#. y4:msg_speaker_id=8
msgctxt "3860_Chihiro"
msgid "Tanimura-san! How's the water over there?"
msgstr "¡Tanimura-san! ¿Cómo está el agua por ahí?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=2
