#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11028_望月京子：源氏名"
msgid "For some reason, people around me think of me as some kind of big sister."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=1
#. y4:msg_location=T19.P1
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11040_望月京子：源氏名"
msgid "They talk to me about their problems and ask me for advice."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=2
#. y4:msg_location=T19.P2
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "11052_Kiryu"
msgid "What's wrong with that?"
msgstr "¿Qué hay de malo con eso?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=3
#. y4:msg_location=T19.P3
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11064_望月京子：源氏名"
msgid "Well, I don't really mind, but the other day I met a high school boy after a concert."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=7
#. y4:msg_section_label=Conversación 7
#. y4:msg_talk=7
#. y4:msg_phrase=5
#. y4:msg_location=T7.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "11076_Kiryu"
msgid "Oh?"
msgstr "Oh..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=5
#. y4:msg_location=T19.P5
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11088_望月京子：源氏名"
msgid "He walked right up to me and said, \"Please make me your apprentice!\""
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=6
#. y4:msg_location=T19.P6
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "11100_Kiryu"
msgid "Attracting apprentices, are you? That's pretty impressive."
msgstr ""

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=7
#. y4:msg_location=T19.P7
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=19
#. y4:msg_decision_choices=1. You can't do it half-heartedly. -> T19.P8 | 2. What's wrong? Don't you think you can do it? -> T19.P15 | 3. Just ignore him. -> T19.P22
msgctxt "11112_望月京子：源氏名"
msgid "I keep telling him that I'm not interested in training any apprentices, but he won't listen."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=8
#. y4:msg_location=T19.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't do it half-heartedly.
msgctxt "11124_Kiryu"
msgid "You can't do it half-heartedly. It won't be good for you or your apprentice."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=9
#. y4:msg_location=T19.P9
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't do it half-heartedly.
msgctxt "11136_望月京子：源氏名"
msgid "I thought so. Do you have an apprentice, Kiryu-san?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=10
#. y4:msg_location=T19.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't do it half-heartedly.
msgctxt "11148_Kiryu"
msgid "Sort of. He was like a younger brother to me."
msgstr ""

msgctxt "11160_望月京子：源氏名"
msgid "I can totally picture that! Did he follow you around and call you Aniki or something? <Color:7>♥<Color:Default>"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=12
#. y4:msg_location=T19.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't do it half-heartedly.
msgctxt "11172_Kiryu"
msgid "Well, that's all in the past now..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=13
#. y4:msg_location=T19.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't do it half-heartedly.
msgctxt "11184_Kiryu"
msgid "The point is that unless you truly intend to look after this kid, you should keep saying no."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=14
#. y4:msg_location=T19.P14
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You can't do it half-heartedly.
msgctxt "11196_望月京子：源氏名"
msgid "I think you're right. I'll tell him."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=15
#. y4:msg_location=T19.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's wrong? Don't you think you can do it?
msgctxt "11208_Kiryu"
msgid "What's wrong? Don't you think you can do it? Why not give it a try?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=16
#. y4:msg_location=T19.P16
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's wrong? Don't you think you can do it?
msgctxt "11220_望月京子：源氏名"
msgid "No, it's not that... I just think I haven't done anything that'd be worth teaching to somebody."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=17
#. y4:msg_location=T19.P17
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's wrong? Don't you think you can do it?
msgctxt "11232_望月京子：源氏名"
msgid "I'm the one who should be the apprentice to somebody else."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=18
#. y4:msg_location=T19.P18
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's wrong? Don't you think you can do it?
msgctxt "11244_Kiryu"
msgid "What kind of attitude is that? You can't expect to make it big without any followers."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=19
#. y4:msg_location=T19.P19
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's wrong? Don't you think you can do it?
msgctxt "11256_望月京子：源氏名"
msgid "But I hate people who try to make themselves look more important than everybody else. My friends in the band are my equals."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=20
#. y4:msg_location=T19.P20
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=What's wrong? Don't you think you can do it?
msgctxt "11268_望月京子：源氏名"
msgid "I guess you'd never understand that, Kiryu-san..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=1
#. y4:msg_phrase=24
#. y4:msg_location=T1.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You want me to buy you a new one?
msgctxt "11280_Kiryu"
msgid "......"
msgstr "......"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=22
#. y4:msg_location=T19.P22
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just ignore him.
msgctxt "11292_Kiryu"
msgid "Just ignore him. The kid'll give up sooner or later."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=23
#. y4:msg_location=T19.P23
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just ignore him.
msgctxt "11304_望月京子：源氏名"
msgid "But..."
msgstr "Pero..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=24
#. y4:msg_location=T19.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just ignore him.
msgctxt "11316_Kiryu"
msgid "Besides, you don't need apprentices to teach people. They say a man teaches the most by the example he sets."
msgstr ""

msgctxt "11328_望月京子：源氏名"
msgid "Hey, you don't have to be a guy to do that!\\r\n"
"But, I think I get what you mean."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=26
#. y4:msg_location=T19.P26
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just ignore him.
msgctxt "11340_望月京子：源氏名"
msgid "I guess I just have to live a life that will be inspiring to kids like him."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=27
#. y4:msg_location=T19.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just ignore him.
msgctxt "11352_Kiryu"
msgid "That's right."
msgstr "Así es."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=28
#. y4:msg_location=T19.P28
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just ignore him.
msgctxt "11364_望月京子：源氏名"
msgid "Thanks! I'll tell him that he can't be my apprentice, but if he wants to learn from my actions, I won't stop him."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=29
#. y4:msg_location=T19.P29
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just ignore him.
msgctxt "11376_Kiryu"
msgid "Good."
msgstr "Perfecto."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=0
#. y4:msg_location=T20.P0
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11388_望月京子：源氏名"
msgid "So, um, Kiryu-san..."
msgstr "Emm..., Kiryu-san..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=1
#. y4:msg_location=T20.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "11400_Kiryu"
msgid "Why the long face?"
msgstr "¿Por qué la cara larga?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=2
#. y4:msg_location=T20.P2
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11412_望月京子：源氏名"
msgid "The bassist in my band was attacked by someone last night."
msgstr "El bajista de mi banda fue atacado por alguien anoche."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=3
#. y4:msg_location=T20.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "11424_Kiryu"
msgid "What? Who did it?"
msgstr "¡¿Qué?! ¿Quien fue?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=4
#. y4:msg_location=T20.P4
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11436_望月京子：源氏名"
msgid "No idea... He was walking alone when somebody hit him from behind."
msgstr "Ni idea... Él estaba caminando solo, cuando alguien le pego por atrás."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=5
#. y4:msg_location=T20.P5
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11448_望月京子：源氏名"
msgid "Luckily he wasn't seriously injured. Just knocked out."
msgstr "Por suerte no le paso nada de gravedad. Lo noquearon eso sí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=6
#. y4:msg_location=T20.P6
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11460_望月京子：源氏名"
msgid "But when I think about what could have happened... It makes me mad!"
msgstr "Pero cuando pienso en lo que le podría haber pasado... ¡Me llena de rabia te juro!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=7
#. y4:msg_location=T20.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "11472_Kiryu"
msgid "Does he have any idea who it might've been?"
msgstr "¿Tienes alguna idea de quién le habrá hecho eso?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=8
#. y4:msg_location=T20.P8
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11484_望月京子：源氏名"
msgid "No. He's a great guy. I can't believe anybody would wanna hurt him."
msgstr "Ni idea. Él es un chico bueno. No puedo creer que alguien le haya pegado así."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=9
#. y4:msg_location=T20.P9
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11496_望月京子：源氏名"
msgid "But... those guys from Bad Flag do seem to be jealous of our band's popularity."
msgstr "Pero... Los chicos de Bad Flag parecen estar celosos de lo populares que somos."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=10
#. y4:msg_location=T20.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "11508_Kiryu"
msgid "Those guys from before. Yeah, I wouldn't put it past them."
msgstr "Son los tipos de antes... Ya, no te dejarán la oportunidad."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=11
#. y4:msg_location=T20.P11
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=20
#. y4:msg_decision_choices=1. Don't do anything hasty. -> T20.P12 | 2. You should watch out. -> T20.P21 | 3. I'll get revenge for you. -> T20.P29
msgctxt "11520_望月京子：源氏名"
msgid "I can't stand those guys!"
msgstr "¡Son insoportables estos sinvergüenzas!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=12
#. y4:msg_location=T20.P12
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't do anything hasty.
msgctxt "11532_Kiryu"
msgid "Don't do anything hasty. And don't think about getting revenge."
msgstr "No lo hagas sin pensarlo. Y ni pienses en vengarte."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=13
#. y4:msg_location=T20.P13
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't do anything hasty.
msgctxt "11544_望月京子：源氏名"
msgid "So I'm supposed to just sit back while they attack my friends!?"
msgstr "¡¿Así que dices que deje que ataquen a mis amigos?!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=14
#. y4:msg_location=T20.P14
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't do anything hasty.
msgctxt "11556_Kiryu"
msgid "You'd just be doing them a favor. If they get the police involved in this, you won't be in a position to play in your band, will you?"
msgstr "Kyoko, solo estarías haciéndoles el favor. Si lo haces y va la policía, no podrías tocar en tu banda o ¿me equivoco?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=15
#. y4:msg_location=T20.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't do anything hasty.
msgctxt "11568_Kiryu"
msgid "It would disappoint your fans, too."
msgstr "Y además decepcionarías a tus fans..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=16
#. y4:msg_location=T20.P16
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't do anything hasty.
msgctxt "11580_望月京子：源氏名"
msgid "That's true... I couldn't take it if it resulted in the band splitting up."
msgstr "Es verdad... Tiene sentido, y al final la banda se separaría..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=17
#. y4:msg_location=T20.P17
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't do anything hasty.
msgctxt "11592_Kiryu"
msgid "Just sit tight until we find out for sure who was behind this."
msgstr "Siéntate hasta que descubramos con certeza quién está detrás de esto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=18
#. y4:msg_location=T20.P18
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't do anything hasty.
msgctxt "11604_望月京子：源氏名"
msgid "You're right. I was just so upset, I didn't think about my fans..."
msgstr "Tienes razón. Estaba tan cegada, no pensé en las consecuencias..."

msgctxt "11616_望月京子：源氏名"
msgid "Thanks, Kiryu-san. <Color:7>♥<Color:Default> I'll tell the other band members to stay outta trouble, too."
msgstr "Gracias, Kiryu- san. <Color:7>♥<Color:Default> Les dire a los miembros de la banda que no se metan en esto también."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=20
#. y4:msg_location=T20.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Don't do anything hasty.
msgctxt "11628_Kiryu"
msgid "Good, that's for the best."
msgstr "Bien, es lo mejor para ustedes."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=21
#. y4:msg_location=T20.P21
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You should watch out.
msgctxt "11640_Kiryu"
msgid "You should watch out. They might come after you next."
msgstr "Deberías tener más cuidado. Capaz seas la siguiente a la que quieran ir."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=22
#. y4:msg_location=T20.P22
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You should watch out.
msgctxt "11652_望月京子：源氏名"
msgid "They can all bring it on! I'll make them sorry for hurting my friend!"
msgstr "¡Pues pueden intentarlo! ¡Se arrepentirán de haber lastimado a mi amigo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=23
#. y4:msg_location=T20.P23
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You should watch out.
msgctxt "11664_Kiryu"
msgid "Don't underestimate them. Even you'd have trouble facing several men by yourself."
msgstr "No los subestimes. Además, ¿Que harás si son demasiados? No podrías sola."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=24
#. y4:msg_location=T20.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You should watch out.
msgctxt "11676_Kiryu"
msgid "For now, just try to avoid doing anything alone. Maybe I should be your bodyguard."
msgstr "Por ahora, no hagas ni trates de hacer eso por sola. Tal vez debería ir contigo como un guardaespaldas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=25
#. y4:msg_location=T20.P25
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You should watch out.
msgctxt "11688_望月京子：源氏名"
msgid "Thanks. But you don't need to go out of your way for me like that."
msgstr "Gracias Kiryu-san. Pero no hace falta que te esfuerces por mí así."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=26
#. y4:msg_location=T20.P26
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You should watch out.
msgctxt "11700_望月京子：源氏名"
msgid "I'll hang around with the other guys in the band. Thanks for the offer, though."
msgstr "Me quedaré con otros chicos de la banda. Gracias por ofrecerte igualmente."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=27
#. y4:msg_location=T20.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You should watch out.
msgctxt "11712_Kiryu"
msgid "I see... Well, call me if anything else happens."
msgstr "Ya veo... Bueno, llámame si pasa algo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=28
#. y4:msg_location=T20.P28
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=You should watch out.
msgctxt "11724_望月京子：源氏名"
msgid "I will!"
msgstr "¡Lo prometo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=29
#. y4:msg_location=T20.P29
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "11736_Kiryu"
msgid "I'll get revenge for you. Just tell me where to find them."
msgstr "Me vengaré por ti. Solo dime donde y les parto."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=30
#. y4:msg_location=T20.P30
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "11748_望月京子：源氏名"
msgid "Hey! What're you talking about!?"
msgstr "¡Ey! ¡¿De qué estás hablando?!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=31
#. y4:msg_location=T20.P31
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "11760_Kiryu"
msgid "I'll teach them a lesson they won't soon forget. Don't worry, I'm used to this kind of thing."
msgstr "Les daré una lección que no olvidaran. No te preocupes, estoy acostumbrado a estas cosas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=32
#. y4:msg_location=T20.P32
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "11772_望月京子：源氏名"
msgid "No, that's okay. You don't have to do anything, Kiryu-san."
msgstr "No, está bien. No tiene que hacer nada, Kiryu-san."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=33
#. y4:msg_location=T20.P33
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "11784_Kiryu"
msgid "Huh? Aren't you angry about what they did?"
msgstr "¿Eh? ¿No estabas enojada por lo que hicieron?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=34
#. y4:msg_location=T20.P34
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "11796_望月京子：源氏名"
msgid "Of course I am! You'd just escalate the situation, though. This is our problem."
msgstr "¡Claro que lo estoy! Solo que escalaría el problema, solo eso. Este es nuestro problema. (NT:Está sacando a Kiryu del tema.)"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=35
#. y4:msg_location=T20.P35
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "11808_望月京子：源氏名"
msgid "If you do something without telling me, I'll never forgive you!"
msgstr "Si haces algo sin decirme, ¡no te lo perdonaré!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=36
#. y4:msg_location=T20.P36
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I'll get revenge for you.
msgctxt "11820_Kiryu"
msgid "Okay..."
msgstr "Bueno..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=0
#. y4:msg_location=T21.P0
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11832_望月京子：源氏名"
msgid "Did you know there's gonna be a battle of the bands event in Kamurocho?"
msgstr "¿Sabes que habrá una batalla de bandas en Kamurocho?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=1
#. y4:msg_location=T21.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "11844_Kiryu"
msgid "No..."
msgstr "No..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=2
#. y4:msg_location=T21.P2
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11856_望月京子：源氏名"
msgid "They said the winner gets a record deal!"
msgstr "¡Dicen que el ganador se llevara un contrato discográfico!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=3
#. y4:msg_location=T21.P3
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "11868_Kiryu"
msgid "You're entering, right?"
msgstr "¡¿Entraste?!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=4
#. y4:msg_location=T21.P4
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
msgctxt "11880_望月京子：源氏名"
msgid "Of course! I heard other famous indie bands are entering too, but we'll beat 'em!"
msgstr "¡Claro! Escuche también, que entraron otras bandas indies muy famosas, ¡Pero los venceré!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=5
#. y4:msg_location=T21.P5
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
msgctxt "11892_Kiryu"
msgid "You're pretty confident."
msgstr "Estás muy confiada."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=6
#. y4:msg_location=T21.P6
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_decision_group=21
#. y4:msg_decision_choices=1. Sure. I'll be there. -> T21.P7 | 2. If I can make it. -> T21.P17 | 3. Maybe I could sing a song... -> T21.P24
msgctxt "11904_望月京子：源氏名"
msgid "Sure am! We're the best band in the city! You gotta come and see us!"
msgstr "¡Claro que lo estoy! ¡Somos la mejor banda de la ciudad! ¡Tienes que venir a vernos!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=7
#. y4:msg_location=T21.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sure. I'll be there.
msgctxt "11916_Kiryu"
msgid "Sure. I'll be there. Make sure you do your best."
msgstr "Lo estaré. Haz tu mejor esfuerzo."

msgctxt "11928_望月京子：源氏名"
msgid "Thanks! <Color:7>♥<Color:Default> This'll be the first time you've actually seen my band, huh?"
msgstr "¡Gracias! <Color:7>♥<Color:Default> Sera la primera vez que veas mi banda, ¿eh?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=27
#. y4:msg_location=T19.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Just ignore him.
msgctxt "11940_Kiryu"
msgid "That's right."
msgstr "Así es."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=10
#. y4:msg_location=T21.P10
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sure. I'll be there.
msgctxt "11952_望月京子：源氏名"
msgid "Oh, but..."
msgstr "Oh, pero..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=11
#. y4:msg_location=T21.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sure. I'll be there.
msgctxt "11964_Kiryu"
msgid "What?"
msgstr "¿Qué?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=12
#. y4:msg_location=T21.P12
#. y4:msg_speaker=譛帶怦莠ｬ蟄撰ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sure. I'll be there.
msgctxt "11976_望月京子：源氏名"
msgid "I'm happy you're coming, but your clothes..."
msgstr "Estoy contenta que vayas, pero tu ropa..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=13
#. y4:msg_location=T21.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Sure. I'll be there.
msgctxt "11988_Kiryu"
msgid "No good, huh?"
msgstr "No está a la moda..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
