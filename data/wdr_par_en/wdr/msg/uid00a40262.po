msgctxt "152_Akiyama"
msgid "You kind of looked like you needed money."
msgstr "¡Porque parece que necesita dinero urgentemente!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=3
#. y4:msg_location=T1.P3
#. y4:msg_speaker=Girl du Jour
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You looked like you needed money.
msgctxt "164_Girl du Jour"
msgid "You jerk! Mind your own business!"
msgstr "¡Imbécil! ¡Ocúpate de tus propios asuntos!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=1
#. y4:msg_phrase=4
