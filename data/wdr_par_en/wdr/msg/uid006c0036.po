#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe that's your fate.
msgctxt "8688_Kiryu"
msgid "That's not for me to say. Only fate knows for sure."
msgstr "Eso no me corresponde a mí decirlo. Solo el destino lo sabe con certeza."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=12
#. y4:msg_section_label=Conversación 12
