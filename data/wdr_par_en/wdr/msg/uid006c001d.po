#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=2
#. y4:msg_location=T2.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "5172_Rio"
msgid "I've got a dog, and I'm looking for a companion for him."
msgstr "Tengo un perrito en casa, y últimamente he estado pensando que quizá necesita un\n"
"amiguito."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=3
#. y4:msg_location=T2.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "5184_Akiyama"
msgid "Why's that?"
msgstr "¿Por qué?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=4
#. y4:msg_location=T2.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "5196_Rio"
msgid "He's lonely all by himself. I thought I should get him a friend."
msgstr "Me da la impresión de que se siente solo. Creo que tener a otro perrito con él le\n"
"haría bien."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=5
#. y4:msg_location=T2.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "5208_Akiyama"
msgid "Ah, I see. And?"
msgstr "Entiendo. ¿Y entonces?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=6
#. y4:msg_location=T2.P6
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "5220_Rio"
msgid "I went to the pet store a while ago, and they had an adorable pair of dogs who were brother and sister."
msgstr "Fui a una tienda de mascotas y vi una parejita de cachorros, eran hermanitos, macho y hembra."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=7
#. y4:msg_location=T2.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "5232_Rio"
msgid "I thought about getting the girl, but..."
msgstr "Me gustó la hembra. Pensé que podría llevarla a casa, pero..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=8
#. y4:msg_location=T2.P8
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "5244_Rio"
msgid "They just looked so happy together. I couldn't bear splitting them up."
msgstr "Los vi juntos y parecían inseparables, tan felices uno al lado del otro. No quería separarlos."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=9
#. y4:msg_location=T2.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "5256_Akiyama"
msgid "You mean that your dog would get a companion, but the dog in the pet store would lose his?"
msgstr "Tu perrito tendría una nueva amiga, pero el hermanito... se quedaría sin nadie."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=10
#. y4:msg_location=T2.P10
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "5268_Rio"
msgid "Exactly. So I left without getting either."
msgstr "¡Sí! Por eso decidí no llevármela en ese momento."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=11
#. y4:msg_location=T2.P11
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "5280_Akiyama"
msgid "Well, I guess there wasn't much of a choice, huh?"
msgstr "Bueno, supongo que no podías hacer mucho."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=12
#. y4:msg_location=T2.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "5292_Rio"
msgid "Anyway, a few days ago I went back to the pet store and saw a familiar face."
msgstr "Pero hace poco regresé, y vi a un cachorro que me resultaba familiar."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=13
#. y4:msg_location=T2.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "5304_Akiyama"
msgid "The dogs from before?"
msgstr "¿Era uno de los hermanos?"

msgctxt "5316_Rio"
msgid "Yes, but this time there was only one－the male."
msgstr "Sí, pero solo estaba el macho. La hembra se había ido..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=15
#. y4:msg_location=T2.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "5328_Akiyama"
msgid "Oh..."
msgstr "Oh..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=16
#. y4:msg_location=T2.P16
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "5340_Rio"
msgid "Some time had passed since I'd last seen him, actually. He'd grown quite a bit, and he looked like a scruffy old man."
msgstr "Y como ha pasado el tiempo, el perrito creció bastante. ¡Y ahora tiene una cara que parece de abuelo amargado!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=17
#. y4:msg_location=T2.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "5352_Rio"
msgid "I don't think anybody's gonna want him now..."
msgstr "Con esa pinta, tal vez nadie lo quiera adoptar..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=18
#. y4:msg_location=T2.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "5364_Akiyama"
msgid "Except for you, right?"
msgstr "Excepto tú, ¿verdad?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=19
#. y4:msg_location=T2.P19
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=2
#. y4:msg_decision_choices=1. You want a dog that looks like an old man? -> T2.P20 | 2. Sounds like fate. You should buy him. -> T2.P28 | 3. Do you really want a dog that nobody else wants? -> T2.P35
msgctxt "5376_Rio"
msgid "Hehehe. I doubt anyone else will buy him. Plus, he's all alone now that his sister's gone."
msgstr "¡Je, je, je! Me pareció injusto dejarlo así. Sin su hermana, completamente solo."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=127
#. y4:msg_phrase=0
#. y4:msg_location=T127.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T2.P20
#. y4:msg_branch_segment=T2.P20..P27
#. y4:msg_branch_target_text=You want a dog that looks like an old man?
#. y4:msg_branch_raw=01 11 00 14 00 00 00 2a 00 00 00 00 00 00 00 00
msgctxt "5388_Akiyama"
msgid "You want a dog that looks like an old man?"
msgstr "¿Quieres un perro que parece un anciano?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=21
#. y4:msg_location=T2.P21
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You want a dog that looks like an old man?
msgctxt "5400_Rio"
msgid "Oh, I don't know. What should I do?"
msgstr "No lo sé. ¿Qué deberia hacer?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=22
#. y4:msg_location=T2.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You want a dog that looks like an old man?
msgctxt "5412_Akiyama"
msgid "It's a big decision."
msgstr "Es una decisión importante."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=23
#. y4:msg_location=T2.P23
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You want a dog that looks like an old man?
msgctxt "5424_Rio"
msgid "I can't make up my mind."
msgstr "No puedo decidirme."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=24
#. y4:msg_location=T2.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You want a dog that looks like an old man?
msgctxt "5436_Akiyama"
msgid "Well, I can't really criticize the poor mutt. After all, I'm also a scruffy old man."
msgstr "Bueno, en realidad no puedo criticar al pobre perro. Después de todo, yo también soy un viejo desaliñado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=25
#. y4:msg_location=T2.P25
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You want a dog that looks like an old man?
msgctxt "5448_Rio"
msgid "Haha. Oh, you are not, Akiyama-san!"
msgstr "Jaja. ¡No estás viejo, Akiyama-san!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=26
#. y4:msg_location=T2.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You want a dog that looks like an old man?
msgctxt "5460_Akiyama"
msgid "Heh, thanks. But anyway, what are you gonna do about the dog?"
msgstr "Je, gracias. Pero volviendo al punto, ¿qué harás con el perro?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=27
#. y4:msg_location=T2.P27
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=You want a dog that looks like an old man?
msgctxt "5472_Rio"
msgid "I really don't know."
msgstr "Realmente no lo sé."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=28
#. y4:msg_location=T2.P28
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sounds like fate. You should buy him.
msgctxt "5484_Akiyama"
msgid "Sounds like fate. There had to be a reason he was still at the pet store. Maybe he was waiting for you all this time? You should buy him."
msgstr "Si crees en los lazos, entonces adóptalo. Tal vez el que siga allí no sea una coincidencia... sino el destino."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=29
#. y4:msg_location=T2.P29
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sounds like fate. You should buy him.
msgctxt "5496_Rio"
msgid "Yeah, I think you're right. I kinda feel a connection to him."
msgstr "Sí, eso creo. De algún modo, me sentí muy conectada con él."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=30
#. y4:msg_location=T2.P30
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sounds like fate. You should buy him.
msgctxt "5508_Akiyama"
msgid "Don't overthink it, just follow your gut. Go back one more time and make your decision right there and then."
msgstr "Y bueno, no vas a quedarte dudando para siempre, ¿verdad? Ve a verlo una vez más y decide."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=31
#. y4:msg_location=T2.P31
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sounds like fate. You should buy him.
msgctxt "5520_Rio"
msgid "......"
msgstr "......"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=32
#. y4:msg_location=T2.P32
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sounds like fate. You should buy him.
msgctxt "5532_Rio"
msgid "You're right. I'll do that!"
msgstr "¡Tiene razón! ¡Eso voy a hacer!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=33
#. y4:msg_location=T2.P33
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sounds like fate. You should buy him.
msgctxt "5544_Akiyama"
msgid "Yeah, that's the best decision you could make."
msgstr "Sí, esa es la mejor decisión que podrías tomar."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=34
#. y4:msg_location=T2.P34
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Sounds like fate. You should buy him.
msgctxt "5556_Rio"
msgid "Thanks so much for the advice, Akiyama-san!"
msgstr "¡Gracias por el consejo, Akiyama-san!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=35
#. y4:msg_location=T2.P35
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you really want a dog that nobody else wants?
msgctxt "5568_Akiyama"
msgid "Do you really want a dog that nobody else wants? You can do better than that."
msgstr "¿De verdad te conformarías con un perro que nadie más quiso? Te mereces algo mejor."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=36
#. y4:msg_location=T2.P36
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you really want a dog that nobody else wants?
msgctxt "5580_Rio"
msgid "Maybe you're right..."
msgstr "Quizás tengas razón..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=37
#. y4:msg_location=T2.P37
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you really want a dog that nobody else wants?
msgctxt "5592_Akiyama"
msgid "He didn't look like an old man the first time you saw him, right? There's probably a reason why no one's bought him yet."
msgstr "Él no parecía un anciano la primera vez que lo viste, ¿verdad? Probablemente hay una razón por la que nadie lo compró todavía."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=38
#. y4:msg_location=T2.P38
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you really want a dog that nobody else wants?
msgctxt "5604_Rio"
msgid "I guess so, but still..."
msgstr "Supongo, pero aún así..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=39
#. y4:msg_location=T2.P39
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you really want a dog that nobody else wants?
msgctxt "5616_Rio"
msgid "That's a bit insensitive, don't you think?"
msgstr "Eso es un poco insensible, ¿no cree?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=40
#. y4:msg_location=T2.P40
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Do you really want a dog that nobody else wants?
msgctxt "5628_Akiyama"
msgid "Oh, yeah... Sorry..."
msgstr "Eh, sí. Lo siento..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=0
#. y4:msg_location=T3.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "5640_Rio"
msgid "I went on a photoshoot today. You know, for the magazine?"
msgstr "Hoy fui a una sesión de fotos. Para la revista."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=1
#. y4:msg_location=T3.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "5652_Akiyama"
msgid "Oh yeah. Did you finally decide on a name for your column?"
msgstr "Ah, sí. ¿Por fin has decidido un nombre para tu sección?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=2
#. y4:msg_location=T3.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "5664_Rio"
msgid "Hehe, oh yes I did! I'm going with \"Rio's All-Night Carnival\"!"
msgstr "Jeje, ¡oh sí! Me quede con ¡\"El Carnaval Nocturno de Rio\"!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=3
#. y4:msg_phrase=3
