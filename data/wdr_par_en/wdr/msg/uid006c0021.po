#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Yep, you sure are pretty.
msgctxt "6624_Erena"
msgid "Ya don't have to go that far. It just makes it sound like you're lyin'."
msgstr "No tienes por qué ir tan lejos. Solamente haces que suene como si estuvieras mintiendo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=25
#. y4:msg_location=T5.P25
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Yep, you sure are pretty.
msgctxt "6636_Akiyama"
msgid "I thought you said you didn't mind if it wasn't true."
msgstr "Pensé que habías dicho que no te importaba si no era verdad."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=26
#. y4:msg_location=T5.P26
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Yep, you sure are pretty.
msgctxt "6648_Erena"
msgid "Huh!? Ya mean you were lyin'!?"
msgstr "¡¿Eh?! ¡¿Estabas mintiendo?!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=27
#. y4:msg_location=T5.P27
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Yep, you sure are pretty.
msgctxt "6660_Akiyama"
msgid "What do you think?"
msgstr "¿Qué piensas?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=28
#. y4:msg_location=T5.P28
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Yep, you sure are pretty.
msgctxt "6672_Erena"
msgid "Hehe, I'm happy either way."
msgstr "Je, je. Soy feliz de todos modos."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
#. y4:msg_phrase=29
#. y4:msg_location=T5.P29
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Yep, you sure are pretty.
msgctxt "6684_Akiyama"
msgid "You just want to be flattered, huh?"
msgstr "Tú solo quieres que te halaguen, ¿eh?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=0
#. y4:msg_location=T6.P0
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "6696_Erena"
msgid "You look like you're a strong drinker."
msgstr "Parece que eres un bebedor empedernido."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=1
#. y4:msg_location=T6.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "6708_Akiyama"
msgid "I suppose I am."
msgstr "Supongo que lo soy."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=2
#. y4:msg_location=T6.P2
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "6720_Erena"
msgid "Really? Then by all means, drink up! Order something expensive!"
msgstr "¿En serio? Entonces, por supuesto, ¡bebe! ¡Pide algo caro!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=3
#. y4:msg_location=T6.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "6732_Akiyama"
msgid "What're you saying? The more expensive the drink, the longer you want to take to drink it. You have to really savor it."
msgstr "¿Pero qué dices? Cuanto más cara sea la bebida, más tiempo querrás tardar en beberla. Tienes que saborearla de verdad."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
#. y4:msg_phrase=4
#. y4:msg_location=T6.P4
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "6744_Erena"
msgid "What do you usually like to drink?"
msgstr "¿Qué te suele gustar beber?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=6
#. y4:msg_section_label=Conversación 6
#. y4:msg_talk=6
