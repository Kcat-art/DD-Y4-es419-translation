#. y4:msg_branch_segment=T0.P20..P25
#. y4:msg_branch_target_text=You did that for your boyfriend? Wow. I don't think most girls would do that.
#. y4:msg_branch_raw=01 11 00 14 00 00 00 25 00 00 00 00 00 00 00 00
msgctxt "17520_Kiryu"
msgid "You did that for your boyfriend? Wow."
msgstr "¿Dices que lo hiciste por tu novio? Vaya..."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=123
