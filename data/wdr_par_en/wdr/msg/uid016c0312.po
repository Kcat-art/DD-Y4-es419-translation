msgid "\"I'm tired, too. Maybe I can pet you, instead?\""
msgstr "\"Yo también estoy cansado. ¿Tal vez puedo acariciarte, en su lugar?\""

#. y4:line_status=translated
#. y4:translated_by=MasterCry
