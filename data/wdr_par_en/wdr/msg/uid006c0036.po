#. y4:msg_branch_raw=01 11 00 17 00 00 00 17 00 00 00 00 00 00 00 00
msgctxt "11316_Kiryu"
msgid "What do you want to do?"
msgstr "¿Qué quieres hacer?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=24
#. y4:msg_location=T19.P24
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=What do you want to do?
msgctxt "11328_松岡里緒奈：源氏名"
msgid "Me? What about you?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=25
#. y4:msg_location=T19.P25
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=What do you want to do?
msgctxt "11340_Kiryu"
msgid "You first."
msgstr "Tú primero."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=26
#. y4:msg_location=T19.P26
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=What do you want to do?
msgctxt "11352_松岡里緒奈：源氏名"
msgid "What!? This is so embarrassing..."
msgstr "¿¡Qué!? Esto es tan vergonzoso..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=27
#. y4:msg_location=T19.P27
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=What do you want to do?
msgctxt "11364_Kiryu"
msgid "Go on, I'm waiting."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=28
#. y4:msg_location=T19.P28
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=What do you want to do?
msgctxt "11376_松岡里緒奈：源氏名"
msgid "No, I can't talk about it! Just forget I brought it up."
msgstr "¡No, no puedo hablar de eso! Olvídate de que lo mencioné."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=19
#. y4:msg_section_label=Conversación 19
#. y4:msg_talk=19
#. y4:msg_phrase=29
#. y4:msg_location=T19.P29
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=What do you want to do?
msgctxt "11388_Kiryu"
msgid "You're blushing."
msgstr "Te estás sonrojando."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=0
#. y4:msg_location=T20.P0
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "11400_松岡里緒奈：源氏名"
msgid "I saw my dad yesterday by the side of the road on my way home from work."
msgstr "Ayer vi a mi padre al lado de la carretera cuando volvía del trabajo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=1
#. y4:msg_location=T20.P1
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
msgctxt "11412_Kiryu"
msgid "Really? Did you say anything to him?"
msgstr "¿De verdad? ¿Le dijiste algo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=2
#. y4:msg_location=T20.P2
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "11424_松岡里緒奈：源氏名"
msgid "No... He looked pretty drunk."
msgstr "No... Parecía bastante borracho."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=3
#. y4:msg_location=T20.P3
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "11436_松岡里緒奈：源氏名"
msgid "He never acted drunk when he was younger no matter how much he drank."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=4
#. y4:msg_location=T20.P4
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "11448_松岡里緒奈：源氏名"
msgid "He looked so sad... I couldn't bear to look at him."
msgstr "Parecía tan triste... No podía soportar mirarlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=2
#. y4:msg_phrase=37
#. y4:msg_location=T2.P37
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You'll get used to it eventually.
msgctxt "11460_Kiryu"
msgid "......"
msgstr "......"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=6
#. y4:msg_location=T20.P6
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=20
#. y4:msg_decision_choices=1. Everyone has problems. -> T20.P7 | 2. He probably wants to forget his money troubles. -> T20.P15 | 3. You should've talked to him. -> T20.P24
msgctxt "11472_松岡里緒奈：源氏名"
msgid "Maybe something's troubling him."
msgstr "Tal vez algo le esté preocupando."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=7
#. y4:msg_location=T20.P7
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Everyone has problems.
msgctxt "11484_Kiryu"
msgid "Everyone has problems. Some are just bigger than others."
msgstr "Todo el mundo tiene problemas. Algunos son simplemente más grandes que otros."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=8
#. y4:msg_location=T20.P8
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Everyone has problems.
msgctxt "11496_Kiryu"
msgid "Your father's no exception. After all, he hasn't seen his daughter for a long time."
msgstr "Tu padre no es una excepción. Después de todo, hace mucho tiempo que no ve a su hija."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=9
#. y4:msg_location=T20.P9
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Everyone has problems.
msgctxt "11508_松岡里緒奈：源氏名"
msgid "Yeah, true..."
msgstr "Sí, es verdad..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=10
#. y4:msg_location=T20.P10
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Everyone has problems.
msgctxt "11520_Kiryu"
msgid "Plus he's responsible for a whole stable of pro wrestlers."
msgstr "Además, es responsable de toda una cuadrilla de luchadores profesionales."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=11
#. y4:msg_location=T20.P11
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Everyone has problems.
msgctxt "11532_Kiryu"
msgid "That's got to be tougher than you imagine."
msgstr "Eso tiene que ser más difícil de lo que te imaginas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=12
#. y4:msg_location=T20.P12
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Everyone has problems.
msgctxt "11544_松岡里緒奈：源氏名"
msgid "I haven't been the best daughter, have I?"
msgstr "No he sido la mejor hija, ¿verdad?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=13
#. y4:msg_location=T20.P13
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Everyone has problems.
msgctxt "11556_Kiryu"
msgid "The fact that you can say that shows how much you've grown. Don't forget how you feel right now."
msgstr "El hecho de que puedas decir eso demuestra cuánto has crecido. No olvides cómo te sientes en este momento."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=14
#. y4:msg_location=T20.P14
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Everyone has problems.
msgctxt "11568_松岡里緒奈：源氏名"
msgid "I won't. I feel a bit better now."
msgstr "No lo haré. Ahora me siento un poco mejor."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=15
#. y4:msg_location=T20.P15
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He probably wants to forget his money troubles.
msgctxt "11580_Kiryu"
msgid "He probably wants to forget his money troubles. Being a father is hard, having to always act like nothing's wrong in front of your family."
msgstr "Probablemente quiere olvidar sus problemas de dinero. Ser padre es duro, tener que actuar siempre como si no pasara nada delante de tu familia."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=16
#. y4:msg_location=T20.P16
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He probably wants to forget his money troubles.
msgctxt "11592_松岡里緒奈：源氏名"
msgid "My mom did say something about a scary debt collector coming by the house..."
msgstr "Mi madre dijo algo sobre un cobrador de deudas que vino a casa..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=17
#. y4:msg_location=T20.P17
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He probably wants to forget his money troubles.
msgctxt "11604_Kiryu"
msgid "It may not be my place to say this, but you may be the only one who can cheer him up."
msgstr "Puede que no me corresponda a mí decir esto, pero puede que seas la única que pueda animarlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=18
#. y4:msg_location=T20.P18
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He probably wants to forget his money troubles.
msgctxt "11616_松岡里緒奈：源氏名"
msgid "Me?"
msgstr "¿Yo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=19
#. y4:msg_location=T20.P19
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He probably wants to forget his money troubles.
msgctxt "11628_Kiryu"
msgid "Yes. He hasn't seen your face in a long time. I'm sure it would make him feel better just to see your smile."
msgstr "Sí. No ha visto tu cara en mucho tiempo. Estoy seguro de que se sentiría mejor sólo con ver tu sonrisa."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=20
#. y4:msg_location=T20.P20
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He probably wants to forget his money troubles.
msgctxt "11640_Kiryu"
msgid "Don't look so worried. Just give him a smile."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=21
#. y4:msg_location=T20.P21
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He probably wants to forget his money troubles.
msgctxt "11652_松岡里緒奈：源氏名"
msgid "I hope I can..."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=22
#. y4:msg_location=T20.P22
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He probably wants to forget his money troubles.
msgctxt "11664_Kiryu"
msgid "You can do it."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=23
#. y4:msg_location=T20.P23
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=He probably wants to forget his money troubles.
msgctxt "11676_松岡里緒奈：源氏名"
msgid "Okay. I'll give it my best shot."
msgstr "Bien. Daré lo mejor de mí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=24
#. y4:msg_location=T20.P24
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should've talked to him.
msgctxt "11688_Kiryu"
msgid "You should've talked to him. It would've been a perfect chance to make up."
msgstr "Deberías haber hablado con él. Habría sido una oportunidad perfecta para hacer las paces."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=25
#. y4:msg_location=T20.P25
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should've talked to him.
msgctxt "11700_松岡里緒奈：源氏名"
msgid "No, that would have been impossible. I wasn't emotionally prepared for it."
msgstr "No, eso habría sido imposible. No estaba emocionalmente preparada para ello."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
#. y4:msg_section_label=Conversación 20
#. y4:msg_talk=20
#. y4:msg_phrase=26
#. y4:msg_location=T20.P26
#. y4:msg_speaker=Kiryu
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You should've talked to him.
msgctxt "11712_Kiryu"
msgid "What're you talking about? You don't need to prepare to talk to your own father. Just do it."
msgstr "¿De qué estás hablando? No es necesario que te prepares para hablar con tu propio padre. Sólo hazlo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=20
