#. y4:msg_location=T13.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "8712_Akiyama"
msgid "I didn't? Huh, that's weird! Anyway, what kind of guys do you like?"
msgstr "¿No lo hice? ¡Eh, qué raro! De todos modos, ¿qué tipo de chicos te gustan?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
