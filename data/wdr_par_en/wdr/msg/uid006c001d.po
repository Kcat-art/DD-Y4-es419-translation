#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "6744_Akiyama"
msgid "Table tennis, huh?"
msgstr "Ping-pong, ¿eh?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
#. y4:msg_talk=5
