#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1576_Minamida"
msgid "Of course, there's something in it for you too. If the machine is upgraded, the user will be able to receive various bits of useful information."
msgstr "Y por supuesto, también obtendrás algo a cambio. Si la máquina\n"
"se mejora, el usuario podrá acceder a información muy útil."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=19
#. y4:msg_location=T3.P19
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1588_Minamida"
msgid "Please think it over. Heheheh..."
msgstr "Solo pido que lo consideres. Je, je, je..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=0
#. y4:msg_location=T4.P0
#. y4:msg_speaker=Man in White
#. y4:msg_speaker_id=2
msgctxt "1600_Man in White"
msgid "Hm? Who are you? Do you need something?"
msgstr "¿Mm? ¿Quién eres? ¿Necesitas algo?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=1
#. y4:msg_location=T5.P1
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=13
msgctxt "1612_Saejima"
msgid "What's this machine with the electric chair? And more importantly, who are you?"
msgstr "¿Qué es esa máquina con la silla eléctrica?\n"
"Y lo más importante, ¿quién eres?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=2
#. y4:msg_location=T5.P2
#. y4:msg_speaker=Man in White
#. y4:msg_speaker_id=2
msgctxt "1624_Man in White"
msgid "My name is Minamida of course! I'm actually pretty famous, depending on which neck of the woods you're in."
msgstr "¡Yo soy Minamida! De hecho, soy muy famoso dependiendo\n"
"a quién le preguntes."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=3
#. y4:msg_location=T5.P3
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1636_Minamida"
msgid "And this, my friend, is the Inner Fighter VII Revolution. Or IF7-R, for short."
msgstr "Y esto, amigo mío, es el Inner Fighter VII Revolution.\n"
"O el IF7-R, para abreviar."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=5
#. y4:msg_location=T4.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "1648_Saejima"
msgid "The IF7-R?"
msgstr "¿El IF7-R?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=6
#. y4:msg_location=T4.P6
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1660_Minamida"
msgid "The IF7-R is the arcade machine of the future, and I invented it! Heheheh..."
msgstr "¡El IF7-R es la máquina de arcade del futuro, y la invente yo!\n"
"Je, je, je..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=6
#. y4:msg_location=T5.P6
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=13
msgctxt "1672_Saejima"
msgid "I don't get it. How can a machine be a game? This just looks like a fancy torture device."
msgstr "No lo entiendo. ¿Cómo una máquina podría ser un juego?\n"
"Esto parece una máquina de tortura moderna."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=7
#. y4:msg_location=T5.P7
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1684_Minamida"
msgid "How rude. This machine is the invention of the century!"
msgstr "Qué grosero. ¡Esta máquina es el invento del siglo!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=9
#. y4:msg_location=T4.P9
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1696_Minamida"
msgid "The IF7-R provides <Italic>the</Italic> ultimate arcade experience. It allows realistic battles in a virtual world."
msgstr "El IF7-R proporciona la experiencia de arcade <Italic>definitiva</Italic>.\n"
"Con ella tendrás peleas realistas en un mundo virtual."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=9
#. y4:msg_location=T5.P9
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=13
msgctxt "1708_Saejima"
msgid "......"
msgstr "......"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=10
#. y4:msg_location=T5.P10
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=13
msgctxt "1720_Saejima"
msgid "(I got absolutely no idea what this guy is talkin' about...)"
msgstr "(No tengo ni la menor idea de lo que está diciendo este tipo...)"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=11
#. y4:msg_location=T5.P11
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1732_Minamida"
msgid "Heheheh. Just give it a try and you'll understand."
msgstr "Je, je, je. Solo dale una oportunidad y lo entenderás."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=12
#. y4:msg_location=T5.P12
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1744_Minamida"
msgid "One game is 10,000 yen. Anybody can play, as long as they have the dough."
msgstr "Una partida cuesta 10.000 yenes. Cualquiera puede jugar,\n"
"mientras tenga el dinero."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=13
#. y4:msg_location=T5.P13
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=13
msgctxt "1756_Saejima"
msgid "I don't know what this thing does, and I can't see a reason to spend that much on a machine..."
msgstr "No sé lo que hace esta cosa, y no le veo una razón para gastar\n"
"tanto dinero en una máquina..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=14
#. y4:msg_location=T5.P14
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1768_Minamida"
msgid "Think about it the other way around. You're getting a 10,000 yen experience! Not so bad, right? Heheheh."
msgstr "Piénsalo de otra manera. ¡Estás obteniendo la experiencia de\n"
"10.000 yenes! Nada mal, ¿verdad? Je, je, je."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=8
#. y4:msg_location=T3.P8
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_decision_group=0
#. y4:msg_decision_choices=1. Explain -> T3.P11 | 2. That won't be necessary. -> T3.P9
msgctxt "1780_Minamida"
msgid "Do you want to hear a more detailed explanation on the machine?"
msgstr "¿Quieres que te explique más detalladamente como funciona?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=16
#. y4:msg_location=T5.P16
#. y4:msg_speaker=Saejima
#. y4:msg_speaker_id=13
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That won't be necessary.
msgctxt "1792_Saejima"
msgid "No, I'm good. I'll try it next time, when I got more time."
msgstr "No, estoy bien. Lo probaré la próxima vez que tenga tiempo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=18
#. y4:msg_location=T4.P18
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=That won't be necessary.
msgctxt "1804_Minamida"
msgid "I see. Then come back anytime if you want to play. I'll be waiting!"
msgstr "Ya veo. Bueno, vuelve cuando quieras jugar.\n"
"¡Te estaré esperando!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=11
#. y4:msg_location=T3.P11
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1816_Minamida"
msgid "Very well, I will explain in detail!"
msgstr "¡Bien, entonces te lo explicaré al detalle!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=12
#. y4:msg_location=T3.P12
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1828_Minamida"
msgid "To play, you must first <Color:7>input<Color:Default> information on your enemy."
msgstr "Para jugar, primero debes <Color:7>ingresar<Color:Default> la información sobre tu enemigo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=13
#. y4:msg_location=T3.P13
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1840_Minamida"
msgid "However, the only information you can <Color:7>input<Color:Default> is that of particularly strong enemies, ones who made a lasting impression on you."
msgstr "Sin embargo, la única información que puedes <Color:7>ingresar<Color:Default> es la de enemigos\n"
"particularmente fuertes que te dejaron con una gran impresión."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=14
#. y4:msg_location=T3.P14
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1852_Minamida"
msgid "If you <Color:7>input<Color:Default> an enemy and are victorious against him, you become stronger. Nifty, don't you think?"
msgstr "Si consigues <Color:7>ingresar<Color:Default> a un enemigo y lo derrotas\n"
"te volverás más fuerte. Una maravilla, ¿no crees?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=15
#. y4:msg_location=T3.P15
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1864_Minamida"
msgid "But, some punks broke the machine. And now that feature no longer works."
msgstr "Pero unos matones rompieron la máquina.\n"
"Y ahora esa función ya no sirve."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=16
#. y4:msg_location=T3.P16
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1876_Minamida"
msgid "I will need some money to be able to fix it, and that's where you come in!"
msgstr "Necesitaré algo de dinero para poder arreglarlo, ¡y ahí es donde\n"
"entras tú!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=17
#. y4:msg_location=T3.P17
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1888_Minamida"
msgid "Would you mind donating some funds so I can repair and modify this baby? I might not look it, but I'm flat broke."
msgstr "¿Te importaría donar fondos para que le haga unos arreglitos a\n"
"esta belleza? No lo aparento, pero estoy en la ruina."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=2
#. y4:msg_section_label=Conversación 2
#. y4:msg_talk=5
#. y4:msg_phrase=25
#. y4:msg_location=T5.P25
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1900_Minamida"
msgid "Of course, there's something in it for you too. If the machine is upgraded, the player will be able to receive various bits of useful information."
msgstr "Y por supuesto, también obtendrás algo a cambio. Si la máquina\n"
"se mejora, el usuario podrá acceder a información muy útil."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=19
#. y4:msg_location=T3.P19
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Explain
msgctxt "1912_Minamida"
msgid "Please think it over. Heheheh..."
msgstr "Solo pido que lo consideres. Je, je, je..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=6
#. y4:msg_phrase=0
#. y4:msg_location=T6.P0
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1924_Minamida"
msgid "Oh, it's you! I didn't have a chance to thank you for saving me."
msgstr "¡Ah, eres tú! No tuve la oportunidad de agradecerte por salvarme."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=6
#. y4:msg_phrase=1
#. y4:msg_location=T6.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=15
msgctxt "1936_Akiyama"
msgid "I don't need any thanks. I was in too much of a hurry to ask before, but what's this machine about?"
msgstr "No hace falta. Tenía mucha prisa para preguntarte antes, pero\n"
"¿qué hace esta máquina?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=3
#. y4:msg_phrase=4
#. y4:msg_location=T3.P4
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1948_Minamida"
msgid "I call this the Inner Fighter VII Revolution! Or the IF7-R, for short."
msgstr "¡Lo llamo Inner Fighter VII Revolution! O simplemente\n"
"IF7-R, para abreviar."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=5
#. y4:msg_location=T4.P5
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=4
msgctxt "1960_Akiyama"
msgid "The IF7-R?"
msgstr "¿El IF7-R?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=6
#. y4:msg_location=T4.P6
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1972_Minamida"
msgid "The IF7-R is the arcade machine of the future, and I invented it! Heheheh..."
msgstr "¡El IF7-R es la máquina de arcade del futuro, y la invente yo!\n"
"Je, je, je..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=6
#. y4:msg_phrase=5
#. y4:msg_location=T6.P5
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=15
msgctxt "1984_Akiyama"
msgid "An arcade machine? This thing's a game?"
msgstr "¿Una máquina de arcade? ¿Esta cosa es un juego?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=6
#. y4:msg_phrase=6
#. y4:msg_location=T6.P6
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "1996_Minamida"
msgid "Simply put, yes. But it's quite different from any game you've ever seen."
msgstr "En pocas palabras, sí. Pero es muy diferente a cualquier\n"
"otro que hayas visto."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=4
#. y4:msg_phrase=9
#. y4:msg_location=T4.P9
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "2008_Minamida"
msgid "The IF7-R provides <Italic>the</Italic> ultimate arcade experience. It allows realistic battles in a virtual world."
msgstr "El IF7-R proporciona la experiencia de arcade <Italic>definitiva</Italic>.\n"
"Con ella tendrás peleas realistas en un mundo virtual."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=6
#. y4:msg_phrase=8
#. y4:msg_location=T6.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=15
msgctxt "2020_Akiyama"
msgid "Sounds pretty bogus to me."
msgstr "Suena a puro cuento para mi."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=6
#. y4:msg_phrase=9
#. y4:msg_location=T6.P9
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "2032_Minamida"
msgid "Well, can't blame you for saying that. I mean, it is pretty unbelievable! But what you see here will make the unbelievable believable!"
msgstr "Bueno, no te culpo por decir eso. ¡Lo sé, es de locos! ¡Pero lo\n"
"que verás aquí hará que lo increíble se vuelva realidad!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=6
#. y4:msg_phrase=10
#. y4:msg_location=T6.P10
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "2044_Minamida"
msgid "If you're going to call me a liar, then you should give it a try first. Heheheh."
msgstr "Si vas a tratarme de mentiroso, entonces deberías intentarlo\n"
"primero. Je, je, je."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
#. y4:msg_talk=6
#. y4:msg_phrase=11
#. y4:msg_location=T6.P11
#. y4:msg_speaker=Minamida
#. y4:msg_speaker_id=1
msgctxt "2056_Minamida"
msgid "One game is 10,000 yen. The price is actually a bargain when compared to the value of the experience you're getting."
msgstr "Jugar una partida cuesta 10.000 yenes. El precio es una ganga\n"
"comparada con la experiencia que obtendrás."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
