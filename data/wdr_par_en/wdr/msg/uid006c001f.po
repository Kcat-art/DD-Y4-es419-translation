#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're just saying that.
msgctxt "4356_Noa"
msgid "Hehe! It's not like that at all!"
msgstr "¡A-ha-ha! ♪ ¡No lo hacía por eso! ¡No te hagas ideas erróneas!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=24
#. y4:msg_location=T0.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You're just saying that.
msgctxt "4368_Akiyama"
msgid "Are you sure this isn't just the alcohol talking?"
msgstr "¿De verdad? Entonces es algo peor..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
