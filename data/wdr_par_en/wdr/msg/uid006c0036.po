#. y4:msg_choice_index=3
#. y4:msg_branch_choice=Want me to go with you?
msgctxt "12108_松岡里緒奈：源氏名"
msgid "But... I think it's best I go alone."
msgstr "Pero... Creo que es mejor que vaya sola."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=28
