msgctxt "392"
msgid "Quit"
msgstr "Salir"

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "397"
msgid "Cancel the order."
msgstr "Cancelar el pedido."

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "415"
msgid "Order"
msgstr "Pagar"

#. y4:line_status=translated
msgctxt "421"
msgid "Order the currently selected item.  "
msgstr "Pedir el objeto actualmente seleccionado.  "

#. y4:line_status=translated
#. y4:translated_by=dani64amv
msgctxt "458"
msgid "(I haven't picked anything.)  "
msgstr "(No he escogido nada)."

#. y4:line_status=reviewed
#. y4:translated_by=dani64amv
#. y4:reviewed_by=dani64amv
msgctxt "489"
msgid "(I'm short on cash.)  "
msgstr "(Me hace falta dinero)."

#. y4:line_status=translated
msgctxt "512"
msgid "Will that be all for you?"
msgstr "¿Eso será todo?"

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "538"
msgid "(I can't carry any more stuff.)"
msgstr "(No puedo llevar más cosas)."

#. y4:line_status=reviewed
#. y4:reviewed_by=dani64amv
msgctxt "570"
msgid "(They're sold out.)"
msgstr "(Están agotados)."

#. y4:line_status=translated
msgctxt "590"
msgid "The king of champagnes. Sure to turn heads."
msgstr "El rey de los champagnes. Seguro que atraerá\ntodas las miradas."

#. y4:line_status=translated
msgctxt "634"
msgid "Classy champagne for a classy man."
msgstr "Champán con clase para un hombre con clase."

#. y4:line_status=translated
msgctxt "669"
msgid "A slightly more premium champagne for the\ndiscerning customer."
msgstr "Un champán ligeramente prémium para un\ncliente más exigente."

#. y4:line_status=translated
msgctxt "732"
msgid "A middle-of-the-road champagne. Not bad, but\nnothing too special."
msgstr "Un champán de calidad media. No está mal, pero\nnada demasiado especial."

#. y4:line_status=reviewed
#. y4:reviewed_by=sasha
msgctxt "798"
msgid "A Yamazaki whisky made with carefully selected,\nmature malts for a flavorful, smooth finish."
msgstr "Un whisky Yamazaki elaborado con maltas\ncuidadosamente seleccionadas y maduras, que\nofrecen un sabor rico y un final suave."

#. y4:line_status=translated
msgctxt "891"
msgid "A simple draft beer with a nice head of foam."
msgstr "Una cerveza de barril sencilla con una buena\nespuma."

#. y4:line_status=translated
msgctxt "937"
msgid "This is a cocktail of crème de cassis liqueur and \norange juice."
msgstr "Este es un cóctel de licor de crème de cassis y \njugo de naranja."

#. y4:line_status=translated
msgctxt "1003"
msgid "Plain old orange juice, pulp and all."
msgstr "Jugo de naranja, con pulpa y todo."

#. y4:line_status=translated
msgctxt "1041"
msgid "A clean spring water soju made with premier Korean\nbarley."
msgstr "Un soju de agua de manantial limpia elaborado con cebada coreana de primera calidad."

