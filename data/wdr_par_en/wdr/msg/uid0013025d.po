msgid "No problem."
msgstr "Sin problemas."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=10
#. y4:msg_location=T1.P10
#. y4:msg_speaker=Man in Disguise
#. y4:msg_speaker_id=0
msgctxt "204_Man in Disguise"
msgid "This lets me sell my stuff without anyone suspecting a thing. Even if I raise suspicions, people will think it's the Kamurocho Guard."
msgstr "Je, je... Con esto puedo vender mis productos sin problemas. Si alguien sospecha, la culpa será de los Guardianes de Kamurocho."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=11
#. y4:msg_location=T1.P11
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
msgctxt "216_Tanimura"
msgid "Hey."
msgstr "Oye."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=12
#. y4:msg_location=T1.P12
#. y4:msg_speaker=Man in Disguise
#. y4:msg_speaker_id=0
msgctxt "228_Man in Disguise"
msgid "Yikes!"
msgstr "¡Vaya!"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=13
#. y4:msg_location=T1.P13
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
msgctxt "240_Tanimura"
msgid "Cosplaying and selling weapons? Real nice."
msgstr "¿Vendiendo armas mientras haces cosplay?, mis respetos."

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=14
#. y4:msg_location=T1.P14
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
msgctxt "252_Tanimura"
msgid "Look, you're causing a lot of headaches by dressing up like that. But I'm sure you already know that, don't you?"
msgstr "Sabes perfectamente que tu atuendo está causando problemas a ciertas personas. Lo haces a propósito, ¿no?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=15
#. y4:msg_location=T1.P15
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=6
msgctxt "264_Tanimura"
msgid "I have some questions for you, so how about you come with me?"
msgstr "Tengo algunas preguntas para ti, ¿qué te parece si vienes conmigo?"

#. y4:msg_type=dialogue
#. y4:msg_label=Diálogo
#. y4:msg_talk=1
#. y4:msg_phrase=16
#. y4:msg_location=T1.P16
#. y4:msg_speaker=Man in Disguise
#. y4:msg_speaker_id=0
msgctxt "276_Man in Disguise"
msgid "The hell I will! Shit, this's become a real pain in the ass, 'cause now I gotta get rid of you!"
msgstr "¡Ni de broma! ¡Mierda, esto se ha vuelto un dolor de cabeza, porque ahora tengo que deshacerme de ti!"
