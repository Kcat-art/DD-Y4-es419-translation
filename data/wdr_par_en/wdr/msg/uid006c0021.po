#. y4:msg_location=T22.P0
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "12552_Erena"
msgid "Now I'm afraid to get involved with someone again..."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=1
#. y4:msg_location=T22.P1
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "12564_Akiyama"
msgid "Why? People break up all the time."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=2
#. y4:msg_location=T22.P2
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "12576_Erena"
msgid "Yeah, but if it's always going to be like this..."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=3
#. y4:msg_location=T22.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
msgctxt "12588_Akiyama"
msgid "Like what?"
msgstr "Un sueño..."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=22
#. y4:msg_section_label=Conversación 22
#. y4:msg_talk=22
#. y4:msg_phrase=4
#. y4:msg_location=T22.P4
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
msgctxt "12600_Erena"
msgid "Always worrying about what the other person is thinking. Not being able to be yourself. I just end up gettin' sick of it after a while."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=11
#. y4:msg_section_label=Conversación 11
#. y4:msg_talk=11
#. y4:msg_phrase=21
#. y4:msg_location=T11.P21
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Maybe you're just working too hard at it.
msgctxt "12612_Akiyama"
msgid "I see..."
msgstr "Ya veo..."

#. y4:msg_type=decision
