msgctxt "116_Tanimura"
msgid "...So? How was it?"
msgstr "... ¿Así que? ¿Cómo te fue?"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=1
#. y4:msg_location=T0.P1
#. y4:msg_speaker=Smith
#. y4:msg_speaker_id=2
msgctxt "128_Smith"
msgid "It was good! It was worth coming to Japan just for this!"
msgstr "¡Estuvo bueno! ¡Valió la pena venir a Japón solo por esto!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=2
#. y4:msg_location=T0.P2
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "140_Tanimura"
msgid "Right? I knew this was the place you meant!"
msgstr "¿Verdad? ¡Sabía que este era el lugar al que te referías!"

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=3
#. y4:msg_location=T0.P3
#. y4:msg_speaker=Smith
#. y4:msg_speaker_id=2
msgctxt "152_Smith"
msgid "Actually, it wasn't."
msgstr "En realidad, no fue así."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=0
#. y4:msg_section_label=Conversación 0
#. y4:msg_talk=0
#. y4:msg_phrase=4
#. y4:msg_location=T0.P4
#. y4:msg_speaker=Tanimura
#. y4:msg_speaker_id=0
msgctxt "164_Tanimura"
msgid "What the heck..."
msgstr "¿Qué diablos?"

#. y4:line_status=translated
msgctxt "176_Smith"
msgid "I mean, I did have a good time, but that's just a\\r\ncoincidence. This wasn't the place I was talking\\r\nabout originally."
msgstr "Quiero decir, la pasé bien, pero eso es solo una\\r\ncoincidencia. Este no era el lugar sobre el que estaba hablando\\r\noriginalmente."

#. y4:line_status=translated
msgctxt "188_Smith"
msgid "I'll tell you one more time. A men's only place\\r\nwhere everybody's naked!"
msgstr "Te lo diré una vez más. ¡Un lugar solo para hombres\\r\ndonde todo el mundo está desnudo!"

#. y4:line_status=translated
#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=0
