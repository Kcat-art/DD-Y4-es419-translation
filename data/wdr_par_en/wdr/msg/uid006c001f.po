msgid "Oh man, you have to hear this."
msgstr "Oiga, Akiyama-san, tiene que escuchar esto."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=5
#. y4:msg_section_label=Conversación 5
