#. y4:msg_speaker=Ami
#. y4:msg_speaker_id=3
msgctxt "108_Ami"
msgid "Ooh, are you getting jealous?"
msgstr "¿Ooh, estás celosa?"

#. y4:line_status=translated
msgctxt "120_Freeloader"
msgid "No way! Just, er, come right home after you clock out.\\r\nI'll have dinner waiting for you."
msgstr "¡Qué va! Solo, em, te vienes derechito a casa en cuanto\\r\nsalgas del trabajo. Te espero con la cena lista."

#. y4:line_status=translated
#. y4:msg_type=dialogue
