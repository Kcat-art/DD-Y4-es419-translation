msgstr "Ya te acostumbrarás."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=35
#. y4:msg_phrase=3
#. y4:msg_location=T35.P3
#. y4:msg_speaker=Chihiro
#. y4:msg_speaker_id=3
msgctxt "2736_Chihiro"
msgid "I don't know. I get so nervous and clumsy sometimes. Do you really think anyone would want to request me?"
msgstr "Ay no sé... Me pongo muy nerviosa y soy torpe. ¿Realmente piensa que alguien querría solicitarme?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=1
#. y4:msg_section_label=Conversación 1
#. y4:msg_talk=35
#. y4:msg_phrase=4
#. y4:msg_location=T35.P4
#. y4:msg_speaker=Noa
#. y4:msg_speaker_id=29
msgctxt "2748_Noa"
