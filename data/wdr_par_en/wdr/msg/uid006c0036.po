msgstr "... ¿Has comido algo hoy?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=4
#. y4:msg_location=T28.P4
#. y4:msg_speaker=譚ｾ蟯｡驥檎ｷ貞･茨ｼ壽ｺ先ｰ丞錐
#. y4:msg_speaker_id=2
msgctxt "14448_松岡里緒奈：源氏名"
msgid "I started my diet this morning."
msgstr "Comencé mi dieta esta mañana."

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=28
#. y4:msg_section_label=Conversación 28
#. y4:msg_talk=28
#. y4:msg_phrase=5
