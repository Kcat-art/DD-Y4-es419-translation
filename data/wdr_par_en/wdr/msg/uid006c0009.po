msgctxt "9408_Maya"
msgid "I dunno. There's just something wrong about the girl being the one to say it."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=15
#. y4:msg_section_label=Conversación 15
