#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you sure you didn't love him?
msgctxt "12432_Erena"
msgid "I guess you're right..."
msgstr "Supongo que tiene razón..."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=18
#. y4:msg_location=T21.P18
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you sure you didn't love him?
msgctxt "12444_Erena"
msgid "Sorry. I'll probably be like this for a while. I hope it won't be too depressing for you."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=19
#. y4:msg_location=T21.P19
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=Are you sure you didn't love him?
msgctxt "12456_Akiyama"
msgid "Don't worry about it."
msgstr "No hay de que."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=20
#. y4:msg_location=T21.P20
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You jumped into that relationship too quickly.
msgctxt "12468_Akiyama"
msgid "You jumped into that relationship too quickly. You should've waited until you knew a little more about each other before going out."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=21
#. y4:msg_location=T21.P21
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You jumped into that relationship too quickly.
msgctxt "12480_Erena"
msgid "But then we'd have never gone out. Ain't that right?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=22
#. y4:msg_location=T21.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You jumped into that relationship too quickly.
msgctxt "12492_Akiyama"
msgid "Well... I suppose that's one way to look at it."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=23
#. y4:msg_location=T21.P23
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You jumped into that relationship too quickly.
msgctxt "12504_Erena"
msgid "Then it don't matter if you jump into a relationship."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=24
#. y4:msg_location=T21.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You jumped into that relationship too quickly.
msgctxt "12516_Akiyama"
msgid "Maybe, but I can't help but think that going out with a guy who picks you up off the street isn't the best idea."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=25
#. y4:msg_location=T21.P25
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You jumped into that relationship too quickly.
msgctxt "12528_Erena"
msgid "Oh, I'm not so sure about that. I know people who started going out that way and got married."
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=21
#. y4:msg_section_label=Conversación 21
#. y4:msg_talk=21
#. y4:msg_phrase=26
#. y4:msg_location=T21.P26
#. y4:msg_speaker=Erena
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=You jumped into that relationship too quickly.
msgctxt "12540_Erena"
msgid "I really don't like the way you're assumin' that I'm the one at fault here."
msgstr ""

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
