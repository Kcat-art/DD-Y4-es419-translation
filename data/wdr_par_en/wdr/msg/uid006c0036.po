#. y4:msg_decision_choices=1. I'll get revenge for you. -> T27.P7 | 2. You shouldn't be drinking that much. -> T27.P14 | 3. Are you sure you're a strong drinker? -> T27.P21
msgctxt "14136_松岡里緒奈：源氏名"
msgid "It's the only time I've ever lost a drinking contest! I still can't believe it!"
msgstr "¡Es la única vez que he perdido en una competencia de bebidas! ¡Todavía no puedo creerlo!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=27
#. y4:msg_section_label=Conversación 27
#. y4:msg_talk=27
