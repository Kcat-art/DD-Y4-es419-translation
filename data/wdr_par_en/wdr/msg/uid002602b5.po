#. y4:msg_speaker=Cat-loving Homeless Man
#. y4:msg_speaker_id=0
msgctxt "1336_Cat-loving Homeless Man"
msgid "That's odd. My old cat Miko would always come right up to me when I did that."
msgstr "Qué raro... Mi viejo gato Miko venía\\r\nsiempre que le hacía así."

#. y4:line_status=translated
#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=3
#. y4:msg_section_label=Conversación 3
