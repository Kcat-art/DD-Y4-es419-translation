#. y4:item_icon=2d_ys_fish_coelacanthus
#. y4:item_field=description
#. y4:item_pair_context=23358
msgctxt "99763"
msgid "Known as a \"living fossil.\""
msgstr "Conocido como un 'fósil viviente.'"

#. y4:line_status=translated
#. y4:item_index=244
