msgctxt "11112_Akiyama"
msgid "Yeah."
msgstr "Sí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=3
#. y4:msg_location=T13.P3
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11124_Rio"
msgid "Well, sure. Doesn't everyone?"
msgstr "Bueno, claro. ¿Quién no lo ha hecho?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=4
#. y4:msg_location=T13.P4
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11136_Akiyama"
msgid "Sure, but I'm asking what <Italic>you</Italic> have done, not everyone else."
msgstr "Claro, pero yo te estoy preguntando qué has hecho <Italic>tú</Italic>, no los demás."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=5
#. y4:msg_location=T13.P5
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11148_Rio"
msgid "Well, once I came out of the bathroom and didn't realize that my panties were up around my waist."
msgstr "Pues una vez salí del baño sin darme cuenta de que tenía las bragas subidas hasta la cintura."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=6
#. y4:msg_location=T13.P6
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11160_Akiyama"
msgid "Huh? How'd that happen?"
msgstr "¿Eh? ¿Cómo pasó eso?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=7
#. y4:msg_location=T13.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11172_Rio"
msgid "I had taken them completely off, and when I put them back on, I somehow put both legs through one leg hole and pulled them up."
msgstr "Me las había quitado por completo, y cuando me las volví a poner, de alguna manera metí las dos piernas por un solo agujero y me las subí."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=8
#. y4:msg_location=T13.P8
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11184_Akiyama"
msgid "What!? How did you fit?"
msgstr "¿¡Qué!? ¿Cómo hiciste para caber?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=9
#. y4:msg_location=T13.P9
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11196_Rio"
msgid "I was thinner back then. About eight kilos lighter than I am now."
msgstr "Era más delgada en ese entonces. Como ocho kilos menos que ahora."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=10
#. y4:msg_location=T13.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11208_Akiyama"
msgid "Eight kilos less than now? You must've been just skin and bones!"
msgstr "¿Ocho kilos menos? ¡Debes haber solo piel y huesos!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=11
#. y4:msg_location=T13.P11
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11220_Rio"
msgid "I'm short, so I thought it was the right weight for me. I got told to gain some weight later, though."
msgstr "Soy bajita, así que pensaba que era el peso justo para mí. Después me dijeron que debía subir de peso."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=12
#. y4:msg_location=T13.P12
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11232_Rio"
msgid "Dresses don't look good if you're too thin."
msgstr "Los vestidos no lucen bien si estás demasiado delgada."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=13
#. y4:msg_location=T13.P13
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11244_Akiyama"
msgid "Now I understand how you could fit both of your legs in one hole, but that's still pretty crazy."
msgstr "Ahora entiendo cómo pudiste meter ambas piernas por un solo agujero, pero sigue siendo bastante loco."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=14
#. y4:msg_location=T13.P14
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11256_Rio"
msgid "No, it gets even better!"
msgstr "¡No, se pone aún mejor!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=15
#. y4:msg_location=T13.P15
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11268_Akiyama"
msgid "I can't imagine how."
msgstr "No puedo imaginar cómo."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=16
#. y4:msg_location=T13.P16
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11280_Rio"
msgid "I was wearing overalls at the time!"
msgstr "¡En aquel tiempo llevaba overoles!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=17
#. y4:msg_location=T13.P17
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11292_Rio"
msgid "That means I had taken my overalls and panties completely off, used the toilet, and then put them back on in the wrong order."
msgstr "Eso significa que me había quitado el overol y las bragas por completo, usé el baño, y luego me lo puse todo en el orden equivocado."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=18
#. y4:msg_location=T13.P18
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11304_Akiyama"
msgid "You don't remember doing it?"
msgstr "¿No recuerdas haberlo hecho?"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=19
#. y4:msg_location=T13.P19
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=13
#. y4:msg_decision_choices=1. Do you tend to black out when you drink? -> T13.P20 | 2. I don't believe you. -> T13.P27 | 3. I bet you were embarrassed when you noticed. -> T13.P33
msgctxt "11316_Rio"
msgid "Not at all."
msgstr ""

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=160
#. y4:msg_phrase=0
#. y4:msg_location=T160.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T13.P20
#. y4:msg_branch_segment=T13.P20..P26
#. y4:msg_branch_target_text=Do you tend to black out when you drink?
#. y4:msg_branch_raw=01 11 00 14 00 00 00 28 00 00 00 00 00 00 00 00
msgctxt "11328_Akiyama"
msgid "Do you tend to black out when you drink?"
msgstr "¿Tiendes a tener lagunas mentales cuando bebes?"

msgctxt "11340_Rio"
msgid "Maaaybe. ♪"
msgstr "Puede seeer. ♪"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=22
#. y4:msg_location=T13.P22
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Do you tend to black out when you drink?
msgctxt "11352_Akiyama"
msgid "No maybe about it. I think we can file that one under \"definitely.\""
msgstr "Nada de \"Puede seeer\". Creo que podemos archivar eso bajo \"definitivamente\"."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=23
#. y4:msg_location=T13.P23
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Do you tend to black out when you drink?
msgctxt "11364_Rio"
msgid "Hehehe. I mean, I don't even know if I lose my memory or not! Doesn't that count?"
msgstr ""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=24
#. y4:msg_location=T13.P24
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Do you tend to black out when you drink?
msgctxt "11376_Akiyama"
msgid "Hmm... Well, I guess everyone has embarrassing stories from some point in their lives."
msgstr "Hmm… Bueno, supongo que todos tienen historias vergonzosas en algún momento de sus vidas."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=25
#. y4:msg_location=T13.P25
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Do you tend to black out when you drink?
msgctxt "11388_Rio"
msgid "You're very understanding, Akiyama-san. When I noticed what I'd done, I was totally stumped as to how it happened."
msgstr "Usted es muy comprensivo, Akiyama-san. Cuando me di cuenta de lo que había hecho, estaba completamente perpleja sobre cómo había pasado."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=26
#. y4:msg_location=T13.P26
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=Do you tend to black out when you drink?
msgctxt "11400_Akiyama"
msgid "Heh, I get you."
msgstr "Je, te entiendo."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=161
#. y4:msg_phrase=0
#. y4:msg_location=T161.P0
#. y4:msg_choice_index=2
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T13.P27
#. y4:msg_branch_segment=T13.P27..P32
#. y4:msg_branch_target_text=I don't believe you.
#. y4:msg_branch_raw=01 11 00 1b 00 00 00 14 00 00 00 00 00 00 00 00
msgctxt "11412_Akiyama"
msgid "I don't believe you."
msgstr "No te creo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=28
#. y4:msg_location=T13.P28
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't believe you.
msgctxt "11424_Rio"
msgid "I don't blame you. When I realized what I'd done, I was so surprised that I sobered up immediately!"
msgstr "No lo culpo. Cuando me di cuenta de lo que hice, ¡me sorprendí tanto que inmediatamente me puse sobria!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=29
#. y4:msg_location=T13.P29
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't believe you.
msgctxt "11436_Akiyama"
msgid "Did anyone say anything?"
msgstr "¿Alguien dijo algo?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=30
#. y4:msg_location=T13.P30
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't believe you.
msgctxt "11448_Rio"
msgid "Luckily everybody else was drunk, too. I don't think anyone even noticed."
msgstr "Por suerte todos los demás también estaban borrachos. No creo que nadie se haya dado cuenta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=31
#. y4:msg_location=T13.P31
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=2
#. y4:msg_branch_choice=I don't believe you.
msgctxt "11460_Akiyama"
msgid "That's the silver lining, I guess."
msgstr "Esa es la parte buena, supongo."

msgctxt "11472_Rio"
msgid "Yep! ♪"
msgstr "¡Sip! ♪"

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=162
#. y4:msg_phrase=0
#. y4:msg_location=T162.P0
#. y4:msg_choice_index=3
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T13.P33
#. y4:msg_branch_segment=T13.P33..P38
#. y4:msg_branch_target_text=I bet you were embarrassed when you noticed.
#. y4:msg_branch_raw=01 11 00 21 00 00 00 2c 00 00 00 00 00 00 00 00
msgctxt "11484_Akiyama"
msgid "I bet you were embarrassed when you noticed."
msgstr "Apuesto a que estabas avergonzada cuando te diste cuenta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=34
#. y4:msg_location=T13.P34
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you were embarrassed when you noticed.
msgctxt "11496_Rio"
msgid "When I noticed, I was like, \"How on earth did this happen!?\""
msgstr "Cuando me di cuenta, pensé: \"¿¡Cómo diablos sucedió esto?!\""

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=35
#. y4:msg_location=T13.P35
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you were embarrassed when you noticed.
msgctxt "11508_Akiyama"
msgid "I see... So you were more worried about the how than the why, huh?"
msgstr "Ya veo... Así que estabas más preocupada por el cómo que por el por qué, ¿eh?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=36
#. y4:msg_location=T13.P36
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you were embarrassed when you noticed.
msgctxt "11520_Rio"
msgid "Yep."
msgstr "Sí."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=37
#. y4:msg_location=T13.P37
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you were embarrassed when you noticed.
msgctxt "11532_Rio"
msgid "But the more I thought about what happened, the more embarrassed I got! Hehehe."
msgstr "Pero cuanto más pensaba en lo que pasó, ¡más vergüenza me daba! Je, je, je."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=13
#. y4:msg_section_label=Conversación 13
#. y4:msg_talk=13
#. y4:msg_phrase=38
#. y4:msg_location=T13.P38
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=3
#. y4:msg_branch_choice=I bet you were embarrassed when you noticed.
msgctxt "11544_Akiyama"
msgid "Heh, I can imagine."
msgstr "Je, me lo imagino."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=0
#. y4:msg_location=T14.P0
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11556_Rio"
msgid "A new girl joined the club recently."
msgstr "Una chica nueva se unió al club hace poco."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=1
#. y4:msg_location=T14.P1
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11568_Rio"
msgid "She seemed kinda sad the first time we talked, so I got a bit worried about her."
msgstr "Parecía un poco triste la primera vez que hablamos, así que me preocupé un poco por ella."

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=2
#. y4:msg_location=T14.P2
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11580_Rio"
msgid "But the other day when we were talking, she suddenly started laughing like a maniac!"
msgstr "Pero el otro día, mientras hablábamos, ¡de repente empezó a reírse como loca!"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=3
#. y4:msg_location=T14.P3
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
msgctxt "11592_Akiyama"
msgid "Uh... Why?"
msgstr "Eh... ¿Por qué?"

#. y4:msg_type=pre_context
#. y4:msg_label=Contexto previo
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=4
#. y4:msg_location=T14.P4
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
msgctxt "11604_Rio"
msgid "Hehe. She said I made a funny face and couldn't help but laugh!"
msgstr "Je, je. ¡Ella dijo que hice una cara graciosa y no podía dejar de reír!"

#. y4:msg_type=decision
#. y4:msg_label=Pregunta con opciones
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=5
#. y4:msg_location=T14.P5
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_decision_group=14
#. y4:msg_decision_choices=1. I can't imagine you making weird faces. -> T14.P6 | 2. I can tell you care about the other girls. -> T14.P13 | 3. Show me the face you made. -> T14.P20
msgctxt "11616_Rio"
msgid "She's sooo cute when she laughs. She's a really nice girl."
msgstr "Es taaan linda cuando se ríe. Es una chica muy simpática."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=163
#. y4:msg_phrase=0
#. y4:msg_location=T163.P0
#. y4:msg_choice_index=1
#. y4:msg_branch_opcode=0x0111
#. y4:msg_branch_target=T14.P6
#. y4:msg_branch_segment=T14.P6..P12
#. y4:msg_branch_target_text=I can't imagine you making weird faces.
#. y4:msg_branch_raw=01 11 00 06 00 00 00 27 00 00 00 00 00 00 00 00
msgctxt "11628_Akiyama"
msgid "I can't imagine you making weird faces."
msgstr "No puedo imaginarte haciendo caras raras."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=7
#. y4:msg_location=T14.P7
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I can't imagine you making weird faces.
msgctxt "11640_Rio"
msgid "Well, I do sometimes. Especially when I'm with people I'm close to. When I'm relaxed, I make faces without realizing it."
msgstr "Bueno, a veces lo hago. Sobre todo cuando estoy con gente cercana. Cuando estoy relajada, hago muecas sin darme cuenta."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=8
#. y4:msg_location=T14.P8
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I can't imagine you making weird faces.
msgctxt "11652_Rio"
msgid "Don't you ever do things like that, Akiyama-san?"
msgstr "¿Usted nunca hace cosas así, Akiyama-san?"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=9
#. y4:msg_location=T14.P9
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I can't imagine you making weird faces.
msgctxt "11664_Akiyama"
msgid "Hmm, with my face, you probably couldn't tell. I'm not that expressive."
msgstr "Hmm, con mi cara probablemente ni se notaría. No soy muy expresivo."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=10
#. y4:msg_location=T14.P10
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I can't imagine you making weird faces.
msgctxt "11676_Akiyama"
msgid "And it's not like I'm that good looking either. I'm just some guy."
msgstr "Y tampoco es que sea muy atractivo. Solo soy un tipo cualquiera."

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=11
#. y4:msg_location=T14.P11
#. y4:msg_speaker=Rio
#. y4:msg_speaker_id=2
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I can't imagine you making weird faces.
msgctxt "11688_Rio"
msgid "That's not true! You've got a wonderful face!"
msgstr "¡Eso no es verdad! ¡Usted tiene una cara maravillosa!"

#. y4:msg_type=branch_dialogue
#. y4:msg_label=Respuesta de rama
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=14
#. y4:msg_phrase=12
#. y4:msg_location=T14.P12
#. y4:msg_speaker=Akiyama
#. y4:msg_speaker_id=0
#. y4:msg_choice_index=1
#. y4:msg_branch_choice=I can't imagine you making weird faces.
msgctxt "11700_Akiyama"
msgid "Heh, if you say so."
msgstr "Je, si tú lo dices."

#. y4:msg_type=choice
#. y4:msg_label=Opción del jugador
#. y4:msg_section=14
#. y4:msg_section_label=Conversación 14
#. y4:msg_talk=164
#. y4:msg_phrase=0
#. y4:msg_location=T164.P0
#. y4:msg_choice_index=2
